,"socialicon2socialtype":"time","logogrid":"logolistsg","logogridcount":"1","coverimage":"genericassets/images/app/commonimage8.jpg","creatorimage":"genericassets/images/app/mikeholmes.jpg","customerimage":"genericassets/images/app/sarahbarrett.jpg","logoimage":"genericassets/images/app/presentationsai.png","customerlogoimage":"genericassets/images/app/logoipsum.png","venue":"Saturday, November 25th 10AM","speakerprimary1":"Mike Holmes","speakersecondary1":"CEO","speakerimage1":"genericassets/images/app/mikeholmes.jpg","speakerprimary2":"Sarah Barrett","speakersecondary2":"Project Manager","speakerimage2":"genericassets/images/app/sarahbarrett.jpg","speakerprimary3":"Samuel Johnson","speakersecondary3":"Marketing Manager","speakerimage3":"genericassets/images/app/samueljohnson.jpg","speakerprimary4":"Natasha Evans","speakersecondary4":"Chief Executive Officer","speakerimage4":"genericassets/images/app/teresaperkins.jpg","description":"I am a driven, highly motivated, multilingual administrative professional with over 5 years of experience providing executive-level support."},"cover-singleprofilelist":{"creatorname":"#COMPANY_EXECUTIVE_NAME_1#","customername":"#COMPANY_CUSTOMER_NAME_1#","creatordesignation":"#COMPANY_EXECUTIVE_DESIGNATION_1#","customerdesignation":"General Partner","socialicon1secondary":"#COMPANY_EXECUTIVE_LINKEDIN_1#","socialicon1primary":"Linkedin","socialicon1socialtype":"linkedin","socialicon2secondary":"#COMPANY_TWITTER#","socialicon2primary":"Twitter","socialicon2socialtype":"twitter","socialicon3secondary":"#COMPANY_ADDRESS#","socialicon3primary":"Location","socialicon3socialtype":"location","presenterlogogrid":"logolistsg","presenterlogogridcount":"3","logoimage":"#COMPANY_PRIMARY_LOGO#","ctabutton":"Register Now","coverimage":"genericassets/images/app/commonimage8.jpg","coverimage1":"genericassets/images/app/commonimage6.jpg","creatorimage":"genericassets/images/app/mikeholmes.jpg","customerimage":"genericassets/images/app/sarahbarrett.jpg","customerlogoimage":"genericassets/images/app/logoipsum.png","covernumber":"2023","speakerprimary1":"#COMPANY_EXECUTIVE_NAME_1#","speakersecondary1":"#COMPANY_EXECUTIVE_DESIGNATION_1#","speakerimage1":"genericassets/images/app/mikeholmes.jpg","speakerprimary2":"Sarah Barrett","speakersecondary2":"Project Manager","speakerimage2":"genericassets/images/app/sarahbarrett.jpg","speakerprimary3":"Samuel Johnson","speakersecondary3":"Marketing Manager","speakerimage3":"genericassets/images/app/samueljohnson.jpg","speakerprimary4":"Natasha Evans","speakersecondary4":"Chief Executive Officer","speakerimage4":"genericassets/images/app/teresaperkins.jpg","presenterdescription":[["Forbes 30 Under 30 - Technology 2021"],["Contributing Writer at TechCrunch & Wired"],["Judge at the Global Web Innovation Awards"],["10 years of experience in software engineering and AI development"],["Worked with 50+ leading brands including Google, Apple, Microsoft, and IBM"],["Awarded 40+ technology and innovation awards including at the CES Innovation Awards and Global Tech Summit"],["Mentor at Stanford’s StartX and part of the MIT Innovation Program"],["Speaker at TEDx, Web Summit, and AI Conference"],["Alumnus of Harvard Business School’s Executive Education Program"]]},"cover-singleprofileparagraph":{"creatorname":"#COMPANY_EXECUTIVE_NAME_1#","customername":"#COMPANY_CUSTOMER_NAME_1#","creatordesignation":"#COMPANY_EXECUTIVE_DESIGNATION_1#","customerdesignation":"General Partner","socialicon1secondary":"#COMPANY_EXECUTIVE_LINKEDIN_1#","socialicon1primary":"Linkedin","socialicon1socialtype":"linkedin","socialicon2secondary":"#COMPANY_TWITTER#","socialicon2primary":"Twitter","socialicon2socialtype":"twitter","socialicon3secondary":"#COMPANY_ADDRESS#","socialicon3primary":"Location","socialicon3socialtype":"location","presenterlogogrid":"logolistsg","presenterlogogridcount":"3","logogrid":"logolistsg","logogridcount":"3","logoimage":"#COMPANY_PRIMARY_LOGO#","ctabutton":"Register Now","coverimage":"genericassets/images/app/commonimage8.jpg","coverimage1":"genericassets/images/app/commonimage6.jpg","creatorimage":"genericassets/images/app/mikeholmes.jpg","customerimage":"genericassets/images/app/sarahbarrett.jpg","customerlogoimage":"genericassets/images/app/logoipsum.png","covernumber":"2023","speakerprimary1":"#COMPANY_EXECUTIVE_NAME_1#","speakersecondary1":"#COMPANY_EXECUTIVE_DESIGNATION_1#","speakerimage1":"genericassets/images/app/mikeholmes.jpg","speakerprimary2":"Sarah Barrett","speakersecondary2":"Project Manager","speakerimage2":"genericassets/images/app/sarahbarrett.jpg","speakerprimary3":"Samuel Johnson","speakersecondary3":"Marketing Manager","speakerimage3":"genericassets/images/app/samueljohnson.jpg","speakerprimary4":"Natasha Evans","speakersecondary4":"Chief Executive Officer","speakerimage4":"genericassets/images/app/teresaperkins.jpg","presenterdescription":[["Alexandra Forbes is a renowned technology leader and innovator, named in Forbes 30 Under 30 for Technology in 2021. With over a decade of experience in software engineering and AI development, she has worked with industry giants like Google, Apple, Microsoft, and IBM, leading groundbreaking projects that push the boundaries of digital transformation.\\n\\n"],["As a contributing writer for TechCrunch and Wired, Alexandra shares insights on emerging tech trends, while her role as a judge at global tech awards highlights her expertise and influence in the industry. She has earned 40+ awards for her contributions to technology, including accolades at CES Innovation Awards and Global Tech Summit.\\n\\n"],["Alexandra is also a dedicated mentor at Stanford’s StartX and the MIT Innovation Program, where she helps nurture the next generation of entrepreneurs. An alumnus of the Harvard Business School’s Executive Education Program, she continues to be a sought-after speaker at major conferences like TEDx and Web Summit. Her passion for driving innovation and her ability to lead complex tech teams have solidified her as a key figure in shaping the future of AI and cloud computing.\\n\\n"],["Alexandra also supports women in tech through various initiatives, helping increase diversity in STEM fields and ensuring equal opportunities for aspiring female engineers."]]},"sectionbreak-common":{"logogrid":"logolistsg","logogridcount":"1","coverimage":"genericassets/images/app/sectionbreak.jpg"},"sectionbreak-illustration":{"logogrid":"logolistsg","logogridcount":"1","coverimage":"section break.svg","commonbg":"section break.svg","type":"illustration"},"quote-simple":{"authorname":"- He who quoted","authorimage":"genericassets/images/app/elonmusk.jpeg","logogrid":"logolistsg","logogridcount":"1","coverimage":"genericassets/images/app/inspiringpresentationtemplates.jpg","logoimage":"genericassets/images/app/presentationsai.png"},"quote-common":{"quotetitle":"Best Quote Words","quotetakeaway":"What we have to do... is to find a way to celebrate our diversity and debate our differences without fracturing our communities.","authorname":"- Elon Musk","logogrid":"logolistsg","logogridcount":"1","authorimage":"genericassets/images/app/elonmusk.jpeg","coverimage":"genericassets/images/app/inspiringpresentationtemplates.jpg","logoimage":"genericassets/images/app/presentationsai.png"},"quote_stock_image_mnu":{"title":"Inspirational Quotes by Famous People","graphic":"authorlist","graphictype":"person","list":"quotetext","author":"alberteinstein","hidegraphic":true,"bg":"genericassets/shapes/stockassets/imagewithtext/leftquote/Albert_Einstein.jpg"},"quote_stock_left_image_mnu":{"title":"Inspirational Quotes by Famous People","graphic":"authorlist","graphictype":"person","list":"quotetext","author":"alberteinstein","hidegraphic":true,"bg":"genericassets/shapes/stockassets/imagewithtext/rightquote/Sundar_Pichai.jpg"},"quote-fullbleed-left":{"quotetitle":"Best Quote Words","quotetakeaway":"Passion has helped us; but can do so no more. It will in future be our enemy. Reason, cold, calculating, unimpassioned reason, must furnish all the materials for our future support and defence.","authorname":"Albert Einstein","logogrid":"logolistsg","logogridcount":"1","authorimage":"genericassets/shapes/stockassets/imagewithtext/leftquote/Albert_Einstein.jpg","logoimage":"genericassets/images/app/apple.png"},"quote-fullbleed-right":{"quotetitle":"Best Quote Words","quotetakeaway":"If you don\'t find a way to make money while you sleep, you will work until you die.","authorname":"Sundar Pichai","logogrid":"logolistsg","logogridcount":"1","authorimage":"genericassets/shapes/stockassets/imagewithtext/rightquote/Sundar_Pichai.jpg","logoimage":"genericassets/images/app/apple.png"},"quote-author":{"authorname":"Abraham Lincoln","authorimage":"genericassets/images/app/abrahamlincoln.jpg","logogrid":"logolistsg","logogridcount":"1","logoimage":"genericassets/images/app/presentationsai.png"},"quote-testimonial":{"authorname":"Steve Jobs","authordesignation":"Co-founder Apple Inc.","authorimage":"genericassets/images/app/sarahbarrett.jpg","logogrid":"logolistsg","logogridcount":"1","logoimage":"genericassets/images/app/presentationsai.png"},"cta-common":{"coverimage":"genericassets/images/app/reference.jpg","logogrid":"logolistsg","logogridcount":"1","logoimage":"genericassets/images/app/presentationsai.png","creatorname":"#COMPANY_EXECUTIVE_NAME_1#","customername":"#COMPANY_CUSTOMER_NAME_1#","creatordesignation":"#COMPANY_EXECUTIVE_DESIGNATION_1#","customerdesignation":"General Partner","creatorimage":"genericassets/images/app/mikeholmes.jpg","customerimage":"genericassets/images/app/sarahbarrett.jpg","ctabutton":"Reach Me","socialicon1secondary":"#COMPANY_EXECUTIVE_LINKEDIN_1#","socialicon1primary":"Linkedin","socialicon1socialtype":"linkedin","socialicon2secondary":"#COMPANY_TWITTER#","socialicon2primary":"Twitter","socialicon2socialtype":"twitter","socialicon3secondary":"#COMPANY_ADDRESS#","socialicon3primary":"Location","socialicon3socialtype":"location","re