                        // return "accent" + (colorValue + 1) + "-bg-color";
                        return "clsNodeAccentbg"
                    }
                    // return "accent" + (groupindex + 1) + "-bg-color";
                    if (this.data.multicolor) {
                        return "clsNodeAccentbg";
                    } else {
                        return "clsNodeAccentbg";
                        // return "accent1-bg-color";
                    }
                    break;
            }
        }
    }

}
