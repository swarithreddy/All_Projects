function VOAsset(argData, objData){
    this.appearance = [];
    if (argData != null && 0 < argData.length) {
        for(let a1=0;a1<argData.length;a1++){
            if(argData[a1].type=="ICON"&&argData[a1].data){
                argData[a1].data = new DOMParser().parseFromString(argData[a1].data, "image/svg+xml").documentElement.cloneNode(true);
            }
        }
        this.data = argData;
        this.name = this.data.length > 0 ? this.data[0].assetName : null;
    } else {
        this.data = [];
        this.name = null;
    }
    this.placeholderData = argData?argData.slice(0):[];
    if (argData&&argData.length>0&&objData.showPlaceholder && argData[0].iconType) this.placeholderData = this.placeholderData.slice(1, this.placeholderData.length);
}

function DComponent(argparent, argprops) {
    this.items = [];
    this.minwidth = 0;
    this.minheight = 0;
    this.props = argprops;
    this.parent = argparent;
    this.name = "DComponent";
    this.state = { x: 0, y: 0, width: 0, height: 0 };
}

DComponent.prototype.move = function (argx, argy) {
    try {
        this.state.x = argx;
        this.state.y = argy;
    } catch (error) {
        alert("error")
        // ErrorHandler.onListner(this, "move");
    }
}

DComponent.prototype.size=function(argwidth, argheight, argforce = false) {
    // try {
    if (!argforce && (this.state.width === argwidth || this.state.height === argheight)) return 0;
    this.state.width = argwidth;
    this.state.height = argheight;
    this.resize();
    // } catch (error) {
    //     ErrorHandler.onListner(this, "setsize");
    // }
}

DComponent.prototype.resize =function() {
    this.doComputation();
}

// set data(value) {
//     this.voData = value;
//     // this.setLayout();
//     this.doComputation();
// }

// get data() {
//     return this.voData;
// }

DComponent.prototype.setLayout=function() {
    if (this.voData.customProperties.datapoint == "none") this.validHover = true;
    if (this.voData.validHover && this.voData.customProperties.datapoint == "none") {
        this.voData.layout.showValue = false;
        this.voData.customProperties.showYAxisGrid = true;
        this.voData.customProperties.showYAxisLine = true;
        this.voData.customProperties.showXAxisLine = true;
        this.voData.customProperties.showYAxisGridValue = true;
    }
}
Object.defineProperties(DComponent.prototype, {
    'data': {
        get: function () {
            return this.voData
        },
        set: function (value) {
            this.voData = value;
            this.doComputation();
        }
    },
    'datavalidation': {
        get: function () {
            return this.data != null ? true : false;
        },
        set: function (value) {
            this.voData = value;
            this.doComputation();
        }
    },
    'measurementvalidation': {
        get: function () {
            return this.minwidth < this.state.width && this.minheight < this.state.height;
        }
    },
    'isvalid': {
        get: function () {
            return this.measurementvalidation && this.datavalidation;
        }
    },
});



DComponent.prototype.doComputation=function() { }

DComponent.prototype.clear=function() {
    let length = this.items.length;
    for (let i1 = 0; i1 < length; i1++) {
        this.items[i1].clear();
    }
    this.items = [];
}


let fontDeatils;
let vodata;
function ChartFonts(argProps, voDetails) {
    if (argProps) {
        fontDeatils = argProps;
    }
    if (voDetails) {
        vodata = voDetails;
    }
}
Object.defineProperties(ChartFonts.prototype, {
    labelThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.label ? fontDeatils.label : "p3";
            return " " + classValue;
        },
    },
    placeholderText: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.placeholdertext ? fontDeatils.placeholdertext : "h5";
            return " " + classValue;
        },
    },
    secondaryLabelThemeClassName: {
        get: function () {
            
            let classValue = fontDeatils && fontDeatils.secondarylabel ? fontDeatils.secondarylabel : "p3";
            if(vodata&&vodata.arrsecondaryLabelFontStyle&&vodata.arrsecondaryLabelFontStyle.length>0&&vodata.arrsecondaryLabelFontStyle[0]){
                return " " + vodata.arrsecondaryLabelFontStyle[0];
            }else{
                return " " + classValue;
            }
        },
    },
    shapeCompareLabel: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.primarylabel ? fontDeatils.primarylabel : "p3";
            if(vodata&&vodata.arrLabelFontStyle&&vodata.arrLabelFontStyle.length>0&&vodata.arrLabelFontStyle[0]){
                return " " + vodata.arrLabelFontStyle[0];
            }else{
                return " " + classValue;
            }
        },
    },
    valueThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.value ? fontDeatils.value : "n1";
            if(vodata.customValueFontClass){
                classValue = vodata.customValueFontClass;
            }
            return " " + classValue;
        },
    },
    promptTextClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.prompttext ? fontDeatils.prompttext : "h9";
            return " " + classValue;
        },
    },
    hdClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.hdtext ? fontDeatils.hdtext : "h9";
            return " " + classValue;
        },
    },
    axisLabelThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.axislabel ? fontDeatils.axislabel : "n1";
            return " " + classValue;
        },
    },
    gridThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.gridvalue ? fontDeatils.gridvalue : "p3";
            return " " + classValue;
        },
    },
    legendLabelThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.legendlabel ? fontDeatils.legendlabel : "p3";
            return " " + classValue;
        },
    },
    legendValueThemeClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.value ? fontDeatils.value : "n1";
            return " " + classValue;
        },
    },
    titleClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.title ? fontDeatils.title : "h7";
            return " " + classValue;
        },
    },
    headingClassName: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.columnheading ? fontDeatils.columnheading : "h9";
            return " " + classValue;
        },
    },
    projectiontext: {
        get: function () {
            let classValue = fontDeatils && fontDeatils.projectiontext ? fontDeatils.projectiontext : "h9";
            return " " + classValue;
        },
    },
    labelOuterColor: {
        get: function () {
            return " clsTextTertiaryColor";
        },
    },
    gridLabelOuterColor: {
        get: function () {
            return " clsTextTertiaryColor";
