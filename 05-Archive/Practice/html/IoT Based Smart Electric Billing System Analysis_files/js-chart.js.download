    this._labelHeaderAlign = this._data.getAttribute("labelheaderalign") ? this._data.getAttribute("labelheaderalign") : "";
    this._headerValueDisplayFormat = this._data.getAttribute("valueheaderformat") ? this._data.getAttribute("valueheaderformat") : "";
