                    try {
                        instance = new window[this.data.moodData.calloutstyle](parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrBottomText[i2], 1, false, {}, "", "", objCallout);
                    } catch (error) {
                        instance = new window["HighlightTest"](parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrBottomText[i2], 1, false, {}, "", "", objCallout);
