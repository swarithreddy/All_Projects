function VOData(argProps) {
    let ChartDefaultValue = new window["ChartDefaultValues"]();
    let ChartHelper = new window["ChartHelper"]();
    let ChartUtils = new window["ChartUtils"]();
    this._SVGUtils = new window["SVGUtils"]();
    this.tempStorage = "";
    this._callAnimation = ""; //new window["coinColumnAnimation"]();
    let ChartPropertiesName = new window["ChartPropertiesName"]();
    this.ChartPropertiesName = new window["ChartPropertiesName"]();
    this._ChartHelper = ChartHelper;
    this._ChartUtils = ChartUtils;
    this._labelColorClass = " clsLabelTextColor ";
    this._valueColorClass = " clsValueTextColor ";
    this.instanceDetails = argProps.objInstanceDeatil;
    this.props = argProps;
    this.voLayout = argProps.voLayout;
    this.presentMode = argProps.presentMode;
    this.asset = null;
    this._projectionDivider = false;
    this._disableEdit = false;
    this.boolHighlightDifference = false;
    this.dummerSeriesItemLength = 1;
    this.highlightDiffernecPoint1 = "";
    this.highlightDiffernecPoint2 = "";
    this.highlightDifferenceStyle = "";
    this.highlightDifferceText = "";
    this.highlightdifferencedisplayFormat = "";
    this._positiveGridCount = "";
    this._negativeGridCount = "";
    this._projectionStartIndex = "";
    this._currentslide = argProps.currentslide;
    this.objHighlightDifferenceDetails = {};
    this._values = [];
    this._labels = [];
    this._chartFlip = false;
    this._comparisonLabel = [];
    this._legendLabels = [];
    this._secondaryText = [];
    this._statisticalValues = [];
    this.labelLineHeight = [];
    this.labelLetterSpace = [];
    this._boolShowHdCallout = true;
    this._boolHdCalloutFontSize = 0;
    this.secondaryLabelLineHeight = [];
    this.secondaryLabelLetterSpace = [];
    this._currentElementDiv = "";
    this.compareTitleLineHeight = [];
    this.compareTitleLetterSpace = [];
    this.legendlabellineHeight = [];
    this.legendlabelletterspacing = [];
    this._statiSticalLongValue = "";
    this._labelHeaderAlign = "";
    this._itemHeaderAlign = "";
    this._secondaryHeaderAlign = "";
    this._valueHeaderAlign = "";
    this.boolEnableSecondayText = false;
    this._boolEnableWidthReducer = false;
    this.arrEmphasisStyle = [];
    this._displayValueMaxCount = 10;
    this._highlights = [];
    this._lineStyleHightlightValue = [];
    this._emphasis = [];
    this._maxValueSeriesItems = [];
    this._projection = [];
    this._itemPlacehoders = [];
    this._itemPlacehodersType = [];
    this._itemPlaceholderPath = [];
    this._secondaryValues = [];
    this._grapicImage = [];
    this._itemGraphicPath = [];
    this._arrlineHighlightText = [];
    this._promptText = [];
    this._longValue = 0;
    this._longLengthValue = 0;
    this._rangeTotal = 0;
    this._rangePositive = 0;
    this._rangeNegative = 0;
    this._previousData = { width: 0, height: 0, x: 0 };
    this._data = argProps.data;
    this._seriesItemLength = 1;
    this._showLegend = true;
    this._primaryPlaceholderName = [];
    this._primaryPlaceholderPath = [];
    this._primaryPlaceholderPathData = [];
    this._primaryPlaceholderType = [];
    this._logoContrast = [];
    this._itemHeaderTitle = "";
    this._boolEnableHeader = false;
    this._labelHeaderTitle = "";
    this._secondaryHeaderTitle = "";
    this._valueHeaderTitle = "";
    this._secondaryPlaceholderPath = [];
    this._hdHeight = 0;
    this._neativeExtraValue = 0;
    this._hasLogoPlaceholder = false;
    this._secondaryPlaceholder = [];
    this._arrImagePlaceHolder = [];
    this._arrHighvalueBreak = [
        { minnode: 1, maxnode: 3 },
        { minnode: 2, maxnode: 4 },
        { minnode: 3, maxnode: 5 },
    ];
    this._boolEnablesequeceNumber = false;
    this._gap = 0;
    this._highValueBreak = false;
    this._secondaryPlaceholderType = [];
    this._secondaryPlaceholderName = [];
    this._secondaryValuesDenominationSuffix = [];
    this._gap = 0;
    this.columnasset = "";
    // this._secondaryPlaceholderType = [];
    this._voTheme = { valueFontStyle: "", valueFontWeight: "", valueFontFamily: "", valueFontSize: 12, labelFontSize: 23, labelFontFamily: "" };
    this._valueDisplayFormat = [];
    this._labelDisplayFormat = [];
    this._arrHyperlinkUrl = [];
    this._labelHeaderWidth = 0;
    this._suffix = [];
    this._prefix = [];
    this._xValues = [];
    this._yValues = [];
    this._denominationPrefix = [];
    this._currencySymbol = [];
    this._valuesDenomination = [];
    this._xMaxValue;
    this._yMaxValue;
    this._yMinValue;
    this._xMinValue;
    this._coinStyle;
    this._borderRadius = false;
    this.slideObj = argProps.slideobj ? argProps.slideobj.cloneNode(true) : "";
    this._slideID = this._data.getAttribute("data-slideid");
    this._slideID = !this._slideID ? "elementslide" : this._slideID;
    this._designerUI = false;
    this._headerHeight = 60;
    this._PositiveDiff = 0;
    this._stackedPercentage = false;
    this._minValue;
    this._maxValue;
    this._sprefix = [];
    this._arrGraphicImagePrompt = [];
    this._ssuffix = [];
    this._sdenominationPrefix = [];
    this._scurrencySymbol = [];
    this._indualHighlightReverse = false;
    if (this._slideID == "elementslide") {
        this._designerUI = true;
    }

    this.baseProperties = argProps.baseProperties;
    this._displayValueFormat = this.baseProperties.defaultDisplayFormat ? this.baseProperties.defaultDisplayFormat : "asentered";
    this._customProperties = argProps.customProperties;
    this._connectorLine = false;
    this._connectorLineType = null;
    this._connectorLineColor = null;
    this._connectorLinedashArray = null;
    this._connectorLineStyle = null;
    this.compareStyle = null;
    this._shapeBoder = null;
