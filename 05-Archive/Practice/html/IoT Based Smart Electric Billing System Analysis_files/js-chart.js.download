    }
    if (vodata.seriesItemLength == 2 && index > 0) {
        return "clsNodeAccentbg";
    }
    if (vodata.seriesItemLength == 4 && index > 0) {
        if (index == 2 || index == 3) {
            return "clsNodeAccentbg";
        } else {
            return "clsNodeAccentbg";
        }
    }
    if (vodata.seriesLength == 2 && vodata.data.getAttribute("data-multicolor") && index != 0) {
        return "clsNodeAccentbg";
    }
    if(vodata.multicolor){
        return "clsNodeAccentbg";
    }else{
        return "clsNodeAccentbg";
        // return "accent1-bg-color";
    }
};

