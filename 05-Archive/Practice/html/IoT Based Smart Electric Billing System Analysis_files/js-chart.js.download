BaseSeriesItem.prototype.getBgFillDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            if (fillProperty && fillProperty == "color") {
                PropertyIndex = 0;
            } else {
                PropertyIndex = groupindex;
            }
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient"
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "bgcolor":
            if (fillProperty == "stroke") {
                return "bgstroke";
            } else {
                return "fillbgColor";
            }
            break;
        case "tertiary":
            if (fillProperty == "stroke") {
                return "clsTertiaryStroke";
            } else {
                return "clsTertiaryFill";
            }
            break;
        case "secondary":
            if (fillProperty == "stroke") {
                return "secondary-stroke";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-fill";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = PropertyIndex != 0 ? 5 : groupindex
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex
                        // return "accent" + (colorValue + 1) + "-fill";
                        return "clsAccentfill";
                    }
                    // return "accent" + (groupindex + 1) + "-fill";
                    if (this.data.multicolor) {
                        return "clsAccentfill";
                    } else {
                        return "clsAccentfill";
                        // return "accent1-fill";
                    }
                    break;
                case "stroke":
                    return this.data.ChartFonts.appendgraphicStrokeColor(groupindex);
                    break
            }
        }
    }

}
