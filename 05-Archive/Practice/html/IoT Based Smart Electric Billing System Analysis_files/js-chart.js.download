        }
        if (this.voLayout.showPlaceholder || ((strPlaceholderType == "ICON" || strPlaceholderType == "icon") && this.legendPlaceHolderType)) chartItem.setAttribute(ChartPropertiesName.primaryPlaceholderType, strPlaceholderType);
        if (strPlaceholderType) strPlaceholderType = strPlaceholderType.toUpperCase();
        if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
            strPlaceHolder = true;
        }
        if (strPlaceHolder) {
            if (strPlaceholderType === "ICON" || strPlaceholderType === "icon") {
