            let boolformat = this.xmlData.getAttribute("displayvalue");
            if (!boolformat) {
                switch (this.showDataPoints) {
                    case "first":
                        this.xmlData.setAttribute("displayvalue", "F");
                        break;
                    case "last":
                        this.xmlData.setAttribute("displayvalue", "L");
                        break;
                    case "firstandlast":
                        this.xmlData.setAttribute("displayvalue", "FL");
                        break;
                    case "all":
                        this.xmlData.setAttribute("displayvalue", "all");
                        break;
                    case "high":
                        this.xmlData.setAttribute("displayvalue", "H");
                        break;
                    case "low":
                        this.xmlData.setAttribute("displayvalue", "LO");
                        break;
                    case "highandlow":
                        this.xmlData.setAttribute("displayvalue", "L,H");
                        break;
                    case "none":
                        this.xmlData.setAttribute("displayvalue", "none");
                        break;
                }
            }
