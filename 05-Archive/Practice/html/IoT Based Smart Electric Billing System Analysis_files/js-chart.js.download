BaseSeriesItem.prototype.createPatternSvg = function (parentElement, bgElement = false) {
    let baseSvg = SVGUtils.createSVGElement("svg");
    SVGUtils.assignAttributes(baseSvg, {
        id: "pattenContainer",
        width: parentElement.clientWidth,
        height: parentElement.clientHeight,
        style: "position:absolute;"
    })
    if (bgElement) {
        parentElement.appendChild(baseSvg)
    } else {
        parentElement.parentNode.appendChild(baseSvg)
    }
    let defsTag = SVGUtils.createSVGElement("defs");
    baseSvg.appendChild(defsTag)
    let patternTag = SVGUtils.createSVGElement("pattern");
    SVGUtils.assignAttributes(patternTag, {
        id: "pattern" + this.groupindex,
        x: "0",
        y: "0",
        width: "40",
        height: "40",
        patternUnits: "userSpaceOnUse"
    })
    defsTag.appendChild(patternTag);
    let rect = SVGUtils.createSVGElement("rect");
    SVGUtils.assignAttributes(rect, {
        width: parentElement.clientWidth,
        height: parentElement.clientHeight,
        fill: "url(#pattern" + this.groupindex + ")"
    })
    baseSvg.appendChild(rect)
    let Svg = this.data.asset.data[this.data.asset.data.length - 2];
    let patternSvg = Svg ? Svg.data : "";

    if (!patternSvg) {
        patternSvg = this.data.slideObj.querySelector("#series-0").querySelector("#pattenContainer").children[0].children[0].children[0].cloneNode(true)
    } else {
        patternSvg = new DOMParser().parseFromString(patternSvg, "image/svg+xml").documentElement.cloneNode(true);
    }
    patternTag.appendChild(patternSvg)
}
BaseSeriesItem.prototype.labelbgProperties = function (element) {
    if (this.data.layout.labelbgShapeType == "circle") {
        element.style.borderRadius = "50%"
    }
    if (this.data.layout.labelbgStyle == "border") {
        if (this.data.layout.labelbgBorderSize) {
            element.style.border = this.data.layout.labelbgBorderSize + "px solid";
            element.style.setProperty("--border-width", this.data.layout.labelbgBorderSize + "px", "");
        } else {
            element.style.setProperty("--border-width", "2px", "");
            element.style.border = "2px solid"
        }
        let strBordeClass = this.getBgColorDetails(this.groupindex, this.data.ChartFonts.appendgraphicBorderColor(this.groupindex), this.data.layout.labelbgBorderColor, "bordercolor")
        if (this.data.layout.labelbgBorderColor == "gradient") {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                element.classList.add("bordergradient")
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                if (this.data.layout.labelBgBorderOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBordeClass, this.groupindex, this.data.layout.labelBgBorderOpacity);
                    element.style.borderColor = rgbavalue;
                } else {
                    element.classList.add(strBordeClass)
                }
            }
        }
    }
    if (this.data.layout.labelbgBgColor) {
        let strBgClass = this.getBgColorDetails(this.groupindex, "clsNodeTertiarybg", this.data.layout.labelbgBgColor, "bgcolor")
        if (this.data.layout.labelbgBgColor == "gradient") {
            if ((this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                element.classList.add("gradient")
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                if (this.data.layout.labelbgOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBgClass, this.groupindex, this.data.layout.labelbgOpacity);
                    element.style.background = rgbavalue;
                } else {
                    element.classList.add(strBgClass)
                }
            }
        }
    }
    if (this.data.layout.labelbgRadius) {
        let borderRadiuslefttop = this.data.layout.labelbgRadius && this.data.layout.labelbgRadius.length > 0 ? this.data.layout.labelbgRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.labelbgRadius && this.data.layout.labelbgRadius.length > 1 ? this.data.layout.labelbgRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.labelbgRadius && this.data.layout.labelbgRadius.length > 2 ? this.data.layout.labelbgRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.labelbgRadius && this.data.layout.labelbgRadius.length > 3 ? this.data.layout.labelbgRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
}
BaseSeriesItem.prototype.addGradient = function (svgRect, parentElement, bgFill = true, stroke = false, bgElemenet = false) {
    let GradientDatas = bgElemenet ? this.data.layout.backgroundGradientDatas : this.data.layout.itemGradientDatas;
    let opacity1 = GradientDatas && GradientDatas.opacity1 ? GradientDatas.opacity1 : "0.6";
    let opacity2 = GradientDatas && GradientDatas.opacity2 ? GradientDatas.opacity2 : "1";
    let color1 = GradientDatas && GradientDatas.color1 ? this.checkColorValue(GradientDatas.color1) : "var(--accent" + 2 + "-color-rgp)";
    let color2 = GradientDatas && GradientDatas.color2 ? this.checkColorValue(GradientDatas.color2) : "var(--accent" + 6 + "-color-rgp)";
    let defs = this.data.SVGUtils.createSVGElement("defs");
    parentElement.appendChild(defs);
    let linearGrad = this.data.SVGUtils.createSVGElement("linearGradient");
    this.data.SVGUtils.assignAttributes(linearGrad, {
        id: bgElemenet ? "bggrad" : "grad",
        x1: "0%",
        x2: bgFill ? "0%" : "100%",
        y1: bgFill ? "100%" : "0%",
        y2: "0%",
    });
    defs.appendChild(linearGrad);
    let stop1 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop1, {
        class: "stop1",
        offset: GradientDatas && GradientDatas.percentage1 ? GradientDatas.percentage1 + "%" : "0%",
        style: "stop-color:" + color1 + ";stop-opacity:" + opacity1,
    });
    linearGrad.appendChild(stop1);
    let stop2 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop2, {
        class: "stop2",
        offset: GradientDatas && GradientDatas.percentage2 ? GradientDatas.percentage2 + "%" : "100%",
        style: "stop-color:" + color2 + ";stop-opacity:" + opacity2,
    });
    linearGrad.appendChild(stop2);
    if (bgFill) {
        this.data.SVGUtils.assignAttributes(svgRect, {
            fill: bgElemenet ? "url(#bggrad)" : "url(#grad)"
        });
    }
    if (stroke) {
        this.data.SVGUtils.assignAttributes(svgRect, {
            stroke: bgElemenet ? "url(#bggrad)" : "url(#grad)"
        });
    }
}
BaseSeriesItem.prototype.checkColorValue = function (colorvalue) {
    if (colorvalue) {
        if (colorvalue.includes("item1")) {
            return "var(--item" + 1 + "-color-rgb)"
        }
        if (colorvalue.includes("item2")) {
            return "var(--item" + 2 + "-color-rgb)"
        }
        if (colorvalue.includes("item3")) {
            return "var(--item" + 3 + "-color-rgb)"
        }
        if (colorvalue.includes("item4")) {
            return "var(--item" + 4 + "-color-rgb)"
        }
        if (colorvalue.includes("item5")) {
            return "var(--item" + 5 + "-color-rgb)"
        }
        if (colorvalue.includes("item6")) {
            return "var(--item" + 6 + "-color-rgb)"
        }
    }
}
