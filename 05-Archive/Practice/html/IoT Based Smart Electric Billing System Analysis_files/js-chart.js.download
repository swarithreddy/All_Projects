        if (arrLeft.length > 0) arrLeft[0] = arrLeft[0] > this.voData.rangeTotal ? this.voData.rangeTotal - 4 : arrLeft[0];

        if (this.type == "vertical" && arrLeft.length < 1) {
            arrLeft = baseLineBottomValue ? baseLineBottomValue.toString().split(",") : [];
            arrLeftText = arrBottomText;
