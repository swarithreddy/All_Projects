ChartFonts.prototype.dynamiclabelThemeClassName = function(index="0"){
    if(vodata&&vodata.arrLabelFontStyle.length>index&&vodata.arrLabelFontStyle[index]){
        return " " + vodata.arrLabelFontStyle[index];

    }else{
        let classValue = fontDeatils && fontDeatils.label ? fontDeatils.label : "p3";
        return " " + classValue;
    }
}
ChartFonts.prototype.dynamiclegendLabelThemeClassName = function(index="0"){
    if(vodata&&vodata.arrLabelFontStyle.length>index&&vodata.arrLabelFontStyle[index]){
        return " " + vodata.arrLabelFontStyle[index];
    }else{
        let classValue1 = fontDeatils && fontDeatils.legendlabel ? fontDeatils.legendlabel : "p3";
        return " " + classValue1;
    }
}
ChartFonts.prototype.graphicColor = function (index) {
    // if(vodata.seriesItemLength==3&&index>0){
    //     return " accent" + (index+(index*2)) + "-color";
    // }
    // if(vodata.seriesItemLength==2&&index>0)
