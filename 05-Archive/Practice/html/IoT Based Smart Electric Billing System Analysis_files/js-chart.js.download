let svgAssetdummey = null;
function SimpleScaleBarChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleScaleBarChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleScaleBarChart.prototype = Object.create(BaseBarChart.prototype);
SimpleScaleBarChart.prototype.constructor = SimpleScaleBarChart;

SimpleScaleBarChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleScaleBarSeries"](argparent, argprops)
}

SimpleScaleBarChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveY = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
    if (this.data.layout.enableBackground && this.data.layout.backgroundItemType == "svg") {
        this.createGraphicsShape("", "", true);
    }
    this.createGraphicsShape();
}

SimpleScaleBarChart.prototype.createGraphicsShape = function (argparent, argprops, bgItem = false) {
    let slide = document.getElementById(this.voData.slideID);
    let element = slide.querySelectorAll(".chartgraphic");
    if (bgItem) {
        element = slide.querySelectorAll(".backgroundItem");
    }
    this.asset = this.data.asset.data[0].data;
    this.assetName = this.data.asset.name;
    for (let i1 = 0; i1 < element.length; i1++) {
        let index = element[i1] && element[i1]
            .getAttribute("id") && element[i1]
                .getAttribute("id")
                .split("-").length > 1 && element[i1]
                    .getAttribute("id")
                    .split("-")[1]
                    .split("_").length > 0 ? parseInt(
                        element[i1]
                            .getAttribute("id")
                            .split("-")[1]
                            .split("_")[0]
                    ) : i1;
        let itemMinSize = 43;
        let intGraphicsWidth = itemMinSize < element[i1].clientWidth ? element[i1].clientWidth : itemMinSize; //argparent.getAttribute("data-width");
        let intGraphicsHeight =
            this.data.layout.labelVPosition == "top" || this.data.layout.valueVPosition == "top" || this.data._customProperties.showMergeItems
                ? element[i1].clientHeight
                : element[i1].clientHeight;
        // let oldPercentageW = element[i1].getAttribute("data-oldpercentage");
        // let newPercentageW = element[i1].getAttribute("data-newpercentage");
        let percentageDiff = itemMinSize < element[i1].clientWidth ? 0 : itemMinSize - element[i1].clientWidth;

        // let intGraphicsWidth = this.data._customProperties.showMergeItems ? argparent.getAttribute("data-width") : argparent.getAttribute("data-width") * 0.7;
        // let intGraphicsHeight = argparent.getAttribute("data-height");

        let clstyle =
            this.data.hasEmphasis && this.data.emphasis[index] != true
                ? "clsTertiaryFill"
                : this.data.hasEmphasis && this.data.emphasis[index] == true
                    ? "clsAccentfill"
                    : this.getBgFillDetails(index, this.data.ChartFonts.appendgraphicFillColor(index), this.data.layout.itemColor, "bgcolor")//"accent" + (index + 1) + "-fill";
        if (bgItem) {
            clstyle = this.data.hasEmphasis && this.data.emphasis[index] != true
                ? "clsTertiaryFill"
                : this.data.hasEmphasis && this.data.emphasis[index] == true
                    ? "clsAccentfill"
                    : this.getBgFillDetails(index, this.data.ChartFonts.appendgraphicFillColor(index), this.data.layout.backgroundColor, "bgcolor")//"accent" + (index + 1) + "-fill";
        }
        // let previousElement =  element[i1].querySelector("#graphicmask-container");
        // previousElement.remove();
        let svgGraphicMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
            id: "graphicmask-container",
            x: "0%",
            y: "0%",
            width: "100%",
            // filter: "url(#f1" +index + ")",
            height: intGraphicsHeight,
            class: clstyle+" chartMainGraphic"
        });
        svgGraphicMaskContainer.style.strokeOpacity ="0";
        if(bgItem&&this.data.layout.backgroundOpacity){
            this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
                "fill-opacity":this.data.layout.backgroundOpacity
            });
        }
        if (this.data.projection[index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.add("clsTertiaryFill");
        }

        if (this.data.projection[index] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.add("prjectionOpacity")
            svgGraphicMaskContainer.dataset.customopacity = "0.5"
        }
        if (this.data.projection[index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.remove("clsAccentfill");
            svgGraphicMaskContainer.classList.add("aclsAccentfill");
        }
        if (this.data.projection[index] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
            svgGraphicMaskContainer.classList.remove("clsAccentfill");
            svgGraphicMaskContainer.classList.add("clsAccentfill");
        }
        element[i1].appendChild(svgGraphicMaskContainer);
        let maskElements = element[i1].querySelectorAll("#graphicmask-container");
        for (let j1 = 1; j1 < maskElements.length; j1++) {
            maskElements[0].remove()
        }
        let defs = this.data.SVGUtils.createSVGElement("defs");
        svgGraphicMaskContainer.appendChild(defs);

        let svgMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgMaskContainer, {
            id: "mask-container",
            x: "0%",
            y: "0%",
            width: "100%",
            height: "100%",
            "data-mask": "true",
        });
        svgGraphicMaskContainer.appendChild(svgMaskContainer);
        let svgRect = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(svgRect, {
            id: "rect-container",
            class: clstyle,
            x: "0%",
            y: "0%",
            width: "100%",
            height: "100%",
        });
        if (this.data.layout.itemColor == "gradient") {
            this.data.SVGUtils.assignAttributes(svgRect, {
                class: ""
            });
            this.addGradient(svgRect, svgMaskContainer)
        }

        if (this.data.layout.itemShadowValues.length > 0) {
            let filterTag = this.data.SVGUtils.createSVGElement("filter");
            defs.appendChild(filterTag)
            this.data.SVGUtils.assignAttributes(filterTag, {
                id: "f1" + index,
                x: "0",
                y: "0",
                width: "100%",
                height: "100%"
            });

            let insetFilterTag1 = this.data.SVGUtils.createSVGElement("feOffset");
            this.data.SVGUtils.assignAttributes(insetFilterTag1, {
                result: "offOut",
                in: "SourceGraphic",
                dx: this.data.layout.itemShadowValues[0],
                dy: this.data.layout.itemShadowValues[1]
            });
            filterTag.appendChild(insetFilterTag1)
            let insetFilterTag3 = this.data.SVGUtils.createSVGElement("feGaussianBlur");
            this.data.SVGUtils.assignAttributes(insetFilterTag3, {
                result: "blurOut",
                in: "offOut",
                stdDeviation: this.data.layout.itemShadowValues[2]
            });
            filterTag.appendChild(insetFilterTag3)
            let insetFilterTag2 = this.data.SVGUtils.createSVGElement("feBlend");
            this.data.SVGUtils.assignAttributes(insetFilterTag2, {
                in: "SourceGraphic",
                in2: "inOut",
                mode: "normal"
            });
            filterTag.appendChild(insetFilterTag2)
        }

        let svgContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgContainer, {
            id: "container",
            x: "0%",
            y: "0%",
            width: intGraphicsWidth + "px",
            height: "100%",
            style: "position:absolute;overflow:hidden!important",
        });
        svgMaskContainer.appendChild(svgContainer);


        // if (this.data.projection[i1] == true && this.data.hasProjection) {
        //     this.createProjection(svgContainer, i1);
        // }
        //
        let rotate = element[i1].getAttribute("data-negative") ? 180 : 0;
        let svgBaseGroup = this.data.SVGUtils.createSVGElement("g");
        this.data.SVGUtils.assignAttributes(svgBaseGroup, {
            style: rotate == 180 ? "transform-origin:center; transform:rotate(" + rotate + "deg)" : "",
            "data-animation": "shapeitem",
            "data-graphic-x": element[i1].clientWidth,
            class: "moodanimation",
        });
        // if (this.data.projection[i1] == true && this.data.hasProjection) {
        //     this.data.SVGUtils.assignAttributes(svgBaseGroup, {
        //         mask: "url(#mask" + i1 + "_" + 0 + ")",
        //     });
        // }
        svgContainer.appendChild(svgBaseGroup);
        let svgGroup = this.data.SVGUtils.createSVGElement("g");
        svgBaseGroup.appendChild(svgGroup);
        let svgAsset
        if (!this.asset) {
            svgAsset = this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0].cloneNode("true")
            this.data.SVGUtils.assignAttributes(svgAsset, {
                width: "",
                height: "",
            });
        } else {
            svgAsset = this.asset.cloneNode(true);
        }
        // let svgAsset = new DOMParser().parseFromString(this.asset, "image/svg+xml").documentElement.cloneNode(true);
        svgGroup.appendChild(svgAsset);
        let arrViewBox = svgAsset.getAttribute("viewBoxDefault") ? svgAsset.getAttribute("viewBoxDefault").split(" ") : svgAsset.getAttribute("viewboxdefault").split(" ");
        let numProportionateScale = intGraphicsHeight / arrViewBox[3];
        let numContainerProportionateScale = 100 / (numProportionateScale * 100);
        let minSize = arrViewBox[2] * (100 / intGraphicsWidth);
        //let boolMiniSize = intGraphicsWidth * 0.5 < arrViewBox[2] ? true : false;

        // let clstyle =
        //     this.data.hasEmphasis && this.data.emphasis[index] != true
        //         ? "secondary-fill"
        //         : this.data.hasEmphasis && this.data.emphasis[index] == true
        //         ? "accent" + (index + 1) + "-fill"
        //         : "accent" + (index + 1) + "-fill";
        this.data.SVGUtils.assignAttributes(svgGroup, {
            //class: clstyle,
            style: "transform : translateX(" + -parseInt(percentageDiff) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",
        }); // percentageDiff == 0  : "transform: translateX(" + -parseInt(percentageDiff*0.5) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",?
        this.data.SVGUtils.assignAttributes(svgAsset, {
            width: numContainerProportionateScale * 100 + "%",
            height: numContainerProportionateScale * 100 + "%",
        });
        this.updateSize(svgAsset, intGraphicsWidth * numContainerProportionateScale, intGraphicsHeight);
    }
}

SimpleScaleBarChart.prototype.createProjection = function (argParent, index) {
    let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
    let patternTag = this.data.SVGUtils.createSVGElement("pattern");
    this.data.SVGUtils.assignAttributes(patternTag, {
        id: "pattern",
        patternUnits: "userSpaceOnUse",
        width: "20",
        height: "20",
    });
    patternDefsTag.appendChild(patternTag);
    let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(patternMaskTag, {
        id: "mask" + index + "_" + 0,
        patternUnits: "userSpaceOnUse",
    });
    patternDefsTag.appendChild(patternMaskTag);
    let patternImageTag = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(patternImageTag, {
        "xlink:href": "#chartprojectionpattern",
    });
    patternTag.appendChild(patternImageTag);
    let patternRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(patternRect, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        fill: "url(#pattern)",
    });
    patternMaskTag.appendChild(patternRect);
    argParent.appendChild(patternDefsTag);
}

SimpleScaleBarChart.prototype.updateSize = function (svgAsset, width, height) {
    let lw = this.getViewBoxValue(svgAsset.getElementById(this.assetName.toLowerCase() + "-left"), 2);
    let rw = this.getViewBoxValue(svgAsset.getElementById(this.assetName.toLowerCase() + "-right"), 2);
    let cw = (width - (lw + rw)) + 3;
    let intpad = 1;
    cw = cw < 0 ? 1 : cw;
    cw += intpad;
    if (cw != NaN && rw != 0) {
        let x = Number(svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").getAttribute("x")) - intpad / 2;
        x = x < 0 ? 1 : x;
        svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").setAttribute("x", 1);
        svgAsset.getElementById(this.assetName.toLowerCase() + "-centerUse").setAttribute("width", cw);
    }
}

SimpleScaleBarChart.prototype.getViewBoxValue = function (element, index) {
    return element != null ? parseFloat(element.getAttribute("viewBox").split(/\s+|,/)[index]) : 0;
}



