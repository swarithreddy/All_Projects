        //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, (this.rectGrapicsItemSize.y + 4)),
        //     width: this.data.SVGUtils.createPercentValue(this.parentWidth, (this.rectGrapicsItemSize.width - 4)),
        //     height: this.data.SVGUtils.createPercentValue(this.parentHeight, (this.parentHeight - 8)),
        // });
        // yPercentage = this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y + 4);
        // widthPercentage = this.data.SVGUtils.createPercentValue(this.parentWidth, this.parentWidth - 8);
        // heightPercentage = this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.height);
    } else {
        if (this.groupIndex == this.data.seriesLength - 1) {
            // this.data.SVGUtils.assignAttributes(rectBorder, {
            //     x: this.data.SVGUtils.createPercentValue(this.parentWidth, (this.rectGrapicsItemSize.x)),
            //     width: this.data.SVGUtils.createPercentValue(this.parentWidth, (this.rectGrapicsItemSize.width - 4))
            // });
            // yPercentage = this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y);
            // heightPercentage = this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.height);
        }
        // this.data.SVGUtils.assignAttributes(rectBorder, {
        //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, (this.rectGrapicsItemSize.y + 4)),
        //     height: this.data.SVGUtils.createPercentValue(this.parentHeight, (this.parentHeight - 8)),
        // });
        // widthPercentage = this.data.SVGUtils.createPercentValue(this.parentWidth, this.parentWidth - 8);
    }
    if (widthPercentage) {
        rectBorder.style.width = widthPercentage;
    }
    if (heightPercentage) {
        rectBorder.style.height = heightPercentage;
    }
    if (yPercentage) {
        rectBorder.style.top = yPercentage;
    }
    svgElement.appendChild(rectBorder);
};
SimpleStackedPercentageSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment.show;
};

function SimpleStackedVennChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleStackedVennChart";
    BasePieChart.call(this, argparent, argprops);
}
SimpleStackedVennChart.prototype = Object.create(BasePieChart.prototype);
SimpleStackedVennChart.prototype.constructor = SimpleStackedVennChart;

SimpleStackedVennChart.prototype.seriesInstance=function(argparent, argprops) 
{
        return new window["SimpleStackedVennSeries"](argparent, argprops);
}



function SimpleStackedVennSeries(argparent, argprops) {
    this.name = "SimpleStackedVennSeries";
    BasePieSeries.call(this, argparent, argprops);
}
SimpleStackedVennSeries.prototype = Object.create(BasePieSeries.prototype);
SimpleStackedVennSeries.prototype.constructor = SimplePieSeries;
SimpleStackedVennSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.layout.hadconnector) this.applyLayout(true);
    let alignment = this.getItemAlignmentClass(this.data.layout.itemAlignment);
    let element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    // element.dataset.animation = "nodeitem";
    element.dataset.index = this.index;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    element.className = "accent" + customColorIndex + " clsMultiColorParent " + alignment;
    this.data.SVGUtils.assignAttributes(element, {
        style: "position:absolute;top:0;bottom:0;",
        class: "series accent" + customColorIndex + " clsMultiColorParent " + alignment,
    });
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    let eProps = {
        index: 0,
        groupindex: this.index,
        angle: this.props.angle,
        endangle: this.props.endangle,
        midangle: this.props.midangle,
        startangle: this.props.startangle,
        centerPointPad: this.props.centerPointPad,
    };
    this.endAngle = this.props.endangle;
    this.startAngle = this.props.startangle;
    if (this.parent) this.parent.appendChild(element);
    let seriesitem = this.seriesItemInstance(element, eProps);
    seriesitem.ChartHelper = this.ChartHelper;
    seriesitem.ChartUtils = this.ChartUtils;
    seriesitem.move(0, 0);
    seriesitem.size(this.state.width, this.state.height);
    seriesitem.data = this.data;
    this.chartGrapicsAreaSize = this.state.width;
};
SimpleStackedVennSeries.prototype.applyLayout = function (measurement = false) {
    if (measurement && this.index == 0) {
        for (let i1 = 0; i1 < this.voData.seriesLength; i1++) {
            let graphicHeightPercentage = (this.parent.clientHeight * this.data.values[i1][this.index]) / this.data._postiveMaxValue;
            if (this.data.layout.hadCallout || this.data.layout.hadconnector) {
                this.color = "";
                let intLabelMaxWidth = ((this.viewportGroup.width - this.state.width) / 2) * 0.6;
                this.data.maxValueW = intLabelMaxWidth * 0.6;
                this.data.maxValueH = 40;
                let seriesElement = this.parent;
                let graphicTopValue = seriesElement.clientHeight - graphicHeightPercentage;
                let objLayoutManager = {
                    groupIndex: i1,
                    measurement: measurement,
                    parentWidth: this.viewportGroup.width,
                    parentHeight: this.viewportGroup.height,
                    graphicsAreaWidth: this.state.width,
                    graphicsAreaHeight: this.state.height,
                    connectorWidth: ((this.viewportGroup.width - this.state.width) / 2) * 0.3,
                    graphicsAreaX: (this.viewportGroup.width - this.state.width) / 2,
                    graphicsAreaY: seriesElement.offsetTop + graphicTopValue,
                    layoutAreaHeight: this.viewportGroup.height,
                    color: this.color,
                    ChartHelper: this.ChartHelper,
                    ChartUtils: this.ChartUtils,
                    intLabelMaxWidth: intLabelMaxWidth,
                    parentElement: this.parent.parentNode,
                };
                this.layoutManagerRounded = new window["LayoutManagerVerticalDoubleSideConnector"](objLayoutManager);
                this.layoutManagerRounded.data = this.data;
                this.layoutManagerRounded.ChartHelper = this.ChartHelper;
                this.layoutManagerRounded.ChartUtils = this.ChartUtils;
                this.layoutManagerRounded.svgData;
            }
        }
    }
    if (!measurement) {
        if (this.data.layout.hadCallout || this.data.layout.hadconnector) {
            this.color = "";
            let intLabelMaxWidth = ((this.viewportGroup.width - this.state.width) / 2) * 0.6;
            this.data.maxValueW = intLabelMaxWidth * 0.6;
            this.data.maxValueH = 40;
            let seriesElement = this.parent.querySelectorAll(".series")[this.index];
            let graphicContainer = seriesElement ? seriesElement.querySelector(".graphicconatiner") : "";
            let objLayoutManager = {
                measurement: measurement,
                groupIndex: this.index,
                parentWidth: this.viewportGroup.width,
                parentHeight: this.viewportGroup.height,
                graphicsAreaWidth: this.state.width,
                graphicsAreaHeight: this.state.height,
                connectorWidth: ((this.viewportGroup.width - this.state.width) / 2) * 0.3,
                graphicsAreaX: (this.viewportGroup.width - this.state.width) / 2,
                graphicsAreaY: seriesElement.parentNode.offsetTop + graphicContainer.offsetTop,
                layoutAreaHeight: this.viewportGroup.height,
                color: this.color,
                ChartHelper: this.ChartHelper,
                ChartUtils: this.ChartUtils,
                intLabelMaxWidth: intLabelMaxWidth,
                parentElement: this.parent.parentNode,
            };
            this.layoutManagerRounded = new window["LayoutManagerVerticalDoubleSideConnector"](objLayoutManager);
            this.layoutManagerRounded.data = this.data;
            this.layoutManagerRounded.ChartHelper = this.ChartHelper;
            this.layoutManagerRounded.ChartUtils = this.ChartUtils;
            if (this.parent.parentNode) this.parent.parentNode.appendChild(this.layoutManagerRounded.svgData);
        }
    }
};

SimpleStackedVennSeries.prototype.getItemAlignmentClass = function (alignmentvalue) {
    return "cls" + alignmentvalue;
};

