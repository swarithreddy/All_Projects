function SVGUtils() {}

SVGUtils.prototype.createSVGElement = function (type) {
    let el = document.createElementNS("http://www.w3.org/2000/svg", type);
    return el;
};

SVGUtils.prototype.createElement = function (type) {
    let el = document.createElement(type);
    return el;
};

SVGUtils.prototype.createEmptySvgNode = function () {
    let blankNode = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    return blankNode;
};

SVGUtils.prototype.createEmptyGNode = function () {
    let blankNode = document.createElementNS(NS.SVG, "g");
    return blankNode;
};

SVGUtils.prototype.createCustomNode = function (nodeName) {
    let blankNode = document.createElementNS(NS.SVG, nodeName);
    return blankNode;
};

SVGUtils.prototype.createEmptySvgRect = function () {
    let blankNode = document.createElementNS(NS.SVG, "rect");
    return blankNode;
};

SVGUtils.prototype.createEmptySvgImage = function () {
    let blankNode = document.createElementNS(NS.SVG, "image");
    return blankNode;
};

SVGUtils.prototype.createEmptyUseNode = function () {
    let useNode = document.createElementNS(NS.SVG, "use");
    return useNode;
};

SVGUtils.prototype.createTextNode = function (text) {
    let textNode = document.createElementNS(NS.SVG, "text");
    //textNode.textContent=text;
    return textNode;
};

SVGUtils.prototype.createBlankSlide = function () {
    let blankSlide = SVGUtils.createElement("div");

    let objAttr = {
        id: IDUtils.uuidv4(),
    };
    const strDefaultClassName = LayoutHelper.getDefaultSlideClassName();
    let strCurrentFontName = DocumentThemesHelper.getInstance().currentFontName;

    objAttr["data-type"] = "SLIDE";
    objAttr["data-layout"] = strDefaultClassName;
    objAttr["data-font"] = strCurrentFontName;

    let tempClass = DocumentMoodsHelper.getInstance().moodsName + " mood ";
    objAttr["class"] = tempClass + "commonLayout " + strDefaultClassName + " " + strCurrentFontName;
    SVGUtils.assignAttributes(blankSlide, objAttr);

    let divBG = SVGUtils.createElement("div");
    SVGUtils.assignAttributes(divBG, { id: "BG", class: "BG", "data-type": "BG" });
    blankSlide.appendChild(divBG);

    let divGraphic = SVGUtils.createElement("div");
    SVGUtils.assignAttributes(divGraphic, { id: "GRAPHIC", class: "GRAPHIC", "data-type": "GRAPHIC" });
    blankSlide.appendChild(divGraphic);

    ImageUtils.createLayoutShape(blankSlide, "add");

    return blankSlide;
};

SVGUtils.prototype.createLabel = function (text) {
    const strText = text && text != "" ? text : "";
    let textLabelDiv = SVGUtils.createElement("div");
    let strFontClassName = PresetThemeHelper.getFontClassName("slidelabel", null, false).withoutgraphic;
    let strClassName = "SLIDE_LABEL backgroundColorBg " + strFontClassName + " ";

    SVGUtils.assignAttributes(textLabelDiv, {
        id: "SLIDE_LABEL",
        class: strClassName,
        "data-type": "SLIDE_LABEL",
        contentEditable: "true",
       "data-dck-selector": "true",
        "data-editable": "true",
        "data-texthalign": "center",
        "data-bgopacity": "100",
        "data-prompt-text": AppConstant.PROMPT_SLIDE_LABEL,
    });
    textLabelDiv.innerText = strText;
    return textLabelDiv;
};

SVGUtils.prototype.createTitle = function (text) {
    const strText = text == AppConstant.PROMPT_SLIDE_TITLE || !text ? "" : text;
    let textTitle = SVGUtils.createElement("div");
    let strFontClassName = PresetThemeHelper.getFontClassName("title", null, false).withoutsubtitle.withoutgraphic;
    let strClassName = "TITLE transparentBg " + strFontClassName + " ";

    SVGUtils.assignAttributes(textTitle, {
        id: "TITLE",
        class: strClassName,
        "data-type": "TITLE",
        contentEditable: "true",
        "data-dck-selector": "true",
        "data-editable": "true",
        "data-texthalign": "center",
        "data-bgopacity": "100",
        "data-prompt-text": AppConstant.PROMPT_SLIDE_TITLE,
    });
    textTitle.innerText = strText;
    return textTitle;
};

SVGUtils.prototype.createSubtitle = function (text) {
    const strText = text && text != "" ? text : "";
    let textSubTitle = SVGUtils.createElement("div");
    let strFontClassName = PresetThemeHelper.getFontClassName("subtitle", null, false).withoutgraphic;
    let strClassName = "SUBTITLE backgroundColorBg " + strFontClassName + " ";

    SVGUtils.assignAttributes(textSubTitle, {
        id: "SUBTITLE",
        class: strClassName,
        "data-type": "SUBTITLE",
        contentEditable: "true",
        "data-dck-selector": "true",
        "data-editable": "true",
        "data-texthalign": "center",
        "data-bgopacity": "100",
        "data-prompt-text": AppConstant.PROMPT_SLIDE_SUB_TITLE,
    });
    textSubTitle.innerText = strText;
    return textSubTitle;
};

SVGUtils.prototype.createTextBox = function (text, type = "TEXTBOX") {
    let elTextBox = SVGUtils.createElement("div");
    SVGUtils.assignAttributes(elTextBox, { id: "TEXTBOX", class: "TEXTBOX", "data-type": type, "data-animation": type == "TEXTBOX" ? "textbox" : "takeaway" });
    return elTextBox;
};

SVGUtils.prototype.addTextBox = function (strSlideID, elTextBox, text, type = "TEXTBOX") {
    const strText = text && text != "" ? text : "";
    let elTextBoxEditorHolder = SVGUtils.createElement("div");
    SVGUtils.assignAttributes(elTextBoxEditorHolder, { id: "TEXTBOX_HOLDER", class: "textBoxEditorHolder" });

    if (type == "TEXTBOX") {
        let strFontClassName = PresetThemeHelper.getFontClassName("textbox", null, false).withoutgraphic;
        let strClassName = "textBoxEditor transparentBg " + strFontClassName;
        let slideObj = DocumentStore.getInstance().getSlideDetails(strSlideID);
        let currentLayout = slideObj.content.dataset.layout;
        if (currentLayout == "textBoxLayoutTitleTopRight") strClassName = "textBoxEditor titleColorBg " + strFontClassName;
        let elTextBoxEditor = SVGUtils.createElement("div");
        SVGUtils.assignAttributes(elTextBoxEditor, {
            id: "TEXTBOX_EDITOR",
            class: strClassName,
            contenteditable: "true",
            "data-dck-selector": "true",
            "data-prompt-text": AppConstant.PROMPT_SLIDE_TEXT_BOX,
        });
        elTextBoxEditor.innerText = strText;
        elTextBox.appendChild(elTextBoxEditorHolder);
        elTextBoxEditorHolder.appendChild(elTextBoxEditor);
    } else if (type == "GRID" || type == "GRIDTEXT") {
        let arrImage = [];
        for (let i = 0; i < 2; i++) {
            arrImage.push({
                type: "image",
                value: "", //IndexStore.getInstance().staticServerURL + "genericassets/placeholderimages/logoplaceholder.png",
                contenttype: "logo",
            });
        }
        let objGridData = { gridimages: arrImage };
        if (type == "GRIDTEXT") objGridData.gridtitle = { type: "text", value: "Sample" };
        let gridInstance = new window["SimpleImageGrid"](elTextBoxEditorHolder, objGridData);
        gridInstance.initDiagramCreation();
        if (type == "GRIDTEXT") elTextBoxEditorHolder.className = "clsLinearImageGridVertical";
        elTextBox.appendChild(elTextBoxEditorHolder);
    } else {
        let menuType = "list";
        if (type == "TAKEAWAY_TEXT") menuType = "singlelist";
        TextBoxPropertyUtils.createTakeAwayText(strSlideID, null, menuType);
    }
};

SVGUtils.prototype.createTextBg = function () {
    let textBgElement = SVGUtils.createElement("div");
    textBgElement.id = "textBg";
    textBgElement.classList.add("textBg");
    textBgElement.classList.add("moodanimation");
    textBgElement.classList.add("transparentBg");
    textBgElement.setAttribute("data-animation", "textbg");
    return textBgElement;
};

SVGUtils.prototype.createTextElement = function () {
    let targetNode = document.getElementsByClassName("commonLayout")[0];
    DocumentMoodsHelper.getInstance().applyTextElementToTitleSubtitle(targetNode);
};

SVGUtils.prototype.createImage = function (strSlideID, objImageData, boolUpdateLayout = true) {
    const imageID = objImageData.imageID;
    const imageURL = objImageData.imageURL;
    const imageWidth = objImageData.imageWidth;
    const imageHeight = objImageData.imageHeight;

    let nodeImage = SVGUtils.createElement("img");
    nodeImage.style.setProperty("width", "auto");
    nodeImage.style.setProperty("height", "100%");
    nodeImage.style.setProperty("object-fit", "unset");
    SVGUtils.assignAttributes(nodeImage, {
        "data-type": "IMAGE",
        src: imageURL,
        id: imageID,
        "data-width": imageWidth,
        "data-height": imageHeight,
    });

    if (boolUpdateLayout) {
        DocumentStore.getInstance().updateSlideLayout(strSlideID, "image", undefined, objImageData);
    }
    return nodeImage;
};

// Parameters:
// node - DOM element to apply new attribute values to
// attrs - Object with attribute keys/values
// unitCheck - Boolean to indicate the need to use SVGUtils.setUnitAttr
SVGUtils.prototype.assignAttributes = function (node, attrs, unitCheck) {
    for (let i1 in attrs) {
        try {
            let ns = i1.substr(0, 4) === "xml:" ? "http://www.w3.org/2000/xmlns/" : i1.substr(0, 6) === "xlink:" ? "http://www.w3.org/1999/xlink" : null;
            if (ns) {
                node.setAttributeNS(ns, i1, attrs[i1]);
            } else if (!unitCheck && node&&attrs[i1]) {
                node.setAttribute(i1, attrs[i1]);
            }
        } catch (error) {
            console.log(error);
        }
        // else {
        //   SVGUtils.setUnitAttr(node, i1, attrs[i1]);
        // }
    }
};

SVGUtils.prototype.assignStyleProperty = function (node, attrs) {
    for (let i1 in attrs) {
        node.style.setProperty(i1, attrs[i1]);
    }
};

SVGUtils.prototype.createPercentValue = function (actualValue, computedValue) {
    let tempPercent = computedValue / actualValue;
    tempPercent = tempPercent * 100;
    return tempPercent + "%";
};

SVGUtils.prototype.removeStyleProperty = function (nodeSource, strProperty) {
    try {
        if (nodeSource && nodeSource.style && strProperty && strProperty != "") {
            if (nodeSource.style.removeProperty) {
                nodeSource.style.removeProperty(strProperty);
            } else {
                nodeSource.style.removeAttribute(strProperty);
            }
        }
    } catch (error) {
        console.log("Remove Style Property Error..." + error);
    }
};

function chartAssetsLoader() {
    this.params = "";
}

chartAssetsLoader.prototype.loadAssets = function (arrayAssets, boolCorporate = false, boolLoadImages = true, appAssetURL = "./") {
    this.isCorporateAsset = boolCorporate;
    this.intLoadCount = 0;

    this.loadCount = 0;
    return new Promise((resolve, reject) => {
        if (!arrayAssets || arrayAssets.length === 0) {
            resolve(this.params);
            return;
        }
        for (let i = 0; i < arrayAssets.length; i++) {
            if (arrayAssets[i]) {
                const strAssetUrl = arrayAssets[i].url;
                let strAssetPrefixURL = appAssetURL;
                strAssetPrefixURL = !!arrayAssets[i].corporateUrl && arrayAssets[i].corporateUrl != "" ? appCorporateURL : strAssetPrefixURL;
                this.downloadAsset(arrayAssets, strAssetPrefixURL + strAssetUrl, i, resolve, reject);
            } else {
                this.loadCount = this.loadCount + 1;
                if (arrayAssets.length == this.loadCount) resolve();
            }
        }
    });
};

chartAssetsLoader.prototype.downloadAsset = function (arrayAssets, assetURL, index, resolve, reject, diagramParent) {
    const xhr = new XMLHttpRequest();
    let chartUtils = new window["ChartUtils"]();
    xhr.open("GET", assetURL);
    xhr.onload = (data) => {
        arrayAssets[index].data = data.target.response;
        chartUtils.appenDefs(arrayAssets[index], document.querySelector("#elementslide"));
        if (arrayAssets.length - 1 == index) resolve(this.params);
    };

    xhr.onerror = () => {
        this.loadCount++;
        if (arrayAssets.length - 1 == index) resolve(this.params);
        console.log("File could not be loaded..." + xhr.statusText);
    };
    xhr.send();
};

let menuDetails = null;
let chartInstance;
function ChartBuilder(argParams) {
    this.width = 900;
    this.height = 550;
    this.svgDiv = null;
    this.xmlData = null;
    this.oldXmlData = null;
    this.params = argParams;
    this.assetObjectDeatiles;
    this.designerUI = false;
    this.addoperation = false;
    this.ChartUtils = new window["ChartUtils"]();
    this.ChartHelper = new window["ChartHelper"]();
}
ChartBuilder.prototype.addListener = function (event, callback) {
    this.ChartHelper.eventManager.addListener(event, callback);
};

ChartBuilder.prototype.getAssets = function (objDetails, slide, xmldata) {
    let ChartDataGenerator = new window["ChartDataGenerator"]();
    let ChartUtils = new window["ChartUtils"]();
    this.assetObjectDeatiles = objDetails;
    this.parent = objDetails.parent;
    this.slideID = objDetails.slideId; //this.parent.id;

    //saranya
    /* if (objDetails.moodchange && objDetails.moodchange == true) {
        this.changeMenuMoodsData(objDetails, xmldata)
    } */

    if (objDetails.slideobj || objDetails.item) {
        if (!!xmldata) {
            this.xmlData = xmldata;
            this.presentData = true;
        } else {
            this.presentData = false;
            this.xmlData = objDetails.xmldata ? objDetails.xmldata : objDetails.slideobj.content.querySelector("desc") ? objDetails.slideobj.content.querySelector("desc").children[0] : "";
            this.oldXmlData = this.xmlData ? this.xmlData.cloneNode(true) : "";
        }
        if (!objDetails.item && this.xmlData) {
            let chartItem = objDetails.property == "fontsize" ? objDetails.value : this.xmlData.getAttribute("name");
            ChartUtils.getChartSupportData(chartItem, objDetails, this.xmlData, objDetails.moodsData);
        }
    } else this.xmlData = objDetails.chartData; //ChartHelper.getData(objDetails.dataType);
    if (objDetails.operation == "paste" || objDetails.operation == "redraw" || !this.xmlData) {
        this.xmlData = ChartDataGenerator.outlineChartData(objDetails.menu, true, this.designerUI);
    }

    if (!xmldata) {
        ChartDataGenerator.propertyUpdation(this.xmlData, objDetails, this.designerUI);
        if (objDetails.operation != "redraw") {
            ChartUtils.validationForMinValue(this.xmlData, true);
        } else {
            ChartUtils.assetNodeCountChange(this.xmlData, this.oldXmlData, objDetails);
        }
        this.applyRules(this.xmlData, objDetails);

        // ChartDataValidation.doLayoutValidation(this.xmlData, null, false);
        //ChartHelper.getChartLayoutlistDataByName(this.xmlData.getAttribute("name"));

        ChartDataGenerator.assignproperty(this.xmlData, objDetails);
        menuDetails = objDetails;
        this.ChartUtils.setmenuData(menuDetails);
    }

    //if (objDetails.moodsData) ChartUtils.applyMoodsData(objDetails.moodsData, this.xmlData, this.slideID, objDetails.repeat, objDetails);
    this.chartName = objDetails.menu ? objDetails.menu.classname : this.xmlData.getAttribute("data-classname") ? this.xmlData.getAttribute("data-classname") : this.xmlData.getAttribute("name");
    this.xmlData.setAttribute("name", this.chartName);
    this.chartLayout = this.xmlData.getAttribute("layout");

    //SANKAR ASSET LOADING PROCESS
    //this.chartAsset = this.getChartAssetList({ slideID: this.slideID, elementID: "", chartName: this.chartName }, this.xmlData);
    //objDetails.assets = this.chartAsset.arrAssets;

    this.chartAsset = this.ChartHelper.getChartAssetList({ slideID: this.slideID, elementID: "", chartName: this.chartName }, this.xmlData);
    objDetails.assets = this.chartAsset.arrAssets;
    objDetails.chartData = this.xmlData;
    objDetails.presentData = this.presentData;

    let className = this.xmlData.getAttribute("data-classname");
    let objLayout = this.ChartHelper.getLayout(objDetails, this.chartName, className, this.xmlData);
    let secondaryObject = null;
    if (this.chartName == "statisticalBarSimpleRectangle" || this.chartName == "barSimpleRectangle" || this.chartName == "columnSimpleRectangle" || this.chartName == "barSimpleRectangleFill") {
        let boolMultiseries = this.xmlData.children[0].getAttribute("value").split(",").length > 1 ? true : false;
        if (boolMultiseries) {
            if (this.chartName == "columnSimpleRectangle") {
                secondaryObject = this.ChartHelper.getLayout(objDetails, this.chartName, className, this.xmlData, boolMultiseries, true);
            } else {
                secondaryObject = this.ChartHelper.getLayout(objDetails, this.chartName, className, this.xmlData, boolMultiseries);
            }
        }
    }
    if (secondaryObject) {
        objLayout.value = secondaryObject.value;
        objLayout.label = secondaryObject.label;
        objLayout.placeholder = secondaryObject.placeholder;
        if (secondaryObject.common) {
            objLayout.common = secondaryObject.common;
        }
    }
    objDetails.layout = objLayout;
};

ChartBuilder.prototype.buildAsset = function (objDetails, argParent, instancedetail = {}, designerui = false) {
    let objAnimationType = {
        animationoff: "none",
        animateallatonce: "all",
        animateoneatatime: "one",
    };

    this.xmlData = this.xmlData ? this.xmlData : objDetails.chartData;
    this.chartName = objDetails?.menu?.classname ? objDetails.menu.classname : this.xmlData.getAttribute("data-classname") ? this.xmlData.getAttribute("data-classname") : this.xmlData.getAttribute("name");
    this.presentData = objDetails.presentData;
    let animationType = this.xmlData.getAttribute("animation");
    animationType = animationType && objAnimationType[animationType] ? objAnimationType[animationType] : "all";
    let slideObj1 = objDetails.slideobj ? objDetails.slideobj : { content: argParent };
    let graphic1 = slideObj1.content.querySelector("[id='GRAPHIC']");
    if (instancedetail.takeaway) {
        graphic1 = slideObj1.content.querySelector("[id='TEXTBOX_GRAPHIC_HOLDER']");
    }
    if (objDetails.graphicDiv) {
        graphic1 = objDetails.graphicDiv;
    }
    let strGraphicPadding = window.getComputedStyle(graphic1);
    /* if (objDetails.moodsData && objDetails.moods) {
        let menuData = objDetails.menu ? objDetails.menu : null;
        let menuName = menuData.name ? menuData.name : "";
        if (menuData && menuName) {
            SlideUtils.updateUniqueLayout(this.slideID, menuName, "chart", menuData);
        }

    } */
    let basechart = document.createElement("div");
    let divParent = document.createElement("div");
    divParent.appendChild(basechart);
    let graphicDiv = this.getGraphicDiv(this.slideID, slideObj1);
    if (instancedetail.takeaway) {
        graphicDiv = slideObj1.content.querySelector("[id='TEXTBOX_GRAPHIC_HOLDER']");
    }
    if (objDetails.graphicDiv) {
        graphicDiv = objDetails.graphicDiv;
    }
    // graphicDiv.parentElement.setAttribute("data-slidetype", data.type);
    let oldElement; // = cloneElementDiv; //document.getElementById("ELEMENT_DIV");
    divParent.className = "slide";
    if (this.presentData) {
        divParent.classList.add("dummeyClass");
    } else {
        divParent.classList.remove("dummeyClass");
        if (oldElement) oldElement.remove();
    }
    if (graphicDiv) {
        graphicDiv.appendChild(divParent);
    } else {
        return;
    }
    basechart.id = "base-chart";
    basechart.dataset.classname = this.chartName;
    let hasDirection = window.getComputedStyle(basechart)["direction"] == "rtl";

    let boundsPadding = strGraphicPadding ? { right: parseFloat(strGraphicPadding["paddingRight"]), left: parseFloat(strGraphicPadding["paddingLeft"]), top: parseFloat(strGraphicPadding["paddingTop"]), bottom: parseFloat(strGraphicPadding["paddingBottom"]) } : { right: 0, left: 0, top: 0, bottom: 0 };
    let graphicWidth = graphic1.clientWidth - (boundsPadding.left + boundsPadding.right);
    let graphicHeight = graphic1.clientHeight - (boundsPadding.top + boundsPadding.bottom);
    let graphicSize = { width: graphicWidth, height: graphicHeight };
    let widthPadding = this.xmlData.getAttribute("data-widthpadding") ? Number(this.xmlData.getAttribute("data-widthpadding")) : 0;
    let heightPadding = this.xmlData.getAttribute("data-heightpadding") ? Number(this.xmlData.getAttribute("data-heightpadding")) : 0;
    let graphicPadding = this.xmlData.getAttribute("data-graphicpadding") ? this.xmlData.getAttribute("data-graphicpadding") : "";
    this.width = parseInt(graphicSize.width) - widthPadding;
    this.height = parseInt(graphicSize.height) - heightPadding;
    divParent.id = "ELEMENT_DIV";
    divParent.style.position = "absolute";
    divParent.setAttribute("data-dck-selector", "true");
    divParent.style.top = "0px";
    divParent.style.width = this.width + "px";
    divParent.style.height = this.height + "px";
    if (!this.xmlData.getAttribute("data-slidebg")) {
        divParent.style.width = this.width + "px";
        divParent.style.height = this.height + "px";
    }

    const gridsize = 4;
    const gridRow = parseInt(this.width / gridsize);
    const gridColumn = parseInt(this.height / gridsize);
    let gridWidth = gridsize * gridRow;
    let gridHeight = gridsize * gridColumn;
    const gridX = (this.width - gridWidth) / 2;
    const gridY = (this.height - gridHeight) / 2;
    const eprops = { gridsize: gridsize, gridrow: gridRow, gridcolumn: gridColumn, parentwidth: this.width, parentheight: this.height };

    // this.xmlData.setAttribute("legendposition", "bottom");
    let className = this.xmlData.getAttribute("data-classname");
    let jsonChartItemMetaData = this.ChartHelper.getChartProperty("name", className)[0]; //chartListData.nameobjDetails.className;
    if (jsonChartItemMetaData && this.mooddata?.data?.rtlsupport) jsonChartItemMetaData.direction = this.mooddata?.data?.rtlsupport && hasDirection;
    let voBaseProperties = new window["VOBaseProperties"](jsonChartItemMetaData);
    let objLayout = objDetails.layout ? objDetails.layout : objDetails.menu ? objDetails.menu.chartlayout : "";
    let objMenu = objDetails.menu ? objDetails.menu : "";
    if (this.designerUI) {
        objLayout = objDetails.menu ? objDetails.menu.chartlayout : objLayout;
        objMenu = objDetails.menu ? objDetails.menu : "";
    }
    let voLayout = new window["VOLayout"](objLayout, this.xmlData, objMenu, slideObj1.content, voBaseProperties, this.mooddata.data, hasDirection); //new VOLayout(objLayout, this.xmlData);
    let calloutInstancevalue = this.calloutmethod ? this.calloutmethod.func : "";
    let defultcontentfunction = this.defaulContentNode ? this.defaulContentNode.func : "";
    let chartredrawopertion = this.chartredrawopertaion ? this.chartredrawopertaion.func : "";
    let menuParser = this.menuparser ? this.menuparser.func : "";
    let moodsData = this.mooddata ? this.mooddata.data : "";
    let tintArray = this.tintarray ? this.tintarray : "";
    if (!instancedetail && calloutInstancevalue) {
        instancedetail = {};
        instancedetail.calloutInstance = calloutInstancevalue;
    } else {
        if (calloutInstancevalue && instancedetail) instancedetail.calloutInstance = calloutInstancevalue;
    }
    if (!instancedetail && defultcontentfunction) {
        instancedetail = {};
        instancedetail.defaultcontentInstance = defultcontentfunction;
    } else {
        if (defultcontentfunction && instancedetail) instancedetail.defaultcontentInstance = defultcontentfunction;
    }
    if (!instancedetail && tintArray) {
        instancedetail = {};
        instancedetail.tintarray = tintArray;
    } else {
        if (tintArray && instancedetail) instancedetail.tintarray = tintArray;
    }
    if (!instancedetail && menuParser) {
        instancedetail = {};
        instancedetail.menuparser = menuParser;
    } else {
        if (menuParser && instancedetail) instancedetail.menuparser = menuParser;
    }
    if (!instancedetail && chartredrawopertion) {
        instancedetail = {};
        instancedetail.chartRedraw = chartredrawopertion;
    } else {
        if (chartredrawopertion && instancedetail) instancedetail.chartRedraw = chartredrawopertion;
    }
    if (!instancedetail && moodsData) {
        instancedetail = {};
        instancedetail.moodData = moodsData;
    } else {
        if (moodsData && instancedetail) instancedetail.moodsData = moodsData;
    }
    var voCustomProperties = new window["VOCustomProperties"]({
        data: this.xmlData,
        voLayout: voLayout,
        currentslide: slideObj1.content,
        // asset: this.objItamAsset,
        baseProperties: jsonChartItemMetaData,
    });
    let voData = new window["VOData"]({
        slideID: this.slideID,
        data: this.xmlData,
        baseProperties: voBaseProperties,
        customProperties: voCustomProperties,
        voLayout: voLayout,
        presentMode: this.presentData,
        objDetails: objDetails,
        slideobj: objDetails.slideobj ? objDetails.slideobj.content : slideObj1.content,
        currentslide: slideObj1.content,
        objInstanceDeatil: instancedetail,
        divParent: divParent,
        hasdirection: hasDirection,
    });
    let voAsset = new window["VOAsset"](objDetails.assets, voLayout); //VOAsset(objDetails.assets, voLayout);

    // let objList = ChartHelper.getChartListDataByName(this.chartName);
    voData.asset = voAsset;
    voData.layout = voLayout;
    voData.currentElementDiv = divParent;
    ///////////
    let slideObj = slideObj1;
    let cloneElementDiv = slideObj ? slideObj.content.querySelector("div[id='ELEMENT_DIV']") : "";
    let strGraphicTemplateJson = cloneElementDiv ? cloneElementDiv.getAttribute("data-json-graphic-template-details") : "";
    ///////

    if (graphicPadding) divParent.style.padding = graphicPadding;
    divParent.dataset.slideid = this.slideID;
    //  divParent.dataset.rendertype = "chart";
    if (strGraphicTemplateJson) divParent.setAttribute("data-json-graphic-template-details", strGraphicTemplateJson);
    if (this.xmlData.getAttribute("data-animateid")) {
        divParent.dataset.cssanimation = true;
        divParent.dataset.graphicanimateid = this.xmlData.getAttribute("data-animateid");
    }
    if (voLayout.legendGlopalStyle) {
        basechart.classList.add(voLayout.legendGlopalStyle);
    }

    if (voData.chartFlip) {
        basechart.className = voBaseProperties.family + " basechart chartflip";
    } else {
        basechart.className = this.xmlData.getAttribute("changetablecontent") != "true" ? voBaseProperties.family + " basechart" : "charttable basechart";
    }
    if (this.xmlData.getAttribute("changetablecontent") == "true") {
        basechart.dataset.tablecontent = true;
    }
    if (voData._labelTextBold) {
        basechart.classList.add("labelbold");
    } else {
        basechart.classList.remove("labelbold");
    }

    if (voData._labelTextItalic) {
        basechart.classList.add("labelitalic");
    } else {
        basechart.classList.remove("labelitalic");
    }
    basechart.style.width = gridWidth + "px";
    basechart.style.height = gridHeight + "px";
    basechart.style.gridTemplateRows = "repeat(" + parseInt(gridHeight / gridsize) + ", " + gridsize + "px)";
    basechart.style.gridTemplateColumns = "repeat(" + parseInt(gridWidth / gridsize) + ", " + gridsize + "px)";
    basechart.dataset.animationtype = animationType;
    basechart.style.setProperty("--bg-opacity", "1");
    basechart.style.setProperty("--border-opacity", "1");
    basechart.style.setProperty("--node-icon-opacity", "1");
    basechart.style.setProperty("--customItemlineopacity", "0.5");
    if ((animationType == "one" && this.chartName != "columnSimpleRectangle" && this.chartName != "barSimpleRectangle") || this.chartName != "statisticalBarSimpleRectangle") {
        basechart.dataset.secondarytype = "all";
    }
    if (animationType == "one" && this.xmlData.children.length == 1 && (this.chartName == "barStackedRectangle" || this.chartName == "columnStackedRectangle")) {
        basechart.dataset.animationtype = "all";
    }
    if (voBaseProperties.catagorie) {
        basechart.setAttribute("data-category", voBaseProperties.catagorie);
    }
    let secondaryBaseChart = document.createElement("div");
    secondaryBaseChart.classList.add("secondarybasechart");
    basechart.appendChild(secondaryBaseChart);
    let titleBounds = { height: 0, width: 0 };
    if (this.xmlData.getAttribute("changetablecontent") != "true") {
        titleBounds = this.createChartTitleText(basechart, gridWidth, gridHeight, secondaryBaseChart, voData, instancedetail);
    }
    let titleTextHeight = titleBounds.height;
    let titleTextWidth = titleBounds.width;
    gridHeight -= titleTextHeight;
    gridWidth -= titleTextWidth;
    this.width -= titleTextWidth;
    this.height -= titleTextHeight;
    let sorceBounds = { width: 0, height: 0 };
    if (this.xmlData.getAttribute("changetablecontent") != "true") {
        sorceBounds = this.createSourceText(basechart, gridWidth, gridHeight, secondaryBaseChart, voData, instancedetail, titleBounds);
    }
    let sourceTextHeight = sorceBounds.height;
    let sourceTextWidth = sorceBounds.width;
    gridHeight -= sourceTextHeight;
    gridWidth -= sourceTextWidth;
    this.width -= sourceTextWidth;
    this.height -= sourceTextHeight;
    secondaryBaseChart.style.width = gridWidth + "px";
    secondaryBaseChart.style.height = gridHeight + "px";
    secondaryBaseChart.style.gridTemplateRows = "repeat(" + parseInt(gridHeight / gridsize) + ", " + gridsize + "px)";
    secondaryBaseChart.style.gridTemplateColumns = "repeat(" + parseInt(gridWidth / gridsize) + ", " + gridsize + "px)";
    if (!this.presentData && designerui) {
        let prevNode = graphicDiv.querySelector(".clsElementBG");
        if (prevNode) prevNode.remove();
        let backgroundElement = document.createElement("div");
        backgroundElement.className = "clsElementBG moodanimation";
        backgroundElement.dataset.animation = "graphicbg";
        graphicDiv.insertBefore(backgroundElement, divParent);

        let strLayoutStyle = graphicDiv.parentElement.dataset.layoutstyle;
        let objLayoutJson = window.layoutJSON;

        if (strLayoutStyle && strLayoutStyle != "" && objLayoutJson) {
            let objCommonLayoutJson = objLayoutJson["commonlayout"];
            let objGridDetails = objCommonLayoutJson[strLayoutStyle.split("_")[0]][strLayoutStyle.split("_")[1]];
            updateGridProperties(backgroundElement, objGridDetails, "element");
        }

        if (graphicDiv) {
            graphicDiv.appendChild(divParent);
        } else {
            return;
        }
    }
    // let boolMultiColor = this.xmlData.getAttribute("data-multicolor") || voData._customProperties.showMergeItems ? true : false;
    // if ((jsonChartItemMetaData.family == "column" || jsonChartItemMetaData.family == "bar") && this.xmlData.children[0].getAttribute("value").split(",").length > 1) boolMultiColor = true;
    // let themeBgColor = slideObj1.content.getAttribute("data-theme-group-name") ? slideObj1.content.getAttribute("data-theme-group-name") : "secHighlightWhitebg";
    // if (boolMultiColor) {
    //     themeBgColor = themeBgColor == "sngHighlightWhitebg" ? "secHighlightWhitebg" : themeBgColor;
    //     slideObj.content.classList.remove("secHighlightWhitebg")
    //     OperationsManager.getInstance().doSlideGraphicThemeChangeOperation(this.slideID, "graphic", -1, themeBgColor);
    //     slideObj.content.classList.remove("sngHighlightWhitebg")
    //     PresetThemeHelper.getMultiColorClassName(slideObj.content, null, "add");
    // } else {
    //     let themeBgColor1 = themeBgColor == "secHighlightWhitebg" ? "sngHighlightWhitebg" : themeBgColor;
    //     slideObj.content.classList.remove("secHighlightWhitebg")
    //     slideObj.content.classList.remove("sngHighlightWhitebg")
    //     PresetThemeHelper.getMultiColorClassName(slideObj.content, null, "remove");
    //     slideObj.content.classList.remove(themeBgColor);
    //     slideObj.content.classList.add(themeBgColor1);
    // }
    let mainClass = jsonChartItemMetaData.class;
    if (this.xmlData.getAttribute("changetablecontent") == "true") {
        mainClass = "SimpleTable";
    }
    this.uiChart = new window[mainClass](secondaryBaseChart, { gridsize: gridsize, gridrow: gridRow, gridcolumn: gridColumn, parentwidth: this.width, parentheight: this.height });
    this.uiChart.ChartHelper = this.ChartHelper;
    this.uiChart.ChartUtils = this.ChartUtils;
    this.uiChart.data = voData;
    this.uiChart.move(gridX, gridY);
    this.uiChart.size(gridWidth, gridHeight);

    ///For hightlight
    if (jsonChartItemMetaData.highlightCalloutType) this.xmlData.setAttribute("calloutType", jsonChartItemMetaData.highlightCalloutType);

    let moodsName = slideObj.content.getAttribute("class").split("mood")[0];
    this.xmlData.setAttribute("data-mood", moodsName);
    // this.xmlData.setAttribute("data-family", jsonChartItemMetaData.family);
    let SVGUtils = new window["SVGUtils"]();
    let divDesc = SVGUtils.createSVGElement("desc");
    divParent.appendChild(divDesc);
    divDesc.appendChild(this.xmlData.cloneNode(true));
    if (instancedetail.takeaway) {
        let elementDiv = graphicDiv.querySelectorAll("#ELEMENT_DIV");
        if (elementDiv.length > 1) {
            if (elementDiv[0].clientHeight > 1) graphicDiv.removeChild(elementDiv[0]);
        }
    }
    return divParent;

    ////////
};
ChartBuilder.prototype.createSourceText = function (basechart, gridWidth, gridHeight, secondaryBaseChart, voData, instancedetail, titleBounds) {
    if (voData.enableSorceText == "true") {
        let element = document.createElement("div");
        element.className = "chartSource chartsourcetextparent";
        element.style.zIndex = "1";
        element.style.gridColumnStart = 1;
        element.style.gridColumnEnd = Math.round(gridWidth / 4);
        element.style.gridRowStart = 1;
        element.style.gridRowEnd = Math.round(250 / 4);
        if (voData.sourcetextAlign) {
            element.classList.add(voData.sourcetextAlign);
        }
        basechart.appendChild(element);
        let themeClassName = "p7";
        if (instancedetail && instancedetail.fontsData && instancedetail.fontsData.sourcetext) {
            themeClassName = instancedetail.fontsData.sourcetext;
        }

        let subelement = document.createElement("div");
        subelement.className = "chartSourcetext moodanimation  chartsourcetextchild " + themeClassName;
        subelement.id = "chartSourcetext-text";
        subelement.style.zIndex = "1";
        subelement.style.height = "auto";
        subelement.innerHTML = voData.sourcetext;
        subelement.setAttribute("maxFontSize", 30);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "sourcetext");
        subelement.setAttribute("data-animation", "sourcetext");
        subelement.setAttribute("data-prompt-text", "Enter your source text");
        this.ChartHelper.setTextChangeListner(subelement);
        element.appendChild(subelement);
        if (voData._sourceTextColor) {
            subelement.style.setProperty("color", voData._sourceTextColor, "important");
            TextHighLightUtils.clearStylesBasedOnType(subelement, "textcolor");
        }
        if (voData.moodData.theme && voData.moodData.theme && voData.moodData.theme.textcolormapping && voData.moodData.theme.textcolormapping.source) {
            subelement.style.color = voData.moodData.theme.textcolormapping.source;
        }
        if (voData.sourceTextLineHeight) subelement.style.lineHeight = voData.sourceTextLineHeight;
        if (voData.sourceTextLetterSpace) subelement.style.letterSpacing = voData.sourceTextLetterSpace + "em";
        let parentBg = window.getComputedStyle(element)["background-color"];
        let childBg = window.getComputedStyle(subelement)["background-color"];
        if (childBg != "rgba(0, 0, 0, 0)" || parentBg != "rgba(0, 0, 0, 0)") {
            subelement.classList.add("charttitleColorBg");
        } else {
            subelement.classList.add("transparentBg");
        }
        let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : 0;
        let paddingTop = window.getComputedStyle(subelement)["padding-top"] ? parseFloat(window.getComputedStyle(subelement)["padding-top"]) : 0;
        let paddingBottom = window.getComputedStyle(subelement)["padding-bottom"] ? parseFloat(window.getComputedStyle(subelement)["padding-bottom"]) : 0;
        let marginTop = window.getComputedStyle(element)["margin-top"] ? parseFloat(window.getComputedStyle(element)["margin-top"]) : 0;
        let marginBottom = window.getComputedStyle(element)["margin-bottom"] ? parseFloat(window.getComputedStyle(element)["margin-bottom"]) : 0;
        let totalHeight = lineHeight * 3 + paddingTop + paddingBottom;
        if (totalHeight < subelement.clientHeight) {
            subelement.style.height = totalHeight + "px";
        }
        subelement.style.maxHeight = totalHeight + "px";
        let position = "bottom";
        switch (position) {
            case "top":
                element.style.gridRowStart = 1;
                element.style.gridRowEnd = Math.round(subelement.clientHeight / 4);
                secondaryBaseChart.style.gridRowStart = Math.round(subelement.clientHeight / 4);
                secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight - subelement.clientHeight) / 4);
                return { x: 0, y: 0, width: 0, height: subelement.clientHeight + marginBottom };
                break;
            case "bottom":
                if (titleBounds.height == 0 || !titleBounds.height) secondaryBaseChart.style.gridRowStart = 1;
                let gridStart = secondaryBaseChart.style.gridRowStart;
                let gridEnd = Math.round((gridHeight - subelement.clientHeight - marginTop) / 4);
                gridEnd = gridEnd < gridStart ? parseFloat(gridStart) + 6 : gridEnd;
                secondaryBaseChart.style.gridRowEnd = gridEnd;
                element.style.gridRowStart = secondaryBaseChart.style.gridRowEnd;
                element.style.gridRowEnd = Math.round(gridHeight / 4);
                if (titleBounds.height && titleBounds.height != 0) {
                    element.style.gridRowStart = Math.round(titleBounds.height / 4) + parseInt(secondaryBaseChart.style.gridRowEnd);
                    element.style.gridRowEnd = Math.round((gridHeight + titleBounds.height) / 4);
                }
                secondaryBaseChart.dataset.titleheight = subelement.clientHeight + marginTop;
                secondaryBaseChart.dataset.assetType = "sourcetext";
                return { x: 0, y: 0, width: 0, height: subelement.clientHeight + marginTop };
                break;
        }
    } else {
        secondaryBaseChart.dataset.titleheight = 0;
        return { x: 0, y: 0, width: 0, height: 0 };
    }
};
ChartBuilder.prototype.createChartTitleText = function (basechart, gridWidth, gridHeight, secondaryBaseChart, voData, instancedetail) {
    if (voData.enableChartTileText == "true") {
        let element = document.createElement("div");
        element.className = "chartTitle clsGraphicTitleParent";
        element.style.zIndex = "1";
        element.style.gridColumnStart = 1;
        element.style.gridColumnEnd = Math.round(gridWidth / 4);
        element.style.gridRowStart = 1;
        element.style.gridRowEnd = Math.round(250 / 4);
        if (voData.chartTitleAlign) {
            element.classList.add(voData.chartTitleAlign);
        }
        basechart.appendChild(element);
        let themeClassName = "p7";
        if (instancedetail && instancedetail.fontsData && instancedetail.fontsData.title) {
            themeClassName = instancedetail.fontsData.title;
        }
        if (voData.chartTitleTextFontSize) {
            themeClassName = voData.chartTitleTextFontSize;
        }
        let subelement = document.createElement("div");
        subelement.className = "chartTitletext transparentBg moodanimation  clsGraphicTitle " + themeClassName;
        subelement.id = "chartTitletext-text";
        subelement.style.zIndex = "1";
        subelement.style.height = "auto";
        subelement.innerHTML = voData.titletext;
        if (voData.chartTitleLineHeight) subelement.style.lineHeight = voData.chartTitleLineHeight;
        if (voData.chartTitleLetterSpace) subelement.style.letterSpacing = voData.chartTitleLetterSpace + "em";
        if (voData.chartTitleOpacity) subelement.style.opacity = voData.chartTitleOpacity;
        if (voData.chartTitleTransform) subelement.style.setProperty("text-transform", voData.chartTitleTransform, "important");
        if (voData.chartTitleTextSize) subelement.style.setProperty("font-size", voData.chartTitleTextSize, "important");
        subelement.setAttribute("maxFontSize", 30);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "charttiletext");
        subelement.setAttribute("data-animation", "charttitletext");
        subelement.setAttribute("data-prompt-text", "Enter your title text");
        subelement.classList.add("transparentBg");
        this.ChartHelper.setTextChangeListner(subelement);
        element.appendChild(subelement);
        let parentBg = window.getComputedStyle(element)["background-color"];
        let childBg = window.getComputedStyle(subelement)["background-color"];
        if (childBg != "rgba(0, 0, 0, 0)" || parentBg != "rgba(0, 0, 0, 0)") {
            subelement.classList.add("titleColorBg");
        } else {
            subelement.classList.add("transparentBg");
        }
        if (voData._chartTitleTextBold) {
            subelement.style.setProperty("font-weight", "bold", "important");
        }
        if (voData._chartTitleTextItalic) {
            subelement.style.setProperty("font-style", "italic", "important");
        }
        if (voData._chartTitleTextColor) {
            subelement.style.setProperty("color", voData._chartTitleTextColor, "important");
            TextHighLightUtils.clearStylesBasedOnType(subelement, "textcolor");
        }
        let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : 0;
        let paddingTop = window.getComputedStyle(subelement)["padding-top"] ? parseFloat(window.getComputedStyle(subelement)["padding-top"]) : 0;
        let paddingBottom = window.getComputedStyle(subelement)["padding-bottom"] ? parseFloat(window.getComputedStyle(subelement)["padding-bottom"]) : 0;
        let marginTop = window.getComputedStyle(element)["margin-top"] ? parseFloat(window.getComputedStyle(element)["margin-top"]) : 0;
        let marginBottom = window.getComputedStyle(element)["margin-bottom"] ? parseFloat(window.getComputedStyle(element)["margin-bottom"]) : 0;
        let totalHeight = lineHeight * 3 + paddingTop + paddingBottom;
        let maxTitleHeight = 0;
        let count = 3;
        while (totalHeight > gridHeight * 0.3) {
            totalHeight = lineHeight * count + paddingTop + paddingBottom;
            count--;
            if (count == 0) {
                break;
            }
        }
        subelement.style.maxHeight = totalHeight + "px";
        if (totalHeight < subelement.clientHeight) {
            subelement.style.height = totalHeight + "px";
        }
        let position = "top";
        if (voData.customTitleFontClass) {
            themeClassName = voData.customTitleFontClass;
        }
        if (voData.moodData.theme && voData.moodData.theme && voData.moodData.theme.textcolormapping && voData.moodData.theme.textcolormapping.heading) {
            subelement.style.color = voData.moodData.theme.textcolormapping.heading;
        }
        subelement.className = "chartTitletext transparentBg moodanimation  clsGraphicTitle " + themeClassName;
        switch (position) {
            case "top":
                element.style.gridRowStart = 1;
                element.style.gridRowEnd = Math.round((subelement.clientHeight + marginBottom) / 4);
                secondaryBaseChart.style.gridRowStart = Math.round((subelement.clientHeight + marginBottom) / 4);
                secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight - subelement.clientHeight) / 4);
                return { x: 0, y: 0, width: 0, height: subelement.clientHeight + marginBottom };
                break;
            case "bottom":
                secondaryBaseChart.style.gridRowStart = 1;
                secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight - subelement.clientHeight - marginTop) / 4);
                element.style.gridRowStart = secondaryBaseChart.style.gridRowEnd;
                let gridStart = element.style.gridRowStart;
                let gridEnd = Math.round(gridHeight / 4);
                element.style.gridRowEnd = parseFloat(gridStart) > gridEnd ? parseFloat(gridStart) + 6 : gridEnd;
                return { x: 0, y: 0, width: 0, height: subelement.clientHeight + marginTop };
                break;
        }
    } else {
        return { x: 0, y: 0, width: 0, height: 0 };
    }
};
