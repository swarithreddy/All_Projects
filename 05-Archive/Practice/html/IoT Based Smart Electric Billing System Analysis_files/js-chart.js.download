        this.itemPosIndex = this.data.item.hasOwnProperty("posindex") ? this.data.item.posindex : 2;
        this.itemHPosition = this.data.item.hasOwnProperty("position") ? (this.data.item.position.length > 0 ? this.data.item.position[0] : "") : "";
        this.itemVPosition = this.data.item.hasOwnProperty("position") ? (this.data.item.position.length > 1 ? this.data.item.position[1] : "") : "";
        this.itemalterpos = this.data.item.hasOwnProperty("alteralign") ? this.data.item.alteralign : "";
        this.itemthickness = this.data.item.hasOwnProperty("size") ? Number(this.data.item.size) : "";
        boolMultiSeries = this.xmlData.getAttribute("multiseriescount") ? true : this.xmlData.children[0].getAttribute("value") ? this.xmlData.children[0].getAttribute("value").split(",").length > 1 : false;
        boolMultiSeries = this.disableMultiSeries ? false : boolMultiSeries;
        this.multiSeriesItemSize = this.data.item.hasOwnProperty("multiseriessize") && boolMultiSeries ? parseFloat(this.data.item.multiseriessize) : "";
        if (boolMultiSeries && chartName && !chartName.toLowerCase().includes("pie") && !chartName.toLowerCase().includes("doughnut")) this.itemthickness = 1;
        this.itemthicknesssize = this.data.item.hasOwnProperty("itemsize") ? Number(this.data.item.itemsize) : 1;
        this.itemBgBorder = this.data.item.hasOwnProperty("bgborder") ? this.data.item.bgborder : "";
        this.itemLineColor = this.data.item.hasOwnProperty("lineColor") ? this.data.item.lineColor : "";
        this.itemFillType = this.data.item.hasOwnProperty("fill") && this.data.item.fill.length > 0 ? this.data.item.fill[0] : "";
        // this.itemassetType = this.data.item.hasOwnProperty("fill") && this.data.item.fill.length > 1 ? this.data.item.fill[1] : "";
        this.itemColor = this.data.item.hasOwnProperty("color") ? this.data.item.color : "";
        this.linechartType = this.data.item.hasOwnProperty("linechart") && this.data.item.linechart.hasOwnProperty("style") ? this.data.item.linechart.style : "";
        this.linechartThickness = ""; //this.data.item.hasOwnProperty("linechart") && this.data.item.linechart.length > 1 ? this.data.item.linechart[1] : "";
        this.linestyle = ""; //this.data.item.hasOwnProperty("linechart") && this.data.item.linechart.length > 2 ? this.data.item.linechart[2] : "";
        this.lineColor = this.data.item.hasOwnProperty("linechart") && this.data.item.linechart.hasOwnProperty("color") ? this.data.item.linechart.color : "";
        this.lineOpacity = this.data.item.hasOwnProperty("linechart") && this.data.item.linechart.hasOwnProperty("opacity") ? this.data.item.linechart.opacity : "";
        this.lineGradientValues = this.createGradientValue(this.data.item, "line") ? this.createGradientValue(this.data.item, "line").strgradientValue : "";
        this.lineGradientDatas = this.createGradientValue(this.data.item, "line") ? this.createGradientValue(this.data.item, "line").gridvalues : "";
        this.lineShadow = this.data.item.hasOwnProperty("linestyle") ? this.data.item.linestyle : "";
        this.areaShadow = this.data.item.hasOwnProperty("areastyle") ? this.data.item.areastyle : "";
        this.lineareaGlopalStyle = this.data.item.hasOwnProperty("globalstyle") ? this.data.item.globalstyle : "";
        this.areaGradientValues = this.createGradientValue(this.data.item, "area") ? this.createGradientValue(this.data.item, "area").strgradientValue : "";
        this.areaGradientDatas = this.createGradientValue(this.data.item, "area") ? this.createGradientValue(this.data.item, "area").gridvalues : "";
        this.areaChart = this.data.item.hasOwnProperty("areachart") ? true : "";
        this.areaColor = this.data.item.hasOwnProperty("areachart") && this.data.item.areachart.hasOwnProperty("color") ? this.data.item.areachart.color : "";
        this.areaOpacity = this.data.item.hasOwnProperty("areachart") && this.data.item.areachart.hasOwnProperty("opacity") ? this.data.item.areachart.opacity : "";
        this.stepdown = this.data.item.hasOwnProperty("stepdown") ? this.data.item.stepdown : "";
        this.waffleShape = this.data.item.hasOwnProperty("waffleshape") ? this.data.item.waffleshape : "";
        this.itemType = this.data.item.hasOwnProperty("type") ? this.data.item.type : "";
        this.assetname = this.data.item.hasOwnProperty("asset") ? this.data.item.asset : "";
        this.itemborderstyle = this.data.item.hasOwnProperty("border") && this.data.item.border.length > 3 ? this.data.item.border[3] : "";
        this.itemalignment = "bottom_center"; //this.data.item.hasOwnProperty("itemalignment") ? this.data.item.itemalignment: "";
        this.itemOpacity = this.data.item.hasOwnProperty("opacity") ? this.data.item.opacity : "1";
        this.itemOpacityClass = this.data.item.hasOwnProperty("opacity") ? "clsgraphicopacity" : "";
        this.itemCoinChart = this.data.item.hasOwnProperty("coinchart") ? this.data.item.coinchart : "";
        this.itemFolder = this.data.item.hasOwnProperty("id") ? this.data.item.id : "";
        this.singleStackedColumn = this.data.item.hasOwnProperty("issinglestackedColumn") ? this.ChartHelper.parseBoolen(this.data.item.issinglestackedColumn) : "";
        this.itemWidthPercentage = this.data.item.hasOwnProperty("widthpercentage") ? this.data.item.widthpercentage : "";
        this.itemHeightPercentage = this.data.item.hasOwnProperty("heightpercentage") ? this.data.item.heightpercentage : "";
        if (this.stepdown) {
            this.xmlData.setAttribute("data-stepdown", "true");
        }
        if (this.linechartType == "linefull") {
            this.linechartType = "line";
            this.linechartfull = "true";
        }
        if (this.linechartType == "splinefull") {
            this.linechartType = "spline";
            this.linechartfull = "true";
        }
        if (this.itemthickness == 1.9 && this.labelItemBased == "true") {
            this.itemthickness = 1.4;
        }
        if (this.data.item.hasOwnProperty("shape") && Object.keys(this.data.item.shape).length != 0) {
            this.itemshape = this.data.item.shape.hasOwnProperty("type") ? this.data.item.shape.type : "";
            this.itemShapeStyle = this.data.item.shape.hasOwnProperty("style") ? this.data.item.shape.style : "";
            this.itemShapeBorderSize = this.data.item.shape.hasOwnProperty("bordersize") ? this.data.item.shape.bordersize : "";
            this.itemShapeBorderColor = this.data.item.shape.hasOwnProperty("bordercolor") ? this.data.item.shape.bordercolor : "";
            this.itemShapeBgColor = this.data.item.shape.hasOwnProperty("fillcolor") ? this.data.item.shape.fillcolor : "";
            this.itemtShapeRadius = this.data.item.shape.hasOwnProperty("radius") ? this.data.item.shape.radius : "";
            this.itemShapebgOpacity = this.data.item.shape.hasOwnProperty("fillopacity") ? this.data.item.shape.fillopacity : "";
            this.itemShapeShadow = this.data.item.shape.hasOwnProperty("shadow") ? this.data.item.shape.shadow : "";
            this.itemShapeDrawStyle = this.data.item.shape.hasOwnProperty("shapestyle") ? this.data.item.shape.shapestyle : "";
        }

        if (this.data.item.hasOwnProperty("linechart") && this.data.item.hasOwnProperty("shape") && Object.keys(this.data.item.shape).length != 0) {
            this.linechartshape = this.data.item.shape.hasOwnProperty("type") ? this.data.item.shape.type : "";
            this.linechartShapeStyle = this.data.item.shape.hasOwnProperty("style") ? this.data.item.shape.style : "";
            this.linechartShapeBorderSize = this.data.item.shape.hasOwnProperty("bordersize") ? this.data.item.shape.bordersize : "";
            this.linechartShapeBorderColor = this.data.item.shape.hasOwnProperty("bordercolor") ? this.data.item.shape.bordercolor : "";
            this.linechartShapeBgColor = this.data.item.shape.hasOwnProperty("fillcolor") ? this.data.item.shape.fillcolor : "";
            this.linechartShapeRadius = this.data.item.shape.hasOwnProperty("radius") ? this.data.item.shape.radius : "";
            this.linechartShapebgOpacity = this.data.item.shape.hasOwnProperty("fillopacity") ? this.data.item.shape.fillopacity : "";
        }
        if ((this.data.item.hasOwnProperty("headStyle") || this.xmlData.getAttribute("data-linehead") == "true") && !this.areaChart && this.xmlData.getAttribute("data-linehead") != "false") {
            // if(this.data.item.hasOwnProperty("headStyle")){
            this.lineHead = true;
            // this.lineHeadShapeType = this.data.item.headStyle.hasOwnProperty("type")?this.data.item.headStyle.type:"";
            // this.lineHeadShapeName = this.data.item.headStyle.hasOwnProperty("name")?this.data.item.headStyle.name:"";
            // this.lineHeadShapeWidth = this.data.item.headStyle.hasOwnProperty("width")?this.data.item.headStyle.width:"";
            // this.lineHeadShapeHeight = this.data.item.headStyle.hasOwnProperty("height")?this.data.item.headStyle.height:"";
        } else {
            this.lineHead = false;
        }
        if (this.areaChart) {
            this.xmlData.setAttribute("data-bgFill", "true");
        }
        // if (this.linechartType && this.linechartThickness) {
        //     this.xmlData.setAttribute("data-charttype", this.linechartType);
        //     this.xmlData.setAttribute("data-linethickness", this.linechartThickness);
        // }
        if (this.xmlData.getAttribute("data-spline") == "true") {
            this.linechartType = "spline";
        }
        if (this.xmlData.getAttribute("data-spline") == "false") {
            this.linechartType = "line";
        }
        if (this.linechartType) {
            this.xmlData.setAttribute("data-charttype", this.linechartType);
        }
        if (this.itemColor == "gradient" || this.lineColor == "gradient" || this.areaColor == "gradient") {
            this.xmlData.setAttribute("data-bgFillType", "gradient");
        } else {
            this.xmlData.setAttribute("data-bgFillType", "");
        }
        if (this.linechartType && this.data.item.hasOwnProperty("shadow")) {
            this.xmlData.setAttribute("data-dropshadow", "true");
        }
        this.borderRadiusValues = this.itemborderRadius(this.data.item);
        this.borderRadiusClass = this.data.item.radius && this.isString(this.data.item.radius) ? this.data.item.radius : "";
        this.alterBorderRadiusClass = this.borderRadiusClass ? this.createAlterClass(this.borderRadiusClass) : "";
        this.chartFlip = this.xmlData.getAttribute("chartflip") && this.xmlData.getAttribute("chartflip") == "true" ? true : false;
        if (mooddata?.rtlsupport && voBaseProperties.family == "bar") {
            this.chartFlip = true;
            this.xmlData.setAttribute("chartflip", true);
        }
        if (this.chartFlip) {
            this.alterBorderRadiusClass = this.borderRadiusClass;
            this.borderRadiusClass = this.borderRadiusClass ? this.createAlterClass(this.borderRadiusClass) : "";
        }
        this.itemborder = this.itemBorder(this.data.item);
        if (this.itemFillType == "image" || this.itemFillType == "imagewithfilter") {
            this.xmlData.setAttribute("data-graphicimage", "true");
        }
        if (this.xmlData.getAttribute("usergraphicimage")) {
            this.itemFillType = "image";
        }
        if (this.data.item.connector) {
            this.haddivider = true;
            this.dividerType = this.data.item.connector.length > 0 ? this.data.item.connector[0] : "";
            this.dividerStyle = this.data.item.connector.length > 1 ? this.data.item.connector[1] : "";
            this.dividerOpacity = this.data.item.connector.length > 2 ? this.data.item.connector[2] : "";
            this.dividerColor = this.data.item.connector.length > 2 ? this.data.item.connector[2] : "";
        }
        this.itemShadowValues = ""; //this.data.item.hasOwnProperty("shadow") ? this.data.item.shadow : "";
        if (this.data.item.hasOwnProperty("shape") && Object.keys(this.data.item.shape).length != 0) {
            this.boolitemShape = true;
            this.itemShapeType = this.data.item.shape.hasOwnProperty("type") ? this.data.item.shape.type : "";
            this.itemStyle = this.data.item.shape.hasOwnProperty("style") ? this.data.item.shape.style : "";
            this.itemBorderSize = this.data.item.shape.hasOwnProperty("bordersize") ? this.data.item.shape.bordersize : "";
            this.itemBorderColor = this.data.item.shape.hasOwnProperty("bordercolor") ? this.data.item.shape.bordercolor : "";
            this.itemBgColor = this.data.item.shape.hasOwnProperty("fillcolor") ? this.data.item.shape.fillcolor : "";
            this.itemshapeRadius = this.data.item.shape.hasOwnProperty("radius") ? this.data.item.shape.radius : "";
            this.itembgOpacity = this.data.item.shape.hasOwnProperty("bgopacity") ? this.data.item.shape.bgopacity : "";
            this.itemShapeWidth = this.data.item.shape.hasOwnProperty("size") && this.data.item.shape.size.length > 0 ? this.data.item.shape.size[0] : "";
            this.itemShapeHeight = this.data.item.shape.hasOwnProperty("size") && this.data.item.shape.size.length > 1 ? this.data.item.shape.size[1] : "";
        }
        this.itemGradientValues = this.createGradientValue(this.data.item) ? this.createGradientValue(this.data.item).strgradientValue : "";
        this.itemGradientDatas = this.createGradientValue(this.data.item) ? this.createGradientValue(this.data.item).gridvalues : "";
        this.itemHeader = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.item.header.show) : false;
        this.itemHeaderPosition = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("position") ? this.data.item.header.position : "";
        this.itemHeaderIndex = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("index") ? this.data.item.header.index : "0";
        this.itemHeaderHPosition = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("halign") ? this.data.item.header.halign : "center";
        this.hasitemHeaderTitle = this.data.item.hasOwnProperty("header");
        this.itemHeaderPaddingClass = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("padding") ? this.data.item.header.padding : "";
        this.itemHeaderColor = this.data.item.hasOwnProperty("header") && this.data.item.header.hasOwnProperty("color") ? this.data.item.header.color : "";

        this.itemIconCounter = this.data.item.hasOwnProperty("iconcount") ? this.ChartHelper.parseBoolen(this.data.item.iconcount) : false;
        this.iconassetType = this.data.item.hasOwnProperty("assettype") ? this.data.item.assettype : "";
        this.itemShadow = this.data.item.hasOwnProperty("shadow") ? this.data.item.shadow : "";
        this.itemGlobalStyle = this.data.item.hasOwnProperty("globalstyle") ? this.data.item.globalstyle : "clsStacedVenn";
        this.itemAlignment = this.data.item.hasOwnProperty("alignment") ? this.data.item.alignment : "bottom_center";
    }
    if (this.data && this.data.common) {
        this.itemgap = this.data.common.hasOwnProperty("nodesize") ? parseFloat(this.data.common.nodesize) : "";
        this.itemSpace = this.data.common.hasOwnProperty("gap") ? parseFloat(this.data.common.gap) : "";
        boolMultiSeries = boolMultiSeries ? boolMultiSeries : this.xmlData.children[0].getAttribute("value") ? this.xmlData.children[0].getAttribute("value").split(",").length > 1 : false;
        if (this.data.common.hasOwnProperty("multiseriesnodegap") && boolMultiSeries) {
            this.itemSpace = parseFloat(this.data.common.multiseriesnodegap);
        }
        this.itemgap = chartName != "statisticalBarSimpleRectangle" && this.data.common.hasOwnProperty("multiseriesnodesize") && boolMultiSeries ? parseFloat(this.data.common.multiseriesnodesize) : this.itemgap;
        this.multiseriesGapValue = this.data.common.hasOwnProperty("multiseriesgap") && boolMultiSeries ? parseFloat(this.data.common.multiseriesgap) : 0;
        this.itemgap = this.itemgap == 1 ? 0.999 : this.itemgap;
        let positionBounds = this.getPositionBounds(slide);
        this.parenthPosition = this.data.common.hasOwnProperty("hPosition") ? this.data.common.hPosition : positionBounds.halign;
        this.parentvPosition = this.data.common.hasOwnProperty("vPosition") ? this.data.common.vPosition : positionBounds.valign;
        if (this.data.common.separator) {
            this.hadseparator = true;
            this.separatorStyle = this.data.common.separator.length > 0 ? this.data.common.separator[0] : "";
            this.separatorOpacity = this.data.common.separator.length > 2 ? this.data.common.separator[2] : "";
            this.separatorColor = this.data.common.separator.length > 3 ? this.data.common.separator[3] : "";
        }
        this.defaultGrid = this.data.common.hasOwnProperty("defaultgrid") ? this.data.common.defaultgrid : "";
    }
    this.sequenceGrandparentcls = "clsChartNumbering clsMoodNumberingStyle";
    this.sequenceParentGlopalcls = "clsSeqTitleParent";
    this.sequenceChildGlopalcls = "clsSeqText";
    this.highlightStyleStyle = "style1";
    if (this.data && this.data.highlightstyle) {
        this.highlightStyleShow = this.data.highlightstyle.hasOwnProperty("show") ? this.ChartHelper.parseBoolen(this.data.highlightstyle.show) : false;
        this.highlightStyleStyle = this.data.highlightstyle.hasOwnProperty("style") ? this.data.highlightstyle.style : "style1";
    }
    this.valuetextShadow = this.createTextShadow();
    this.itemBoxShadow = this.createBoxShadow();
    this.valueShapeShadow = this.createValueShapeBoxShadow();
    this.bgBoxShadow = this.createBgBoxShadow();
    this.labelTextShadow = this.createLabelTextShadow();

    this.valueTextShdowOpacity = this.data.value && this.data.value.hasOwnProperty("shadow") && this.data.value.shadow.length > 4 ? this.data.value.shadow[4] : 0.2;
    this.valueTextShdowColor = this.data.value && this.data.value.hasOwnProperty("shadow") && this.data.value.shadow.length > 5 ? this.data.value.shadow[5] : "secondary";

    this.labelTextShdowOpacity = this.data.label && this.data.label.hasOwnProperty("shadow") && this.data.label.shadow.length > 4 ? this.data.label.shadow[4] : 0.2;
    this.labelTextShdowColor = this.data.label && this.data.label.hasOwnProperty("shadow") && this.data.label.shadow.length > 5 ? this.data.label.shadow[5] : "secondary";

    this.itemBoxShdowOpacity = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 4 ? this.data.item.shadow[4] : 0.2;
    this.itemBoxShdowColor = this.data.item && this.data.item.hasOwnProperty("shadow") && this.data.item.shadow.length > 5 ? this.data.item.shadow[5] : "item";
    this.itemBgBoxShdowOpacity = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 4 ? this.data.background.shadow[4] : 0.2;
    this.itemBgBoxShdowColor = this.data.background && this.data.background.hasOwnProperty("shadow") && this.data.background.shadow.length > 5 ? this.data.background.shadow[5] : "item";

    this.valueShapeShdowOpacity = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shape.shadow.length > 4 ? this.data.value.shape.shadow[4] : 0.2;
    this.valueShapeShdowColor = this.data.value && this.data.value.shape && this.data.value.shape.hasOwnProperty("shadow") && this.data.value.shapeshadow.length > 5 ? this.data.value.shape.shadow[5] : "item";

    this.itemBgborderstyle = this.data.background && this.data.background.hasOwnProperty("border") && this.data.background.border.length > 3 ? this.data.background.border[3] : "";
    if (this.data.axis) {
        this.disapleXaxis = this.data.axis.xaxis ? (this.data.axis.xaxis == "false" ? true : "") : "";
        this.disapleYaxis = this.data.axis.yaxis ? (this.data.axis.yaxis == "false" ? true : "") : "";
    }

    if (this.data.hasOwnProperty("grid")) {
        this.showGrid = this.data.grid.hasOwnProperty("show") ? this.data.grid.show : false;
        this.gridType = "";
        this.axisLineSide = this.data.grid.axisSide;
        this.showGridLine = this.data.grid.gridLine;
        this.showAxisLine = this.data.grid.axisLine;
        this.showXAxisLine = this.data.grid.xAxisLine;
        this.showYAxisLine = this.data.grid.yAxisLine;
        this.axisLineThickness = this.data.grid.gridValue;
        this.axisLineThickness = this.showAxisLine ? 3 : 0;

        this.showXAxisCustomLine = this.data.grid.hasOwnProperty("xaxisline") ? this.data.grid.xaxisline.show : "";
        this.showYAxisCustomLine = this.data.grid.hasOwnProperty("yaxisline") ? this.data.grid.yaxisline.show : "";
        this.showGridCustomLine = this.data.grid.hasOwnProperty("gridline") ? this.data.grid.gridline.show : this.data.common.defaultgrid;
        this.defaultGrid = this.showGridCustomLine;

        this.xAxisLineThickness = this.data.grid.hasOwnProperty("xaxisline") ? this.data.grid.xaxisline.thickness : "";
        this.yAxisLineThickness = this.data.grid.hasOwnProperty("yaxisline") ? this.data.grid.yaxisline.thickness : "";
        this.gridLineThickness = this.data.grid.hasOwnProperty("gridline") ? this.data.grid.gridline.thickness : "";

        this.xAxisLineStyleClass = this.data.grid.hasOwnProperty("xaxisline") && this.data.grid.xaxisline.globalstyle ? this.data.grid.xaxisline.globalstyle : "clsAxisStyle";

        this.xAxisLineStyle = this.data.grid.hasOwnProperty("xaxisline") ? this.data.grid.xaxisline.style : "";
        this.yAxisLineStyle = this.data.grid.hasOwnProperty("yaxisline") ? this.data.grid.yaxisline.style : "";
        this.gridLineStyle = this.data.grid.hasOwnProperty("gridline") ? this.data.grid.gridline.style : "dashed";

        this.yAxisLineStyleClass = this.data.grid.hasOwnProperty("yaxisline") && this.data.grid.yaxisline.globalstyle ? this.data.grid.yaxisline.globalstyle : this.xAxisLineStyleClass;

        this.xAxisLineOpacity = this.data.grid.hasOwnProperty("xaxisline") ? this.data.grid.xaxisline.opcity : "";
        this.yAxisLineOpacity = this.data.grid.hasOwnProperty("yaxisline") ? this.data.grid.yaxisline.opcity : "";
        this.gridLineOpacity = this.data.grid.hasOwnProperty("gridline") ? this.data.grid.gridline.opcity : "";

        this.gridLineStyleClass = this.data.grid.hasOwnProperty("gridline") && this.data.grid.gridline.globalstyle ? this.data.grid.gridline.globalstyle : "";

        this.xAxisLineColor = this.data.grid.hasOwnProperty("xaxisline") ? this.data.grid.xaxisline.color : "";
        this.yAxisLineColor = this.data.grid.hasOwnProperty("yaxisline") ? this.data.grid.yaxisline.color : "";
        this.gridLineColor = this.data.grid.hasOwnProperty("gridline") ? this.data.grid.gridline.color : "";
    } else {
        this.showGrid = false;
    }

    if (this.data.legend && !this.data.connector) {
        this.showLegend = true;
        this.legendWidth = this.data.legend.hasOwnProperty("width") ? this.data.legend.width : "";
        this.legendValign = this.data.legend.hasOwnProperty("valign") ? this.data.legend.valign : "middle";
        this.legendHalign = this.data.legend.hasOwnProperty("halign") ? this.data.legend.halign : "center";
        this.legendGlopalStyle = this.data.legend.hasOwnProperty("globalstyle") ? this.data.legend.globalstyle : "";
        this.legendLabelPosition = this.data.legend.hasOwnProperty("labelValPosType") ? this.data.legend.labelValPosType : "";
        this.legendPosition = this.data.legend.hasOwnProperty("position") ? this.data.legend.position : "";
        if (this.legendPosition.length > 1) {
            this.legendPosition.splice(1, 1);
        }
        this.legendPosition = this.xmlData.getAttribute("customlegendposition") ? this.xmlData.getAttribute("customlegendposition") : this.legendPosition;
        this.legendShapePosition = this.data.legend.hasOwnProperty("shapePos") ? this.data.legend.shapePos : "";

        let legendAlignment = this.data.legend.hasOwnProperty("legendAlignment");
        if (legendAlignment) {
            this.legendAlignment.push({ data: "none", label: "legendposnone" });
            let legendAlignmentList = this.data.legend.legendAlignment.split(",");
            let length = legendAlignmentList.length;
            for (let i1 = 0; i1 < length; i1++) {
                this.legendAlignment.push({ data: legendAlignmentList[i1], label: "legendpos" + legendAlignmentList[i1] });
            }
        } else {
            this.legendAlignment = [
                { data: "none", label: "legendposnone" },
                { data: "left", label: "legendposleft" },
                { data: "right", label: "legendposright" },
                { data: "top", label: "legendpostop" },
                { data: "bottom", label: "legendposbottom" },
            ];
        }
        if (this.data.legend.hasOwnProperty("shape") && Object.keys(this.data.legend.shape).length != 0) {
            this.legendShape = this.data.legend.shape.hasOwnProperty("type") ? this.data.legend.shape.type : "";
            this.legendShapeType = this.data.legend.shape.hasOwnProperty("shapetype") ? this.data.legend.shape.shapetype : "";
            this.legendShapeHeight = this.data.legend.shape.hasOwnProperty("size") && this.data.legend.shape.size.length > 0 ? this.data.legend.shape.size[0] : "";
