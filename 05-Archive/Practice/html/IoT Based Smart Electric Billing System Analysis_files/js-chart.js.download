function ChartHelper() {
    this.SVGUtils = new window["SVGUtils"]();
    this.ChartDataGenerator = new window["ChartDataGenerator"]();
    this.ChartUtils = new window["ChartUtils"]();
    this.eventManager = new window["ChartEventManager"]();
}
ChartHelper.prototype.createDivElement = function (props) {
    let element = this.SVGUtils.createElement("div");
    this.applyProperties(element, props);
    return element;
};

ChartHelper.prototype.applyProperties = function (element, props) {
    for (var key in props) {
        element[key] = props[key];
    }
};

ChartHelper.prototype.setTextChangeListner = function (element) {
    if (element) {
        this.eventManager.dispatch("textchange", element);
        // element.addEventListener("focusout", event => {
        //     this.onFocusoutHandler(element);
        // });
        if (element && element.className && element.className.includes("valuetext")) {
            // element.addEventListener("keydown", (event) => {
            //     // this.ChartHelper.onKeyDownHandler(element);
            // });
        }
        let fontSize = window.getComputedStyle(element).fontSize;
        if (fontSize) element.setAttribute("maxFontSize", fontSize);
        var textChangeObserver = function (mutationsList, observer) {
            let maxFontSize = element.getAttribute("maxFontSize");
            maxFontSize = parseInt(maxFontSize ? maxFontSize : 36);
            if (!element.getAttribute("data-supportedtexthighlight")) {
                // ChartHelper.prototype.adjustFontSize(element, 10, maxFontSize - ChartFonts.minFontSize, maxFontSize);
                // ChartHelper.prototype.textPositionChangeObserver(element);
            }
        };
        var config = { subtree: true, characterData: true };
        var cssCommonTextChangeObserver = new MutationObserver(textChangeObserver);
        cssCommonTextChangeObserver.observe(element, config);
    }
};

ChartHelper.prototype.textChangeObserver = function (element) {
    let maxFontSize = element.getAttribute("maxFontSize");
    maxFontSize = parseInt(maxFontSize ? maxFontSize : 36);
    this.adjustFontSize(element, 10, maxFontSize - ChartFonts.minFontSize, maxFontSize);
    this.textPositionChangeObserver(element);
};
ChartHelper.prototype.onKeyDownHandler = function (element) {
    if (event.keyCode == 13) {
        event.preventDefault();
        const type = element.getAttribute("data-type");
        switch (type) {
            case "value":
            case "legendvalue":
                this.ChartDataGenerator.assignValueData(element);
                break;
            default:
        }
    }
};

ChartHelper.prototype.onFocusoutHandler = function (element) {
    const type = element.getAttribute("data-type");
    const slideID = this.getElementSlide(element).getAttribute("id"); //element.getAttribute("data-slideid");
    const slide = this.getElementSlide(element); //document.getElementById(slideID);

    // if (slideID && slide) {
    //     let grid = slide ? slide.getElementsByClassName("grid") : "";
    //     if (!!grid[0]) {
    //         grid[0].style.opacity = 0;
    //         let removeListner = grid[0].getElementsByClassName("removelistner");
    //         for (let i1 = 0; i1 < removeListner.length; i1++) {
    //             removeListner[i1].setAttribute("data-listner", "false");
    //         }
    //     }
    // }

    switch (type) {
        case "label":
        case "legendlabel":
        case "comparisonlabel":
        case "placeholdertext":
        case "comparelabel":
            element.parentElement.scrollTop = 0;
            this.ChartDataGenerator.assignLabelData(element, type);
            break;
        case "multilegendlabel":
            element.parentElement.scrollTop = 0;
            this.ChartDataGenerator.assignLegendLabelData(element);
            break;
        case "value":
        case "legendvalue":
        case "promt":
            if (element.dataset.enabled != "true") {
                this.ChartDataGenerator.assignValueData(element);
            }
            break;
        case "axistitle":
            element.scrollLeft = 0;
            this.ChartDataGenerator.assignAxisTitleData(element);
            break;
        case "baselinecallout":
            this.ChartDataGenerator.assignBaseLineData(element);
            break;
        case "basevalue":
            this.ChartDataGenerator.assignBaseLinevalueData(element);
            break;
        case "baseleftvalue":
            this.ChartDataGenerator.assignBaseLineLeftvalueData(element);
            break;
        case "secondarylabel":
            this.ChartDataGenerator.assignSecondaryData(element);

        default:
    }
};

ChartHelper.prototype.getElementSlide = function (element, returnorginal = false) {
    if (!element) {
        return null;
    } else if (element.className.includes("GRAPHIC") || element.id == "TEXTBOX_HOLDER") {
        if (returnorginal) {
            return element;
        } else {
            return element.parentElement;
        }
    } else {
        return this.getElementSlide(element.parentElement, returnorginal);
    }
};
ChartHelper.prototype.getElementDiv = function (element) {
    if (element.getAttribute("id") == "ELEMENT_DIV") {
        return element;
    } else {
        return this.getElementDiv(element.parentElement);
    }
};
ChartHelper.prototype.textPositionChangeObserver = function (element, label = false) {
    let type = element.getAttribute("data-type");
    let slide = this.getElementSlide(element); //document.getElementById(slideID);
    let slideID = slide ? this.getElementSlide(element).getAttribute("id") : null; //element.getAttribute("data-slideid");
    if (slide.getAttribute("id") != "TEXTBOX") {
        slide = slide.querySelector(".GRAPHIC");
    } else {
        slideID = slide ? this.getElementSlide(element).parentNode.getAttribute("id") : null;
    }
    let graphicDiv = this.getElementSlide(element, true);

    if (slideID && slide) {
        let grid = graphicDiv ? graphicDiv.getElementsByClassName("grid") : "";
        type = type == "comparisonlabel" ? "label" : type;
        switch (type) {
            case "label":
            case "legendlabel":
            case "secondarylabel":
            case "placeholdertext":
            case "comparelabel":
                let elementDiv = graphicDiv.querySelectorAll("#ELEMENT_DIV");
                let CurrentDiv = elementDiv.length > 1 ? elementDiv[elementDiv.length - 1] : elementDiv.length > 0 ? elementDiv[0] : graphicDiv;
                const arrLabel = CurrentDiv.getElementsByClassName(type);
                const textAlign = arrLabel.length > 0 ? arrLabel[0].getAttribute("data-textalign") : "";
                const length = arrLabel.length;
                if (!!grid[0]) {
                    grid[0].style.opacity = 0;
                    let removeListner = grid[0].getElementsByClassName("removelistner");
                    for (let i1 = 0; i1 < removeListner.length; i1++) {
                        removeListner[i1].setAttribute("data-listner", "false");
                    }
                    if (length) {
                        if (textAlign == "vertical") {
                            this.alignVerticalLabel(arrLabel, label);
                        } else if (textAlign == "horizantal") {
                            this.alignHorizantalLabel(arrLabel, label);
                        }
                    }
                } else {
                    if (length > 0) {
                        if (textAlign == "vertical") {
                            this.alignVerticalLabel(arrLabel, label);
                        } else if (textAlign == "horizantal") {
                            this.alignHorizantalLabel(arrLabel, label);
                        }
                    }
                }

                break;
            case "value":
            case "legendvalue":
            case "promt":
                let secondarySlide = this.getElementDiv(element);
                const arrValue = secondarySlide.getElementsByClassName(type);
                const Vlength = arrValue.length;
                if (Vlength) this.assignFontSizeValue(arrValue);
                if (type == "legendvalue") this.alignHorizantalLabel(arrValue);
                break;
            case "axistitle":
                break;
            default:
        }
    } else {
        console.log("sucess");
    }
};

ChartHelper.prototype.alignVerticalLabel = function (arrLabel) {
    let minHeight = 0;
    const length = arrLabel.length;
    let maxHeight = parseInt(window.getComputedStyle(arrLabel[0])["maxHeight"]);
    let fontSize = 0;
    for (let i3 = 0; i3 < length; i3++) {
        let childMaxHeight = parseInt(window.getComputedStyle(arrLabel[i3])["maxHeight"]);
        maxHeight = maxHeight < childMaxHeight ? childMaxHeight : maxHeight;
    }
    for (let i1 = 0; i1 < length; i1++) {
        let childHeight = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["height"]);
        minHeight = minHeight < childHeight ? childHeight : minHeight;
        let childFontSize = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let height = maxHeight < minHeight ? maxHeight : minHeight;
        arrLabel[i2].style.minHeight = height + "px";
        arrLabel[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

ChartHelper.prototype.alignHorizantalLabel = function (arrLabel, label = false) {
    let minWidth = 0;
    let fontSize = 0;
    const length = arrLabel.length;
    const maxWidth = parseInt(window.getComputedStyle(arrLabel[0])["maxWidth"]);
    for (let i1 = 0; i1 < length; i1++) {
        arrLabel[i1].style.minWidth = 10 + "px"; //ranjith
        let childWidth = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["width"]);
        //let childWidth = parseInt(window.getComputedStyle(arrLabel[i1])["width"]);
        minWidth = minWidth < childWidth ? childWidth : minWidth;
        let childFontSize = parseInt(window.getComputedStyle(arrLabel[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let width = maxWidth < minWidth ? maxWidth : minWidth;
        // arrLabel[i2].style.width = "auto";
        width = width < 139 && label ? 139 : width;
        arrLabel[i2].style.minWidth = width + 1 + "px";
        if (arrLabel[i2].dataset.headerWidthTitle && arrLabel[i2].dataset.headerWidthTitle > width) {
            arrLabel[i2].style.minWidth = arrLabel[i2].dataset.headerWidthTitle + "px";
        }
        arrLabel[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

ChartHelper.prototype.assignFontSizeValue = function (arrValue) {
    let minWidth = 0;
    let fontSize = 0;
    const length = arrValue.length;
    const maxWidth = parseInt(window.getComputedStyle(arrValue[0])["maxWidth"]);
    for (let i1 = 0; i1 < length; i1++) {
        let childWidth = parseInt(window.getComputedStyle(arrValue[i1].childNodes[0])["width"]);
        minWidth = minWidth < childWidth ? childWidth : minWidth;
        let childFontSize = parseInt(window.getComputedStyle(arrValue[i1].childNodes[0])["font-size"]);
        fontSize = i1 == 0 ? childFontSize : fontSize < childFontSize ? fontSize : childFontSize;
    }

    for (let i2 = 0; i2 < length; i2++) {
        let width = maxWidth < minWidth ? maxWidth : minWidth;
        if (arrValue[i2].dataset.hasstatistical != "true") arrValue[i2].style.minWidth = width + 1 + "px";
        arrValue[i2].childNodes[0].style.setProperty("font-size", fontSize + "px", "");
    }
};

