function SingleWaffleSeries(argparent, argprops) {
    this.name = "SingleWaffleSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SingleWaffleSeries.prototype = Object.create(BaseColumnSeries.prototype);
SingleWaffleSeries.prototype.constructor = SingleWaffleSeries;

SingleWaffleSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SingleWaffleSeriesItem"](argparent, argprops);
};
SingleWaffleSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : this.gapPercentage;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.parent) this.parent.appendChild(element);
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    ///boolMax
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.valueStyle = this.ChartFonts.graphicColor(this.index);
        this.doAddValueElement(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
    subelement.style.width = 100 + "%";
    subelement.style.order = 2;
    // subelement.style.flex = "unset";
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

function SingleWaffleSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.iconRow = 10;
    this.iconColumn = 10;
    this.valueMaxW = 0;
    this.labelMaxW = 0;
    this.labeMaxH = 0;
    this.valueMaxH = 0;
    this.styleShape = null;
    this.graphicH = 0;
    this.padding = 8;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
    this.boolDisableWidth = true;
}
SingleWaffleSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SingleWaffleSeriesItem.prototype.constructor = SingleWaffleSeriesItem;

SingleWaffleSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.5;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * 0.3;
    this.valueMaxH = this.state.height * 0.5; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.valueAlignment.itemBased == "true") this.valueMaxW = this.state.width * 0.4;
    if (this.labelAlignment.itemBased == "true") this.labelMaxW = this.state.width * 0.4;
};

SingleWaffleSeriesItem.prototype.doAddGraphicElement = function () {
    // this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.values[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

SingleWaffleSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
};

SingleWaffleSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    this.styleShape = this.data.layout.waffleShape ? this.data.layout.waffleShape : "rect";
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? labelMaxW * 0.5 : labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgFillDetails(styleIndex, this.ChartFonts.graphicFillColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "secondary-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.justifyContent = "center ";
    subelement.style.alignItems = "center ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic transformOrginBottom";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "center";
    graphicElement.style.position = "relative";
    graphicElement.style.justifyContent = "center";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);

    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.boolDisableWidth = true;
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.boolDisableWidth = true;
            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops, "", true, true);
            else this.doAddTopValue(sameElement, argprops, "", true, true);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.boolDisableWidth = true;
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement clsValueBg " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            if (this.data.layout.valueGlobalstyle) {
                subelement.classList.add(this.data.layout.valueGlobalstyle);
            }
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops, "", true, true);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops, "", true, true);
            else this.doAddTopValue(element, argprops, "", true, true);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement clsValueBg " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            if (this.data.layout.valueGlobalstyle) {
                subelement.classList.add(this.data.layout.valueGlobalstyle);
            }
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops, "", true, true);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops, "", true, true);
        }
    }
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? subelement.clientWidth * 0.5 : subelement.clientWidth;
    let graphicHeight = subelement.clientHeight;
    if (this.data.layout.itemgap) {
        if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
            graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.data.layout.itemgap : graphicWidth;
            if (graphicHeight > graphicWidth) {
                graphicWidth = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") && graphicWidth > subelement.children[0].clientWidth ? subelement.children[0].clientWidth : graphicWidth;
            }
        } else {
            graphicHeight = this.data.layout.itemgap;
            graphicHeight = graphicHeight > subelement.clientHeight ? subelement.clientHeight : graphicHeight;
        }
    }
    let iconVerSize = graphicWidth / this.iconColumn;
    let iconHorSize = graphicHeight / this.iconRow;
    this.iconsize = iconVerSize < iconHorSize ? iconVerSize : iconHorSize;
    if (this.data.layout.itemgap) {
        subelement.children[0].style.width = this.iconsize * this.iconColumn + "px";
        subelement.children[0].style.height = this.iconsize * this.iconColumn + "px";
    }
    this.createBgGraphicSVG(graphicElement, argprops, null, null, index);
    this.createGraphicSVG(graphicElement, argprops, null, null, index);
    if (this.data.layout.itemgap && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true") {
        this.parent.style.flex = "unset";
    }
};

SingleWaffleSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow clsValueTitleParent  " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                // element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.boolDisableWidth) {
        element.style.width = "";
    } else {
        element.style.width = this.valueMaxW + "px";
    }
    if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            // element.style.marginLeft = "auto";
        } else {
            element.style.marginRight = "auto";
        }
    }
    // if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
    //     this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex)//"accent" + (this.groupindex + 1) + "-color";
    // }
    this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");

    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation clsValueText " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    if (this.data.layout.valueInset == "inside") {
        subelement.className = "valuetext moodanimation clsValueText " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    }
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);

    // if (boolenablePer&&this.data.displayValueFormat!="number") {
    //     // if(this.data.suffix[this.groupindex][this.index]==""){
    //     //     subelement.innerText = parseFloat(argprops.valuetext) > 100 ? "100%" : this.data.prefix[this.groupindex][this.index] +this.data._currencySymbol[this.groupindex][this.index]+ parseFloat(argprops.value) + "%";
    //     // }
    // }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
    }

    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        // element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgstyle == "style6") {
            // element.classList.add("moodanimation");
            // element.dataset.animation = "bgsecondarytext"
        }
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                // subelement.classList.add("calloutbgstyle" + groupindex);
                // subelement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor && this.data.layout.valueColor != "secondary") {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this.index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
    } else {
        fontsize = window.getComputedStyle(subelement)["font-size"];
    }
    if (!boolmax) {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        if (this.data.layout.valueInset == "inside") {
            if (this.data.suffixStyle) {
                let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
                if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
            }
            if (this.data.prefixStyle) {
                let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
                if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
            }
        }
        subelement.style.overflow = "hidden";
    }
};
SingleWaffleSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index) {
    let intPad = this.data.chartName != "singlewaffleiconchart" ? 5 : 0;
    let graphicHeight = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? argparent.clientWidth * 0.5 : argparent.clientWidth;
    let graphicWidth = argparent.clientWidth;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "bggraphics-" + this.groupindex + "_" + this.index,
        class: "bggraphics",
        x: "0px",
        y: "0px",
        width: "100%",
        height: "100%",
        style: "position:absolute;left:0;margin:auto;right:0",
    });

    let strStyleClass = this.getBgFillDetails(this.groupindex, this.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);//this.getBgColorDetails(this.groupindex,this.ChartFonts.graphicBgColor(this.groupindex),this.data.layout.itemColor,"bgcolor") + " moodanimation";
    let intVerIndex = this.iconRow - 1;
    let intHerIndex = 0;
    let intColumn = this.iconColumn;
    let intDrawW = this.iconsize * this.iconColumn;
    let intDrawH = this.iconsize * this.iconRow;

    graphicWidth = graphicWidth > intDrawW ? intDrawW : graphicWidth;
    graphicHeight = graphicHeight > intDrawH ? intDrawH : graphicHeight;

    let intDrawX = (graphicWidth - intDrawW) / 2 < 0 ? this.state.x : this.state.x + (graphicWidth - intDrawW) / 2;
    let intDrawY = (graphicHeight - intDrawH) / 2 < 0 ? this.state.y : this.state.y + (graphicHeight - intDrawH) / 2;

    let iconCount = parseInt(this.data.values[0][0]) > 100 ? 100 : parseInt(this.data.values[0][0]);
    let iconWH = 0;
    for (let i1 = 0; i1 < iconCount; i1++) {
        if (i1 != 0 && parseInt(i1 % intColumn) == 0) {
            intHerIndex = 0;
            intVerIndex--;
        }
        let svgIcon;
        if (this.data.chartName != "singlewaffleiconchart") {
            if (this.styleShape == "circle") {
                svgIcon = this.data.SVGUtils.createSVGElement("circle");
            } else {
                svgIcon = this.data.SVGUtils.createSVGElement("rect");
            }
        } else {
            svgIcon = this.data.SVGUtils.createSVGElement("use");
        }

        let iconX = intDrawX + this.iconsize * intHerIndex + intPad;
        let iconY = intDrawY + this.iconsize * intVerIndex + intPad;
        iconWH = this.iconsize - intPad * 2;

        if (this.styleShape == "circle") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "rect-" + this.groupindex + "_" + this.index,
                class: "moodanimation " + strStyleClass,
                cx: iconX + iconWH / 2 + "px",
                cy: iconY + iconWH / 2 + "px",
                r: iconWH / 2,
                "fill-opacity": this.data.layout.itemOpacity ? this.data.layout.itemOpacity : 1,
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "data-animation": "item",
            });
        } else {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "rect-" + this.groupindex + "_" + this.index,
                class: "moodanimation " + strStyleClass,
                x: iconX + "px",
                y: iconY + "px",
                width: iconWH,
                height: iconWH,
                "fill-opacity": this.data.layout.itemOpacity ? this.data.layout.itemOpacity : 1,
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "data-animation": "item",
            });
        }
        if (this.style.bgFillType == "gradient") {
            this.addGradient(svgIcon, svgElement, true, true);
        }
        intHerIndex++;
        svgElement.appendChild(svgIcon);
        if (this.data.chartName == "singlewaffleiconchart") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "xlink:href": "#" + this.data.itemPlacehoders[index],
                "data-name": this.data.itemPlacehoders[index],
                "data-iconpath": this.data.itemPlacehodersPath[index],
            });
        }
        this.itemSvgShapeProperties(svgIcon, this.index, this.groupindex);
    }
    this.data.SVGUtils.assignAttributes(svgElement, {
        width: (iconWH + intPad * 2) * 10,
        height: (iconWH + intPad * 2) * 10,
    });
    argparent.appendChild(svgElement);
};
SingleWaffleSeriesItem.prototype.createBgGraphicSVG = function (argparent, argprops, width, height, index) {
    let intPad = this.data.chartName != "singlewaffleiconchart" ? 5 : 0;
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? argparent.clientWidth * 0.5 : argparent.clientWidth;
    let graphicHeight = argparent.clientHeight;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "bggraphics-" + this.groupindex + "_" + this.index,
        class: "bggraphics",
        x: "0px",
        y: "0px",
        width: "100%",
        height: "100%",
    });
    argparent.appendChild(svgElement);

    if (this.data.chartName == "singlewaffleiconchart") {
        let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(dummySVGNode, {
            "xlink:href": "#" + this.data.itemPlacehoders[argprops.gindex],
            "data-name": this.data.itemPlacehoders[argprops.gindex],
            "data-iconpath": this.data.itemPlacehodersPath[argprops.gindex],
            opacity: 0,
        });
        svgElement.appendChild(dummySVGNode);
        let bounds = dummySVGNode.getBBox();
        svgElement.removeChild(dummySVGNode);
        let tempHeight = graphicHeight / bounds.height;
    }
    let strStyleClass = " moodanimation";
    let intVerIndex = this.iconRow - 1;
    let intHerIndex = this.iconColumn - 1;
    let intColumn = this.iconColumn;
    let intDrawW = this.iconsize * this.iconColumn;
    let intDrawH = this.iconsize * this.iconRow;
    graphicWidth = graphicWidth > intDrawW ? intDrawW : graphicWidth;
    graphicHeight = graphicHeight > intDrawH ? intDrawH : graphicHeight;
    let intDrawX = (graphicWidth - intDrawW) / 2 < 0 ? this.state.x : this.state.x + (graphicWidth - intDrawW) / 2;
    let intDrawY = (graphicHeight - intDrawH) / 2 < 0 ? this.state.y : this.state.y + (graphicHeight - intDrawH) / 2;
    let iconWH = 0;
    for (let i1 = 0; i1 <= 99; i1++) {
        if (i1 != 0 && parseInt(i1 % intColumn) == 0) {
            intHerIndex = 9;
            intVerIndex--;
        }
        let svgIcon;
        if (this.data.chartName != "singlewaffleiconchart") {
            if (this.styleShape == "circle") {
                svgIcon = this.data.SVGUtils.createSVGElement("circle");
            } else {
                svgIcon = this.data.SVGUtils.createSVGElement("rect");
            }
        } else {
            svgIcon = this.data.SVGUtils.createSVGElement("use");
        }
        let iconX = intDrawX + this.iconsize * intHerIndex + intPad;
        let iconY = intDrawY + this.iconsize * intVerIndex + intPad;
        iconWH = this.iconsize - intPad * 2;
        if (this.styleShape == "circle") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "backgroundminirect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                cx: iconX + iconWH / 2 + "px",
                cy: iconY + iconWH / 2 + "px",
                r: iconWH / 2,
                "data-customopacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.5",
                "data-hidecustomopacity": "true",
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.5",
                "data-animation": "itembackground",
            });
        } else {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "backgroundminirect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                x: iconX + "px",
                y: iconY + "px",
                width: iconWH,
                height: iconWH,
                "data-customopacity": "0.5",
                "data-hidecustomopacity": "true",
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.5",
                "data-animation": "itembackground",
            });
        }
        if (this.data.chartName == "singlewaffleiconchart") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "xlink:href": "#" + this.data.itemPlacehoders[index],
                "data-name": this.data.itemPlacehoders[index],
                "data-iconpath": this.data.itemPlacehodersPath[index],
            });
        }
        intHerIndex--;
        svgElement.appendChild(svgIcon);
        this.itemSvgBgShapeProperties(svgIcon, this.index, this.groupindex);
    }
    this.data.SVGUtils.assignAttributes(svgElement, {
        width: (iconWH + intPad * 2) * 10,
        height: (iconWH + intPad * 2) * 10,
    });
};


function SinglePiePercentageChart(argparent, argprops) {
    this.index = argprops.index;
    this.index = argprops.index;
    this.name = "SingleWaffleChart";
    this.minSeriesSize = 300;
    this.maxGraphicSize = 1300;
    BaseMovieclipColumnChart.call(this, argparent, argprops);
    this.bollEnableSize =false;
}
SinglePiePercentageChart.prototype = Object.create(BaseMovieclipColumnChart.prototype);
SinglePiePercentageChart.prototype.constructor = SinglePiePercentageChart;

SinglePiePercentageChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SinglePiePercentageSeries"](argparent, argprops);
}
function SinglePiePercentageSeries(argparent, argprops) {
    this.name = "SinglePiePercentageSeries";
    this.gapPercentage = 1;
    this.maxSize = 400;
    BaseMovieclipColumnSeries.call(this, argparent, argprops);
}
SinglePiePercentageSeries.prototype = Object.create(BaseMovieclipColumnSeries.prototype);
SinglePiePercentageSeries.prototype.constructor = SinglePiePercentageSeries;
SinglePiePercentageSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SinglePiePercentageSeriesItem"](argparent, argprops);
};

SinglePiePercentageSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    element.className = "series accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.justifyContent = "center";
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    //boolMax
    if (this.data.hadSecondaryText) {
        this.addlabel = true;
        this.doSecondaryLabel(element, argprops, true);
        this.doSecondaryLabel(element, argprops);
    }
    this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    // if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
    //     this.addvalue = true;
    //     this.doAddValueElement(element, argprops);
    // }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer") {
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    this.widthPercentage = 0.7;
    if (this.data.layout.itemgap > 1) this.maxSize = this.data.layout.itemgap;
    let viewSize = this.state.width * this.widthPercentage < this.rectSeriesItem.height ? this.state.width * this.widthPercentage : this.rectSeriesItem.height;
    viewSize = this.maxSize < viewSize ? this.maxSize : viewSize;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond";
    subelement.style.width = viewSize + "px";
    subelement.style.height = viewSize + "px";
    subelement.style.flex = "unset";
    subelement.setAttribute("data-width", viewSize);
    subelement.setAttribute("data-height", viewSize);
    if (this.data.chartName == "SingleDoughnutGaugeChart") {
        subelement.style.width = this.state.width + "px";
        subelement.setAttribute("data-width", this.state.width);
    }
    if (this.data.chartName == "multiCompPie") {
        subelement.style.height = "auto";
    }
    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

function SinglePiePercentageSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.minSize = 20;
    this.maxSize = 400;
    this.assetSize = 0;
    this.name = "SinglePiePercentageSeriesItem";
    this.radius = 0;
    this.startAngle = 270;
    this.maxAngle = 360;
    this.endAngle = 0;
    this.innerRadius = 0;
    this.pntEnd = {
        x: 0,
        y: 0,
    };
    this.pntStart = {
        x: 0,
        y: 0,
    };
    this.pntCenter = {
        x: 0,
        y: 0,
    };
    this.pntInnerEnd = {
        x: 0,
        y: 0,
    };
    this.pntInnerStart = {
        x: 0,
        y: 0,
    };
    this.centerPaddingDistance = 5;
    BaseMovieclipColumnSeriesItem.call(this, argparent, argprops);
}
SinglePiePercentageSeriesItem.prototype = Object.create(BaseMovieclipColumnSeriesItem.prototype);
SinglePiePercentageSeriesItem.prototype.constructor = SinglePiePercentageSeriesItem;

SinglePiePercentageSeriesItem.prototype.updateBasicData = function () {
    BaseMovieclipColumnSeriesItem.prototype.updateBasicData.call(this);

    var intAssetLength = this.data.asset.data.length;
    if (0 < intAssetLength) this.assetURL = this.data.serverUrl + this.data.asset.data[0].url;
    this.asset = this.data.asset.data;
};

SinglePiePercentageSeriesItem.prototype.doAddGraphicElement = function () {
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType,
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };
    if (this.data.layout.itemgap > 1) this.maxSize = this.data.layout.itemgap;
    const parentWidth = this.parent.getAttribute("data-width") / this.length;
    const parentHeight = this.parent.getAttribute("data-height");
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = parentWidth + "px";
    element.style.height = "auto";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    this.parent.appendChild(element);

    this.doAddTopSeriesItemElement(element, eProps);
};

SinglePiePercentageSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = "auto";
    element.style.alignItems = "center";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", parentHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
    }
};

SinglePiePercentageSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // if (this.displayValue(argprops) && this.valueAlignment.position == "outer") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "outer") _iHeight += _dataPlaceholder.height;

    let parentWidth = argparent.getAttribute("data-width");
    let parentHeight = argparent.getAttribute("data-height");

    if (this.valueAlignment.position == "outer" && this.labelAlignment.itemBased != "true") {
        this.doAddTopValue(argparent, argprops, true);
        _iHeight = this.maxValueH;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex;
    element.className = "basegraphic basetopgraphic";
    element.style.width = parentWidth + "px";
    element.style.height = parentHeight + "px";
    if (argparent) argparent.appendChild(element);
    else return element;

    const baseGraphicHeight = parentHeight - _iHeight;
    const valuePercentage = 1;
    let viewSize = parentWidth < baseGraphicHeight ? parentWidth : baseGraphicHeight;
    viewSize = this.maxSize < viewSize ? this.maxSize : viewSize;
    this.assetSize = this.minSize + (viewSize - this.minSize) * valuePercentage;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "seriesitem-" + index;
    // subelement.style.display = "block";
    subelement.className = "chartgraphic seriesitem topseriesitem";
    subelement.style.width = this.assetSize + "px";
    subelement.style.height = this.assetSize + "px";
    subelement.style.position = "relative";
    subelement.setAttribute("data-width", this.assetSize);
    subelement.setAttribute("data-type", "ITEM");
    subelement.setAttribute("data-height", this.assetSize);
    if (this.data.chartName == "SingleDoughnutGaugeChart") {
        subelement.style.width = this.state.width + "px";
        subelement.setAttribute("data-width", this.state.width);
    }
    element.appendChild(subelement); //multiCompPie

    //
    if (this.data.chartName == "SinglePiePopoutChart" || this.data.chartName == "SingleDoughnutPopoutChart") {
        this.doDoughnutPopoutComputation(this.assetSize, groupindex, index, subelement, argprops);
    } else {
        if (this.data.chartName == "SinglePieChart") {
            this.doPieComputation(this.assetSize, groupindex, index, subelement, argprops);
        } else {
            if (this.data.chartName == "SingleAssetPieOverlayChart") {
                this.doPieAssetOverlayComputation(this.assetSize, groupindex, index, subelement, argprops);
            } else {
                if (this.data.chartName == "SingleDoughnutGaugeChart") {
                    this.maxAngle = 180;
                    this.doGaugeComputation(this.assetSize, groupindex, index, subelement, argprops);
                } else {
                    this.createMicroChartSVG(this.data.layout.microStyle, subelement, argprops, this.assetSize);
                    // this.doDoughnutComputation(this.assetSize, groupindex, index, subelement, argprops);
                }
            }
        }
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * 1);
        this.boolDisableWidth = true;
        if (this.valueAlignment.position == "inner" && this.labelAlignment.samepos == "true" && this.labelAlignment.itemBased == "true") {
            this.labeMaxH = this.state.height * 0.9;
        }
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        argparent.parentNode.parentNode.parentNode.appendChild(sameElement);
        if (this.valueAlignment.hposition == "left" || this.labelAlignment.hposition == "left") {
            argparent.parentNode.parentNode.parentNode.style.flexDirection = "row";
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.boolDisableWidth = true;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.valueMaxW = (this.state.width - this.assetSize) * 0.8;
            this.valueMaxH = this.state.height * 0.5;
            this.doAddTopValue(sameElement, argprops, "", true);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        if (this.valueAlignment.position == "outer" || this.assetSize < this.valueMaxH) {
            this.valueStyle = "outerstyle";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.flexDirection = "column";
            }
            this.valueAlignment.position == "inner" ? this.doAddTopValue(element, argprops, false, false) : this.doAddTopValue(element, argprops, false, true);
        } else if (this.valueAlignment.position == "inner") {
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + index;
            valueElement.className = "valueelement topseriesitem";
            valueElement.style.width = "100%";
            valueElement.style.height = "100%";
            valueElement.style.display = "flex";
            valueElement.style.justifyContent = "center";
            valueElement.style.alignItems = "center";
            valueElement.style.overflow = "hidden";
            valueElement.style.position = "absolute";
            valueElement.style.top = 0;
            subelement.style.position = "relative";
            subelement.appendChild(valueElement);
            this.valueMaxW = this.assetSize * 0.5;
            this.valueStyle = "innerstyle";

            // if(this.data.layout.microStyle=="clsPieMicroDiagram"){
            //     this.valueStyle = "innerstyle";
            // }
            this.doAddTopValue(valueElement, argprops, false, false);
            let valueNode = valueElement.querySelector(".value");
            valueNode.style.marginLeft = "unset";
        }
    }

    if (this.displayLabel(argprops)) {
        graphicH = viewSize;
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

            if (graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(labelElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

                subelement.style.width = "50%";
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition != "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }
};

SinglePiePercentageSeriesItem.prototype.doPieAssetOverlayComputation = function (assetSize, groupindex, index, subelement, argprops) {
    assetSize = parseInt(assetSize);
    let intMaxAngle = 360;
    this.pntCenter.x = parseInt(assetSize / 2);
    this.pntCenter.y = parseInt(assetSize / 2);
    if (argprops.value == 99) {
        this.pntCenter.x = this.pntCenter.x + 5;
    }
    let value = argprops.value < 100 ? argprops.value : 100;
    this.radius = parseInt(assetSize / 2);
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
    this.endAngle = this.startAngle + (intMaxAngle * value) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.graphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "chartgraphic ",
        x: "0%",
        y: "0%",
        width: parseInt(assetSize) + "px",
        height: parseInt(assetSize) + "px",
        "data-graphicassetimage": "true",
        viewBox: 0 + " " + 0 + " " + parseInt(assetSize) + " " + parseInt(assetSize),
    });
    subelement.appendChild(svgElement);
    if (this.data.layout.itemColor == "gradient") {
        strStyleClass = "";
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to  " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.data.layout.itemOpacity ? this.data.layout.itemOpacity : "0.5",
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray?.toString(),
        mask: "url(#mask" + groupindex + ")",
    });
    this.assetURL = this.data.serverUrl + this.voData.asset.data[0].url;
    let ImageTag = this.data.SVGUtils.createSVGElement("image");
    this.data.SVGUtils.assignAttributes(ImageTag, {
        "xlink:href": this.assetURL,
        class: "moodanimation",
        id: "singlepie-" + groupindex + "_" + 0,
        x: this.pntCenter.x - this.radius + "px",
        y: this.pntCenter.y - this.radius + "px",
        width: 2 * this.radius + "px",
        height: 2 * this.radius + "px",
        "data-animation": "imageitem",
        "data-type": "IMAGE",
        "data-secondassetSource": this.data.layout.itemFolder,
    });
    ImageTag.style.pointerEvents = "all";
    svgPathTo.style.pointerEvents = "none";
    svgElement.appendChild(ImageTag);
    svgElement.appendChild(svgPathTo);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }

    if (this.data.layout.itemFillType == "pattern") {
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsTag);
        let pattern = this.data.SVGUtils.createSVGElement("pattern");
        this.data.SVGUtils.assignAttributes(pattern, {
            patternUnits: "userSpaceOnUse",
            width: "25",
            height: "25",
            id: "stripe",
        });
        defsTag.appendChild(pattern);

        let imageTag = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(imageTag, {
            "xlink:href": this.data.serverUrl + "chart/pattern/highlightStripesPattern.png",
            width: "25",
            height: "25",
        });
        pattern.appendChild(imageTag);

        this.data.SVGUtils.assignAttributes(svgPathTo, {
            fill: "url(#stripe)",
            class: "path_to",
        });
    }
};

SinglePiePercentageSeriesItem.prototype.doPieComputation = function (assetSize, groupindex, index, subelement, argprops) {
    assetSize = parseInt(assetSize);
    let intMaxAngle = 360;
    this.pntCenter.x = parseInt(assetSize / 2);
    this.pntCenter.y = parseInt(assetSize / 2);
    if (argprops.value == 99) {
        this.pntCenter.x = this.pntCenter.x + 5;
    }
    let value = argprops.value < 100 ? argprops.value : 100;
    this.totalDashArray = Math.PI * parseInt(assetSize / 2);
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
    this.radius = parseInt(assetSize / 2);
    this.endAngle = this.startAngle + (intMaxAngle * value) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let strStyleBgClass = this.getBgFillDetails(groupindex, "clsTertiaryFill", this.data.layout.backgroundColor, "bgcolor");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "chartgraphic ",
        x: "0%",
        y: "0%",
        width: parseInt(assetSize) + "px",
        height: parseInt(assetSize) + "px",
        viewBox: 0 + " " + 0 + " " + parseInt(assetSize) + " " + parseInt(assetSize),
    });
    subelement.appendChild(svgElement);
    if (this.data.layout.itemColor == "gradient") {
        strStyleClass = "";
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to  " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.data.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": parseInt(assetSize / 2),
        "data-innerradius": 0,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray?.toString(),
        mask: "url(#mask" + groupindex + ")",
    });
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }
    let circlesvg = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(circlesvg, {
        id: "maskcircle" + groupindex,
        class: "moodanimation transformOrgincenter " + strStyleBgClass,
        cx: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.x),
        cy: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.y),
        r: this.data.SVGUtils.createPercentValue(assetSize, this.radius),
        "data-animation": "itembackground",
        "stroke-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.5",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.5",
    });
    svgElement.appendChild(circlesvg);
    svgElement.appendChild(svgPathTo);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }
    if (this.voData.layout.backgroundBorder && this.voData.layout.backgroundBorder.alignment) {
        this.data.SVGUtils.assignAttributes(circlesvg, {
            "fill-opacity": "0",
            "stroke-opacity": "1",
            "stroke-width": this.voData.layout.backgroundBorder.width,
            class: "moodanimation " + this.getBgFillDetails(this.groupindex, "clsTertiaryStroke", this.voData.layout.backgroundBorder.color, "stroke"),
        });
        if (this.voData.layout.itemBgborderstyle == "dashed") {
            this.data.SVGUtils.assignAttributes(circlesvg, {
                "stroke-dasharray": "15,15",
            });
        }
    }
    if (this.data.layout.itemFillType == "pattern") {
        svgElement.classList.add(strStyleClass);
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsTag);
        let pattern = this.data.SVGUtils.createSVGElement("pattern");
        this.data.SVGUtils.assignAttributes(pattern, {
            patternUnits: "userSpaceOnUse",
            width: "25",
            height: "25",
            id: "stripe",
        });
        defsTag.appendChild(pattern);
        if (this.data.asset && this.data.asset.data.length > 0 && this.data.asset.data[this.data.asset.data.length - 1].id == "chartprojectionpattern") {
            this.data.SVGUtils.assignAttributes(pattern, {
                width: "40",
                height: "40",
            });
            let pattentSvg = "";
            if (!this.data.asset.data[this.data.asset.data.length - 1].data) {
                pattentSvg = this.data.slideObj.querySelector("#stripe") ? this.data.slideObj.querySelector("#stripe").children[0].cloneNode(true) : "";
            } else {
                pattentSvg = this.data.asset.data[this.data.asset.data.length - 1].data.cloneNode(true);
            }
            pattern.appendChild(pattentSvg);
        } else {
            let imageTag = this.data.SVGUtils.createSVGElement("image");
            this.data.SVGUtils.assignAttributes(imageTag, {
                "xlink:href": this.data.serverUrl + "chart/pattern/highlightStripesPattern.png",
                width: "25",
                height: "25",
            });
            pattern.appendChild(imageTag);
        }
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            fill: "url(#stripe)",
            class: "path_to",
        });
    }
};
SinglePiePercentageSeriesItem.prototype.doGaugeComputation = function (assetSize, groupindex, index, subelement, argprops) {
    if (this.voData.chartName == "SingleDoughnutGaugeChart") {
        this.outerRadius = this.state.width * 0.38;
        this.outerRadius = this.outerRadius > assetSize ? assetSize * 0.9 : this.outerRadius;
        this.pntCenter.y = assetSize;
    }
    this.startAngle = 180;
    let intMaxAngle = 180;
    this.pntCenter.x = this.state.width / 2;
    let pntEnd = { x: 0, y: 0 };
    let pntStart = { x: 0, y: 0 };

    let pntInnerStart = { x: 0, y: 0 };
    let pntInnerEnd = { x: 0, y: 0 };

    let pntBgEnd = { x: 0, y: 0 };
    let pntBgInnerEnd = { x: 0, y: 0 };

    this.outerRadius = this.outerRadius;
    this.innerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt(this.outerRadius * (this.voData.customProperties.innerRadius * 0.01));
    let value = this.data.values[this.groupindex][0] < 100 ? this.data.values[this.groupindex][0] : 100;
    this.totalDashArray = Math.PI * this.outerRadius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / this.data.maxValue);
    this.endAngle = this.startAngle + (180 / 100) * value;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
    pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;
    let numBgEndAngle = this.startAngle + 180;
    pntBgEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * numBgEndAngle) / 180));
    pntBgEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * numBgEndAngle) / 180));
    pntBgInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (numBgEndAngle / 180)));
    pntBgInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (numBgEndAngle / 180)));
    let strStyleClass = 1 < this.voData.seriesItemLength ? "item" + (this.index + 1) : "item" + (this.groupindex + 1);
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        class: "graphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        viewBox: 0 + " " + 0 + " " + this.width + " " + this.height,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    subelement.appendChild(svgElement);
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path_to-" + this.groupindex + "_" + this.index,
        class: "path_to " + strStyleClass,
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntEnd.x +
            "," +
            pntEnd.y +
            "L" +
            pntInnerEnd.x +
            "," +
            pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-semi-cy": "25%",
        "data-endangle": this.endAngle,
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray?.toString(),
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-animation": "item",
        mask: "url(#mask" + this.groupindex + ")",
        "data-innerradius": this.innerRadius,
    });
    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + this.groupindex + "_" + this.index,
        class: "path_from " + strStyleClass,
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntStart.x +
            "," +
            pntStart.y +
            "L" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "fill-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y + this.pntCenter.y / 2,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
    let svgBgPath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath, {
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (numBgEndAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntBgEnd.x +
            "," +
            pntBgEnd.y +
            "L" +
            pntBgInnerEnd.x +
            "," +
            pntBgInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (numBgEndAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        id: "bg_path-" + this.groupindex + "_" + this.index,
        "data-animation": "itembackground",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : 0.2,
        class: "moodanimation " + this.getBgFillDetails(this.groupindex, "clsTertiaryFill", this.data.layout.backgroundColor, "bgcolor"),
    });
    svgElement.appendChild(svgBgPath);
    svgElement.appendChild(svgPathTo);
};
SinglePiePercentageSeriesItem.prototype.doDoughnutComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let intMaxAngle = this.maxAngle;
    this.pntCenter.x = assetSize / 2;
    this.pntCenter.y = assetSize / 2;
    this.radius = assetSize / 2;
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (intValue / 100);
    this.innerRadius = this.radius * 0.8;
    this.endAngle = this.startAngle + (intMaxAngle * intValue) / 100;
    if (argprops.value == 99) {
        this.pntCenter.x = this.pntCenter.x + 7;
    }
    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.graphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "chartgraphic " + strStyleClass,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
        viewBox: 0 + " " + 0 + " " + assetSize + " " + assetSize,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-type": "CHARTITEM",
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    subelement.appendChild(svgElement);

    let svgBgDonghnutPath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
        id: "svgBgDonghnutPath-" + groupindex + "_" + index,
        class: "moodanimation " + this.getBgFillDetails(this.groupindex, "clsTertiaryFill", this.data.layout.backgroundColor, "bgcolor") + " " + this.getBgFillDetails(this.groupindex, "clsTertiaryStroke", this.data.layout.backgroundColor, "stroke"),
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 1 1 " +
            (this.pntStart.x - 0.001) +
            "," +
            this.pntStart.y +
            "L" +
            (this.pntInnerStart.x - 0.001) +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            " 0 1 0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "data-animation": "itembackground",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : 0.6,
        "stroke-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : 0.6,
    });
    if (this.voData.layout.backgroundBorder && this.voData.layout.backgroundBorder.alignment == "all") {
        this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
            "fill-opacity": "0",
            "stroke-width": this.voData.layout.backgroundBorder.width,
            class: "moodanimation " + this.getBgFillDetails(this.groupindex, "clsTertiaryStroke", this.voData.layout.backgroundBorder.color, "stroke"),
        });
        if (this.voData.layout.itemBgborderstyle == "dashed") {
            this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
                "stroke-dasharray": "15,15",
            });
        }
    }

    svgElement.appendChild(svgBgDonghnutPath);
    if (this.data.layout.itemColor == "gradient") {
        strStyleClass = "";
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray?.toString(),
        mask: "url(#mask" + groupindex + ")",
    });
    svgElement.appendChild(svgPathTo);
    if (this.data.layout.itemFillType == "pattern") {
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsTag);
        let pattern = this.data.SVGUtils.createSVGElement("pattern");
        this.data.SVGUtils.assignAttributes(pattern, {
            patternUnits: "userSpaceOnUse",
            width: "25",
            height: "25",
            id: "stripe",
        });
        defsTag.appendChild(pattern);
        let imageTag = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(imageTag, {
            "xlink:href": this.data.serverUrl + "chart/pattern/highlightStripesPattern.png",
            width: "25",
            height: "25",
        });
        pattern.appendChild(imageTag);
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            fill: "url(#stripe)",
            class: "path_to",
        });
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }
    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + groupindex + "_" + index,
        class: "path_from",
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "L" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": 0,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
};

SinglePiePercentageSeriesItem.prototype.doFillComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.graphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let svgFilterElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgFilterElement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        //filter: "url(#dropshadow)"
    });
    subelement.appendChild(svgFilterElement);

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "svgElement-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
    });
    svgFilterElement.appendChild(svgElement);

    let svgIcon = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgIcon, {
        class: "bgsvg moodanimation",
        "data-animation": "itembackground",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        fill: "#efefef",
        "data-name": this.data.asset.data[0].id,
        "xlink:href": "#" + this.data.asset.data[0].id,
    });
    svgElement.appendChild(svgIcon);
    let baseSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSVG, {
        id: "baseSVG-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        mask: "url(#maskicon)",
    });
    svgElement.appendChild(baseSVG);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        id: "maskicon",
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    let svgAsset = this.data.asset.data[0].data.cloneNode(true);
    svgMask.appendChild(svgAsset);
    let svgAssetWidth = svgAsset.getAttribute("width");
    let svgAssetHeight = svgAsset.getAttribute("height");
    let viewBoxValue = svgAsset.getAttribute("viewBox");
    let pntViewBoxValue = svgAssetWidth != null && svgAssetHeight != null && viewBoxValue == null ? "0 0 " + parseInt(svgAssetWidth) + " " + parseInt(svgAssetHeight) : svgAsset.getAttribute("viewBox");
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.rectHeight = (assetSize * intValue) / 100;
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + groupindex + "_" + index,
        class: "graphic-container",
        x: "0%",
        y: assetSize - this.rectHeight + "px",
        width: "100%",
        height: this.rectHeight + "px",
    });
    baseSVG.appendChild(graphicContainerSVG);
    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + groupindex + "_" + index,
        class: "chartgraphic transformOrginBottom moodanimation " + strStyleClass,
        "data-type": "CHARTITEM",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-animation": "item",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
};
SinglePiePercentageSeriesItem.prototype.doDoughnutPopoutComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let pntEnd = { x: 0, y: 0 };
    let pntStart = { x: 0, y: 0 };
    let pntInnerEnd = { x: 0, y: 0 };
    let pntInnerStart = { x: 0, y: 0 };
    let pntBgEnd = { x: 0, y: 0 };
    let pntBgStart = { x: 0, y: 0 };
    let pntBgInnerEnd = { x: 0, y: 0 };
    let pntBgInnerStart = { x: 0, y: 0 };
    let intMaxAngle = 360;
    this.pntCenter.x = assetSize / 2;
    this.pntCenter.y = assetSize / 2;
    this.outerRadius = assetSize / 2;
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.totalDashArray = Math.PI * this.outerRadius;
    let dasharray = Math.PI * (this.outerRadius * 0.9) - this.outerRadius * 0.2;
    this.valueDashArray = dasharray - dasharray * (intValue / 100);
    this.innerRadius = this.voData.customProperties.innerRadius == 0 || !this.voData.customProperties.innerRadius ? 0 : parseInt(this.outerRadius * (this.voData.customProperties.innerRadius * 0.01));
    this.length = this.voData.seriesItemLength;
    this.endAngle = this.startAngle + (intMaxAngle * intValue) / 100;

    let midAngle = this.startAngle + (this.startAngle - this.endAngle) / 2;
    if (this.endAngle > this.startAngle) {
        midAngle = this.startAngle + (this.endAngle - this.startAngle) / 2;
    }
    let pntCenterPointPadding = this.DistanceMeasureMent(midAngle, 10);

    let intStrokeWidth = this.data.customProperties.appearance == "Outline" ? 4 : 0;
    this.baseRadius = this.outerRadius;
    this.outerRadius = parseInt(this.outerRadius * 0.9);
    this.outerRadius = this.outerRadius - intStrokeWidth;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    pntBgStart = { x: pntEnd.x, y: pntEnd.y };
    pntBgEnd = { x: pntStart.x, y: pntStart.y };
    pntBgEnd.x = pntBgEnd.x == pntBgStart.x && pntBgEnd.y == pntBgStart.y ? pntBgEnd.x - 0.001 : pntBgEnd.x;
    pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
    pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    pntBgInnerStart = { x: pntInnerEnd.x, y: pntInnerEnd.y };
    pntBgInnerEnd = { x: pntInnerStart.x, y: pntInnerStart.y };
    pntBgInnerEnd.x = pntBgInnerEnd.x == pntBgInnerStart.x && pntBgInnerEnd.y == pntBgInnerStart.y ? pntBgInnerEnd.x - 0.001 : pntBgInnerEnd.x;
    pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;
    let centerPointPadding = pntCenterPointPadding;
    centerPointPadding.pointY = parseFloat(this.data.values[this.groupindex][0]) != 100 ? centerPointPadding.pointY : 0;
    this.intRemaingAngle = (360 / 100) * (100 - parseFloat(this.data.values[this.groupindex][0])) + this.endAngle;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");

    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        class: "graphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        viewBox: 0 + " " + 0 + " " + assetSize + " " + assetSize,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    let svgBgPath_to = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath_to, {
        id: "popoutbgpath_to" + this.groupindex + "_" + this.index,
        class: "popoutbgpath_to moodanimation " + this.getBgFillDetails(this.groupindex, "clsTertiaryFill", this.data.layout.backgroundColor, "bgcolor"),
        d:
            "M" +
            pntBgInnerStart.x +
            "," +
            pntBgInnerStart.y +
            "L" +
            pntBgStart.x +
            "," +
            pntBgStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.intRemaingAngle - this.endAngle > 180 ? 1 : 0) +
            ",1 " +
            pntBgEnd.x +
            "," +
            pntBgEnd.y +
            "L" +
            pntBgInnerEnd.x +
            "," +
            pntBgInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.intRemaingAngle - this.endAngle > 180 ? 1 : 0) +
            ",0 " +
            pntBgInnerStart.x +
            "," +
            pntBgInnerStart.y +
            "z",
        "data-animation": "itembackground",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : 0.6,
        "stroke-width": intStrokeWidth + "px",
        "data-customopacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : 0.6,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.intRemaingAngle,
        "data-startangle": this.endAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    let strStyleBgClass = this.getBgFillDetails(groupindex, "clsTertiaryFill", this.data.layout.backgroundColor, "bgcolor");
    let svgBgPath_from = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgPath_from, {
        id: "bgpath_from" + this.groupindex + "_" + this.index,
        class: "bgpath_from moodanimation " + strStyleBgClass,
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 1 1 " +
            (pntStart.x - 0.001) +
            "," +
            pntStart.y +
            "L" +
            (pntInnerStart.x - 0.001) +
            "," +
            pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            " 0 1 0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "1",
        "data-cx": this.pntCenter.x,
        "data-customopacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "1",
        "data-cy": this.pntCenter.y,
        "data-endangle": this.intRemaingAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
        style: "opacity:0",
    });
    if (this.data.layout.backgroundColor == "gradient") {
        this.addGradient(svgBgPath_to, svgElement, true, true, true);
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path:" + this.groupindex + "_" + this.index,
        class: "path_to " + this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor"), //this.ChartFonts.graphicFillColor(this.groupindex),
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntEnd.x +
            "," +
            pntEnd.y +
            "L" +
            pntInnerEnd.x +
            "," +
            pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "fill-opacity": this.data.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 1,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": assetSize / 2,
        "data-animation": "item",
        "data-innerradius": this.innerRadius,
        "data-totaldasharray": Math.PI * this.baseRadius,
        "data-valuedasharray": this.valueDashArray.toString(),
        mask: "url(#mask" + groupindex + ")",
    });

    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + this.groupindex + "_" + this.index,
        class: "path_from",
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntStart.x +
            "," +
            pntStart.y +
            "L" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "fill-opacity": 0,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
    svgElement.appendChild(svgBgPath_from);
    svgElement.appendChild(svgBgPath_to);
    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgGroup, {
        class: "valuegroup",
        "data-animation": "itemmmovegroup",
        "data-moveX": centerPointPadding.pointX,
        "data-movey": centerPointPadding.pointY,
        transform: "translate(" + centerPointPadding.pointX + "," + centerPointPadding.pointY + ")",
    });
    svgElement.appendChild(svgGroup);
    svgGroup.appendChild(svgPathTo);
    subelement.appendChild(svgElement);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }
    if (this.data.layout.itemFillType == "pattern") {
        let defsTag = this.data.SVGUtils.createSVGElement("defs");
        svgElement.appendChild(defsTag);
        let pattern = this.data.SVGUtils.createSVGElement("pattern");
        this.data.SVGUtils.assignAttributes(pattern, {
            patternUnits: "userSpaceOnUse",
            width: "25",
            height: "25",
            id: "stripe",
        });
        defsTag.appendChild(pattern);
        let imageTag = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(imageTag, {
            "xlink:href": this.data.serverUrl + "chart/pattern/highlightStripesPattern.png",
            width: "25",
            height: "25",
        });
        pattern.appendChild(imageTag);
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            fill: "url(#stripe)",
            class: "path_to",
        });
    }
};
SinglePiePercentageSeriesItem.prototype.DistanceMeasureMent = function (midAngle, distance) {
    let pntX = distance;
    let pntY = this.data.values[0][0] < 50 ? -distance : distance;
    if (this.data.values[0][0] == 50) {
        pntX = distance;
        pntY = 0;
    }
    let xyPos = {
        pointX: pntX,
        pointY: pntY,
    };
    return xyPos;
};

function SimpleColumnImageChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
    this.bollEnableSize =false;
}
SimpleColumnImageChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleColumnImageChart.prototype.constructor = SimpleColumnImageChart;

SimpleColumnImageChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleColumnImageSeries"](argparent, argprops);
}
SimpleColumnImageChart.prototype.doAddGraphicElement=function(argparent) {
    let padding = 10;
    let moveY = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
    this.createGraphicsImage();
}
SimpleColumnImageChart.prototype.createGraphicsImage=function() {
    let graphicElement = this.parent.querySelectorAll(".chartgraphic");
    let valueElement = this.parent.querySelectorAll(".value");
    let labelElement = this.parent.querySelectorAll(".label");
    let seriesElement = this.parent.querySelectorAll(".series");
    for (let i1 = 0; i1 < graphicElement.length; i1++) {
        let assetdata = this.voData.asset.data.length>0&&this.voData.asset.data[0].data?JSON.parse(this.voData.asset.data[0].data):"";
        let farmes = "";
        let assetValueUrl = "";
        if(assetdata){
            farmes =assetdata.frames;
            this.data.spriteasset.push({name:this.data.layout.assetname,assetvalue:this.voData.asset.data});
            assetValueUrl = this.voData.asset.data[1].url
        }else{
            if(this.data.spriteasset.length>0){
                for(let k1=0;k1<this.data.spriteasset.length;k1++){
                    if(this.data.spriteasset[k1].name ==this.data.layout.assetname ){
                        assetdata =JSON.parse(this.data.spriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.spriteasset[k1].assetvalue[1].url
                    }
         
                }
                farmes =assetdata.frames;
            }
            if(!farmes&&this.data.secondaryspriteasset.length>0&&!assetdata){
                for(let k1=0;k1<this.data.secondaryspriteasset.length;k1++){
                    if(this.data.secondaryspriteasset[k1].name ==this.data.layout.assetname){
                        assetdata =JSON.parse(this.data.secondaryspriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.secondaryspriteasset[k1].assetvalue[1].url
                    }
         
                }
                farmes =assetdata?assetdata.frames:"";
            }
        }
        const totalfarmes = farmes.length - 1;
        const assetURL = this.data.serverUrl +assetValueUrl ;
        let indexValue = (this.voData.values[i1][0]/this.data.rangePositive)*100;

        let frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((indexValue/100) * totalfarmes);
        if(this.data.seriesLength==1){
            frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((this.voData.values[i1][0] / 100) * totalfarmes);
        }
        const frame = farmes[frameIndex].frame;

        let spriteCoordinates = [];
        for (let i1 = 0; i1 < totalfarmes+1; i1++) {
            let eachFrame = farmes[i1].frame;
            let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
            spriteCoordinates.push(eachFrameCoordinates);
        }

        let itemWidth = graphicElement[i1].clientWidth;
        let itemHeight = graphicElement[i1].clientHeight;
        if(this.data.layout.itemgap!=1&&this.data.layout.itemgap>1){
            itemWidth = this.data.layout.itemgap
        }
        if(itemWidth>graphicElement[i1].clientWidth){
            itemWidth = graphicElement[i1].clientWidth;
        }
        let graphicSize = itemWidth>itemHeight?itemHeight:itemWidth;
      
        graphicElement[i1].style.height = graphicSize+"px";
        graphicElement[i1].style.width = graphicSize+"px";
        if(this.data.layout.valueItemBased=="true"&&this.data.layout.labelItemBased=="true")
        {
            graphicElement[i1].parentNode.style.alignItems = "center";
            graphicElement[i1].parentNode.style.justifyContent = "center";
        }else{
            graphicElement[i1].parentNode.style.width = graphicSize+"px";
            graphicElement[i1].parentNode.style.height = graphicSize+"px";
        }
        itemWidth =graphicSize;
        itemHeight = graphicSize;
        const scaleX = itemWidth / frame.w;
        const scaleY = itemHeight / frame.h;
        let scale = scaleX < scaleY ? scaleX : scaleY;
        scale  = scale==0?1:scale;
        const viewWidth = frame.w * scale;
        const viewHeight = frame.h * scale;
        let translateX = (itemWidth-viewWidth) / 2;
        const translateY = (itemHeight-frame.h) / 2;

        let assetelement = this.ChartHelper.createDivElement({});
        assetelement.id = "graphicimage-" + i1;
        assetelement.className = "graphicimage";
        // assetelement.dataset.animation = "spriteanimation";
        assetelement.dataset.frameindex = frameIndex;
        assetelement.dataset.assetURL = assetURL;
        assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
        assetelement.setAttribute(
            "style",
            "width:" +
                frame.w +
                "px; height:" +
                frame.h +
                "px; background-repeat:no-repeat; background-image:url('" +
                assetURL +
                "'); background-position:" +
                -frame.x +
                "px " +
                -frame.y +
                "px;" +
                "transform: translate(" +
                translateX +
                "px," +
                translateY +
                "px) scale(" +
                scale +
                "," +
                scale +
                ");position: absolute"
        );
        graphicElement[i1].appendChild(assetelement);
        translateX = (itemWidth-assetelement.clientWidth)/2;

        assetelement.setAttribute(
            "style",
            "width:" +
                frame.w +
                "px; height:" +
                frame.h +
                "px; background-repeat:no-repeat; background-image:url('" +
                assetURL +
                "'); background-position:" +
                -frame.x +
                "px " +
                -frame.y +
                "px;" +
                "transform: translate(" +
                translateX +
                "px," +
                translateY +
                "px) scale(" +
                scale +
                "," +
                scale +
                ");position: absolute"
        )
        // if(this.data.seriesLength!=1){
        //     let graphicHeightValue = graphicElement.parentNode.clientHeight
        //     graphicElement.style.height = graphicHeightValue*scale+"px"
        // }
        let labelW = labelElement[i1] ? labelElement[i1].clientWidth : 0;
        let valueW = valueElement[i1] ? valueElement[i1].clientWidth : 0;
        let widthPercentage = parseInt(((viewWidth + labelW + valueW + 20) / this.state.width) * 100) + "%";
        if (seriesElement[i1]) {
            seriesElement[i1].style.maxWidth = "100%";
        }
    }
}
function SimpleColumnImageSeries(argparent, argprops) {
    this.name = "SimpleColumnImageSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleColumnImageSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleColumnImageSeries.prototype.constructor = SimpleColumnImageSeries;

SimpleColumnImageSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleColumnImageSeriesItem"](argparent, argprops);
}
function SimpleColumnImageSeriesItem(argparent, argprops) {
    this.name = "SimpleColumnImageSeriesItem";
    this.groupindex = argprops.groupindex;
    this.graphicH = 0;
    this.bkelement = "";
    this.bkSubElement = "";
    this.middleelementValue;
    this.middleelementLabel;
    this.middleelementPlaceholder;
    this.addvalue = argprops.addvalue;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleColumnImageSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleColumnImageSeriesItem.prototype.constructor = SimpleColumnImageSeriesItem;

SimpleColumnImageSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, centerAlign = false) {
    let _oHeight = 0;
    let _iHeight = 0;
    this.boolEnableInnerValue = false;
    let highlightDifferenceHeight = 0;

    const index = argprops.index;
    const groupindex = argprops.gindex;
    objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = 30;
    }
    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    if (this.groupindex == 0 && this.index == 0) {
        overlapStackedColumn = false;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        this.middleelementLabel = this.ChartHelper.createDivElement({});
        this.middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementLabel.className = "middleelement  moodanimation";
        this.middleelementLabel.dataset.animation = "columncirclearrow";
        this.middleelementLabel.style.width = this.middleLW + "px";
        this.middleelementLabel.style.height = this.middleLH + "px";
        this.middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementLabel);
        if (this.labelAlignment.position == "middle") this.middleelementLabel.className = "this.middleelementLabel";
        this.createSVGElement(this.middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = this.data.layout.valuefontsize ? this.data.layout.valuefontsize * 2 : parseInt(this.state.width * 0.4 * 0.25);
        this.middleVH = this.data.layout.valuefontsize ? this.data.layout.valuefontsize * 2 : parseInt(this.state.width * 0.4 * 0.25);

        this.middleVW = this.middleVW > 170 ? 170 : this.middleVW;
        this.middleVH = this.middleVH > 170 ? 170 : this.middleVH;

        this.middleVW = this.data.layout.valueShapeWidth ? this.data.layout.valueShapeWidth : this.middleVW;
        this.middleVH = this.data.layout.valueShapeHeight ? this.data.layout.valueShapeHeight : this.middleVH;

        this.middleelementValue = this.ChartHelper.createDivElement({});
        this.middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementValue.className = "middleelement  moodanimation";
        this.middleelementValue.dataset.animation = "columncirclearrow";
        this.middleelementValue.style.width = this.middleVW + "px";
        this.middleelementValue.style.height = this.middleVH + "px";
        this.middleelementValue.style.padding = "10px";
        if (this.data.layout.boolvaluebgShape) {
            this.valuebgProperties(this.middleelementValue);
            this.middleelementValue.style.padding = "8px";
        }
        if (this.data.layout.valuebgBgColor == "theme") {
            this.valueStyle = this.ChartFonts.valueInnerColor;
        }
        if (this.data.layout.valuePaddingleft) this.middleelementValue.style.marginLeft = this.data.layout.valuePaddingleft + "px";
        if (this.data.layout.valuePaddingright) this.middleelementValue.style.marginRight = this.data.layout.valuePaddingright + "px";
        if (this.data.layout.valuePaddingbottom) this.middleelementValue.style.marginBottom = this.data.layout.valuePaddingbottom + "px";
        if (this.data.layout.valuePaddingtop) this.middleelementValue.style.marginTop = this.data.layout.valuePaddingtop + "px";
        element.appendChild(this.middleelementValue);

        if (this.data.seriesLength == 1) {
            this.createSVGElement(this.middleelementValue, argprops, "value", false, true);
        } else {
            this.createSVGElement(this.middleelementValue, argprops, "value");
        }
        let valueSuffixElement = this.middleelementValue.querySelector(".clsSuffixTxt");
        if (valueSuffixElement) {
            valueSuffixElement.classList.remove("clsInnerSuffixTxt");
            valueSuffixElement.classList.add("clsInnerSuffixTxt");
        }
        let valuePerfixElement = this.middleelementValue.querySelector(".clsPrefixTopSmallTxt");
        if (valuePerfixElement) {
            valuePerfixElement.classList.remove("clsInnerPrefixTxt");
            valuePerfixElement.classList.add("clsInnerPrefixTxt");
        }
    }

    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        this.middleelementPlaceholder = this.ChartHelper.createDivElement({});
        this.middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementPlaceholder.className = "middleelement  moodanimation";
        this.middleelementPlaceholder.dataset.animation = "columncirclearrow";
        this.middleelementPlaceholder.style.width = this.middlePW + "px";
        this.middleelementPlaceholder.style.height = this.middlePH + "px";
        this.middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementPlaceholder);
        this.createSVGElement(this.middleelementPlaceholder, argprops, "placeholder");
    }

    parentHeight = this.state.height;
    // if(this.data.minValue<0){
    //  parentHeight =this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    //  parentHeight = parentHeight<this.state.height?this.state.height:parentHeight;
    // }

    let baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.5) + dropShadowHeight + highlightDifferenceHeight);
    let valueHeight = argprops.minvalue < 0 ? 2 * this.maxValueH : this.maxValueH;
    if (this.valueAlignment.position == "outer") {
        baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight + valueHeight);
    }

    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;

    let baseGraphicHeightPercentage = baseGraphicHeight;
    let dummeyValue = argprops.value;
    let differncePercentage = (this.data.rangePositive * 0.8) / this.data.secondPositiveHighValue;
    if (this.data.highvaluebreak && argprops.value != this.data.rangePositive) {
        dummeyValue = argprops.value * differncePercentage;
    }
    if (this.data.seriesLength == 1 && dummeyValue == 0 && totalValue == 0) {
        totalValue = 1;
        dummeyValue = 1;
        argprops.totalvalue = 1;
    }
    let graphicHeightPercentage = baseGraphicHeightPercentage * (dummeyValue / totalValue);
    let parentPercentage = baseGraphicHeightPercentage * (argprops.totalvalue / totalValue);
    let seriesItem = this.parent.querySelectorAll(".topseriesitem");
    for (let s1 = 0; s1 < seriesItem.length; s1++) {
        seriesItem[s1].style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage + this.maxValueH);
    }
    let ParentHeightValue = parentPercentage + this.maxValueH;

    // let seriesItemHeight =
    if (this.data.data.getAttribute("data-multiseries") && this.data.seriesItemLength > 1) {
        graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / this.data.seriesItemMaxValue[groupindex]);
    }

    // if(this.data.minValue==0){
    //     graphicHeightPercentage = baseGraphicHeightPercentage * ((parseFloat(argprops.value)+10) / (argprops.maxvalue+10));
    // }
    if (this.valueAlignment.position == "middle") {
        this.middleelementValue.setAttribute("data-graphic-y", graphicH);
        if (this.data.chartFlip) {
            this.middleelementValue.setAttribute("data-graphic-y", -graphicH);
        }
    }
    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        // let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = this.getBgColorDetails(groupindex, this.ChartFonts.emphasizeColor, this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
        // let bgClsFillStyle = "";
        // if (this.data.layout.backgroundColor == "theme") {
        //     bgClsFillStyle = this.ChartFonts.graphicBgColor(groupindex);
        // } else {
        //     if (this.data.layout.backgroundColor == "transparent") {
        //         bgClsFillStyle = " transparent";
        //     } else {
        //         bgClsFillStyle = this.ChartFonts.emphasizeColor;
        //     }
        // }
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        backgroundElement.style.opacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customorgin = this.customOrginValue;
        backgroundElement.style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage);
        if (this.data.chartName == "columnslider") {
            backgroundElement.style.width = 100 * this.thicknessPercentage + "%";
        }
        if (this.data.layout.backgroundColor == "gradient") {
            backgroundElement.style.backgroundImage = this.data.layout.backgroundGradientValues ? this.data.layout.backgroundGradientValues : "";
        }
        element.appendChild(backgroundElement);

        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = "chartMainGraphic backgroundItem moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = backgroundElement.style.width;
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            backgroundBorderElement.dataset.customopacity = "0.5";
            backgroundBorderElement.style.height = this.data.SVGUtils.createPercentValue(this.state.height, parentPercentage);
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            if (this.data.layout.backgroundborderstyle == "dashed") {
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment + "dashed");
                backgroundBorderElement.style.setProperty("--border-style", "dashed", "");
            } else {
                backgroundBorderElement.style.setProperty("--border-style", "solid", "");
                backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
            }
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            backgroundBorderElement.style.setProperty("--border-width", this.data.layout.backgroundBorder.width + "px", "");

            let BgBorderColor = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.data.layout.backgroundBorder.color, "bordercolor");
            backgroundBorderElement.classList.add(BgBorderColor);
            if (this.data.layout.backgroundBorder.color == "gradient") {
                backgroundBorderElement.classList.add("itemborderGrdient");
            }
            // if (this.data.layout.backgroundBorder.color == "theme") {
            //     let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
            //     backgroundBorderElement.classList.add("accent" + (groupindex + 1) + "-border-color");
            //     if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
            //         this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
            //     }
            // }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = "";

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.itemBased == "true" || this.labelAlignment.itemBased == "true") {
        subelement.style.width = 100 + "%";
    }
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder")) && this.labelAlignment.itemBased != "true" && this.valueAlignment.itemBased != "true")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    // subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : graphicHeightPercentage+"px";
    subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue, graphicHeightPercentage);
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    if (this.data.chartName == "columnslider") {
        subelement.style.borderRadius = "35px";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic graphicnode moodanimation " + this.transformOrginValue + " " + clsStyle;
    graphicElement.dataset.customorgin = this.customOrginValue;
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
    graphicElement.dataset.animation = "item";
    if (this.data.hasEmphasis || this.data.hasProjection) {
        graphicElement.classList.add("chartMainGraphic");
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    if (this.data.chartName == "columnStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }

    if (this.data.chartName == "columnslider") {
        graphicElement.style.borderRadius = "35px";
    }
    if ((this.style.bgFillType == "gradient" && !this.data.hasEmphasis) || (this.style.bgFillType == "gradient" && this.data.hasEmphasis && this.data.emphasis[groupindex] == true)) {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    if (this.data.highvaluebreak && argprops.value >= this.data.rangePositive) {
        let highvalueBreakElemnt = this.ChartHelper.createDivElement({});
        highvalueBreakElemnt.style.height = "6%";
        highvalueBreakElemnt.style.position = "absolute";
        highvalueBreakElemnt.style.width = "100%";
        graphicElement.style.position = "relative";
        if (this.data.chartFlip) {
            highvalueBreakElemnt.style.bottom = "13%";
        } else {
            highvalueBreakElemnt.style.top = "11%";
        }
        graphicElement.parentNode.appendChild(highvalueBreakElemnt);
        let dividerHeight = highvalueBreakElemnt.clientHeight;
        let dividerWidth = highvalueBreakElemnt.clientWidth;
        let point1 = { x: 0, y: 0 };
        let point2 = { x: 0, y: 0 };
        let point3 = { x: 0, y: 0 };
        let point4 = { x: 0, y: 0 };
        let svgParent = this.data.SVGUtils.createSVGElement("svg");
        highvalueBreakElemnt.appendChild(svgParent);
        let svgPath = this.data.SVGUtils.createSVGElement("path");
        point1.x = 0;
        point1.y = dividerHeight;
        point2.x = dividerWidth * 0.44;
        point2.y = 7;
        point3.x = dividerWidth * 0.5;
        point3.y = dividerHeight;
        point4.x = dividerWidth;
        point4.y = 7;
        let pathValue = "M" + point1.x + "," + point1.y + " L" + point2.x + "," + point2.y + " L" + point3.x + "," + point3.y + " L" + point4.x + "," + point4.y;
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: pathValue,
            "stroke-width": "8px",
            fill: "none",
            class: "dividerpath moodanimation",
            "data-animation": "highvaluebreak",
        });
        svgParent.appendChild(svgPath);
    }
    if (this.data.layout.enableBackground) {
        if (this.voData.layout.backgroundBorderRadiusValues) {
            let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    clsStyle = "";

    if (this.data.chartName != "columnSimpleRectangleFill") {
        ///DropShadow
        let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
        // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
        let colorStyle = this.data.layout.itemBoxShdowColor == "item" || this.data.layout.itemBoxShdowColor == "theme" ? clsStyle : this.data.layout.itemBoxShdowColor;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
        // graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    }
    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "columnborderelement";
        borderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);

        // graphicElement.classList.remove("accent" + (styleIndex + 1) + "-bg-color");
        // graphicElement.classList.add("background-bg-color");

        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        // if (this.voData.shapeBoderColor == "theme") {
        let strBordeStyleClass = this.getBgColorDetails(groupindex, this.data.ChartFonts.appendgraphicBorderColor(groupindex), this.voData.shapeBoderColor, "bordercolor");
        borderElement.classList.add(strBordeStyleClass);
        if (this.voData.shapeBoderColor == "gradient") {
            borderElement.classList.add("itemborderGrdient");
        }
        this.emphasisColor = " tertiary-border-color";
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
            if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
                let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
                graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
            }
        }
        if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
            this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex, true);
        }

        if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
            graphicElement.classList.remove("background-bg-color");
            graphicElement.classList.add(this.data.ChartFonts.appendgraphicBgColor(styleIndex));
        }
        borderElement.classList.add("moodanimation");
        borderElement.dataset.animation = "itemborder";
        borderElement.setAttribute("data-graphic-y", graphicElement.clientHeight);
        if (this.data.chartFlip) {
            borderElement.setAttribute("data-graphic-y", -graphicElement.clientHeight);
        }
        // }

        if (this.data.layout.itemborderstyle == "dashed") {
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign + "dashed");
            borderElement.style.setProperty("--border-style", "dashed", "");
        } else {
            borderElement.style.setProperty("--border-style", "solid", "");
            borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        }
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
        borderElement.style.setProperty("--border-width", this.voData.shapeBoderSize + "px", "");

        if (graphicHeightPercentage < this.voData.shapeBoderSize) {
            borderElement.style.borderWidth = graphicHeightPercentage + "px";
            borderElement.style.setProperty("--border-width", graphicHeightPercentage + "px", "");
        }
    }

    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = graphicElement.clientHeight + "px 0% 0%";
    }

    if (borderElement) {
        borderElement.classList.remove("columnborderelement");
        borderElement.classList.add("columnborderelement");
    }
    if (this.data.grapicImage[groupindex] == "true" && this.data.chartName != "columnSimpleRectangleFill" && this.data.chartName != "column3DRectangle") {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        // subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
        let item = this.ChartUtils.getOffsetLeftTop(graphicElement, "SLIDE", true);
        graphicElement.setAttribute("data-x", item.x);
        graphicElement.setAttribute("data-y", item.y);
        graphicElement.setAttribute("data-width", graphicElement.clientWidth);
        graphicElement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-width", graphicElement.clientWidth);
        subImgelement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

        subImgelement.setAttribute("data-x", item.x);
        subImgelement.setAttribute("data-y", item.y);
        graphicElement.style.position = "absolute";
        graphicElement.style.overflow = "hidden";
        if (this.data.data.getAttribute("layout") == "outsidenumberbottom" || this.data.data.getAttribute("layout") == "outsidenumberinsidelabel" || this.data.data.getAttribute("layout") == "outsidenumber" || this.data.data.getAttribute("layout") == "labeloutsidetop") {
            // subImgelement.style.position = "absolute";
            graphicElement.style.position = "relative";
        }
        this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img");
        if (this.data.hasEmphasis || this.data.hasProjection) {
            let bgColor = window.getComputedStyle(graphicElement)["background-color"];
            this.ChartUtils.applyOverlayToImage(subImgelement, bgColor);
        }
    }
    if (this.index == 1) {
        graphicElement.classList.remove("chartgraphic");
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        graphicH = Math.round(graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        this.valueMaxW = this.state.width * 0.5;
        // if( this.valueAlignment.position == "inner"||this.labelAlignment.position == "inner"&&this.valueAlignment.samepos == "true"){
        sameElement.style.height = "100%";
        //}
        if (booloverLap) {
            this.overlap = booloverLap;
            sameElement.style.position = "relative";
            sameElement.style.justifyContent = "flex-end";
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.appendChild(subelement);
            overlapParentDiv.appendChild(sameElement);
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%;height:100%;",
            });
            overlapParentDiv.style.flexDirection = "column-reverse";
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
        } else {
            subelement.appendChild(sameElement);
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.voData.shapeBorder ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.samepos != "true")) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            if (this.placeholderAlignment.itemBased == "true" && this.placeholderAlignment.samepos != "true") {
                let itembasedPlaceholderElement = this.ChartHelper.createDivElement({});
                itembasedPlaceholderElement.style.width = graphicElement.clientWidth + "px";
                itembasedPlaceholderElement.style.position = "relative";
                itembasedPlaceholderElement.style.left = graphicElement.offsetLeft + "px";
                argparent.appendChild(itembasedPlaceholderElement);
                this.doAddTopPlaceholder(itembasedPlaceholderElement, argprops);
                if (itembasedPlaceholderElement.children.length > 0) {
                    itembasedPlaceholderElement.children[0].style.display = "flex";
                    itembasedPlaceholderElement.children[0].children[0].style.width = itembasedPlaceholderElement.children[0].children[0].clientHeight + "px";
                }
            } else {
                this.doAddTopPlaceholder(argparent, argprops);
            }
        }
    }

    if (this.displayLabel(argprops)) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.labelMaxW = subelement.clientWidth;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";

            if (graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(labelElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%;height:100%;",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

                subelement.style.width = "50%";
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.labelMaxW = labelElement.clientWidth;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            if (this.valueAlignment.itemBased == "true" && graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH) && this.labelAlignment.position == "inner") {
                let overlapParentDiv1 = this.ChartHelper.createDivElement({});
                graphicElement.parentNode.appendChild(overlapParentDiv1);
                this.data.SVGUtils.assignAttributes(overlapParentDiv1, {
                    style: "display:flex;align-items: flex-end;width:100%;height:100%;",
                });
                overlapParentDiv1.appendChild(graphicElement);
                this.doAddLabel(overlapParentDiv1, argprops);
            } else {
                this.doAddLabel(element, argprops);
            }
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }
    if (this.data.layout.secondaryElement && this.alignment.itemBased == "true") {
        this.doAddSecondaryLabel(element, argprops, true);
        if (this.alignment.itemBased == "true" && this.alignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.secondarylayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.alignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            if (this.data.layout.secondaryElementType != "image") {
                this.doAddSecondaryLabel(labelElement, argprops);
            } else {
                this.doSecondaryImage(labelElement, argprops);
            }
        }
    }

    if (this.displayValue(argprops)) {
        graphicH = Math.round(graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true);
        this.boolEnableInnerValue = false; //(((this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && ((element.clientHeight - subelement.clientHeight) < this.maxValueH)))
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            this.valueOuter = true;
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.itemBasedValueWidth + "%" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv);
                subelement.parentNode.appendChild(label[0]);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(valueElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%;height:100%;",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%";
                graphicElement.style.width = "100%";
                if (borderElement) borderElement.style.width = "100%";
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || (this.data.chartName == "columnStackedRectangle" && subelement.clientHeight < this.maxValueH) || graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && !this.boolEnableInnerValue && this.valueAlignment.itemBased != "true") {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.data._emphasisName == "emphasize-grey"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                    ? this.ChartFonts.graphicColor(styleIndex)
                    : this.ChartFonts.valueOuterColor;
            graphicH = Math.round(subelement.clientHeight) - this.maxValueH;
            this.valueOuter = true;
            if (this.data.layout.enableBackground) {
                this.doAddTopValue(element, argprops);
            } else if (this.data.chartName == "columnStackedRectangle") {
                overlapStackedColumn = true;
                this.removeValueElement();
            } else this.doAddTopValue(element, argprops);
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.maxValueH) || this.boolEnableInnerValue) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? 100 * this.thicknessPercentage + "%" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }

            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
            this.valueStyle = this.ChartFonts.valueOuterColor;
            element.style.order = 1;
            if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH) {
                this.overlap = subelement.clientHeight < this.maxValueH;
                this.doAddTopValue(element, argprops);
            } else {
                this.doAddTopValue(argparent, argprops);
            }
        }
    }
    bkelement = element;
    bkSubElement = subelement;
    this.middleElementvalidation(element, subelement, this.middleelementValue, middleelementPlaceholder, middleelementLabel);
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
    let multiSeries = this.data.data.getAttribute("data-multiseries") ? true : false;
    if ((this.data.comparisonStyle == "style2" && this.data.seriesItemLength < 2 && this.data.rangeNegative >= 0) || (this.data.comparisonStyle == "style2" && multiSeries)) {
        differnceIndex = multiSeries ? index : groupindex;
        let boolEnablecomparestyle = "";
        if (multiSeries) {
            boolEnablecomparestyle = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index + 1]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index - 1]);
        } else {
            boolEnablecomparestyle = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex + 1][index]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex - 1][index]);
        }

        if (boolEnablecomparestyle) {
            let differentValue1;
            if (multiSeries) {
                differentValue1 = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            } else {
                differentValue1 = differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            }
            let differentValue = ((differentValue1 / this.data.rangePositive) * 100).toFixed(0) + "%";
            let eprops = {
                differentValue: differnceIndex == 0 ? differentValue : differentValue,
            };
            //this.createCompareStyle(element, eprops, graphicElement)
        }
    }
    if (this.data.chartName == "columnSimpleRectangleFill") {
        this.createRect(graphicElement, argparent);
    }
    if (this.data.layout.itemFillType == "pattern") {
        this.createPatternSvg(graphicElement);
        if (borderElement) borderElement.style.zIndex = "3";
    }
    if (this.data.layout.backgroundFillType == "pattern") {
        this.createPatternSvg(backgroundElement);
        subelement.parentNode.appendChild(subelement);
    }
    if (backgroundElement && this.data.layout.itemalterpos == "true") {
        backgroundElement.style.width = graphicElement.clientWidth + "px";
        backgroundElement.style.left = graphicElement.offsetLeft + "px";
        if (backgroundBorderElement) backgroundBorderElement.style.left = this.data.layout.backgroundBorder.width ? graphicElement.offsetLeft - this.data.layout.backgroundBorder.width + "px" : graphicElement.offsetLeft + "px";
    }
    if (backgroundElement) {
        if (this.data.layout.data.background.opacity) {
            let Class = this.getBgClassList(backgroundElement);
            let rgbavalue = this.ChartUtils.createRBGColor(Class, this.groupindex, this.data.layout.backgroundOpacity);
            backgroundElement.style.setProperty("background-color", rgbavalue, "important");
        }
    }
    if (backgroundElement) {
        backgroundElement.style.width = graphicElement.clientWidth + "px";
        if (backgroundBorderElement) {
            backgroundBorderElement.style.width = graphicElement.clientWidth + "px";
        }
    }
    if (middleelementPlaceholder && (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true")) {
        middleelementPlaceholder.style.position = "absolute";
        if (this.placeholderAlignment.hposition == "left") {
            middleelementPlaceholder.style.left = graphicElement.parentNode.offsetLeft + graphicElement.offsetLeft;
            middleelementPlaceholder.style.margin = "unset";
        }
        if (this.placeholderAlignment.hposition == "center") {
            middleelementPlaceholder.style.left = graphicElement.offsetLeft + (graphicElement.clientWidth - middleelementPlaceholder.clientWidth) / 2;
        }
        if (this.placeholderAlignment.hposition == "right") {
            middleelementPlaceholder.style.left = graphicElement.offsetLeft + graphicElement.clientWidth - middleelementPlaceholder.clientWidth + "px";
        }
    }
    ///DropShadow
    if (this.data.layout.itemShadow && this.data.chartName != "columnStackedRectangle") {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if (this.data.layout.itemOpacityClass) {
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};
SimpleColumnImageSeriesItem.prototype.doAddBottomSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numBottomHeight = -argprops.minvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight =
            (this.labelAlignment && this.labelAlignment.position == "middle") || (this.valueAlignment && this.valueAlignment.position == "middle") || (this.placeholderAlignment && this.placeholderAlignment.position == "middle") || (this.valueAlignment && this.valueAlignment.position == "middle") ? 300 : 163;
        if (numBottomHeight < minimumHeight && argprops.minvalue < 0) {
            numBottomHeight = minimumHeight;
        }
        numBottomHeight = numBottomHeight > this.state.height - this.itembasedHeight ? this.state.height - this.itembasedHeight : numBottomHeight;
    }

    let minGraphicHeight = (numBottomHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem bottomseriesitem";
    element.style.height = "0%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numBottomHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (argprops.value < 0) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numBottomHeight },
        };
        // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "top") {
        //     this.doAddBottomPlaceholder(element, argprops);
        // }

        // if (this.displayValue(argprops) && this.valuePosition == "top") {
        //     this.doAddBottomValue(element, argprops);
        // }
        this.doAddBottomGraphicsContainer(element, eprops);

        // this.middleElementvalidationBottom(bkelement, element,this.middleelementValue, middleelementPlaceholder, middleelementLabel,eprops);
    } else {
        if (bkSubElement) {
            this.middleElementvalidation(bkelement, bkSubElement, this.middleelementValue, middleelementPlaceholder, middleelementLabel);
        }
    }
};
SimpleColumnImageSeriesItem.prototype.doAddGraphicElement = function () {
    this.itemBasedValueWidth = 1 - this.thicknessPercentage;
    if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") && this.data.chartName == "simpleIconFillRepeatChart") {
        let remaingValue = this.data.values[this.groupindex][this.index] % 10;
        let maxCount = this.data.displayValueMaxCount;

        let roundedValue = 0;
        let originalValue = 0;
        if (remaingValue >= 5) {
            let addinValue = 10 - remaingValue;
            originalValue = addinValue + parseInt(this.data.values[this.groupindex][this.index]);
        } else {
            originalValue = parseInt(this.data.values[this.groupindex][this.index]) - remaingValue;
        }
        this.data.valuesDenomination[this.index][0] = originalValue;
        let splitValue = this.data.values[this.groupindex][this.index].toString().split("");
        let multiplefactor = maxCount / 10;
        let graphicCount = splitValue.length > 1 ? parseFloat(splitValue.join(".")) : this.data.values[this.index][0];
        graphicCount = Math.round(graphicCount * multiplefactor);
        graphicCount = this.data.values[this.index][0] >= 100 ? maxCount : graphicCount;
        this.data.valuesDenomination[this.index][0] = graphicCount;
    }
    if (this.data.displayValueFormat == "outof" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data._valuesDenomination[this.groupindex][this.index] = this.data._valuesDenomination[this.groupindex][this.index] + " out of " + this.data.displayValueMaxCount;
    }
    if (this.data.displayValueFormat == "fraction" && this.data.chartName == "simpleIconFillRepeatChart") {
        this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] + "/" + this.data.displayValueMaxCount;
    }
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };
    // if(this.data.seriesLength==1){
    //     eProps.valuetext = this.data.prefix[this.groupindex][this.index] + this.data.values[this.groupindex][this.index]+ this.data.suffix[this.groupindex][this.index];
    // }
    const stackHeight = eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const numParentWidth = this.parent.getAttribute("data-width") / this.length;
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.justifyContent = "flex-end";
    element.style.width = this.data.chartName == "columnStackedRectangle" ? "100%" : 100 / this.length + "%";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? stackHeight * 100 + "%" : "100%";
    if (this.data.chartName == "columnStackedRectangle") element.style.display = "block";
    element.setAttribute("data-width", numParentWidth);
    this.parent.appendChild(element);
    if (this.data.data.getAttribute("data-barspace") == "Overlapping" && this.data.seriesItemLength > 1 && this.index > 0) {
        element.style.position = "relative";
        element.style.left = "-20px";
    }
    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(element, eProps);
    this.doAddBottomSeriesItemElement(element, eProps);
    if (this.data.chartName == "columnStackedRectangle") {
        this.valueOverlapping();
    }
};


function SimpleIconRepeatFillChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleIconRepeatFillChart";
    this.minSeriesSize = 300;
    this.maxGraphicSize = 1300;    
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleIconRepeatFillChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleIconRepeatFillChart.prototype.constructor = SimpleIconRepeatFillChart;

SimpleIconRepeatFillChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleIconRepeatFillSeries"](argparent, argprops);
}
SimpleIconRepeatFillChart.prototype.CreateHightlightDifference = function () {
    return null;
}
function SimpleIconRepeatFillSeries(argparent, argprops) {
    this.name = "SimpleColumnSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleIconRepeatFillSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleIconRepeatFillSeries.prototype.constructor = SimpleIconRepeatFillSeries;

SimpleIconRepeatFillSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleIconRepeatFillSeriesItem"](argparent, argprops);
};

SimpleIconRepeatFillSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.parent) this.parent.appendChild(element);
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    ///boolMax
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.valueStyle = this.ChartFonts.graphicColor(this.index);
        this.doAddValueElement(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
    subelement.style.width = this.gapPercentage * 100 + "%";
    subelement.style.order = 2;
    subelement.style.flex = "unset";
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};



function SimpleIconRepeatFillSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.labelMaxW = 230;
    this.graphicH = 0;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleIconRepeatFillSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleIconRepeatFillSeriesItem.prototype.constructor = SimpleIconRepeatFillSeriesItem;

SimpleIconRepeatFillSeriesItem.prototype.doAddTopGraphicsContainer = function(argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? this.labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex,this.ChartFonts.graphicBgColor(styleIndex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "secondary-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic transformOrginBottom";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);



    clsStyle =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true
            ? this.setNoEmphasis(graphicElement, clsStyle, groupindex)
            : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                ? this.setHasEmphasis(graphicElement, clsStyle, groupindex)
                : clsStyle;

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops);
            else this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if (
            (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") ||
            this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)
        ) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                        ? this.ChartFonts.graphicColor(styleIndex)
                        : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops);
            else this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops);
        }
    }
    this.createBgGraphicSVG(graphicElement, argprops, null, null, index);
    this.createGraphicSVG(graphicElement, argprops, null, null, index);
    let valueElement = this.parent.parentNode.querySelector(".value ");
    if(valueElement){
        let valueChildElement = valueElement.children[0];
        valueElement.style.alignItems ="flex-end";
        valueChildElement.style.maxHeight = valueElement.clientHeight+"px"
        this.ChartHelper.adjustFontSize(valueChildElement, 10, this.ChartFonts.maxLabelFontSize(valueChildElement) - 10, this.ChartFonts.maxLabelFontSize(valueChildElement));
    } 
}

SimpleIconRepeatFillSeriesItem.prototype.createGraphicSVG = function(argparent, argprops, width, height, index) {
    height = this.state.height * 0.26;
    width = argparent.clientWidth;

    let iconBgStyleFill = this.getBgFillDetails(index,this.data.ChartFonts.graphicFillColor(index),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicFillColor(index);
    let iconBgStyleStroke = this.ChartFonts.graphicStrokeColor(index);
    if (this.style.bgFillType == "gradient") {
        iconBgStyleFill = "";
    }

    let parentSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(parentSvg, {
        width: "100%",
        height: "100%",
        style: "position:absolute;"
    });
    argparent.appendChild(parentSvg)
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        class: iconBgStyleStroke + " "+iconBgStyleFill,
        width: "100%",
        height: "100%",
    });
    parentSvg.appendChild(baseSvg)
    if (this.style.bgFillType == "gradient") {
        this.addGradient(baseSvg, parentSvg, true, true)
    }
    argparent.style.display = "flex";
    argparent.style.justifyContent = "center";

    //dummey Element//
    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[index],
        "data-name": this.data.itemPlacehoders[index],
        "data-iconpath":this.data.itemPlacehodersPath[index],
        "opacity": 0
    });
    baseSvg.appendChild(dummySVGNode)

    //svg calculation
    let bounds = dummySVGNode.getBBox();
    baseSvg.removeChild(dummySVGNode)
    let intIconW = bounds.width; //parseInt(xmlData.getAttribute("viewBox").split(" ")[2]);
    let intIconH = bounds.height; //parseInt(xmlData.getAttribute("viewBox").split(" ")[3]);
    let numItemHPercentage = (height / intIconH) > (width / intIconW) ? (width / intIconW) : height / intIconH
    let maxCount = this.data.displayValueMaxCount;
    let offCount = 5
    let graphicCount = 6;
    let intPadding = 12;
    let intVpadding =12;
    let numValue = this.data.values[index][0]
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        numValue = numValue > 100 ? 100 : numValue;
        let remaingValue = numValue % 10;
        remaingValue = remaingValue == 0 ? 1 : remaingValue;
        let roundedValue = 0;
        let originalValue = 0;
        if (remaingValue >= 5) {
            let addinValue = 10 - remaingValue;
            originalValue = addinValue + parseInt(numValue)
        } else {
            originalValue = parseInt(numValue) != remaingValue ? parseInt(numValue) - remaingValue : remaingValue;
        }
        if (numValue <= maxCount) {
            numValue = this.data.values[index][0];
        } else {
            numValue = numValue < this.data.displayValueMaxCount ? this.data.values[index][0] : originalValue;
        }
    }
    let currentValue = parseInt(numValue) < 10 ? parseInt(numValue / 100) : parseInt(numValue)
    let splitValue = parseInt(numValue) < 10 ? currentValue : currentValue.toString().split("");
    graphicCount = (splitValue.length > 1) ? parseFloat(splitValue.join(".")) : currentValue;
    let multiplefactor = maxCount / 10;
    graphicCount = parseInt(numValue) != 0 && Math.round(graphicCount * multiplefactor) == 0 ? 1 : Math.round(graphicCount * multiplefactor);
    graphicCount = numValue >= 100 ? maxCount : graphicCount;
    graphicCount = this.data.values[index][0] <= maxCount ? this.data.values[index][0] : graphicCount;
    this.intIconFitH = parseInt(intIconH * numItemHPercentage);
    this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
    let iconCount = parseInt(width / this.intIconFitW);
    while (iconCount < offCount || this.intIconFitW > 114 || this.intIconFitH > 208) {
        numItemHPercentage = numItemHPercentage * 0.9
        this.intIconFitH = parseInt(intIconH * numItemHPercentage);
        this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
        iconCount = parseInt(width / this.intIconFitW);
    }
    this.intTotalIcons = iconCount != maxCount ? maxCount : iconCount;
    this.data.SVGUtils.assignAttributes(baseSvg, {
        height: this.intIconFitH
    });
    //

    //CreateMaskTag

    let defsTag1 = this.data.SVGUtils.createSVGElement("defs");
    parentSvg.appendChild(defsTag1)
    let maskTag1 = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(maskTag1, {
        "data-maskelement": "true",
        id: this.voData.slideID + "maskElemen1",
        fill: "white"
    });
    defsTag1.appendChild(maskTag1)
    let maskRect1 = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(maskRect1, {
        width: "100%",
        height: this.intIconFitH,
        class: "moodanimation transformOrginLeft",
        "data-customorgin": "left",
        "data-animation": "itemfill1"
    });
    maskTag1.appendChild(maskRect1)

    //create Masktag2
    let defsTag2 = this.data.SVGUtils.createSVGElement("defs");
    parentSvg.appendChild(defsTag2)
    let maskTag2 = this.data.SVGUtils.createSVGElement("mask");
    defsTag2.appendChild(maskTag2)
    this.data.SVGUtils.assignAttributes(maskTag2, {
        "data-maskelement": "true",
        id: this.voData.slideID + "maskElemen2",
        fill: "white"
    });
    let maskRect2 = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(maskRect2, {
        width: "100%",
        height: this.intIconFitH,
        class: "moodanimation transformOrginLeft",
        "data-customorgin": "left",
        "data-animation": "itemfill2"
    });
    maskTag2.appendChild(maskRect2)


    //Mask Rect Calculation 
    let graphicwidth = offCount * this.intIconFitW;
    this.data.SVGUtils.assignAttributes(maskRect1, {
        width: graphicwidth * (this.data.values[index][0] / 100),
    });
    let maskId = "maskElemen1";
    let Basesvg1 = "";
    let Basesvg2 = "";
    if (iconCount < maxCount && this.data.displayValueFormat == "percentage") {
        Basesvg1 = this.data.SVGUtils.createSVGElement("svg");
        Basesvg2 = this.data.SVGUtils.createSVGElement("svg");
        baseSvg.appendChild(Basesvg1)
        baseSvg.appendChild(Basesvg2)
    }
    for (let i2 = 0; i2 < this.intTotalIcons; i2++) {
        let iconX = this.intIconFitW * i2;
        let iconY = 0
        if (iconCount < maxCount) {
            this.data.SVGUtils.assignAttributes(baseSvg, {
                height: (2 * this.intIconFitH)+intVpadding,
                width: offCount * this.intIconFitW
            });
            this.data.SVGUtils.assignAttributes(parentSvg, {
                width: offCount * this.intIconFitW
            });
            graphicwidth = offCount * this.intIconFitW;
            this.data.SVGUtils.assignAttributes(maskRect1, {
                width: graphicwidth * (this.data.values[index][0] / 100),
            });

        } else {
            this.data.SVGUtils.assignAttributes(baseSvg, {
                width: maxCount * this.intIconFitW
            });
            this.data.SVGUtils.assignAttributes(parentSvg, {
                height: this.intIconFitH,
                width: maxCount * this.intIconFitW
            });
            graphicwidth = maxCount * this.intIconFitW;
            this.data.SVGUtils.assignAttributes(maskRect1, {
                width: graphicwidth * (this.data.values[index][0] / 100),
            });
        }
        // this.data.SVGUtils.assignAttributes(maskRect1, {
        //     width: (offCount * this.intIconFitW)*((this.data.values[index][0] / 100)),
        // });
        if (iconCount < maxCount && i2 > (offCount - 1)) {
            let indexValue = i2 - (offCount - 1);
            if (i2 == offCount) {
                iconX = 0;
            } else {
                iconX = this.intIconFitW * (indexValue - 1)
            }
            maskId = "maskElemen2"
            iconY = this.intIconFitH+intVpadding;


            if (this.data.values[index][0] < 50) {
                this.data.SVGUtils.assignAttributes(maskRect1, {
                    width: (offCount * this.intIconFitW) * ((this.data.values[index][0] / 50)),
                });
            } else {
                this.data.SVGUtils.assignAttributes(maskRect1, {
                    width: offCount * this.intIconFitW,
                });
                let calculatValue = this.data.values[index][0] - 50
                this.data.SVGUtils.assignAttributes(maskRect2, {
                    width: (offCount * this.intIconFitW) * ((calculatValue / 50)),
                    y: this.intIconFitH+intVpadding
                });
            }

        }
        let svgIcon = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgIcon, {
            id: "itemplaceholder-" + index + "_" + i2,
            x: iconX,
            y: iconY,
            width: this.intIconFitW,
            height: this.intIconFitH,
            "data-graphic-x": (iconX + (this.intIconFitW / 2)),
            "data-graphic-y": (iconY + (this.intIconFitH / 2)),
            class: "moodanimation",
            "data-animation": "item",
            "xlink:href": "#" + this.data.itemPlacehoders[index],
            "data-name": this.data.itemPlacehoders[index],
            "data-iconpath":this.data.itemPlacehodersPath[index],
            "data-type": "ICON",
            "data-customorgin": "null",
            "data-icongroup": this.voData.data.getAttribute("data-iconid")
        });


        if (iconCount < maxCount && this.data.displayValueFormat == "percentage") {
            if (maskId == "maskElemen1") {
                Basesvg1.appendChild(svgIcon)
                this.data.SVGUtils.assignAttributes(Basesvg1, {
                    "data-mask": "true",
                    mask: "url(#" + this.voData.slideID + maskId + ")"
                });
            } else {
                Basesvg2.appendChild(svgIcon)
                this.data.SVGUtils.assignAttributes(Basesvg2, {
                    "data-mask": "true",
                    mask: "url(#" + this.voData.slideID + maskId + ")"
                });
            }
        } else {
            if (this.data.displayValueFormat == "percentage") {
                this.data.SVGUtils.assignAttributes(baseSvg, {
                    "data-mask": "true",
                    mask: "url(#" + this.voData.slideID + maskId + ")"
                });
            }
            baseSvg.appendChild(svgIcon)
        }

        if (graphicCount <= i2 && (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction" || iconCount < maxCount)) {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "visibility": "hidden",
                "fill-opacity": 0,
                "stroke-opacity": 0
            });
            svgIcon.style.visibility ="hidden";
        }
        iconX = iconX + this.intIconFitW;
    }
}
SimpleIconRepeatFillSeriesItem.prototype.createBgGraphicSVG = function(argparent, argprops, width, height, index) {
    height = argparent.clientHeight != 0 ? argparent.clientHeight / 2 : this.state.height * 0.26;
    width = argparent.clientWidth;
    let intPadding = 12;
    let intVpadding =12;
    let iconBgStyleFill = this.getBgFillDetails(this.groupindex,this.ChartFonts.secondaryFill(),this.data.layout.backgroundColor,"bgcolor");
    // let iconBgStyleStroke = this.getBgFillDetails(groupindex,this.ChartFonts.secondaryFill(),this.data.layout.backgroundColor,"stroke");
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        class: iconBgStyleFill,
        width: "100%",
        height: "100%",
        "fill-opacity": this.data.layout.backgroundOpacity?this.data.layout.backgroundOpacity:"0.3",
        "stroke-opacity":  this.data.layout.backgroundOpacity?this.data.layout.backgroundOpacity:"0.3",
    });
    argparent.appendChild(baseSvg)
    argparent.style.display = "flex";
    argparent.style.justifyContent = "center";
    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[index],
        "data-name": this.data.itemPlacehoders[index],
        "data-iconpath":this.data.itemPlacehodersPath[index],
        "opacity": 0
    });
    baseSvg.appendChild(dummySVGNode)
    let bounds = dummySVGNode.getBBox();
    baseSvg.removeChild(dummySVGNode)
    let intIconW = bounds.width; //parseInt(xmlData.getAttribute("viewBox").split(" ")[2]);
    let intIconH = bounds.height; //parseInt(xmlData.getAttribute("viewBox").split(" ")[3]);
    let numItemHPercentage = (height / intIconH) > (width / intIconW) ? (width / intIconW) : height / intIconH
    let maxCount = this.data.displayValueMaxCount;
    let offCount = 5
    this.intIconFitH = parseInt(intIconH * numItemHPercentage);
    this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
    let iconCount = parseInt(width / this.intIconFitW);
    while (iconCount < offCount || this.intIconFitW > 114 || this.intIconFitH > 208) {
        numItemHPercentage = numItemHPercentage * 0.9
        this.intIconFitH = parseInt(intIconH * numItemHPercentage);
        this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
        iconCount = parseInt(width / this.intIconFitW);
    }
    this.intTotalIcons = iconCount != maxCount ? maxCount : iconCount;

    this.data.SVGUtils.assignAttributes(baseSvg, {
        height: this.intIconFitH
    });
    for (let i2 = 0; i2 < this.intTotalIcons; i2++) {

        let iconX = this.intIconFitW * i2;
        let iconY = 0
        if (iconCount < maxCount) {
            this.data.SVGUtils.assignAttributes(baseSvg, {
                height: (2 * this.intIconFitH)+intVpadding,
                width: offCount * this.intIconFitW
            });
        } else {
            this.data.SVGUtils.assignAttributes(baseSvg, {
                width: maxCount * this.intIconFitW
            });
        }
        if (iconCount < maxCount && i2 > (offCount - 1)) {
            let indexValue = i2 - (offCount - 1);
            if (i2 == offCount) {
                iconX = 0;
            } else {
                iconX = this.intIconFitW * (indexValue - 1)
            }

            iconY = this.intIconFitH+intVpadding;

        }
        let svgIcon = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgIcon, {
            id: "itemplaceholder-" + index + "_" + i2,
            x: iconX,
            y: iconY,
            width: this.intIconFitW,
            height: this.intIconFitH,
            class: "moodanimation",
            "xlink:href": "#" + this.data.itemPlacehoders[index],
            "data-name": this.data.itemPlacehoders[index],
            "data-iconpath":this.data.itemPlacehodersPath[index],
            "data-type": "ICON",
            "data-animation": "itembackground",
            "data-graphic-x": (iconX + (this.intIconFitW / 2)),
            "data-graphic-y": (iconY + (this.intIconFitH / 2)),
            "data-icongroup": this.voData.data.getAttribute("data-iconid"),
        });
        baseSvg.appendChild(svgIcon)
        iconX = iconX + this.intIconFitW;
    }
}


"use strict";
function SimpleIconFillBarChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleBarChart";
    BaseBarChart.call(this, argparent, argprops);
}
SimpleIconFillBarChart.prototype = Object.create(BaseBarChart.prototype);
SimpleIconFillBarChart.prototype.constructor = SimpleIconFillBarChart;

SimpleIconFillBarChart.prototype.seriesInstance = function(argparent, argprops) {
    return new window["SimpleIconFillBarSeries"](argparent, argprops);
}

function SimpleIconFillBarSeries(argparent, argprops){
    this.name = "SimpleIconFillBarSeries";
    BaseBarSeries.call(this, argparent, argprops);
}
SimpleIconFillBarSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleIconFillBarSeries.prototype.constructor = SimpleIconFillBarSeries;

SimpleIconFillBarSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new window["SimpleIconFillBarSeriesItem"](argparent, argprops);
}
function SimpleIconFillBarSeriesItem(argparent, argprops) {
    this.name = "SimpleIconFillBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.dummeyLabelMaxW = 230;
    this.dummeyValueMaxH = 0;
    this.iconWH = 30;
    this.graphicW;
    this.layoutWidth = 0;
    BaseBarSeriesItem.call(this, argparent, argprops);
}
SimpleIconFillBarSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
SimpleIconFillBarSeriesItem.prototype.constructor = SimpleIconFillBarSeriesItem;

SimpleIconFillBarSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    let _oWidth = 0;
    let _iWidth = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;

    // if (this.displayValue(argprops)) {
    //     if (this.valueAlignment.itemBased == "true") {
    //         this.valueStyle =
    //             this.data.hasEmphasis && this.data.emphasis[groupindex] != true
    //                 ? this.ChartFonts.valueOuterColor
    //                 : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
    //                 ? this.ChartFonts.graphicColor(groupindex)
    //                 : this.ChartFonts.valueOuterColor;
    //         const subValueElement = this.ChartHelper.createDivElement({});
    //         subValueElement.id = "topvalue-" + groupindex + "_" + index;
    //         subValueElement.className = "topvalue ";
    //         subValueElement.style.width = graphicWidthPercentage * 100 + "%";
    //         argparent.appendChild(subValueElement);
    //         this.doAddRightValue(subValueElement, argprops);
    //     }
    // }

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "chartgraphic basegraphic baserightgraphic";
    element.style.height = "100%"; //this.valueAlignment.itemBased == "true" ? this.state.height * 0.6 + "px" :
    element.style.width = "calc(100% - " + _oWidth + "px)";
    element.style.position = "relative";
    element.style.justifyContent = "center";
    if (this.data.chartName == "barSimpleIconFill") {
        element.style.justifyContent = "flex-start";
    }
    if ((index == 0 && this.data.chartName == "comparisonModelType2") || (this.data.chartName == "comparisonModelType3" && groupindex < this.data.seriesLength / 2)) element.style.flexDirection = "row-reverse";
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true") {
            if (this.labelAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }
        if (this.valueAlignment.itemBased == "true") {
            if (this.valueAlignment.vposition == "top") element.style.flexDirection = "column-reverse";
            else element.style.flexDirection = "column";
        }

        element.style.alignItems = "flex-start";
    }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.hposition == "right") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.hposition == "right") this.doAddRightValue(element, argprops, true);

    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.dummeyLabelMaxW * 0.5;
        this.middleLH = labelMaxH;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        this.middleVH = parseInt(this.state.height * (this.thicknessPercentage - 0.1));
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        this.middlePH = this.state.height * 0.7 > 100 ? 100 : this.state.height * 0.7;
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentWidth = argparent.getAttribute("data-width");
    const baseGraphicWidth = parentWidth - (this.maxLabelW + this.currentValW + parseInt(this.middleLW) + parseInt(this.middlePW) + parseInt(this.middleVW));
    const baseGraphicWidthPercentage = baseGraphicWidth / parentWidth;
    const graphicWidthPercentage = argprops.value / 100;

    let backgroundElement;
    if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") {
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + this.ChartFonts.emphasizeColor;
        backgroundElement.style.width = baseGraphicWidthPercentage * 100 + "%";
        backgroundElement.style.height = this.thicknessPercentage * 100 + "%";
        backgroundElement.dataset.animation = "itembackground";
        if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundElement.style.borderRadius = this.dummeyValueMaxH + "px";
        element.appendChild(backgroundElement);
    }

    //"graphicbg";
    //MASKeLEMENT
    let basemaskSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(basemaskSvg, {
        width: "100%",
        height: "100%",
    });
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    let maskTag = this.data.SVGUtils.createSVGElement("mask");
    this.maskIdValue = Math.random() + this.data.slideID + "maskElement" + groupindex;
    this.data.SVGUtils.assignAttributes(maskTag, {
        id: this.maskIdValue,
        "data-maskelement": "true",
    });
    defsTag.appendChild(maskTag);
    const subelement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(subelement, {
        width: graphicWidthPercentage * 100 + "%",
        height: 110 * this.thicknessPercentage + "%",
        id: "graphicconatiner-" + groupindex + "_" + index,
        class: "graphicconatiner ",
    });
    subelement.style.position = "absolute";
    subelement.style.left = "0";

    maskTag.appendChild(subelement);
    basemaskSvg.appendChild(defsTag);
    element.appendChild(basemaskSvg);

    if (this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") {
        if ((this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle")) {
            if (this.valueAlignment.hposition == "right" && this.valueAlignment.position == "middle") {
                middleelementValue.style.marginLeft = parseInt(subelement.clientWidth - this.middleVH * 0.5) + "px";
            } else if (this.placeholderAlignment.hposition == "right" && this.placeholderAlignment.position == "middle") {
                middleelementPlaceholder.style.marginLeft = parseInt(subelement.clientWidth - this.middlePH * 0.5) + "px";
            } else if (this.labelAlignment.hposition == "right" && this.labelAlignment.position == "middle") {
                middleelementLabel.style.marginLeft = parseInt(subelement.clientWidth - this.middleLH * 0.5) + "px";
            }
        }
        if ((this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") || (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") || (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle")) {
            //middleelement.style.marginTop = -parseInt(subelement.clientHeight - this.middleW * 0.5) + "px";
            if (this.valueAlignment.hposition == "left" && this.valueAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleVH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleVH * 0.5 + "px";
            } else if (this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.position == "middle") {
                subelement.style.marginLeft = this.middlePH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middlePH * 0.5 + "px";
            } else if (this.labelAlignment.hposition == "left" && this.labelAlignment.position == "middle") {
                subelement.style.marginLeft = this.middleLH * 0.5 + "px";
                if (backgroundElement) backgroundElement.style.marginLeft = this.middleLH * 0.5 + "px";
            }
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let strStyleClass = ""; //this.getBgColorDetails(styleIndex,this.ChartFonts.graphicBgColor(styleIndex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicBgColor(styleIndex);
    const clsStyle = strStyleClass + " moodanimation transformOrginLeft";
    const graphicElement = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(graphicElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: " moodanimation",
        fill: "white",
        "data-animation": "item",
        width: "100%",
        height: "100%",
    });
    graphicElement.dataset.customorgin = "left";
    subelement.appendChild(graphicElement);

    ///DropShadow
    let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
    let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
    graphicElement.style.boxShadow = "0 12px 20px 0 " + rgbaColor;

    if (this.displayPrimaryPlaceholder(argprops)) {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.placeholderAlignment.position == "outer" || this.graphicW < this.state.height * 0.6) {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddRightPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            subelement.style.display = "flex";
            subelement.style.justifyContent = "flex-end";
            this.doAddRightPlaceholder(subelement, argprops);
        }
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.data.layout.labelInterchange == "true") &&
        (this.data.layout.labelInterchange == "true" || this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner")
    ) {
        let vLayoutName = "";
        if (this.data.layout.labelInterchange != "true") {
            vLayoutName = this.labellayoutClassName("container");
        }
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "row";
        sameElement.style.position = "unset";
        sameElement.style.overflow = "unset";
        sameElement.style.minWidth = "13%";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.3 + "px" : "50%";
        element.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" || this.data.layout.labelInterchange == "true") {
            this.labelStyle = this.labelAlignment.itemBased == "true" ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelOuterColor;
            if (this.data.layout.labelInterchange == "true") {
                this.labelMaxW = this.state.width * 0.3;
                this.labelMaxH = (this.state.height / this.length) * 0.5;
            }

            this.doAddLabel(sameElement, argprops, true, "", false);
            this.doAddLabel(sameElement, argprops, "", "", false, true);
        }
        if (this.valueAlignment.samepos == "true" || this.data.layout.labelInterchange == "true") {
            this.valueStyle = this.valueAlignment.itemBased == "true" ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueOuterColor;
            if (this.data.layout.labelInterchange == "true") {
                this.valueMaxW = this.state.width * 0.3;
                this.valueMaxH = (this.state.height / this.length) * 0.5;
                sameElement.style.flexDirection = "column";
            }
            this.valueStyle = this.ChartFonts.graphicColor(groupindex);
            argprops.valuetext = parseFloat(this.data.values[groupindex][0]);
            this.deafaultPercentage = true;
            this.doAddRightValue(sameElement, argprops, true, "", false);
            this.doAddRightValue(sameElement, argprops, "", "", false);
            sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.3 + "px" : "50%";
            this.layoutWidth = this.maxLabelW > this.currentValW ? this.maxLabelW + 20 : this.currentValW + 20;
            sameElement.style.width = "auto";
        }
    }

    if (this.displayLabel(argprops) && this.labelAlignment.samepos != "true" && this.data.layout.labelInterchange != "true") {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true") {
            this.valueStyle = this.ChartFonts.graphicColor(groupindex);
            this.deafaultPercentage = true;
            this.doAddRightValue(element, argprops, true);
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = graphicElement.clientWidth - this.currentValW + "px";
            element.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops, "", "", false);
            this.dummeyValueMaxH = subelement.clientHeight;
        } else if (this.labelAlignment.position == "outer" || this.graphicW < this.dummeyLabelMaxW) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(element, argprops, "", "", false);
        } else {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops, "", "", false);
        }
    }

    if (this.displayValue(argprops) && this.valueAlignment.samepos != "true" && this.data.layout.labelInterchange != "true") {
        this.graphicW = Math.round(baseGraphicWidth * graphicWidthPercentage);
        this.doAddRightValue(element, argprops, true, "", false);
        if ((this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true") || this.graphicW < this.currentValW) {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(groupindex) : this.ChartFonts.valueOuterColor;
            this.valueStyle = this.ChartFonts.graphicColor(groupindex);
            this.deafaultPercentage = true;
            if (this.data.chartName == "barFillRectangle" || this.data.chartName == "barRoundedFill") this.doAddRightValue(argparent, argprops, "", "", false);
            else {
                if (this.labelAlignment.itemBased == "true") this.doAddRightValue(subelement, argprops, "", "", false);
                else this.doAddRightValue(element, argprops, "", "", false);
            }
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.itemBased != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            // subelement.style.display = "flex";
            if (index == 0 && this.data.chartName == "comparisonModelType2") subelement.style.justifyContent = "flex-start";
            this.valueStyle = this.ChartFonts.graphicColor(groupindex);
            // else subelement.style.justifyContent = "flex-end";
            this.doAddRightValue(valueElement, argprops, "", "", false);
        }
    }

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
    }
    this.createBgGraphicSVG(basemaskSvg, argprops, this.state.width * this.gapPercentage, null, groupindex);
    this.createGraphicSVG(basemaskSvg, argprops, this.state.width * this.gapPercentage, null, groupindex);
};

SimpleIconFillBarSeriesItem.prototype.doAddGraphicElement = function () {
    // let myIndex = this.data.chartName == "comparisonModelType3" ? this.valueIndex : this.groupindex;
    this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.valuesDenomination[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];

    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { y: 0, x: 0, height: this.state.height, width: this.state.width },
    };

    const stackWidth = eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.height = this.data.chartName == "barStackedRectangle" ? "100%" : 100 / this.length + "%";
    element.style.width = this.data.chartName == "barStackedRectangle" ? stackWidth * 100 + "%" : "100%";
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") {
        if (this.index == 0) element.style.paddingRight = "10px";
        else if (this.index == 1) element.style.paddingLeft = "10px";
    }
    if (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2) element.style.justifyContent = "flex-end";
    this.parent.appendChild(element);

    this.doAddLeftSeriesItemElement(element, eProps);
    this.doAddRightSeriesItemElement(element, eProps);
};

SimpleIconFillBarSeriesItem.prototype.doAddRightSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.width / argprops.totalvalue;
    let numRightWidth = argprops.maxvalue * numMultpleFactor;
    if (numRightWidth < 63 && argprops.minvalue < 0) {
        numRightWidth = 63;
    }

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem rightseriesitem";
    element.style.pointerEvents = "all";
    if (this.data.chartName == "comparisonModelType3") {
        element.style.width = "50%";
    } else element.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : (numRightWidth / this.state.width) * 100 + "%";
    element.setAttribute("data-width", numRightWidth);
    // if (this.valueAlignment.vposition == "top") {
    //     element.style.flexDirection = "column";
    //     element.style.justifyContent = "center";
    // }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            width: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholderpath: argprops.placeholderpath,
            placeholdertype: argprops.placeholdertype,
            viewport: { y: argprops.viewport.y, x: argprops.viewport.x, width: numRightWidth, height: argprops.viewport.height },
        };
        this.doAddRightGraphicsContainer(element, eprops);
    }
};

SimpleIconFillBarSeriesItem.prototype.createBgGraphicSVG = function (argparent, argprops, width, height, index) {
    //iconfillSvg
    let intPadding = 10;
    height = argparent.parentNode.clientHeight;
    width = argparent.parentNode.clientWidth - this.layoutWidth;
    if (this.valueAlignment.samepos != "true") {
        width = argparent.clientWidth;
        height = argparent.clientHeight;
    }
    this.iconWH = height;
    let rowCount = 1;
    let columnCount = parseInt(600 / this.iconWH);
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    let iconBgStyleFill = this.getBgFillDetails(index, this.data.ChartFonts.graphicFillColor(index), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(index);
    let iconBgStyleStroke = this.getBgFillDetails(index, this.ChartFonts.graphicStrokeColor(index), this.data.layout.backgroundColor, "stroke"); //this.ChartFonts.graphicFillColor(index);
    this.data.SVGUtils.assignAttributes(baseSvg, {
        width: "100%",
        height: this.iconWH,
        class: iconBgStyleStroke + " " + iconBgStyleFill,
        "data-useContainer": "true",
        "fill-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.3",
        "stroke-opacity": this.data.layout.backgroundOpacity ? this.data.layout.backgroundOpacity : "0.3",
    });
    argparent.appendChild(baseSvg);
    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[index],
        "data-iconpath": this.data.itemPlacehodersPath[index],
        "data-name": this.data.itemPlacehoders[index],
        opacity: 0,
    });
    baseSvg.appendChild(dummySVGNode);
    let bounds = dummySVGNode.getBBox();
    let intIconW = bounds.width; //parseInt(xmlData.getAttribute("viewBox").split(" ")[2]);
    let intIconH = bounds.height; //parseInt(xmlData.getAttribute("viewBox").split(" ")[3]);
    let numItemHPercentage = height / intIconH;
    this.intIconFitH = parseInt(intIconH * numItemHPercentage);
    this.intIconFitW = parseInt(intIconW * numItemHPercentage) + intPadding;
    this.intTotalIcons = parseInt(width / (intIconW + intPadding));
    let widthdiff = (width - this.intTotalIcons * this.intIconFitW) / this.intTotalIcons;

    baseSvg.removeChild(dummySVGNode);
    // argparent.setAttribute("width", width);

    let iconX = 0;
    for (let i2 = 0; i2 < this.intTotalIcons; i2++) {
        let iconX = (this.intIconFitW + widthdiff) * i2;
        let iconY = 0;
        let svgIcon = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgIcon, {
            id: "itemplaceholder-" + index,
            x: iconX,
            y: (height - this.intIconFitH) / 2,
            width: this.intIconFitW,
            height: this.intIconFitH,
            class: "moodanimation",
            "data-name": this.data.itemPlacehoders[index],
            "data-iconpath": this.data.itemPlacehodersPath[index],
            "data-animation": "itembackground" + (this.groupindex + 1),
            "xlink:href": "#" + this.data.itemPlacehoders[index],
            "data-icongroup": this.voData.data.getAttribute("data-iconid"),
            "data-type": "ICON",
            "data-graphic-x": iconX + this.iconWH / 2,
            "data-graphic-y": iconY + this.iconWH / 2,
        });
        baseSvg.appendChild(svgIcon);
        iconX = iconX + this.intIconFitW;
    }
    width = width < baseSvg.getBBox().width ? baseSvg.getBBox().width : width;
    argparent.setAttribute("width", width + 5);
};

SimpleIconFillBarSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index) {
    //iconfillSvg
    height = argparent.parentNode.clientHeight;
    width = argparent.parentNode.clientWidth - this.layoutWidth;
    if (this.valueAlignment.samepos != "true") {
        width = argparent.clientWidth;
        height = argparent.clientHeight;
    }
    let rowCount = 1;

    let iconBgStyleFill = this.getBgFillDetails(index, this.data.ChartFonts.graphicFillColor(index), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(index);
    let iconBgStyleStroke = this.ChartFonts.graphicStrokeColor(index);
    let widthdiff = (width - this.intTotalIcons * this.intIconFitW) / this.intTotalIcons;

    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        width: "100%",
        height: "100%",
        "data-useContainer": "true",
        class: iconBgStyleStroke + " " + iconBgStyleFill,
        "data-mask": "true",
        mask: "url(#" + this.maskIdValue + ")",
    });
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(baseSvg, baseSvg);
        this.addGradient(baseSvg, baseSvg, false, true);
    }
    argparent.appendChild(baseSvg);
    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[index],
        "data-name": this.data.itemPlacehoders[index],
        "data-iconpath": this.data.itemPlacehodersPath[index],
        opacity: 0,
    });
    baseSvg.appendChild(dummySVGNode);
    let bounds = dummySVGNode.getBBox();
    baseSvg.removeChild(dummySVGNode);
    this.iconWH = bounds.height;
    let iconX = 0;
    for (let i2 = 0; i2 < this.intTotalIcons; i2++) {
        let iconX = (this.intIconFitW + widthdiff) * i2;
        let iconY = 0;
        let svgIcon = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgIcon, {
            id: "itemplaceholder-" + index,
            x: iconX,
            y: (height - this.intIconFitH) / 2,
            width: this.intIconFitW,
            height: this.intIconFitH,
            "data-name": this.data.itemPlacehoders[index],
            "data-iconpath": this.data.itemPlacehodersPath[index],
            "xlink:href": "#" + this.data.itemPlacehoders[index],
            "data-icongroup": this.voData.data.getAttribute("data-iconid"),
            "data-type": "ICON",
            "data-graphic-x": iconX + this.iconWH / 2,
            "data-graphic-y": iconY + this.iconWH / 2,
        });
        baseSvg.appendChild(svgIcon);
        iconX = iconX + this.intIconFitW;
    }
    width = width < baseSvg.getBBox().width ? baseSvg.getBBox().width : width;
    argparent.setAttribute("width", width);
    argparent.setAttribute("height", height);
};
SimpleIconFillBarSeriesItem.prototype.doAddRightValue = function (argparent, argprops, boolmax = false, boolOrder = false, overlapValue = true, graphiccustomW) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let valIndex = this.data.chartName == "comparisonModelType3" ? (groupindex < this.voData.seriesLength / 2 ? 0 : 1) : index;
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;

    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valueAlignment.itemBased == "true" ? this.valuelayoutClassName("itemlabel") : this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + valGroupIndex + "_" + valIndex;
    element.style.minWidth = 20 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.className = "value " + vLayoutName;
    element.style.order = boolOrder ? "1" : this.valueAlignment.index;
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) element.classList.add(this.data.layout.valuePaddingClass);
    if (this.valueAlignment.textbgitem == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        element.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
    }
    if (this.valueAlignment.hposition == "right") {
        element.classList.add("minlabelsize");
    }
    if (this.valueAlignment.hposition == "right" && this.valueAlignment.samepos == "true") {
        element.style.justifyContent = "flex-Start";
    }
    if (this.valueBackground) {
        element.className = "value " + vLayoutName + " " + this.ChartFonts.graphicColor;
        element.style.left = "20px";
    }
    if (this.valueAlignment.hposition == "left") element.style.textAlign = "start";

    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    subelement.id = "valuetext-" + valGroupIndex + "_" + valIndex;
    subelement.innerText = boolmax ? this.data.longValue : this.data.prefix[this.groupindex][this.index] + argprops.valuetext + this.data.suffix[this.groupindex][this.index];
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[valGroupIndex + " " + valIndex];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + valIndex);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-graphic-x", graphicW);
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, valGroupIndex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (graphiccustomW) {
        subelement.setAttribute("data-graphic-x", graphiccustomW);
    }
    if (this.data.chartName == "barStackedRectangle") {
        subelement.dataset.animation = "secondarytext" + (valIndex + 1);
        subelement.dataset.stackedmultiseries = "true";
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(valGroupIndex));
    }
    if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.remove(this.ChartFonts.appendgraphicColor(valGroupIndex));
        subelement.classList.add("clsTextTertiaryColor");
    }
    element.appendChild(subelement);
    if (this.data.arrHyperlinkUrl.length >= valGroupIndex) {
        element.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[valGroupIndex]);
    }
    if (this.deafaultPercentage) {
        if (this.data.displayValueFormat == "number") {
            // if(this.data.suffix[this.groupindex][this.index]==""){
            //     subelement.innerText = this.data.values[groupindex][index];
            // }
        } else {
            if (this.data.suffix[this.groupindex][this.index] == "") {
                subelement.innerText = this.data.prefix[this.groupindex][this.index] + parseFloat(argprops.valuetext) + "%";
                subelement.dataset.defalutPercentage = "true";
            }
        }
    }
    if (this.valueAlignment.textbg == "true" && this.valueAlignment.textbgitem != "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            // if (this.valueAlignment.hposition == "right") {
            //     element.style.paddingTop = this.data.layout.valuePaddingtop + 15 + "px";
            //     element.style.paddingBottom = "15px";
            // } else if (this.valueAlignment.hposition == "left") {
            //     element.style.paddingTop = "15px";
            //     element.style.paddingBottom = this.data.layout.valuePaddingbottom + 15 + "px";
            // }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);

    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";

    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this], "important");
    }

    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 20, 25, this.maxValueFontSize[this.arrIndex] - 1);
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, 25, this.maxValueFontSize[this.arrIndex] - 1);
    // ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.currentValW = element.clientWidth;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        element.remove();
        if (parseFloat(fontsize) <= 25) {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid) {
                this.removeGrid();
            }
        }
    } else {
        fontsize = window.getComputedStyle(subelement)["font-size"];
        if (overlapgrid && overlapValue) {
            element.style.display = "none";
        } else {
            element.style.overflow = "hidden";
        }
    }
};

function SimpleAssetFillChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleAssetFillChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleAssetFillChart.prototype.constructor = SimpleAssetFillChart;

SimpleAssetFillChart.prototype.seriesInstance = function(argparent, argprops) {
    return new window["SimpleAssetFillSeries"](argparent, argprops);
}
function SimpleAssetFillSeries(argparent, argprops) {
    this.name = "SimpleAssetFillSeries";
    this.gapPercentage = 1
    BaseColumnSeries.call(this, argparent, argprops);
    this.gapPercentage = 1
}
SimpleAssetFillSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleAssetFillSeries.prototype.constructor = SimpleAssetFillSeries;

SimpleAssetFillSeries.prototype.seriesItemInstance = function(argparent, argprops) {
    return new window["SimpleAssetFillSeriesItem"](argparent, argprops);
}
SimpleAssetFillSeries.prototype.doAddLabel =function(argparent, argprops, boolMax = false) {
    return null;
  }


function SimpleAssetFillSeriesItem(argparent, argprops) {
    this.name = "SimpleAssetFillSeriesItem";
    this.groupindex = argprops.groupindex;
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.graphicH = 0;
    this.middleelementValue;
    this.middleelementLabel;
    this.middleelementPlaceholder;
    BaseColumnSeriesItem.call(this, argparent, argprops);

}
SimpleAssetFillSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleAssetFillSeriesItem.prototype.constructor = SimpleAssetFillSeriesItem;

SimpleAssetFillSeriesItem.prototype.doAddGraphicElement = function () {
    // this.data.valuesDenomination[this.index][0] = parseFloat(this.data.valuesDenomination[this.index][0]) > 100 ? 100 : this.data.valuesDenomination[this.index][0];
    // this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    // this.data.rangePositive = this.data.rangePositive>100?100:this.data.rangePositive;
    if(this.data.boolPercentageChart)
    {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index])
    }    
   if ((this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction")) {
        let remaingValue = this.data.values[this.groupindex][this.index] % 10;
        let maxCount = this.data.displayValueMaxCount;

        let roundedValue = 0;
        let originalValue = 0;
        if (remaingValue >= 5) {
            let addinValue = 10 - remaingValue;
            originalValue = addinValue + parseInt(this.data.values[this.groupindex][this.index])
        } else {
            originalValue = parseInt(this.data.values[this.groupindex][this.index]) - remaingValue;
        }
        this.data.valuesDenomination[this.index][0] = originalValue;
        let splitValue = (this.data.values[this.groupindex][this.index]).toString().split("");
        let multiplefactor = maxCount / 10;
        let graphicCount = (splitValue.length > 1) ? parseFloat(splitValue.join(".")) : this.data.values[this.index][0];
        graphicCount = Math.round(graphicCount * multiplefactor)
        graphicCount = this.data.values[this.index][0] == 100 ? maxCount : graphicCount
        this.data.valuesDenomination[this.index][0] = graphicCount;
    }
    if (this.data.displayValueFormat == "outof") {
        this.data._valuesDenomination[this.groupindex][this.index] = this.data._valuesDenomination[this.groupindex][this.index] + " out of " + this.data.displayValueMaxCount
    }
    if (this.data.displayValueFormat == "fraction") {
        this.data.valuesDenomination[this.index][0] = this.data.valuesDenomination[this.index][0] + "/" + this.data.displayValueMaxCount;
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const stackHeight = eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const numParentWidth = this.parent.getAttribute("data-width") / this.length;
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    element.style.width = this.data.chartName == "columnStackedRectangle" ? "100%" : 100 / this.length + "%";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? stackHeight * 100 + "%" : "100%";
    if (this.data.chartName == "columnStackedRectangle") element.style.display = "block";
    element.setAttribute("data-width", numParentWidth);
    this.parent.appendChild(element);
    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(element, eProps);
    this.doAddBottomSeriesItemElement(element, eProps);
    if (this.data.chartName == "columnStackedRectangle") {
        this.valueOverlapping()
    }
}
SimpleAssetFillSeriesItem.prototype.doAddTopSeriesItemElement = function(argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = (argprops.minvalue < 0) ? -(argprops.minvalue) + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height /  argprops.maxvalue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = (this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle")) ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight
    }


    let minGraphicHeight = (numTopHeight / this.state.height) * 100
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : minGraphicHeight + "%";
    element.style.display = "flex";
    element.style.alignItems = "center";
    element.style.justifyContent = "center";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
}

SimpleAssetFillSeriesItem.prototype.doAddTopGraphicsContainer = function(argparent, argprops, centerAlign = false) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        this.middleelementLabel = this.ChartHelper.createDivElement({});
        this.middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementLabel.className = "middleelement  moodanimation";
        this.middleelementLabel.dataset.animation = "columncirclearrow";
        this.middleelementLabel.style.width = this.middleLW + "px";
        this.middleelementLabel.style.height = this.middleLH + "px";
        this.middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementLabel);
        if (this.labelAlignment.position == "middle") this.middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(this.middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        this.middleelementValue = this.ChartHelper.createDivElement({});
        this.middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementValue.className = "middleelement  moodanimation";
        this.middleelementValue.dataset.animation = "columncirclearrow";
        this.middleelementValue.style.width = this.middleVW + "px";
        this.middleelementValue.style.height = this.middleVH + "px";
        this.middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementValue);
        this.createSVGElement(this.middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        this.middleelementPlaceholder = this.ChartHelper.createDivElement({});
        this.middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementPlaceholder.className = "middleelement  moodanimation";
        this.middleelementPlaceholder.dataset.animation = "columncirclearrow";
        this.middleelementPlaceholder.style.width = this.middlePW + "px";
        this.middleelementPlaceholder.style.height = this.middlePH + "px";
        this.middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementPlaceholder);
        this.createSVGElement(this.middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6))
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex,this.ChartFonts.graphicBgColor(styleIndex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicBgColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic  transformOrginBottom";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "center";
    graphicElement.style.flexDirection = "column";
    graphicElement.style.justifyContant = "center";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    // if (this.style.bgFillType == "gradient") {
    //     graphicElement.style.backgroundImage = this.data.layout.itemGradientValues?this.data.layout.itemGradientValues:"";
    // }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

        if (booloverLap) {
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.appendChild(subelement)
            overlapParentDiv.appendChild(sameElement)
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%"
            })
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

        } else {
            subelement.appendChild(sameElement)
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }



    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv)
                subelement.parentNode.appendChild(label[0])
                overlapParentDiv.appendChild(subelement)
                overlapParentDiv.appendChild(valueElement)
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%"
                })
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%"
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                        ? this.ChartFonts.graphicColor(styleIndex)
                        : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") {
                (this.valueAlignment.position == "inner") ? this.doAddTopValue(element, argprops) : this.doAddTopValue(argparent, argprops);
            }
            else this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.valueMaxH) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.valueMaxH)) {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops);
        }
    }
    this.middleElementvalidation(element, subelement, this.middleelementValue, this.middleelementPlaceholder, this.middleelementLabel);
    this.createAssetOrder(graphicElement, argprops);
    subelement.style.height = "auto";
    element.style.height = "auto"

};
SimpleAssetFillSeriesItem.prototype.displayLabel = function(argprops) {
    return this.labelAlignment && this.labelAlignment.position != "middle" ? this.labelAlignment.show : false;
}
SimpleAssetFillSeriesItem.prototype.createAssetOrder = function(parent, argprops) {
    let FirstRowSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(FirstRowSvg, {
        width: "100%",
        height: (parent.clientHeight / 2)
    })
    parent.appendChild(FirstRowSvg)
    let firstDefsTag = this.data.SVGUtils.createSVGElement("defs");
    FirstRowSvg.appendChild(firstDefsTag);
    let maskidValue = Math.random() + this.data.slideID + this.groupindex + "first"
    let firstMaskTag = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(firstMaskTag, {
        id: maskidValue,
        "fill": "white",
        "data-maskelement": "true",
    });
    firstDefsTag.appendChild(firstMaskTag)
    let FirstRowRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(FirstRowRect, {
        width: "100%",
        height: "100%",
        class: "moodanimation transformOrginLeft",
        "data-customorgin": "left",
        "data-animation": "item1"
    })
    firstMaskTag.appendChild(FirstRowRect);
    this.createBgElements(FirstRowSvg, parent, argprops, true)
    this.createBgElements(FirstRowSvg, parent, argprops, false, maskidValue)

    let SecondRowSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(SecondRowSvg, {
        width: "100%",
        height: (parent.clientHeight / 2) + (parent.clientHeight / 2) * 0.2
    })
    parent.appendChild(SecondRowSvg);
    let secondDefsTag = this.data.SVGUtils.createSVGElement("defs");
    SecondRowSvg.appendChild(secondDefsTag);
    let secondMaskTag = this.data.SVGUtils.createSVGElement("mask");
    let maskValueID = Math.random() + this.data.slideID + this.groupindex + "second"
    this.data.SVGUtils.assignAttributes(secondMaskTag, {
        id: maskValueID,
        "data-maskelement": "true",
        "fill": "white"
    });
    secondDefsTag.appendChild(secondMaskTag)
    let secondRowRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(secondRowRect, {
        width: "10%",
        height: "100%",
        class: "moodanimation transformOrginLeft",
        "data-customorgin": "left",
        "data-animation": "item2"
    })

    secondMaskTag.appendChild(secondRowRect);
    this.createBgElements(SecondRowSvg, parent, argprops, true)
    this.createBgElements(SecondRowSvg, parent, argprops, false, maskValueID)
    parent.style.height = (parseFloat(SecondRowSvg.getAttribute("height")) + parseFloat(SecondRowSvg.getAttribute("height"))) + "px"
    parent.parentNode.height = (parseFloat(SecondRowSvg.getAttribute("height")) + parseFloat(SecondRowSvg.getAttribute("height"))) + "px"
    let basewidth = SecondRowSvg.getBBox().width;
    let multipleFactor = basewidth / 50;
    let firstWidth = 0;
    let secondWidth = 0;
    if (this.data.values[this.groupindex][0] <= 50) {
        firstWidth = multipleFactor * this.data.values[this.groupindex][0];
        secondWidth = 0;
    } else {
        firstWidth = basewidth;
        let secondValue = this.data.values[this.groupindex][0] - 50;
        secondWidth = secondValue * multipleFactor;
    }

    if(firstWidth==0){
        this.data.SVGUtils.assignAttributes(FirstRowRect, {
            width: "0%"
        })
    }else{
        this.data.SVGUtils.assignAttributes(FirstRowRect, {
            width: firstWidth
        })
    }
    if(secondWidth==0){
        this.data.SVGUtils.assignAttributes(secondRowRect, {
            width: "0%"
        })
    }else{
        this.data.SVGUtils.assignAttributes(secondRowRect, {
            width: secondWidth
        })
    }


}
SimpleAssetFillSeriesItem.prototype.createBgElements = function(parent, grandParent, argprops, bgelement = false, maskId = null) {
    let svgAsset
    this.asset = this.data.asset.data[0].data;
    if (!this.asset) {
        if(this.data.slideObj.querySelector("#series-" + this.groupindex)){
            svgAsset = this.data.slideObj.querySelector("#series-" + this.groupindex).querySelector("#container").children[0].children[0].children[0].cloneNode("true")
        }else{
            svgAsset = this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0].cloneNode("true")
        }
        svgAsset.removeAttribute("width")
        svgAsset.removeAttribute("height")
    } else {
        svgAsset = this.asset.cloneNode(true);
    }
    if(svgAsset.getAttribute("viewBox")){
        svgAsset.setAttribute("viewBoxDefault",svgAsset.getAttribute("viewBox"));
        svgAsset.removeAttribute("viewBox")
    }
    let arrViewBox = svgAsset.getAttribute("viewBoxDefault")?svgAsset.getAttribute("viewBoxDefault").split(" "):svgAsset.getAttribute("viewboxdefault")?svgAsset.getAttribute("viewboxdefault").split(" "):svgAsset.getAttribute("viewBox")?svgAsset.getAttribute("viewBox").split(" "):"0 0 400 400";
    let maxWidth = (grandParent.clientWidth / 5) - 10
    let numProportionateScale = (grandParent.clientHeight / arrViewBox[3]) < (maxWidth / arrViewBox[2]) ? grandParent.clientHeight / arrViewBox[3] : maxWidth / arrViewBox[2];
    let SecondRowBgSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(SecondRowBgSvg, {
        id: "container",
        width: "100%",
        height: "100%",
        class: this.getBgFillDetails(this.groupindex,this.ChartFonts.graphicStrokeColor(this.groupindex),this.data.layout.itemColor,"stroke")+" "+this.getBgFillDetails(this.groupindex,this.ChartFonts.graphicFillColor(this.groupindex),this.data.layout.itemColor,"bgcolor")// this.ChartFonts.graphicFillColor(this.groupindex)
    })

    if (bgelement) {
        this.data.SVGUtils.assignAttributes(SecondRowBgSvg, {
            class: this.getBgFillDetails(this.groupindex,this.ChartFonts.graphicStrokeColor(this.groupindex),this.data.layout.itemColor,"stroke"),//this.ChartFonts.graphicStrokeColor(this.groupindex)
        });
        if (this.data.layout.itemColor == "gradient") {
            SecondRowBgSvg.setAttribute("fill","")
            this.addGradient(SecondRowBgSvg, SecondRowBgSvg,false,true)
        }
    }else{
        if (this.data.layout.itemColor == "gradient") {
            this.addGradient(SecondRowBgSvg, SecondRowBgSvg)
            this.addGradient(SecondRowBgSvg, SecondRowBgSvg,false,true)
        }
    }
    if (maskId) {
        this.data.SVGUtils.assignAttributes(SecondRowBgSvg, {
            "data-mask": "true",
            mask: "url(#" + maskId + ")"
        })
    }
    parent.appendChild(SecondRowBgSvg)
    if (!bgelement) {
        this.data.SVGUtils.assignAttributes(SecondRowBgSvg, {
            "style": "position:absolute;"
        })
    }
    let assetHeight = 0
    let containerWidth = 0;
    for (let i1 = 0; i1 < 5; i1++) {
        let baseGroup = this.data.SVGUtils.createSVGElement("g");
        SecondRowBgSvg.appendChild(baseGroup)
        let scaleGroup = this.data.SVGUtils.createSVGElement("g");
        let percentageDiff = maxWidth + 10 * i1;
        this.data.SVGUtils.assignAttributes(baseGroup, {
            style: "transform :translateX(" + parseFloat(percentageDiff) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",
        });

        baseGroup.appendChild(scaleGroup)
        let copySvg = svgAsset.cloneNode(true)
        scaleGroup.appendChild(copySvg)
        percentageDiff = (((scaleGroup.children[0].getBBox().width * numProportionateScale) + 10) * i1);
        this.data.SVGUtils.assignAttributes(baseGroup, {
            style: "transform :translateX(" + parseFloat(percentageDiff) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",
        });
        if (i1 == 0) {
            assetHeight = numProportionateScale > 1 ? baseGroup.children[0].getBBox().height * numProportionateScale : baseGroup.children[0].getBBox().height;
            parent.setAttribute("height", assetHeight)
        }

        this.data.SVGUtils.assignAttributes(baseGroup, {
            style: "transform :translateX(" + parseFloat(percentageDiff) + "px) scale(" + numProportionateScale + "," + numProportionateScale + ")",
        });
        if (bgelement) {
            this.data.SVGUtils.assignAttributes(scaleGroup, {
                class: "moodanimation",
                "data-animation": "itembackground",
                "data-graphic-x": parseFloat(percentageDiff),
                "data-graphic-y": 0
            });
        }
    }
    containerWidth = SecondRowBgSvg.getBBox().width
}


function SimpleScaleIconCompareChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleScaleIconCompareChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleScaleIconCompareChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleScaleIconCompareChart.prototype.constructor = SimpleScaleIconCompareChart;

SimpleScaleIconCompareChart.prototype.seriesInstance=function(argparent, argprops) {
    return new window["SimpleScaleIconCompareSeries"](argparent, argprops);
}
SimpleScaleIconCompareChart.prototype.CreateHightlightDifference = function () {
    return null;
}

function SimpleScaleIconCompareSeries(argparent, argprops) {
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleScaleIconCompareSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleScaleIconCompareSeries.prototype.constructor = SimpleScaleIconCompareSeries;

SimpleScaleIconCompareSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    // element.dataset.animation = "nodeitem"
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    this.parent.style.justifyContent = "center";
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops, true);
    }
    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond fillLevelFinder" + " item" + this.graphicElement.hposition;
    subelement.style.width = this.gapPercentage * 100 + "%";
    subelement.style.position = "relative";
    subelement.style.alignItems = "center";
    if (this.data.layout.labelItemBased != "true") {
        subelement.style.justifyContent = "center";
    } else {
        subelement.style.justifyContent = "unset";
    }
    subelement.style.order = 2;
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && this.index == 0) subelement.classList.add("alterstyle");

    for (let i1 = 0; i1 < 1; i1++) {
        // if(this.index==0){
        //     subelement.classList.add("flexdirrevers")
        // }else{
        //     subelement.classList.add("flexdirforward")
        // }
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
        if (this.items[i1]) {
            let graphicWidth = this.items[i1].parent.dataset.dummeygraphicWidth;
            let layoutWidth = this.items[i1].parent.dataset.dummeyWidth;
            if (graphicWidth && layoutWidth) {
                let seriesWidth = parseFloat(graphicWidth) + parseFloat(layoutWidth);
                let remainingwidth = this.state.width * (1 - this.gapPercentage);
                element.style.width = seriesWidth + remainingwidth + "px";
                element.style.maxWidth = this.state.width + "px";
            }
        }
    }
};

SimpleScaleIconCompareSeries.prototype.updateBasicData = function () {
    BaseColumnSeries.prototype.updateBasicData.call(this);
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.7;
};

SimpleScaleIconCompareSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleScaleIconCompareSeriesItem"](argparent, argprops);
};

function SimpleScaleIconCompareSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.labelMaxW = 230;
    this.valueMaxW = 0;
    this.valueMaxH = 0;
    this.width = 0;
    this.labeMaxH = 90;
    this.graphicH = 0;
    this.minValueFontSize = [25,25]
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleScaleIconCompareSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleScaleIconCompareSeriesItem.prototype.constructor = SimpleScaleIconCompareSeriesItem;


SimpleScaleIconCompareSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if(categoryFontDetails)
    {
        this.maxValueFontSize = [categoryFontDetails.maxSize,categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize,categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [100, 100];
    if(this.data.customValueFontSize){
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if(this.minValueFontSize[0]>this.data.customValueFontSize)this.minValueFontSize = [this.data.customValueFontSize,this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] :this.maxLabelFontSize;
    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        this.labelMaxW = (this.state.width * this.gapPercentage) * 0.4;
        this.labeMaxH = this.state.height * 0.5 - 8;
    } else {
        this.labelMaxW = (this.state.width * this.gapPercentage) * 0.4;
        this.labeMaxH = this.state.height * 0.5 - 8;
    }
    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex.toString(),
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        this.valueMaxW = (this.state.width * this.gapPercentage) * 0.4;
        this.valueMaxH = this.state.height * 0.3;
    } else {
        this.valueMaxW = (this.state.width * this.gapPercentage) * 0.4;
        this.valueMaxH = this.state.height * 0.3;
    }
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: (this.data.layout.placeholderPosIndex).toString(),
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased == "true") this.valueMaxW = (this.state.width * this.gapPercentage) * 0.4;
        if (this.valueAlignment.itemBased == "true") this.labelMaxW = (this.state.width * this.gapPercentage) * 0.4;
    }
}

SimpleScaleIconCompareSeriesItem.prototype.doAddGraphicElement = function () {
    this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.valuesDenomination[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + parseFloat(this.data.values[this.groupindex][this.index]) + "%",
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
}


SimpleScaleIconCompareSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");


    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };



        let layoutContainer =this.ChartHelper.createDivElement({});
        layoutContainer.className = "layoutContainer";
        layoutContainer.style.width = "40%";
        layoutContainer.style.height = "30%";
        layoutContainer.style.position = "relative"

        if (this.data.voLayout.valuetextbgstyle) {
            layoutContainer.classList.add(this.data.voLayout.valuetextbgstyle);
        }
        if (this.data.layout.labelItemBased == "true") {
            argparent.appendChild(layoutContainer)
        }
        this.doAddTopGraphicsContainer(argparent, eprops, layoutContainer);
        layoutContainer.style.maxWidth = ((this.state.width * this.gapPercentage) - (2 * this.circleRadius)) + "px";

        layoutContainer.style.width = "";

        if (this.data.layout.labelItemBased == "true") {
            argparent.appendChild(layoutContainer)
            if (this.data.layout.valueInset != "inside") {
                this.doAddTopValue(layoutContainer, eprops);
            }
            this.doAddLabel(layoutContainer, eprops);
        }
        if (this.data.layout.haddivider) {
            let side = groupindex == "0" ? "left" : "right";
            if (this.voData.voLayout.valuetextbgcallout == "true") {
                this.cretaeSvgCallout(layoutContainer, side);
                layoutContainer.style.alignItem = "center";
            } else {
                let valueContainer = layoutContainer.querySelector(".value");
                let labelContainer = layoutContainer.querySelector(".label");
                let levelFinder = argparent.querySelector("#levelfinder");
                let levelFinderTop = levelFinder ? parseFloat(window.getComputedStyle(levelFinder)["top"]) : 0;
                let labelHeight = parseFloat(labelContainer.clientHeight);
                valueContainer.style.maxHeight = valueHeight + "px"
                layoutContainer.style.height = "auto";
                let valueHeight = parseFloat(valueContainer.clientHeight);
                let labelPosition = 0;
                if (this.voData.voLayout.dividerType == "type1") {
                    layoutContainer.style.top = (levelFinderTop - valueHeight) + "px";
                } else {
                    layoutContainer.style.top = (levelFinderTop - (valueHeight / 2)) + "px";
                }
                if (this.data.values[this.groupindex][this.index] > 50) {
                    let topGap = levelFinderTop
                    if (topGap < valueHeight + 5) {
                        layoutContainer.style.top = (levelFinderTop + 5) + "px";
                    }
                } else {
                    if (this.data.values[this.groupindex][this.index] < 50) {
                        let BottomGap = (this.state.height - levelFinderTop)
                        if (BottomGap < labelHeight + 5 || BottomGap < valueHeight + 5) {
                            layoutContainer.style.top = (levelFinderTop - valueHeight - labelHeight) + "px";
                        }
                    }
                }
                layoutContainer.style.position = "absolute";
                (this.graphicElement.alterpos == "true" && this.groupindex == 0) ? layoutContainer.classList.add("alterstylepos") : layoutContainer.classList.add("alterstylenoraml")
            }
        } else {
            layoutContainer.style.height = "100%";
            const vLayoutName = this.labellayoutClassName("container");
            layoutContainer.classList.add(vLayoutName);
            layoutContainer.style.flexWrap = "unset";
            layoutContainer.style.flexDirection = "column";;
            argparent.dataset.dummeyWidth = layoutContainer.clientWidth;
        }
    }
}

SimpleScaleIconCompareSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, layoutContainer) {
    let divider = this.data.layout.haddivider;

    const parentWidth = argparent.getAttribute("data-width");
    const parentHeight = argparent.getAttribute("data-height");

    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    let graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    let element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + argprops.gindex + "_" + argprops.index,
        element.className = "chartgraphic basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.pointerEvents = "all";
    argparent.appendChild(element)
    this.width = element.clientWidth;

    //create base svg//
    let numMultpleFactor = this.width / 100;
    this.circleRadius = (numMultpleFactor * this.data.values[argprops.gindex][argprops.index]) / 2
    element.style.height = (2 * this.circleRadius) + "px";
    let classStyle = this.data.ChartFonts.graphicFillColor(argprops.gindex) + this.data.ChartFonts.graphicStrokeColor(argprops.gindex)
    let parentSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(parentSvg, {
        "data-icongroup": this.voData.data.getAttribute("data-iconid"),
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    if (true) {
        let circle = this.data.SVGUtils.createSVGElement("circle");
        this.data.SVGUtils.assignAttributes(circle, {
            class: classStyle + " moodanimation transformOrginCenter",
            cx: "50%",
            cy: "50%",
            r: this.circleRadius,
            "data-animation": "item"
        });
        parentSvg.appendChild(circle);
    } else {
        let square = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(square, {
            class: classStyle + " moodanimation transformOrginCenter",
            x: "0%",
            y: "0%",
            width: 2 * this.circleRadius,
            height: 2 * this.circleRadius,
            "data-animation": "item"
        });
        parentSvg.appendChild(square);
        element.style.height = (2 * this.circleRadius) + "px";
    }
    element.style.width = (2 * this.circleRadius) + "px";
    this.labelMaxW = ((this.state.width * this.gapPercentage) - (2 * this.circleRadius)) + "px"
    element.appendChild(parentSvg);

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = this.circleRadius;
        this.doAddTopValue(element, argprops, true);
        let placeHolderBounds = this.getPlaceholderBounds()
        let booloverLap = (this.graphicH * 1.5) < this.maxLabelH + this.maxValueH + (this.width * 0.3) || argprops.value < 40;
        // if(booloverLap)element.style.height = (this.graphicH*2)+this.maxLabelH + this.maxValueH + (width*0.2)+"px";
        const vLayoutName = this.valuelayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + this.groupindex + "_" + argprops.index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.height = "100%";
        sameElement.style.position = "absolute";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        if (!booloverLap) element.appendChild(sameElement);


        if (this.valueAlignment.samepos && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = booloverLap ?this.getColorDetails(argprops.gindex, this.data.ChartFonts.valueOuterColor, this.data.layout.valueColor, "color")  : this.data.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(layoutContainer, argprops, "", booloverLap);
            else this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" || booloverLap ? this.data.ChartFonts.graphicFillColor(argprops.gindex) :this.data.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopPlaceholder(layoutContainer, argprops, true);
            else this.doAddTopPlaceholder(sameElement, argprops, true);
        }
    }
    argparent.dataset.dummeygraphicWidth = (2 * this.circleRadius);

    // if (this.data.layout.valueInset == "true") {
    //     this.valueStyle =this.data.ChartFonts.valueInnerColor; 
    //     this.doAddTopValue(element, argprops);
    // }

}


SimpleScaleIconCompareSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, overlap) {
    let valueMaxSize = "";
    if (boolmax) {
        valueMaxSize = this.maxValueFontSize[this.arrIndex] * (this.data.rangePositive / this.data.rangePositive)
    } else {
        if (!overlap) {
            valueMaxSize = this.maxValueFontSize[this.arrIndex] * (argprops.value / this.data.rangePositive)
        }
    }
    valueMaxSize = valueMaxSize < 50 ? 50 : valueMaxSize
    const index = argprops.index;
    const groupindex = argprops.gindex;

    let padding = this.setoverlapPadding("value");
    let labelPadding = this.setoverlapPadding("label");
    let vLayoutName = this.valuelayoutClassName("value");
    if (overlap) {
        padding["right"] = labelPadding["right"];
        padding["left"] = labelPadding["left"]
        if (argprops.gindex == 0) {
            vLayoutName = "valuerightmiddle"
        } else {
            vLayoutName = "valueleftmiddle"
        }
    }
    const element =this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = this.valueMaxH + "px";
    element.style.width = this.valueMaxW + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName + this.ChartFonts.graphicColor(groupindex)//" accent" + (groupindex + 1) + "-color";
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if(this.data.layout.valuePaddingClass){
        element.classList.add(this.data.layout.valuePaddingClass)
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.data.layout.valueInset == "inside") {
        element.className = "value topvalue overflow " + vLayoutName
    }
    const subelement = document.createElement("div");

    let hasInnerValue = this.data.layout.valueInset=="inside"
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor,this.valueStyle,subelement,"value",hasInnerValue)
    this.checkMoodLevelColorvalue(this.data.layout.valueColor,subelement,"value","color",null,hasInnerValue)
    let colorTabValueCustomClass = this.valueStyle=="dummeycolor"?"":this.data.clsValueTextColor;

    subelement.id = "valuetext-" + groupindex + "_" + index;
    subelement.className = "valuetext "+colorTabValueCustomClass+" moodanimation " + this.valueStyle + " "+this.data.ChartFonts.valueThemeClassName;;
    subelement.innerText = argprops.valuetext
    subelement.style.maxWidth = this.valueMaxW + "px";
    // subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = valueMaxSize + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", valueMaxSize);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", this.graphicH);
    subelement.dataset.animation = "secondarytext";
    if(this.valueStyle=="textgradient"){
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important")
    }
    element.appendChild(subelement);
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding ="10px";
        this.valuebgProperties(subelement)
    }
    if (this.voData.voLayout.valuetextbgcallout == "true") {

        if (this.groupindex == 0) {
            element.style.marginRight = "40PX";
            element.style.marginLeft = "unset"
        } else {
            element.style.marginLeft = "40PX";
            element.style.marginRight = "unset";
        }
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if(this.data.layout.valueShadowClass)subelement.classList.add(this.data.layout.valueShadowClass)
    }
   this.ChartHelper.setTextChangeListner(subelement);

    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.data.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme"? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if(this.data.layout.valueShadowClass)subelement.classList.add(this.data.layout.valueShadowClass)
    }
   if(this.data.valueTextColor[groupindex][index]){
        subelement.style.setProperty("color",this.data.valueTextColor[groupindex][index],"important")
    }
   this.calculateMaxFonsize(subelement,boolmax,valueMaxSize)
   this.ChartHelper.adjustFontSize(subelement, 10, 58, valueMaxSize);
   this.ChartHelper.adjustFontSizeWidth(subelement, 10, 58, valueMaxSize);
    //this.ChartHelper.textPositionChangeObserver(subelement);
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        argparent.removeChild(element);
    }else{
        this.ChartUtils.createSpanFormat(subelement,this.data);
    }
}


SimpleScaleIconCompareSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "minheightvalue label moodanimation " + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        element.id = "label-text-" + this.groupindex;
        element.style.minHeight = 10 + "px";
        element.style.width = this.labelMaxW + "px";
        element.style.maxWidth = this.labelMaxW + "px";
        element.style.maxHeight = this.labeMaxH + "px";
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px";
        if( this.data.arrLabelTextSize[this.index])element.style.fontSize = this.data.arrLabelTextSize[this.index]
        element.style.fontSize = this.data.arrLabelTextSize[this.index]
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        element.style.paddingBottom = padding["bottom"] + "px";
        if(this.data.layout.labelPaddingClass)
        {
            element.classList.add(this.data.layout.labelPaddingClass)
        }
        // if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        let labelColor = this.getColorDetails(this.groupindex, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;
        let subelement = document.createElement("div");
        
        let hasInnerLabel = this.data.layout.labelInset=="inside"
                this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor,this.ChartFonts.labelOuterColor,subelement,"heading",hasInnerLabel)
                this.checkMoodLevelColorvalue(this.data.layout.labelColor,subelement,"heading","color",null,hasInnerLabel)
                
                let colorTabCustomClass = this.labelStyle=="dummeycolor"?"":this.data.clsLabelTextColor;

        subelement.className = "labeltext "+colorTabCustomClass+" "+ this.labelStyle;
        subelement.id = "labeltext-" + this.groupindex;
        if(this.data.arrLabelOpacity[this.groupindex])subelement.style.setProperty("opacity",this.data.arrLabelOpacity[this.groupindex],"")
        if(this.data.arrLabeltexttransform[this.groupindex])subelement.style.setProperty("text-transform",this.data.arrLabeltexttransform[this.groupindex],"")

        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.data.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.labelMaxW + "px";
        subelement.style.maxHeight = this.labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.data.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        if(this.data._labelTextColor[this.groupindex]){
            subelement.style.setProperty("color",this.data._labelTextColor[this.groupindex],"important")
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding ="10px"
            this.labelbgProperties(subelement)
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent")?this.labelStyle:this.ChartFonts.graphicColor(this.groupindex);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item"||this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.groupindex, this.data.layout.valueTextShdowOpacity);
            if(this.data.layout.labelShadowClass)subelement.classList.add(this.data.layout.labelShadowClass)
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
        }
        if(!boolMax)this.ChartHelper.setTextChangeListner(subelement);
        if (this.voData.voLayout.valuetextbgcallout == "true") {

            if (this.groupindex == 0) {
                element.style.marginRight = "40PX";
                element.style.marginLeft = "unset"
            } else {
                element.style.marginLeft = "40PX";
                element.style.marginRight = "unset";
            }
        }
        if(this.data.labelLineHeight[this.groupindex]){
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if(this.data.labelLetterSpace[this.groupindex]){
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex]+"em";
        }
       this.ChartHelper.adjustFontSize(subelement, 10, this.data.ChartFonts.maxLabelFontSize(element) - this.data.ChartFonts.minFontSize, this.data.ChartFonts.maxLabelFontSize(element));
       if(!boolMax)this.ChartHelper.textPositionChangeObserver(subelement);
       this.ChartHelper.recalculateMaxHeight(subelement);
       this.ChartUtils.enableTextHeighlight(subelement,this.data)
        element.style.minHeight = 10 + "px";
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            argparent.removeChild(element);
        }
    }
}

SimpleScaleIconCompareSeriesItem.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment && !this.addplaceholder ? this.placeholderAlignment.show : false;
}
SimpleScaleIconCompareSeriesItem.prototype.getPlaceholderBounds = function (props) {
    if (this.data.primaryPlaceholder) {
        return { width: this.width * 0.3, height: this.width * 0.3 };
    } else {
        return { width: this.state.width, height: 0 };
    }
}
SimpleScaleIconCompareSeriesItem.prototype.doAddTopPlaceholder = function (argparent, argprops, customSize = false) {
    const index = argprops.index;
    const type = String(argprops.placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    let bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    bounds.height = type != "image" ? 80 : bounds.height;
    if (customSize) {
        bounds.width = 70;
        bounds.height = 70;

    }
    let padding = this.setoverlapPadding("label");
    const pLayoutName = this.placeholderlayoutClassName("placeholder");

    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.paddingLeft = padding["left"] + "px";
    baseelement.style.paddingRight = padding["right"] + "px";
    baseelement.style.paddingTop = padding["top"] + "px";
    baseelement.style.paddingBottom = padding["bottom"] + "px";
    baseelement.style.pointerEvents = "all";
    baseelement.style.order = this.placeholderAlignment.index;

    if (argparent) argparent.appendChild(baseelement);

    const element = this.ChartHelper.createDivElement({});
    element.id = "primary-placeholder-" + this.groupindex;
    element.className = "primaryplaceholder topprimaryplaceholder moodanimation " + pLayoutName;
    element.setAttribute("data-animation", "primaryplaceholder");
    element.style.width = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.width + "px";
    element.style.height = bounds.height + "px";
    if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "outer") {
        element.style.height = this.data.layout.placholderHeight ? this.data.layout.placholderHeight + "px" : bounds.height + 10 + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : 100 + "px";
        baseelement.className = pLayoutName;
    } else {
        element.style.height = this.data.layout.placholderHeight ? this.data.layout.placholderHeight + "px" : bounds.height + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        baseelement.className = pLayoutName;
    }
    baseelement.appendChild(element);
    if (this.placeholderAlignment.position == "inner") {
        element.style.height = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
        element.style.width = this.data.layout.placholderWidth ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position != "middle") {
        this.bgProperties(element)

    }
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder") && type == "image") {
        this.bgProperties(element)
    }
    if (this.data.layout.boolplaceholderShape) {
        element.style.alignItems = "center";
        element.style.justifyContent = "center"
    }
    // if (this.graphicElement.alterpos == "true") {

    // }

    switch (type) {
        case "icon":
            this.doAddIconUseNodeElement(element, argprops);
            break;
        case "image":
            this.doAddImageUseNodeElement(element, argprops);
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }

}

function SimplePercentageSliceChart(argParent, argProps) {
    this.widthPercentage = 1;
    this.minSeriesSize = 300;
    this.name = "BaseCuurencyChart";
    this.ChartFonts = new window["ChartFonts"]();
    BaseChart.call(this, argParent, argProps);
}
SimplePercentageSliceChart.prototype = Object.create(BaseChart.prototype);
SimplePercentageSliceChart.prototype.constructor = SimplePercentageSliceChart;

SimplePercentageSliceChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["SimplePercentageSliceSeries"](argParent, argProps)
}



SimplePercentageSliceChart.prototype.doComputation=function() {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddGraphicDesk();
            this.doAddMetaData();
        }
    }
}

SimplePercentageSliceChart.prototype.updateBasicData=function() {
    this.length = this.voData.seriesLength;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeries = { x: this.viewport.x, y: this.viewport.y, width: 0, height: 0 };
    this.rectBaseSeries = { x: this.viewport.x, y: this.viewport.y, width: this.viewport.width, height: this.viewport.height };
}


SimplePercentageSliceChart.prototype.doAddGraphicDesk=function() {
    const pading = 8;
    if (this.data.baseProperties.grid && !this.data._customProperties.showYAxisGrid) this.rectBaseSeries.height -= 20;
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";

    this.rectSeries.height = this.rectBaseSeries.height;
    this.rectSeries.width = this.rectBaseSeries.width;

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    element.style.height = seriesHeight;
    element.style.width = seriesWidth;
    element.style.maxHeight = seriesHeight;

    this.parent.appendChild(element);

    this.doAddGraphicElement(element);
}

SimplePercentageSliceChart.prototype.doAddGraphicElement=function(argparent) {
    let padding = 20;
    let moveY = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
}

// ---------------------------------- Enhancement ---------------------------------

SimplePercentageSliceChart.prototype.doAddLegendDesk=function(argProps) {
    let eProps = {};
    let eParent = null;
    this.addLegendDeskElements(eParent, eProps);
}

SimplePercentageSliceChart.prototype.addLegendDeskElements=function(argParent, argProps) {
    if (this.data.baseProperties.legend) {
        let eProps = {};
        let element = this.ChartHelper.createDivElement(eProps);
        return element;
    }
    return null;
}



function SimplePercentageSliceSeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
    this.name = "BaseSeries";
    this.maxLabelFontSize = [24, 24];
    this.minLabelFontSize = [30 - 8, 30 - 8];
    this.dummeylabelMaxW = 0;
    this.scaleX = 1;
    this.scaleY = 1;
    this.intItemGap = 4;
    this.numRectGrapicX = 0;
    this.numWidthPercentage = 0.34;
    this.numHeightPercentage = 0.64;
    this.dummeyLabeMaxH = 90;
    this.minValueFontSize = [25, 25];
    this.ChartFonts = new window["ChartFonts"]();
    this.valueStyle = this.ChartFonts.valueOuterColor;
    BaseSeries.call(this, argparent, argprops);
}
SimplePercentageSliceSeries.prototype = Object.create(BaseSeries.prototype);
SimplePercentageSliceSeries.prototype.constructor = SimplePercentageSliceSeries;

SimplePercentageSliceSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimplePercentageSliceSeriesItem"](argparent, argprops);
};

SimplePercentageSliceSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

SimplePercentageSliceSeries.prototype.updateBasicData = function () {
    this.itembasedHeight = 0;
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.2 - 8;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage * 0.9;
    this.valueMaxH = this.state.height * 0.3; //< 35 ? this.state.height : 35;
    let _oWidth = 0;
    this.length = this.voData.seriesItemLength;
    this.viewportGroup = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

SimplePercentageSliceSeries.prototype.doMeasurementComputation = function (argprops) {
    if (this.index == 0) {
        this.numRectGrapicX = 0;
        this.data.tempVarData = 0;
    }
    this.rectAvalSize = {
        x: (this.viewportGroup.width * this.numWidthPercentage) / 2,
        y: (this.viewportGroup.height * this.numHeightPercentage) / 2,
        width: this.viewportGroup.width * this.numWidthPercentage,
        height: this.viewportGroup.height * this.numHeightPercentage,
    };
    this.scaleX = this.rectAvalSize.width / 475.8;
    this.scaleY = this.rectAvalSize.height / 400;
    let intFitWidth = this.rectAvalSize.width;
    let intFitHeight = this.rectAvalSize.height;
    if (this.scaleX < this.scaleY) {
        intFitHeight = intFitHeight * this.scaleX;
        this.scaleY = intFitHeight / 400;
    } else {
        intFitWidth = intFitWidth * this.scaleY;
        this.scaleX = intFitWidth / 475.8;
    }
    this.rectSeriesItemSize = {
        x: (this.viewportGroup.width - intFitWidth) / 2,
        y: (this.viewportGroup.height - intFitHeight) / 2,
        width: intFitWidth,
        height: intFitHeight,
    };
    let intValueWidth = this.getWidth(this.rectSeriesItemSize.width, parseInt(this.data.values[this.index][0]), parseInt(this.data.seriesLength));
    this.numRectGrapicX = this.data.tempVarData;
    this.rectGrapicsItemSize = { x: this.numRectGrapicX, y: 0, width: intValueWidth, height: this.rectSeriesItemSize.height };
    this.data.tempVarData += this.rectGrapicsItemSize.width + this.intItemGap;
};

SimplePercentageSliceSeries.prototype.getWidth = function (width, value, seriesLength) {
    var barPercent = (value * 100) / this.data.totalValue;
    barPercent = this.data.totalValue == 0 ? 100 / seriesLength : barPercent;
    var displace = ((width - (seriesLength - 1) * this.intItemGap) * barPercent) / 100;
    return displace;
};

SimplePercentageSliceSeries.prototype.doAddGraphicElement = function (argprops) {
    let element = this.ChartHelper.createDivElement();
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.style.position = "absolute";
    element.style.width = "100%";
    element.style.height = "100%";
    let customColorIndex = this.ChartFonts.customColor(this.index);
    this.data.SVGUtils.assignAttributes(element, {
        class: "series accent" + customColorIndex + " clsMultiColorParent",
    });
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    let intMaxGraphicSize = parseInt(this.data.maxValue * this.numMultiplyFactor);
    let eProps = {
        index: 0,
        scaleX: this.scaleX,
        scaleY: this.scaleX,
        groupIndex: this.index,
        parentWidth: this.rectSeriesItemSize.width,
        parentHeight: this.rectSeriesItemSize.height,
        rectGrapicsItemSize: {
            x: this.rectGrapicsItemSize.x,
            y: this.rectGrapicsItemSize.y,
            width: this.rectGrapicsItemSize.width,
            height: this.rectGrapicsItemSize.height,
        },
    };
    let groupParentElemet = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(groupParentElemet, { x: "0%", y: "0%", width: "100%", height: "100%" });

    let groupElemet = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(groupElemet, {
        id: "seriesItem-" + this.groupIndex + "_" + this.index,
        class: "seriesitem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeriesItemSize.y + 10),
        width: this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeriesItemSize.height),
    });
    groupParentElemet.appendChild(groupElemet);
    element.appendChild(groupParentElemet);
    if (this.parent) this.parent.appendChild(element);
    let seriesitem = this.seriesItemInstance(groupElemet, eProps);
    seriesitem.ChartHelper = this.ChartHelper;
    seriesitem.ChartUtils = this.ChartUtils;
    seriesitem.data = this.data;
    this.applyLayout(element, eProps);
};

SimplePercentageSliceSeries.prototype.applyLayout = function (element, eProps) {
    let calloutHeight = this.viewportGroup.height * 0.9;
    let calloutWidth = (this.viewportGroup.width - this.rectSeriesItemSize.width) / 2 - 20;
    let targetBounds = { x: 0, y: 0, width: calloutWidth, height: calloutHeight };
    let axiscolumnBaseLineData = {
        title: "text",
        content: {},
        assettype: "chart",
        animatable: "false",
        position: { primary: "horizantal" },
    };
    let Instance = "";
    if (this.data.moodData.calloutstyle) {
        let calloutStyle = this.data.moodData.calloutstyle == "CalloutModel3" || this.data.moodData.calloutstyle == "CalloutModel1" || this.data.moodData.calloutstyle == "CalloutModel2" ? "CalloutModel4" : this.data.moodData.calloutstyle;
        this.data.getCurrentSlide.classList.remove(this.data.moodData.calloutstyle);
        this.data.getCurrentSlide.classList.add(calloutStyle);
        this.data.data.setAttribute("oldcalloutstyle", calloutStyle);
        try {
            Instance = new window[calloutStyle](element.children[0], axiscolumnBaseLineData, targetBounds);
        } catch (error) {
            Instance = new window["HighlightTest"](element.children[0], axiscolumnBaseLineData, targetBounds);
        }
    } else {
        Instance = new window["HighlightTest"](element.children[0], axiscolumnBaseLineData, targetBounds);
    }
    let baseCalloutSvg = element.parentNode && element.parentNode.parentNode && element.parentNode.parentNode.querySelectorAll("#callOut").length > 0 ? element.parentNode.parentNode.querySelectorAll("#callOut")[0] : "";
    if (!baseCalloutSvg) return;
    baseCalloutSvg.setAttribute("id", "comparecallout");
    element.appendChild(baseCalloutSvg);
    let childSvg = baseCalloutSvg.querySelector("#callout-title");
    childSvg.innerHTML = "";
    baseCalloutSvg.style.maxWidth = calloutWidth + "px";
    baseCalloutSvg.style.minWidth = calloutWidth * 0.4 + "px";
    baseCalloutSvg.style.height = calloutHeight + "px";
    baseCalloutSvg.dataset.animation = "chartcalloutshape";
    baseCalloutSvg.classList.remove("bottomcenter");
    baseCalloutSvg.classList.add("moodanimation");
    if (childSvg) {
        childSvg.style.removeProperty("max-height");
        childSvg.style.removeProperty("max-width");
    }
    if (this.index == 0) {
        baseCalloutSvg.classList.add("lefttop");
    } else {
        baseCalloutSvg.classList.add("rightbottom");
    }
    // baseCalloutSvg.style.border = "3px solid";
    baseCalloutSvg.style.bottom = this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeriesItemSize.height + 10);
    // baseCalloutSvg.style.position = "absolute";
    // baseCalloutSvg.dataset.animation = "callout"
    // let borderNote = this.ChartHelper.createDivElement();
    // baseCalloutSvg.style.setProperty("--border-width", "3px", "");
    // baseCalloutSvg.style.setProperty("--border-style", "solid", "")
    // borderNote.className = "notch";
    // baseCalloutSvg.appendChild(borderNote)
    let leftPercentage;
    if (this.index == 0) {
        // baseCalloutSvg.className = "calloutContainerleft";
        leftPercentage = "calc(" + this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.x) + " - " + calloutWidth + "px)";
    } else {
        // baseCalloutSvg.className = "calloutContainerright";
        let baseValue = this.rectGrapicsItemSize.x + this.rectSeriesItemSize.x + 20;
        let overlapValue = this.state.width < baseValue + calloutWidth ? baseValue + calloutWidth - this.state.width : 0;
        if (overlapValue) baseValue -= overlapValue;
        leftPercentage = this.data.SVGUtils.createPercentValue(this.state.width, baseValue);
    }
    // baseCalloutSvg.classList.add("moodanimation")
    // baseCalloutSvg.classList.add("bgColor")
    // baseCalloutSvg.classList.add((this.data.ChartFonts.appendgraphicBorderColor(this.index)));

    // element.appendChild(baseCalloutSvg)

    this.valueMaxW = calloutWidth;
    this.valueMaxH = calloutHeight * 0.3;
    this.valueStyle = this.ChartFonts.valueOuterColor;
    this.doAddTopValue(childSvg, true);
    this.doAddTopValue(childSvg);
    this.dummeylabelMaxW = calloutWidth;
    this.dummeyLabeMaxH = calloutHeight * 0.7;
    this.doAddLabel(childSvg, "", true);
    this.doAddLabel(childSvg);
    if (this.index == 0) {
        leftPercentage = "calc(" + this.data.SVGUtils.createPercentValue(this.state.width, this.rectSeriesItemSize.x + this.rectGrapicsItemSize.width) + " - " + baseCalloutSvg.clientWidth + "px)";
    }
    baseCalloutSvg.style.left = leftPercentage;
    let label = baseCalloutSvg.querySelector(".label");
    let value = baseCalloutSvg.querySelector(".value");
    if (label) {
        label.style.width = label.parentNode.clientWidth + "px";
    }
    if (value) {
        // value.style.width = parseInt(value.parentNode.clientWidth)-25+"px";
        value.children[0].style.maxWidth = value.parentNode.clientWidth + "px";
        value.children[0].style.overflow = "hidden";
    }
    value.parentNode.style.maxWidth = value.parentNode.clientWidth + "px";
    if (baseCalloutSvg) {
        let height = parseFloat(baseCalloutSvg.style.height);
        let textParent = baseCalloutSvg.querySelector("#callout-textparent");
        if (textParent) textParent.style.maxHeight = "unset";
        baseCalloutSvg.children[0].style.height = "100%";
        label.style.minHeight = "auto";
        let valueHeight = value.clientHeight;
        let labelHeight = label.clientHeight;
        let totalHeight = labelHeight + valueHeight;
        value.style.height = "auto";
        if (totalHeight > height) {
            baseCalloutSvg.style.height = totalHeight + "px";
        }
        if (this.index == 0) {
            baseCalloutSvg.style.top = "unset";
            baseCalloutSvg.style.left = 0;
            baseCalloutSvg.style.height = "auto";
            baseCalloutSvg.style.bottom = 0;
            label.children[0].style.textAlign = "end";
            baseCalloutSvg.style.left = this.rectSeriesItemSize.x - baseCalloutSvg.clientWidth - 20 + "px";
        } else {
            baseCalloutSvg.style.top = 0;
            baseCalloutSvg.style.height = "auto";
            baseCalloutSvg.style.left = this.rectSeriesItemSize.x + this.rectSeriesItemSize.width + 20 + "px";
            baseCalloutSvg.style.bottom = "unset";
        }
        if (this.index == 0) {
            this.data.previousData = { width: baseCalloutSvg.clientWidth, height: baseCalloutSvg.clientHeight, x: this.rectSeriesItemSize.x, labelWidth: label.style.width };
        } else {
            let baseParentNode = baseCalloutSvg.parentNode.parentNode.parentNode;
            let callOut = baseParentNode.querySelectorAll("#callOut")[0];
            let prelabel = baseParentNode.querySelector(".label");
            let preValue = baseParentNode.querySelector(".value");
            let preChild = baseParentNode.querySelector("#callout-title");
            if (baseCalloutSvg.clientHeight < this.data.previousData.height) {
                baseCalloutSvg.style.height = this.data.previousData.height + "px";
            } else {
                if (baseCalloutSvg.clientHeight > this.data.previousData.height) {
                    if (callOut) callOut.style.height = baseCalloutSvg.clientHeight + "px";
                    prelabel = baseParentNode.querySelector(".label");
                    prelabel.style.minHeight = "auto";
                }
            }

            if (baseCalloutSvg.clientWidth < this.data.previousData.width) {
                baseCalloutSvg.style.width = this.data.previousData.width + "px";
                label.style.width = this.data.previousData.labelWidth;
                // value.style.width = this.data.previousData.labelWidth;
                childSvg.style.maxWidth = preChild.style.maxWidth;
            } else {
                if (baseCalloutSvg.clientWidth > this.data.previousData.width) {
                    baseCalloutSvg.style.width = baseCalloutSvg.clientWidth + "px";
                    let valueNode = this.data.previousData.x - baseCalloutSvg.clientWidth - 20;
                    // if (valueNode > 1) baseCalloutSvg.style.left = this.data.previousData.x - baseCalloutSvg.clientWidth - 20 + "px";
                    prelabel = baseParentNode.querySelector(".label");
                    preValue = baseParentNode.querySelector(".value");
                    preChild.style.maxWidth = childSvg.style.maxWidth;
                    prelabel.style.width = label.style.width;
                    // preValue.style.width =label.style.width;
                }
            }
        }
    }
    if (Instance && Instance.setupBgShape) {
        Instance.setupBgShape();
    }
};

SimplePercentageSliceSeries.prototype.doAddTopValue = function (argparent, boolmax = false, boolOrder = false, overlapValue = true) {
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : this.index;
    // if(this.data.boolPercentageChart){
    //     this.data.valuesDenomination[valGroupIndex][0] = parseInt(this.data.values[valGroupIndex][0])
    //  }
    const index = this.index;
    const groupindex = this.index;
    let valIndex = this.data.chartName == "comparisonModelType3" ? (groupindex < this.voData.seriesLength / 2 ? 0 : 1) : index;
    this.valueStyle = this.ChartFonts.graphicColor(valIndex);
    let padding = this.setoverlapPadding("value");
    this.valueAlignment.hposition = valIndex == 0 ? "left" : "right";
    const vLayoutName = this.valueAlignment.itemBased == "true" ? this.valuelayoutClassName("itemlabel") : this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + 0 + "_" + valIndex;
    element.style.minWidth = 20 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.overflow = "hidden";
    element.className = "calloutline value " + vLayoutName;
    element.style.order = boolOrder ? "1" : this.valueAlignment.index;
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.valueAlignment.textbgitem == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        element.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
    }
    if (this.valueBackground) {
        element.className = "value " + vLayoutName + " " + this.ChartFonts.graphicColor;
        element.style.left = "20px";
    }
    if (this.valueAlignment.hposition == "left") element.style.textAlign = "start";

    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);

    subelement.className = "valuetext " + this.ChartFonts.valueThemeClassName + " moodanimation";
    subelement.id = "valuetext-" + valGroupIndex + "_" + valIndex;
    subelement.innerText = boolmax ? this.data.longValue : this.data.prefix[valGroupIndex][0] + this.data.valuesDenomination[valGroupIndex][0] + this.data.suffix[valGroupIndex][0];
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[valGroupIndex + " " + valIndex];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + 0);
    subelement.setAttribute("data-slideid", this.data.slideID);
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    }
    subelement.dataset.animation = "secondarytext";
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(valGroupIndex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, valGroupIndex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
    }
    if (this.data.arrHyperlinkUrl.length >= valIndex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[valIndex]);
    }
    element.appendChild(subelement);
    if (this.data.arrHyperlinkUrl.length >= valGroupIndex) {
        element.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[valGroupIndex]);
    }
    if (valGroupIndex == 0) {
        subelement.style.textAlign = "end";
    }
    if (this.deafaultPercentage) {
        subelement.innerText = parseFloat(this.data.values[valGroupIndex][0]) + "%";
    }
    if (this.valueAlignment.textbg == "true" && this.valueAlignment.textbgitem != "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            // if (this.valueAlignment.hposition == "right") {
            //     element.style.paddingTop = this.data.layout.valuePaddingtop + 15 + "px";
            //     element.style.paddingBottom = "15px";
            // } else if (this.valueAlignment.hposition == "left") {
            //     element.style.paddingTop = "15px";
            //     element.style.paddingBottom = this.data.layout.valuePaddingbottom + 15 + "px";
            // }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);

    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][this.index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 20, 25, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, 25, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.currentValW = element.clientWidth;
        this.currentValH = element.clientHeight;
        element.remove();
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);
    }
};

SimplePercentageSliceSeries.prototype.doAddLabel = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.showLabel) {
        this.labelAlignment.hposition = this.index == 0 ? "left" : "right";
        let llayoutname = this.labellayoutClassName("label");
        let element = document.createElement("div");

        element.className = "label calloutline moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.index) + " " + llayoutname;
        element.id = "label-text-" + this.index;
        element.style.minHeight = 10 + "px";
        element.style.maxWidth = this.dummeylabelMaxW + "px";
        element.style.maxHeight = this.dummeyLabeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.bo;
        element.style.order = this.labelAlignment.index;
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px";
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (this.data.layout.labelPaddingClass) {
            element.classList.add(this.data.layout.labelPaddingClass);
        }
        if (argparent) argparent.appendChild(element);
        else return element;
        let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.ChartFonts.labelOuterColor;
        let subElementMaxHeight = this.dummeyLabeMaxH - (this.data.layout.labelPaddingtop + this.data.layout.labelPaddingbottom);
        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        // this.checkMoodLevelColorvalue(this.data.layout.labelColor,subelement,"heading","color",null,hasInnerLabel)

        subelement.className = "labeltext";
        subelement.id = "labeltext-" + this.index;
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");

        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.index];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = this.dummeylabelMaxW + "px";
        subelement.style.maxHeight = subElementMaxHeight + "px";
        subelement.style.overflow = "hidden";

        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.index);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
        element.appendChild(subelement);
        if (this.data._labelTextColor[this.index]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.index], "important");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                    element.style.paddingBottom = "15px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = "15px";
                    element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        }
        if (this.data.labelLineHeight[this.index]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.index];
        }
        if (this.data.labelLetterSpace[this.index]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.index] + "em";
        }
        this.ChartHelper.setTextChangeListner(subelement);

        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement, true);
        if (boolMax) {
            this.labelMaxHeight = element.clientHeight;
            argparent.removeChild(element);
        }
    }
};

SimplePercentageSliceSeries.prototype.valuelayoutClassName = function (itemname, boolBottom = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolBottom) {
            if (this.valueAlignment.vposition == "bottom") vLayoutName = vLayoutName + this.valueAlignment.hposition + "top";
            else if (this.valueAlignment.vposition == "top") vLayoutName = vLayoutName + this.valueAlignment.hposition + "bottom";
            else vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        } else {
            vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    }
    return vLayoutName;
};
SimplePercentageSliceSeries.prototype.setoverlapPadding = function (name) {
    let hposition;
    let vPosition;
    let area = { left: 0, right: 0, top: 0, bottom: 0 };
    if (name == "label") {
        area = { left: this.data.layout.labelPaddingleft, right: this.data.layout.labelPaddingright, top: this.data.layout.labelPaddingtop, bottom: this.data.layout.labelPaddingbottom };
        if (this.labelAlignment && this.labelAlignment.overlap == "value") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.labelPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.labelPaddingright;
            return area;
        } else if (this.labelAlignment ** this.labelAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = (this.middlePH + this.data.layout.labelPaddingbottom) * 0.5;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.labelPaddingright;
            return area;
        }
    } else if (name == "value") {
        area = { left: this.data.layout.valuePaddingleft, right: this.data.layout.valuePaddingright, top: this.data.layout.valuePaddingtop, bottom: this.data.layout.valuePaddingbottom };
        if (this.valueAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleLH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.valuePaddingright;
            return area;
        } else if (this.valueAlignment.overlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middlePH + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middlePW + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middlePW + this.data.layout.valuePaddingright;
            return area;
        }
    } else if (name == "placeholder") {
        area = {
            left: this.data.layout.placeholderPaddingleft,
            right: this.data.layout.placeholderPaddingright,
            top: this.data.layout.placeholderPaddingtop,
            bottom: this.data.layout.placeholderPaddingbottom,
        };
        if (this.placeholderAlignment.overlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = middleValueH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleLH + this.data.layout.placeholderPaddingright;
            return area;
        } else if (this.placeholderAlignment.overlap == "placeholder") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW + this.data.layout.placeholderPaddingright;
            return area;
        }
    }
    return area;
};

SimplePercentageSliceSeries.prototype.labellayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") lLayoutName = lLayoutName + "valuecontainer valuebackground";
    return lLayoutName;
};


function SimplePercentageSliceSeriesItem(argparent, argprops) {
    this.index = argprops.index;
    this.groupIndex = argprops.groupIndex;
    this.parentWidth = argprops.parentWidth;
    this.parentHeight = argprops.parentHeight;
    this.rectGrapicsItemSize = argprops.rectGrapicsItemSize;
    //this.rectBgImages = argProps.rectBgImages;
    this.scaleX = argprops.scaleX;
    this.scaleY = argprops.scaleY;
    this.intItemGap = 10;
    BaseSeriesItem.call(this, argparent, argprops);
}
SimplePercentageSliceSeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
SimplePercentageSliceSeriesItem.prototype.constructor = SimplePercentageSliceSeriesItem;

SimplePercentageSliceSeriesItem.prototype.doComputation = function () {
    if (this.datavalidation) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
}

SimplePercentageSliceSeriesItem.prototype.updateBasicData = function () {
    this.length = this.voData.seriesItemLength;
    let intAssetLength = this.voData.asset.data.length;
    if (0 < intAssetLength) this.assetURL = this.voData.asset.data[0].url;
}

SimplePercentageSliceSeriesItem.prototype.doAddGraphicElement = function () {
    let elementGroup = this.data.SVGUtils.createSVGElement("g");
    let boolOdd = this.voData.seriesLength % 2 == 0 ? true : false;
    let strSideAlignment;
    let leftAlignment = Math.ceil(this.voData.seriesLength / 2);
    let rightIndex = this.groupIndex + 1 - leftAlignment;
    let intCurrentIndex = this.groupIndex + 1;
    if (boolOdd) {
        strSideAlignment = this.groupIndex >= leftAlignment ? "right" + rightIndex : "left" + intCurrentIndex;
    } else {
        strSideAlignment = intCurrentIndex > leftAlignment ? "right" + rightIndex : leftAlignment == intCurrentIndex ? "center" : "left" + intCurrentIndex;
    }

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = 1 < this.voData.seriesItemLength ? "item" + (this.index + 1) : "item" + (this.groupIndex + 1);
    this.data.SVGUtils.assignAttributes(svgElement, {
        class: "chartgraphic " + strStyleClass,
        id: "graphic-" + this.groupIndex + "_" + this.index,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-x": 0,
        "data-y": 0
    });
    elementGroup.appendChild(svgElement);

    let imageTag = this.data.SVGUtils.createSVGElement("image");
    this.data.SVGUtils.assignAttributes(imageTag, {
        class: "imagetag moodanimation",
        "data-animation": "bgimage",
        id: "item-" + this.groupIndex + "_" + 0,
        "xlink:href": this.data.serverUrl + this.assetURL,
        "data-gap": this.intItemGap,
        width: "100%",
        height: "100%",
        x: this.data.SVGUtils.createPercentValue(this.width, 0)
    });
    let rect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(rect, {
        x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y),
        width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight),
        id: "item-" + this.groupIndex + "_" + 0,
        fill: "#fff",
        class: "CalloutRect",
        "data-x": this.rectGrapicsItemSize.x,
        "data-y": this.rectGrapicsItemSize.y
    });
    let rectBorder = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(rectBorder, {
        class: "moodanimation "+this.data.ChartFonts.appendgraphicFillColor(this.groupIndex),
        "data-animation": "borderrect",
        id: "strokeitem-" + this.groupIndex + "_" + 0,
        x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.x),
        y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.rectGrapicsItemSize.y),
        width: this.data.SVGUtils.createPercentValue(this.parentWidth, this.rectGrapicsItemSize.width),
        height: this.data.SVGUtils.createPercentValue(this.parentHeight, this.parentHeight),
        mask: "url(#mask" + this.data.slideID + this.groupIndex + ")",
        "style": "mix-blend-mode: multiply;",
        "stroke-width": "4px",
    });
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, { id: "mask" + this.data.slideID + this.groupIndex, fill: "white" });
    defsTag.appendChild(mask);
    let svgAsset
    if (!this.voData.asset.data[1].data) {
        if(this.data.slideObj.querySelector("#series-" + this.groupIndex)){
            svgAsset = this.data.slideObj.querySelector("#series-" + this.groupIndex).querySelector(".chartgraphic").children[0].children[0].children[0]
        }else{
            svgAsset = this.data.slideObj.querySelector("#series-0").querySelector(".chartgraphic").children[0].children[0].children[0]
        }
    } else {
        svgAsset = this.voData.asset.data[1].data.cloneNode(true);
    }
    mask.appendChild(svgAsset);
    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgGroup, {
        id: "svgGroup-" + this.groupIndex + "_" + 0
    });
    if (this.groupIndex == 0) svgGroup.appendChild(imageTag);
    svgElement.appendChild(svgGroup);
    svgElement.appendChild(rectBorder);

    this.parent.appendChild(elementGroup);
}

SimplePercentageSliceSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment.show;
}


function SimpleOverlapComparisonChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleOverlapComparisonChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleOverlapComparisonChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleOverlapComparisonChart.prototype.constructor = SimpleOverlapComparisonChart;

SimpleOverlapComparisonChart.prototype.seriesInstance=function(argparent, argprops) {
    return new window["SimpleOverlapComparisonSeries"](argparent, argprops);
}
SimpleOverlapComparisonChart.prototype.CreateHightlightDifference = function () {
    return null;
}

// let backX = 0;
// let secondarybackX = 0;
// let remaingArea = 0;
// let secondaryRemaingArea = 0;
// let previousWidth = 0;
// let secondarypreviousWidth = 0;
function SimpleOverlapComparisonSeries(argparent, argprops) {
    this.name = "SimpleOverlapComparisonSeries";
    this.gapPercentage = 1;
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleOverlapComparisonSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleOverlapComparisonSeries.prototype.constructor = SimpleOverlapComparisonSeries;

SimpleOverlapComparisonSeries.prototype.doAddGraphicElement = function (argprops) {
    for (let i1 = 0; i1 < this.voData.seriesLength; i1++) {
        if (i1 == 0) {
            remaingArea = this.parent.clientWidth;
        }
        let value = this.data.values[i1][0];
        let viewArea = this.parent.clientWidth / this.voData.totalValue;
        let graphicArea = viewArea * value > this.parent.clientHeight ? this.parent.clientHeight : viewArea * value;
        remaingArea += graphicArea / 2;
    }
    // let seriesWidth = (((this.state.width/2)*(this.voData.seriesLength-1))/this.voData.seriesLength)+this.state.width;
    let viewSeriesArea = remaingArea / this.voData.totalValue;
    let numValue = this.data.values[this.index][0];
    viewSeriesArea = viewSeriesArea * numValue > this.parent.clientHeight ? this.parent.clientHeight : viewSeriesArea * numValue;
    viewSeriesArea = viewSeriesArea < 110 ? 110 : viewSeriesArea;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    let seriesWidth = this.state.width;
    let moveX = this.viewport.x;
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = viewSeriesArea + "px";
    element.style.position = "absolute";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    let parentWidth;
    if (this.index == 0) {
        previousWidth = 0;
    }

    if (this.index != 0) {
        if (this.data._directionenable) {
            element.style.right = backX + previousWidth / 2 + "px";
        } else {
            element.style.left = backX + previousWidth / 2 + "px";
        }
        backX += previousWidth / 2;
        previousWidth = viewSeriesArea > this.parent.clientHeight ? this.parent.clientHeight : viewSeriesArea;

        this.parent.style.position = "relative";
        this.parent.parentNode.style.justifyContent = "center";
    } else {
        previousWidth = viewSeriesArea > this.parent.clientHeight ? this.parent.clientHeight : viewSeriesArea;
    }
    if (this.index == 0) {
        backX = 0;
    }

    if (this.parent) this.parent.appendChild(element);
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }

    ///boolMax
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
    subelement.style.width = 100 + "%";
    subelement.style.order = 2;
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
        let graphicHeight = seriesItem.parent.querySelector(".graphicconatiner").clientHeight * 0.8 < 110 ? 110 : seriesItem.parent.querySelector(".graphicconatiner").clientHeight * 0.8;
        element.style.width = graphicHeight + "px";
        if (this.index != 0) {
            let overlap = graphicHeight / 2 < secondarypreviousWidth / 2;
            let moveX = secondarypreviousWidth / 2;
            // if (overlap) {
            //     moveX = secondarypreviousWidth * 0.6;
            // }
            if (this.data._directionenable) {
                element.style.right = secondarybackX + moveX + "px";
            } else {
                element.style.left = secondarybackX + moveX + "px";
            }
            secondarybackX += moveX;
            secondaryRemaingArea += graphicHeight / 2;
        } else {
            secondaryRemaingArea = graphicHeight;
            secondarybackX = 0;
        }
        secondarypreviousWidth = graphicHeight;
        if (this.index == this.voData.seriesLength - 1) {
            element.parentNode.style.width = secondaryRemaingArea + "px";
        }
    }
};
SimpleOverlapComparisonSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleOverlapComparisonSeriesItem"](argparent, argprops);
};


// let objValue;
// let labelMaxW = 230;
// let labeMaxH = 90;
// let valueMaxW = 0;
// let valueMaxH = 0;
// let graphicH = 0;
// let padding = 8;
// let bkelement;
// let bkSubElement;
// let middleelementValue;
// let middleelementLabel;
// let middleelementPlaceholder;
function SimpleOverlapComparisonSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleOverlapComparisonSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleOverlapComparisonSeriesItem.prototype.constructor = SimpleOverlapComparisonSeriesItem;



SimpleOverlapComparisonSeriesItem.prototype.updateBasicData = function () {
    BaseColumnSeriesItem.prototype.updateBasicData.call(this);
    // if(this.data.chartName=="barFXGHandVerticalChart"){
    //     this.asset = this.data.asset.data[ChartUtils.getFactorIndex(this.groupindex, 4)].data;
    //     this.assetName = this.data.asset.name;
    // }else {
    this.asset = this.data.asset.data[0].data;
    this.assetName = this.data.asset.name;
    // }
}

SimpleOverlapComparisonSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, centerAlign = false) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.4 : this.labelMaxW * 0.4;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - ((this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)))
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    let maxValue = argprops.maxvalue;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / maxValue) < 0.2 ? 0.2 : baseGraphicHeightPercentage * (argprops.value / maxValue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgFillDetails(styleIndex,this.data.ChartFonts.graphicFillColor(styleIndex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicFillColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : graphicHeightPercentage * 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic moodanimation transformOrginBottom " + clsStyle;
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.dataset.animation = "item";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    // if (this.style.bgFillType == "gradient") {
    //     graphicElement.style.backgroundImage = this.data.layout.itemGradientValues?this.data.layout.itemGradientValues:"";
    // }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);

    clsStyle =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true
            ? this.setNoEmphasis(graphicElement, clsStyle, groupindex)
            : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                ? this.setHasEmphasis(graphicElement, clsStyle, groupindex)
                : clsStyle;



    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
        graphicElement.dataset.customorgin = "bottom";
    }

    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") {
        graphicElement.classList.add("clsNodeTertiarybg");
        graphicElement.style.boxShadow = "";

    }


    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = (graphicH*0.6)< this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) + 8;
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.top = "unset";
        sameElement.style.bottom = "0";
        sameElement.style.height = "80%";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "60%";
        if (this.groupindex == this.voData.seriesLength - 1) {
            sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

        }
        if (booloverLap) {
            let previousSeriesGroup = this.parent.parentNode.parentNode.querySelectorAll(".series");
            let previousseries = this.groupindex!=0?previousSeriesGroup[this.groupindex-1]:previousSeriesGroup[0];
            let preSameElement = previousseries.querySelector(".sameelement");
            if(preSameElement)preSameElement.style.width = "100%"
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.parentNode.appendChild(sameElement);
            sameElement.style.position="relative";
            sameElement.style.justifyContent="flex-end";
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%"
            })
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

        } else {
            subelement.appendChild(sameElement)
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.labelMaxW = sameElement.clientWidth * 0.6
            if (this.groupindex == this.voData.seriesLength - 1) {
                this.labelMaxW = sameElement.clientWidth * 0.5
            }
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor :  this.getColorDetails(groupindex,this.ChartFonts.valueInnerColor, this.data.layout.valueColor, "color");
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.valueMaxW = sameElement.clientWidth * 0.5
            if (this.groupindex == this.voData.seriesLength - 1) {
                this.valueMaxW = sameElement.clientWidth * 0.5
            }
            if (booloverLap) {
                this.valueStyle = this.ChartFonts.graphicColor(argprops.gindex);
            }
            this.doAddTopValue(sameElement, argprops);
            if(sameElement.querySelector(".value")&&sameElement.querySelector(".value").style.display=="none"){
                sameElement.querySelector(".value").style.display="block"
            }
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

            if (graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement)
                overlapParentDiv.appendChild(labelElement)
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%"
                })
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

                subelement.style.width = "50%"
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if (
            (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") ||
            graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)
        ) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv)
                subelement.parentNode.appendChild(label[0])
                overlapParentDiv.appendChild(subelement)
                overlapParentDiv.appendChild(valueElement)
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%"
                })
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%"
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
            if(valueElement.querySelector(".value")&&valueElement.querySelector(".value").style.display=="none"){
                valueElement.querySelector(".value").style.display="block"
            }
        } else if ((this.valueAlignment.position == "outer" || graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                        ? this.ChartFonts.graphicColor(styleIndex)
                        : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") {
                (this.valueAlignment.position == "inner") ? this.doAddTopValue(element, argprops) : this.doAddTopValue(argparent, argprops);
            }
            else {
                this.doAddTopValue(element, argprops);
                if(element.querySelector(".value")&&element.querySelector(".value").style.display=="none"){
                    element.querySelector(".value").style.display="block"
                }
            }
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.valueMaxH) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "50%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.valueMaxH)) {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops);
        }
    }
    bkelement = element;
    bkSubElement = subelement;
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);
    this.createGraphicsShape(graphicElement, argprops);
}

SimpleOverlapComparisonSeriesItem.prototype.createGraphicsShape = function (argparent, argprops, bottomelement = false) {
    let intGraphicsWidth = this.data._customProperties.showMergeItems ? argparent.getAttribute("data-width") : argparent.clientWidth;
    let intGraphicsHeight = argparent.clientHeight; //argparent.getAttribute("data-height");
    ///
    let svgAsset
    if (!this.asset) {
        if(this.data.slideObj.querySelector("#series-" + argprops.gindex)){
            svgAsset = this.data.slideObj.querySelector("#series-" + argprops.gindex).querySelector("#container").children[0].children[0].children[0]
        }else{
            svgAsset = this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0]
        }
    } else {
        svgAsset = this.asset.cloneNode(true);
    }

    if(svgAsset.getAttribute("viewBox")){
        let viewBoxValue = svgAsset.getAttribute("viewBox");
        svgAsset.setAttribute("viewBoxDefault",viewBoxValue);
        svgAsset.removeAttribute("viewBox")
    }
    let arrViewBox = svgAsset.getAttribute("viewBoxDefault")?svgAsset.getAttribute("viewBoxDefault").split(" "):svgAsset.getAttribute("viewboxdefault").split(" ");
    let numProportionateScale = intGraphicsWidth / arrViewBox[2] < intGraphicsHeight / arrViewBox[3] ? intGraphicsWidth / arrViewBox[2] : intGraphicsHeight / arrViewBox[3];
    let numContainerProportionateScale = 100 / (numProportionateScale * 100);
    let itemMinSize = (parseInt(arrViewBox[3] * numProportionateScale));
    if (bottomelement) itemMinSize = (parseInt(arrViewBox[3] * numProportionateScale));
    let minSize = arrViewBox[3] * (100 / intGraphicsHeight);

    let clstyle =
        this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true
            ? "secondary-fill"
            : this.data.hasEmphasis && this.data.emphasis[argprops.gindex] == true
                ? "clsAccentfill"
                : this.data.ChartFonts.appendgraphicFillColor(argprops.gindex);

    let svgGraphicMaskContainer = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
        id: "graphicmask-container",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        style: "overflow:unset !important",
    });
    argparent.appendChild(svgGraphicMaskContainer);


    let svgMaskContainer = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgMaskContainer, {
        id: "mask-container",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        style: "overflow:unset !important",
        mask: "url(#" + this.data.slideID + "mask-column:" + argprops.gindex + "_" + argprops.index + ")",
    });
    svgGraphicMaskContainer.appendChild(svgMaskContainer);




    let svgContainer = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgContainer, { id: "container", x: "0%", y: "0%", style: "overflow:unset !important" });
    svgMaskContainer.appendChild(svgContainer);
    if (this.data.projection[argprops.gindex] == true && this.data.hasProjection) {
        this.createProjection(svgContainer, argprops);
    }
    let svgparetGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgparetGroup, {
        // "data-animation": "columnshape",
        // class: "moodanimation transformOrginBottom",
    });

    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    svgContainer.appendChild(svgparetGroup);
    svgparetGroup.appendChild(svgGroup);
    ///
    svgGroup.appendChild(svgAsset);
    ///
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgAsset, svgContainer, true, false)
    }
    this.data.SVGUtils.assignAttributes(svgGroup, {
        transform: "scale(" + numProportionateScale + "," + numProportionateScale + ")",
    });
    argparent.parentNode.style.height = itemMinSize + "px"
    // this.data.SVGUtils.assignAttributes(argparent.parentNode, {
    //     height: ,
    // });
    this.data.SVGUtils.assignAttributes(svgAsset, {
        style: "overflow:unset !important"
    });
}
SimpleOverlapComparisonSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.width = this.valueMaxW + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if(this.data.layout.valuePaddingClass){
        element.classList.add(this.data.layout.valuePaddingClass)
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }

    if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
        this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex)//"accent" + (this.groupindex + 1) + "-color";
    }
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;
    
    let hasInnerValue = this.data.layout.valueInset=="inside"
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor,this.valueStyle,subelement,"value",hasInnerValue)
    this.checkMoodLevelColorvalue(this.data.layout.valueColor,subelement,"value","color",null,hasInnerValue)
    let colorTabValueCustomClass = this.valueStyle=="dummeycolor"?"":this.data.clsValueTextColor;

    subelement.className = "valuetext "+colorTabValueCustomClass+" moodanimation " + this.valueStyle + " "+this.data.ChartFonts.valueThemeClassName;;
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (boolenablePer&&this.data.displayValueFormat!="number") {
        subelement.innerText = parseFloat(argprops.valuetext) + "%";
    }
    if ((this.data.layout.valueInset == "inside" || this.data.layout.valueInset == "middle") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext  moodanimation " + this.valueStyle + " "+this.data.ChartFonts.valueThemeClassName;
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding ="10px";
        this.valuebgProperties(subelement)
    }
    if(this.valueStyle=="textgradient"){
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important")
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if(this.data.layout.valueShadowClass)subelement.classList.add(this.data.layout.valueShadowClass)
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);


    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex])
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));

            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsSecondaryTextColor")
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex))
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if(this.data.valueTextColor[this.groupindex][this.index]){
        subelement.style.setProperty("color",this.data.valueTextColor[this.groupindex][this.index],"important")
    }
    this.calculateMaxFonsize(subelement,boolmax,this.maxValueFontSize[this.arrIndex])
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    subelement.style.lineHeight = ""
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"]
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping()
        }
        else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid()
            }
        }
    } else {
        this.ChartUtils.createSpanFormat(subelement,this.data);
        fontsize = window.getComputedStyle(subelement)["font-size"]
        if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
            element.style.display = "none"
        }
        if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
            if (this.data.suffixStyle) {
                let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
                if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
            }
            if (this.data.prefixStyle) {
                let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
                if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
            }
        }
    }
}



"use strict";
function Simple3DBarChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleBarChart";
    BaseBarChart.call(this, argparent, argprops);
}
Simple3DBarChart.prototype = Object.create(BaseBarChart.prototype);
Simple3DBarChart.prototype.constructor = Simple3DBarChart;

Simple3DBarChart.prototype.seriesInstance = function(argparent, argprops) {
    return new window["Simple3DBarSeries"](argparent, argprops);
}

function Simple3DBarSeries(argparent, argprops){
    this.name = "SimpleBarSeries";
    BaseBarSeries.call(this, argparent, argprops);
    this.svgAsset =true;
}
Simple3DBarSeries.prototype = Object.create(BaseBarSeries.prototype);
Simple3DBarSeries.prototype.constructor = Simple3DBarSeries;

Simple3DBarSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new window["Simple3DBarSeriesItem"](argparent, argprops);
}
function Simple3DBarSeriesItem(argparent, argprops) {
    this.name = "Simple3DBarSeriesItem";
    this.groupindex = argprops.groupindex;
    BaseBarSeriesItem.call(this, argparent, argprops);
}
Simple3DBarSeriesItem.prototype = Object.create(BaseBarSeriesItem.prototype);
Simple3DBarSeriesItem.prototype.constructor = Simple3DBarSeriesItem;

Simple3DBarSeriesItem.prototype.doAddRightGraphicsContainer = function (argparent, argprops) {
    BaseBarSeriesItem.prototype.doAddRightGraphicsContainer.call(this,argparent, argprops)
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const element = argparent.getElementsByClassName("chartgraphic")[0];
    element.className = "chartgraphic  moodanimation transformOrginLeft";
    element.dataset.customorgin = "left";
    element.dataset.animation = "realbar"
    element.style.overflow = "hidden";
    element.style.boxShadow = "unset";
    element.style.width = "100%";
    let width = (element.clientWidth)>parseFloat(element.dataset.graphicwidth)?parseFloat(element.dataset.graphicwidth):element.clientWidth;
    element.dataset.widthValue = width;       
    let moveX = Math.round(10);
    width = width - moveX;
    let height = element.clientHeight + Math.round(element.clientHeight * 0.07);
    let intY = Math.round(height * 0.1) + Math.round(element.clientHeight * 0.07);
    let moveY = 0;
    let sideopacity = 0.8;
    let topopacity = 0.5;
    element.dataset.movey = moveX;
   ///DropShadow
   if(this.data.layout.itemShadow&&this.data.chartName != "barStackedRectangle"){
    element.classList.add(this.data.layout.itemShadow);
    }
    if(this.data.layout.itemOpacityClass){
        element.style.opacity = this.data.layout.itemOpacity;
        element.dataset.customopacity = this.data.layout.itemOpacity;
    }
    let clstyle =
    this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true
        ? "clsTertiaryFill"
        : this.data.hasEmphasis && this.data.emphasis[this.groupindex] == true
            ? this.ChartFonts.appendgraphicFillColor(this.groupindex)//"accent" + (this.groupindex + 1) + "-fill"
            : this.getBgFillDetails(this.groupindex,this.ChartFonts.appendgraphicFillColor(this.groupindex),this.data.layout.itemColor,"bgcolor");


    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: element.clientHeight,
    });
    element.appendChild(svgElement);

    let groupElement = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElement, {
        // fill: "#a367dc",
        // stroke: "#c767dc",
        // "fill-opacity": 1,
        // "stroke-opacity": 1,
        transform: "translate(0,0)",
        style: "outline:none",
    });
    svgElement.appendChild(groupElement);

    let groupElement_1 = this.data.SVGUtils.createSVGElement("g");
    groupElement.appendChild(groupElement_1);

    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     clstyle = " clsTertiaryFill";
    // }

    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
    //     clstyle += " prjectionOpacity";
    // }
    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (6) + "-fill";
    // }
    // if (this.data.projection[this.groupindex] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (1) + "-fill";
    // }

    let groupElement_2 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElement_2, {
        class: clstyle+" chartMainGraphic",
        // fill: "#67b7dc",
        stroke: "#ffffff",
        "stroke-opacity": 0.2,
    });
    groupElement_1.appendChild(groupElement_2);

    let groupElement_3 = this.data.SVGUtils.createSVGElement("g");
    groupElement_2.appendChild(groupElement_3);

 

    let groupElementPath_4 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_4, {
        class: clstyle+" chartMainGraphic",
        "fill-opacity": sideopacity,
        // fill: "#5292b0",
    });
    groupElement_3.appendChild(groupElementPath_4);
    let pathElement_4 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_4, {
        d: "M" + width + "," + intY + "L" + (width + moveX) + "," + moveY + "L" + (width + moveX) + "," + (height - intY * 2 + moveY) + "L" + width + "," + (height - 2) + " Z",
        // d: "M" + width + ",0" + "L" + (width + moveX) + "," + moveY + "L" + (width + moveX) + "," + (height + moveY) + "L" + width + "," + height + " Z",
    });
    groupElementPath_4.appendChild(pathElement_4);
    // M104.253,0  L130.2338,-15  L130.2338,51  L104.253,66  Z

    let groupElementPath_5 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_5, {
        class: clstyle+" chartMainGraphic",
        opacity: topopacity,
        // fill: "#5da5c6",
    });
    groupElement_3.appendChild(groupElementPath_5);
    let pathElement_5 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_5, {
        d: "M0" + "," + intY + "L" + moveX + "," + moveY + "L" + (width + moveX) + "," + moveY + "L" + width + "," + intY + " Z",
        // d: "M0,0" + "L" + moveX + "," + moveY + "L" + (width + moveX) + "," + moveY + "L" + width + ",0" + " Z",
    });
    groupElementPath_5.appendChild(pathElement_5);
    // M0,0  L25.9808,-15  L130.2338,-15  L104.253,0  Z

    let groupElementPath_6 = this.data.SVGUtils.createSVGElement("g");
    groupElement_3.appendChild(groupElementPath_6);
    let pathElement_6 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_6, {
        d: "M0" + "," + intY + "L" + width + "," + intY + "L" + width + "," + (height - 2) + "L0," + (height - 2) + " Z",
        //"M0,0" + "L" + width + "," + "0" + "L" + width + "," + height + "L0," + height + " Z",
    });
    // M0,0  L104.253,0  L104.253,66  L0,66  Z
    groupElementPath_6.appendChild(pathElement_6);

}

