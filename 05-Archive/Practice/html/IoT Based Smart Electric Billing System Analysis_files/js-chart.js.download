BaseSeriesItem.prototype.bgProperties = function (element) {
    if (this.data.layout.placeHolderShapeType == "circle") {
        element.style.borderRadius = "50%"
    }

    if (this.data.layout.placHolderStyle == "border") {
        if (this.data.layout.placHolderBorderSize) {
            element.style.border = this.data.layout.placHolderBorderSize + "px solid";
            element.style.setProperty("--border-width", this.data.layout.placHolderBorderSize + "px", "");
        } else {
            element.style.setProperty("--border-width", "2px", "");
            element.style.border = "2px solid"
        }

        let strBordeClass = this.getBgColorDetails(this.groupindex, this.data.ChartFonts.appendgraphicBorderColor(this.groupindex), this.data.layout.placHolderBorderColor, "bordercolor")
        if (this.data.layout.placHolderBorderColor == "gradient") {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                element.classList.add("bordergradient");
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                if (this.data.layout.placHolderborderOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBordeClass, this.index, this.data.layout.placHolderborderOpacity);
                    element.style.borderColor = rgbavalue;
                } else {
                    element.classList.add(strBordeClass)
                }
            }
        }
    }
    if (this.data.layout.placHolderBgColor) {
        let strBgClass = this.getBgColorDetails(this.groupindex, "clsNodeTertiarybg", this.data.layout.placHolderBgColor, "bgcolor")
        if (this.data.layout.placHolderBgColor == "gradient") {
            if ((this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                element.classList.add("gradient")
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                if (this.data.layout.placHolderbgOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBgClass, this.groupindex, this.data.layout.placHolderbgOpacity);
                    element.style.background = rgbavalue;
                } else {
                    element.classList.add(strBgClass)
                }
            }
        }
    }
    if (this.data.layout.placeHolderRadius) {
        let borderRadiuslefttop = this.data.layout.placeHolderRadius && this.data.layout.placeHolderRadius.length > 0 ? this.data.layout.placeHolderRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.placeHolderRadius && this.data.layout.placeHolderRadius.length > 1 ? this.data.layout.placeHolderRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.placeHolderRadius && this.data.layout.placeHolderRadius.length > 2 ? this.data.layout.placeHolderRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.placeHolderRadius && this.data.layout.placeHolderRadius.length > 3 ? this.data.layout.placeHolderRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
}
BaseSeriesItem.prototype.setBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--cutomNodeBorderWidthPercent");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".iconHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
}
BaseSeriesItem.prototype.setImageBorderWidth = function (baseelement) {
    let percentValue = window.getComputedStyle(baseelement).getPropertyValue("--customNodeBorderImageWidth");
    percentValue = isNaN(parseInt(percentValue)) ? 4 : parseInt(percentValue);
    let sourceNode = baseelement.querySelector(".imageHolder");
    if (sourceNode) baseelement.style.setProperty("--customNodeBorderImageWidth", (sourceNode.offsetWidth / 100) * percentValue + "px");
}
BaseSeriesItem.prototype.itemSvgShapeProperties = function (element, seriesIndex, groupindex) {

    if (this.data.layout.itemShapeStyle == "border") {
        let borderSize = this.data.layout.itemShapeBorderSize ? this.data.layout.itemShapeBorderSize : "2"
        element.style.strokeWidth = borderSize
        if (this.data.layout.itemShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryStroke")
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex))
            }
        } else {
            if (this.data.layout.itemShapeBorderColor == "tertiary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("clsTertiaryStroke")
                }
            } else if (this.data.layout.itemShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("secondary-stroke")
                }
            } else if (this.data.layout.itemShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("secondary-stroke")
                }
            } else if (this.data.layout.itemShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    this.addGradient(element, element, element.parentNode, false, true);
                }
            }
            else {
                element.classList.add("clsTertiaryStroke")
            }

        }
    }
    if (this.data.layout.itemShapeBgColor) {
        if (this.data.layout.itemShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryFill")
                if (this.data.layout.itemShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itemShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.itemShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itemShapebgOpacity, "important");

                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex))
                }
            }
        } else {
            if (this.data.layout.itemShapeBgColor == "tertiary") {
                if (this.data.layout.itemShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itemShapebgOpacity, "important");
                } else {
                    element.classList.add("clsTertiaryFill");
                }
            } else {
                if (this.data.layout.itemShapeBgColor == "secondary") {
                    if (this.data.layout.itemShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.itemShapebgOpacity, "important");
                    } else {
                        element.classList.add("secondary-fill");
                    }
                } else {
                    if (this.data.layout.itemShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true);
                    } else if (this.data.layout.itemShapeBgColor == "bgcolor") {
                        if (this.data.layout.itemShapebgOpacity) {
                            element.style.setProperty("fill-opacity", this.data.layout.itemShapebgOpacity, "important");
                        } else {
                            element.classList.add("fillbgColor");
                        }
                    }
                }
            }
        }
    }
    // if (this.data.layout.itemshapeRadius) {
    //     let borderRadiuslefttop = this.data.layout.itemshapeRadius && this.data.layout.itemshapeRadius.length > 0 ? this.data.layout.itemshapeRadius[0] + "px" : 0 + "px";
    //     let borderRadiusLeftBottom = this.data.layout.itemshapeRadius && this.data.layout.itemshapeRadius.length > 1 ? this.data.layout.itemshapeRadius[1] + "px" : 0 + "px";
    //     let borderRadiusRightTop = this.data.layout.itemshapeRadius && this.data.layout.itemshapeRadius.length > 2 ? this.data.layout.itemshapeRadius[2] + "px" : 0 + "px";
    //     let borderRadiusRightBottom = this.data.layout.itemshapeRadius && this.data.layout.itemshapeRadius.length > 3 ? this.data.layout.itemshapeRadius[3] + "px" : 0 + "px";
    //     element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    // }
}
BaseSeriesItem.prototype.itemSvgBgShapeProperties = function (element, seriesIndex, groupindex) {

    if (this.data.layout.backgroundShapeStyle == "border") {
        let borderSize = this.data.layout.backgroundShapeBorderSize ? this.data.layout.backgroundShapeBorderSize : "2"
        element.style.strokeWidth = borderSize
        if (this.data.layout.backgroundShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryStroke")
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex))
            }
        } else {
            if (this.data.layout.backgroundShapeBorderColor == "tertiary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("clsTertiaryStroke")
                }
            } else if (this.data.layout.backgroundShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("secondary-stroke")
                }
            } else if (this.data.layout.backgroundShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    element.classList.add("secondary-stroke")
                }
            } else if (this.data.layout.backgroundShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    element.classList.add("clsTertiaryStroke")
                } else {
                    this.addGradient(element, element, element.parentNode, false, true);
                }
            }
            else {
                element.classList.add("clsTertiaryStroke")
            }

        }
    }
    if (this.data.layout.backgroundShapeBgColor) {
        if (this.data.layout.backgroundShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryFill")
                if (this.data.layout.backgroundShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.backgroundShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.backgroundShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.backgroundShapebgOpacity, "important");

                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex))
                }
            }
        } else {
            if (this.data.layout.backgroundShapeBgColor == "tertiary") {
                if (this.data.layout.backgroundShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.backgroundShapebgOpacity, "important");
                } else {
                    element.classList.add("clsTertiaryFill");
                }
            } else {
                if (this.data.layout.backgroundShapeBgColor == "secondary") {
                    if (this.data.layout.backgroundShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.backgroundShapebgOpacity, "important");
                    } else {
                        element.classList.add("secondary-fill");
                    }
                } else {
                    if (this.data.layout.backgroundShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true);
                    } else if (this.data.layout.backgroundShapeBgColor == "bgcolor") {
                        if (this.data.layout.backgroundShapebgOpacity) {
                            element.style.setProperty("fill-opacity", this.data.layout.backgroundShapebgOpacity, "important");
                        } else {
                            element.classList.add("fillbgColor");
                        }
                    }
                }
            }
        }
    }
    // if (this.data.layout.backgroundShapeRadius) {
    //     let borderRadiuslefttop = this.data.layout.backgroundShapeRadius && this.data.layout.backgroundShapeRadius.length > 0 ? this.data.layout.backgroundShapeRadius[0] + "px" : 0 + "px";
    //     let borderRadiusLeftBottom = this.data.layout.backgroundShapeRadius && this.data.layout.backgroundShapeRadius.length > 1 ? this.data.layout.backgroundShapeRadius[1] + "px" : 0 + "px";
    //     let borderRadiusRightTop = this.data.layout.backgroundShapeRadius && this.data.layout.backgroundShapeRadius.length > 2 ? this.data.layout.backgroundShapeRadius[2] + "px" : 0 + "px";
    //     let borderRadiusRightBottom = this.data.layout.backgroundShapeRadius && this.data.layout.backgroundShapeRadius.length > 3 ? this.data.layout.backgroundShapeRadius[3] + "px" : 0 + "px";
    //     element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    // }
}
BaseSeriesItem.prototype.getBgClassList = function (element) {
    let ementClassList = element.classList
    let ClassValue;
    for (let c1 = 0; c1 < ementClassList.length; c1++) {
        let Class = ementClassList[c1]
        if (Class == "clsNodeTertiarybg" ||Class == "clsQuaternaryBg"|| Class.includes("Accent") || Class.includes("secondary-bg-color") || Class.includes("itembgColor")) {
            ClassValue = Class
        }
    }
    return ClassValue;

}
BaseSeriesItem.prototype.createStatistacalContainer = function (element, mesurment = false) {
    if (this.data.showStatistical) {
        let themeClassName = "h1"
        // if (this.ChartFonts && this.ChartFonts.projectiontext) {
        //     themeClassName = this.ChartFonts.projectiontext;
        // }
        let statisticalContainer = this.ChartHelper.createDivElement({});
        statisticalContainer.className = "statistcalelement moodanimation";
        statisticalContainer.setAttribute("data-animation", "statisticaltext");
        if (this.data.layout.statisticalPaddingClass) statisticalContainer.classList.add(this.data.layout.statisticalPaddingClass)
        element.appendChild(statisticalContainer);
        let arrowDiv = this.ChartHelper.createDivElement({});
        arrowDiv.className = "statisticalparentmark ";
        let arrowChild = this.ChartHelper.createDivElement({});
        arrowChild.className = "statisticalmark  " + this.statisticalArrowStyle;
        arrowChild.style.fontSize = this.data.layout.statisticalArrowfontsize + "px"
        arrowDiv.appendChild(arrowChild)
        statisticalContainer.appendChild(arrowDiv)
        this.doAddStasticalValue(statisticalContainer, mesurment);
        // let valueDiv = this.ChartHelper.createDivElement({});
        // valueDiv.className = "statisticalValue "+this.statisticalStyle+" "+themeClassName;
        // let valueElement = this.ChartHelper.createDivElement({});
        // valueElement.className = themeClassName;
        // valueElement.innerHTML = this.data.statisticalValues[this.groupindex];
        // valueDiv.appendChild(valueElement)
        // statisticalContainer.appendChild(valueDiv);
        // let fontSize = window.getComputedStyle(valueDiv)["font-size"]?parseFloat(window.getComputedStyle(valueDiv)["font-size"]):30;
        // this.ChartHelper.adjustFontSize(valueDiv, 20, 10, fontSize, true);
        // this.ChartHelper.adjustFontSizeWidth(valueDiv, 20, 10,fontSize);
        // if(this.data.layout.statisticalPaddingClass)valueDiv.classList.add(this.data.layout.statisticalPaddingClass)
        if (this.data.statisticalValues[this.groupindex] > 0) {
            if (!this.statisticalArrowStyle) arrowChild.classList.add("postivecolor");
            arrowChild.classList.add("positivearrow");
            statisticalContainer.setAttribute("data-graphic-y", 1)
        } else if (this.data.statisticalValues[this.groupindex] < 0) {
            if (!this.statisticalArrowStyle) arrowChild.classList.add("negativecolor");
            arrowChild.classList.add("negativearrow");
            statisticalContainer.setAttribute("data-graphic-y", -1)
        }
        if (this.groupindex == (this.data.seriesLength - 1)) this.checkMinWidth()
        if (mesurment) {
            this.statisticalWidth = statisticalContainer.clientWidth;
            statisticalContainer.remove();
        }
    }
}
BaseSeriesItem.prototype.doAddStasticalValue = function (argparent, mesurment = false) {
    let themeClassName = "n1"
    if (this.ChartFonts && this.ChartFonts.projectiontext) {
        themeClassName = this.ChartFonts.projectiontext;
    }
    const element = this.ChartHelper.createDivElement({});
    element.style.minWidth = 20 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.paddingLeft = "4px";
    element.style.fontSize = this.data.layout.statisticalfontsize + "px"
    element.className = "statisticalValue " + this.statisticalStyle + " " + themeClassName;
    const subelement = document.createElement("div");
    subelement.className = themeClassName;
    if (argparent) argparent.appendChild(element);
    else return element;
    element.appendChild(subelement);
    let fontSize = window.getComputedStyle(element)["font-size"] ? parseFloat(window.getComputedStyle(element)["font-size"]) : 30;
    subelement.innerHTML = mesurment ? this.data.statiSticalLongValue : this.data.statisticalValues[this.groupindex];;
    // subelement.style.fontSize =  fontSize+"px";
    subelement.setAttribute("maxFontSize", fontSize);
    subelement.style.fontSize = fontSize + "px";
    this.ChartHelper.adjustFontSize(subelement, 20, 10, fontSize, true);
    if (this.data.statisticalValues[this.groupindex] > 0) {
        element.className = "statisticalValue postivecolor";
    } else if (this.data.statisticalValues[this.groupindex] < 0) {
        element.className = "statisticalValue negativecolor";
    }
};
BaseSeriesItem.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize) {
    if (this.groupindex == (this.data.seriesLength - 1) && !boolmax && !this.data.promptText) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize)
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        if (!this.addvalue) this.data.data.removeAttribute("valuemaxfontsize")
    }
}
BaseSeriesItem.prototype.checkMinWidth = function () {
    let elementDiv = this.parent.parentNode.parentNode;
    let statisticalNodes = elementDiv.querySelectorAll(".statistcalelement");
    let maxWidth = 0;
    Array.from(statisticalNodes).forEach(function (item) {
        maxWidth = maxWidth < item.clientWidth ? item.clientWidth : maxWidth;
    })
    Array.from(statisticalNodes).forEach(function (item) {
        item.style.minWidth = maxWidth + "px"
    })
}
BaseSeriesItem.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {

    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
}
BaseSeriesItem.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {

    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle)
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
}
"use strict";
let gridvalueSize = 0;

function BaseBarChart(argparent, argprops) {
    this.ChartFonts = new window["ChartFonts"]();
    BaseChart.call(this, argparent, argprops);
    this.maxLabelW = 0;
    this.titleY = 0;
    this.titleHeight = 0;
}
BaseBarChart.prototype = Object.create(BaseChart.prototype);
BaseBarChart.prototype.constructor = BaseBarChart;

BaseBarChart.prototype.move = function (argx, argy) {
    try {
        this.state.x = argx;
        this.state.y = argy;
    } catch (error) {
        alert("error");
        // ErrorHandler.onListner(this, "move");
    }
};
BaseBarChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BaseBarSeries"](argParent, argProps);
};

BaseBarChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddAxisTitle();
            this.doAddGridValues();
            this.doAddGraphicDesk();
            this.doAddGridDesk();
            if (!this.voData.presentMode || this.voData._boolenaclebaseline) {
                this.doAddBaseLineDesk();
            }
            if (this.data.highlightDifference.display) {
                this.CreateHightlightDifference();
            }
            if (this.data.layout.assetname == "cigeratte") {
                this.createGraphicsImage();
            }
            if (this.data.indualHighlight && this.data.seriesItemLength < 2) this.createIndualHighlight();
            if (this.data.indualHighlight && this.data.seriesItemLength == 2) this.createTwoSeriesIndualHighlight();
            this.doAddMetaData();
            this.adjustChartTitlePosition();
        }
    }
};
BaseBarChart.prototype.createTwoSeriesIndualHighlight = function () {
    let element = document.createElement("div");
    element.className = "indualhighlightbasenode accent1 clsMultiColorParent";
    let ParentNode = this.parent.querySelector(".baseseries");
    let barContainer = this.parent.querySelector(".barContainer") ? this.parent.querySelector(".barContainer").children[0] : 0;
    element.style.height = barContainer.clientHeight + "px";
    element.style.top = this.parent.querySelector(".barContainer").offsetTop + barContainer.offsetTop + "px";
    element.style.left = "0px";
    ParentNode.appendChild(element);
    for (let i1 = 0; i1 < this.data.seriesLength; i1++) {
        let FirstPoint = i1;
        let secondPoint = i1;
        let firstPointValue = this.data.values[FirstPoint][0];
        let secondPointValue = this.data.values[secondPoint][1];
        let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
        this.createtwoseriesHighlightNode(element, FirstPoint, secondPoint, firstValueHigh, i1, this.data.seriesLength);
    }
};
BaseBarChart.prototype.createtwoseriesHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let arrseries = this.parent.querySelectorAll(".series");
    let seriesItemElement = arrseries[index] ? arrseries[index].querySelectorAll(".baseseriesitem") : [];
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][1], index);
    let firstSeriesItem = seriesItemElement.length > 0 ? seriesItemElement[0] : "";
    let secondSeriesItem = seriesItemElement.length > 1 ? seriesItemElement[1] : "";
    let hasfirstValueHigh = parseFloat(this.data.values[FirstPoint][0]) > parseFloat(this.data.values[secondPoint][1]);
    let drawDatas = this.getDrawDatas(firstSeriesItem, secondSeriesItem, arrseries[index], hasfirstValueHigh, index);
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + drawDatas.x1 + "," + drawDatas.y1 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x4 + "," + drawDatas.y4;
    let secondaryPath = "M" + drawDatas.x4 + "," + drawDatas.y4 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x1 + "," + drawDatas.y1;
    if (this.data.HighlightArrowState == "start") {
        strPath = "M" + drawDatas.x4 + "," + drawDatas.y4 + " L" + drawDatas.x3 + "," + drawDatas.y3 + " L" + drawDatas.x2 + "," + drawDatas.y2 + " L" + drawDatas.x1 + "," + drawDatas.y1;
    }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "tertiary-stroke  moodanimation hdline",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode);
    arrowHead.style.offsetPath = "path('" + strPath + "')";
    arrowHead.style.offsetDistance = "100%";
    arrowHead.classList.add("moodanimation");
    arrowHead.classList.add("arrowhead");
    arrowHead.dataset.animation = "indualhdarrowhead";
    if (this.data.HighlightArrowState == "both") {
        let arrowHead1 = this.createArrowHeader(svgNode);
        arrowHead1.style.offsetPath = "path('" + secondaryPath + "')";
        arrowHead1.style.offsetDistance = "100%";
        arrowHead1.classList.add("moodanimation");
        arrowHead1.classList.add("arrowhead");
        arrowHead1.dataset.animation = "indualhdarrowheadend";
    }
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");

        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    let calloutWidth = 0;
    let calloutHeight = 0;
    if (drawDatas.drawType == "type2") {
        callout.style.maxWidth = drawDatas.calloutMaxWidth + "px";
        callout.style.maxHeight = "60px";
        calloutWidth = callout.clientWidth;
        calloutHeight = callout.clientHeight;
        callout.style.top = drawDatas.y3 - calloutHeight / 2 + "px";
        callout.style.left = drawDatas.x1 + (drawDatas.x4 - drawDatas.x1 - calloutWidth) / 2 + "px";
    } else {
        callout.style.maxHeight = (drawDatas.x3 - drawDatas.y2) * 0.8 + "px";
        calloutWidth = callout.clientWidth;
        calloutHeight = callout.clientHeight;
        callout.style.top = drawDatas.y3 > drawDatas.y2 ? drawDatas.y2 + (drawDatas.y3 - drawDatas.y2 - calloutHeight) / 2 + "px" : drawDatas.y2 + (drawDatas.y2 - drawDatas.y3 - calloutHeight) / 2 + "px";
        callout.style.left = drawDatas.x3 - calloutWidth / 2 + "px";
    }
};
BaseBarChart.prototype.getDrawDatas = function (firstSeriesItem, secondSeriesItem, series, firstValueHigh, index) {
    let firstGraphicNode = firstSeriesItem.querySelector(".graphicconatiner");
    let firstValueNode = firstSeriesItem.querySelector(".value");
    let FirstValueWidth = 0;
    let firstGraphicWidth = 0;
    let elementgap = 5;
    let arrowGap = 5;
    if (series) series.style.position = "relative";
    if (this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top" && firstValueNode && firstValueNode.style.display != "none") {
        FirstValueWidth = firstValueNode.clientWidth;
    }
    if (firstGraphicNode) firstGraphicWidth = firstGraphicNode.clientWidth;
    let firstTotalWidth = firstGraphicWidth + FirstValueWidth;

    let secondGraphicNode = secondSeriesItem.querySelector(".graphicconatiner");
    let secondValueNode = secondSeriesItem.querySelector(".value");
    let SecondValueWidth = 0;
    let secondGraphicWidth = 0;
    if (this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top" && secondValueNode && secondValueNode.style.display != "none") {
        SecondValueWidth = secondValueNode.clientWidth;
    }
    if (secondGraphicNode) secondGraphicWidth = secondGraphicNode.clientWidth;
    let SecondTotalWidth = secondGraphicWidth + SecondValueWidth;
    let DifferenceWidth = SecondTotalWidth > firstTotalWidth ? SecondTotalWidth - firstTotalWidth - SecondValueWidth : firstTotalWidth - SecondTotalWidth - SecondValueWidth;
    let lowValue = SecondTotalWidth < firstTotalWidth ? SecondTotalWidth : firstTotalWidth;
    let type = DifferenceWidth < 60 ? "type1" : "type2";
    if (type == "type2") {
        let startValue = secondSeriesItem.offsetLeft + secondSeriesItem.parentNode.offsetLeft + firstTotalWidth;
        if (SecondTotalWidth < firstTotalWidth) {
            startValue = secondSeriesItem.offsetLeft + secondSeriesItem.parentNode.offsetLeft + SecondTotalWidth;
        }
        let CurrentNode = firstTotalWidth > SecondTotalWidth ? secondSeriesItem : firstSeriesItem;
        let x1 = startValue + elementgap + arrowGap;
        let y1 = series.offsetTop + CurrentNode.offsetTop + firstGraphicNode.offsetTop + firstGraphicNode.clientHeight / 2;
        let x2 = x1;
        let y2 = y1;
        let x3 = x1;
        let y3 = y1;
        let x4 = startValue + DifferenceWidth - arrowGap;
        let y4 = y1;
        return { drawType: type, x1: x1, y1: y1, x2: x2, y2: y2, x3: x3, y3: y3, x4: x4, y4: y4, calloutMaxWidth: firstSeriesItem.clientWidth };
    } else {
        FirstPoint = 0;
        secondPoint = 1;
        let elementgap = 5;
        let grahicNodes = series.querySelectorAll(".chartgraphic");
        let valuNode = series.querySelectorAll(".value");
        let seriesElement = this.parent.querySelectorAll(".series");
        let seriesitemCondent = series.querySelectorAll(".baseseriesitem");
        let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint] : "";
        let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint] : "";
        let firstSeries = seriesElement.length > FirstPoint ? seriesElement[FirstPoint] : "";
        let secondSeries = seriesElement.length > secondPoint ? seriesElement[secondPoint] : "";
        let firstSeriesItemContent = seriesitemCondent.length > FirstPoint ? seriesitemCondent[FirstPoint] : "";
        let secondSeriesItemContent = seriesitemCondent.length > secondPoint ? seriesitemCondent[secondPoint] : "";
        let startValue = secondSeriesItem.offsetLeft + secondSeriesItem.parentNode.offsetLeft;

        let hasValue = false;
        if (this.data.layout.valueInset != "inside" && this.data.layout.valueHPosition == "right" && valuNode.length > 0 && valuNode[0].style.display != "none") {
            firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
            secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
            hasValue = true;
        }
        let X1 = 0;
        let Y1 = 0;
        let X2 = 0;
        let Y2 = 0;
        let X3 = 0;
        let Y3 = 0;
        let X4 = 0;
        let Y4 = 0;
        let firstSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? firstSeriesItemContent.offsetLeft : 0;
        let secondSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? secondSeriesItemContent.offsetLeft : 0;
        let fisrtNodeLeft = firstSeries.offsetLeft + firstSeriesItemContentLeft + firstargParentNode.offsetLeft;
        let fisrtNodeRight = firstargParentNode.offsetRight;
        let fisrtNodeWidth = firstargParentNode.clientWidth;
        let fisrtNodeTop = firstSeries.offsetTop;
        let fisrtNodeHeight = firstargParentNode.clientHeight;
        let secondNodeLeft = secondSeries.offsetLeft + secondSeriesItemContentLeft + secondtargParentNode.offsetLeft;
        let secondNodeRight = secondtargParentNode.offsetRight;
        let secondNodeWidth = secondtargParentNode.clientWidth;
        let secondNodeTop = secondSeries.offsetTop;
        let secondNodeHeight = secondtargParentNode.clientHeight;

        let topspace = 50;
        let padding = 5;
        let indualGap = 6;
        let firstGap = fisrtNodeHeight * 0.2 < indualGap ? fisrtNodeHeight * 0.5 + indualGap : fisrtNodeHeight * 0.6;
        let secondGap = secondNodeHeight * 0.2 < indualGap ? secondNodeHeight * 0.5 - indualGap : secondNodeHeight * 0.4;
        let firstNode = index == 0;
        let secondNode = index == length - 1;
        if (firstValueHigh && firstargParentNode && secondtargParentNode) {
            X1 = startValue + fisrtNodeLeft + fisrtNodeWidth + padding;
            Y1 = series.offsetTop + firstSeriesItem.offsetTop + firstGraphicNode.offsetTop + firstGraphicNode.clientHeight / 2;
            X2 = startValue + fisrtNodeLeft + fisrtNodeWidth + topspace;
            Y2 = Y1;
            X3 = startValue + fisrtNodeLeft + fisrtNodeWidth + topspace;
            Y3 = series.offsetTop + secondSeriesItem.offsetTop + secondGraphicNode.offsetTop + secondGraphicNode.clientHeight / 2;
            X4 = startValue + secondNodeLeft + secondNodeWidth + padding;
            Y4 = Y3;
        }
        if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
            X1 = startValue + fisrtNodeLeft + fisrtNodeWidth + padding;
            Y1 = series.offsetTop + firstSeriesItem.offsetTop + firstGraphicNode.offsetTop + firstGraphicNode.clientHeight / 2;
            X2 = startValue + secondNodeLeft + secondNodeWidth + topspace;
            Y2 = Y1;
            X3 = startValue + secondNodeLeft + secondNodeWidth + topspace;
            Y3 = series.offsetTop + secondSeriesItem.offsetTop + secondGraphicNode.offsetTop + secondGraphicNode.clientHeight / 2;
            X4 = startValue + secondNodeLeft + secondNodeWidth + padding;
            Y4 = Y3;
        }
        return { drawType: type, x1: X1, y1: Y1, x2: X2, y2: Y2, x3: X3, y3: Y3, x4: X4, y4: Y4 };
    }
};
BaseBarChart.prototype.createIndualHighlight = function () {
    let element = document.createElement("div");
    element.className = "indualhighlightbasenode accent1 clsMultiColorParent";
    let ParentNode = this.parent.querySelector(".baseseries");
    let barContainer = this.parent.querySelector(".barContainer") ? this.parent.querySelector(".barContainer").children[0] : 0;
    element.style.height = barContainer.clientHeight + "px";
    element.style.top = this.parent.querySelector(".barContainer").offsetTop + barContainer.offsetTop + "px";
    element.style.left = "0px";
    ParentNode.appendChild(element);
    for (let i1 = 0; i1 < this.data.seriesLength - 1; i1++) {
        let FirstPoint = i1;
        let secondPoint = i1 + 1;
        let firstPointValue = this.data.values[FirstPoint][0];
        let secondPointValue = this.data.values[secondPoint][0];
        let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
        this.createHighlightNode(element, FirstPoint, secondPoint, firstValueHigh, i1, this.data.seriesLength);
    }
};
BaseBarChart.prototype.createHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let grahicNodes = this.parent.querySelectorAll(".chartgraphic");
    let valuNode = this.parent.querySelectorAll(".value");
    let labelNode = this.parent.querySelectorAll(".labeltext");
    let seriesElement = this.parent.querySelectorAll(".series");
    let seriesitemCondent = this.parent.querySelectorAll(".seriesitemcond");
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][0], index);
    let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint] : "";
    let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint] : "";
    let firstSeries = seriesElement.length > FirstPoint ? seriesElement[FirstPoint] : "";
    let secondSeries = seriesElement.length > secondPoint ? seriesElement[secondPoint] : "";
    let firstSeriesItemContent = seriesitemCondent.length > FirstPoint ? seriesitemCondent[FirstPoint] : "";
    let secondSeriesItemContent = seriesitemCondent.length > secondPoint ? seriesitemCondent[secondPoint] : "";
    let hasValue = false;
    if (this.data.layout.valueInset != "inside" && this.data.layout.valueHPosition == "right" && valuNode.length > 0 && valuNode[0].style.display != "none" && valuNode[0].children[0].style.visibility != "hidden") {
        firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
        secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
        hasValue = true;
    } else {
        let firstLabelNode = labelNode.length > FirstPoint ? labelNode[FirstPoint] : firstargParentNode;
        let secondLabelNode = labelNode.length > secondPoint ? labelNode[secondPoint] : secondtargParentNode;
        if (firstLabelNode && firstLabelNode.dataset.overlaplabel == "true") {
            firstargParentNode = firstLabelNode.parentNode;
        }
        if (secondLabelNode && secondLabelNode.dataset.overlaplabel == "true") {
            secondtargParentNode = secondLabelNode.parentNode;
        }
    }

    let valueTop = 0;
    if (this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true") {
        valueTop = firstargParentNode.parentNode.offsetTop;
    }
    let X1 = 0;
    let Y1 = 0;
    let X2 = 0;
    let Y2 = 0;
    let X3 = 0;
    let Y3 = 0;
    let X4 = 0;
    let Y4 = 0;
    let firstSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? firstSeriesItemContent.offsetLeft : 0;
    let secondSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? secondSeriesItemContent.offsetLeft : 0;
    let fisrtNodeLeft = firstSeries.offsetLeft + firstSeriesItemContentLeft + firstargParentNode.offsetLeft;
    let fisrtNodeRight = firstargParentNode.offsetRight;
    let fisrtNodeWidth = firstargParentNode.clientWidth;
    let fisrtNodeTop = firstSeries.offsetTop + valueTop;
    let fisrtNodeHeight = firstargParentNode.clientHeight;
    let secondNodeLeft = secondSeries.offsetLeft + secondSeriesItemContentLeft + secondtargParentNode.offsetLeft;
    let secondNodeRight = secondtargParentNode.offsetRight;
    let secondNodeWidth = secondtargParentNode.clientWidth;
    let secondNodeTop = secondSeries.offsetTop + valueTop;
    let secondNodeHeight = secondtargParentNode.clientHeight;

    let topspace = 50;
    let padding = 5;
    let indualGap = 6;
    let firstGap = fisrtNodeHeight * 0.2 < indualGap ? fisrtNodeHeight * 0.5 + indualGap : fisrtNodeHeight * 0.6;
    let secondGap = secondNodeHeight * 0.2 < indualGap ? secondNodeHeight * 0.5 - indualGap : secondNodeHeight * 0.4;
    let firstNode = index == 0;
    let secondNode = index == length - 1;
    if (firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fisrtNodeLeft + fisrtNodeWidth + padding;
        Y1 = firstNode ? fisrtNodeHeight / 2 + valueTop : fisrtNodeTop + firstGap;
        X2 = fisrtNodeLeft + fisrtNodeWidth + topspace;
        Y2 = firstNode ? fisrtNodeHeight / 2 + valueTop : fisrtNodeTop + firstGap;
        X3 = fisrtNodeLeft + fisrtNodeWidth + topspace;
        Y3 = secondNode ? secondNodeTop + secondNodeHeight / 2 : secondNodeTop + secondGap;
        X4 = secondNodeLeft + secondNodeWidth + padding;
        Y4 = secondNode ? secondNodeTop + secondNodeHeight / 2 : secondNodeTop + secondGap;
    }
    if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fisrtNodeLeft + fisrtNodeWidth + padding;
        Y1 = firstNode ? fisrtNodeHeight / 2 : fisrtNodeTop + firstGap;
        X2 = secondNodeLeft + secondNodeWidth + topspace;
        Y2 = firstNode ? fisrtNodeHeight / 2 : fisrtNodeTop + firstGap;
        X3 = secondNodeLeft + secondNodeWidth + topspace;
        Y3 = secondNode ? secondNodeTop + secondNodeHeight / 2 : secondNodeTop + secondGap;
        X4 = secondNodeLeft + secondNodeWidth + padding;
        Y4 = secondNode ? secondNodeTop + secondNodeHeight / 2 : secondNodeTop + secondGap;
    }
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + X1 + "," + Y1 + " L" + X2 + "," + Y2 + " L" + X3 + "," + Y3 + " L" + X4 + "," + Y4;
    let secondaryPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    if (this.data.HighlightArrowState == "start") {
        strPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "tertiary-stroke  moodanimation hdline",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode);
    arrowHead.style.offsetPath = "path('" + strPath + "')";
    arrowHead.style.offsetDistance = "100%";
    arrowHead.classList.add("moodanimation");
    arrowHead.classList.add("arrowhead");
    arrowHead.dataset.animation = "indualhdarrowhead";
    if (this.data.HighlightArrowState == "both") {
        let arrowHead1 = this.createArrowHeader(svgNode);
        arrowHead1.style.offsetPath = "path('" + secondaryPath + "')";
        arrowHead1.style.offsetDistance = "100%";
        arrowHead1.classList.add("moodanimation");
        arrowHead1.classList.add("arrowhead");
        arrowHead1.dataset.animation = "indualhdarrowheadend";
    }
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");
        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    callout.style.maxHeight = (Y3 - Y2) * 0.8 + "px";
    let calloutWidth = callout.clientWidth;
    let calloutHeight = callout.clientHeight;
    callout.style.top = Y3 > Y2 ? Y2 + (Y3 - Y2 - calloutHeight) / 2 + "px" : Y2 + (Y2 - Y3 - calloutHeight) / 2 + "px";
    callout.style.left = X3 - calloutWidth / 2 + "px";
};
BaseBarChart.prototype.createArrowHeader = function (svgNode) {
    if (true) {
        let arrowHeader = "";
        let type = "arrow";
        switch (type) {
            case "arrow":
                arrowHeader = this.data.SVGUtils.createSVGElement("path");
                if (arrowHeader) svgNode.appendChild(arrowHeader);
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    d: "M0,0 L0,15 L10,7.5 z",
                    class: "tertiary-fill hdarrow",
                    "data-customorgin": "null",
                });
                arrowHeader.style.transform = "translate(-7.5px,-7.5px)";
                let bounds = this.getArrowBounds(arrowHeader);
                if (bounds) {
                    let strBounds = "M" + bounds.x1 + "," + bounds.y1 + " L" + bounds.x2 + "," + bounds.y2 + " L" + bounds.x3 + "," + bounds.y3;
                    this.data.SVGUtils.assignAttributes(arrowHeader, {
                        d: strBounds,
                        "data-customsmovey": bounds.y3,
                        "data-customsmovex": bounds.y3,
                        "data-customsmoveendy": bounds.y3,
                        "data-customsmoveendx": bounds.y3,
                    });
                    arrowHeader.style.transform = "translate(-" + bounds.y3 + "px,-" + bounds.y3 + "px)";
                }
                return arrowHeader;
                break;
            case "circle":
                arrowHeader = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    cx: "5",
                    cy: "5",
                    r: "10",
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translateY(-5px)";
                break;
            case "square":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 30,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translate(-15px,-15px)";
                break;
            case "rect":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 60,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translateY(-15px)";
                break;
            default:
                return null;
                break;
        }
    } else {
        if (this.data.layout.lineHeadShapeType == "svg") {
            for (let i1 = 0; i1 < this.data.asset.data.length; i1++) {
                if (this.data.asset.data[i1].id == "lineheadshape") {
                    let AssetGroup = this.data.SVGUtils.createSVGElement("g");
                    this.data.SVGUtils.assignAttributes(AssetGroup, {
                        id: "lineshape",
                        class: "clsAccentfill",
                    });
                    let svgAsset = "";
                    if (this.data.asset.data[i1].data) {
                        svgAsset = this.data.asset.data[i1].data.cloneNode(true);
                        AssetGroup.appendChild(svgAsset);
                    } else {
                        svgAsset = this.data.slideObj.querySelector("#lineshape") && this.data.slideObj.querySelector("#lineshape").children.length > 0 ? this.data.slideObj.querySelector("#lineshape").children[0].cloneNode(true) : "";
                        if (svgAsset) AssetGroup.appendChild(svgAsset);
                    }

                    return AssetGroup;
                }
            }
        }
    }
};
BaseBarChart.prototype.getArrowBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    if (width && height) {
        let x1 = 0;
        let y1 = 0;
        let x2 = 0;
        let y2 = width;
        let x3 = height;
        let y3 = width * 0.5;
        return { x1: x1, y1: y1, x2: x2, y2: y2, x3: x3, y3: y3 };
    } else {
        return null;
    }
};
BaseBarChart.prototype.createHdDisplayFormat = function (value1, value2, index) {
    let TextValue = "";
    switch (this.data.indualHdFormat) {
        case "number":
            TextValue = value1 - value2;
            let deciamlCount1 = TextValue.toString().split(".").length > 1 ? TextValue.toString().split(".")[1].length : 0;
            if (deciamlCount1 > 2) {
                return TextValue.toFixed(2);
            }
            let elementMaxValue = value1 > value2 ? -TextValue : -TextValue;
            return this.data.HighlightArrowState == "start" ? -elementMaxValue : elementMaxValue;
            break;
        case "percentage":
            let maxValue = parseFloat(value1);
            let minValue = parseFloat(value2);
            let differnceValue = minValue - maxValue;
            let maxPercentage = 100 / maxValue;
            let percentage = maxPercentage * differnceValue;
            let deciamlCount = percentage.toString().split(".").length > 1 ? percentage.toString().split(".")[1].length : 0;
            if (deciamlCount > 2) {
                return percentage.toFixed(2) + "%";
            } else {
                return percentage + "%";
            }
            break;
        case "fraction":
            let fractionvalue = "";
            let numValue1 = value1 > value2 ? value1 : value2;
            let numValue2 = value1 < value2 ? value1 : value2;
            let countNode = 0;
            for (var i1 = Math.max(numValue1, numValue2); i1 > 1; i1--) {
                if (numValue1 % i1 == 0 && numValue2 % i1 == 0) {
                    numValue1 /= i1;
                    numValue2 /= i1;
                }
                if (countNode > 400) {
                    break;
                }
                countNode++;
            }
            if (numValue2 === 1) {
                fractionvalue = numValue1.toString();
            } else {
                fractionvalue = numValue1.toString() + "/" + numValue2.toString();
            }
            return fractionvalue;

            break;
        case "customlabel":
            return this.data.indualHdFormatText[index][0];
            break;
        case "multiplevalue":
            let percentage1 = ((100 / value1) * value2) / 100;
            let deciamlCount2 = percentage1.toString().split(".").length > 1 ? percentage1.toString().split(".")[1].length : 0;
            if (deciamlCount2 > 2) {
                return percentage1.toFixed(2) + "x";
            } else {
                return percentage1 + "x";
            }
            break;
    }
};
BaseBarChart.prototype.adjustChartTitlePosition = function () {
    let titleNode = this.parent.parentNode.querySelector(".chartTitle");
    let barContainer = this.parent.querySelector(".barContainer");
    let legendElement = this.parent.querySelector(".legend");
    let header = this.parent.querySelector(".header");
    if (this.legendposition == "bottom" && legendElement) {
    } else {
        if (barContainer) {
            let topValue = barContainer.offsetTop;
            if (header && (this.data.layout.labelHeaderPosition == "top" || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top")) {
                topValue = topValue - header.clientHeight;
            }
            if (titleNode) {
                titleNode.style.position = "relative";
                titleNode.style.top = topValue + "px";
            }
        }
    }
};
BaseBarChart.prototype.adjustLegendDesk = function () {
    let gridElement = this.parent.querySelector(".grid");
    let legendElement = this.parent.querySelector(".legend");

    if (gridElement && legendElement) {
        let gridHeight = gridElement.clientHeight;
        let graphicAreaHeight = legendElement.parentNode.children[1].clientHeight;
        let calculatedGapHeight = (gridHeight - graphicAreaHeight) / 2;
        let orignalPadding = calculatedGapHeight + 72;
        legendElement.style.paddingTop = orignalPadding + "px";
    }
};
BaseBarChart.prototype.updateBasicData = function () {
    this.length = this.voData.seriesLength;
    let boolEnabelBaseLine = (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true") || this.data.data.getAttribute("data-baseline") == "true" ? true : false;
    boolEnabelBaseLine = this.data.data.getAttribute("data-highlightdifference") ? false : boolEnabelBaseLine;
    this.viewport = boolEnabelBaseLine ? { x: 0, y: 0, width: this.state.width, height: this.state.height } : { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeries = { x: this.viewport.x, y: this.viewport.y, width: 0, height: 0 };
    this.rectBaseSeries = { x: this.viewport.x, y: this.viewport.y, width: this.viewport.width - 10, height: this.viewport.height };
};

BaseBarChart.prototype.doAddAxisTitle = function () {
    let chartalignment = "vertical";
    let displayList = [];
    if (this.data._customProperties.showXAxisTitle && this.data._customProperties.showYAxisTitle) displayList = ["axis-title-left", "axis-title-bottom"];
    else if (this.data._customProperties.showXAxisTitle) displayList = ["axis-title-bottom"];
    else if (this.data._customProperties.showYAxisTitle) displayList = ["axis-title-left"];
    let eProps = {
        gridsize: this.props.gridsize,
        chartalignment: chartalignment,
        rectBaseSeries: this.rectBaseSeries,
        displaylist: displayList,
        slideID: this.data.slideID,
        xAxisTitle: this.data._customProperties.xAxisTitle,
        yAxisTitle: this.data._customProperties.yAxisTitle,
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    if (this.rectBaseLegend) {
        eProps.legendSeries = this.rectBaseLegend;
    }
    this.addAxisTitleElement(this.parent, eProps);
};

BaseBarChart.prototype.addAxisTitleElement = function (argParent, argProps) {
    const axisTitleSize = 60;
    let displaylist = argProps.displaylist;
    let chartHelper = this.ChartHelper;
    let chartFonts = this.ChartFonts;
    let data = this.data;
    displaylist.map(function (item) {
        switch (item) {
            case "axis-title-left": {
                argProps.rectBaseSeries.x += axisTitleSize;
                argProps.rectBaseSeries.width -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-left";
                element.style.zIndex = "1";
                element.style.gridColumnStart = 1;
                element.style.gridColumnEnd = axisTitleSize / argProps.gridsize + 1;
                element.style.gridRowStart = 1;
                element.style.gridRowEnd = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height - axisTitleSize) / argProps.gridsize + 1);
                argParent.appendChild(element);

                let subelement = document.createElement("div");
                subelement.className = "axistitletext moodanimation clsTextTertiaryColor " + chartFonts.axisLabelThemeClassName;
                subelement.id = "axis-title-left-text";
                subelement.style.zIndex = "1";
                subelement.dataset.customstartrotation = "-90deg";
                subelement.dataset.customendrotation = "-90deg";
                subelement.style.lineHeight = "0.7";
                subelement.style.height = "39px";
                subelement.innerText = argProps.yAxisTitle;
                subelement.style.width = element.clientHeight + "px";
                subelement.setAttribute("maxFontSize", 30);
                subelement.setAttribute("data-id", "yAxis");
                subelement.setAttribute("data-slideid", argProps.slideID);
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-animation", "yaxistitle");
                subelement.setAttribute("data-prompt-text", "Enter Y Axis Label");
                if (data._yaxisTextColor) {
                    subelement.style.setProperty("color", data._yaxisTextColor, "important");
                }
                if (data.axisVerLetterspaceing) subelement.style.letterSpacing = data.axisVerLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
            case "axis-title-right": {
                argProps.rectBaseSeries.width -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-right";
                element.style.gridColumnStart = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize + 1);
                element.style.gridColumnEnd = parseInt(element.style.gridColumnStart) + axisTitleSize / argProps.gridsize;
                element.style.gridRowStart = argProps.rectBaseSeries.y / argProps.gridsize + 1;
                element.style.gridRowEnd = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height) / argProps.gridsize + 1);
                argParent.appendChild(element);

                let subelement = document.createElement("p");
                subelement.className = "axistitletext";
                subelement.id = "axis-title-right-text";
                subelement.innerText = "Enter Y Axis Title";
                subelement.setAttribute("data-prompt-text", "Enter Y Axis Label");
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-animation", "yaxistitle");
                if (data.axisVerLetterspaceing) subelement.style.letterSpacing = data.axisVerLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
            case "axis-title-top": {
                argProps.rectBaseSeries.y += axisTitleSize;
                argProps.rectBaseSeries.height -= axisTitleSize;

                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-top";
                element.style.gridColumnStart = 1;
                element.style.gridColumnEnd = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize + 1);
                element.style.gridRowStart = 1;
                element.style.gridRowEnd = axisTitleSize / argProps.gridsize + 1;
                argParent.appendChild(element);

                let subelement = document.createElement("p");
                subelement.className = "axistitletext clsTextTertiaryColor";
                subelement.id = "axis-title-top-text";
                subelement.innerText = "Enter X Axis Title";
                subelement.setAttribute("data-prompt-text", "Enter X Axis Title");
                subelement.style.alignItems = "flex-start";
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-animation", "yaxistitle");
                if (data.axisHorLetterspaceing) subelement.style.letterSpacing = data.axisHorLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
            case "axis-title-bottom": {
                argProps.rectBaseSeries.height -= axisTitleSize;
                if (argProps.legendSeries) {
                    argProps.legendSeries.height -= axisTitleSize;
                }
                let element = document.createElement("div");
                element.className = "axistitle accent1 clsMultiColorParent";
                element.id = "axis-title-bottom";
                element.style.zIndex = "1";
                element.style.gridColumnStart = 1;
                element.style.gridColumnEnd = Math.round((argProps.rectBaseSeries.x + argProps.rectBaseSeries.width) / argProps.gridsize + 1);
                element.style.gridRowStart = Math.round((argProps.rectBaseSeries.y + argProps.rectBaseSeries.height + 20) / argProps.gridsize + 1);
                element.style.gridRowEnd = parseInt(element.style.gridRowStart) + (axisTitleSize - 20) / argProps.gridsize;
                argParent.appendChild(element);

                let subelement = document.createElement("div");
                subelement.className = "axistitletext moodanimation clsTextTertiaryColor " + chartFonts.axisLabelThemeClassName;
                subelement.id = "axis-title-bottom-text";

                subelement.style.alignItems = "flex-start";
                subelement.innerText = argProps.xAxisTitle;
                subelement.style.height = "100%";
                subelement.style.overflow = "hidden";
                // subelement.style.maxWidth = element.clientWidth + "px";
                subelement.setAttribute("maxFontSize", 30);
                subelement.setAttribute("data-slideid", argProps.slideID);
                subelement.setAttribute("data-id", "xAxis");
                subelement.setAttribute("contenteditable", "true");
                subelement.setAttribute("data-dck-selector", "true");
                subelement.setAttribute("data-type", "axistitle");
                subelement.setAttribute("data-animation", "xaxistitle");
                subelement.setAttribute("data-prompt-text", "Enter X Axis Label");
                if (data._xaxisTextColor) {
                    subelement.style.setProperty("color", data._xaxisTextColor, "important");
                }
                if (data.axisHorLetterspaceing) subelement.style.letterSpacing = data.axisHorLetterspaceing + "em";
                chartHelper.setTextChangeListner(subelement);
                element.appendChild(subelement);
                break;
            }
        }
    });
};

BaseBarChart.prototype.doAddGridValues = function () {};

BaseBarChart.prototype.doAddGraphicDesk = function () {
    const pading = 8;
    if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid && this.data.seriesItemLength == 1) this.rectBaseSeries.height -= 20;
    this.rectBaseSeries.width += 10;
    if (this.data.data.getAttribute("axisbaseline") || this.data.data.getAttribute("data-baseline") == "true") {
        this.rectBaseSeries.height -= 30;
    }
    const seriesWidth = this.rectBaseSeries.width + "px";
    const seriesHeight = this.rectBaseSeries.height + "px";
    let dummeyrectBaseSeriesHeight = this.rectBaseSeries.height;
    let numGraphicArea = 0;
    let DifferenceValue = 0;
    let baseContainerHeight = 0;
    let gapValue = 0;

    this.rectSeries.width = this.rectBaseSeries.width;

    const element = this.ChartHelper.createDivElement();
    element.id = "base-series";
    element.className = "baseseries";
    element.style.height = seriesHeight;
    element.style.width = seriesWidth;
    element.style.maxHeight = seriesHeight;
    element.style.gridColumnStart = this.rectBaseSeries.x / this.props.gridsize + 1;
    element.style.gridColumnEnd = (this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize;
    element.style.gridRowStart = this.rectBaseSeries.y / this.props.gridsize + 1;
    element.style.gridRowEnd = (this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height)) / -this.props.gridsize;
    this.parent.appendChild(element);

    const containerElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";
    containerElement.style.width = element.clientWidth + "px";
    if (numGraphicArea != 0) {
        containerElement.style.height = dummeyrectBaseSeriesHeight + "px";
    } else {
        containerElement.style.height = element.clientHeight + "px";
    }
    containerElement.style.position = "relative";
    containerElement.style.display = "flex";
    containerElement.style.flexDirection = "column";
    containerElement.className = "barContainer";
    // containerElement.style.top = this.rectLegendBaseSeries.x + "px";
    element.appendChild(containerElement);
    if (this.data.chartName.includes("comparisonModel") || (this.data.chartName == "barStackedRectangle" && this.legendposition == "bottom") || this.data.chartName.includes("comparisonmodel") || (this.data.data.getAttribute("data-stackpercentage") && this.legendposition == "top")) {
        this.computeLongLabel(containerElement);
    }
    this.doAddLegendDesk(element);
    containerElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - (element.querySelector(".legend").clientWidth + 5) + "px" : element.clientWidth + "px";
    this.legendHeight = element.querySelector(".legend") ? element.querySelector(".legend").clientHeight : 0;
    this.legendY = this.legendposition == "top" ? this.legendHeight : 0;
    const subElement = this.ChartHelper.createDivElement();
    // subElement.id = "base-series";
    // subElement.className = "baseseries";
    let legendBounds = this.computLegendSize(containerElement);
    if (this.legendposition == "right" || this.legendposition == "left") {
        this.legendWidth = element.querySelector(".legend") ? element.querySelector(".legend").clientWidth : 0;
    }
    subElement.style.width = element.querySelector(".legend") && (this.legendposition == "right" || this.legendposition == "left") ? element.clientWidth - element.querySelector(".legend").clientWidth + "px" : element.clientWidth + "px";
    subElement.style.height = this.rectBaseSeries.height - legendBounds.height + "px";
    dummeyrectBaseSeriesHeight -= legendBounds.height;
    let TitleHeight = { height: 0, width: 0 };
    if (this.data.enableHeader && (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder)) {
        containerElement.style.position = "relative";
        let labelMaxW = this.data.chartName == "barStackedRectangle" ? this.rectSeries.width * 0.2 : this.rectSeries.width * 0.3;
        let labelBounds = this.lonngLabelMesurement(element, {}, true, labelMaxW, 230);
        let labelWidth = labelBounds ? labelBounds.width : 0;
        let valueMaxW = this.rectSeries.width * 0.2;
        let valueBounds = this.lonngValueMesurement(element, {}, true, valueMaxW, 230);
        let valueWidth = valueBounds ? valueBounds.width : 0;
        let itemWidth = this.rectBaseSeries.width - (labelWidth + valueWidth);
        TitleHeight = this.data.seriesItemLength == 1 && this.data.enableHeader ? this.createHeader(element, true, labelWidth, valueWidth, itemWidth) : 0;
        dummeyrectBaseSeriesHeight -= TitleHeight.height;
        this.data._headerHeight = TitleHeight.height - 12;
        if (this.data.layout.labelHeaderPosition == "top" || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top") {
            this.titleY = TitleHeight.height;
            this.titleHeight = TitleHeight.height;
        }
    }
    let numIndualHeight = "";
    let numIndualSizeHeight = "";
    let numIndualGapHeight = "";
    let numTotalHeight = "";
    // if(this.data.chartName=="barSimpleRectangle"&&this.data.seriesItemLength>1){
    //     this.data.layout.itemgap = 0.999;
    //     this.data.layout.parentvPosition ="";
    // }
    let gridGapHeight = 0;
    // if(this.data.layout.labelHeaderTitle||this.data.layout.valueHeaderTitle||this.data.layout.placeholderheder){
    //     this.length = this.length+1;
    // }
    if ((this.data.layout.itemSpace || this.data.layout.itemSpace == 0) && this.data.layout.itemgap != 1) {
        numIndualHeight = dummeyrectBaseSeriesHeight / this.length;
        numIndualSizeHeight = this.data.layout.itemgap ? (this.data.layout.itemgap > 2 ? this.data.layout.itemgap : numIndualHeight * this.data.layout.itemgap) : 0;
        numIndualGapHeight = this.data.layout.itemSpace ? (this.data.layout.itemSpace > 2 ? this.data.layout.itemSpace : numIndualHeight * this.data.layout.itemSpace) : 0;
        if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            gridGapHeight = numIndualGapHeight * 2;
            if (this.legendposition == "bottom" && this.data.seriesItemLength > 2) {
                dummeyrectBaseSeriesHeight -= numIndualGapHeight;
            }
        }
        numTotalHeight = numIndualGapHeight * (this.length - 1) + numIndualSizeHeight * this.length + gridGapHeight;

        if (numTotalHeight > dummeyrectBaseSeriesHeight) {
            // let differnceValue = numTotalHeight-dummeyrectBaseSeriesHeight;
            // let percentageForSize=(differnceValue*0.6)/this.length;
            // let percentageForGap=differnceValue*0.4;
            let sizePercentage = dummeyrectBaseSeriesHeight / numTotalHeight;
            numTotalHeight = dummeyrectBaseSeriesHeight;
            // numGraphicArea = (this.data.layout.itemgap-percentageForSize);
            numGraphicArea = numIndualSizeHeight * sizePercentage;
            if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
                gridGapHeight = numIndualGapHeight * sizePercentage * 2;
            }
        } else {
            if (this.data.layout.itemgap > 2) {
                numGraphicArea = this.data.layout.itemgap;
            } else {
                numGraphicArea = numIndualHeight * this.data.layout.itemgap;
            }
        }
        gapValue = numIndualGapHeight;
    }

    this.rectSeries.height = numGraphicArea != 0 ? numGraphicArea : dummeyrectBaseSeriesHeight / this.length;
    // subElement.style.top = this.rectLegendBaseSeries.x + "px";
    subElement.style.display = "flex";
    subElement.style.flexDirection = "column";
    subElement.style.position = "relative";
    containerElement.appendChild(subElement);
    let projectionBounds = this.createChartProjuctionLabel(this.parent, baseContainerHeight, this.state.height, this.data, this.data.instancedetail, element, containerElement, gapValue, true);
    if (projectionBounds.width > 0) {
        this.rectSeries.width -= projectionBounds.width;
        this.rectBaseSeries.width -= projectionBounds.width;
        let subElementWidth = subElement.clientWidth;
        subElement.style.width = subElementWidth - projectionBounds.width + "px";
        let containerElementWidth = containerElement.clientWidth;
        containerElement.style.width = containerElementWidth - projectionBounds.width + "px";
        let baseElementWidth = element.clientWidth;
        element.style.width = baseElementWidth - projectionBounds.width + "px";
        if (!this.data.chartFlip) element.style.gridColumnEnd = (this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize;
        else element.style.gridColumnStart = (this.rectBaseSeries.x + projectionBounds.width) / this.props.gridsize; // this.rectBaseSeries.x+=(projectionBounds.width-2);
    }
    this.doAddGraphicElement(subElement);
    let boolLabelItemBased = this.data.layout.labelItemBased == "true";
    if (this.data.seriesItemLength == 1 && this.data.enableHeader) this.createHeader(element, false, 0, 0, 0, false, boolLabelItemBased);
    if ((this.data.layout.labelHeaderPosition == "top" || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top") && this.data.seriesItemLength == 1) {
        element.style.flexDirection = "column-reverse";
        element.classList.add("columreverse");
    }
    if ((this.data.layout.labelHeaderPosition == "bottom" || this.data.layout.valueHeaderPosition == "bottom" || this.data.layout.itemHeaderPosition == "bottom") && this.data.seriesItemLength == 1) {
        element.style.flexDirection = "column";
    }
    if (containerElement.children.length > 1 && this.data.layout.itemgap != 1) {
        if (this.legendposition == "left" || this.legendposition == "right") {
            containerElement.style.height = numTotalHeight + "px";
        } else {
            if (this.legendposition == "bottom") {
                containerElement.children[0].style.paddingTop = "0px";
            }
        }
        containerElement.children[1].style.height = numTotalHeight - gridGapHeight + "px";
        containerElement.style.justifyContent = "center";
        containerElement.style.alignItems = "center";
        containerElement.dataset.gridHeight = numTotalHeight;
        this.ParentElementPosition(element, this.data.layout.parentvPosition);
    } else {
        if (this.data.layout.itemgap != 1) {
            containerElement.style.height = numTotalHeight + "px";
            containerElement.style.justifyContent = "center";
            containerElement.children[0].style.height = numTotalHeight - gridGapHeight + "px";
            this.ParentElementPosition(element, this.data.layout.parentvPosition);
        }
    }
    if (containerElement.children.length > 1) {
        if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid) {
            if (this.legendposition == "bottom") {
                let gridHeight = parseFloat(containerElement.dataset.gridHeight);
                let graphicHeight = containerElement.children[1].clientHeight;
                let indualHeight = (gridHeight - graphicHeight) / 2;
                containerElement.children[0].style.paddingTop = indualHeight + 72 + "px";
            }
            if (this.legendposition == "top") {
                let gridHeight = parseFloat(containerElement.dataset.gridHeight);
                let graphicHeight = containerElement.children[1].clientHeight;
                let indualHeight = (gridHeight - graphicHeight) / 2;
                containerElement.children[0].style.paddingBottom = indualHeight + 28 + "px";
                this.legendY = containerElement.children[0].clientHeight;
            }
        } else {
            if (this.legendposition == "top") containerElement.children[0].style.paddingBottom = "72px";
            if (this.legendposition == "bottom") containerElement.children[0].style.paddingTop = "72px";
        }
    }
    let projectionSecondaryBounds = this.createChartProjuctionLabel(this.parent, baseContainerHeight, this.state.height, this.data, this.data.instancedetail, element, containerElement, gapValue);
    let arrprojectionEnableDiv = element.querySelectorAll(".projectionEnableGraphic");
    let arrprojectioDisableDiv = element.querySelectorAll(".projectionDisabledGraphic");
    let projectionEnableDiv = arrprojectionEnableDiv.length > 0 ? arrprojectionEnableDiv[0] : "";
    let projectioDisableDiv = arrprojectioDisableDiv.length > 0 ? arrprojectioDisableDiv[arrprojectioDisableDiv.length - 1] : "";
    if (projectionEnableDiv && projectioDisableDiv && this.data.projectionDivider) {
        let seriesContainer = projectionEnableDiv.querySelector(".seriesitemcond");
        let disableDiv = { height: projectioDisableDiv.clientHeight, y: projectioDisableDiv.offsetTop };
        let enableDiv = { height: projectionEnableDiv.clientHeight, y: projectionEnableDiv.offsetTop };
        let topValue = 0;
        let gapValue = 0;
        if (disableDiv.y > enableDiv.y) {
            gapValue = disableDiv.y - (enableDiv.y + enableDiv.height);
            topValue = enableDiv.y + enableDiv.height + gapValue / 2;
        } else {
            if (disableDiv.y < enableDiv.y) {
                gapValue = enableDiv.y - (disableDiv.y + enableDiv.height);
                topValue = disableDiv.y + disableDiv.height + gapValue / 2;
            }
        }
        let dividerLine = document.createElement("div");
        dividerLine.className = "projectiondivider moodanimation";
        dividerLine.setAttribute("data-animation", "projectiondividerline");
        dividerLine.style.height = "2px";
        dividerLine.style.top = topValue + "px";
        dividerLine.style.width = "calc(100% + " + projectionBounds.width + "px)";
        subElement.appendChild(dividerLine);
    }
    if (this.data.seriesItemLength == 1 && boolLabelItemBased) {
        // element.style.alignItems = "flex-end";
    }
    // if(projectionBounds.width>0){
    //     this.rectSeries.width -= projectionBounds.width;
    //     this.rectBaseSeries.width -= projectionBounds.width;
    //     let subElementWidth = subElement.clientWidth;
    //     subElement.style.width = (subElementWidth-projectionBounds.width)+"px";
    //     let containerElementWidth = containerElement.clientWidth;
    //     containerElement.style.width = (containerElementWidth-projectionBounds.width)+"px";
    //     let baseElementWidth = element.clientWidth;
    //     element.style.width = (baseElementWidth-projectionBounds.width)+"px";
    //     element.style.gridColumnEnd = (this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize;
    //     // this.rectBaseSeries.x+=(projectionBounds.width-2);
    // }
};
BaseBarChart.prototype.createChartProjuctionLabel = function (basechart, gridWidth, gridHeight, voData, instancedetail, secondaryBaseChart, containerElement, gapValue, measurement = false) {
    if (voData.enableProjectionText == "true") {
        let projectionAreaBounds = this.calculateProjectionWidth(containerElement.clientHeight, containerElement);
        let projectionHeight = projectionAreaBounds.height;
        let element = document.createElement("div");
        element.className = "projectionTitle projectiontitletextparent";
        element.style.zIndex = "1";
        element.style.gridRowStart = Math.round((projectionAreaBounds.y + gapValue) / this.props.gridsize + 1);
        element.style.gridRowEnd = Math.round((projectionAreaBounds.y + projectionHeight) / this.props.gridsize + 1);

        element.style.gridColumnStart = 1;
        element.style.gridColumnEnd = Math.round(250 / 4);
        if (voData.projectionTextAlign) {
            element.classList.add(voData.projectionTextAlign);
        }
        basechart.appendChild(element);
        let themeClassName = "p4";
        if (this.ChartFonts && this.ChartFonts.projectiontext) {
            themeClassName = this.ChartFonts.projectiontext;
        }
        if (voData.projectionTitleTextFontSize) {
            themeClassName = voData.projectionTitleTextFontSize;
        }
        if (voData.projectionTextLineHeight) subelement.style.lineHeight = voData.projectionTextLineHeight;
        if (voData.projectionTextLetterSpace) subelement.style.letterSpacing = voData.projectionTextLetterSpace + "em";
        let legnd = basechart.querySelector(".legend");
        let legendWidth = 0;
        let legendHeight = 0;
        if (legnd && (this.legendposition == "left" || this.legendposition == "right")) {
            legendWidth = legnd.clientWidth;
            legendHeight = legnd.clientHeight;
        }
        let subelement = document.createElement("div");
        subelement.className = "projectionTitletext moodanimation  projectiontitletextchild " + themeClassName;
        subelement.id = "projectionTitletext-text";
        subelement.style.zIndex = "1";
        subelement.style.width = "auto";
        subelement.innerHTML = voData.projectiontext;
        subelement.setAttribute("maxFontSize", 30);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "projectiontext");
        subelement.setAttribute("data-animation", "projectiontiletext");
        subelement.setAttribute("data-prompt-text", "Enter your projection text");
        if (voData._projectionTextBold) {
            subelement.style.setProperty("font-weight", "bold", "important");
        }
        if (voData._projectionTextItalic) {
            subelement.style.setProperty("font-style", "italic", "important");
        }
        if (!measurement) this.ChartHelper.setTextChangeListner(subelement);
        element.appendChild(subelement);
        let parentBg = window.getComputedStyle(element)["background-color"];
        let childBg = window.getComputedStyle(subelement)["background-color"];
        if (childBg != "rgba(0, 0, 0, 0)" || parentBg != "rgba(0, 0, 0, 0)") {
            subelement.classList.add("titleColorBg");
        } else {
            subelement.classList.add("transparentBg");
        }
        if (this.data._projectionTextColor) {
            subelement.style.setProperty("color", this.data._projectionTextColor, "important");
            TextHighLightUtils.clearStylesBasedOnType(subelement, "textcolor");
        }
        //    let lineHeight = window.getComputedStyle(subelement)["line-height"]?parseFloat(window.getComputedStyle(subelement)["line-height"]):0;
        //    let paddingTop = window.getComputedStyle(subelement)["padding-top"]?parseFloat(window.getComputedStyle(subelement)["padding-top"]):0;
        //    let paddingBottom = window.getComputedStyle(subelement)["padding-bottom"]?parseFloat(window.getComputedStyle(subelement)["padding-bottom"]):0;
        let marginTop = window.getComputedStyle(subelement)["margin-right"] ? parseFloat(window.getComputedStyle(subelement)["margin-right"]) : 0;
        let marginBottom = window.getComputedStyle(subelement)["margin-left"] ? parseFloat(window.getComputedStyle(subelement)["margin-left"]) : 0;
        let totalWidth = (this.state.width - legendWidth) * 0.32;
        subelement.style.maxWidth = totalWidth - marginBottom - 5 + "px";
        if (totalWidth < subelement.clientWidth) {
            subelement.style.width = totalWidth + "px";
        }
        if (voData.projectionTextSize) subelement.style.setProperty("font-size", voData.projectionTextSize, "important");
        if (voData.projectionTextOpacity) subelement.style.setProperty("opacity", voData.projectionTextOpacity, "important");
        if (voData.projectionTextTransform) subelement.style.setProperty("text-transform", voData.projectionTextTransform, "important");
        let position = "right";
        switch (position) {
            case "right":
                if (!measurement) {
                    element.style.gridColumnStart = 1;
                    element.style.gridColumnEnd = Math.round((subelement.clientWidth + marginBottom) / 4);
                    if (!this.data.chartFlip) {
                        secondaryBaseChart.style.gridColumnEnd = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize);
                        element.style.gridColumnStart = secondaryBaseChart.style.gridColumnEnd;
                        element.style.gridColumnEnd = parseInt(secondaryBaseChart.style.gridColumnEnd) + Math.round((subelement.clientWidth + marginBottom) / 4);
                    }
                    this.checkMaxLineCount(subelement, "bar");
                    return { x: 0, y: 0, width: subelement.clientWidth + marginBottom, height: subelement.clientHeight };
                } else {
                    this.checkMaxLineCount(subelement, "bar");
                    let objectValue = { x: 0, y: 0, width: subelement.clientWidth + marginBottom, height: subelement.clientHeight };
                    basechart.removeChild(element);

                    return objectValue;
                }
                break;
            case "bottom":
                // secondaryBaseChart.style.gridRowStart = 1;
                // secondaryBaseChart.style.gridRowEnd = Math.round((gridHeight-subelement.clientHeight-marginTop)/4);
                // element.style.gridRowStart = secondaryBaseChart.style.gridRowEnd;
                element.style.gridRowEnd = Math.round(gridHeight / 4);
                this.checkMaxLineCount(subelement, "bar");
                return { x: 0, y: 0, width: subelement.clientWidth, height: subelement.clientHeight + marginTop };
                break;
        }
    } else {
        return { x: 0, y: 0, width: 0, height: 0 };
    }
};

BaseBarChart.prototype.calculateProjectionWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let height = projectionLength * indualWidth;
    let y = startingProjectionPoint * indualWidth;
    return { y: containerElement.offsetTop + this.rectBaseSeries.y + y, height: height };
};
BaseBarChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 20;
    let moveY = this.rectSeries.y;
    // if (this.data.layout.itemSpace) {
    //     this.rectSeries.height = this.rectSeries.height - this.data.layout.itemSpace;
    // }
    if (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) {
        // this.data.headerHeight = this.rectBaseSeries.height*0.1;
        // this.rectSeries.maxHeight = this.rectSeries.height-(this.data.headerHeight/this.length);
        // this.length = this.length+1;
    }
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(this.rectSeries.x, moveY);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveY += this.rectSeries.height;
    }
    this.adjustaxisline(argparent);
};
BaseBarChart.prototype.adjustaxisline = function (argparent) {
    let bottomTitle = this.parent.querySelector("#axis-title-bottom");
    let graphicArea = this.items[0].parent.querySelector(".seriesitemcond");
    if (graphicArea && bottomTitle) {
        let graphicWidth = graphicArea.clientWidth;
        let titleGridcalCulation = (graphicArea.offsetLeft + 20) / this.props.gridsize + 1;
        bottomTitle.style.gridColumnStart = parseInt(titleGridcalCulation);
        bottomTitle.style.gridColumnEnd = parseInt(titleGridcalCulation) + (parseInt(graphicWidth) / this.props.gridsize + 1);
    }
};
BaseBarChart.prototype.computeLongLabel = function (argparent) {
    this.labelMaxW = this.rectBaseLegend.width * 0.2;
    this.labelMaxH = 100;
    let element = document.createElement("div");
    element.className = "label outerColor1 p4";
    element.style.minWidth = 10 + "px";
    element.style.height = this.labelMaxH + "px";
    element.style.maxWidth = this.labelMaxW + "px";
    element.style.maxHeight = this.labelMaxH + "px";
    element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
    element.style.paddingRight = this.data.layout.labelPaddingright + "px";
    element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
    element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
    if (argparent) argparent.appendChild(element);
    else return element;
    let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //

    let hasInnerLabel = this.data.layout.labelInset == "inside";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);

    subelement.className = this.data.layout.labelColor ? "labeltext " + this.labelStyle : "labeltext " + this.data.clsLabelTextColor + this.labelStyle;
    subelement.innerText = this.data.longLabel;
    subelement.style.maxWidth = this.labelMaxW + "px";
    subelement.style.maxHeight = this.labelMaxH + "px";
    subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-prompt-text", "Enter Label");
    element.appendChild(subelement);
    this.ChartHelper.setTextChangeListner(subelement);
    this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement, true);
    this.ChartHelper.recalculateMaxHeight(subelement);
    this.maxLabelW = subelement.clientWidth;
    element.remove();
    return this.maxLabelW;
};
// ---------------------------------- Enhancement ---------------------------------

BaseBarChart.prototype.doAddLegendDesk = function (argParent) {
    if ((this.voData.seriesItemLength > 1 && this.data.baseProperties.maxAllowedSeriesItems > 1) || this.data.chartName.includes("comparisonModel")) {
        this.rectBaseLegend.height -= 20;
        const element = this.ChartHelper.createDivElement();
        element.className = "legend";
        this.rectBaseLegend.width = this.rectBaseLegend.width - this.maxLabelW;
        element.style.maxWidth = this.rectBaseLegend.width + "px";
        element.style.maxHeight = this.rectBaseLegend.height + "px";
        if (this.legendposition == "bottom") {
            argParent.style.flexDirection = "column";
            element.style.width = this.rectBaseLegend.width + "px";
        }
        if (this.legendposition == "top") {
            argParent.style.flexDirection = "column-reverse";
            argParent.classList.add("columreverse");
        }
        if (this.legendposition == "left") {
            argParent.style.flexDirection = "row-reverse";
        }
        if (this.data.layout.legendWidth && (this.legendposition == "left" || this.legendposition == "right")) {
            element.style.maxWidth = this.data.layout.legendWidth;
            element.style.width = this.data.layout.legendWidth;
        }
        if (this.legendposition == "bottom" || this.legendposition == "right") element.style.order = 1;
        argParent.appendChild(element);
        let eProps = { maxsize: this.rectBaseLegend, legendlabel: true };
        this.addLegendDeskElements(element, eProps);
        if (this.maxLabelW > 0) {
            argParent.style.alignItems = "flex-end";
        }
    }
};

BaseBarChart.prototype.addLegendDeskElements = function (argParent, argProps) {
    if (this.data.baseProperties.legend && this.data.showLegend) {
        let legend = new window["Legend"](argParent, argProps, true);
        legend.ChartHelper = this.ChartHelper;
        legend.ChartUtils = this.ChartUtils;
        legend.move(0, 0);
        legend.size(this.rectBaseLegend.width, this.rectBaseLegend.height);
        legend.data = this.data;
    }
    //this.doMeasurementComputation(argParent);
    return null;
};

BaseBarChart.prototype.doAddGridDesk = function () {
    let eParent = this.parent;
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let negseries = eParent.getElementsByClassName("leftseriesitem");
    let Container = eParent.getElementsByClassName("barContainer");
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series").children[0] : "";
    let secondarySeriesHeight = secondarySeries ? (secondarySeries.dataset.gridHeight ? parseFloat(secondarySeries.dataset.gridHeight) : secondarySeries.clientHeight) : 0;
    if (negseries[0] && negseries[0].children.length > 0) {
        let childSeries = eParent.querySelectorAll(".baseleftgraphic");
        negseries = childSeries.length > 0 ? childSeries : negseries;
    }
    let eValue = eParent.getElementsByClassName("value");
    let eLeft = eParent.getElementsByClassName("baseleftgraphic");
    let evalue = eLeft[0] ? eLeft[0].getElementsByClassName("value") : {};
    let statisticalValue = eParent.getElementsByClassName("statistcalelement");
    let gridMaxValue = eParent.querySelector(".gridmaxValue");
    let gridNegativeValue = eParent.querySelector(".gridnegativemaxValue");
    let negValueBounds = evalue[0] ? { width: parseInt(evalue[0].clientWidth), height: parseInt(evalue[0].clientHeight) } : { width: 0, height: 0 };
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };
    let statisticalValueBounds = statisticalValue[0] ? { width: parseInt(statisticalValue[0].clientWidth), height: parseInt(statisticalValue[0].clientHeight) } : { width: 0, height: 0 };
    let VlaueWidth = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(valueBounds.width) : 0;

    let negativeValueWidth = 0;
    if (gridMaxValue) {
        VlaueWidth = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false ? parseFloat(gridMaxValue.clientWidth) : 0;
    }

    if (this.data.highlightDifference.display || this.data.indualHighlight) {
        VlaueWidth += this.data.hdHeight;
    }
    if (this.data.layout.statisticalInset == "outer" || this.data.layout.statisticalInset == "bgoutside") {
        VlaueWidth += statisticalValueBounds.width;
    }
    if (gridNegativeValue) {
        negativeValueWidth = this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" ? parseFloat(gridNegativeValue.clientWidth) : 0;
    }
    negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth) - negativeValueWidth, height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    // if(negseries[0]&&negseries[0].parentNode&&negseries[0].parentNode.dataset.parentSeriesWidth){
    //     negBounds.width = negseries[0].dataset.parentSeriesWidth;
    // }
    totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth) - VlaueWidth - negativeValueWidth, height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };

    let element = document.createElement("div");
    //let height = this.data.seriesItemLength>1?this.rectLegendBaseSeries.height:this.rectBaseSeries.height;
    element.className = "grid accent" + 1 + " clsMultiColorParent";
    element.style.display = "grid";
    element.style.setProperty("--customItemColor", "var(--item" + 1 + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + 1 + "-rgb)");

    let columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize + 1);
    if ((this.data.chartName == "barStackedRectangle" && this.legendposition == "left") || (this.legendposition == "left" && this.data.seriesItemLength > 1 && this.legendWidth > 0)) {
        this.rectBaseSeries.x += eSeries[0].offsetLeft + this.legendWidth;
        columnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize);
    }
    if (this.data.chartFlip) {
        this.rectBaseSeries.x += eSeries[0].offsetLeft;
        columnStart = Math.round((this.rectBaseSeries.x + VlaueWidth) / this.props.gridsize + 1);
    }
    element.style.gridColumnStart = columnStart;
    element.style.gridColumnEnd = Math.round(parseInt((this.rectBaseSeries.x + (this.rectBaseSeries.width - this.legendWidth - VlaueWidth)) / this.props.gridsize) + 1);
    element.style.gridRowStart = Math.round(parseInt((this.rectBaseSeries.y + this.legendY) / this.props.gridsize + 1));
    element.style.gridRowEnd = Math.round(parseInt((this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height - this.legendHeight - this.titleHeight)) / -this.props.gridsize));
    eParent.appendChild(element);
    if (this.data.chartFlip) {
        let clientWidthValue = eSeries[0].clientWidth;
        element.style.gridColumnEnd = Math.round(parseInt((this.rectBaseSeries.x + (clientWidthValue - VlaueWidth)) / this.props.gridsize) + 1);
    }
    let elementRect = document.createElement("div");
    elementRect.style.width = "100%";
    elementRect.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + gridvalueSize - this.legendHeight + "px";
    elementRect.style.display = "flex";
    if (this.legendposition != "left") elementRect.style.flexDirection = "row-reverse";
    if (this.data.chartFlip) {
        elementRect.style.flexDirection = "row";
    }
    element.appendChild(elementRect);

    let elementConatiner = document.createElement("div");
    elementConatiner.style.width = totalBounds.width + "px";
    elementConatiner.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + gridvalueSize - this.legendHeight + "px";
    elementRect.appendChild(elementConatiner);
    let differneceValue = 0;
    if (this.data.layout.parentvPosition == "bottom") {
        differneceValue = elementConatiner.clientHeight + gridvalueSize - secondarySeriesHeight;
        element.style.gridRowStart = parseInt(element.style.gridRowStart) + Math.round((elementConatiner.clientHeight + gridvalueSize - secondarySeriesHeight) / this.props.gridsize);
        if (secondarySeries) {
            element.style.gridRowStart = Math.round(secondarySeries.offsetTop / this.props.gridsize);
        }
        element.style.gridRowEnd = parseInt(element.style.gridRowStart) + Math.round((elementConatiner.clientHeight + gridvalueSize) / this.props.gridsize);
        elementConatiner.style.height = elementConatiner.clientHeight - differneceValue + "px";
    }
    if (this.data.layout.parentvPosition == "middle") {
        differneceValue = secondarySeriesHeight > elementConatiner.clientHeight + gridvalueSize ? (secondarySeriesHeight - (elementConatiner.clientHeight + gridvalueSize)) / 2 : (elementConatiner.clientHeight + gridvalueSize - secondarySeriesHeight) / 2;
        // if(this.legendHeight>0&&this.legendposition=="bottom"){
        //     element.style.gridRowStart = parseInt(element.style.gridRowStart)+Math.round(((this.state.height-(secondarySeriesHeight+this.legendHeight))/2)/this.props.gridsize)
        // }else{
        element.style.gridRowStart = parseInt(element.style.gridRowStart) + Math.round(differneceValue / this.props.gridsize);
        let topValue = Container.length > 0 ? Container[0].offsetTop : 0;
        if (this.parent.dataset.titleheight && this.parent.dataset.assetType != "sourcetext" && parseFloat(this.parent.dataset.titleheight) < topValue) {
            topValue -= parseFloat(this.parent.dataset.titleheight);
        }
        if (Container.length > 0) {
            element.style.gridRowStart = Math.round(topValue / this.props.gridsize);
        }

        // }
        elementConatiner.style.height = secondarySeriesHeight + "px";
        element.style.gridRowEnd = Math.round(secondarySeriesHeight / this.props.gridsize) + parseInt(element.style.gridRowStart);
    }
    let rectSeries = {
        x: 0,
        y: 0,
        width: elementConatiner.clientWidth,
        height: elementConatiner.clientHeight,
        top: elementConatiner.clientHeight < elementConatiner.offsetTop ? elementConatiner.offsetTop - elementConatiner.clientHeight : elementConatiner.offsetTop,
        left: elementConatiner.offsetLeft + negBounds.width,
    };
    if (this.data._customProperties.showYAxisTitle || this.legendposition == "left") {
        element.style.position = "relative";
        rectSeries.left = elementConatiner.offsetLeft + negBounds.width;
    }
    if (this.data.chartFlip) {
        let leftValue = totalBounds.width - (negBounds.width + negativeValueWidth);
        if (negBounds.width > 0) {
            leftValue = elementConatiner.offsetLeft + (totalBounds.width - (negBounds.width + negativeValueWidth));
        }
        rectSeries.left = leftValue;
    }
    let graphicContainer = eParent.querySelector(".chartgraphic");
    let grid3dspace = graphicContainer && graphicContainer.getAttribute("data-movey") ? graphicContainer.getAttribute("data-movey") : 0;
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        valueWidth: VlaueWidth,
        negativeValueWidth: negativeValueWidth,
        gridvalueSize: { width: 0, height: gridvalueSize },
        type: "horizontal",
        negBounds: negBounds,
        move3dspace: grid3dspace,
        negValueBounds: negValueBounds,
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: totalBounds.width },
    };
    this.addGridDeskElement(elementConatiner, eProps);
    if (this.data.chartName == "barStackedRectangle" && this.legendposition == "left") {
        let yaxis = elementConatiner.querySelector(".axisYlines");
        if (yaxis) {
            yaxis.style.marginLeft = "0px";
        }
        let xaxis = elementConatiner.querySelector(".axisXlines");
        if (xaxis) {
            xaxis.style.marginLeft = "0px";
        }
    }
    if (this.data.chartName == "barStackedRectangle" && this.legendposition == "top") {
        let xaxis = elementConatiner.querySelector(".axisXlines");
        let legendArea = this.parent.querySelector(".legend");
        // if(xaxis&&legendArea){
        //     let topElementValue = xaxis.parentNode.offsetTop+legendArea.clientHeight
        //     xaxis.parentNode.style.top = topElementValue+"px"
        //   }
    }
    if (this.data.layout.parentvPosition == "bottom" || this.data.layout.parentvPosition == "middle") {
        element.style.position = "relative";
    }
};

BaseBarChart.prototype.addGridDeskElement = function (argParent, argProps) {
    if (this.data.baseProperties.grid) {
        if (this.data.chartName == "barStackedRectangle") this.voData.rangeTotal = this.voData.maxStackValueTotal;
        let grid = new window["Grid"](argParent, argProps);
        grid.data = this.data;
        grid.rectSeries = argProps.rectSeries;
        grid.negBounds = argProps.negBounds;
        grid.negValueBounds = argProps.negValueBounds;
        grid.move(0, 0);
        grid.size(argProps.rectSeries.width, argProps.rectSeries.height);
    }
    return null;
};

BaseBarChart.prototype.doAddBaseLineDesk = function () {
    let eParent = this.parent;
    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let negseries = eParent.getElementsByClassName("leftseriesitem");
    let totalBounds = eSeries[0] ? { width: parseInt(eSeries[0].clientWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    if (this.data.rangeNegative < 0) {
        let elementWidth = parseFloat(eSeries[0].querySelector(".rightseriesitem").clientWidth);
        totalBounds = eSeries[0] ? { width: parseInt(elementWidth), height: parseInt(eSeries[0].clientHeight) } : { width: 0, height: 0 };
    }
    let eValue = eParent.getElementsByClassName("value");
    let eLeft = eParent.getElementsByClassName("baseleftgraphic");
    let evalue = eLeft[0] ? eLeft[0].getElementsByClassName("value") : {};
    let gridMaxValue = eParent.querySelector(".gridmaxValue");
    let negValueBounds = evalue[0] ? { width: parseInt(evalue[0].clientWidth), height: parseInt(evalue[0].clientHeight) } : { width: 0, height: 0 };
    let negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth), height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };
    let valueBounds = eValue[0] ? { width: parseInt(eValue[0].clientWidth), height: parseInt(eValue[0].clientHeight) } : { width: 0, height: 0 };

    let VlaueWidth = (this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside") && this.data.layout.valueItemBased != "true" ? parseFloat(valueBounds.width) : 0;
    let negativeValueWidth = 0;
    if (gridMaxValue) {
        VlaueWidth = (this.data.layout.valueInset == "outer" || this.data.layout.valueInset == "outside" || this.data.layout.valueInset == "bgoutside" || this.data.layout.valueInset == false) && this.data.layout.valueItemBased != "true" ? parseFloat(gridMaxValue.clientWidth) : 0;
    }
    negBounds = negseries[0] ? { width: parseInt(negseries[0].clientWidth) - negativeValueWidth, height: parseInt(negseries[0].clientHeight) } : { width: 0, height: 0 };

    let element = document.createElement("div");
    element.className = "axisbaseline";
    element.style.display = "grid";
    element.style.gridColumnStart = Math.round(this.rectBaseSeries.x / this.props.gridsize + 1);
    element.style.gridColumnEnd = Math.round((this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize);
    element.style.gridRowStart = Math.round(this.rectBaseSeries.y / this.props.gridsize + 1);
    element.style.gridRowEnd = Math.round(parseInt((this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height - this.legendHeight - this.titleHeight)) / -this.props.gridsize));
    eParent.appendChild(element);

    let elementRect = document.createElement("div");
    if (this.data._customProperties.showYAxisTitle) {
        elementRect.style.width = this.rectBaseSeries.x + this.rectBaseSeries.width - axisTitleSize + "px";
    } else {
        elementRect.style.width = this.rectBaseSeries.x + this.rectBaseSeries.width + "px";
    }
    elementRect.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
    elementRect.style.display = "flex";
    if (!this.data.chartFlip) elementRect.style.flexDirection = "row-reverse";
    element.appendChild(elementRect);

    let elementConatiner = document.createElement("div");
    elementConatiner.style.width = totalBounds.width + "px";
    elementConatiner.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
    let secondarySeries = eParent.querySelector("#base-series") ? eParent.querySelector("#base-series").children[0] : "";
    let secondarySeriesHeight = secondarySeries ? (secondarySeries.dataset.gridHeight ? parseFloat(secondarySeries.dataset.gridHeight) : secondarySeries.clientHeight) : 0;
    let offsetTop = secondarySeries ? secondarySeries.offsetTop : 0;
    if (secondarySeriesHeight > 0) {
        elementConatiner.style.height = secondarySeriesHeight + "px";
    }
    elementRect.style.height = elementConatiner.style.height;

    if (this.data.layout.parentvPosition == "bottom") {
        elementRect.style.alignItems = "flex-end";
    }
    if (this.data.layout.parentvPosition == "middle") {
        elementRect.style.alignItems = "center";
    }
    element.style.gridRowStart = Math.round((this.rectBaseSeries.y + offsetTop) / this.props.gridsize + 1);
    element.style.gridRowEnd = parseFloat(element.style.gridRowStart) + Math.round(elementConatiner.clientHeight / 4);

    elementRect.appendChild(elementConatiner);
    let rectSeries = {
        x: 0,
        y: 0,
        width: elementConatiner.clientWidth - VlaueWidth - negativeValueWidth,
        height: elementConatiner.clientHeight,
        top: elementConatiner.offsetTop,
        left: elementConatiner.offsetLeft,
    };
    let eProps = {
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        type: "horizontal",
        chartHelper: this.ChartHelper,
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    this.addAxisBaselineDeskElement(elementConatiner, eProps);
};
BaseBarChart.prototype.addGradient = function (svgRect, parentElement, bgFill = false) {
    let SVGUtils = new window["SVGUtils"]();
    let defs = SVGUtils.createSVGElement("defs");
    parentElement.appendChild(defs);
    let linearGrad = SVGUtils.createSVGElement("linearGradient");
    SVGUtils.assignAttributes(linearGrad, {
        id: "grad",
        x1: "0%",
        x2: bgFill ? "0%" : "100%",
        y1: bgFill ? "100%" : "0%",
        y2: "0%",
    });
    defs.appendChild(linearGrad);
    let stop1 = SVGUtils.createSVGElement("stop");
    SVGUtils.assignAttributes(stop1, {
        class: "stop1",
        offset: "0%",
        style: "stop-color:var(--accent" + 2 + "-color);stop-opacity:1",
    });
    linearGrad.appendChild(stop1);
    let stop2 = SVGUtils.createSVGElement("stop");
    SVGUtils.assignAttributes(stop2, {
        class: "stop2",
        offset: "100%",
        style: "stop-color:var(--accent" + 6 + "-color);stop-opacity:1",
    });
    linearGrad.appendChild(stop2);
    SVGUtils.assignAttributes(svgRect, {
        fill: "url(#grad)",
    });
};
BaseBarChart.prototype.addAxisBaselineDeskElement = function (argParent, argProps) {
    let axisbaseline = new window["AxisBaseLine"](argParent, argProps);
    axisbaseline.data = this.data;
    axisbaseline.rectSeries = argProps.rectSeries;
    axisbaseline.move(0, 0);
    axisbaseline.size(argProps.rectSeries.width, argProps.rectSeries.height);
};
BaseBarChart.prototype.CreateHightlightDifference = function () {
    let eParent = this.parent;

    let eSeries = eParent.getElementsByClassName("seriesitemcond");
    let baseseies = eParent.querySelector("#base-series");
    let barContainer = eParent.querySelector(".barContainer");
    let negseries = eParent.getElementsByClassName("leftseriesitem");
    let secondarySeries = eParent.querySelector("#base-series") && eParent.querySelector("#base-series").children[0] ? eParent.querySelector("#base-series").children[0].children[0] : "";
    let secondarySeriesHeight = secondarySeries ? (secondarySeries.dataset.gridHeight ? parseFloat(secondarySeries.dataset.gridHeight) : secondarySeries.clientHeight) : 0;

    let totalBounds = baseseies ? { width: parseInt(baseseies.clientWidth - 10), height: parseInt(baseseies.clientHeight) } : { width: 0, height: 0 };
    let element = document.createElement("div");
    element.className = "highlightdiff " + this.data.highlightDifference.style;
    element.style.display = "grid";
    element.style.gridColumnStart = this.rectBaseSeries.x / this.props.gridsize + 1;
    element.style.gridColumnEnd = (this.rectBaseSeries.x + this.rectBaseSeries.width) / this.props.gridsize;
    element.style.gridRowStart = this.rectBaseSeries.y / this.props.gridsize + 1;
    element.style.gridRowEnd = (this.state.height - (this.rectBaseSeries.y + this.rectBaseSeries.height)) / -this.props.gridsize;
    eParent.appendChild(element);

    let elementRect = document.createElement("div");
    elementRect.style.width = "100%";
    elementRect.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
    elementRect.style.display = "flex";
    elementRect.style.flexDirection = "row-reverse";
    elementRect.style.position = "relative";
    element.appendChild(elementRect);
    let elementConatiner = document.createElement("div");
    elementConatiner.style.width = totalBounds.width + "px";
    elementConatiner.style.height = this.rectBaseSeries.y + this.rectBaseSeries.height + "px";
    elementRect.appendChild(elementConatiner);
    let differneceValue = 0;
    if (this.data.layout.parentvPosition == "bottom") {
        differneceValue = elementConatiner.clientHeight - secondarySeriesHeight;
        element.style.gridRowStart = parseInt(element.style.gridRowStart) + Math.round((elementConatiner.clientHeight + gridvalueSize - secondarySeriesHeight) / this.props.gridsize);
        elementConatiner.style.height = elementConatiner.clientHeight - differneceValue + "px";
        let childContainer = barContainer.children[0];
        if ((this.data.enableHeader && this.data.layout.labelHeaderPosition == "top") || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top") {
            element.style.gridRowStart = Math.round(childContainer.offsetTop / this.props.gridsize) + Math.round(barContainer.offsetTop / this.props.gridsize);
        } else {
            element.style.gridRowStart = Math.round(childContainer.offsetTop / this.props.gridsize) + Math.round(barContainer.offsetTop / this.props.gridsize);
        }
    } else if (this.data.layout.parentvPosition == "middle") {
        differneceValue = (elementConatiner.clientHeight - secondarySeriesHeight) / 2;
        element.style.gridRowStart = parseInt(element.style.gridRowStart) + Math.round(differneceValue / this.props.gridsize);
        elementConatiner.style.height = elementConatiner.clientHeight - 2 * differneceValue + "px";
        if ((this.data.enableHeader && this.data.layout.labelHeaderPosition == "top") || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top") {
            let childContainer = barContainer.children[0];
            element.style.gridRowStart = Math.round(childContainer.offsetTop / this.props.gridsize) + Math.round(barContainer.offsetTop / this.props.gridsize);
        }
    }
    let rectSeries = { x: 0, y: 0, width: elementConatiner.clientWidth, height: elementConatiner.clientHeight, top: elementConatiner.offsetTop, left: elementConatiner.offsetLeft };
    let eProps = {
        type: "bar",
        highlightNodes: [this.data.highlightDifference.point1, this.data.highlightDifference.point2],
        gridsize: this.props.gridsize,
        rectSeries: rectSeries,
        type: "horizontal",
        viewport: { y: this.state.y, x: this.state.x, height: this.state.height, width: this.state.width },
    };
    let hightlightDiffernce = new window["hightlightDifference"](elementConatiner, eParent, eProps);
    hightlightDiffernce.data = this.data;
    hightlightDiffernce.rectSeries = eProps.rectSeries;
    hightlightDiffernce.move(0, 0);
    hightlightDiffernce.size(eProps.rectSeries.width, eProps.rectSeries.height);
};
BaseBarChart.prototype.createGraphicsImage = function () {
    let graphicElement = this.parent.querySelectorAll(".chartgraphic");
    let valueElement = this.parent.querySelectorAll(".value");
    let labelElement = this.parent.querySelectorAll(".label");
    let seriesElement = this.parent.querySelectorAll(".series");
    for (let i1 = 0; i1 < graphicElement.length; i1++) {
        let assetdata = this.voData.asset.data.length > 0 && this.voData.asset.data[0].data ? JSON.parse(this.voData.asset.data[0].data) : "";
        let farmes = "";
        let assetValueUrl = "";
        if (assetdata) {
            farmes = assetdata.frames;
            this.data.spriteasset.push({ name: this.data.layout.assetname, assetvalue: this.voData.asset.data });
            assetValueUrl = this.voData.asset.data[1].url;
        } else {
            if (this.data.spriteasset.length > 0) {
                for (let k1 = 0; k1 < this.data.spriteasset.length; k1++) {
                    if (this.data.spriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.spriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.spriteasset[k1].assetvalue[1].url;
                    }
                }
                farmes = assetdata.frames;
            }
        }
        const totalfarmes = farmes.length - 1;
        const assetURL = this.data.serverUrl + assetValueUrl;
        let indexValue = (this.voData.values[i1][0] / this.data.rangePositive) * 100;

        let frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((indexValue / 100) * totalfarmes);
        if (this.data.seriesLength == 1) {
            frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.ceil((this.voData.values[i1][0] / 100) * totalfarmes);
        }
        const frame = farmes[frameIndex].frame;

        let spriteCoordinates = [];
        for (let i1 = 0; i1 < totalfarmes + 1; i1++) {
            let eachFrame = farmes[i1].frame;
            let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
            spriteCoordinates.push(eachFrameCoordinates);
        }

        let itemWidth = graphicElement[i1].clientWidth;
        let itemHeight = graphicElement[i1].clientHeight;
        const scaleX = itemWidth / frame.w;
        const scaleY = itemHeight / frame.h;
        const scale = scaleX < scaleY ? scaleX : scaleY;

        const viewWidth = frame.w * scale;
        const viewHeight = frame.h * scale;
        const translateX = (viewWidth - frame.w) / 2;
        const translateY = (viewHeight - frame.h) / 2;

        const assetelement = this.ChartHelper.createDivElement({});
        assetelement.id = "graphicimage-" + i1;
        assetelement.className = "graphicimage";
        // assetelement.dataset.animation = "spriteanimation";
        assetelement.dataset.frameindex = frameIndex;
        assetelement.dataset.assetURL = assetURL;
        assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + 0 + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        graphicElement[i1].appendChild(assetelement);

        let labelW = labelElement[i1] ? labelElement[i1].clientWidth : 0;
        let valueW = valueElement[i1] ? valueElement[i1].clientWidth : 0;
        let widthPercentage = parseInt(((viewWidth + labelW + valueW + 20) / this.state.width) * 100) + "%";
        if (seriesElement[i1]) {
            seriesElement[i1].style.maxWidth = widthPercentage;
        }
    }
};
BaseBarChart.prototype.createCallout = function () {
    let calloutDiv = this.ChartHelper.createDivElement();
    calloutDiv.className = "indualhighlightcallout hdcallout moodanimation";
    calloutDiv.dataset.animation = "indualhdcalloutdiv";
    let textCallout = this.ChartHelper.createDivElement();
    textCallout.className = "indualhighlighttextcallout " + this.ChartFonts.hdClassName;
    calloutDiv.appendChild(textCallout);
    return calloutDiv;
};

let objLabel = null;
let labelMaxW = 0;
let labelMaxH = 0;
let valueMaxW = 0;
let valueMaxH = 0;
function BaseBarSeries(argparent, argprops) {
    this.pad = 10;
    this.voData = null;
    this.gapPercentage = 0.7;
    this.name = "BaseSeries";
    this.ChartFonts = new window["ChartFonts"]();
    this.maxLabelFontSize = [24, 24];
    this.minLabelFontSize = [30 - 8, 30 - 8];
    this.alignment = "";
    this.svgAsset = false;
    this.sequenceNumberMaxWidth = 0;
    BaseSeries.call(this, argparent, argprops);
}
BaseBarSeries.prototype = Object.create(BaseSeries.prototype);
BaseBarSeries.prototype.constructor = BaseBarSeries;

BaseBarSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["BaseBarSeriesItem"](argparent, argprops);
};

BaseBarSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseBarSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseBarSeries.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let _oWidth = 0;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    this.gapPercentage = this.data.layout.itemgap ? 1 : this.gapPercentage;
    // this.gapPercentage = this.data.seriesItemLength > 1 ? 0.7 : this.gapPercentage;
    let objRuler = ""; //this.ChartUtils.ruler(this.data.data);
    if (objRuler) {
        if (this.data.validHover && objRuler.layout) {
            this.data.conflictLayout = "basic";
        }
    }

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });
    this.secondaryLabelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLabelHPosition,
        vposition: this.data.layout.secondaryLabelVPosition,
        show: this.data.layout.showsecondaryLabel,
        inset: this.data.layout.secondaryLabelInset,
        index: this.data.layout.secondaryLabelPosIndex,
        itemBased: this.data.layout.secondaryLabelItemBased,
        samepos: this.data.layout.secondaryLabelSamePos,
        textbg: this.data.layout.secondaryLabeltextbg,
        textbgstyle: this.data.layout.secondaryLabeltextbgstyle,
        textbgcallout: this.data.layout.secondaryLabeltextbgcallout,
        textbgitem: this.data.layout.secondaryLabeltextbgItem,
    });
    this.secondaryNumberAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryNumberHPosition,
        vposition: this.data.layout.secondaryNumberVPosition,
        show: this.data.layout.secondaryNumber,
        inset: this.data.layout.secondaryNumberInset,
        index: this.data.layout.secondaryNumberPosIndex,
        itemBased: this.data.layout.secondaryNumberItemBased,
        samepos: this.data.layout.secondaryNumberSamePos,
        textbg: this.data.layout.secondaryNumbertextbg,
        textbgstyle: this.data.layout.secondaryNumbertextbgstyle,
        textbgcallout: this.data.layout.secondaryNumbertextbgcallout,
        textbgitem: this.data.layout.secondaryNumbertextbgItem,
    });
    this.secondaryLogoAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLogoHPosition,
        vposition: this.data.layout.secondaryLogoVPosition,
        show: this.data.layout.secondaryLogo,
        inset: this.data.layout.secondaryLogoInset,
        index: this.data.layout.secondaryLogoPosIndex,
        itemBased: this.data.layout.secondaryLogoItemBased,
        samepos: this.data.layout.secondaryLogoSamePos,
        textbg: this.data.layout.secondaryLogotextbg,
        textbgstyle: this.data.layout.secondaryLogotextbgstyle,
        textbgcallout: this.data.layout.secondaryLogotextbgcallout,
        textbgitem: this.data.layout.secondaryLogotextbgItem,
    });
    this.secondarySequenceAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondarySquenceNumberHPosition,
        vposition: this.data.layout.secondarySquenceNumberVPosition,
        show: this.data.layout.secondarySquenceNumber,
        inset: this.data.layout.secondarySquenceNumberInset,
        index: this.data.layout.secondarySquenceNumberPosIndex,
        itemBased: this.data.layout.secondarySquenceNumberItemBased,
        samepos: this.data.layout.secondarySquenceNumberSamePos,
        textbg: this.data.layout.secondarySquenceNumbertextbg,
        textbgstyle: this.data.layout.secondarySquenceNumbertextbgstyle,
        textbgcallout: this.data.layout.secondarySquenceNumbertextbgcallout,
        textbgitem: this.data.layout.secondarySquenceNumbertextbgItem,
    });
    this.alignment = this.secondaryLabelAlignment;
    if (this.data.layout.secondaryElementType == "image") {
        this.alignment = this.secondaryLogoAlignment;
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        this.alignment = this.secondarySequenceAlignment;
    }
    if (this.data.layout.secondaryElementType == "number") {
        this.alignment = this.secondaryNumberAlignment;
    }
    labelMaxW = this.data.chartName == "barStackedRectangle" ? this.state.width * 0.2 : this.state.width * 0.3;
    labelMaxH = this.state.height * this.gapPercentage; //this.labelAlignment.vposition == "top" ? this.state.height * 0.4 :

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });
    valueMaxW = this.state.width * 0.3;
    valueMaxH = this.state.height * this.gapPercentage;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
    });

    this.length = this.voData.seriesItemLength;
    if (this.data.chartName == "comparisonModelType2" && this.labelAlignment.hposition == "center") {
        labelMaxH = this.state.height * 0.7;
    }
    if (this.data.sequencenumber) {
        labelMaxH = this.state.height * 0.5;
    }
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2" || this.data.chartName == "comparisonModelType3") this.length = 1;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem.width = this.viewport.width - _oWidth;
    this.rectSeriesItem.height = this.data.chartName == "barStackedRectangle" ? this.viewport.height : this.viewport.height / this.length;
    this.gridBounds = { x: _oWidth, y: 0, width: this.rectSeriesItem.width, height: this.viewport.height };
};

BaseBarSeries.prototype.doMeasurementComputation = function (argprops) {};

BaseBarSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.data.enableHeader && (this.data.layout.labelHeaderTitle || this.data.layout.valueHeaderTitle || this.data.layout.placeholderheder) && this.index == this.data.seriesLength) {
        let element = document.createElement("div");
        element.id = "header-" + this.index;
        element.className = "header overflow ";
        // element.style.height = this.data._headerHeight + "px";
        element.style.maxWidth = "100%";
        // element.dataset.animation = "nodeitem";

        element.style.maxHeight = this.data._headerHeight + "px";
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        let seiesElement = this.parent.querySelector(".series");
        let labelHeader = document.createElement("div");
        let serieslabel = seiesElement.querySelector(".label");
        if (this.data.layout.labelHeaderTitle) {
            labelHeader.innerText = this.data.labelHeader;
            labelHeader.setAttribute("contenteditable", "true");
            labelHeader.setAttribute("data-prompt-text", "Enter Title");
        }
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.style.width = serieslabel ? serieslabel.clientWidth + "px" : "0%";
        labelHeader.style.order = this.labelAlignment.index;
        labelHeader.className = "labelheader labelheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        labelHeader.setAttribute("maxFontSize", 30);
        labelHeader.setAttribute("data-id", "label-header");
        labelHeader.setAttribute("data-slideid", this.data.slideID);
        labelHeader.setAttribute("contenteditable", "true");
        labelHeader.setAttribute("data-dck-selector", "true");
        labelHeader.setAttribute("data-type", "labelheader");
        if (this.data._labelHeaderColor) {
            labelHeader.style.setProperty("color", this.data._labelHeaderColor, "important");
        }
        // labelHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(labelHeader);
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position == "outer") {
            element.appendChild(labelHeader);
        }
        if (this.data.layout.bgTabel) {
            labelHeader.classList.add("enabletable");
        }
        let secondaryHeader = document.createElement("div");
        let secondarylabelElement = seiesElement.querySelector(".secondaryElement");
        secondaryHeader.className = "secondaryheader secondaryheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        if (this.data.layout.placeholderheder) {
            secondaryHeader.innerText = this.data.secondaryHeader;
            secondaryHeader.setAttribute("contenteditable", "true");
            secondaryHeader.setAttribute("data-dck-selector", "true");
            secondaryHeader.setAttribute("data-prompt-text", "Enter Title");
        }
        secondaryHeader.style.order = this.alignment.index;
        secondaryHeader.setAttribute("maxFontSize", 30);
        secondaryHeader.setAttribute("data-id", "secondary-Header");
        secondaryHeader.setAttribute("data-slideid", this.data.slideID);
        secondaryHeader.setAttribute("data-type", "secondaryheader");
        if (this.data._secondaryHeaderColor) {
            secondaryHeader.style.setProperty("color", this.data._secondaryHeaderColor, "important");
        }
        if (this.data.layout.placeholderHeaderHPosition) secondaryHeader.classList.add("header" + this.data.layout.placeholderHeaderHPosition);
        // secondaryHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(secondaryHeader);
        if (this.data.layout.bgTabel) {
            secondaryHeader.classList.add("enabletable");
        }
        secondaryHeader.style.width = secondarylabelElement ? secondarylabelElement.clientWidth + "px" : "0%";
        if (this.alignment.itemBased != "true" && this.alignment.position == "outer" && this.data.layout) {
            element.appendChild(secondaryHeader);
        }

        let seriesItemHeader = document.createElement("div");
        let secondarylabel = seiesElement.querySelector(".seriesitemcond");
        seriesItemHeader.className = "secondaryitemheader itemheadercolor " + this.ChartFonts.secondaryLabelThemeClassName;
        seriesItemHeader.style.order = this.data.layout.itemPosIndex;
        if (this.data.layout.itemHeader) {
            seriesItemHeader.innerText = this.data.itemHeader;
            seriesItemHeader.setAttribute("data-prompt-text", "Enter Title");
            seriesItemHeader.setAttribute("contenteditable", "true");
            seriesItemHeader.setAttribute("data-dck-selector", "true");
        }
        seriesItemHeader.style.width = secondarylabel ? secondarylabel.clientWidth + "px" : "0%";
        seriesItemHeader.setAttribute("maxFontSize", 30);
        seriesItemHeader.setAttribute("data-id", "item-Header");
        seriesItemHeader.setAttribute("data-slideid", this.data.slideID);
        seriesItemHeader.setAttribute("data-type", "itemheader");
        if (this.data._itemHeaderTextColor) {
            seriesItemHeader.style.setProperty("color", this.data._itemHeaderTextColor, "important");
        }
        if (this.data.layout.itemHeaderHPosition) seriesItemHeader.classList.add("header" + this.data.layout.itemHeaderHPosition);
        // seriesItemHeader.setAttribute("data-animation", "yaxistitle");
        this.ChartHelper.setTextChangeListner(seriesItemHeader);
        element.appendChild(seriesItemHeader);
        if (this.data.layout.bgTabel) {
            seriesItemHeader.classList.add("enabletable");
        }
        // if (this.parent) this.parent.appendChild(element);
        this.parent.insertBefore(element, this.parent.firstChild);
    } else {
        let parentLevelNumberingClass = "";
        if (this.data.layout.sequenceGrandparentcls && this.data.sequencenumber) {
            parentLevelNumberingClass = this.data.layout.sequenceGrandparentcls;
        }

        let moveY = this.viewport.y;
        let customColorIndex = this.ChartFonts.customColor(this.index);
        let element = document.createElement("div");
        element.id = "series-" + this.index;
        element.dataset.dckSelector = true;
        element.className = "series overflow accent" + customColorIndex + " clsMultiColorParent " + parentLevelNumberingClass;
        element.style.height = this.state.height + "px";
        element.style.position = "relative";
        element.dataset.index = this.index;
        element.style.maxWidth = "100%";
        // element.dataset.animation = "nodeitem"
        element.style.maxHeight = this.state.height + "px";
        element.setAttribute("data-width", this.state.width);
        element.setAttribute("data-height", this.state.height);
        if (this.data.indualHighlight || this.data.highlightDifference.display) {
            this.parent.style.position = "relative";
        }
        if (this.data._seriesItemLength == 1 || this.data.chartName == "barStackedRectangle") {
            element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
            element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
        } else {
            if (this.data.chartName != "barStackedRectangle") {
                element.className = "series overflow accent" + customColorIndex + " clsMultiColorParent " + parentLevelNumberingClass;
                element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
                element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
            }
        }
        if (this.voData.arrHyperlinkUrl[this.index]) {
            element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
        }
        if (this.data.layout.itemSpace) {
            this.parent.style.justifyContent = "space-between";
        }
        if (this.parent) this.parent.appendChild(element);
        if (this.svgAsset) {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.classList.add("clsChartEmphasisSVGDisabled");
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.classList.add("clsChartEmphasisSVGEnabled");
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("clsChartProjectionSVGEnabled");
                element.classList.add("projectionEnableGraphic");
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("clsChartProjectionSVGDisabled");
                element.classList.add("projectionDisabledGraphic");
            }
        } else if (this.data.grapicImage[this.index] == "true") {
            if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                element.classList.add("clsChartEmphasisImageDisabled");
            }
            if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                element.classList.add("clsChartEmphasisImageEnabled");
            }
            if (this.data.projection[this.index] == true && this.data.hasProjection) {
                element.classList.add("clsChartProjectionImageEnabled");
                element.classList.add("projectionEnableGraphic");
            }
            if (this.data.projection[this.index] != true && this.data.hasProjection) {
                element.classList.add("clsChartProjectionImageDisabled");
                element.classList.add("projectionDisabledGraphic");
            }
        } else {
            if (this.data.chartName == "columnSimpleCoin") {
                if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                    element.classList.add("clsChartEmphasisImageDisabled");
                }
                if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                    element.classList.add("clsChartEmphasisImageEnabled");
                }
                if (this.data.projection[this.index] == true && this.data.hasProjection) {
                    element.classList.add("clsChartProjectionEnabled");
                    element.classList.add("projectionEnableGraphic");
                }
                if (this.data.projection[this.index] != true && this.data.hasProjection) {
                    element.classList.add("clsChartProjectionDisabled");
                    element.classList.add("projectionDisabledGraphic");
                }
            } else {
                if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
                    element.classList.add("clsChartEmphasisDisabled");
                }
                if (this.data.hasEmphasis && this.data.emphasis[this.index] == true) {
                    element.classList.add("clsChartEmphasisEnabled");
                }
                if (this.data.projection[this.index] == true && this.data.hasProjection) {
                    element.classList.add("clsChartProjectionEnabled");
                    element.classList.add("projectionEnableGraphic");
                }
                if (this.data.projection[this.index] != true && this.data.hasProjection) {
                    element.classList.add("clsChartProjectionDisabled");
                    element.classList.add("projectionDisabledGraphic");
                }
            }
        }

        // if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
        //     element.classList.add("emphasis");
        // }
        if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "alphaprojection") {
            element.classList.add("emphasis");
        }

        // if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") {
        //     element.classList.add("emphasis");
        // }
        let sameElement = document.createElement("div");
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.justifyContent = "center";
        sameElement.style.alignItems = "center";
        if (this.data.layout.secondarySamePosition) {
            element.appendChild(sameElement);
        }

        if (this.labelAlignment.show && this.labelAlignment.position == "outer" && this.labelAlignment.hposition == "left" && this.labelAlignment.itemBased != "true") {
            this.addlabel = true;
            labelMaxH = element.clientHeight / 2;
            if (this.data.layout.secondarySamePosition) {
                this.doAddLabel(sameElement, argprops, true);
                this.doAddLabel(sameElement, argprops, false, true);
            } else {
                if (this.data.layout.secondaryPosition) {
                    labelMaxH = element.clientHeight;
                    this.doAddLabel(element, argprops, true);
                    // this.s(element, argprops, false);
                } else {
                    labelMaxH = element.clientHeight;
                    this.doAddLabel(element, argprops, true);
                    this.doAddLabel(element, argprops, false);
                }
            }
        }
        if (this.data.sequencenumber) {
            this.alignment = this.secondarySequenceAlignment;
            this.sequenceNumberMaxWidth = this.state.width * 0.1;
            this.doSecondaryLabel(element, argprops, true, true, true);
            this.doSecondaryLabel(element, argprops, false, true, true);
        }
        if (this.data.layout.secondaryElement && this.alignment.itemBased != "true") {
            // if (false) {
            if (this.data.layout.secondaryElementType != "image" && this.data.layout.secondaryElementType != "icon") {
                labelMaxH = element.clientHeight / 2;
                if (this.data.layout.secondaryElementType == "number") {
                    this.alignment = this.secondaryNumberAlignment;
                }
                if (this.data.layout.secondarySamePosition) {
                    this.doSecondaryLabel(sameElement, argprops, true);
                    this.doSecondaryLabel(sameElement, argprops, false, true);
                } else {
                    if (this.data.layout.secondaryPosition) {
                        labelMaxH = element.clientHeight;
                        this.doSecondaryLabel(element, argprops, true);
                        this.doSecondaryLabel(element, argprops, false);
                    } else {
                        this.doSecondaryLabel(element, argprops, true);
                        this.doSecondaryLabel(element, argprops, false, true);
                    }
                }
            }
            if (this.data.layout.secondaryElementType == "image") {
                this.alignment = this.secondaryLogoAlignment;
                if (this.data.layout.secondarySamePosition) {
                    this.doSecondaryImage(sameElement, argprops);
                } else {
                    if (this.data.layout.secondaryPosition) {
                        this.doSecondaryImage(element, argprops);
                    } else {
                        this.doSecondaryImage(element, argprops);
                    }
                }
            }
            if (this.data.layout.secondaryElementType == "ICON") {
                this.alignment = this.secondaryLogoAlignment;
                if (this.data.layout.secondarySamePosition) {
                    this.doSecondaryIcon(sameElement, argprops);
                } else {
                    if (this.data.layout.secondaryPosition) {
                        this.doSecondaryIcon(element, argprops);
                    } else {
                        this.doSecondaryIcon(element, argprops);
                    }
                }
            }
        }
        if (this.valueAlignment.position == "outer" && this.valueAlignment.hposition == "left" && this.valueAlignment.itemBased != "true") {
            this.addvalue = true;
            this.doAddValueElement(element, argprops);
        }
        if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.hposition == "left" && this.placeholderAlignment.itemBased != "true") {
            this.addplaceholder = true;
            const eprops = {
                index: this.index,
                length: this.length,
                placeholdertype: this.data.primaryPlaceholderType[this.index],
                placeholder: this.data.placeholder,
                placeholderpath: this.data.placeholderpath,
            };
            this.doAddPrimaryPlaceholder(element, eprops);
        }
        if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

        let subelement = document.createElement("div");
        subelement.id = "seriesitemcond-" + this.index;
        subelement.className = "seriesitemcond overflow";
        subelement.style.order = this.data.layout.itemPosIndex;
        subelement.style.position = "relative";
        if (this.data.layout.multiSeriesItemSize) {
            let heightValue = parseFloat(this.data.layout.multiSeriesItemSize) * this.data.seriesItemLength;
            let gapValue = this.data.layout.multiseriesGapValue * (this.data.seriesItemLength - 1);
            let totalHeight = heightValue + gapValue;
            subelement.style.height = totalHeight + "px";
            subelement.setAttribute("data-height", totalHeight);
        } else {
            subelement.style.height = this.gapPercentage * 100 + "%";
        }
        // subelement.style.width = this.rectSeriesItem.width + "px";
        if (element) element.appendChild(subelement);
        if (this.data.layout.bgTabel) {
            subelement.style.height = 100 + "%";
            subelement.classList.add("enabletable");
        }
        let stackElement;
        if (this.data.chartName == "barStackedRectangle") {
            // const numMultpleFactor = this.state.width / this.data.stackSeriesvalueTotal[this.index];
            const numWidth = this.data.stackSeriesvalueTotal[this.index] / this.data.maxStackValueTotal; //this.data.maxStackValueTotal * numMultpleFactor;
            stackElement = document.createElement("div");
            stackElement.id = "stackitemcond-" + this.index;
            stackElement.className = "stackitemcond overflow";
            stackElement.style.height = 100 + "%";
            stackElement.style.display = "flex";
            stackElement.style.width = this.data.data.getAttribute("data-stackpercentage") ? "100%" : numWidth * 100 + "%";
            subelement.appendChild(stackElement);
            // if (this.data.layout.itemShadow) {
            //     stackElement.classList.add(this.data.layout.itemShadow);
            // }
            if (this.data.layout.itemOpacityClass) {
                stackElement.style.opacity = this.data.layout.itemOpacity;
                stackElement.dataset.customopacity = this.data.layout.itemOpacity;
            }
        }

        for (let i1 = 0; i1 < this.length; i1++) {
            let eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
            let itemElement = this.data.chartName == "barStackedRectangle" ? stackElement : subelement;
            let seriesItem = this.seriesItemInstance(itemElement, eProps);
            seriesItem.ChartHelper = this.ChartHelper;
            seriesItem.ChartUtils = this.ChartUtils;
            seriesItem.move(this.rectSeriesItem.x, moveY);
            seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
            seriesItem.data = this.data;
            this.items[i1] = seriesItem;
            moveY += this.rectSeriesItem.height;
        }
    }
};

BaseBarSeries.prototype.labellayoutClassName = function (itemname) {
    let lLayoutName = itemname;
    if (lLayoutName.includes("graphic") && this.labelAlignment.position == "inner") {
        lLayoutName = "inset" + lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    } else {
        if (lLayoutName.includes("label") && this.labelAlignment.itemBased == "true") lLayoutName = "itembased" + lLayoutName;
        lLayoutName = lLayoutName + this.labelAlignment.hposition + this.labelAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") lLayoutName = lLayoutName + "valuecontainer valuebackground";
    return lLayoutName;
};

BaseBarSeries.prototype.doAddLabel = function (argparent, argprops, boolMax = false, disableHeight = false) {
    if (this.data.layout.showLabel) {
        if (this.index == 0) {
            this.data.fontClassName = "";
        }
        let vLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        let comparisonId = this.data.chartName == "comparisonModelType3" && this.index >= this.data.seriesLength / 2 ? "comparisonlabel-text-" : "label-text-";
        element.id = comparisonId + this.index;
        element.className = this.data.fontClassName ? "label moodanimation " + vLayoutName + " " + this.data.fontClassName : "label moodanimation " + vLayoutName + " " + this.ChartFonts.dynamiclabelThemeClassName(this.index);
        element.style.minWidth = 10 + "px";
        element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";
        if (this.data.labelHeaderWidth) {
            element.dataset.headerWidthTitle = this.data.labelHeaderWidth;
        }
        element.setAttribute("data-textalign", "horizantal");
        element.dataset.animation = "primarytext";
        element.style.order = this.data.enableSequecelabel ? 1 : this.labelAlignment.index;
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";

        if (this.data.chartFlip) {
            element.style.paddingRight = this.data.layout.labelPaddingleft + "px";
            element.style.paddingLeft = this.data.layout.labelPaddingright + "px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        if (argparent) {
            argparent.appendChild(element);
        } else return element;
        if (this.data.layout.bgTabel) {
            element.classList.add("enabletable");
        }
        if (this.data.layout.labelfontsize) {
            element.style.fontSize = this.maxLabelFontSize[this.arrIndex] + "px";
        }
        let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.ChartFonts.labelOuterColor;
        if (!this.data.layout.labelColor) {
            this.labelStyle = "";
        }
        let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.index;
        if (this.data.arrLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.index], "");
        if (this.data.arrLabelTextSize[this.index]) subelement.style.setProperty("font-size", this.data.arrLabelTextSize[this.index], "");
        if (this.data.arrLabeltexttransform[this.index]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.index], "");
        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.index];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.index);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        if (this.data._labelTextColor[this.index]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.index], "important");
        }
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
        if (this.data.hasEmphasis || this.data.hasProjection) {
            subelement.classList.add("clsLabelText");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.index);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        if (this.data.presentMode) {
            subelement.setAttribute("contenteditable", "false");
            subelement.setAttribute("data-dck-selector", "true");
        }
        let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(this.index, this.voData.seriesLength / 2) : this.index;
        subelement.setAttribute("data-id", valGroupIndex);
        let comparisonType = this.data.chartName == "comparisonModelType3" && this.index >= this.data.seriesLength / 2 ? "comparisonlabel" : "label";
        subelement.setAttribute("data-type", comparisonType);
        element.appendChild(subelement);
        let labelThemeClassName = this.calculateFontClass(subelement, this.data.labels[this.index], this.ChartFonts.labelThemeClassName);
        if (labelThemeClassName) {
            this.data.fontClassName = labelThemeClassName;
            this.changeFontFamily(subelement, labelThemeClassName, this.ChartFonts.labelThemeClassName);
        }
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                    element.style.paddingBottom = "15px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = "15px";
                    element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
            }
        } else if (this.labelAlignment.position == "inner") {
            subelement.classList.add("titleColorBg");
        } else {
            subelement.classList.add("transparentBg");
        }
        if (this.data.labelLineHeight[this.index]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.index];
        }
        if (this.data.labelLetterSpace[this.index]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.index] + "em";
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        element.style.height = labelMaxH + "px";
        let minReduceFonFize = this.ChartFonts.maxLabelFontSize(element);
        if (this.maxLabelFontSize[this.arrIndex] > labelMaxH && this.data.seriesLength > 12) {
            minReduceFonFize = 4;
        }
        // subelement.style.lineHeight = "1";
        this.ChartHelper.adjustFontSize(subelement, 10, minReduceFonFize, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        // subelement.style.removeProperty("line-height");
        if (boolMax) {
            this.rectSeriesItem.width -= element.clientWidth;
            argparent.removeChild(element);
        }
        if (this.data.chartName == "comparisonModelType2") {
            subelement.style.overflow = "hidden";
        }

        if (this.data.layout.bgTabel) {
            element.style.height = "100%";
            element.style.maxHeight = "100%";
        }
        if (disableHeight) {
            element.style.height = "auto";
        }
    }
};
BaseBarSeries.prototype.calculateFontClass = function (subelement, labelText, fontFamiy) {
    let boolhasNextLine = labelText.includes("<br>") || labelText.includes("<div>");
    let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : 1;
    let elementHeight = subelement.clientHeight;
    let lineCount = Math.floor(elementHeight / lineHeight);
    if (lineCount == 1 && boolhasNextLine) {
        let countValue = parseInt(fontFamiy.match(/\d+/)[0]);
        return "p" + (countValue + 1);
    } else {
        return null;
    }
};
BaseBarSeries.prototype.doSecondaryLabel = function (argparent, argprops, boolMax = false, disableHeight = false, sequencenumber = false) {
    let llayoutname = this.labellayoutClassName("label");
    let element = document.createElement("div");
    let themeClass = sequencenumber && !this.data.presentMode ? "n1" : this.ChartFonts.secondaryLabelThemeClassName;
    element.className = sequencenumber ? "secondaryElement secondarylabel moodanimation " + themeClass + " " + llayoutname + " " + this.data.layout.sequenceParentGlopalcls : "secondaryElement secondarylabel moodanimation " + themeClass + " " + llayoutname;
    element.id = "secondary-text-" + this.index;
    if (sequencenumber) {
        let numberSize = argparent.clientHeight > 48 ? 48 : argparent.clientHeight;
        element.style.setProperty("--numbersize", numberSize + "px");
    }
    if (!sequencenumber) {
        element.style.minWidth = sequencenumber ? labelMaxH + "px" : 10 + "px";
        element.style.height = labelMaxH + "px";
        element.style.maxWidth = this.sequenceNumberMaxWidth + "px";
        element.style.maxHeight = labelMaxH + "px";
    }
    element.setAttribute("data-textalign", "horizantal");
    element.style.order = sequencenumber ? 0 : this.alignment.index;
    element.dataset.animation = "secondarylabel";
    if (!sequencenumber) {
        element.style.paddingLeft = this.data.layout.secondaryLabelPaddingleft + "px";
        element.style.paddingRight = sequencenumber ? "15px" : this.data.layout.secondaryLabelPaddingright + "px";
        element.style.paddingTop = this.data.layout.secondaryLabelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.secondaryLabelPaddingbottom + "px";
    }
    if (this.data.chartFlip) {
        if (sequencenumber) {
            element.style.marginRight = this.data.layout.secondaryLabelPaddingleft + "px";
            element.style.marginLeft = sequencenumber ? "15px" : this.data.layout.secondaryLabelPaddingright + "px";
        } else {
            element.style.paddingRight = this.data.layout.secondaryLabelPaddingleft + "px";
            element.style.paddingLeft = sequencenumber ? "15px" : this.data.layout.secondaryLabelPaddingright + "px";
        }
    }

    if (this.data.layout.secondaryLabelPaddingClass) {
        element.classList.add(this.data.layout.secondaryLabelPaddingClass);
    }
    if (argparent) {
        argparent.appendChild(element);
    } else return element;
    if (this.data.layout.bgTabel) {
        element.classList.add("enabletable");
    }
    let subelement = document.createElement("div"); //this.ChartHelper.createDivElement({}); //
    let tempClassName = this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;
    subelement.className = sequencenumber ? "secondarylabeltext " + this.ChartFonts.labelOuterColor + " " + this.data.layout.sequenceChildGlopalcls : "secondarylabeltext " + this.data.clsLabelTextColor + this.ChartFonts.labelOuterColor;
    subelement.id = "labeltext-" + this.index;
    if (this.data.arrLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.index], "");
    if (this.data.arrLabelTextSize[this.index]) subelement.style.setProperty("font-size", this.data.arrLabelTextSize[this.index], "");
    subelement.innerHTML = boolMax ? this.data.secondarylongLabel : this.data.secondaryText[this.index];
    if (sequencenumber) {
        subelement.innerHTML = this.ChartUtils.getSeqNumber(this.data.moodData, this.index + 1);
    }
    if (!sequencenumber) {
        subelement.style.maxWidth = this.sequenceNumberMaxWidth + "px";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
    }
    if (this.data.arrSecondaryLabelOpacity[this.index]) subelement.style.setProperty("opacity", this.data.arrSecondaryLabelOpacity[this.index], "");
    if (!sequencenumber) subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", this.index);
    subelement.setAttribute("data-prompt-text", "Enter secondaryText");
    subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.index);
    if (this.data.presentMode || sequencenumber) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if (this.data.layout.secondaryElementType == "number") {
        subelement.setAttribute("data-prompt-text", "Enter Number");
        // subelement.setAttribute("onkeypress","return isNumberKey(event)")
    } else {
        subelement.removeAttribute("data-secondaryType");
    }

    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(this.index, this.voData.seriesLength / 2) : this.index;
    subelement.setAttribute("data-id", valGroupIndex);
    subelement.setAttribute("data-type", "secondarylabel");
    element.appendChild(subelement);
    if (this.alignment.textbg == "true") {
        subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
        if (this.labelAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.labelAlignment.vposition == "bottom") {
                element.style.paddingTop = this.data.layout.labelPaddingtop + 15 + "px";
                element.style.paddingBottom = "15px";
            } else if (this.labelAlignment.vposition == "top") {
                element.style.paddingTop = "15px";
                element.style.paddingBottom = this.data.layout.labelPaddingbottom + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.labelAlignment.textbgstyle + this.labelAlignment.vposition);
        }
    } else if (this.alignment.position == "inner") {
        subelement.classList.add("titleColorBg");
    } else {
        subelement.classList.add("transparentBg");
    }
    let minReduceFonFize = this.ChartFonts.minFontSize;
    if (!sequencenumber) this.ChartHelper.setTextChangeListner(subelement);
    if (sequencenumber && parseFloat(this.ChartFonts.maxLabelFontSize(element)) > labelMaxH) {
        minReduceFonFize = 4;
    }
    if (sequencenumber) {
        subelement.setAttribute("data-type", "sequencenumber");
    }
    if (this.data._secondaryTextColor[this.index]) {
        subelement.style.setProperty("color", this.data._secondaryTextColor[this.index], "important");
    }
    // if(sequencenumber){
    //     minReduceFonFize = parseFloat(this.ChartFonts.maxLabelFontSize(element))
    // }
    this.ChartHelper.adjustFontSize(subelement, 10, minReduceFonFize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, minReduceFonFize, this.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement);
    this.ChartHelper.recalculateMaxHeight(subelement);

    // if (sequencenumber && parseFloat(this.ChartFonts.maxLabelFontSize(element)) > labelMaxH) {
    //     element.style.fontSize = parseFloat(this.ChartFonts.maxLabelFontSize(element))+"px";
    // }
    if (sequencenumber) {
        subelement.style.removeProperty("font-size");
    }
    if (boolMax) {
        this.rectSeriesItem.width -= subelement.clientWidth;
        argparent.removeChild(element);
    }
    if (this.data.chartName == "comparisonModelType2") {
        subelement.style.overflow = "hidden";
    }
    if (disableHeight && !sequencenumber) {
        element.style.height = "auto";
    }
    if (this.data.layout.bgTabel) {
        element.style.height = "100%";
        element.style.maxHeight = "100%";
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        subelement.style.minWidth = "90px";
        subelement.style.textAlign = "center";
    }
};
BaseBarSeries.prototype.doSecondaryImage = function (element, argprops) {
    this.thicknessPercentage = this.data.layout.itemthickness && this.data.seriesItemLength < 2 ? this.data.layout.itemthickness : 1;

    let gapPercentage = this.gapPercentage * this.thicknessPercentage * 0.8;
    let BaseParentDiv = document.createElement("div");
    BaseParentDiv.style.width = "150px";
    BaseParentDiv.style.height = "100%";
    BaseParentDiv.style.order = this.alignment.index;
    BaseParentDiv.style.paddingLeft = this.data.layout.secondaryLogoPaddingleft + "px";
    BaseParentDiv.style.paddingRight = this.data.layout.secondaryLogoPaddingright + "px";
    BaseParentDiv.style.paddingTop = this.data.layout.secondaryLogoPaddingtop + "px";
    BaseParentDiv.style.paddingBottom = this.data.layout.secondaryLogoPaddingbottom + "px";
    if (this.data.chartFlip) {
        BaseParentDiv.style.paddingLeft = this.data.layout.secondaryLogoPaddingright + "px";
        BaseParentDiv.style.paddingRight = this.data.layout.secondaryLogoPaddingleft + "px";
    }
    BaseParentDiv.style.position = "unset";
    BaseParentDiv.style.display = "flex";
    BaseParentDiv.style.alignItems = "center";
    BaseParentDiv.id = "secondaryplaceholdergraphic-" + this.index + "_0";
    element.appendChild(BaseParentDiv);
    if (this.data.layout.bgTabel) {
        BaseParentDiv.classList.add("enabletable");
    }
    let parentDiv = document.createElement("div");
    parentDiv.style.width = "150px";
    parentDiv.style.height = gapPercentage * 100 + "%";
    parentDiv.style.order = this.alignment.index;
    BaseParentDiv.appendChild(parentDiv);
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.src = this.data.secondaryPlaceholderPath[this.index];
    subelement.style.pointerEvents = "all";
    subelement.id = "secondaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "secondaryElement";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    parentDiv.appendChild(subelement);

    let item = this.ChartUtils.getOffsetLeftTop(element);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    let BgStyle = "rgba(var(--item" + 1 + "-color-rgb),1)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "rgba(var(--item" + 5 + "-color-rgb),1)";
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "rgba(var(--tertiary-color-rgb),1)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey") {
        BgStyle = "rgba(var(--item" + this.index + "-color,1)";
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
    if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        element.style.position = "relative";
        this.ChartUtils.applyOverlayToImage(subelement, BgStyle);
    }
};
BaseBarSeries.prototype.doSecondaryIcon = function (argparent, argprops) {
    this.thicknessPercentage = this.data.layout.itemthickness && this.data.seriesItemLength < 2 ? this.data.layout.itemthickness : 1;

    let gapPercentage = this.gapPercentage * this.thicknessPercentage * 0.8;
    let BaseParentDiv = document.createElement("div");
    BaseParentDiv.style.width = "150px";
    BaseParentDiv.style.height = "100%";
    BaseParentDiv.style.order = this.alignment.index;
    BaseParentDiv.style.paddingLeft = this.data.layout.secondaryLogoPaddingleft + "px";
    BaseParentDiv.style.paddingRight = this.data.layout.secondaryLogoPaddingright + "px";
    BaseParentDiv.style.paddingTop = this.data.layout.secondaryLogoPaddingtop + "px";
    BaseParentDiv.style.paddingBottom = this.data.layout.secondaryLogoPaddingbottom + "px";
    if (this.data.chartFlip) {
        BaseParentDiv.style.paddingLeft = this.data.layout.secondaryLogoPaddingright + "px";
        BaseParentDiv.style.paddingRight = this.data.layout.secondaryLogoPaddingleft + "px";
    }
    BaseParentDiv.style.position = "unset";
    BaseParentDiv.style.display = "flex";
    BaseParentDiv.style.alignItems = "center";
    BaseParentDiv.id = "secondaryplaceholdergraphic-" + this.index + "_0";
    argparent.appendChild(BaseParentDiv);
    if (this.data.layout.bgTabel) {
        BaseParentDiv.classList.add("enabletable");
    }
    let parentDiv = document.createElement("div");
    parentDiv.style.width = "150px";
    parentDiv.style.height = gapPercentage * 100 + "%";
    parentDiv.style.order = this.alignment.index;
    BaseParentDiv.appendChild(parentDiv);
    let SVGUtils = new window["SVGUtils"]();
    let element = SVGUtils.createSVGElement("svg");
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode",
        "data-nodetype": "iconNode",
        id: "placeholder-" + this.index + "_0",
        width: "100%",
        height: "100%",
    });
    parentDiv.style.display = "flex";
    parentDiv.style.alignItems = "center";
    parentDiv.style.justifyContent = "center";

    let fillClass = this.ChartFonts.graphicFillColor(this.index);
    if (this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") {
        fillClass = "clsAlterTertiaryColor";
    } else {
        if (
            (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
            (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
        ) {
            fillClass = "clsTertiaryFill";
        }
    }
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode " + fillClass,
    });
    console.log("secondary");
    let subelement = SVGUtils.createSVGElement("use");
    SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.index + "_0",
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-placeholderelement": "icon,image",
        "data-id": this.index + "_0",
        "data-type": "ICON",
        "data-name": this.data._secondaryPlaceholderName[this.index],
        "data-iconpath": this.data.secondaryPlaceholderPath[this.index],
        "xlink:href": "#" + this.data._secondaryPlaceholderName[this.index],
    });
    element.appendChild(subelement);
    parentDiv.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    parentDiv.appendChild(overLayDiv);
};
BaseBarSeries.prototype.valuelayoutClassName = function (itemname) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
    }
    if (this.data.chartName == "barSimpleTwoPointStyle2" || this.data.chartName == "barSimpleTwoPointStyle3") vLayoutName = vLayoutName + "valuecontainer valuebackground";
    return vLayoutName;
};

BaseBarSeries.prototype.doAddValueElement = function (argparent, argprops, boolmax = false) {
    const index = 0;
    const groupindex = this.index;
    let valIndex = this.data.chartName == "comparisonModelType3" ? (groupindex < this.voData.seriesLength / 2 ? 0 : 1) : index;
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;

    let vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});

    element.id = "value-text-" + valGroupIndex + "_" + valIndex;
    element.style.minWidth = 10 + "px";
    element.style.height = valueMaxH + "px";
    element.style.maxWidth = valueMaxW + "px";
    element.style.maxHeight = valueMaxH + "px";
    element.className = "value " + vLayoutName;
    if (this.valueBackground) {
        element.className = "value " + vLayoutName + " " + this.ChartFonts.graphicColor;
        element.style.left = "20px";
    }

    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", "value", hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " " + this.valueStyle + " " + this.ChartFonts.valueThemeClassName + " moodanimation";
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + this.ChartFonts.valueThemeClassName + " moodanimation";
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("clsInnerTextColor");
        subelement.classList.add("clsInnerTextColor");
    }
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    subelement.id = "valuetext-" + valGroupIndex + "_" + valIndex;
    subelement.innerText = this.data.prefix[this.index][0] + this.data.valuesDenomination[this.index][0] + this.data.suffix[this.index][0];
    subelement.style.maxWidth = valueMaxW + "px";
    subelement.style.maxHeight = valueMaxH + "px";
    subelement.style.fontSize = this.ChartFonts.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[valGroupIndex + " " + valIndex];
    subelement.setAttribute("maxFontSize", this.ChartFonts.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + valIndex);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.dataset.animation = "secondarytext";
    if (this.data.presentMode) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    element.appendChild(subelement);
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            // if (this.valueAlignment.hposition == "right") {
            //     element.style.paddingTop = this.data.layout.valuePaddingtop + 15 + "px";
            //     element.style.paddingBottom = "15px";
            // } else if (this.valueAlignment.hposition == "left") {
            //     element.style.paddingTop = "15px";
            //     element.style.paddingBottom = this.data.layout.valuePaddingbottom + 15 + "px";
            // }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);

    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.valueTextColor[valGroupIndex][valIndex]) {
        subelement.style.setProperty("color", this.data.valueTextColor[valGroupIndex][valIndex], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.ChartFonts.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxValueFontSize[this.arrIndex] - this.ChartFonts.minFontSize, this.ChartFonts.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    if (boolmax) {
        this.currentValW = element.clientWidth;
        element.remove();
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);

        if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
            if (this.data.suffixStyle) {
                let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
                if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
            }
            if (this.data.prefixStyle) {
                let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
                if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
            }
        }
    }
};

BaseBarSeries.prototype.doAddPrimaryPlaceholder = function (argparent, argprops) {
    const index = argprops.index;
    const bounds = this.getPlaceholderBounds();
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.marginLeft = this.data.layout.placeholderPaddingleft + "px";
    baseelement.style.marginRight = this.data.layout.placeholderPaddingright + "px";
    baseelement.style.marginTop = this.data.layout.placeholderPaddingtop + "px";
    baseelement.style.marginBottom = this.data.layout.placeholderPaddingbottom + "px";
    if (this.data.chartFlip) {
        baseelement.style.marginLeft = this.data.layout.placeholderPaddingright + "px";
        baseelement.style.marginRight = this.data.layout.placeholderPaddingleft + "px";
        if (this.data.layout.placeholderAlterPaddingClass) {
            baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
        }
    } else {
        if (this.data.layout.placeholderAlterPaddingClass && this.data.chartFlip) {
            baseelement.classList.add(this.data.layout.placeholderAlterPaddingClass);
        } else {
            if (this.data.layout.placeholderPaddingClass) {
                baseelement.classList.add(this.data.layout.placeholderPaddingClass);
            }
        }
    }

    baseelement.style.position = "relative";
    // baseelement.className =this.data.layout.placholderGlopalStyle;
    // baseelement.style.overflow = "hidden";
    // baseelement.classList.add("chartclsContentNode");
    let customColorIndex = this.data.seriesItemLength > 1 ? 1 : this.ChartFonts.customColor(this.index);
    baseelement.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    baseelement.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    baseelement.classList.add("contentContainer");
    baseelement.classList.add("clsMultiColorParent");
    baseelement.setAttribute("data-nodetype", "contentContainer");
    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");
    if (argparent) argparent.appendChild(baseelement);

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);

    const element = this.ChartHelper.createDivElement({});
    element.id = "primaryplaceholder-" + index;
    element.className = "primaryplaceholder topprimaryplaceholder";
    element.style.position = "relative";
    element.style.zIndex = "1";
    element.style.height = this.data.layout.placholderHeight && this.data.layout.placholderHeight < bounds.height ? this.data.layout.placholderHeight * this.data.placeholderSizeRatio + "px" : bounds.height * this.data.placeholderSizeRatio + "px";
    element.style.minWidth = this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    element.style.width = this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : bounds.width * this.data.placeholderSizeRatio + "px";
    baseelement.appendChild(element);
    if (this.data.layout.boolplaceholderShape) {
        /// this.bgProperties(element)
    }
    let type = argprops.placeholdertype ? argprops.placeholdertype.toLowerCase() : "";
    let logoBounds = this.getLogoBounds();
    if (((type == "logo" && !this.data._hasIconLogoNode) || (this.data.hasLogoPlaceholder && !this.data._hasIconLogoNode)) && logoBounds) {
        element.style.height = this.data.layout.placholderHeight && this.data.layout.placholderHeight < logoBounds.height ? this.data.layout.placholderHeight * this.data.placeholderSizeRatio + "px" : logoBounds.height * this.data.placeholderSizeRatio + "px";
        element.style.minWidth = this.data.layout.placholderWidth && this.data.layout.placholderWidth < logoBounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : logoBounds.width * this.data.placeholderSizeRatio + "px";
        element.style.width = this.data.layout.placholderWidth && this.data.layout.placholderWidth < logoBounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio + "px" : logoBounds.width * this.data.placeholderSizeRatio + "px";
    } else {
        this.rectSeriesItem.width -= this.data.layout.placholderWidth && this.data.layout.placholderWidth < bounds.width ? this.data.layout.placholderWidth * this.data.placeholderSizeRatio : bounds.width * this.data.placeholderSizeRatio;
    }
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops);
            this.setBorderWidth(baseelement);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            this.setImageBorderWidth(baseelement);
            break;
        case "logo":
            if (this.data.layout.arrplacholderGlopalStyle.length > 2) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[2]);
            this.doAddLogoUseNodeElement(element, argprops, "logo");
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

