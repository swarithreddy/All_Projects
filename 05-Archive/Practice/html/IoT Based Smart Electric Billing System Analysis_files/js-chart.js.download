function BaseSeriesItem(argparent, argprops) {
    this.voData = null;
    this.name = "BaseSeries";
    this.index = argprops.index;
    this.groupindex = argprops.groupindex;
    DComponent.call(this, argparent, argprops);

}
BaseSeriesItem.prototype = Object.create(DComponent.prototype);
BaseSeriesItem.prototype.constructor = BaseSeriesItem;

BaseSeriesItem.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doElementsComputation();
    }
}

BaseSeriesItem.prototype.updateBasicData = function () {
    this.seriesItemLength = this.voData.seriesItemLength;
}
BaseSeriesItem.prototype.checkMaxLabelLineHeight = function (parentNode, labelMaxHeight) {
    let dummeyDivElement = document.createElement("div");
    let labelFontStyle = this.data.arrLabelFontStyle[0]?this.data.arrLabelFontStyle[0]:this.ChartFonts.labelThemeClassName;
    dummeyDivElement.className = labelFontStyle;
    parentNode.appendChild(dummeyDivElement);
    let lineHeight = window.getComputedStyle(dummeyDivElement)["line-height"];
    if (lineHeight) {
        parentNode.removeChild(dummeyDivElement);
        let totalLineHeight = parseFloat(lineHeight) * 3;
        if (labelMaxHeight < totalLineHeight) {
            return totalLineHeight
        } else {
            return labelMaxHeight
        }
    } else {
        return labelMaxHeight
    }
}
BaseSeriesItem.prototype.valuebgProperties = function (element) {
    if (this.data.layout.valuebgShapeType == "circle") {
        element.style.borderRadius = "50%"
    }
    if (this.data.layout.valuebgShapeType == "square") {
        element.style.borderRadius = "0"
    }
    if (this.data.layout.valuebgStyle == "border") {
        if (this.data.layout.valuebgBorderSize) {
            element.style.border = this.data.layout.valuebgBorderSize + "px solid";
            element.style.setProperty("--border-width", this.data.layout.valuebgBorderSize + "px", "");
        } else {
            element.style.setProperty("--border-width", "2px", "");
            element.style.border = "2px solid"
        }
        let strBordeClass = this.getBgColorDetails(this.groupindex, this.data.ChartFonts.appendgraphicBorderColor(this.groupindex), this.data.layout.valuebgBorderColor, "bordercolor")
        if (this.data.layout.valuebgBorderColor == "gradient") {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                element.classList.add("bordergradient")
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("tertiary-border-color")
            } else {
                if (this.data.layout.valueBgBorderOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBordeClass, this.groupindex, this.data.layout.valueBgBorderOpacity);
                    element.style.borderColor = rgbavalue;
                } else {
                    element.classList.add(strBordeClass)
                }
            }
        }
    }
    if (this.data.layout.valuebgBgColor) {
        let strBgClass = this.getBgColorDetails(this.groupindex, "clsNodeTertiarybg", this.data.layout.valuebgBgColor, "bgcolor")
        if (this.data.layout.valuebgBgColor == "gradient") {
            if ((this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                element.classList.add("gradient")
            }
        } else {
            if ((this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") || (this.data.hasEmphasis && this.data.emphasis[this.groupindex] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))) {
                element.classList.add("clsNodeTertiarybg")
            } else {
                if (this.data.layout.valuebgOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(strBgClass, this.groupindex, this.data.layout.valuebgOpacity);
                    element.style.background = rgbavalue;
                } else {
                    element.classList.add(strBgClass)
                }
            }
        }
    }
    if (this.data.layout.valuebgRadius) {
        let borderRadiuslefttop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 0 ? this.data.layout.valuebgRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 1 ? this.data.layout.valuebgRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 2 ? this.data.layout.valuebgRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.valuebgRadius && this.data.layout.valuebgRadius.length > 3 ? this.data.layout.valuebgRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
}

BaseSeriesItem.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient"
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "quaternary":
            if (fillProperty == "color") {
                return "clsQuaternaryColor";
            }else{
                return "clsQuaternaryBg"
            }
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor") && styleProperty == "multiple") {
                        let colorValue = groupindex != 0 ? 5 : groupindex
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
