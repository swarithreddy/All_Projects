    this.name = "SimpleScaleBarSeries";
    BaseBarSeries.call(this, argparent, argprops);
    this.svgAsset = true;
}
SimpleScaleBarSeries.prototype = Object.create(BaseBarSeries.prototype);
SimpleScaleBarSeries.prototype.constructor = SimpleScaleBarSeries;

