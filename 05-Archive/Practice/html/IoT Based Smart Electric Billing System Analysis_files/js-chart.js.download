        this.valueHeaderIndex = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("index") ? this.data.value.header.index : "0";

        this.valueCalculateTitle = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("calculatevalue") ? this.data.value.header.calculatevalue : "";
