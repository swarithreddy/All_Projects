    this.projectionTextTransform = this._data.getAttribute("projectiontexttexttransform") ? this._data.getAttribute("projectiontexttexttransform") : "";
    this.chartTitleTextSize = this._data.getAttribute("titletexttextsize") ? this._data.getAttribute("titletexttextsize") : "";
    this._lineHighlightPoint = this.voLayout.highlightStyleStyle == "style1";
    this._lineHighlightPointStyle1 = this.voLayout.highlightStyleStyle == "style2";
    this._indualHighlight = this._data.getAttribute("data-indualhighlight") ? this._data.getAttribute("data-indualhighlight") == "true" : false;
    this._indualHighlight = this._data.getAttribute("indualhd") && this._data.getAttribute("indualhd") == "true" ? true : this._indualHighlight;
    this._indualHighlightReverse = this._data.getAttribute("indualhdrev") ? this._data.getAttribute("indualhdrev") : "end";
    this._indualHighlightDisplayFormat = this._data.getAttribute("hddisplayformat") ? this._data.getAttribute("hddisplayformat") : "percentage";
    this._projectionText = this._data.getAttribute("projectiontext") ? this._data.getAttribute("projectiontext") : "";
    this._itemHeaderAlign = this._data.getAttribute("itemheaderalign") ? this._data.getAttribute("itemheaderalign") : "";
    this._secondaryHeaderAlign = this._data.getAttribute("secondaryheaderalign") ? this._data.getAttribute("secondaryheaderalign") : "";
