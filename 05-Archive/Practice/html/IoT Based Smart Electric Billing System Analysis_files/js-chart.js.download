ChartBuilder.prototype.changeMenuMoodsData = function (objDetails, xmldata) {
    let xmlData = objDetails.slideContent && objDetails.slideContent.querySelector(".chartbase") ? objDetails.slideContent.querySelector(".chartbase") : "";
    let graphicName = objDetails.slideContent && objDetails.slideContent.querySelector(".chartbase") ? objDetails.slideContent.querySelector(".chartbase").getAttribute("graphicname") : "";
    let menuData = MenuParser.getInstance().getMenuDetail(graphicName);
    if (menuData) {
        objDetails.menu = menuData;
        objDetails.moodchange = false;
        xmlData.removeAttribute("uniqueLayoutName");
        xmlData.removeAttribute("uniqueLayout");
        this.ChartUtils.updateChartProperties(this.slideID, objDetails);
        return;
    }
};

ChartBuilder.prototype.getGraphicDiv = function (slideId, tempSlideObj) {
    let slideObj = tempSlideObj ? tempSlideObj : DocumentStore.getInstance().getSlideDetails(slideId);
    let graphic = slideObj ? slideObj.content.querySelector("[id='GRAPHIC']") : "";
    return graphic;
};
ChartBuilder.prototype.chartRedrawOperation = function (menuData = menuDetails, argParent = null, object = null, instanceDetails = null, designerui = false) {
    let slide = object ? object.slide : null;
    menuData = menuData ? menuData : menuDetails;
    let parentNode = object ? object.slide : argParent;
    if (designerui) {
        if (this.xmlData) {
            this.getAssets(menuData, slide);
        }
        let loadAsset = new window["chartAssetsLoader"]();

        loadAsset.loadAssets(this.chartAsset.arrAssets).then(() => {
            let divParent = this.buildAsset(menuData, parentNode, instanceDetails, designerui);
            return divParent;
        });
    } else {
        let divParent = this.buildAsset(menuData, parentNode, instanceDetails);
        let xmlData = divParent.querySelector("desc") && divParent.querySelector("desc").children.length > 0 ? divParent.querySelector("desc").children[0] : null;
        if (xmlData) {
            let conflicData = xmlData.getAttribute("conflictlayout") == "true" ? true : false;
            let legendArea = divParent.querySelector(".legendbase");
            if (conflicData && !legendArea) {
                divParent = "";
                divParent = null;
            }
        }
        return divParent;
    }
};
ChartBuilder.prototype.addNode = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let childLength = this.xmlData.children.length;
    let object = { property: "dropdowncount", value: childLength + 1 };
    this.ChartUtils.getChartSupportData("", object, this.xmlData);
    let objectValue = { slide: slide };
    this.addoperation = true;
    this.chartRedrawOperation(menuDetails, "", objectValue, "", true);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.deleteNode = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let childLength = this.xmlData.children.length;
    let object = { property: "dropdowncount", value: childLength - 1 };
    this.ChartUtils.getChartSupportData("", object, this.xmlData);
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue, "", true);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.showEmpahsis = function () {
    let hasEmphasis = menuDetails.menu.hasOwnProperty("variationproperties") && menuDetails.menu.variationproperties.hasOwnProperty("emphasize");
    let strvalue = hasEmphasis ? menuDetails.menu.variationproperties.emphasize.value[0] : "middle";
    let index = 1;
    let slide = document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    switch (strvalue) {
        case "first":
            index = 1;
            break;
        case "last":
            index = this.xmlData.children.length - 1;
            break;
        case "middle":
            index = parseInt(this.xmlData.children.length / 2);
            break;
        default:
            index = parseInt(strvalue) - 1;
            break;
    }
    this.xmlData.setAttribute("emphasis", true);
    this.xmlData.children[index].setAttribute("emphasis", true);
    let objectValue = { slide: slide };

    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.hideEmpahsis = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    for (let i2 = 0; i2 < this.xmlData.children.length; i2++) {
        this.xmlData.removeAttribute("emphasis");
        this.xmlData.children[i2].removeAttribute("emphasis");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.showProjection = function () {
    let hasProjection = menuDetails.hasOwnProperty("variationproperties") && menuDetails.variationproperties.hasOwnProperty("projection");
    let strvalue = hasProjection ? menuDetails.variationproperties.projection.value[0] : "middle";
    let index = 1;
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    switch (strvalue) {
        case "first":
            index = 1;
            break;
        case "last":
            index = this.xmlData.children.length - 1;
            break;
        case "middle":
            index = parseInt(this.xmlData.children.length / 2);
            break;
        default:
            index = parseInt(strvalue) - 1;
            break;
    }
    this.xmlData.setAttribute("projection", true);
    this.xmlData.children[index].setAttribute("projection", true);
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.hideProjection = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    for (let i2 = 0; i2 < this.xmlData.children.length; i2++) {
        this.xmlData.removeAttribute("projection", true);
        this.xmlData.children[i2].removeAttribute("projection");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.enablePlaceholder = function () {
    let slide = menuDetails.slideobj && menuDetails.slideobj.content ? menuDetails.slideobj.content : document.querySelector("#elementslide");
    this.xmlData = menuDetails.xmldata ? menuDetails.xmldata : slide.querySelector("desc").children[0];
    let BooldPlaceHolder = this.xmlData.getAttribute("primaryplaceholder");
    if (BooldPlaceHolder) {
        this.xmlData.removeAttribute("primaryplaceholder");

        for (let k1 = 0; k1 < this.xmlData.children.length; k1++) {
            this.xmlData.children[k1].removeAttribute("placeholder");
            this.xmlData.children[k1].removeAttribute("primaryPlaceholderPath");
            this.xmlData.children[k1].removeAttribute("placeholdertype");
        }
    } else {
        this.xmlData.setAttribute("primaryplaceholder", true);
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue, "", true);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length; i1++) {
        arrelementDiv[i1].remove();
    }
};

ChartBuilder.prototype.doEnableBaseLine = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    let BooldPlaceHolder = this.xmlData.getAttribute("data-baseline") == "true";
    if (BooldPlaceHolder) {
        this.xmlData.removeAttribute("data-baseline");
    } else {
        this.xmlData.setAttribute("data-baseline", true);
        this.xmlData.setAttribute("data-baslinestyle", "simplebaseline"), (calloutType = "horizontal");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};
ChartBuilder.prototype.doEnableHighlightDiff = function () {
    let slide = document.querySelector("#elementslide");
    this.xmlData = slide.querySelector("desc").children[0];
    let length = this.xmlData.children.length;
    let boolEnableHighlight = this.xmlData.getAttribute("data-highlightdifference");
    if (!boolEnableHighlight) {
        this.xmlData.setAttribute("data-highlightdifference", "true");
        this.xmlData.setAttribute("data-highlight-value", "first,last");
        this.xmlData.setAttribute("highlightdifferencepoint1", 0);
        this.xmlData.setAttribute("highlightdifferencepoint2", length - 1);
    } else {
        this.xmlData.removeAttribute("data-highlightdifference");
        this.xmlData.removeAttribute("data-highlight-value");
        this.xmlData.removeAttribute("highlightdifferencepoint1");
        this.xmlData.removeAttribute("highlightdifferencepoint2");
    }
    let objectValue = { slide: slide };
    this.chartRedrawOperation(menuDetails, "", objectValue);
    let arrelementDiv = slide.querySelectorAll("#ELEMENT_DIV");
    for (let i1 = 0; i1 < arrelementDiv.length - 1; i1++) {
        arrelementDiv[i1].remove();
    }
};

const initValue = 25;
const initPercentage = 0.2;
let boolAbort = false;
let abortSlideId;
let arrBuilderInstances = {};
function ChartDataGenerator() {
    this.chartUtils = new window["ChartUtils"]();
}

;


ChartDataGenerator.prototype.resetCustomProps = function (xmlData, objDetails) {
    let arrData = [
        "data-bgFill",
        "data-bgFillType",
        "data-linethickness",
        "data-charttype",
        "data-dropshadow",
        "data-pointshape",
        "data-dashed",
        "data-stepdown",
        "data-slidebg",
        "data-graphicimage",
        "data-asset",
        "data-border",
        "data-barspace",
        "data-primaryplaceholder",
        "data-showxaxisline",
        "data-showyaxisline",
        "data-showxaxistitle",
        "data-showyaxistitle",
        "data-showyaxisgrid",
        "data-graphicpadding",
        "data-widthpadding",
        "data-heightpadding",
        "data-multicolor",
        "data-icon",
        "data-iconid",
        "data-borderradius",
        "data-mood",
        "data-minseries",
        "data-maxseries",
        "data-menuminseries",
        "data-menumaxseries",
        "data-stackpercentage",
        "data-connectorLine",
        "data-shapeborder",
        "data-primaryplaceholder",
        "data-baseline",
        "emphasis",
        "itemplaceholder",
        "itemplaceholderpath",
        "projection",
        "data-showMerged",
        "placholder",
        "placeholder",
        "placeholderpath",
        "placeholdertype",
        "primaryplaceholder",
        "primaryPlaceholderPath",
        "data-commonplaceholder",
        "data-highlightdifference",
    ];
    for (var key in arrData) {
        let strName = arrData[key];
        if (
            strName != "placholder" &&
            strName != "placeholderpath" &&
            strName != "placeholder" &&
            strName != "data-baseline" &&
            strName != "placeholdertype" &&
            strName != "primaryplaceholder" &&
            strName != "primaryPlaceholderPath" &&
            strName != "emphasis" &&
            strName != "projection" &&
            strName != "data-highlightdifference"
        ) {
            xmlData.removeAttribute(arrData[key]);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].removeAttribute(arrData[key]);
            }
        } else {
            if (
                (strName == "emphasis" ||
                    strName == "data-highlightdifference" ||
                    strName == "projection" ||
                    strName == "placholder" ||
                    strName == "placeholderpath" ||
                    strName == "placeholder" ||
                    strName == "placeholdertype" ||
                    strName == "primaryplaceholder" ||
                    strName == "primaryPlaceholderPath" ||
                    strName == "data-baseline") &&
                objDetails.menu &&
                (!objDetails.menu.variationproperties || objDetails.menu.variationsplit)
            ) {
                xmlData.removeAttribute(arrData[key]);
                for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                    xmlData.children[i1].removeAttribute(arrData[key]);
                }
            }
        }
    }
};

ChartDataGenerator.prototype.propertyUpdation = function (xmlData, objDetails, designerUi = false) {
    if (objDetails.menu) {
        if (!designerUi) {
            this.resetCustomProps(xmlData, objDetails);
        }
        if (objDetails.menu.floaterproperty) {
            for (var key in objDetails.menu.floaterproperty) {
                xmlData.setAttribute("data-" + key, objDetails.menu.floaterproperty[key]);
            }
        }
        if (objDetails.menu.layoutproperty) {
            this.setChartLayoutProperty(objDetails, xmlData);
        }
        if (objDetails.menu.layoutmeta) {
            this.setSlideLayoutProperty(objDetails, xmlData);
            xmlData.setAttribute("uniqueLayout", "true");
            // if(objDetails.menu.layoutmeta.bgimage){
            // DocumentStore.getInstance().addBGImage(objDetails.slideId, { data: IndexStore.getInstance().staticServerURL + "genericassets/placeholderimages/placeholder.png" })
            // }else{
            // DocumentStore.getInstance().deleteBGImage(objDetails.slideId)
            // }
        } else {
            xmlData.removeAttribute("uniqueLayout");
            // DocumentStore.getInstance().deleteBGImage(objDetails.slideId)
        }
        if (objDetails.menu.hasOwnProperty("customprops")) {
            for (var key in objDetails.menu.customprops) {
                if (key != "connectorline" && key != "shapeborder") {
                    xmlData.setAttribute("data-" + key, objDetails.menu.customprops[key]);
                } else {
                    xmlData.setAttribute("data-" + key, "true");
                    let basekey = key;
                    for (var key in objDetails.menu.customprops[basekey]) {
                        xmlData.setAttribute("data-" + key, objDetails.menu.customprops[basekey][key]);
                    }
                }
            }
        }
        if (objDetails.menu.hasOwnProperty("highlightdifference")) {
            for (var key in objDetails.menu.highlightdifference) {
                xmlData.setAttribute("data-highlightdifference", "true");
                if (key != "connectorline" && key != "shapeborder") {
                    xmlData.setAttribute("data-highlight-" + key, objDetails.menu.highlightdifference[key]);
                } else {
                    xmlData.setAttribute("data-" + key, "true");
                    let basekey = key;
                    for (var key in objDetails.menu.highlightdifference[basekey]) {
                        xmlData.setAttribute("data-highlight-" + key, objDetails.menu.highlightdifference[basekey][key]);
                    }
                }
            }
        }
        if (objDetails.menu.hasOwnProperty("node")) {
            xmlData.setAttribute("data-minseries", objDetails.menu.node[0]);
            xmlData.setAttribute("data-maxseries", objDetails.menu.node[1]);
            xmlData.setAttribute("data-menuminseries", objDetails.menu.node[0]);
            xmlData.setAttribute("data-menumaxseries", objDetails.menu.node[1]);
        }
        if (objDetails.menu.hasOwnProperty("baseline")) xmlData.setAttribute("data-baseline", objDetails.menu.baseline);
        if (objDetails.menu.hasOwnProperty("icon")) xmlData.setAttribute("data-icon", objDetails.menu.icon);
        if (objDetails.menu.hasOwnProperty("iconid")) xmlData.setAttribute("data-iconid", objDetails.menu.iconid);
        if (objDetails.menu.hasOwnProperty("asset")) xmlData.setAttribute("data-asset", objDetails.menu.asset);
        if (objDetails.menu.hasOwnProperty("animateid")) xmlData.setAttribute("data-animateid", objDetails.menu.animateid);
        if (objDetails.menu.hasOwnProperty("name")) xmlData.setAttribute("graphicname", objDetails.menu.name);
        if (objDetails.menu.hasOwnProperty("classname")) xmlData.setAttribute("data-classname", objDetails.menu.classname);
        if (objDetails.menu.hasOwnProperty("appearance")) xmlData.setAttribute("data-appearance", objDetails.menu.appearance);
        if (objDetails.menu.hasOwnProperty("multicolor") && objDetails.menu.multicolor == "true") xmlData.setAttribute("data-multicolor", objDetails.menu.multicolor);
        if (objDetails.menu.hasOwnProperty("ismoodshape")) xmlData.setAttribute("data-mood", objDetails.menu.ismoodshape);
        if (objDetails.menu.hasOwnProperty("graphicgap")) this.graphicGapCalculation(xmlData, objDetails.menu.graphicgap);
        if (objDetails.menu.hasOwnProperty("emphasize") && objDetails.menu.emphasize.value) {
            let strvalue = objDetails.menu.emphasize.value[0];
            let index = 1;
            switch (strvalue) {
                case "first":
                    index = 1;
                    break;
                case "last":
                    index = xmlData.children.length - 1;
                    break;
                case "middle":
                    index = parseInt(xmlData.children.length / 2);
                    break;
                default:
                    index = parseInt(strvalue) - 1;
                    break;
            }
            if (xmlData.children.length > index) {
                xmlData.setAttribute("emphasis", true);
                xmlData.children[index].setAttribute("emphasis", true);
            }
        }
        if (objDetails.menu.hasOwnProperty("secondaryseries-text")) xmlData.setAttribute("data-secondaryType", "text");
        if (objDetails.menu.hasOwnProperty("secondaryseries-image")) xmlData.setAttribute("data-secondaryType", "image");
        if (objDetails.menu.hasOwnProperty("secondaryseries-sequencenumber")) xmlData.setAttribute("data-secondaryType", "sequencenumber");

        if (objDetails.menu.hasOwnProperty("projection")) {
            let strvalue = objDetails.menu.projection.value[0];
            let index = 1;
            switch (strvalue) {
                case "first":
                    index = 1;
                    break;
                case "last":
                    index = xmlData.children.length - 1;
                    break;
                case "middle":
                    index = parseInt(xmlData.children.length / 2);
                    break;
                default:
                    index = parseInt(strvalue) - 1;
                    break;
            }
            xmlData.setAttribute("projection", true);
            xmlData.children[index].setAttribute("projection", true);
        }
        if (objDetails.menu.hasOwnProperty("highlightdifference") && objDetails.menu.highlightdifference.length > 1) {
            xmlData.setAttribute("data-highlightdifference", true);
            xmlData.setAttribute("highlightdifferencepoint1", objDetails.menu.highlightdifference[0]);
            xmlData.setAttribute("highlightdifferencepoint2", objDetails.menu.highlightdifference[1]);
            xmlData.setAttribute("data-highlight-style", objDetails.menu.highlightdifference[2]);
        }
        if (
            (objDetails.menu.hasOwnProperty("chartlayout") && objDetails.menu.chartlayout.placeholder && objDetails.menu.chartlayout.placeholder.default) ||
            objDetails.menu.hasOwnProperty("placeholder-image") ||
            objDetails.menu.hasOwnProperty("placeholder-icon")
        ) {
            xmlData.setAttribute("data-primaryplaceholder", true);
        }
        if (objDetails.menu.hasOwnProperty("chartlayout") && objDetails.menu.chartlayout.label && objDetails.menu.chartlayout.label.hasOwnProperty("itembased")) {
            xmlData.setAttribute("data-showMerged", "false");
        }
        if (
            (objDetails.menu.hasOwnProperty("chartlayout") &&
                objDetails.menu.chartlayout.placeholder &&
                objDetails.menu.chartlayout.placeholder.default &&
                objDetails.menu.chartlayout.placeholder.content) ||
            objDetails.menu.hasOwnProperty("placeholder-image") ||
            objDetails.menu.hasOwnProperty("placeholder-icon")
        ) {
            let type = objDetails.menu.chartlayout.placeholder.content ? objDetails.menu.chartlayout.placeholder.content : "";

            if (objDetails.menu.hasOwnProperty("placeholder-image")) {
                type = "image";
            }
            if (objDetails.menu.hasOwnProperty("placeholder-icon")) {
                type = "icon";
            }
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].setAttribute("placeholdertype", type);
            }
        }
        if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.graphicbg) {
            xmlData.setAttribute("data-slidebg", "true");
        }
        if (objDetails.menu.hasOwnProperty("chartlayout") && objDetails.menu.chartlayout.commonplaceholder && objDetails.menu.chartlayout.commonplaceholder.content) {
            xmlData.setAttribute("commonplaceholdertype", objDetails.menu.chartlayout.commonplaceholder.content);
        }

        if (objDetails.menu.hasOwnProperty("chartlayout") && objDetails.menu.chartlayout.item && objDetails.menu.chartlayout.item.type == "icon") {
            xmlData.setAttribute("data-icon", objDetails.menu.chartlayout.item.asset);
            if (objDetails.menu.chartlayout.item.iconid) {
                xmlData.setAttribute("data-iconid", objDetails.menu.chartlayout.item.iconid);
            } else {
                xmlData.setAttribute("data-iconid", "iconfill");
            }
        }
    }
};

ChartDataGenerator.prototype.graphicGapCalculation = function (xmlData, property) {
    let left = 0;
    let right = 0;
    let top = 0;
    let bottom = 0;
    for (var key in property) {
        if (key == "top") top = Number(property[key]);
        if (key == "left") left = Number(property[key]);
        if (key == "right") right = Number(property[key]);
        if (key == "bottom") bottom = Number(property[key]);
    }
    xmlData.setAttribute("data-graphicpadding", top + "px " + right + "px " + bottom + "px " + left + "px");
    xmlData.setAttribute("data-widthpadding", left + right);
    xmlData.setAttribute("data-heightpadding", top + bottom);
};

ChartDataGenerator.prototype.setSlideLayoutProperty = function (objDetails, xmlData) {
    let slidelayout;
    let seriesLength = xmlData.children.length;
    let seriesItemLength = xmlData.children[0].getAttribute("value").split(",").length;
    let slideID = objDetails.slideId;
    if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.hasOwnProperty("2node") && seriesLength <= 2) {
        slidelayout = objDetails.menu.layoutmeta["2node"].layout;
    } else if (objDetails.menu.hasOwnProperty("layoutmeta") && (objDetails.menu.layoutmeta.hasOwnProperty("3node") || objDetails.menu.layoutmeta.hasOwnProperty("2node")) && seriesLength == 3) {
        slidelayout = objDetails.menu.layoutmeta.hasOwnProperty("3node") ? objDetails.menu.layoutmeta["3node"].layout : objDetails.menu.layoutmeta["2node"].layout;
    } else if (objDetails.menu.hasOwnProperty("layoutmeta") && objDetails.menu.layoutmeta.hasOwnProperty("nodes")) {
        if (objDetails.menu.layoutmeta.hasOwnProperty("nodes")) slidelayout = objDetails.menu.layoutmeta["nodes"].layout;
    }
    if (slidelayout) {
        xmlData.setAttribute("uniqueLayoutName", slidelayout);
        //this.slideLayoutUpdate(slideID, slidelayout);
    }
};

ChartDataGenerator.prototype.setChartLayoutProperty = function (objDetails, xmlData) {
    let twonodelayout = objDetails.menu.layoutproperty["2node"] ? objDetails.menu.layoutproperty["2node"].layout : "";
    let threenodelayout = objDetails.menu.layoutproperty["3node"] ? objDetails.menu.layoutproperty["3node"].layout : "";
    let fournodelayout = objDetails.menu.layoutproperty["4node"] ? objDetails.menu.layoutproperty["4node"].layout : "";
    let layoutlist = objDetails.menu.layoutproperty["layoutList"] ? objDetails.menu.layoutproperty["layoutList"].layout : "";
    let additionallayoutlist = objDetails.menu.layoutproperty["additionalLayoutList"] ? objDetails.menu.layoutproperty["additionalLayoutList"].layout : "";
    let twonodename = objDetails.menu.layoutproperty["2node"] ? objDetails.menu.layoutproperty["2node"].name : "";
    let threenodename = objDetails.menu.layoutproperty["3node"] ? objDetails.menu.layoutproperty["3node"].name : "";
    let fournodename = objDetails.menu.layoutproperty["4node"] ? objDetails.menu.layoutproperty["4node"].name : "";
    let layoutlistname = objDetails.menu.layoutproperty["layoutList"] ? objDetails.menu.layoutproperty["layoutList"].name : objDetails.menu.classname;
    let additionallayoutlistname = objDetails.menu.layoutproperty["additionalLayoutList"] ? objDetails.menu.layoutproperty["additionalLayoutList"].name : "";
    if (twonodelayout && twonodename) {
        xmlData.setAttribute("twonodelayout", twonodelayout);
        xmlData.setAttribute("data-twonodename", twonodename);
    } else {
        xmlData.removeAttribute("twonodelayout");
        xmlData.removeAttribute("data-twonodename");
    }
    if (threenodelayout && threenodename) {
        xmlData.setAttribute("threenodelayout", threenodelayout);
        xmlData.setAttribute("data-threenodename", threenodename);
    } else {
        xmlData.removeAttribute("threenodelayout");
        xmlData.removeAttribute("data-threenodename");
    }
    if (fournodelayout && fournodename) {
        xmlData.setAttribute("fournodelayout", threenodelayout);
        xmlData.setAttribute("data-fournodename", threenodename);
    } else {
        xmlData.removeAttribute("fournodelayout");
        xmlData.removeAttribute("data-fournodename");
    }
    if (layoutlistname) {
        xmlData.setAttribute("data-chartname", layoutlistname);
    }

    // else {
    //     xmlData.removeAttribute("layoutlist");
    //     xmlData.removeAttribute("data-chartname");
    // }
    if (additionallayoutlist && additionallayoutlistname) {
        xmlData.setAttribute("additionallayoutlist", additionallayoutlist);
        xmlData.setAttribute("data-chartname", additionallayoutlistname);
    }
    // else {
    //     xmlData.removeAttribute("additionallayoutlist");
    //     xmlData.removeAttribute("data-chartname");
    // }
};

ChartDataGenerator.prototype.assignproperty = function (xmlData, objDetails) {
    let chartName = xmlData.getAttribute("name");
    let chartLayout = "";
    let seriesLength = xmlData.children.length;
    let seriesItemLength = xmlData.children[0].getAttribute("value").split(",").length;
    let defaultlayout = xmlData.getAttribute("layout");
    if (seriesLength <= 2 && xmlData.getAttribute("twonodelayout")) {
        chartName = xmlData.getAttribute("data-twonodename");
        chartLayout = xmlData.getAttribute("twonodelayout");
    } else if (seriesLength == 3 && xmlData.getAttribute("threenodelayout")) {
        chartName = xmlData.getAttribute("data-threenodename");
        chartLayout = xmlData.getAttribute("threenodelayout");
    } else if (seriesLength == 4 && xmlData.getAttribute("fournodelayout")) {
        chartName = xmlData.getAttribute("data-fournodename") ? xmlData.getAttribute("data-fournodename") : chartName;
        chartLayout = xmlData.getAttribute("fournodelayout");
    } else {
        chartName = xmlData.getAttribute("data-chartname");
        chartLayout = xmlData.getAttribute("primaryplaceholder") == "true" ? xmlData.getAttribute("additionallayoutlist") : xmlData.getAttribute("layoutlist");
    }
    if (!chartLayout && !chartName) {
        chartName = xmlData.getAttribute("data-chartname") ? xmlData.getAttribute("data-chartname") : chartName;
        chartLayout = xmlData.getAttribute("primaryplaceholder") == "true" ? xmlData.getAttribute("additionallayoutlist") : xmlData.getAttribute("layoutlist");
    }
    let length = chartLayout ? chartLayout.split(",").length : 0;
    for (let i1 = 0; i1 < length; i1++) {
        let arrlayout = chartLayout.split(",");
        let boolLayout = true;
        if (arrlayout[i1] == defaultlayout) {
            chartLayout = arrlayout[i1];
            boolLayout = false;
            break;
        }
    }
    xmlData.setAttribute("name", chartName);
    chartLayout = !chartLayout && defaultlayout ? defaultlayout : chartLayout;
    if (chartLayout) {
        xmlData.setAttribute("layout", chartLayout);
    }
    /////
    if (xmlData.getAttribute("data-icon") && xmlData.getAttribute("data-iconid")) {
        for (let i1 = 0; i1 < xmlData.children.length; i1++) {
            let iconPath = xmlData.getAttribute("data-icon") ? xmlData.getAttribute("data-icon").split(",") : [];
            let iconid = xmlData.getAttribute("data-iconid");
            if (!xmlData.children[i1].getAttribute("itemplaceholder") && iconPath.length > i1) {
                xmlData.setAttribute("itemplaceholder", "true");
                xmlData.children[i1].setAttribute("itemplaceholder", iconPath[i1]);
                xmlData.children[i1].setAttribute("itemplaceholderpath", "genericassets/icons/" + iconid + "/" + iconPath[i1] + ".svg");
            }
        }
    }
};


