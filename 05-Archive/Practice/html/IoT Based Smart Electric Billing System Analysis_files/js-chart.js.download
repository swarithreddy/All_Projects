        this.arrplacholderGlopalStyle = this.tempPlacholderGlopalStyle ? this.tempPlacholderGlopalStyle.split(" ") : [];
        if (this.xmlData.getAttribute("primaryplaceholder-type") && !this.placeholdertype) {
            this.placeholdertype = this.xmlData.getAttribute("primaryplaceholder-type");
        }
        if (this.tempPlacholderGlopalStyle && this.tempPlacholderGlopalStyle.split(" ").length < 3) {
            let arrclassDeatils = this.tempPlacholderGlopalStyle.split(" ");
            let arrNodeElements = ["Icon", "Image", "Logo"];
            for (let j1 = 0; j1 < arrNodeElements.length; j1++) {
                if (this.tempPlacholderGlopalStyle.includes(arrNodeElements[j1])) {
                    for (let k1 = 0; k1 < arrclassDeatils.length; k1++) {
                        if (arrclassDeatils[k1].includes(arrNodeElements[j1])) {
                            this.arrplacholderGlopalStyle[j1] = arrclassDeatils[k1];
                        }
                    }
                } else {
                    this.arrplacholderGlopalStyle[j1] = "c";
