        this.labelItemBased = this.data.label.hasOwnProperty("itembased") ? this.data.label.itembased : "";
        this.labeltextbg = this.data.label.hasOwnProperty("textbg") ? "true" : "";
        this.labeltextbgstyle = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.style : "";
        this.labeltextbgcallout = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.callout : "";
        this.labeltextbgItem = this.data.label.hasOwnProperty("textbg") ? this.data.label.textbg.bgitem : "";

