        this.valueHeaderColor = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("color") ? this.data.value.header.color : this.labelHeaderColor ? this.labelHeaderColor : "";
        this.singlevalueColumn = this.data.value.hasOwnProperty("header") && this.data.value.header.hasOwnProperty("valuesinglecolumn") ? this.data.value.header.valuesinglecolumn : "";
