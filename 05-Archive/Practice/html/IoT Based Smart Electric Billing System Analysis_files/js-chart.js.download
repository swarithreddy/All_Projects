ChartHelper.prototype.getValuesRange = function (arrList, grid = false, maxValue = "", maxseriesitem = 0, displayformat = "") {
    let totalValue = 0;
    let numMaxPositiveRange = 0;
    let numSecondHighValue = 0;
    let numMaxNegativeRange = 0;
    let numMaxLongValue = 0;
    let numMinRange = 0;
    let numSecondPostiveHighValue = 0;
    let numSecondNegativeHighValue = 0;
    let dummeyNumMaxPositiveRange = 0;
    let numDummeySecondPostiveValue = 0;
    const length = arrList.length;
    let arrSeriesItemMaxValue = [];
    for (let i1 = 0; i1 < length; i1++) {
        const subLength = maxseriesitem == 1 ? 1 : arrList[i1].length;
        numMinRange = i1 == 0 ? Number(arrList[i1][0]) : numMinRange;
        let seriesItemMaxValue = 0;
        for (let j1 = 0; j1 < subLength; j1++) {
            totalValue += Number(arrList[i1][j1]);
            numMaxPositiveRange = Number(numMaxPositiveRange) < Number(arrList[i1][j1]) ? Number(arrList[i1][j1]) : Number(numMaxPositiveRange);
            seriesItemMaxValue = Number(seriesItemMaxValue) < Number(arrList[i1][j1]) ? Number(arrList[i1][j1]) : Number(seriesItemMaxValue);
            numMinRange = Number(numMinRange) > Number(arrList[i1][j1]) ? Number(arrList[i1][j1]) : Number(numMinRange);
            numMaxNegativeRange = Number(numMaxNegativeRange) > Number(arrList[i1][j1]) ? Number(arrList[i1][j1]) : Number(numMaxNegativeRange);
        }
        arrSeriesItemMaxValue[i1] = seriesItemMaxValue;
    }

    numMaxLongValue = numMaxPositiveRange.toString().length > numMaxNegativeRange.toString().length ? numMaxPositiveRange : numMaxNegativeRange;
    dummeyNumMaxPositiveRange = numMaxPositiveRange;
    numMaxPositiveRange = maxValue > numMaxPositiveRange ? parseFloat(maxValue) : !grid ? parseFloat(numMaxPositiveRange) : this.getMaxValue(parseFloat(numMaxPositiveRange), maxValue);
    numMaxNegativeRange = !grid ? parseFloat(numMaxNegativeRange) : this.getMaxValue(numMaxNegativeRange * -1, null) * -1;

    for (let k1 = 0; k1 < length; k1++) {
        let secondarysubLength = maxseriesitem == 1 ? 1 : arrList[k1].length;
        for (let m1 = 0; m1 < secondarysubLength; m1++) {
            numSecondPostiveHighValue = Number(numMaxPositiveRange) > Number(arrList[k1][m1]) && Number(arrList[k1][m1]) > Number(numSecondPostiveHighValue) ? Number(arrList[k1][m1]) : Number(numSecondPostiveHighValue);
            numDummeySecondPostiveValue = Number(dummeyNumMaxPositiveRange) > Number(arrList[k1][m1]) && Number(arrList[k1][m1]) > Number(numDummeySecondPostiveValue) ? Number(arrList[k1][m1]) : Number(numDummeySecondPostiveValue);
            numSecondNegativeHighValue = Number(numMaxNegativeRange) < Number(arrList[k1][m1]) && Number(arrList[k1][m1]) < Number(numSecondNegativeHighValue) ? Number(arrList[k1][m1]) : Number(numSecondNegativeHighValue);
        }
    }
    if (!maxValue) {
        numDummeySecondPostiveValue = numSecondPostiveHighValue;
    }
    let numMaxTotalRange = numMaxPositiveRange; //+ numMaxNegativeRange * -1;
    let objFormat = { input: numMaxLongValue.toString() };
    let objFormatted = this.formatChartValues(objFormat);
    let longlength = numMaxLongValue;
    if (objFormatted && displayformat != "asentered") {
        longlength = this.ChartUtils.getDenominationValue(numMaxLongValue, objFormatted.currencySystem, "");
    }

    return {
        secondNegativeHighValue: numSecondNegativeHighValue,
        secondPositiveHighValue: numSecondPostiveHighValue,
        minvalue: numMinRange,
        longValue: numMaxLongValue,
        rangePositive: numMaxPositiveRange,
        rangeNegative: numMaxNegativeRange,
        rangeTotal: numMaxTotalRange,
        totalValue: totalValue,
        longLengthValue: longlength,
        seriesItemMaxValue: arrSeriesItemMaxValue,
        hasMaxSecondHighValue: numDummeySecondPostiveValue,
    };
};

ChartHelper.prototype.formatChartValues = function (element) {
    var gDataFormatter = eval("new " + "DataFormatUtil" + "()");
    gDataFormatter.formatCurrency(element);
    return element;
};

ChartHelper.prototype.getlabelRange = function (arrList, labelHeaderTitle) {
    const length = arrList.length;
    let longlabel;
    for (let i1 = 0; i1 < length; i1++) {
        if (i1 == 0) {
            longlabel = arrList[i1] == "" ? "Enter Label" : arrList[i1];
        } else {
            let currentLabel = arrList[i1] == "" ? "Enter Label" : arrList[i1].toString();
            longlabel = longlabel.length < currentLabel.length ? currentLabel : longlabel;
            if (i1 == length - 1 && labelHeaderTitle && labelHeaderTitle.length > 0) {
                longlabel = longlabel.length < labelHeaderTitle.length ? labelHeaderTitle : longlabel;
            }
        }
    }
    return longlabel;
};

ChartHelper.prototype.getCompareLabelRange = function (arrList, prevlongLabel) {
    const length = arrList.length;
    let longlabel = prevlongLabel;
    for (let i1 = 0; i1 < length; i1++) {
        if (arrList[i1] != undefined) {
            let currentLabel = arrList[i1] == "" ? "Enter Label" : arrList[i1].toString();
            longlabel = longlabel.length < currentLabel.length ? currentLabel : longlabel;
        }
    }
    return longlabel;
};

ChartHelper.prototype.getsecondarylabelRange = function (arrList) {
    const length = arrList.length;
    let longlabel;
    for (let i1 = 0; i1 < length; i1++) {
        if (i1 == 0) {
            longlabel = arrList[i1] == "" ? "Enter Seconday Text" : arrList[i1];
        } else {
            let currentLabel = arrList[i1] == "" ? "Enter Seconday Text" : arrList[i1];
            longlabel = longlabel.length < currentLabel.length ? currentLabel : longlabel;
        }
    }
    return longlabel;
};

ChartHelper.prototype.getChartProperty = function (strProperty, strPropertyValue) {
    let ChartMetaDataClass = new window["chartjsonValue"]();
    let ChartMetaData = ChartMetaDataClass.getChartValue();
    let arrItems = [];
    let arrCharts = ChartMetaData.charts;
    if (arrCharts[strPropertyValue]) {
        arrItems.push(arrCharts[strPropertyValue]);
    }
    return arrItems;
};

ChartHelper.prototype.getAlignData = function (argProps) {
    let position = "middle";
    if (argProps.inset == "inside") {
        position = "inner";
    } else {
        if (argProps.inset != position) position = "outer";
    }
    if (argProps.outer) position = "outer";

    return {
        position: position,
        show: argProps.show,
        hposition: argProps.hposition,
        vposition: argProps.vposition,
        index: argProps.positinIndex,
        inset: argProps.inset,
        index: argProps.index,
        itemBased: argProps.itemBased,
        samepos: argProps.index ? "true" : false,
        textbg: argProps.textbg,
        textbgstyle: argProps.textbgstyle,
        textbgcallout: argProps.textbgcallout,
        alterpos: argProps.alterpos,
        overlap: argProps.overlap,
    };
};

ChartHelper.prototype.getStylesdata = function (data) {
    let bgFill = data.getAttribute("data-bgFill") == "true" ? true : false;
    let bgFillType = data.getAttribute("data-bgFillType");
    let bgFillColor = data.getAttribute("data-bgFillColor");
    let lineThickness = data.getAttribute("data-linethickness");
    let dropShadow = data.getAttribute("data-dropshadow") == "true" ? true : false;
    let chartType = data.getAttribute("data-charttype");
    let pointshape = data.getAttribute("data-pointshape");
    let dashed = data.getAttribute("data-dashed");
    let border = data.getAttribute("data-border");
    return {
        bgFill: bgFill,
        bgFillType: bgFillType,
        bgFillColor: bgFillColor,
        lineThickness: lineThickness,
        dropShadow: dropShadow,
        chartType: chartType,
        pointshape: pointshape,
        dashed: dashed,
        border: border,
    };
};

