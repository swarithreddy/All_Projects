    //     clstyle += " prjectionOpacity";
    // }
    // if (this.data.projection[this.groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (6) + "-fill";
    // }
    // if (this.data.projection[this.groupindex] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     clstyle = " accent" + (1) + "-fill";
    // }

    let groupElement = this.data.SVGUtils.createSVGElement("g");
    // this.data.SVGUtils.assignAttributes(groupElement, {
    //     transform: "translate(5.935,38.2)",
    // });
    svgElement.appendChild(groupElement);

    let groupElement_1 = this.data.SVGUtils.createSVGElement("g");
    groupElement.appendChild(groupElement_1);

    let groupElement_2 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElement_2, {
        class: clstyle,
        "stroke-opacity": 0,
    });
    groupElement_1.appendChild(groupElement_2);

    let groupElement_3 = this.data.SVGUtils.createSVGElement("g");
    groupElement_2.appendChild(groupElement_3);

    let groupElementPath_4 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_4, {
        class: clstyle+" chartMainGraphic",
        "fill-opacity": sideopacity,
    });
    groupElement_3.appendChild(groupElementPath_4);
    let pathElement_4 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_4, {
        d: "M" + width + "," + moveY + "L" + (width + moveX) + "," + 0 + "L" + (width + moveX) + "," + (height - moveY) + "L" + width + "," + height + " Z",
    });
    groupElementPath_4.appendChild(pathElement_4);

    let groupElementPath_5 = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(groupElementPath_5, {
        class: clstyle+" chartMainGraphic",
        opacity: topopacity,
    });
    groupElement_3.appendChild(groupElementPath_5);
    let pathElement_5 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_5, {
        d: "M" + 0 + "," + moveY + "L" + moveX + "," + 0 + "L" + (width + moveX) + "," + 0 + "L" + width + "," + moveY + " Z",
    });
    groupElementPath_5.appendChild(pathElement_5);

    let groupElementPath_6 = this.data.SVGUtils.createSVGElement("g");
    groupElement_3.appendChild(groupElementPath_6);
    let pathElement_6 = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(pathElement_6, {
        d: "M0" + "," + moveY + "L" + width + "," + moveY + "L" + width + "," + height + "L" + 0 + "," + height + " Z",
    });
    groupElementPath_6.appendChild(pathElement_6);
}


function SimpleColumnShapePositionChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnShapePositionChart";
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleColumnShapePositionChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleColumnShapePositionChart.prototype.constructor = SimpleColumnShapePositionChart;

SimpleColumnShapePositionChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleColumnShapePositionSeries"](argparent, argprops);
}
function SimpleColumnShapePositionSeries(argparent, argprops) {
    this.name = "SimpleColumnSeries";
    BaseColumnSeries.call(this, argparent, argprops);
    this.svgAsset =true;
}
SimpleColumnShapePositionSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleColumnShapePositionSeries.prototype.constructor = SimpleColumnShapePositionSeries;

SimpleColumnShapePositionSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleColumnShapePositionSeriesItem"](argparent, argprops);
}

function SimpleColumnShapePositionSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.middleelementValue;
    this.middleelementLabel;
    this.middleelementPlaceholder;
    this.differnceIndex;
    this.parentHeight;
    this.graphicH; BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleColumnShapePositionSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleColumnShapePositionSeriesItem.prototype.constructor = SimpleColumnShapePositionSeriesItem;


SimpleColumnShapePositionSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, centerAlign = false) {
    this.emphasisColor = this.ChartFonts.emphasizeFillColor;
    let _oHeight = 0;
    let _iHeight = 0;
    this.boolEnableInnerValue = false;
    let highlightDifferenceHeight = 0;
 
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightPoint = false;
    if (this.data.highlightDifference.point1 == this.groupindex || this.data.highlightDifference.point2 == this.groupindex) {
        if (this.data.highlightDifference.display) highlightPoint = true;
    }
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = 30;
    }
    if(this.data.indualHighlight){
        highlightDifferenceHeight += 30;
     }
    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        this.middleelementLabel = this.ChartHelper.createDivElement({});
        this.middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementLabel.className = "middleelement  moodanimation";
        this.middleelementLabel.dataset.animation = "columncirclearrow";
        this.middleelementLabel.style.width = this.middleLW + "px";
        this.middleelementLabel.style.height = this.middleLH + "px";
        this.middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(this.middleelementLabel);
        if (this.labelAlignment.position == "middle") this.middleelementLabel.className = "this.middleelementLabel";
        this.createSVGElement(this.middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        if (this.data.chartName == "columnslider") {
            this.middleVW = parseInt(this.state.width * 0.7 * 0.55);
            this.middleVH = parseInt(this.state.width * 0.7 * 0.55);
        }
        this.middleelementValue = this.ChartHelper.createDivElement({});
        this.middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementValue.className = "middleelement  moodanimation";
        this.middleelementValue.dataset.animation = "columncirclearrow";
        this.middleelementValue.style.width = this.middleVW + "px";
        this.middleelementValue.style.height = this.middleVH + "px";
        if (this.data.layout.boolvaluebgShape) {
            this.valuebgProperties(this.middleelementValue)
        }
        if (this.data.layout.valuebgBgColor == "theme") {
            this.valueStyle = this.ChartFonts.valueInnerColor;
        }
        element.appendChild(this.middleelementValue);
        this.createSVGElement(this.middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        this.middlePH = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        this.middleelementPlaceholder = this.ChartHelper.createDivElement({});
        this.middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        this.middleelementPlaceholder.className = "middleelement  moodanimation";
        this.middleelementPlaceholder.dataset.animation = "columncirclearrow";
        this.middleelementPlaceholder.style.width = this.middlePW + "px";
        this.middleelementPlaceholder.style.height = this.middlePH + "px";
        if (this.data.layout.boolplaceholderShape) {
            this.bgProperties(this.middleelementPlaceholder)
        }
        element.appendChild(this.middleelementPlaceholder);
        this.createSVGElement(this.middleelementPlaceholder, argprops, "placeholder");
    }

    this.parentHeight = this.state.height;

    let valueHeight = (argprops.minvalue < 0) ?2*this.maxValueH:this.maxValueH;
    let baseGraphicHeight = this.parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight)
    if(this.valueAlignment.position=="outer"){
         baseGraphicHeight = this.parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight+valueHeight)
    }

    let totalValue = (argprops.minvalue < 0) ? -(argprops.minvalue) + argprops.maxvalue : argprops.totalvalue;

    const baseGraphicHeightPercentage = baseGraphicHeight;
    let graphicHeightPercentage = (baseGraphicHeightPercentage * (argprops.value / totalValue));
    let parentPercentage = (baseGraphicHeightPercentage*(argprops.totalvalue / totalValue));

    let seriesItem = this.parent.querySelector(".topseriesitem");
    seriesItem.style.height =  this.data.SVGUtils.createPercentValue(this.state.height,(parentPercentage+this.maxValueH));
    let ParentHeightValue = (parentPercentage+this.maxValueH)
    if (this.data.data.getAttribute("data-multiseries") && this.data.seriesItemLength > 1) {
        graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / this.data.seriesItemMaxValue[groupindex]);
    }

    if (this.valueAlignment.position == "middle") {
        this.middleelementValue.setAttribute("data-graphic-y", this.graphicH);
    }
    let backgroundElement;
    let backgroundBorderElement;
    if (this.data.layout.enableBackground) {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.layout.backgroundColor == "theme") {
            bgClsFillStyle = this.getBgFillDetails(groupindex,this.data.ChartFonts.graphicFillColor(groupindex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicFillColor(groupindex);
        } else {
            if (this.data.layout.backgroundColor == "transparent") {
                bgClsFillStyle = " transparent";
            } else {
                bgClsFillStyle = this.ChartFonts.emphasizeColor;
            }
        }
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity
        backgroundElement.dataset.customorgin = "bottom"
        if (this.data.chartName == "columnslider") {
            backgroundElement.style.width = 100 * this.thicknessPercentage + "%";
        }
        element.appendChild(backgroundElement);

        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = "backgroundItem moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = backgroundElement.style.width;
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            backgroundBorderElement.dataset.customopacity = "0.5";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment)
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px"
            if (this.data.layout.backgroundBorder.color == "theme") {
                let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
                backgroundBorderElement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
                if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                    this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex)
                }
            }
        }

    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle =  this.getBgFillDetails(styleIndex,this.data.ChartFonts.graphicFillColor(styleIndex),this.data.layout.itemColor,"bgcolor")//this.ChartFonts.graphicFillColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center" && this.data.data.getAttribute("primaryplaceholder"))
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue,graphicHeightPercentage);
    if(this.data.chartName == "buildingPositionColumn"){
        subelement.style.height ="100%";
    }
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    if (this.data.chartName == "columnslider") {
        subelement.style.borderRadius = "35px";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic chartMainGraphic graphicnode transformOrginBottom " + clsStyle;
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");


    if (this.data.chartName == "columnslider") {
        graphicElement.style.borderRadius = "35px";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);
    if (this.data.layout.enableBackground) {
        if (this.voData.layout.backgroundBorderRadiusValues) {
            let borderRadiuslefttop = this.voData.layout.backgroundBorderRadiusValues.letftop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusLeftBottom = this.voData.layout.backgroundBorderRadiusValues.leftbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightTop = this.voData.layout.backgroundBorderRadiusValues.righttop ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            let borderRadiusRightBottom = this.voData.layout.backgroundBorderRadiusValues.rightbottom ? (parseInt(this.voData.layout.backgroundBorderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    clsStyle =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder
            ? this.setNoEmphasis(graphicElement, clsStyle, groupindex)
            : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                ? this.setHasEmphasis(graphicElement, clsStyle, groupindex)
                : clsStyle;


    if (this.data.chartName != "columnSimpleRectangleFill") {
        ///DropShadow
        let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
        // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
        let colorStyle = this.data.layout.itemBoxShdowColor == "item" ? clsStyle : "";
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
        graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    }
    let borderElement
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "columnborderelement";
        borderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);

        graphicElement.classList.remove(this.data.ChartFonts.appendgraphicFillColor(styleIndex));
        graphicElement.classList.add("background-fill");

        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px"

        if (this.voData.shapeBoderColor == "theme") {
            let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex)
            borderElement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(groupindex));
            this.emphasisColor = " tertiary-border-color"
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
                if (this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                    let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex)
                    let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
                    graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
                }

            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.data._emphasisName != "emphasize-basic-fill" && this.data._emphasisName != "emphasize-basic-pattern") {
                this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex, true);
            }

            if ((this.data.hasEmphasis && this.data.emphasis[groupindex] == true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) || highlightPoint) {
                graphicElement.classList.remove("background-bg-color");
                graphicElement.classList.add(this.data.ChartFonts.appendgraphicFillColor(styleIndex))
            }
            borderElement.classList.add("moodanimation")
            borderElement.dataset.animation = "itemborder";
            borderElement.setAttribute("data-graphic-y", graphicElement.clientHeight);
        }

        borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign)
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px"
    }

    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = graphicElement.clientHeight + "px 0% 0%";
    }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic chartMainGraphic graphicnode moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
    //     graphicElement.dataset.customorgin = "bottom";
    // }

    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
    //     graphicElement.className = "chartgraphic chartMainGraphic transformOrginBottom graphicnode " + clsStyle + " projection" + (groupindex + 1);
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && !this.data.shapeBorder) {
    //     graphicElement.classList.add("clsTertiaryFill");
    //     graphicElement.style.boxShadow = "";
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert") && this.data.shapeBorder) {
    //     graphicElement.className = "chartgraphic chartMainGraphic chartMainGraphic graphicnode " + clsStyle;
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-alpha") && this.data.shapeBorder) {
    //     graphicElement.classList.add("borderprjectionOpacity")
    //     graphicElement.dataset.customopacity = "0.4";
    //     borderElement.classList.add("borderprjectionOpacity")
    //     borderElement.dataset.customopacity = "0.4"
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder) {
    //     borderElement.classList.add("tertiary-border-color")
    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") && !this.data.shapeBorder) {
    //     let borderColor = "tertiary-border-color"
    //     if (this.data._projectionName == "projection-basic-border-invert") {
    //         borderColor = this.ChartFonts.graphicBorderColor(groupindex)
    //     }
    //     if (this.data._projectionName != "projection-alpha") {
    //         graphicElement.className = "chartgraphic graphicnode moodanimation transformOrginBottom " + borderColor
    //         graphicElement.style.boxShadow = "";
    //     } else {
    //         graphicElement.classList.add("prjectionOpacity")
    //         graphicElement.dataset.customopacity = "0.5"
    //     }

    // }
    // if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     graphicElement.classList.remove("accent" + (groupindex + 1) + "-fill");
    //     graphicElement.classList.add("accent6-fill");
    // }
    // if (this.data.projection[groupindex] == false && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
    //     graphicElement.classList.remove("accent" + (groupindex + 1) + "-fill");
    //     graphicElement.classList.add("accent1-fill");
    // }
    // else {
    //     if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "projection-grey" && this.data.shapeBorder) {
    //         let strBordeStyleClass = "tertiary-border-color"
    //         if (borderElement) borderElement.classList.add(strBordeStyleClass)
    //         let rgbaValue = this.ChartUtils.createRBGColor(strBordeStyleClass, styleIndex, 0.5)
    //         graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    //     }
    // }
    if (borderElement) {
        borderElement.classList.remove("columnborderelement")
        borderElement.classList.add("columnborderelement")
    }
    if (this.index == 1) {
        graphicElement.classList.remove("chartgraphic")
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

        if (booloverLap) {
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.appendChild(subelement)
            overlapParentDiv.appendChild(sameElement)
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%"
            })
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

        } else {
            subelement.appendChild(sameElement)
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;;
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.voData.shapeBorder ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            // if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
            //     this.labelStyle = this.ChartFonts.labelOuterColor;
            //     if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
            //         this.labelStyle = this.ChartFonts.graphicColor(groupindex);
            //     }
            // }
            // if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
            //     this.labelStyle = this.ChartFonts.labelInnerColor;
            // }
            this.labeMaxH = subelement.clientHeight * 0.8
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

            if (this.graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement)
                overlapParentDiv.appendChild(labelElement)
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%"
                })
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

                subelement.style.width = "50%"
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8
            this.doAddLabel(labelElement, argprops);
        } else if (
            (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") ||
            this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)
        ) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        this.boolEnableInnerValue = (((this.data.layout.backgroundBorder || this.data.layout.itemBgBorder == "true") && ((element.clientHeight - subelement.clientHeight) < this.maxValueH)))
        if ((this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true")) {
            this.valueOuter = true;
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            if (this.graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv)
                subelement.parentNode.appendChild(label[0])
                overlapParentDiv.appendChild(subelement)
                overlapParentDiv.appendChild(valueElement)
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%"
                })
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%"
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);

        } else if ((this.valueAlignment.position == "outer" || (this.data.chartName == "columnStackedRectangle" && subelement.clientHeight < this.maxValueH) || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && !this.boolEnableInnerValue && this.valueAlignment.itemBased != "true") {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.data._emphasisName == "emphasize-grey" ? this.ChartFonts.labelOuterColor : this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                        ? this.ChartFonts.graphicColor(styleIndex)
                        : this.ChartFonts.valueOuterColor;
            this.graphicH = Math.round(subelement.clientHeight) - this.maxValueH;
            this.valueOuter = true;
            if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor") {
                let tempstyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color")
                if (tempstyle == "clsAccentColor") {
                    if (this.data.projection[groupindex] == true) {
                        this.valueStyle = this.ChartFonts.graphicColor(5)
                    } else {
                        this.valueStyle = this.ChartFonts.graphicColor(0)
                    }
                }

            }
            if (this.data.layout.enableBackground) {
                this.doAddTopValue(element, argprops)
            } else if (this.data.chartName == "columnStackedRectangle") {
                this.removeValueElement()
            }
            else this.doAddTopValue(element, argprops);
        } else if ((this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.maxValueH) || this.boolEnableInnerValue) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true && this.voData.shapeBorder && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            if (this.data.projection[groupindex] == true && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")) {
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.valueStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (this.data.projection[groupindex] == true && this.voData.shapeBorder && this.data.hasProjection && (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }

            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
            this.valueStyle = this.ChartFonts.valueOuterColor;
            element.style.order = 1;
            if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH) {
                this.doAddTopValue(element, argprops);
            } else {
                this.doAddTopValue(argparent, argprops);
            }
        }
    }
    this.middleElementvalidation(element, subelement, this.middleelementValue, this.middleelementPlaceholder, this.middleelementLabel);
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientWidth + "px" : 0 + "px";
        graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
    let multiSeries = this.data.data.getAttribute("data-multiseries") ? true : false;
    if ((this.data.comparisonStyle == "style2" && this.data.seriesItemLength < 2 && this.data.rangeNegative >= 0) || (this.data.comparisonStyle == "style2" && multiSeries)) {
        this.differnceIndex = multiSeries ? index : groupindex
        let boolEnablecomparestyle = "";
        if (multiSeries) {
            boolEnablecomparestyle = this.differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index + 1]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index - 1])
        } else {
            boolEnablecomparestyle = this.differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex + 1][index]) : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex - 1][index])

        }

        if (boolEnablecomparestyle) {
            let differentValue1
            if (multiSeries) {
                differentValue1 = this.differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index])
            } else {
                differentValue1 = this.differnceIndex == 0 ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index]) : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index])
            }
            let differentValue = ((differentValue1 / this.data.rangePositive) * 100).toFixed(0) + "%";
            let eprops = {
                differentValue: this.differnceIndex == 0 ? differentValue : differentValue
            }
            //this.createCompareStyle(element, eprops, graphicElement)
        }
    }
    if (this.data.chartName == "columnSimpleRectangleFill") {
        this.createRect(graphicElement, argparent)
    }
    if (this.data.layout.itemFillType == "pattern") {
        this.createPatternSvg(graphicElement)
        if (borderElement) borderElement.style.zIndex = "3";

    }
    if (this.data.layout.backgroundFillType == "pattern") {
        this.createPatternSvg(backgroundElement)
        subelement.parentNode.appendChild(subelement)
    }
    if (this.data.chartName == "buildingPositionColumn") {
        this.createShapePosition1(graphicElement, argprops)
    } else {
        graphicElement.style.overflow = "hidden"
        this.createShapePosition(graphicElement)
    }
}
SimpleColumnShapePositionSeriesItem.prototype.createShapePosition = function (graphicElement) {
    let svgAsset
    graphicElement.style.boxShadow = "";
    graphicElement.classList.remove("moodanimation")
    this.asset = this.data.asset.data[0].data;
    let graphicHeight = graphicElement.clientHeight;
    if (!this.asset) {
        if (this.data.presentMode) {
            svgAsset = this.data.slideObj.querySelector("#series-0").parentElement.querySelector(".chartgraphic").children[0].children[0].children[0].children[0].cloneNode("true")
        } else {
            if(this.data.slideObj.querySelector("#series-" + this.groupindex)){
                svgAsset = this.data.slideObj.querySelector("#series-" + this.groupindex).querySelector(".chartgraphic").children[0].children[0].children[0].children[0].cloneNode("true")
            }else{
                svgAsset = this.data.slideObj.querySelector("#series-0").querySelector(".chartgraphic").children[0].children[0].children[0].children[0].cloneNode("true")
            }
        }
    } else {
        svgAsset = this.asset.cloneNode(true);
    }
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    graphicElement.appendChild(baseSvg)
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(baseSvg, baseSvg)
    }
    let parentGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(parentGroup, {
        class: "moodanimation",
        "data-animation": "item"
    });
    parentGroup.setAttribute("data-graphic-y", graphicElement.clientHeight);
    baseSvg.appendChild(parentGroup)
    let baseGroup = this.data.SVGUtils.createSVGElement("g");
    parentGroup.appendChild(baseGroup);
    this.data.SVGUtils.assignAttributes(baseSvg, {
        height: "100%",
        width: "100%"
    });
    // svgAsset.classList.add("accent" + (this.groupindex + 1) + "-fill")
    let arrViewBox = svgAsset.getAttribute("viewBoxDefault")?svgAsset.getAttribute("viewBoxDefault").split(" "):svgAsset.getAttribute("viewboxdefault").split(" ");
    let heightValue = arrViewBox[3];
    // this.data.SVGUtils.assignAttributes(baseSvg, {
    //     height:heightValue,
    //     class:cssStyle
    // });


    baseGroup.appendChild(svgAsset);
    let scaleX = graphicElement.clientWidth / arrViewBox[2];
    let scaleValue = scaleX;
    this.data.SVGUtils.assignAttributes(baseGroup, {
        transform: "scale(" + scaleValue + "," + scaleValue + ")",
    });
    let bounds = baseGroup.getBBox();
    let yValue = -(graphicElement.clientHeight - bounds.height) / 2;
    let xValue = (graphicElement.clientWidth - bounds.width) / 2;
    this.data.SVGUtils.assignAttributes(baseGroup, {
        transform: "scale(" + scaleValue + "," + scaleValue + ")",
    });
   // if(this.data.layout.assetname=="mcairballoonone"){

       if(arrViewBox[3]*scaleValue>graphicElement.clientHeight){
        this.data.SVGUtils.assignAttributes(baseSvg, {
            width: arrViewBox[2]*scaleValue,
            height:graphicHeight
        });
       }else{
        this.data.SVGUtils.assignAttributes(baseSvg, {
            width: arrViewBox[2]*scaleValue,
            height:graphicHeight
        });
       }

        if((arrViewBox[2]*scaleValue)<arrViewBox[2]){
            this.data.SVGUtils.assignAttributes(baseSvg, {
                width: arrViewBox[2],
            });
        }
   // }
}
SimpleColumnShapePositionSeriesItem.prototype.createShapePosition1 = function (graphicElement, argprops) {
    let svgAsset
    graphicElement.style.boxShadow = "";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "flex-end";
    graphicElement.style.justifyContent = "center",
    graphicElement.classList.remove("moodanimation")
    this.asset = this.data.asset.data[0].data;
    if (!this.asset) {
        if (this.data.presentMode) {
            svgAsset = this.data.slideObj.querySelector("#series-0").parentElement.querySelector("#container").children[0].children[0].children[0].cloneNode("true")
        } else {
            if(this.data.slideObj.querySelector("#series-" + this.groupindex)){
                svgAsset = this.data.slideObj.querySelector("#series-" + this.groupindex).querySelector(".chartgraphic").children[0].children[0].children[0].cloneNode("true")
            }else{
                svgAsset = this.data.slideObj.querySelector("#series-0").querySelector(".chartgraphic").children[0].children[0].children[0].cloneNode("true")

            }
          
        }
    } else {
        svgAsset = this.asset.cloneNode(true);
    }

    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    graphicElement.appendChild(baseSvg)
    let baseGroup = this.data.SVGUtils.createSVGElement("g");

    baseSvg.appendChild(baseGroup);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(baseSvg, baseSvg)
    }
    this.data.SVGUtils.assignAttributes(baseSvg, {
        height: "100%",
        width: "100%"
    });
    // svgAsset.classList.add("accent" + (this.groupindex + 1) + "-fill")
    let arrViewBox = svgAsset.getAttribute("viewBoxDefault")?svgAsset.getAttribute("viewBoxDefault").split(" "):svgAsset.getAttribute("viewboxdefault")?svgAsset.getAttribute("viewboxdefault").split(" "):svgAsset.getAttribute("viewBox").split(" ");
    let heightValue = arrViewBox[3];
    // this.data.SVGUtils.assignAttributes(baseSvg, {
    //     height:heightValue,
    //     class:cssStyle
    // });
    baseGroup.appendChild(svgAsset);
    let scaleX = graphicElement.clientWidth / arrViewBox[2];
    let scaley = graphicElement.clientHeight / arrViewBox[3];
    let scaleValue = scaleX<scaley?scaleX:scaley;
    this.data.SVGUtils.assignAttributes(baseGroup, {
        transform: "scale(" + scaleValue + "," + scaleValue + ")",
    });

    let nummultiplefactor = (this.data.values[this.groupindex][this.index] / argprops.maxvalue)
    let childElements = svgAsset ? svgAsset.querySelector("#" + this.data.layout.assetname + "-main") : "";
    let totalChlid = childElements ? (childElements.children.length - 1) : 0
    let valueIndex = Math.floor(totalChlid * nummultiplefactor);
    for (let i1 = 0; i1 <= totalChlid; i1++) {
        childElements.children[i1].style.opacity = "0";
        this.data.SVGUtils.assignAttributes(childElements.children[i1], {
            class: "moodanimation",
            "data-customoneopacity":"0",
            "data-animation": "item" + (this.groupindex + 1)
        })
        childElements.children[valueIndex].style.opacity = "";
        childElements.children[valueIndex].dataset.customoneopacity = "";
        if (i1 > valueIndex) {
            this.data.SVGUtils.assignAttributes(childElements.children[i1], {
                class: "moodanimation",
                "data-animation": "",
                "data-customoneopacity":"0"
            })
            childElements.children[i1].removeAttribute("data-animation")
        }
    }
    let bounds = baseGroup.getBBox();
    let parentBounds = baseSvg.getBBox();
    let yValue = (graphicElement.clientHeight - (arrViewBox[3] * scaleValue));
    let xValue = this.data._designerUI?0:(bounds.width>parentBounds.width?0:(parentBounds.width-bounds.width)/4)
    yValue = 0

    this.data.SVGUtils.assignAttributes(baseGroup, {
        transform: "scale(" + 1 + "," + 1 + ") translate("+xValue+","+yValue+")",
    });
    this.data.SVGUtils.assignAttributes(baseSvg, {
        height:"100%",
        width:arrViewBox[2] * scaleValue,
    });
    
    graphicElement.style.height = baseGroup.getBBox().height+"px";
    graphicElement.parentNode.style.alignItems = "flex-end"

}



// import BaseColumnChart from "../../base/baseChartColumn/BaseColumnChart";
// import SimpleAngularGaugeSeries from "./SimpleAngularGaugeSeries.js";

function SimpleAngularGaugeChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleColumnChart";
    this.name = "SingleWaffleChart";
    this.minSeriesSize = 300;
    this.maxGraphicSize = 1300;
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleAngularGaugeChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleAngularGaugeChart.prototype.constructor = SimpleAngularGaugeChart;

SimpleAngularGaugeChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleAngularGaugeSeries"](argparent, argprops);
}
SimpleAngularGaugeChart.prototype.CreateHightlightDifference = function () {
    return null;
}
function SimpleAngularGaugeSeries(argparent, argprops) {
    this.name = "SingleWaffleSeries";
    this.gapPercentage = 1;
    BaseColumnSeries.call(this, argparent, argprops);
    this.boolDisableWidth = true;
}
SimpleAngularGaugeSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleAngularGaugeSeries.prototype.constructor = SimpleAngularGaugeSeries;

SimpleAngularGaugeSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    this.gapPercentage = this.data.layout.itemgap ? 1 : this.gapPercentage;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.parent) this.parent.appendChild(element);
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    ///boolMax
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.valueStyle = this.ChartFonts.graphicColor(this.index);
        // this.data.valuesDenomination[this.index][0] = this.data.values[this.index][0]>100?100:this.data.values[this.index][0];
        if (this.data.boolPercentageChart) {
            this.data.valuesDenomination[this.index][0] = parseInt(this.data.values[this.index][0]);
        }
        this.doAddValueElement(element, argprops);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
    subelement.style.width = this.gapPercentage * 100 + "%";
    subelement.style.order = 2;
    // subelement.style.flex = "unset";
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

SimpleAngularGaugeSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleAngularGaugeSeriesItem"](argparent, argprops);
};

function SimpleAngularGaugeSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.iconRow = 10;
    this.iconColumn = 10;
    this.valueMaxW = 0;
    this.labelMaxW = 0;
    this.labeMaxH = 0;
    this.valueMaxH = 0;
    this.dummeylabelMaxW = 230;
    this.styleShape = null;
    this.graphicH = 0;
    this.intStartAngle = 138;
    this.intMaxvalue = 100;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
    this.boolDisableWidth = true;
}
SimpleAngularGaugeSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleAngularGaugeSeriesItem.prototype.constructor = SimpleAngularGaugeSeriesItem;

SimpleAngularGaugeSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.data.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.5;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.valueMaxH = this.state.height * 0.5; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.valueAlignment.itemBased == "true") this.valueMaxW = this.state.width * 0.4;
    if (this.labelAlignment.itemBased == "true") this.labelMaxW = this.state.width * 0.4;
};

SimpleAngularGaugeSeriesItem.prototype.doAddGraphicElement = function () {
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

SimpleAngularGaugeSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
};

SimpleAngularGaugeSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    this.styleShape = this.data.layout.waffleShape ? this.data.layout.waffleShape : "rect";
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.dummeylabelMaxW * 0.5 : this.dummeylabelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.data.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "secondary-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.justifyContent = "center ";
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic moodanimation transformOrginBottom";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.dataset.animation = "item";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "center";
    graphicElement.style.position = "relative";
    graphicElement.style.justifyContent = "center";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
    if ((this.data.layout.itemgap > 1 && this.data.layout.itemgap < this.state.width * 0.5 && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased) {
        graphicElement.style.width = this.data.layout.itemgap + "px";
    }
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);

    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        if ((this.data.layout.itemgap > 1 && this.data.layout.itemgap < this.state.width * 0.5 && this.labelAlignment.itemBased == "true") || this.valueAlignment.itemBased) {
            sameElement.style.width = this.state.width - this.data.layout.itemgap + "px";
            this.labelMaxW = this.state.width - this.data.layout.itemgap;
        }
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;

            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            this.valueMaxW = sameElement.clientWidth;
            if (booloverLap) this.doAddTopValue(element, argprops, "", true);
            else this.doAddTopValue(sameElement, argprops, "", true);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops, "", true);
            else this.doAddTopValue(element, argprops, "", true);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops, "", true);
        }
    }
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? subelement.clientWidth * 0.5 : subelement.clientWidth;
    let graphicHeight = subelement.clientHeight;
    let iconVerSize = graphicWidth / this.iconColumn;
    let iconHorSize = graphicHeight / this.iconRow;
    this.iconsize = iconVerSize < iconHorSize ? iconVerSize : iconHorSize;
    this.createGraphicSVG(graphicElement, argprops, null, null, index);
};

SimpleAngularGaugeSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    element.style.setProperty("box-sizing", "border-box", "important");
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.boolDisableWidth) {
        element.style.width = "";
    } else {
        element.style.width = this.valueMaxW + "px";
    }
    if (this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            element.style.marginLeft = "auto";
        } else {
            element.style.marginRight = "auto";
        }
    }
    if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
        this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex); //"accent" + (this.groupindex + 1) + "-color";
    }
    this.valueStyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " n1";
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.data._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (boolenablePer && this.data.displayValueFormat != "number") {
        // subelement.innerText = parseFloat(argprops.valuetext)>100?"100%":parseFloat(argprops.valuetext) + "%";
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "theme" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", this.graphicH);
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
    }

    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgstyle == "style6") {
            element.classList.add("moodanimation");
            element.dataset.animation = "bgsecondarytext";
        }
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.ChartFonts.appendgraphicBorderColor(this.index));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction" && !this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= this.minValueFontSize[this.arrIndex] && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        fontsize = window.getComputedStyle(subelement)["font-size"];
        // if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
        //     element.style.display = "none";
        // }
    }
    if (!boolmax) {
        subelement.style.overflow = "hidden";
    }
};

SimpleAngularGaugeSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index) {
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "svgElement-" + this.groupindex + "_" + this.index,
        class: "gauge",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-startangle": -this.intStartAngle,
    });
    argparent.appendChild(svgElement);
    let svgGroupNode = this.data.SVGUtils.createSVGElement("g");
    let svg = "";
    if (this.data.asset.data[this.index].data) {
        svg = this.data.asset.data[this.index].data;
        let imageNode = svg.getElementsByTagName("image");
        if (imageNode && this.voData.asset.data.length > 1) {
            imageNode[0].setAttribute("xlink:href", this.data.serverUrl + this.voData.asset.data[1].url);
        }
    } else {
        let svgDomData = this.data.slideObj.querySelector("#gaugeGrourp-" + this.groupindex + "_" + this.index);
        svg = svgDomData ? svgDomData.children[0] : "";
    }

    let svgCenterPoint = svg.querySelectorAll("#gauge-centerpoint");
    let intCenterX = svgCenterPoint[0].getAttribute("cx");
    let intCenterY = svgCenterPoint[0].getAttribute("cy");
    let arrowGroup = svg.querySelectorAll("#gauge-arrow")[0];
    this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    let numValue = parseFloat(this.data.values[this.groupindex][this.index]) >= this.intMaxvalue / 2 ? parseFloat(this.data.values[this.groupindex][this.index]) - this.intMaxvalue / 2 : parseFloat(this.data.values[this.groupindex][this.index]);
    numValue = numValue == 0 ? 0.1 : parseFloat(numValue);
    let angle = numValue * (this.intStartAngle / (this.intMaxvalue / 2));
    angle = this.data.values[this.groupindex][this.index] < this.intMaxvalue / 2 ? angle - this.intStartAngle : angle;
    arrowGroup.setAttribute("transform", "rotate(" + angle + " " + intCenterX + " " + intCenterY + ")");
    this.data.SVGUtils.assignAttributes(arrowGroup, {
        "data-animation": "arrowitem",
        "data-angle": angle,
        "data-customy": intCenterY,
        "data-customx": intCenterX,
        "data-startangle": this.intStartAngle,
    });
    let totalAngle = -this.intStartAngle - angle;
    this.data.SVGUtils.assignAttributes(arrowGroup, {
        "data-totalangle": totalAngle,
    });
    this.data.SVGUtils.assignAttributes(svgGroupNode, {
        transform: "scale(" + 1 + ") translate(" + 0 + "," + 0 + ")",
        id: "gaugeGrourp-" + this.groupindex + "_" + this.index,
    });
    svgGroupNode.appendChild(svg);
    svgElement.appendChild(svgGroupNode);
    let assetBounds = svgGroupNode.children[0].getBBox();
    let baseAssetsBounds = svgElement.getBBox();
    let yValue = baseAssetsBounds.height > assetBounds.height ? baseAssetsBounds.height - assetBounds.height : 0;
    yValue = yValue - yValue * 0.5;
    // this.data.SVGUtils.assignAttributes(svgGroupNode, {
    //     transform: "scale(" + 1 + ") translate(" + 0 + "," + yValue + ")",
    // });
};

function Single3DPieChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "Single3DPieChart";
    this.minSeriesSize = 300;
    this.maxGraphicSize = 1300;
    BaseColumnChart.call(this, argparent, argprops);
}
Single3DPieChart.prototype = Object.create(BaseColumnChart.prototype);
Single3DPieChart.prototype.constructor = Single3DPieChart;

Single3DPieChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["Single3DPieSeries"](argparent, argprops);
};

Single3DPieChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveX = this.rectSeries.y;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(argparent, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(moveX, this.rectSeries.y);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveX += this.rectSeries.width;
    }
    this.adjustaxisline(argparent);
    if (this.voData.values[0][0] < 50) {
        this.createGraphicsImage();
        this.createGraphicsImage1();
    } else {
        this.createGraphicsImage1();
        this.createGraphicsImage();
    }
};
Single3DPieChart.prototype.createGraphicsImage = function () {
    let graphicElement = this.parent.querySelectorAll(".chartgraphic");
    let valueElement = this.parent.querySelectorAll(".value");
    let labelElement = this.parent.querySelectorAll(".label");
    let seriesElement = this.parent.querySelectorAll(".series");
    for (let i1 = 0; i1 < graphicElement.length; i1++) {
        let clientHeightValue = graphicElement[i1].clientHeight;
        clientHeightValue = clientHeightValue > 600 ? 600 : clientHeightValue;
        graphicElement[i1].style.width = clientHeightValue + "px";
        graphicElement[i1].style.height = clientHeightValue + "px";
        graphicElement[i1].dataset.animation = "item";
        graphicElement[i1].classList.add("moodanimation");
        let assetdata = this.voData.asset.data.length > 0 && this.voData.asset.data[0].data ? JSON.parse(this.voData.asset.data[0].data) : "";
        let farmes = "";
        let assetValueUrl = "";
        if (assetdata) {
            farmes = assetdata.frames;
            this.data.spriteasset.push({ name: this.data.layout.assetname, assetvalue: this.voData.asset.data });
            assetValueUrl = this.voData.asset.data[1].url;
        } else {
            if (this.data.spriteasset.length > 0) {
                for (let k1 = 0; k1 < this.data.spriteasset.length; k1++) {
                    if (this.data.spriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.spriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.spriteasset[k1].assetvalue[1].url;
                    }
                }
                farmes = assetdata.frames;
            }
            if (!farmes && this.data.secondaryspriteasset.length > 0 && !assetdata) {
                for (let k1 = 0; k1 < this.data.secondaryspriteasset.length; k1++) {
                    if (this.data.secondaryspriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.secondaryspriteasset[k1].assetvalue[0].data);
                        assetValueUrl = this.data.secondaryspriteasset[k1].assetvalue[1].url;
                    }
                }
                farmes = assetdata.frames;
            }
        }
        let assetURL = this.data.serverUrl + assetValueUrl;
        if (!farmes || (farmes && farmes.length < 1)) return;

        let totalfarmes = farmes.length - 1;
        let indexValue = (this.voData.values[i1][0] / this.data.rangePositive) * 100;
        let frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.floor((indexValue / 100) * totalfarmes);
        if (this.data.seriesLength == 1) {
            frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.floor((this.voData.values[i1][0] / 100) * totalfarmes);
        }
        let frame = farmes[frameIndex].frame;

        let spriteCoordinates = [];
        for (let i1 = 0; i1 < totalfarmes + 1; i1++) {
            let eachFrame = farmes[i1].frame;
            let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
            spriteCoordinates.push(eachFrameCoordinates);
        }

        let itemWidth = clientHeightValue;
        let itemHeight = clientHeightValue;
        let scaleX = itemWidth / frame.w;
        let scaleY = itemHeight / frame.h;
        let scale = scaleX < scaleY ? scaleX : scaleY;

        let viewWidth = frame.w * scale;
        let viewHeight = frame.h * scale;
        let centerPointPadding = this.DistanceMeasureMent("", 15);

        let translateX = (itemWidth - viewWidth) / 2;
        let translateY = (itemHeight - viewHeight) / 2;
        let baseElement = this.ChartHelper.createDivElement({});
        baseElement.style.width = clientHeightValue + "px";
        baseElement.style.height = clientHeightValue + "px";
        baseElement.style.display = "flex";
        baseElement.style.alignItems = "center";
        baseElement.style.position = "relative";
        baseElement.style.justifyContent = "center";
        baseElement.style.transform = "translate(" + centerPointPadding.pointX + "px," + centerPointPadding.pointY + "px)";
        baseElement.className = "piegraphic";
        baseElement.style.overflow = "hidden";
        baseElement.dataset.moveX = centerPointPadding.pointX;
        baseElement.dataset.moveY = centerPointPadding.pointY;
        let assetelement = this.ChartHelper.createDivElement({});
        assetelement.id = "graphicimage-" + i1;
        assetelement.className = "graphicimage";
        // assetelement.dataset.animation = "spriteanimation";
        assetelement.dataset.frameindex = frameIndex;
        assetelement.dataset.assetURL = assetURL;
        assetelement.dataset.totalframes = totalfarmes;
        assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        assetelement.style.setProperty("position", "absolute", "important");
        if (this.voData.values[0][0] < 50) {
            graphicElement[i1].appendChild(baseElement);
            baseElement.appendChild(assetelement);
        } else {
            graphicElement[i1].appendChild(assetelement);
        }
        // translateX = (itemWidth - assetelement.clientWidth) / 2;
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        assetelement.style.setProperty("position", "absolute", "important");
        let labelW = labelElement[i1] ? labelElement[i1].clientWidth : 0;
        let valueW = valueElement[i1] ? valueElement[i1].clientWidth : 0;
        let widthPercentage = parseInt(((viewWidth + labelW + valueW + 20) / this.state.width) * 100) + "%";
        // if (seriesElement[i1]) {
        //     seriesElement[i1].style.maxWidth = widthPercentage;
        // }
    }
};
Single3DPieChart.prototype.createGraphicsImage1 = function () {
    let graphicElement = this.parent.querySelectorAll(".chartgraphic");
    let valueElement = this.parent.querySelectorAll(".value");
    let labelElement = this.parent.querySelectorAll(".label");
    let seriesElement = this.parent.querySelectorAll(".series");
    for (let i1 = 0; i1 < graphicElement.length; i1++) {
        let clientHeightValue = graphicElement[i1].clientHeight;
        clientHeightValue = clientHeightValue > 600 ? 600 : clientHeightValue;
        graphicElement[i1].style.width = clientHeightValue + "px";
        graphicElement[i1].style.height = clientHeightValue + "px";
        graphicElement[i1].dataset.animation = "item";
        graphicElement[i1].classList.add("moodanimation");
        let assetdata = this.voData.asset.data.length > 0 && this.voData.asset.data[2].data ? JSON.parse(this.voData.asset.data[2].data) : "";
        let farmes = "";
        let assetValueUrl = "";
        if (assetdata) {
            farmes = assetdata.frames;
            this.data.spriteasset.push({ name: this.data.layout.assetname, assetvalue: this.voData.asset.data });
            assetValueUrl = this.voData.asset.data[3].url;
        } else {
            if (this.data.spriteasset.length > 0) {
                for (let k1 = 0; k1 < this.data.spriteasset.length; k1++) {
                    if (this.data.spriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.spriteasset[k1].assetvalue[2].data);
                        assetValueUrl = this.data.spriteasset[k1].assetvalue[3].url;
                    }
                }
                farmes = assetdata.frames;
            }
            if (!farmes && this.data.secondaryspriteasset.length > 0 && !assetdata) {
                for (let k1 = 0; k1 < this.data.secondaryspriteasset.length; k1++) {
                    if (this.data.secondaryspriteasset[k1].name == this.data.layout.assetname) {
                        assetdata = JSON.parse(this.data.secondaryspriteasset[k1].assetvalue[2].data);
                        assetValueUrl = this.data.secondaryspriteasset[k1].assetvalue[3].url;
                    }
                }
                farmes = assetdata.frames;
            }
        }
        let assetURL = this.data.serverUrl + assetValueUrl;
        if (!farmes || (farmes && farmes.length < 1)) return;
        let totalfarmes = farmes.length - 1;
        let indexValue = (this.voData.values[i1][0] / this.data.rangePositive) * 100;

        let frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.floor((indexValue / 100) * totalfarmes);
        if (this.data.seriesLength == 1) {
            frameIndex = this.voData.values[i1][0] < 1 ? 0 : Math.floor((this.voData.values[i1][0] / 100) * totalfarmes);
        }
        let frame = farmes[frameIndex].frame;

        let spriteCoordinates = [];
        for (let i1 = 0; i1 < totalfarmes + 1; i1++) {
            let eachFrame = farmes[i1].frame;
            let eachFrameCoordinates = [-eachFrame.x, -eachFrame.y];
            spriteCoordinates.push(eachFrameCoordinates);
        }

        let itemWidth = clientHeightValue;
        let itemHeight = clientHeightValue;
        let scaleX = itemWidth / frame.w;
        let scaleY = itemHeight / frame.h;
        let scale = scaleX < scaleY ? scaleX : scaleY;

        let viewWidth = frame.w * scale;
        let viewHeight = frame.h * scale;
        let translateX = 0;
        let translateY = 0;
        let centerPointPadding = this.DistanceMeasureMent("", 15);
        let baseElement = this.ChartHelper.createDivElement({});
        baseElement.style.transform = "translate(" + centerPointPadding.pointX + "px," + centerPointPadding.pointY + "px)";
        baseElement.className = "piegraphic";
        baseElement.style.overflow = "hidden";
        baseElement.dataset.moveX = centerPointPadding.pointX;
        baseElement.dataset.moveY = centerPointPadding.pointY;
        baseElement.style.width = clientHeightValue + "px";
        baseElement.style.height = clientHeightValue + "px";
        baseElement.style.display = "flex";
        baseElement.style.alignItems = "center";
        baseElement.style.position = "relative";
        baseElement.style.justifyContent = "center";
        let assetelement = this.ChartHelper.createDivElement({});
        assetelement.id = "graphicimage-" + 1;
        assetelement.className = "graphicimage";
        // assetelement.dataset.animation = "spriteanimation";
        assetelement.dataset.frameindex = frameIndex;
        assetelement.dataset.assetURL = assetURL;
        assetelement.dataset.totalframes = totalfarmes;
        assetelement.dataset.allframes = JSON.stringify(spriteCoordinates);
        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        assetelement.style.setProperty("position", "absolute", "important");
        if (this.voData.values[0][0] >= 50) {
            graphicElement[i1].appendChild(baseElement);
            baseElement.appendChild(assetelement);
        } else {
            graphicElement[i1].appendChild(assetelement);
        }
        // translateX = (itemWidth - assetelement.clientWidth) / 2;

        assetelement.setAttribute(
            "style",
            "width:" + frame.w + "px; height:" + frame.h + "px; background-repeat:no-repeat; background-image:url('" + assetURL + "'); background-position:" + -frame.x + "px " + -frame.y + "px;" + "transform: translate(" + translateX + "px," + translateY + "px) scale(" + scale + "," + scale + ");position: absolute"
        );
        assetelement.style.setProperty("position", "absolute", "important");
        assetelement.classList.add("pieassetopacity");
        let labelW = labelElement[i1] ? labelElement[i1].clientWidth : 0;
        let valueW = valueElement[i1] ? valueElement[i1].clientWidth : 0;
        let widthPercentage = parseInt(((viewWidth + labelW + valueW + 20) / this.state.width) * 100) + "%";
        // if (seriesElement[i1]) {
        //     seriesElement[i1].style.maxWidth = widthPercentage;
        // }
    }
};
Single3DPieChart.prototype.DistanceMeasureMent = function (midAngle, distance) {
    let pntX = distance;
    let pntY = this.data.values[0][0] < 50 ? -distance : -distance;

    if (this.data.values[0][0] == 50) {
        pntX = -distance;
        pntY = 0;
    }
    if (this.data.values[0][0] >= 50) {
        pntX = -distance;
    }
    let xyPos = {
        pointX: pntX,
        pointY: pntY,
    };
    return xyPos;
};
Single3DPieChart.prototype.CreateHightlightDifference = function () {
    return null;
};

function Single3DPieSeries(argparent, argprops) {
    this.name = "Single3DPieSeries";
    this.gapPercentage = 1;
    BaseColumnSeries.call(this, argparent, argprops);
    this.boolDisableWidth = true;
}
Single3DPieSeries.prototype = Object.create(BaseColumnSeries.prototype);
Single3DPieSeries.prototype.constructor = Single3DPieSeries;

Single3DPieSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["Single3DPieSeriesItem"](argparent, argprops);
};

Single3DPieSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : this.gapPercentage;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + "  accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.parent) this.parent.appendChild(element);
    if (this.data.hasEmphasis && this.data.emphasis[this.index] != true) {
        element.classList.add("emphasis");
    }
    if (this.data.projection[this.index] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
        element.classList.add("emphasis");
    }
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    ///boolMax
    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.valueStyle = this.ChartFonts.graphicColor(this.index);
        this.doAddValueElement(element, argprops, true);
    }

    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond " + " item" + this.graphicElement.hposition;
    subelement.style.width = 100 + "%";
    subelement.style.order = 2;
    // subelement.style.flex = "unset";
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < this.length; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

function Single3DPieSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.iconRow = 10;
    this.iconColumn = 10;
    this.valueMaxW = 0;
    this.labelMaxW = 0;
    this.dummeylabelMaxW = 0;
    this.labeMaxH = 0;
    this.valueMaxH = 0;
    this.styleShape = null;
    this.graphicH = 0;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
    this.boolDisableWidth = true;
}
Single3DPieSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
Single3DPieSeriesItem.prototype.constructor = Single3DPieSeriesItem;

Single3DPieSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
        overlap: this.data.layout.labeloverlap,
    });
    this.labelMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.labeMaxH = this.state.height * 0.5;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
        overlap: this.data.layout.valueoverlap,
    });
    this.valueMaxW = this.state.width * this.gapPercentage * this.thicknessPercentage;
    this.valueMaxH = this.state.height * 0.5; //< 35 ? this.state.height : 35;

    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
        overlap: this.data.layout.placeholderoverlap,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    if (this.valueAlignment.itemBased == "true") this.valueMaxW = this.state.width * 0.4;
    if (this.labelAlignment.itemBased == "true") this.labelMaxW = this.state.width * 0.4;
};

Single3DPieSeriesItem.prototype.doAddGraphicElement = function () {
    // this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.valuesDenomination[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

Single3DPieSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numTopHeight = argprops.maxvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight = this.labelAlignment && (this.labelAlignment.position == "middle" || this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle") ? 143 : 63;
        if (numTopHeight < minimumHeight && argprops.minvalue < 0) {
            numTopHeight = minimumHeight;
        }
        numTopHeight = numTopHeight < this.itembasedHeight ? this.itembasedHeight : numTopHeight;
    }

    let minGraphicHeight = (numTopHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem topseriesitem";
    element.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numTopHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        this.doAddTopGraphicsContainer(element, eprops);
        // if (this.displayPrimaryPlaceholder(eprops) && this.placeholderAlignment.valueAlignment == "top") {
        //     this.doAddTopPlaceholder(element, eprops);
        // }
        // if (this.displayValue(eprops) && this.valuePosition == "top") {
        //     this.doAddTopValue(element, eprops);
        // }
    }
};

Single3DPieSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    this.styleShape = this.data.layout.waffleShape ? this.data.layout.waffleShape : "rect";
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);
    let middleelementValue;
    let middleelementLabel;
    let middleelementPlaceholder;
    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.dummeylabelMaxW * 0.5 : this.dummeylabelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder")) {
        this.middlePW = parseInt(this.state.width * 0.7 * 0.25);
        this.middlePH = parseInt(this.state.width * 0.7 * 0.25);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6)); //+ this.maxValueH
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.maxvalue);

    if (this.data.chartName == "columnFillRectangle") {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.chartName == "columnFillRectangle") bgClsFillStyle = this.ChartFonts.emphasizeColor;
        const backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        element.appendChild(backgroundElement);
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); // this.ChartFonts.graphicBgColor(styleIndex);
    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? "secondary-bg-color" : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? clsStyle : clsStyle;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner ";
    subelement.style.justifyContent = "center ";
    if (this.labelAlignment.vposition == "middle" && this.labelAlignment.itemBased == "true") {
        subelement.style.alignItems = "center";
    } else {
        subelement.style.alignItems = "flex-end";
    }
    subelement.style.width = 100 * this.thicknessPercentage + "%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center") subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    subelement.style.height = 100 + "%";
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);

    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic transformOrginBottom";
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.display = "flex";
    graphicElement.style.alignItems = "center";
    graphicElement.style.position = "relative";
    graphicElement.style.justifyContent = "center";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    subelement.appendChild(graphicElement);

    clsStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.setNoEmphasis(graphicElement, clsStyle, groupindex) : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.setHasEmphasis(graphicElement, clsStyle, groupindex) : clsStyle;

    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true" || this.labelAlignment.position == "inner" || this.valueAlignment.position == "inner" || this.placeholderAlignment.position == "inner")
    ) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = this.graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.maxWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.5 + "px" : "100%";
        this.labelMaxW = this.state.width * 0.5;
        if (!booloverLap) subelement.appendChild(sameElement);
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle = this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;

            if (booloverLap) this.doAddLabel(element, argprops);
            else this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle = this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (booloverLap) this.doAddTopValue(element, argprops, "", true);
            else this.doAddTopValue(sameElement, argprops, "", true);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle = this.placeholderAlignment.itemBased == "true" ? this.ChartFonts.graphicFillColor(styleIndex) : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelInnerColor;
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.doAddLabel(labelElement, argprops);
        } else if ((this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") || this.graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        this.graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);

        this.doAddTopValue(element, argprops, true, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if ((this.valueAlignment.position == "outer" || this.graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) && this.valueAlignment.itemBased != "true") {
            this.valueStyle = this.data.hasEmphasis && this.data.emphasis[groupindex] != true ? this.ChartFonts.valueOuterColor : this.data.hasEmphasis && this.data.emphasis[groupindex] == true ? this.ChartFonts.graphicColor(styleIndex) : this.ChartFonts.valueOuterColor;
            if (this.data.chartName == "columnFillRectangle") this.doAddTopValue(argparent, argprops, "", true);
            else this.doAddTopValue(element, argprops, "", true);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopValue(valueElement, argprops, "", true);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.valueStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddTopValue(argparent, argprops, "", true);
        }
    }
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? subelement.clientWidth * 0.5 : subelement.clientWidth;
    let graphicHeight = subelement.clientHeight;
    let iconVerSize = graphicWidth / this.iconColumn;
    let iconHorSize = graphicHeight / this.iconRow;
    this.iconsize = iconVerSize < iconHorSize ? iconVerSize : iconHorSize;
};

Single3DPieSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false, customgraphicHeight) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let calloutStyle = "";
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 45 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }
    if (this.boolDisableWidth) {
        element.style.width = "";
    } else {
        element.style.width = this.valueMaxW + "px";
    }
    if (graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH) && this.valueAlignment.itemBased != "true" && this.valueAlignment.position == "inner") {
        if (this.groupindex == 0) {
            element.style.marginLeft = "auto";
        } else {
            element.style.marginRight = "auto";
        }
    }
    if (this.data.layout.valueColor == "item" && this.valueStyle == this.ChartFonts.valueOuterColor) {
        this.valueStyle = this.ChartFonts.appendgraphicColor(this.groupindex); // "accent" + (this.groupindex + 1) + "-color";
    }

    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);

    if (boolenablePer && this.data.displayValueFormat != "number") {
        if (this.data.suffix[this.groupindex][this.index] == "") {
            subelement.innerText = parseFloat(argprops.valuetext) > 100 ? "100%" : this.data.prefix[this.groupindex][this.index] + parseFloat(argprops.value) + "%";
        }
    }
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    if (customgraphicHeight) {
        subelement.setAttribute("data-graphic-y", customgraphicHeight);
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    subelement.dataset.animation = "secondarytext";
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    element.appendChild(subelement);
    if (this.data.displayValueFormat == "outof" || this.data.displayValueFormat == "fraction") {
        subelement.setAttribute("data-fraction", "true");
    }
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }

    if (this.valueAlignment.textbg == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgstyle == "style6") {
            element.classList.add("moodanimation");
            element.dataset.animation = "bgsecondarytext";
        }
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
            calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                subelement.classList.add("calloutbgstyle" + groupindex);
                subelement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
            }
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction" && !this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }
    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex));
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this.index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    if (this.data.connectorLine) {
        element.style.minHeight = parseFloat(element.style.minHeight) + 50 + "px";
    }
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        argparent.removeChild(element);
        if (parseFloat(fontsize) <= 25 && calloutStyle != "textbgcalloutstyle4top") {
            this.valueMaxLimit = this.valueOverlapping();
        } else {
            if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
                this.removeGrid();
            }
        }
    } else {
        fontsize = window.getComputedStyle(subelement)["font-size"];
        if (overlapgrid && calloutStyle != "textbgcalloutstyle4top") {
            element.style.display = "none";
        }
    }
    if (!boolmax) {
        this.ChartUtils.createSpanFormat(subelement, this.data);
        subelement.style.overflow = "hidden";
    }
};
Single3DPieSeriesItem.prototype.createGraphicSVG = function (argparent, argprops, width, height, index) {
    let intPad = this.data.chartName != "singlewaffleiconchart" ? 5 : 0;
    let graphicHeight = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? argparent.clientWidth * 0.5 : argparent.clientWidth;
    let graphicWidth = argparent.clientWidth;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "bggraphics-" + this.groupindex + "_" + this.index,
        class: "bggraphics",
        x: "0px",
        y: "0px",
        width: "100%",
        height: "100%",
        style: "position:absolute;left:0;margin:auto;right:0",
    });

    let strStyleClass = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor") + " moodanimation";
    let intVerIndex = this.iconRow - 1;
    let intHerIndex = 0;
    let intColumn = this.iconColumn;
    let intDrawW = this.iconsize * this.iconColumn;
    let intDrawH = this.iconsize * this.iconRow;

    graphicWidth = graphicWidth > intDrawW ? intDrawW : graphicWidth;
    graphicHeight = graphicHeight > intDrawH ? intDrawH : graphicHeight;

    let intDrawX = (graphicWidth - intDrawW) / 2 < 0 ? this.state.x : this.state.x + (graphicWidth - intDrawW) / 2;
    let intDrawY = (graphicHeight - intDrawH) / 2 < 0 ? this.state.y : this.state.y + (graphicHeight - intDrawH) / 2;

    let iconCount = parseInt(this.data.values[0][0]) > 100 ? 100 : parseInt(this.data.values[0][0]);
    let iconWH = 0;
    for (let i1 = 0; i1 < iconCount; i1++) {
        if (i1 != 0 && parseInt(i1 % intColumn) == 0) {
            intHerIndex = 0;
            intVerIndex--;
        }
        let svgIcon;
        if (this.data.chartName != "singlewaffleiconchart") {
            if (this.styleShape == "circle") {
                svgIcon = this.data.SVGUtils.createSVGElement("circle");
            } else {
                svgIcon = this.data.SVGUtils.createSVGElement("rect");
            }
        } else {
            svgIcon = this.data.SVGUtils.createSVGElement("use");
        }

        let iconX = intDrawX + this.iconsize * intHerIndex + intPad;
        let iconY = intDrawY + this.iconsize * intVerIndex + intPad;
        iconWH = this.iconsize - intPad * 2;
        if (this.styleShape == "circle") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "rect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                cx: iconX + iconWH / 2 + "px",
                cy: iconY + iconWH / 2 + "px",
                r: iconWH / 2,
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "data-animation": "item",
            });
        } else {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "rect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                x: iconX + "px",
                y: iconY + "px",
                width: iconWH,
                height: iconWH,
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                "data-animation": "item",
            });
        }

        intHerIndex++;
        svgElement.appendChild(svgIcon);
        if (this.data.chartName == "singlewaffleiconchart") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "xlink:href": "#" + this.data.itemPlacehoders[index],
            });
        }
    }
    this.data.SVGUtils.assignAttributes(svgElement, {
        width: (iconWH + intPad * 2) * 10,
        height: (iconWH + intPad * 2) * 10,
    });
    argparent.appendChild(svgElement);
};
Single3DPieSeriesItem.prototype.createBgGraphicSVG = function (argparent, argprops, width, height, index) {
    let intPad = this.data.chartName != "singlewaffleiconchart" ? 5 : 0;
    let graphicWidth = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? argparent.clientWidth * 0.5 : argparent.clientWidth;
    let graphicHeight = argparent.clientHeight;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "bggraphics-" + this.groupindex + "_" + this.index,
        class: "bggraphics",
        x: "0px",
        y: "0px",
        width: "100%",
        height: "100%",
    });
    argparent.appendChild(svgElement);

    if (this.data.chartName == "singlewaffleiconchart") {
        let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(dummySVGNode, {
            "xlink:href": "#" + this.data.itemPlacehoders[argprops.gindex],
            opacity: 0,
        });
        svgElement.appendChild(dummySVGNode);
        let bounds = dummySVGNode.getBBox();
        svgElement.removeChild(dummySVGNode);
        let tempHeight = graphicHeight / bounds.height;
    }
    let strStyleClass = this.ChartFonts.emphasizeFillColor + " moodanimation";
    let intVerIndex = this.iconRow - 1;
    let intHerIndex = this.iconColumn - 1;
    let intColumn = this.iconColumn;
    let intDrawW = this.iconsize * this.iconColumn;
    let intDrawH = this.iconsize * this.iconRow;
    graphicWidth = graphicWidth > intDrawW ? intDrawW : graphicWidth;
    graphicHeight = graphicHeight > intDrawH ? intDrawH : graphicHeight;
    let intDrawX = (graphicWidth - intDrawW) / 2 < 0 ? this.state.x : this.state.x + (graphicWidth - intDrawW) / 2;
    let intDrawY = (graphicHeight - intDrawH) / 2 < 0 ? this.state.y : this.state.y + (graphicHeight - intDrawH) / 2;
    let iconWH = 0;
    for (let i1 = 0; i1 <= 99; i1++) {
        if (i1 != 0 && parseInt(i1 % intColumn) == 0) {
            intHerIndex = 9;
            intVerIndex--;
        }
        let svgIcon;
        if (this.data.chartName != "singlewaffleiconchart") {
            if (this.styleShape == "circle") {
                svgIcon = this.data.SVGUtils.createSVGElement("circle");
            } else {
                svgIcon = this.data.SVGUtils.createSVGElement("rect");
            }
        } else {
            svgIcon = this.data.SVGUtils.createSVGElement("use");
        }
        let iconX = intDrawX + this.iconsize * intHerIndex + intPad;
        let iconY = intDrawY + this.iconsize * intVerIndex + intPad;
        iconWH = this.iconsize - intPad * 2;
        if (this.styleShape == "circle") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "backgroundminirect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                cx: iconX + iconWH / 2 + "px",
                cy: iconY + iconWH / 2 + "px",
                r: iconWH / 2,
                "data-customopacity": "0.5",
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                opacity: 0.5,
                "data-animation": "itembackground",
            });
        } else {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                id: "backgroundminirect-" + this.groupindex + "_" + this.index,
                class: strStyleClass,
                x: iconX + "px",
                y: iconY + "px",
                width: iconWH,
                height: iconWH,
                "data-customopacity": "0.5",
                "data-graphic-x": iconX + iconWH / 2,
                "data-graphic-y": iconY + iconWH / 2,
                "data-customtransformboxstart": "null",
                "data-customtransformboxend": "null",
                "data-customorgin": "null",
                opacity: 0.5,
                "data-animation": "itembackground",
            });
        }
        if (this.data.chartName == "singlewaffleiconchart") {
            this.data.SVGUtils.assignAttributes(svgIcon, {
                "xlink:href": "#" + this.data.itemPlacehoders[index],
            });
        }
        intHerIndex--;
        svgElement.appendChild(svgIcon);
    }
    this.data.SVGUtils.assignAttributes(svgElement, {
        width: (iconWH + intPad * 2) * 10,
        height: (iconWH + intPad * 2) * 10,
    });
};

function SimpleAssetPieChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimplePieChart";
    BasePieChart.call(this, argparent, argprops);
}
SimpleAssetPieChart.prototype = Object.create(BasePieChart.prototype);
SimpleAssetPieChart.prototype.constructor = SimpleAssetPieChart;

SimpleAssetPieChart.prototype.seriesInstance=function(argparent, argprops) 
{
        return new window["SimpleAssetPieSeries"](argparent, argprops);
}

function SimpleAssetPieSeries(argparent, argprops){
    this.name = "SimpleAssetPieSeries";
    BasePieSeries.call(this, argparent, argprops);
}
SimpleAssetPieSeries.prototype = Object.create(BasePieSeries.prototype);
SimpleAssetPieSeries.prototype.constructor = SimpleAssetPieSeries;

SimpleAssetPieSeries.prototype.seriesItemInstance=function(argparent, argprops) {
    return new window["SimpleAssetPieSeriesItem"](argparent, argprops);

}
function SimpleAssetPieSeriesItem(argparent, argprops){
    this.name = "SimplePieSeriesItem";
    this.groupindex = argprops.groupindex;
    BasePieSeriesItem.call(this, argparent, argprops);
}
SimpleAssetPieSeriesItem.prototype = Object.create(BasePieSeriesItem.prototype);
SimpleAssetPieSeriesItem.prototype.constructor = SimpleAssetPieSeriesItem;

SimpleAssetPieSeriesItem.prototype.doAddGraphicElement=function() {
    let intStrokeWidth = 10;
    let pntEnd = { x: 0, y: 0 };
    let pntStart = { x: 0, y: 0 };
    let pntInnerEnd = { x: 0, y: 0 };
    let pntInnerStart = { x: 0, y: 0 };
    this.outerRadius = this.outerRadius;//- intStrokeWidth;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    if (pntEnd.x == pntStart.x && this._strokeWidth == 0) {
        pntEnd.y = 0;
        pntStart.y = 0;
    }
    pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
    pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        class: "graphic",
        x: "0%",
        y: "0%",
        width: this.state.width + "px",
        height: this.state.width + "px",
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-maxangle": this.maxAngle,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius
    });

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path_to-" + this.groupIndex + "_" + this.index,
        class: "path_to transformOrgincenter chartgraphic",
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntEnd.x +
            "," +
            pntEnd.y +
            "L" +
            pntInnerEnd.x +
            "," +
            pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "stroke-width": intStrokeWidth + "px",
    });
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let clipPath = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(clipPath, { 
        id: "mask" + this.groupindex,
        "data-maskelement": "true"
    });
    defsTag.appendChild(clipPath);
    clipPath.appendChild(svgPathTo);
    this.asset = this.data.asset.data[0].data;
    let svgAsset
    if (!this.asset) {
        if (this.data.presentMode) {
            svgAsset = this.data.slideObj.querySelector("#series-0").parentElement.querySelector("#container").children[0].children[0].children[0].cloneNode("true")
        } else {
            if(this.data.slideObj.querySelector("#series-" + argprops.gindex)){
                svgAsset = this.data.slideObj.querySelector("#series-" + argprops.gindex).querySelector("#container").children[0].children[0].children[0].cloneNode("true")
            }else{
                svgAsset = this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0].cloneNode("true")
            }
        }
    } else {
        svgAsset = this.asset.cloneNode(true);
    }
    this.data.SVGUtils.assignAttributes(svgAsset,{
        class:this.getBgFillDetails(this.groupindex,this.data.ChartFonts.graphicFillColor(this.groupindex),this.data.layout.itemColor,"bgcolor")//this.data.ChartFonts.graphicFillColor(this.groupindex)
    })
    let baseGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(baseGroup,{
        class:"transformOrginCenter moodanimation",
        "data-animation":"imageitem"
    })
    let childGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(childGroup,{
     "transform":"scale(0.8)",
     "transform-origin":"center",
     mask:"url(#mask" + this.groupindex +")",
     "data-maskelement": "true"
    })
   
    let childSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(childSvg,{
        width: this.state.width + "px",
        height: this.state.width + "px",
        
    })
    baseGroup.appendChild(childSvg)
    childSvg.appendChild(childGroup)

    svgElement.appendChild(baseGroup)
    childGroup.appendChild(svgAsset)
    this.parent.appendChild(svgElement);
}


// import BaseChart from "../base/baseChart/BaseChart.js";
// import VOLayout from "../../datamodels/VOLayout";
// import VOBaseProperties from "../../datamodels/VOBaseProperties.js";
// import SVGUtils from "../../../../../util/SVGUtils.js";

function CombinationModel(argparent, argprops) {
    this.ChartFonts = new window["ChartFonts"]();
    BaseChart.call(this, argparent, argprops);
     this.viewBox = false;
        this.isComputed = false;
        this.uiGridDesk = null;
        this.uiAnnotation = null;
        this.uiLegendDesk = null;
        this.voData = null;
        this.voDataSecondary = null;
        this.seriesLength = 0;
        this.primaryitems = [];
        this.secondaryitems = [];
        this.viewportGrid = { x: 0, y: 0, width: 0, height: 0 };
        this.viewportGroup = { x: 0, y: 0, width: 0, height: 0 };
        this.viewportLegend = { x: 0, y: 0, width: 0, height: 0 };
        this.rectSeriesSize = { x: 0, y: 0, width: 0, height: 0 };
        this.viewportAxisXLabel = { x: 0, y: 0, width: 0, height: 0 };
        this.viewportAxisYLabel = { x: 0, y: 0, width: 0, height: 0 };
        this.viewportSeriesGroup = { x: 0, y: 0, width: 0, height: 0 };
        this.object = {
            barSimpleRectangle: "barSimpleRectangle",
            lineChart: "lineChart",
            areaChart: "areaStandard",
            scatterChart: "scatterChart",
            bubbleChart: "bubbleChart"
        };
    
}
CombinationModel.prototype = Object.create(BaseChart.prototype);
CombinationModel.prototype.constructor = CombinationModel;

Object.defineProperties(CombinationModel.prototype, {
    'data': {
        get: function () {
            return this.voData
        },
        set: function (value) {
            this.voData = value;
            this.voDataPrimary = this.ChartUtils.clone(value);
            this.voDataPrimary.axisDisplayFormat = "hidden";
            this.voDataPrimary._valueDisplayFormat = "hidden";
            // this.voDataPrimary.customProperties =  this.voData.customProperties;
            this.voDataSecondary = this.ChartUtils.clone(value);
            this.voDataSecondary.values = this.voDataSecondary.secondaryValues;
            this.voDataSecondary.valuesDenomination = this.voDataSecondary.secondaryValues;
            this.voDataSecondary.longValue = this.voDataSecondary.slongValue;
            this.voDataSecondary.longLengthValue = this.voDataSecondary.slongLengthValue;
            this.voDataSecondary.rangeTotal = this.voDataSecondary.srangeTotal;
            this.voDataSecondary.rangePositive = this.voDataSecondary.srangePositive;
            this.voDataSecondary.rangeNegative = this.voDataSecondary.srangeNegative;
            this.voDataSecondary.valuesType = "secondary";
            this.voDataSecondary.axisDisplayFormat = "hidden";
            this.voDataSecondary.labelDisplayFormat = "hidden";
            this.voDataSecondary.isCombination = true;
            this.voDataSecondary._valueDisplayFormat = "hidden";
            this.voDataSecondary.valuesDenominationSuffix = this.voDataSecondary.secondaryValuesDenominationSuffix;
            this.doComputation();
        }
    },
    'datavalidation': {
        get: function () {
            return this.data != null ? true : false;
        },
        set: function (value) {
            this.voData = value;
            this.doComputation();
        }
    },
});
CombinationModel.prototype.updateBasicData = function () {
    this.length = this.voData.seriesLength;
    this.primaryChartName =
        this.voDataPrimary.primaryChartName == "barHorizontalChart" ? "barVerticalChart" : this.voDataPrimary.primaryChartName;
    this.secondaryChartName =
        this.voDataSecondary.secondaryChartName == "barHorizontalChart" ? "barVerticalChart" : this.voDataSecondary.secondaryChartName;
        this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };

}
CombinationModel.prototype.doComputation = function() {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        // this.doLegendDeskComputation();
        this.doPrimaryElementsComputation();
        this.doSecondaryElementsComputation();
        // this.doGridDeskComputation();
        // this.doAnnotationComputation();
    }
}
CombinationModel.prototype.doSourcePath = function(jsonChartItem) {
    let arrJson = jsonChartItem.src.split("/");
    let srcJson;
    for (let i1 = 0; arrJson.length > i1; i1++) {
        if (i1 == 0) {
            srcJson = arrJson[i1 + 3];
            i1 = i1 + 3;
        } else srcJson += "/" + arrJson[i1];
    }
    return srcJson;
}
CombinationModel.prototype.doPrimaryElementsComputation = function() {
    let gridsize = 4;
    let gridRow = parseInt((this.state.width*0.5) / gridsize);
    let gridColumn = parseInt(this.state.height/ gridsize);
    let parentElement = document.createElement("div");
    parentElement.style.width = this.state.width+"px";
    parentElement.style.height = this.state.height+"px";
    parentElement.classList.add("baseparentnode");
    parentElement.style.display ="flex";
    this.parent.appendChild(parentElement)
    let PrimaryDiv = document.createElement("div");
    PrimaryDiv.style.width = (this.state.width*0.5)+"px";
    PrimaryDiv.style.height = this.state.height+"px";
    PrimaryDiv.classList.add("primaryParent");
    PrimaryDiv.style.gridTemplateRows = "repeat(" +gridColumn + ", " + gridsize + "px)";
    PrimaryDiv.style.gridTemplateColumns = "repeat(" + gridRow + ", " + gridsize + "px)";
    parentElement.appendChild(PrimaryDiv)
    let chartMenuCombination = this.data.menuparser.getChartOldMenuDetail("combinationModel",this.data.data.children.length);
    this.primaryChartName = chartMenuCombination.chart1.classname?chartMenuCombination.chart1.classname:this.primaryChartName;

    let chartMenu = this.data.menuparser.getChartOldMenuDetail(this.object[this.primaryChartName],this.data.data.children.length);
    let jsonChartItem = this.ChartHelper.getChartProperty("name", this.primaryChartName)[0];
    this.objLayout = chartMenuCombination.chart1.chartlayout 
    PrimaryDiv.classList.add(jsonChartItem.family)
    let voLayout =new window["VOLayout"](this.objLayout, this.data.data,chartMenu)
    // voLayout.showValue = false;
    voLayout.showAxisLine = this.voData._customProperties.showAxisLine;
    voLayout.showGridValue = this.voData._customProperties.showGridValue;
    voLayout.showGridLine = this.voData._customProperties.showGridLine;
    let voBaseProperties = new window["VOBaseProperties"](jsonChartItem);
    this.voData._baseProperties = voBaseProperties;
    //voBaseProperties.axisTitle = false;
    this.voDataPrimary.layout = voLayout;
    this.voDataPrimary.voBaseProperties = voBaseProperties;
    let mainClass = jsonChartItem.class;
    this.uiChart = new window[mainClass](PrimaryDiv, { gridsize: gridsize, gridrow: gridRow, gridcolumn: gridColumn, parentwidth: (this.state.width*0.5), parentheight: this.state.height });
    this.uiChart.ChartHelper = this.ChartHelper;
    this.uiChart.ChartUtils = this.ChartUtils;
    this.uiChart.data = this.voDataPrimary;
    this.uiChart.move(0, 0);
    this.uiChart.size(this.state.width*0.5, this.state.height);
}

CombinationModel.prototype.doSecondaryElementsComputation=function() {
    let gridsize = 4;
    let gridRow = parseInt(((this.state.width*0.5)) / gridsize);
    let gridColumn = parseInt(this.state.height / gridsize);
    let chartMenuCombination = this.data.menuparser.getChartOldMenuDetail("combinationModel",this.data.data.children.length);
    this.secondaryChartName = chartMenuCombination.chart2.classname?chartMenuCombination.chart2.classname:this.secondaryChartName;
    let chartMenu = this.data.menuparser.getChartOldMenuDetail(this.object[this.secondaryChartName],this.data.data.children.length);
    let jsonChartItem = this.ChartHelper.getChartProperty("name", this.secondaryChartName)[0];
    this.objLayout = chartMenuCombination.chart2.chartlayout;
    // voLayout.showLabel = false;
    // voLayout.showValue = false;
    let parentElement = this.parent.querySelector(".baseparentnode")
    let secondaryDiv = document.createElement("div");
    secondaryDiv.style.width = this.state.width*0.5+"px";
    secondaryDiv.style.height = this.state.height+"px";
    secondaryDiv.classList.add("secondaryParent");
    secondaryDiv.style.overflow = "hidden";
    secondaryDiv.style.gridTemplateRows = "repeat(" +gridColumn + ", " + gridsize + "px)";
    secondaryDiv.style.gridTemplateColumns = "repeat(" + gridRow + ", " + gridsize + "px)";
    parentElement.appendChild(secondaryDiv)
    secondaryDiv.classList.add(jsonChartItem.family)

    let voLayout =new window["VOLayout"](this.objLayout, this.data.data,chartMenu)
    // voLayout.showValue = false;
    voLayout.showAxisLine = this.voData._customProperties.showAxisLine;
    voLayout.showGridValue = this.voData._customProperties.showGridValue;
    voLayout.showGridLine = this.voData._customProperties.showGridLine;
    let voBaseProperties = new window["VOBaseProperties"](jsonChartItem);
    this.voData._baseProperties = voBaseProperties;
    //voBaseProperties.axisTitle = false;
    this.voDataSecondary.layout = voLayout;
    this.voDataSecondary.voBaseProperties = voBaseProperties;
    let mainClass = jsonChartItem.class;
    this.uiChart = new window[mainClass](secondaryDiv, { gridsize: gridsize, gridrow: gridRow, gridcolumn: gridColumn, parentwidth: (this.state.width*0.5), parentheight: this.state.height });
    this.uiChart.ChartHelper = this.ChartHelper;
    this.uiChart.ChartUtils = this.ChartUtils;
    this.uiChart.data = this.voDataSecondary;
    this.uiChart.move(0, 0);
    this.uiChart.size((this.state.width*0.5), this.state.height);

}
