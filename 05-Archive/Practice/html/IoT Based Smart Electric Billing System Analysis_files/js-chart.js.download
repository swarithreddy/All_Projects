                calloutDiv = parent.parentNode.parentNode.parentNode.querySelector("#callOut");

                // this.data.calloutInstance.displaybox(parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrLeftText[i2], 1, false, {}, "", "", objCallout);
                // calloutDiv = parent.parentNode.querySelector("#calloutContainerDiv");
            }
            if (calloutDiv) {
                parent.parentNode.appendChild(calloutDiv);
                calloutDiv.style.position = "absolute";
                calloutDiv.setAttribute("id", "baselinecalloutContainerDiv");
                let calloutText = calloutDiv.querySelector("#callout-title");
                let pointerDiv = calloutDiv.querySelector(".callout-pointholder");
                if (pointerDiv) pointerDiv.style.pointerEvents = "none";
                calloutDiv.dataset.animation = "baselinecallout";
                calloutDiv.classList.add("moodanimation");
                if (calloutText) {
                    calloutText.setAttribute("contenteditable", "true");
                    calloutText.dataset.type = "baselinecallout";
                    this.ChartHelper.setTextChangeListner(calloutText);
                    calloutText.contentEditable = true;
                    calloutText.setAttribute("data-dck-selector", "true");
                    calloutText.setAttribute("data-dck-selector", "true");
