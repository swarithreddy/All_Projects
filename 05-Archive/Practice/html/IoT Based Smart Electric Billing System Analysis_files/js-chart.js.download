                if (this.data.moodData.calloutstyle) {
                    try {
                        instance = new window[this.data.moodData.calloutstyle](parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrBottomText[i1], 1, false, {}, "", "", objCallout);
                    } catch (error) {
                        instance = new window["HighlightTest"](parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrBottomText[i1], 1, false, {}, "", "", objCallout);
                    }
                } else {
                    instance = new window["HighlightTest"](parent, objCallout.viewPortBounds, objCallout.targetBounds, alignment, arrBottomText[i1], 1, false, {}, "", "", objCallout);
                }
                let designerCalloutDiv = instance.querySelector("#callout-textparent");
