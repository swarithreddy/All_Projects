        this.data.removeAttribute("data-baseline");
    }
    this._comparePlaceholderPath = [];
    this._comparePlaceholder = this._data.getAttribute("enablecompareplaceholder") == "false" ? false : this._data.getAttribute("comparedivider") == "true" ? true : false;

    this._compareTitle = [];
    if (this.voLayout.labelColor) {
        this._labelColorClass = "";
    }
    if (this.voLayout.valueColor) {
        this._valueColorClass = "";
    }
    if (this._comparePlaceHoldertext) {
        this.showLegend = false;
        let arrCompareTitle = this._data.getAttribute("comparetitle") ? this._data.getAttribute("comparetitle").split(",") : ["", ""];
        this._compareTitle = arrCompareTitle;
    }
    // this._percentilePoints =
    if (this._moodData?.rtlsupport && hasDirection) {
        if (argProps?.divParent) argProps.divParent.classList.add("directionchangeenable");
        this._directionenable = true;
    }
    if (this._moodData?.rtlsupport && this.baseProperties.family == "bar") {
        if (!this._data.hasAttribute("chartflip")) {
            this._chartFlip = true;
            this._data.setAttribute("chartflip", true);
        }
        if (argProps?.divParent) argProps.divParent.classList.remove("directionchangeenable");
        if (argProps?.divParent) argProps.divParent.classList.add("directionchangedisable");
        this._directionenable = false;
    } else {
        if (!this._customProperties.chartFlip) {
            this._chartFlip = false;
        }
        if (argProps?.divParent) argProps.divParent.classList.remove("directionchangedisable");
    }
    if (this._boolEnablesequeceNumber && this.voLayout.labelItemBased != "true" && this.voLayout.labelInset != "inside") {
        this.enableSequecelabel = true;
    }
    if (this._data.getAttribute("projectiondivider")) {
        this._projectionDivider = true;
    }
    // if(!this._customProperties.showValueFormat){
    //     this._displayValueFormat = "percentage";
    // }
    if (this.data.getAttribute("highlightvalue") != "false") this.data.removeAttribute("highlightvalue");
    this.arrLabelOpacity = [];
    this.arrLabeltexttransform = [];
    this.arrSecondaryLabelOpacity = [];
    this.arrLabelFontStyle = [];
    this.arrLabelTextSize = [];
    this.arrsecondaryLabeltexttransform = [];
    this.arrsecondaryLabelFontStyle = [];
    this.arrSecondaryLabelTextSize = [];
    let defaultIconCount = 0;
    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        let chartItem = this._data.children[seriesIndex];
        let secondarName = chartItem.getAttribute(ChartPropertiesName.secondaryName);
        this._logoContrast[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.logocontrast) ? chartItem.getAttribute(ChartPropertiesName.logocontrast) : "false";
        let secondaryElementType = "image";
        let labelLineHeight = this._data.children[seriesIndex].getAttribute("labellineheight") ? this._data.children[seriesIndex].getAttribute("labellineheight") : "";
        this.labelLineHeight.push(labelLineHeight);
        let legendLineHeight = this._data.children[seriesIndex].getAttribute("legendlineheight") ? this._data.children[seriesIndex].getAttribute("legendlineheight") : "";
        this.legendlabellineHeight.push(legendLineHeight);
        let labelTextColor = this._data.children[seriesIndex].getAttribute("legendlabeltextcolor") || this._data.children[seriesIndex].getAttribute("labeltextcolor") || "";
        this._labelTextColor.push(labelTextColor);
        let mutiLegendColor = this._data.getAttribute("multilegendlabel" + seriesIndex + "textcolor") || "";
        this.multiLegendTextColor.push(mutiLegendColor);
        let secondaryLabelTextColor = this._data.children[seriesIndex].getAttribute("secondarylabeltextcolor") ? this._data.children[seriesIndex].getAttribute("secondarylabeltextcolor") : "";
        this._secondaryTextColor.push(secondaryLabelTextColor);

        let secondaryLabelLineHeight = this._data.children[seriesIndex].getAttribute("secondarylabellineheight") ? this._data.children[seriesIndex].getAttribute("secondarylabellineheight") : "";
        this.secondaryLabelLineHeight.push(secondaryLabelLineHeight);

        let labelletterspace = this._data.children[seriesIndex].getAttribute("labelletterspace") ? this._data.children[seriesIndex].getAttribute("labelletterspace") : "";
        this.labelLetterSpace.push(labelletterspace);
        let legendLetterspcaing = this._data.children[seriesIndex].getAttribute("legendletterspace") ? this._data.children[seriesIndex].getAttribute("legendletterspace") : "";
        this.legendlabelletterspacing.push(legendLetterspcaing);

        let secondaryLabelletterspace = this._data.children[seriesIndex].getAttribute("secondarylabelletterspacing") ? this._data.children[seriesIndex].getAttribute("secondarylabelletterspacing") : "";
        this.secondaryLabelLetterSpace.push(secondaryLabelletterspace);
        let labelOpacity = this._data.children[seriesIndex].getAttribute("labeltexttextopacity") ? this._data.children[seriesIndex].getAttribute("labeltexttextopacity") : "";
        this.arrLabelOpacity.push(labelOpacity);
        let labelTransform = this._data.children[seriesIndex].getAttribute("labeltexttexttransform") ? this._data.children[seriesIndex].getAttribute("labeltexttexttransform") : "";
        this.arrLabeltexttransform.push(labelTransform);
        let labelfontStyle = this._data.children[seriesIndex].getAttribute("labeltextfontsize") ? this._data.children[seriesIndex].getAttribute("labeltextfontsize") : this._data.getAttribute("labeltextfontsize") ? this._data.getAttribute("labeltextfontsize") : "";
        this.arrLabelFontStyle.push(labelfontStyle);
        let labeltextsize = this._data.children[seriesIndex].getAttribute("labeltexttextsize") ? this._data.children[seriesIndex].getAttribute("labeltexttextsize") : this._data.getAttribute("labeltexttextsize") ? this._data.getAttribute("labeltexttextsize") : "";
        this.arrLabelTextSize.push(labeltextsize);
        let secondarylabelOpacity = this._data.children[seriesIndex].getAttribute("secondarylabeltexttextopacity") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttextopacity") : "";
        this.arrSecondaryLabelOpacity.push(secondarylabelOpacity);
        let secondarylabelTransform = this._data.children[seriesIndex].getAttribute("secondarylabeltexttexttransform") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttexttransform") : "";
        this.arrsecondaryLabeltexttransform.push(secondarylabelTransform);
        let secondarylabelfontStyle = this._data.children[seriesIndex].getAttribute("secondarylabeltextfontsize") ? this._data.children[seriesIndex].getAttribute("secondarylabeltextfontsize") : "";
        this.arrsecondaryLabelFontStyle.push(secondarylabelfontStyle);
        let Secondarylabeltextsize = this._data.children[seriesIndex].getAttribute("secondarylabeltexttextsize") ? this._data.children[seriesIndex].getAttribute("secondarylabeltexttextsize") : "";
        this.arrSecondaryLabelTextSize.push(Secondarylabeltextsize);

        let compareLabelLineHeight = this._data.children[seriesIndex].getAttribute("comparetitlelineheight") ? this._data.children[seriesIndex].getAttribute("comparetitlelineheight") : "";
        this.compareTitleLineHeight.push(compareLabelLineHeight);
        let compareLabelletterspace = this._data.children[seriesIndex].getAttribute("comparetitleletterspcing") ? this._data.children[seriesIndex].getAttribute("comparetitleletterspcing") : "";
        this.compareTitleLetterSpace.push(compareLabelletterspace);
        let labelhighlightColor = this._data.children[seriesIndex].getAttribute("labelHighlightcolor") ? this._data.children[seriesIndex].getAttribute("labelHighlightcolor") : "";
        this._labelHighlightColor.push(labelhighlightColor);
        let defaultImagePath = "";
        let defaultLogoPath = "";
        let defaultIconPath = "";
        if (arrDefaultplaceholderimage.length > 0) {
            if (arrDefaultplaceholderimage.length > seriesIndex && arrDefaultplaceholderimage[seriesIndex]) {
                defaultImagePath = arrDefaultplaceholderimage[seriesIndex].value;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultplaceholderimage.length);
                defaultImagePath = arrDefaultplaceholderimage[indexValue].value;
            }
        }
        if (arrDefaultlogoimage.length > 0) {
            if (arrDefaultlogoimage.length > seriesIndex && arrDefaultlogoimage[seriesIndex]) {
                defaultLogoPath = arrDefaultlogoimage[seriesIndex].value;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultlogoimage.length);
                defaultLogoPath = arrDefaultlogoimage[indexValue].value;
            }
        }
        if (arrDefaultPlaceholderIcons.length > 0) {
            if (arrDefaultPlaceholderIcons.length > seriesIndex && arrDefaultPlaceholderIcons[seriesIndex]) {
                defaultIconPath = arrDefaultPlaceholderIcons[seriesIndex].value;
            } else {
                let indexValue = ChartUtils.getFactorIndex(seriesIndex, arrDefaultPlaceholderIcons.length);
                defaultIconPath = arrDefaultPlaceholderIcons[indexValue].value;
            }
            if (defaultIconPath) {
                this._chartPlaceHolder = defaultIconPath;
            }
        }
        let strName = chartItem.getAttribute(ChartPropertiesName.name);
        let strComparisonName = chartItem.getAttribute(ChartPropertiesName.comparisonName);
        let strLegendName = chartItem.getAttribute(ChartPropertiesName.legendName);
        let strValue = chartItem.getAttribute(ChartPropertiesName.value);
        let strHighlight = chartItem.getAttribute(ChartPropertiesName.highlight);
        let strlineHighlightText = chartItem.getAttribute("linehighlighttext") ? chartItem.getAttribute("linehighlighttext") : "";
        let promptText = chartItem.getAttribute(ChartPropertiesName.prompttext) ? chartItem.getAttribute(ChartPropertiesName.prompttext) : "";
        let valueHdDisplayText = chartItem.getAttribute(ChartPropertiesName.hdcustomtext) ? chartItem.getAttribute(ChartPropertiesName.hdcustomtext) : "";
        let boolLineStyleValueShow = chartItem.getAttribute(ChartPropertiesName.linestylevalueshow) ? chartItem.getAttribute(ChartPropertiesName.linestylevalueshow) : "true";
        let length = strValue.split(",").length;
        this.axisHorLetterspaceing = this._data.getAttribute("axishorletterspacing");
        this.axisVerLetterspaceing = this._data.getAttribute("axisverletterspacing");
        this.hasCustomHighlight = this._data.getAttribute("axisverletterspacing");
        if (this._data.getAttribute("customhighlight") == "true") {
            let customHighlightIndex = this._data.getAttribute("customhighlightpoint") && this._seriesLength >= parseInt(this._data.getAttribute("customhighlightpoint")) ? parseInt(this._data.getAttribute("customhighlightpoint")) : Math.floor(this._seriesLength / 2);
            if (seriesIndex == customHighlightIndex) {
                strHighlight = "true";
            }
        }
        if (this._primaryChartName || this._secondaryChartName) {
            if (!chartItem.getAttribute(ChartPropertiesName.secondaryValue)) chartItem.setAttribute(ChartPropertiesName.secondaryValue, strValue);
        }
        //prompt text
        if (this.baseProperties.promptText) {
            let seriesPromptArr = [];
            if (!promptText) {
                for (let p1 = 0; p1 < length; p1++) {
                    seriesPromptArr.push("");
                }
                promptText = seriesPromptArr.join(",");
            } else {
                let arrText = promptText.split(",");
                for (let p2 = 0; p2 < length; p2++) {
                    if (!arrText[p2]) {
                        seriesPromptArr.push("");
                    } else {
                        seriesPromptArr.push(arrText[p2]);
                    }
                }
                promptText = seriesPromptArr.join(",");
            }
            this._promptText[seriesIndex] = promptText.split(",");
            chartItem.setAttribute(ChartPropertiesName.prompttext, promptText);
        }
        //hddisplayFormat
        if (this._indualHighlightDisplayFormat == "customlabel") {
            let seriesHdDisplayArr = [];
            if (!valueHdDisplayText) {
                for (let h1 = 0; h1 < length; h1++) {
                    seriesHdDisplayArr.push("");
                }
                valueHdDisplayText = seriesHdDisplayArr.join(",");
            } else {
                let arrHdText = valueHdDisplayText.split(",");
                for (let h2 = 0; h2 < length; h2++) {
                    if (!arrHdText[h2]) {
                        seriesHdDisplayArr.push("");
                    } else {
                        seriesHdDisplayArr.push(arrHdText[h2]);
                    }
                }
                valueHdDisplayText = seriesHdDisplayArr.join(",");
