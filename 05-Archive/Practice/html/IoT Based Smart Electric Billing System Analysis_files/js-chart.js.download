    this._compareDivider = this._data.getAttribute("comparedivider") == "true" ? true : false;
    this._hasMultiSlide = this._data.getAttribute("multislide") == "true" ? true : false;
    this._multiColor = this._data.getAttribute("data-multicolor") == "true" ? true : false;
    this._oldDisplayFormat = this._data.getAttribute("oldvalueformat");

