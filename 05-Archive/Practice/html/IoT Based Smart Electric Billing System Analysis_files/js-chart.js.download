    BaseColumnSeries.prototype.updateBasicData.call(this);
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.7;
};

