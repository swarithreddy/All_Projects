function RealObjectPieSeriesItem(argparent, argprops) {
    this.voData = null;
    this.pntCenter = {};
    this.endAngle = argprops.endAngle;
    this.startAngle = argprops.startAngle;
    BasePieSeriesItem.call(this, argparent, argprops);
}
RealObjectPieSeriesItem.prototype = Object.create(BasePieSeriesItem.prototype);
RealObjectPieSeriesItem.prototype.constructor = RealObjectPieSeriesItem;

RealObjectPieSeriesItem.prototype.updateBasicData = function () {
    BasePieSeriesItem.prototype.updateBasicData.call(this)
    let intAssetLength = this.data.asset.data.length;
    if (0 < intAssetLength) {
        if (this.voData.chartName == "pieamericandollarcoin" ||
            this.voData.chartName == "piebrazilianreaiscoin" ||
            this.voData.chartName == "piecanadiandollarscoin" ||
            this.voData.chartName == "piechineseyuancoin" ||
            this.voData.chartName == "pieeuroscoin" ||
            this.voData.chartName == "piefrenchfrancscoin" ||
            this.voData.chartName == "pieindianrupeescoin" ||
            this.voData.chartName == "piejapaneseyencoin" ||
            this.voData.chartName == "piesingaporedollarscoin" ||
            this.voData.chartName == "piesouthafricanrandcoin") this.assetURL =this.data.serverUrl + this.voData.asset.data[0].url;
        else {
            if (this.voData.asset.data.length < 5) {
                this.assetURL = this.data.serverUrl + this.voData.asset.data[0].url;
            } else {
                this.assetURL = this.data.serverUrl + this.voData.asset.data[this.getFactorIndex(this.groupindex, 7)].url;
            }
        }
    }
    this.asset = this.data.asset.data;
}

RealObjectPieSeriesItem.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index;
}

RealObjectPieSeriesItem.prototype.doAddGraphicElement = function () {
    let intStrokeWidth = 10;
    let pntEnd = { x: 0, y: 0 };
    let pntStart = { x: 0, y: 0 };
    let pntInnerEnd = { x: 0, y: 0 };
    let pntInnerStart = { x: 0, y: 0 };
    this.outerRadius = (this.outerRadius * 0.9);//- intStrokeWidth;
    pntEnd.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.endAngle) / 180));
    pntEnd.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.endAngle) / 180));
    pntStart.x = Math.round(this.pntCenter.x + this.outerRadius * Math.cos((Math.PI * this.startAngle) / 180));
    pntStart.y = Math.round(this.pntCenter.y + this.outerRadius * Math.sin((Math.PI * this.startAngle) / 180));
    if (pntEnd.x == pntStart.x && this._strokeWidth == 0) {
        pntEnd.y = 0;
        pntStart.y = 0;
    }
    pntEnd.x = pntEnd.x == pntStart.x && pntEnd.y == pntStart.y ? pntEnd.x - 0.001 : pntEnd.x;
    pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    pntInnerEnd.x = pntInnerEnd.x == pntInnerStart.x && pntInnerEnd.y == pntInnerStart.y ? pntInnerEnd.x - 0.001 : pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + this.groupindex + "_" + this.index,
        class: "graphic",
        x: "0%",
        y: "0%",
        width: this.state.width + "px",
        height: this.state.width + "px",
        viewBox: 0 + " " + 0 + " " + this.state.width + " " + this.state.height,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-maxangle": this.maxAngle,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.outerRadius
    });

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path_to-" + this.groupIndex + "_" + this.index,
        class: "path_to transformOrgincenter chartgraphic moodanimation",
        d:
            "M" +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "L" +
            pntStart.x +
            "," +
            pntStart.y +
            "A" +
            this.outerRadius +
            "," +
            this.outerRadius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            pntEnd.x +
            "," +
            pntEnd.y +
            "L" +
            pntInnerEnd.x +
            "," +
            pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            pntInnerStart.x +
            "," +
            pntInnerStart.y +
            "z",
        "stroke-width": intStrokeWidth + "px",
        "data-animation": "item"
    });
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let clipPath = this.data.SVGUtils.createSVGElement("clipPath");
    this.data.SVGUtils.assignAttributes(clipPath, {
    "data-maskelement": "true",

    id: this.data.slideID+"clipPath" + this.groupindex 
     });
    defsTag.appendChild(clipPath);
    clipPath.appendChild(svgPathTo);

    let imageTag = this.data.SVGUtils.createSVGElement("image");
    this.data.SVGUtils.assignAttributes(imageTag, {
        class: "imagetag transformOrgincenter moodanimation",
        id: "item-" + this.groupindex + "_" + this.index,
        "xlink:href": this.assetURL,
        x: this.pntCenter.x - this.outerRadius + "px",
        y: this.pntCenter.y - this.outerRadius + "px",
        width: 2 * this.outerRadius + "px",
        height: 2 * this.outerRadius + "px",
        "data-animation": "imageitem",
    });

    let svgGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgGroup, {
        class: "valuegroup",
        id: "svgGroup-" + this.groupindex + "_" + this.index,
        "clip-path": "url(#"+this.data.slideID+"clipPath" + this.groupindex + ")",
        "data-boolclippath":"true",
        "data-mask":'true',
        transform: "translate(" + this.props.centerPointPad.x + "," + this.props.centerPointPad.y + ")"
        //transform: "translate(" + 0 + "," + 0 + ")"
    });
    if(this.data.layout.itemFolder){
        this.data.SVGUtils.assignAttributes(imageTag, {
            "data-secondassetSource": this.data.layout.itemFolder,
            "data-type": "IMAGE"
        });
        this.data.SVGUtils.assignAttributes(svgElement, {
            "data-innertarget":"true",
            "data-type":"item"
        });
        imageTag.style.pointerEvents ="all";
        svgPathTo.style.pointerEvents ="none";
        this.data.SVGUtils.assignAttributes(svgGroup, {
            "data-graphicassetimage":"true"
        });
    }
    svgGroup.appendChild(imageTag);
    svgElement.appendChild(svgGroup);
    this.parent.appendChild(svgElement);
}

RealObjectPieSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment.show;
}


// let this.intCircleRadius = 8;
// let this.minHeight;
// let projectionArray = [];

function SimpleLineChart(argparent, argprops) {
    this.index = argprops.index;
    this.name = "SimpleLineChart";
    this.ChartFonts = new window["ChartFonts"]();
    this.intStartX = 0;
    this.intLastX = 0;
    this.intCircleRadius = 8;
    this.minHeight;
    this.projectionArray = [];
    this.maskPathId = "";
    this.maskRectId = "";
    this.maskprojection = "projectionmaskrect";
    this.baseMaskRect = "";
    this.customColorIndex = 1;
    BaseColumnChart.call(this, argparent, argprops);
}
SimpleLineChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleLineChart.prototype.constructor = SimpleLineChart;

SimpleLineChart.prototype.seriesInstance = function (argparent, argprops) {
    return new window["SimpleLineSeries"](argparent, argprops);
};

SimpleLineChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddAxisTitle();
            this.doAddGridValues();
            this.doAddGraphicDesk();
            if (this.data._designerUI) {
                this.doAddGridValues();
            }
            this.doAddGridDesk();
            this.doAddBaseLineDesk();
            if (this.data.highlightDifference.display) {
                this.CreateHightlightDifference();
            }
            if (this.data.indualHighlight) this.createIndualHighlight();
            this.doAddMetaData();
        }
    }
};

SimpleLineChart.prototype.doAddGraphicElement = function (argparent) {
    let padding = 10;
    let moveX = this.rectSeries.y;
    this.maskprojection = Math.random() + "projectionmaskrect";
    let element = document.createElement("div");
    element.style.width = "100%";
    element.style.height = "100%";
    element.style.display = "flex";
    element.style.flexDirection = "column";
    element.style.position = "relative";
    argparent.appendChild(element);

    let serieselement = document.createElement("div");
    serieselement.style.width = "100%";
    serieselement.style.height = "100%";
    serieselement.style.display = "flex";
    serieselement.style.position = "absolute";
    element.appendChild(serieselement);

    // this.rectSeries.y += 40;
    // this.rectSeries.height -= 40;
    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1 };
        let series = this.seriesInstance(serieselement, eProps);
        series.ChartHelper = this.ChartHelper;
        series.ChartUtils = this.ChartUtils;
        series.move(moveX, this.rectSeries.y);
        series.size(this.rectSeries.width, this.rectSeries.height);
        series.data = this.data;
        this.items[i1] = series;
        moveX += this.rectSeries.width;
    }

    let labelElement = element.getElementsByClassName("label")[0];

    let containerHeight = element && element.querySelector("#seriesitemcond-1") ? element.querySelector("#seriesitemcond-1").clientHeight : 0;
    if (containerHeight == 0) {
        containerHeight = element && element.querySelector("#seriesitemcond-0") ? element.querySelector("#seriesitemcond-0").clientHeight : 0;
    }
    this.minHeight = labelElement ? labelElement.clientHeight : 0;
    this.minHeight += this.data._customProperties.showXAxisTitle ? 40 : 0;
    let subelement = document.createElement("div");
    subelement.style.width = "100%";
    subelement.style.height = this.state.height - this.minHeight + "px";
    subelement.style.display = "flex";
    subelement.style.position = "absolute";
    element.appendChild(subelement);
    if (this.data.chartFlip) {
        subelement.style.height = 15 + this.state.height - this.minHeight + "px";
    }
    serieselement.remove();
    element.appendChild(serieselement);
    this.fullLine = this.data.layout.linechartfull == "true" ? true : false;
    this.createPathSVG(subelement, containerHeight, element);
    this.createProjectionSVG(subelement);
    this.checkBottomSeriesItemPositions(argparent);
};
SimpleLineChart.prototype.checkBottomSeriesItemPositions = function (argparent) {
    let bottomSeries = argparent.querySelectorAll(".bottomseriesitem");
    for (i1 = 0; i1 < bottomSeries.length; i1++) {
        if (bottomSeries[i1]) bottomSeries[i1].style.position = "relative";
    }
};
SimpleLineChart.prototype.createPathSVG = function (argparent, containerHeight, element) {
    let boolSameValue = this.data.minValue == this.data.positiveMaxValue;
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = this.style.lineThickness;
    this.parentWidth = argparent.clientWidth;
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.bgFill = this.style.bgFill;
    this.gradient = this.style.bgFillType == "gradient";
    this.areaGradient = this.data.layout.areaColor == "gradient";
    this.lineGradient = this.data.layout.lineColor == "gradient";
    this.pointshape = this.data.layout.linechartshape;
    this.dashedarray = this.style.dashed;
    if (this.data.layout.linestyle == "dashed") {
        this.dashedarray = "15,15";
    }
    this.randomkey = Math.random();
    this.state.height -= 40;
    let sereiesX = 17;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "series-common",
        class: "commonitem",
        x: this.data.SVGUtils.createPercentValue(this.state.width, sereiesX),
        y: this.data.SVGUtils.createPercentValue(this.state.height, this.rectSeries.y),
        width: this.data.SVGUtils.createPercentValue(this.state.width, this.state.width),
        height: this.data.SVGUtils.createPercentValue(this.state.height, this.state.height),
        "data-width": this.state.width,
        "data-height": this.state.height,
    });
    argparent.appendChild(svgElement);
    if (this.data.indualHighlight && !this.data.chartFlip) {
        argparent.style.top = "30px";
    }
    if (this.data.layout.itemCoinChart) {
        argparent.parentNode.classList.add("coinlineparent");
        argparent.classList.add("coinline");
    }
    ///
    let seriesItemLength = this.voData.seriesItemLength;
    let intPreviousX = 0;
    let intPreviousY = 0;
    let intPreviousProjectionX = 0;
    let intPreviousProjectionWidth = 0;

    for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
        this.customColorIndex = this.ChartFonts.customColor(seriesItemIndex);
        let svgSeiesItem = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgSeiesItem, {
            id: "svgseriesitem-" + seriesItemIndex,
            class: "svgseriesitem accent" + this.customColorIndex + " clsMultiColorParent " + this.data.layout.lineareaGlopalStyle,
            //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
        });
        if (this.data.hasProjection) {
            this.data.SVGUtils.assignAttributes(svgSeiesItem, {
                class: "svgseriesitem accent" + this.customColorIndex + " clsMultiColorParent projectiondisablestyle " + this.data.layout.lineareaGlopalStyle,
                //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
            });
        }
        svgSeiesItem.style.setProperty("--customItemColor", "var(--item" + this.customColorIndex + "-color-rgb)");
        svgSeiesItem.style.setProperty("--customContrastColor", "var(--contrast" + this.customColorIndex + "-rgb)");

        let strPath = "";
        let strAreaPath = "";
        let intX = "";
        let intY = "";
        let intStartYPoint = "";
        let intstartPoint = "";
        let strLinePathTo = "";
        let strPathTo = "";
        let svgAreaPath;
        let AreaBaseSvg = "";
        if (this.bgFill) {
            AreaBaseSvg = this.data.SVGUtils.createSVGElement("svg");
            svgSeiesItem.appendChild(AreaBaseSvg);
            svgAreaPath = this.data.SVGUtils.createSVGElement("path");
            AreaBaseSvg.appendChild(svgAreaPath);
        }
        let svgPath = this.data.SVGUtils.createSVGElement("path");
        if (this.dropshadow) {
            this.createDropShadow(svgElement);
            if (this.bgFill) {
                this.data.SVGUtils.assignAttributes(svgPath, {
                    filter: "url(#dropshadow)",
                });
            }
        }
        if (this.bgFill) {
            AreaBaseSvg.appendChild(svgPath);
        } else {
            if (this.dropshadow) {
                let dropsadowSvg = this.data.SVGUtils.createSVGElement("svg");
                this.data.SVGUtils.assignAttributes(dropsadowSvg, {
                    filter: "url(#dropshadow)",
                });
                let dropsadowRect = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(dropsadowRect, {
                    width: this.state.width,
                    height: this.state.height,
                    fill: "transparent",
                });
                dropsadowSvg.appendChild(dropsadowRect);
                svgSeiesItem.appendChild(dropsadowSvg);
                dropsadowSvg.appendChild(svgPath);
            } else {
                svgSeiesItem.appendChild(svgPath);
            }
        }
        let container;
        let seriesContainer;
        let seriesItemContainer;

        let arrProjection = [];
        this.projectionArray = [];
        let rectWidth = "";
        let point1 = { x: 0, y: 0 };
        let arrPoints = [];
        let areaFirstPoint = { x: 0, y: 0 };
        if (this.chart == "spline") {
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                // let strLine = "";
                let svgLinePath = this.data.SVGUtils.createSVGElement("path");
                // this.intCircleRadius = this.data.hasEmphasis && this.data.emphasis[seriesIndex] == true ? 2 * 5 : 5;
                // let svgItems = this.items[seriesIndex];
                let intQX1;
                let intQX2;
                let intQY1;
                let intQY2;
                let intCY;
                let intCX;
                let intBeginY;
                let numMultiplyFactor = (containerHeight - (this.minHeight + this.intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (this.minHeight + height + this.intCircleRadius)) + this.intCircleRadius;
                itemY -= numValue > 0 ? 0 : this.minHeight + this.intCircleRadius;
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0 || (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0)) {
                    graphicContainer = seriesContainer[1].querySelector(".chartelementgraphic");
                    if (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0) {
                        graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                        itemY = seriesContainer[0].querySelector(".value").parentNode.parentNode.offsetTop;
                    } else {
                        itemY = seriesContainer[1].offsetTop + seriesContainer[1].querySelector(".value").offsetTop;
                    }
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + graphicContainer.parentNode.offsetTop;
                    }
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                    itemY = seriesContainer[0].querySelector(".value").offsetTop + seriesContainer[0].querySelector(".value").offsetHeight;
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + seriesContainer[0].offsetTop + graphicContainer.clientHeight;
                    }
                }
                if (this.data.highlightDifference.display && !this.data.chartFlip) {
                    itemY = itemY + 30;
                }
                intX = sereiesX + this.rectSeries.width / 2 - this.intCircleRadius * 2;
                intY = itemY;
                intY = intY > containerHeight && !this.data.chartFlip ? containerHeight - this.intCircleRadius : intY;
                intStartYPoint = itemY + graphicContainer.clientHeight;
                if (this.data.chartFlip) {
                    intStartYPoint = itemY - graphicContainer.clientHeight;
                }
                if (seriesIndex == 0) {
                    if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                        height = seriesContainer[1].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY - height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY + height;
                        }
                    } else {
                        height = seriesContainer[0].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY + height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY - height;
                        }
                    }
                    if (this.bgFill) this.intStartX = intX;
                    intStartYPoint = intStartYPoint + 0.001;
                    intY = intY + 0.001;
                    strAreaPath += this.bgFill ? "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " " : "M" + intX + "," + intY;
                    if (this.fullLine && this.bgFill) {
                        strPath += "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " ";
                    } else {
                        strPath += "M" + intX + "," + intY;
                    }
                    intPreviousX = intX;
                    intPreviousY = intY;
                    intBeginY = intPreviousY;
                    areaFirstPoint = { x: intX, y: intStartYPoint };
                }
                intCY = intY;
                intCX = intX;
                if (seriesIndex != 0) {
                    intQX1 = parseFloat(intPreviousX + (intX - intPreviousX) / 4);
                    intQY1 = intPreviousY > intY ? parseFloat(intPreviousY + 5) : parseFloat(intPreviousY - 5);
                    if (seriesIndex == 1) {
                        intQX1 = intPreviousX;
                        intQX2 = intPreviousY < intY ? intX : parseFloat(intX - (intX - intPreviousX) / 3);
                        intQY1 = intPreviousY > intY ? parseFloat(intPreviousY + 5) : parseFloat(intPreviousY - 5);
                        intQY2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intY + 20 : intY - 5;
                        intQX2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intQX2 - 20 : intQX2;
                        intQY1 = intPreviousY == intY ? parseInt(intPreviousY) : intQY1;
                        intQY2 = intPreviousY == intY ? parseInt(intPreviousY) : intQY2;
                        intQY1 = intQY1 > argparent.clientHeight ? argparent.clientHeight : intQY1;
                        intQY2 = intQY2 > argparent.clientHeight ? argparent.clientHeight : intQY2;

                        if (intPreviousY < intY && intY - intPreviousY < this.rectSeries.height * 0.6) {
                            intQY2 = intPreviousY < intY && intY - intPreviousY > this.rectSeries.height * 0.6 ? intY + 20 : intY;
                            strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5);
                            strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5) : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + (intY - 5);
                            intCY = intY - 5;
                        } else {
                            strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                            strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                        }
                    } else {
                        intQX1 = parseFloat(intPreviousX + (intX - intPreviousX) / 3);
                        intQX2 = seriesIndex == this.seriesLength - 1 ? parseFloat(intX) : parseFloat(intX - (intX - intPreviousX) / 3);
                        intQY1 = intPreviousY;
                        intQY2 = intY;
                        intQY1 = intPreviousY == intY ? parseInt(intPreviousY) : intQY1;
                        intQY2 = intPreviousY == intY ? parseInt(intPreviousY) : intQY2;
                        intQY2 = intPreviousY - intBeginY > this.rectSeries.height * 0.6 ? parseInt(intQY2 + 50) : intQY2;

                        intQY1 = intQY1 > argparent.clientHeight ? argparent.clientHeight : intQY1;
                        intQY2 = intQY2 > argparent.clientHeight ? argparent.clientHeight : intQY2;

                        strPath += " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                        strAreaPath += this.bgFill ? "C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY : "M" + intPreviousX + "," + intPreviousY + " C" + intQX1 + "," + intQY1 + " " + intQX2 + " " + intQY2 + " " + intX + " " + intY;
                    }
                    intPreviousX = intX;
                    intPreviousY = intY;
                }
                arrPoints.push({ x: intX, y: intY });
                if (seriesIndex != 0) {
                    if (this.bgFill) {
                        strPath = this.makePath(arrPoints, null, argparent);
                        strAreaPath = this.makePath(arrPoints, areaFirstPoint, argparent);
                    } else {
                        strPath = this.makePath(arrPoints, null, argparent);
                        strAreaPath = this.makePath(arrPoints, null, argparent);
                    }
                }
                // point1 = seriesIndex == this.voData.seriesLength - 2 ? { x: shapeX, y: shapeY } : point1;
                // let point2 = { x: shapeX, y: shapeY };
                if (seriesIndex == this.voData.seriesLength - 1 && this.data.layout.lineHead) {
                    if (this.data.layout.lineHead) {
                        let arrowPoints = this.doMeasurementArrow(arrPoints, seriesItemIndex);
                        strPath += "L" + arrowPoints.x + "," + arrowPoints.y;
                    }
                    // let angle = this.getAngle(point1, point2);
                    let arrowHead = document.createElement("div");
                    let arrowHeadParent = document.createElement("div");
                    arrowHeadParent.className = "arrowheadParent accent" + this.customColorIndex + " clsMultiColorParent";
                    arrowHeadParent.style.setProperty("--customItemColor", "var(--item" + this.customColorIndex + "-color-rgb)");
                    arrowHeadParent.style.setProperty("--customContrastColor", "var(--contrast" + this.customColorIndex + "-rgb)");
                    // arrowHeadGroup.style.transform = "translate("+shapeX+"px, "+(shapeY-13)+"px) rotate("+angle+"deg)"
                    if (arrowHead) {
                        arrowHeadParent.appendChild(arrowHead);
                        argparent.appendChild(arrowHeadParent);
                        arrowHeadParent.style.offsetPath = "path('" + strPath + "')";
                        arrowHeadParent.style.offsetDistance = "100%";
                        arrowHeadParent.classList.add("moodanimation");
                        arrowHead.classList.add("clsNodeAccentbg");
                        arrowHead.classList.add("arrowhead");
                        arrowHeadParent.dataset.animation = "arrowhead";
                    }
                    // arrowHeadParent.appendChild(arrowHeadGroup);
                    // svgSeiesItem.appendChild(arrowHeadParent)
                }
                let dummeyPath = this.data.SVGUtils.createSVGElement("path");
                this.data.SVGUtils.assignAttributes(dummeyPath, {
                    visblity: "hidden",
                    d: strPath,
                });
                let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyPath);
                this.ChartUtils.addDummySvg(emptySvgNode, this.data.slideObj);
                let pathLength;
                let linePathLength = "";
                pathLength = dummeyPath.getTotalLength();
                if (this.bgFill) linePathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.data.slideObj);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
                // this.linethickness = 6;
                let clsstyle = this.gradient && !this.bgFill ? this.ChartFonts.graphicFillColor(seriesIndex) : this.ChartFonts.graphicFillColor(0);
                if (this.data.layout.lineShapeStroke) {
                    clsstyle = this.ChartFonts.graphicFillColor(0) + " " + this.ChartFonts.graphicStrokeColor(0) + " strokestyle";
                }

                let svgCircle = "";
                let dummeyShape = "";
                let ShapeWidth = 2 * this.intCircleRadius;
                let ShapeHeight = 2 * this.intCircleRadius;
                let shapeX = intX - this.intCircleRadius;
                let shapeY = intY - this.intCircleRadius;
                if (this.pointshape == "rect") {
                    ShapeWidth = 2 * this.intCircleRadius + 4;
                }
                let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
                emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyLineShape);
                svgElement.appendChild(emptySvgNode);
                dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " clsprojectionenableshapestyle");
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " clsprojectiondisableshapestyle");
                }
                let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
                svgElement.removeChild(emptySvgNode);
                if (this.data.layout.itemShapeWidth) {
                    ShapeWidth = this.data.layout.itemShapeWidth;
                }
                if (this.data.layout.itemShapeHeight) {
                    ShapeHeight = this.data.layout.itemShapeHeight;
                }
                if (getShapeBounds) {
                    ShapeWidth = getShapeBounds.width ? getShapeBounds.width : 0;
                    ShapeHeight = getShapeBounds.height ? getShapeBounds.height : 0;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    shapeY = intY - ShapeHeight / 2;
                    shapeX = intX - ShapeWidth / 2;
                    ShapeWidth = ShapeWidth;
                    ShapeHeight = ShapeHeight;
                }
                if (this.pointshape == "rhombus") {
                    x1 = intX;
                    y1 = intY - ShapeHeight / 2;
                    x2 = intX - ShapeWidth / 2;
                    y2 = intY;
                    x3 = intX;
                    y3 = intY + ShapeHeight / 2;
                    x4 = intX + ShapeHeight / 2;
                    y4 = intY;
                    strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    svgCircle = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(svgCircle, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                        id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                        "data-cxvalues": intCX,
                        "data-animation": "itemcircle",
                        "data-animateitem": "itemcircle" + seriesItemIndex,
                        "data-pathLength": pathLength,
                        "data-linepathlength": linePathLength,
                        visibility: "visible",
                    });
                    dummeyShape = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(dummeyShape, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        visibility: "hidden",
                    });
                    if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                    svgSeiesItem.appendChild(svgCircle);
                } else {
                    if (this.pointshape == "rhombus") {
                        svgCircle = this.data.SVGUtils.createSVGElement("path");

                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            d: strShapePath,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-seriesitemindex": seriesItemIndex.toString(),
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "rhombus" ? "visible" : "hidden",
                        });
                        svgSeiesItem.appendChild(svgCircle);
                    } else {
                        svgCircle = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            cx: intX,
                            cy: intY,
                            r: ShapeWidth / 2,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intCX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "circle" ? "visible" : "hidden",
                        });
                        dummeyShape = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(dummeyShape, {
                            cx: intX,
                            cy: intY,
                            r: ShapeWidth / 2,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: "hidden",
                        });
                        if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                        svgSeiesItem.appendChild(svgCircle);
                    }
                }
                // if(this.data.layout.lineShapeStroke){
                //     svgCircle.classList.add("strokestyle");
                // }
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPoint && this.data.lineHighlightStyle[seriesIndex] == "true") {
                    svgCircle.setAttribute("visibility", "hidden");
                    let highlightShape = this.createHighlightShape(intX, intY, ShapeWidth, seriesIndex, pathLength);
                    highlightShape.dataset.animation = "linehighlightcircle";
                    highlightShape.dataset.animationitem = "highlightcircle-" + seriesIndex + "_" + seriesItemIndex;
                    svgSeiesItem.appendChild(highlightShape);
                    let valueElement = seriesContainer[0].querySelector(".value");
                    if (!valueElement && seriesContainer[1]) {
                        valueElement = seriesContainer[1].querySelector(".value");
                    }
                    if (valueElement) {
                        let ElementHeight = valueElement.clientHeight;
                        let valueTop = intY - ElementHeight / 2;
                        if (this.data.layout.valuePaddingClass) {
                            valueElement.classList.remove(this.data.layout.valuePaddingClass);
                        }
                        if (this.data.layout.valueAlterPaddingClass) {
                            valueElement.classList.remove(this.data.layout.valueAlterPaddingClass);
                        }
                        valueElement.children[0].dataset.hashighlight = "true";
                        // valueElement.style.top = valueTop+"px";
                        valueElement.children[0].classList.remove("linehighlightfontstyle1");
                        valueElement.classList.remove("linehighlightcustomsize");
                        valueElement.children[0].classList.add("linehighlightfontstyle1");
                        valueElement.classList.add("linehighlightcustomsize");
                        valueElement.children[0].classList.remove("clsValueTextColor");
                        valueElement.children[0].classList.remove("clsInnerTextColor");
                        valueElement.children[0].classList.add("clsInnerTextColor");
                    }
                    let topValue = valueElement && window.getComputedStyle(valueElement) && window.getComputedStyle(valueElement)["top"] ? parseFloat(window.getComputedStyle(valueElement)["top"]) : "";
                    if (topValue && !isNaN(topValue) && this.data.chartFlip && !valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                    if (topValue && !isNaN(topValue) && !this.data.chartFlip && valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    // svgCircle.classList.remove(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                    svgCircle.classList.remove("bgfill");
                    svgCircle.classList.remove("clsTertiaryFill");
                    svgCircle.classList.add("clsprojectionenableshapestyle");
                    if (dummeyShape) {
                        dummeyShape.classList.add("clsprojectionenableshapestyle");
                    }
                } else if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    svgCircle.classList.add("clsprojectiondisableshapestyle");
                    if (dummeyShape) {
                        dummeyShape.classList.add("clsprojectiondisableshapestyle");
                    }
                }
                this.itemShapebgProperties(svgCircle, seriesItemIndex, seriesItemIndex, dummeyShape);
                // if(seriesItemIndex>0){
                //     svgCircle.style.setProperty("fill","rgba(var(--node-theme-color),1)","important")
                // }
                if (this.data.hasProjection && rectWidth == "" && this.data.projection[seriesIndex] == true) {
                    rectWidth = this.data.hasProjection && this.data.projection[seriesIndex] == true ? intX : "";
                    arrProjection.push({
                        x: 0,
                        width: rectWidth,
                    });
                    this.projectionArray.push({
                        x: intX,
                        width: this.parentWidth - rectWidth,
                    });
                } else {
                    if (this.data.hasProjection && arrProjection.length != 0 && this.data.projection[seriesIndex - 1] == true && this.data.projection[seriesIndex] == false) {
                        intPreviousProjectionX = intX;
                        intPreviousProjectionWidth = this.width - intX;
                        // arrProjection.push({ x: intPreviousProjectionX, width: intPreviousProjectionWidth });
                        if (this.projectionArray.length >= 1) {
                            this.projectionArray[this.projectionArray.length - 1].width = intPreviousProjectionX - this.projectionArray[this.projectionArray.length - 1].x;
                        }
                    } else {
                        if (this.data.hasProjection && this.data.projection[seriesIndex] == true && this.data.projection[seriesIndex - 1] == false) {
                            intPreviousProjectionWidth = intX;
                            if (arrProjection.length > 1) arrProjection[arrProjection.length - 1].width = intPreviousProjectionWidth - arrProjection[arrProjection.length - 1].x;
                            this.projectionArray.push({
                                x: intX,
                                width: this.parentWidth - intX,
                            });
                        }
                    }
                }

                this.data.SVGUtils.assignAttributes(svgLinePath, {
                    d: strAreaPath,
                    class: this.ChartFonts.graphicStrokeColor(seriesItemIndex) + " " + this.data.layout.areaShadow,
                    "fill-opacity": 0,
                    "stroke-opacity": 0,
                    "stroke-width": this.linethickness + "px",
                    id: "itemlines-" + seriesIndex + "_" + seriesItemIndex,
                });
                // svgSeiesItem.appendChild(svgLinePath);
                sereiesX += this.rectSeries.width;
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPointStyle1) {
                    let objBounds = this.getChartHighLightValue(this.parent.parentNode, seriesIndex);
                    let targetBounds = objBounds.targetBounds;
                    let highlightData = {
                        title: this.data.lineHighlightText[seriesIndex] ? this.data.lineHighlightText[seriesIndex] : "Enter highlight text",
                        content: {
                            type: "",
                            value: {},
                        },
                        position: { primary: "vertical", secondary: "center" },
                    };
                    let hightlight = "";
                    if (this.data.moodData.calloutstyle) {
                        try {
                            hightlight = new window[this.data.moodData.calloutstyle](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        } catch (error) {
                            hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        }
                    } else {
                        hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                    }
                    if (hightlight) {
                        hightlight.style.pointerEvents = "none";
                        let textNode = hightlight.querySelector("#callout-title");
                        if (textNode) {
                            textNode.setAttribute("contenteditable", "true");
                            textNode.setAttribute("data-dck-selector", "true");
                            textNode.setAttribute("data-prompt-text", "Enter highlight text");
                            this.ChartHelper.setTextChangeListner(textNode);
                            textNode.setAttribute("data-type", "highlightlabel");
                            textNode.setAttribute("index", seriesIndex);
                            textNode.setAttribute("id", "lineheightlighttext" + seriesIndex);
                            textNode.classList.add("linehighlightlabel");
                            textNode.style.pointerEvents = "all";
                            if (!this.data.lineHighlightText[seriesIndex]) {
                                textNode.innerText = "";
                            }
                        }
                        hightlight.setAttribute("data-animation", "linehighlightshape");
                        hightlight.classList.add("moodanimation");
                    }
                }
            }
            sereiesX = 17;
        } else {
            for (let seriesIndex = 0; seriesIndex < this.voData.seriesLength; seriesIndex++) {
                container = element.querySelector("#seriesitemcond-" + seriesIndex);
                seriesItemContainer = container.querySelector("#baseseriesitem-" + seriesItemIndex);
                seriesContainer = seriesItemContainer.querySelectorAll(".seriesitem");
                let numMultiplyFactor = (containerHeight - (this.minHeight + this.intCircleRadius)) / this.voData.rangeTotal;
                let numValue = this.voData.values[seriesIndex][seriesItemIndex];
                let height = parseInt(numValue * numMultiplyFactor);
                let negHeight = this.voData.rangeNegative == 0 ? 0 : parseInt(this.voData.rangeNegative * numMultiplyFactor);
                let itemY = this.rectSeries.y + negHeight + (containerHeight - (this.minHeight + height + this.intCircleRadius)) + this.intCircleRadius;
                itemY -= numValue > 0 ? 0 : this.minHeight + this.intCircleRadius;

                let graphicContainer;
                if (this.voData.values[seriesIndex][seriesItemIndex] < 0 || (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0)) {
                    graphicContainer = seriesContainer[1].querySelector(".chartelementgraphic");
                    if (this.data.layout.valueVPosition == "bottom" && this.voData.values[seriesIndex][seriesItemIndex] > 0) {
                        graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                        itemY = seriesContainer[0].querySelector(".value").parentNode.parentNode.offsetTop;
                    } else {
                        itemY = seriesContainer[1].offsetTop + seriesContainer[1].querySelector(".value").offsetTop;
                    }
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + graphicContainer.parentNode.offsetTop;
                    }
                } else {
                    graphicContainer = seriesContainer[0].querySelector(".chartelementgraphic");
                    itemY = seriesContainer[0].querySelector(".value").offsetTop + seriesContainer[0].querySelector(".value").offsetHeight;
                    if (this.data.chartFlip) {
                        itemY = container.offsetTop + seriesContainer[0].offsetTop + graphicContainer.clientHeight;
                    }
                }
                if (this.data.highlightDifference.display && !this.data.chartFlip) {
                    itemY = itemY + 30;
                }
                intX = sereiesX + this.rectSeries.width / 2 - this.intCircleRadius * 2;
                intY = itemY;
                intY = intY > containerHeight && !this.data.chartFlip ? containerHeight - this.intCircleRadius : intY;

                if (seriesIndex == 0) {
                    if (this.voData.values[seriesIndex][seriesItemIndex] < 0) {
                        height = seriesContainer[1].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY - height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY + height;
                        }
                    } else {
                        height = seriesContainer[0].querySelector(".chartelementgraphic").clientHeight;
                        intStartYPoint = itemY + height;
                        if (this.data.chartFlip) {
                            intStartYPoint = itemY - height;
                        }
                    }
                    intStartYPoint = intStartYPoint + 0.001;
                    intY = intY + 0.001;
                    if (this.bgFill) this.intStartX = intX;
                    if (this.bgFill) strAreaPath = "M" + intX + "," + intStartYPoint + "L" + intX + "," + intY;
                    if (this.fullLine && this.bgFill) {
                        strPath += "M" + intX + "," + intStartYPoint + " L" + intX + "," + intY + " ";
                    } else {
                        strPath += "M" + intX + "," + intY;
                    }
                } else {
                    // if (seriesIndex == this.voData.seriesLength - 1 && this.data.layout.lineHead) {
                    //     intX += 20;
                    // }
                    strPath += "L" + intX + "," + intY;
                    if (this.bgFill) strAreaPath += "L" + intX + "," + intY;
                }
                arrPoints.push({ x: intX, y: intY });
                let dummeyPath = this.data.SVGUtils.createSVGElement("path");
                this.data.SVGUtils.assignAttributes(dummeyPath, {
                    visblity: "hidden",
                    d: strPath,
                });
                let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyPath);
                this.ChartUtils.addDummySvg(emptySvgNode, this.data.slideObj);
                let pathLength;
                let linePathLength = "";
                pathLength = dummeyPath.getTotalLength();
                if (this.bgFill) linePathLength = dummeyPath.getTotalLength();
                this.ChartUtils.removeDummySvg(this.data.slideObj);
                if (this.bgFill) pathLength = seriesIndex * parseInt(100 / (this.voData.seriesLength - 1));
                // this.linethickness = 6;
                // this.gradient = true;
                let clsstyle = this.gradient && !this.bgFill ? this.ChartFonts.graphicFillColor(seriesItemIndex) : this.ChartFonts.graphicFillColor(0);
                // if (this.data.layout.lineShapeStroke) {
                //     clsstyle = this.ChartFonts.graphicFillColor(0) + " " + this.ChartFonts.graphicStrokeColor(0)+" strokestyle"
                // }
                let svgCircle;
                let dummeyShape;
                let ShapeWidth = 2 * this.intCircleRadius;
                let ShapeHeight = 2 * this.intCircleRadius;
                let shapeX = intX - this.intCircleRadius;
                let shapeY = intY - this.intCircleRadius;
                let x1, y1, x2, y2, x3, y3, x4, y4;
                let strShapePath = "";
                if (this.pointshape == "rect") {
                    ShapeWidth = 2 * this.intCircleRadius + 4;
                }
                let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
                emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
                emptySvgNode.appendChild(dummeyLineShape);
                svgElement.appendChild(emptySvgNode);
                dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle);
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " clsprojectionenableshapestyle");
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    dummeyLineShape.setAttribute("class", this.data.layout.itemShapeDrawStyle + " clsprojectiondisableshapestyle");
                }
                let getShapeBounds = this.getLineShapeBounds(dummeyLineShape);
                svgElement.removeChild(emptySvgNode);
                if (this.data.layout.itemShapeWidth) {
                    ShapeWidth = this.data.layout.itemShapeWidth;
                }
                if (this.data.layout.itemShapeHeight) {
                    ShapeHeight = this.data.layout.itemShapeHeight;
                }
                if (getShapeBounds) {
                    ShapeWidth = getShapeBounds.width ? getShapeBounds.width : ShapeWidth;
                    ShapeHeight = getShapeBounds.height ? getShapeBounds.height : ShapeHeight;
                }
                if (this.pointshape == "rect" || this.pointshape == "square") {
                    shapeY = intY - ShapeHeight / 2;
                    shapeX = intX - ShapeWidth / 2;
                    ShapeWidth = ShapeWidth;
                    ShapeHeight = ShapeHeight;
                }
                if (this.pointshape == "rhombus") {
                    x1 = intX;
                    y1 = intY - ShapeHeight / 2;
                    x2 = intX - ShapeWidth / 2;
                    y2 = intY;
                    x3 = intX;
                    y3 = intY + ShapeHeight / 2;
                    x4 = intX + ShapeHeight / 2;
                    y4 = intY;
                    strShapePath = "M" + x1 + "," + y1 + "L" + x2 + "," + y2 + "L" + x3 + "," + y3 + "L" + x4 + "," + y4 + "L" + x1 + "," + y1;
                }

                if (this.pointshape == "rect" || this.pointshape == "square") {
                    svgCircle = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(svgCircle, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                        id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                        "data-cxvalues": intX,
                        "data-animation": "itemcircle",
                        "data-animateitem": "itemcircle" + seriesItemIndex,
                        "data-pathLength": pathLength,
                        "data-linepathlength": linePathLength,
                        visibility: "visible",
                    });

                    dummeyShape = this.data.SVGUtils.createSVGElement("rect");
                    this.data.SVGUtils.assignAttributes(dummeyShape, {
                        x: shapeX,
                        y: shapeY,
                        width: ShapeWidth,
                        height: ShapeHeight,
                        visibility: "hidden",
                    });
                    if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                    svgSeiesItem.appendChild(svgCircle);
                } else {
                    if (this.pointshape == "rhombus") {
                        svgCircle = this.data.SVGUtils.createSVGElement("path");

                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            d: strShapePath,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "rhombus" ? "visible" : "hidden",
                        });
                        svgSeiesItem.appendChild(svgCircle);
                    } else {
                        svgCircle = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(svgCircle, {
                            cx: intX,
                            cy: intY,
                            r: ShapeWidth / 2,
                            class: "item-circle moodanimation " + " " + this.data.layout.itemShapeDrawStyle,
                            id: "circle-" + seriesIndex + "_" + seriesItemIndex,
                            "data-cxvalues": intX,
                            "data-animation": "itemcircle",
                            "data-animateitem": "itemcircle" + seriesItemIndex,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            visibility: this.pointshape == "circle" ? "visible" : "hidden",
                        });
                        dummeyShape = this.data.SVGUtils.createSVGElement("circle");
                        this.data.SVGUtils.assignAttributes(dummeyShape, {
                            cx: intX,
                            cy: intY,
                            "data-pathLength": pathLength,
                            "data-linepathlength": linePathLength,
                            r: ShapeWidth / 2,
                            visibility: "hidden",
                        });
                        if (this.data.layout.linechartShapebgOpacity) svgSeiesItem.appendChild(dummeyShape);
                        svgSeiesItem.appendChild(svgCircle);
                    }
                }
                this.itemShapebgProperties(svgCircle, seriesItemIndex, seriesIndex, dummeyShape);
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPoint && this.data.lineHighlightStyle[seriesIndex] == "true") {
                    svgCircle.setAttribute("visibility", "hidden");
                    let highlightShape = this.createHighlightShape(intX, intY, ShapeWidth, seriesIndex, pathLength);
                    highlightShape.dataset.animation = "linehighlightcircle";
                    highlightShape.dataset.animationitem = "highlightcircle-" + seriesIndex + "_" + seriesItemIndex;
                    svgSeiesItem.appendChild(highlightShape);
                    let valueElement = seriesContainer[0].querySelector(".value");
                    if (!valueElement && seriesContainer[1]) {
                        valueElement = seriesContainer[1].querySelector(".value");
                    }
                    if (valueElement) {
                        // valueElement.style.position="absolute";
                        let ElementHeight = valueElement.clientHeight;
                        let valueTop = intY - ElementHeight / 2;
                        if (this.data.layout.valuePaddingClass) {
                            valueElement.classList.remove(this.data.layout.valuePaddingClass);
                        }
                        if (this.data.layout.valueAlterPaddingClass) {
                            valueElement.classList.remove(this.data.layout.valueAlterPaddingClass);
                        }
                        valueElement.children[0].dataset.hashighlight = "true";
                        valueElement.children[0].classList.remove("linehighlightfontstyle1");
                        valueElement.classList.remove("linehighlightcustomsize");
                        valueElement.children[0].classList.add("linehighlightfontstyle1");
                        valueElement.classList.add("linehighlightcustomsize");
                        valueElement.children[0].classList.remove("clsValueTextColor");

                        valueElement.children[0].classList.remove("clsInnerTextColor");
                        valueElement.children[0].classList.add("clsInnerTextColor");

                        valueElement.children[0].style.visibility = "visible";
                        valueElement.style.visibility = "visible";
                        // valueElement.style.top = valueTop+"px"
                    }
                    let topValue = valueElement && window.getComputedStyle(valueElement) && window.getComputedStyle(valueElement)["top"] ? parseFloat(window.getComputedStyle(valueElement)["top"]) : "";
                    if (topValue && !isNaN(topValue) && this.data.chartFlip && !valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                    if (topValue && !isNaN(topValue) && !this.data.chartFlip && valueElement.getAttribute("id").includes("bottomvalue")) {
                        valueElement.style.setProperty("top", -topValue + "px", "important");
                    }
                }
                if (this.data.hasProjection && this.data.projection[seriesIndex] == true) {
                    // svgCircle.classList.remove(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                    svgCircle.classList.remove("bgfill");
                    svgCircle.classList.remove("clsTertiaryFill");
                    svgCircle.classList.add("clsprojectionenableshapestyle");
                    if (dummeyShape) {
                        dummeyShape.classList.add("clsprojectionenableshapestyle");
                    }
                } else if (this.data.hasProjection && this.data.projection[seriesIndex] == false) {
                    svgCircle.classList.add("clsprojectiondisableshapestyle");
                    if (dummeyShape) {
                        dummeyShape.classList.add("clsprojectiondisableshapestyle");
                    }
                }
                if (this.data.hasProjection && rectWidth == "" && this.data.projection[seriesIndex] == true) {
                    rectWidth = this.data.hasProjection && this.data.projection[seriesIndex] == true ? intX : "";
                    arrProjection.push({
                        x: 0,
                        width: rectWidth,
                    });
                    this.projectionArray.push({
                        x: intX,
                        width: this.parentWidth - rectWidth,
                    });
                } else {
                    if (this.data.hasProjection && arrProjection.length != 0 && this.data.projection[seriesIndex - 1] == true && this.data.projection[seriesIndex] == false) {
                        intPreviousProjectionX = intX;
                        intPreviousProjectionWidth = this.width - intX;
                        // arrProjection.push({ x: intPreviousProjectionX, width: intPreviousProjectionWidth });
                        if (this.projectionArray.length >= 1) {
                            this.projectionArray[this.projectionArray.length - 1].width = intPreviousProjectionX - this.projectionArray[this.projectionArray.length - 1].x;
                        }
                    } else {
                        if (this.data.hasProjection && this.data.projection[seriesIndex] == true && this.data.projection[seriesIndex - 1] == false) {
                            intPreviousProjectionWidth = intX;
                            if (arrProjection.length > 1) arrProjection[arrProjection.length - 1].width = intPreviousProjectionWidth - arrProjection[arrProjection.length - 1].x;
                            this.projectionArray.push({
                                x: intX,
                                width: this.parentWidth - intX,
                            });
                        }
                    }
                }
                // if(seriesItemIndex>0){
                //     svgCircle.style.setProperty("fill","rgba(var(--node-theme-color),1)","important")
                // }
                sereiesX += this.rectSeries.width;
                point1 = seriesIndex == this.voData.seriesLength - 2 ? { x: shapeX, y: shapeY } : point1;
                let point2 = { x: shapeX, y: shapeY };
                if (seriesIndex == this.voData.seriesLength - 1 && this.data.layout.lineHead) {
                    if (this.data.layout.lineHead) {
                        let arrowPoints = this.doMeasurementArrow(arrPoints, seriesItemIndex);
                        strPath += "L" + arrowPoints.x + "," + arrowPoints.y;
                    }
                    let angle = this.getAngle(point1, point2);
                    let arrowHead = document.createElement("div");
                    let arrowHeadParent = document.createElement("div");
                    arrowHeadParent.className = "arrowheadParent accent" + this.customColorIndex + " clsMultiColorParent";
                    arrowHeadParent.style.setProperty("--customItemColor", "var(--item" + this.customColorIndex + "-color-rgb)");
                    arrowHeadParent.style.setProperty("--customContrastColor", "var(--contrast" + this.customColorIndex + "-rgb)");
                    // arrowHeadGroup.style.transform = "translate("+shapeX+"px, "+(shapeY-13)+"px) rotate("+angle+"deg)"
                    if (arrowHead) {
                        arrowHeadParent.appendChild(arrowHead);
                        argparent.appendChild(arrowHeadParent);
                        arrowHeadParent.style.offsetPath = "path('" + strPath + "')";
                        arrowHeadParent.style.offsetDistance = "100%";
                        arrowHeadParent.classList.add("moodanimation");
                        arrowHead.classList.add("clsNodeAccentbg");
                        arrowHead.classList.add("arrowhead");
                        arrowHeadParent.dataset.animation = "arrowhead";
                    }
                }
                if (this.data.highlights[seriesIndex] && this.data.lineHighlightPointStyle1) {
                    let objBounds = this.getChartHighLightValue(this.parent.parentNode, seriesIndex);
                    let targetBounds = objBounds.targetBounds;
                    let highlightData = {
                        title: this.data.lineHighlightText[seriesIndex] ? this.data.lineHighlightText[seriesIndex] : "Enter highlight text",
                        content: {
                            type: "",
                            value: {},
                        },
                        position: { primary: "vertical", secondary: "center" },
                    };
                    let hightlight = "";
                    if (this.data.moodData.calloutstyle) {
                        try {
                            hightlight = new window[this.data.moodData.calloutstyle](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        } catch (error) {
                            hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                        }
                    } else {
                        hightlight = new window["HighlightTest"](this.parent.parentNode.firstChild, highlightData, targetBounds);
                    }
                    if (hightlight) {
                        hightlight.style.pointerEvents = "none";
                        let textNode = hightlight.querySelector("#callout-title");
                        if (textNode) {
                            textNode.setAttribute("contenteditable", "true");
                            textNode.setAttribute("data-dck-selector", "true");
                            textNode.setAttribute("data-prompt-text", "Enter highlight text");
                            this.ChartHelper.setTextChangeListner(textNode);
                            textNode.setAttribute("data-type", "highlightlabel");
                            textNode.setAttribute("index", seriesIndex);
                            textNode.setAttribute("id", "lineheightlighttext" + seriesIndex);
                            textNode.classList.add("linehighlightlabel");
                            textNode.style.pointerEvents = "all";
                            if (!this.data.lineHighlightText[seriesIndex]) {
                                textNode.innerText = "";
                            }
                        }
                        hightlight.setAttribute("data-animation", "linehighlightshape");
                        hightlight.classList.add("moodanimation");
                    }
                }
            }

            sereiesX = 17;
        }

        if (this.fullLine) {
            strPath += this.chart == "spline" ? "L" + intX + "," + intStartYPoint + "z" : "L" + intX + "," + intStartYPoint + "z";
        }

        let strokeColor = this.getBgFillDetails(seriesItemIndex, "clsAccentStroke", this.data.layout.itemColor, "stroke");
        this.data.SVGUtils.assignAttributes(svgPath, {
            d: strPath,
            class: "item-path " + strokeColor + " moodanimation " + this.data.layout.lineShadow,
            "data-animation": "itemline",
            "data-linechart": "true",
            "data-seriesitemindex": seriesItemIndex.toString(),
            fill: "transparent",
            "series-itemindex": seriesItemIndex,
            "stroke-opacity": this.data.layout.lineOpacity ? this.data.layout.lineOpacity : 0.5,
            "stroke-width": this.linethickness + "px",
        });
        // if(this.style.bgFillType != "gradient")
        // {
        //     this.data.SVGUtils.assignAttributes(svgPath, {
        //         fill: "transparent"
        //     });
        // }
        if (this.bgFill) {
            strokeColor = this.getBgFillDetails(seriesItemIndex, strokeColor, this.data.layout.itemLineColor, "stroke");
            this.data.SVGUtils.assignAttributes(svgPath, {
                class: "item-path " + strokeColor + " " + this.data.layout.lineShadow,
                "data-seriesitemindex": seriesItemIndex.toString(),
                "data-animation": "",
                "stroke-linecap": "",
            });
        }
        this.intLastX = sereiesX + intX;
        let areaFillColor = this.getBgFillDetails(seriesItemIndex, this.data.ChartFonts.appendgraphicFillColor(seriesItemIndex), this.data.layout.itemColor, "bgcolor");
        if (this.bgFill) {
            if (seriesItemIndex == 0) {
                this.createMaskSVG(svgElement);
            }
            strAreaPath += this.chart == "spline" ? "L" + intX + "," + intStartYPoint : "L" + intX + "," + intStartYPoint;

            this.data.SVGUtils.assignAttributes(svgAreaPath, {
                d: strAreaPath,
                style: "stroke:none;",
                class: "areapath path_to item-lines " + areaFillColor + " " + this.data.layout.areaShadow,
                id: "points_to-" + seriesItemIndex,
                "data-areacolor": areaFillColor,
                "fill-opacity": this.data.layout.areaOpacity && (this.data.layout.areaOpacity < 0.5 || this.data.seriesItemLength == 1) ? this.data.layout.areaOpacity : 0.5,
            });
            this.data.SVGUtils.assignAttributes(AreaBaseSvg, {
                "data-mask": "true",
                mask: "url(#" + this.baseMaskRect + ")",
            });
        }
        let clonepath = "";
        let defsTag = "";
        let maskElement = "";
        if (this.dashedarray) {
            defsTag = this.data.SVGUtils.createSVGElement("defs");
            maskElement = this.data.SVGUtils.createSVGElement("mask");
            this.maskPathId = Math.random() + this.data.slideID + "maskpath" + seriesItemIndex;
            this.data.SVGUtils.assignAttributes(maskElement, {
                "data-maskelement": "true",
                id: this.maskPathId,
                fill: "none",
                stroke: "white",
            });
            defsTag.appendChild(maskElement);
            svgSeiesItem.appendChild(defsTag);
            clonepath = svgPath.cloneNode(true);
            this.data.SVGUtils.assignAttributes(clonepath, {
                class: this.data.layout.lineShadow,
                fill: "none",
                stroke: "white",
                "data-animation": "",
                "stroke-width": this.linethickness + "px",
                "stroke-dasharray": this.dashedarray,
            });
            if (this.dashedarray) {
                this.data.SVGUtils.assignAttributes(maskElement, {
                    class: "dasharrayelement",
                });
            }
            maskElement.appendChild(clonepath);
            this.data.SVGUtils.assignAttributes(svgPath, {
                mask: "url(#" + this.maskPathId + ")",
                "data-mask": "true",
                "data-mask": "true",
            });
        }
        svgElement.appendChild(svgSeiesItem);
        if (this.gradient == true) {
            this.addGradient(svgPath, svgAreaPath, svgElement, this.bgFill, false, seriesItemIndex);
        }
        if (this.data.hasProjection) {
            this.maskRectId = Math.random() + "maskrect";
            this.data.SVGUtils.assignAttributes(svgAreaPath, {
                "data-mask": "",
                mask: "url(#" + this.maskRectId + ")",
            });
            if (this.dashedarray) {
            } else {
                this.data.SVGUtils.assignAttributes(svgPath, {
                    "data-mask": "",
                    mask: "url(#" + this.maskRectId + ")",
                });
            }
        }
        let ProjectionDefsTag = this.data.SVGUtils.createSVGElement("defs");
        let ProjectionMaskTag = this.data.SVGUtils.createSVGElement("mask");
        this.data.SVGUtils.assignAttributes(ProjectionMaskTag, {
            id: this.maskRectId,
            fill: "white",
            class: "projectionRect",
            maskUnits: "userSpaceOnUse",
        });
        if (this.dashedarray) {
        } else {
            ProjectionDefsTag.appendChild(ProjectionMaskTag);
        }
        if (clonepath && this.data.hasProjection) {
            this.data.SVGUtils.assignAttributes(clonepath, {
                mask: "url(#" + this.maskRectId + ")",
            });
        }
        for (let i4 = 0; i4 < arrProjection.length; i4++) {
            if (this.dashedarray && i4 == 0) {
                defsTag.appendChild(ProjectionMaskTag);
            }
            i4 == 0 ? svgSeiesItem.appendChild(ProjectionDefsTag) : "";
            let maskRect = this.data.SVGUtils.createSVGElement("rect");
            this.data.SVGUtils.assignAttributes(maskRect, {
                id: "projectionrectbase",
                x: arrProjection[i4].x,
                y: "0%",
                width: arrProjection[i4].width,
                height: this.state.height,
            });
            ProjectionMaskTag.appendChild(maskRect);
            if (this.dashedarray) {
                maskElement.appendChild(clonepath);
            }
        }
    }
};
SimpleLineChart.prototype.calculateProjectionWidth = function (gridWidth, containerElement) {
    let startingProjectionPoint = this.data.projectionindex;
    let childLength = this.data.seriesLength;
    let indualWidth = gridWidth / childLength;
    let projectionLength = childLength - startingProjectionPoint == 0 ? 1 : childLength - startingProjectionPoint;
    let width = projectionLength * indualWidth - indualWidth / 2;
    let x = startingProjectionPoint * indualWidth + indualWidth / 2;
    return { x: containerElement.offsetLeft + this.rectBaseSeries.x + x, width: width };
};
SimpleLineChart.prototype.createHighlightShape = function (centerX, centerY, width, index, pathLength) {
    let svgCircle = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(svgCircle, {
        cx: centerX,
        cy: centerY,
        r: 24,
        class: "highlightshape moodanimation linehighlightshapestyle1 " + this.data.layout.itemShapeDrawStyle,
        "data-pathLength": pathLength,
        "data-customsmovey": centerY,
        "data-customsmovex": centerX,
    });
    return svgCircle;
};
SimpleLineChart.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex, dummeyShape) {
    if (this.data.layout.linechartShapeStyle == "border") {
        let borderSize = this.data.layout.linechartShapeBorderSize ? this.data.layout.linechartShapeBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.linechartShapeBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsTertiaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
                dummeyShape.classList.add(this.data.ChartFonts.appendgraphicColor(seriesIndex));
            }
        } else {
            if (this.data.layout.linechartShapeBorderColor == "tertiary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    // element.classList.add("clsTertiaryStroke");
                    // if(dummeyShape)dummeyShape.classList.add("clsTertiaryFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "secondary") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    element.classList.add("secondary-stroke");
                    if (dummeyShape) dummeyShape.classList.add("clsSecondaryFill");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "bgcolor") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("bgfill");
                    element.classList.add("bgstroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "alterbg") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    if (dummeyShape) dummeyShape.classList.add("alterbgcolor");
                    element.classList.add("alter-background-stroke");
                }
            } else if (this.data.layout.linechartShapeBorderColor == "gradient") {
                if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                    // element.classList.add("clsTertiaryStroke");
                } else {
                    this.addGradient(element, element, element.parentNode, false, true, false, seriesIndex);
                }
            } else {
                // element.classList.add("clsTertiaryStroke");
            }
        }
    }
    if (this.data.layout.linechartShapeBgColor) {
        if (this.data.layout.linechartShapeBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                // element.classList.add("clsTertiaryFill");
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                }
            } else {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.linechartShapeBgColor == "tertiary") {
                if (this.data.layout.linechartShapebgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                } else {
                    // element.classList.add("clsTertiaryFill");
                }
            } else {
                if (this.data.layout.linechartShapeBgColor == "secondary") {
                    if (this.data.layout.linechartShapebgOpacity) {
                        element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                    } else {
                        element.classList.add("secondary-fill");
                    }
                } else if (this.data.layout.linechartShapeBgColor == "alterbg") {
                    if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                        // element.classList.add("clsTertiaryStroke");
                    } else {
                        element.classList.remove("clsAccentfill");
                        element.classList.remove("bgfill");
                        element.classList.add("alterbgcolor");
                    }
                } else {
                    if (this.data.layout.linechartShapeBgColor == "gradient") {
                        this.addGradient(element, element, element.parentNode, true, false, seriesIndex);
                    } else if (this.data.layout.linechartShapeBgColor == "bgcolor") {
                        if (this.data.layout.linechartShapebgOpacity) {
                            element.classList.remove("clsAccentfill");
                            element.classList.add("bgfill");
                            element.style.setProperty("fill-opacity", this.data.layout.linechartShapebgOpacity, "important");
                        } else {
                            element.classList.add("secondary-fill");
                        }
                    }
                }
            }
        }
    }
    if (this.data.layout.itemShapeShadow) {
        element.classList.add(this.data.layout.itemShapeShadow);
    }
};
SimpleLineChart.prototype.createProjectionSVG = function (item) {
    if (this.data.hasProjection) {
        let svgProjection = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgProjection, {
            id: "projectionlayer",
            width: "100%",
            style: "position:absolute;",
            height: "100%",
            x: "0%",
            y: "0%",
        });
        let itemGraphic = item;
        let itemProjection = itemGraphic.cloneNode(true);
        //let TopmaskElement = itemProjection.querySelector(".basemaskrect");
        // if(TopmaskElement){
        //     TopmaskElement.parentNode.parentNode.removeChild(TopmaskElement.parentNode)
        // }
        this.data.SVGUtils.assignAttributes(itemProjection.children[0], {
            x: 0,
            y: 0,
        });
        let itemCircles = itemProjection.querySelectorAll(".item-circle");
        let areaPath = itemProjection.querySelectorAll(".areapath");
        for (let i1 = 0; i1 < itemCircles.length; i1++) {
            itemCircles[i1].parentNode.removeChild(itemCircles[i1]);
        }
        for (let a1 = 0; a1 < areaPath.length; a1++) {
            areaPath[a1].style.fill = "white";
        }
        let itemMask = itemProjection.querySelectorAll(".projectionRect");
        let maskNode = itemProjection.querySelector(".dasharrayelement");
        if (maskNode) maskNode.remove();

        for (let i2 = 0; i2 < itemMask.length; i2++) {
            let xvalue = itemMask[i2].children[0].getAttribute("width");
            let widthvalue = this.intLastX - parseFloat(xvalue);
            itemMask[i2].children[0].setAttribute("x", xvalue);
            itemMask[i2].children[0].setAttribute("width", widthvalue);
            itemProjection.children[0].appendChild(itemMask[i2].parentNode);
            itemMask[i2].setAttribute("id", this.maskprojection);
        }

        let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
        svgProjection.appendChild(patternDefsTag);

        let seriesItem = itemProjection.querySelectorAll(".svgseriesitem");
        let projectionClass = "";
        let projectionStrokeClass = this.lineGradient ? "" : "";
        for (let i1 = 0; i1 < seriesItem.length; i1++) {
            seriesItem[i1].setAttribute("mask", "url(#" + this.maskprojection + ")");
            projectionStrokeClass = this.lineGradient ? "" : this.getBgFillDetails(i1, "clsAccentStroke", this.data.layout.itemColor, "stroke");
            let seriesItemClass = seriesItem[i1].getAttribute("class") ? seriesItem[i1].getAttribute("class") : "";
            seriesItem[i1].setAttribute("class", seriesItemClass + " " + this.data.layout.lineShadow);

            let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
            this.data.SVGUtils.assignAttributes(patternMaskTag, {
                id: this.randomkey + this.data.slideID + "mask" + i1,
                class: "mask projectionenablestyle",
                maskUnits: "userSpaceOnUse",
            });
            patternMaskTag.style.setProperty("filter", "none", "important");
            let pathTo = seriesItem[i1].querySelectorAll(".item-lines");
            let itemPath = seriesItem[i1].querySelectorAll(".item-path");
            patternDefsTag.appendChild(patternMaskTag);
            let lineshaowColors = this.data.layout.lineShadow ? this.data.layout.lineShadow.split(" ") : [];
            if (pathTo.length > 0 && pathTo[0].parentNode && pathTo[0].parentNode.parentNode) {
                lineshaowColors.forEach(function (element) {
                    if (element) {
                        seriesItem[i1].classList.remove(element);
                    }
                });
                seriesItem[i1].classList.remove("projectiondisablestyle");
                seriesItem[i1].classList.add("projectionenablestyle");
                // pathTo[0].parentNode.style.setProperty("filter", "grayscale(100%)", "important");
            }
            if (itemPath.length > 0 && itemPath[0].parentNode && itemPath[0].parentNode.parentNode) {
                lineshaowColors.forEach(function (element) {
                    if (element) {
                        seriesItem[i1].classList.remove(element);
                    }
                });
                seriesItem[i1].classList.remove("projectiondisablestyle");
                seriesItem[i1].classList.add("projectionenablestyle");
                //itemPath[0].parentNode.style.setProperty("filter", "grayscale(100%)", "important");
            }
            for (let i3 = 0; i3 < pathTo.length; i3++) {
                let maskLine = pathTo[i3].cloneNode(true);
                maskLine.removeAttribute("class");
                maskLine.removeAttribute("mask");
                this.data.SVGUtils.assignAttributes(maskLine, {
                    class: "item-lines " + this.data.layout.lineShadow,
                    stroke: "white",
                });
                if (this.bgFill) {
                    maskLine.style.fill = "white";
                    maskLine.removeAttribute("fill-opacity");
                    maskLine.removeAttribute("stroke-opacity");
                }
                patternMaskTag.appendChild(maskLine);
                projectionClass = this.areaGradient ? "" : "";
                this.data.SVGUtils.assignAttributes(pathTo[i3], {
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                    class: "path_to item-lines " + projectionClass + " " + this.data.layout.lineShadow,
                });
                if (this.bgFill) {
                    projectionClass = !this.areaGradient && pathTo[i3].getAttribute("data-areacolor") ? pathTo[i3].getAttribute("data-areacolor") : projectionClass;
                    this.data.SVGUtils.assignAttributes(pathTo[i3], {
                        mask: "",
                        class: "path_to item-lines clsAreaStyle " + projectionClass,
                    });
                    pathTo[i3].style.removeProperty("fill");
                    pathTo[i3].removeAttribute("fill-opacity");
                    pathTo[i3].removeAttribute("stroke-opacity");
                }
                // let fillType = pathTo[i3].getAttribute("fill");
                // if(fillType&&fillType.includes("area")){
                //     fillType = fillType.replace("area", "projectionarea");
                // }else{
                //     if(fillType&&fillType.includes("grad")){
                //         fillType = fillType.replace("grad", "projectiongrad");
                //     }
                // }
                // pathTo[i3].setAttribute("fill",fillType);
            }
            for (let i2 = 0; i2 < itemPath.length; i2++) {
                let maskPath = itemPath[i2].cloneNode(true);
                maskPath.removeAttribute("class");
                this.data.SVGUtils.assignAttributes(maskPath, {
                    stroke: "white",
                    class: "item-path " + this.data.layout.lineShadow,
                    "data-animation": "",
                    // "stroke-dasharray": 13,
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                });
                patternMaskTag.appendChild(maskPath);
                this.data.SVGUtils.assignAttributes(itemPath[i2], {
                    mask: "url(#" + this.randomkey + this.data.slideID + "mask" + i1 + ")",
                    class: "item-path moodanimation " + this.data.layout.lineShadow,
                    "data-animation": "itemline",
                    "data-linechart": "true",
                    "data-seriesitemindex": i1.toString(),
                });

                if (this.bgFill) {
                    this.data.SVGUtils.assignAttributes(itemPath[i2], {
                        class: "item-path clsAreaStroke " + projectionStrokeClass + " " + this.data.layout.lineShadow,
                        "data-animation": "",
                    });
                    if (this.data.layout.lineShadow) {
                        this.data.SVGUtils.assignAttributes(itemPath[i2].parentNode, {
                            class: this.data.layout.lineShadow,
                        });
                    }
                    itemPath[i2].style.removeProperty("fill");
                    itemPath[i2].removeAttribute("stroke-opacity");
                }
                if (itemPath[i2] && itemPath[i2].parentNode && !this.bgFill && projectionStrokeClass) {
                    itemPath[i2].parentNode.classList.add(projectionStrokeClass);
                }
                if (this.dashedarray) {
                    this.data.SVGUtils.assignAttributes(itemPath[i2], {
                        mask: "",
                        "data-mask": "",
                    });
                }

                // let fillType = itemPath[i2].getAttribute("stroke");
                // if(fillType&&fillType.includes("area")){
                //     fillType = fillType.replace("area", "projectionarea");
                // }else{
                //     if(fillType&&fillType.includes("grad")){
                //         fillType = fillType.replace("grad", "projectiongrad");
                //     }
                // }
                // itemPath[i2].setAttribute("stroke",fillType);
            }
        }
        let cloneNode = itemProjection.children[0].cloneNode(true);
        cloneNode.setAttribute("x", "0");
        svgProjection.appendChild(cloneNode);
        item.children[0].style.position = "absolute";
        item.insertBefore(svgProjection, item.children[0]);
        if (this.style.bgFillType == "gradient") {
            let areaGradient = svgProjection.getElementsByTagName("linearGradient");
            for (let p1 = 0; p1 < areaGradient.length; p1++) {
                let currentId = areaGradient[p1].getAttribute("id");
                if (currentId && currentId.includes("area")) {
                    currentId = currentId.replace("area", "projectionarea");
                } else {
                    if (currentId && currentId.includes("grad")) {
                        currentId = currentId.replace("grad", "projectiongrad");
                    }
                }
                let itemLines = svgProjection.querySelectorAll(".item-lines");
                for (let i1 = 0; i1 < itemLines.length; i1++) {
                    if (itemLines[i1].getAttribute("fill").includes("area")) {
                        let oldFillValue = itemLines[i1].getAttribute("fill");
                        let newFillValue = oldFillValue.replace("area", "projectionarea");
                        itemLines[i1].setAttribute("fill", newFillValue);
                    } else {
                        if (itemLines[i1].getAttribute("fill").includes("grad")) {
                            let oldFillValue = itemLines[i1].getAttribute("fill");
                            let newFillValue = oldFillValue.replace("grad", "projectiongrad");
                            itemLines[i1].setAttribute("fill", newFillValue);
                        }
                    }
                }
                areaGradient[p1].setAttribute("id", currentId);
                for (let p2 = 0; p2 < areaGradient[p1].children.length; p2++) {
                    let currentStyle = areaGradient[p1].children[p2].getAttribute("style");
                    if (currentStyle.includes("var(--gradient1-color-rgb)")) {
                        currentStyle = currentStyle.replace("var(--gradient1-color-rgb)", "var(--tertiary-color-rgb)");
                    }
                    if (currentStyle.includes("var(--gradient2-color-rgb)")) {
                        currentStyle = currentStyle.replace("var(--gradient2-color-rgb)", "var(--tertiary-color-rgb)");
                    }
                    areaGradient[p1].children[p2].setAttribute("style", currentStyle);
                }
            }
        }
        let arrowHeadarray = svgProjection.querySelectorAll(".arrowhead");
        for (let a1 = 0; a1 < arrowHeadarray.length; a1++) {
            arrowHeadarray[a1].remove();
        }
        let arrowHightlightCircle = svgProjection.querySelectorAll(".highlightshape");
        for (let h1 = 0; h1 < arrowHightlightCircle.length; h1++) {
            arrowHightlightCircle[h1].remove();
        }
        if (this.data.hasProjection) {
            let projectiondisable = item.querySelectorAll("#series-common").length > 1 ? item.querySelectorAll("#series-common")[1] : "";
            if (projectiondisable) {
                let svgSeiesItemClone = projectiondisable.querySelectorAll(".svgseriesitem");
                for (s1 = 0; s1 < svgSeiesItemClone.length; s1++) {
                    if (svgSeiesItemClone[s1].classList.contains("projectiondisablestyle")) {
                        svgSeiesItemClone[s1].classList.remove("projectiondisablestyle");
                        let pathNode = svgSeiesItemClone[s1].getElementsByTagName("path");
                        for (let v1 = 0; v1 < pathNode.length; v1++) {
                            pathNode[v1].classList.add("projectiondisablestyle");
                        }
                    }
                }
            }
        }
        if (this.bgFill) {
            let itemLine = svgProjection.querySelectorAll("[data-animation='itemline']");
            for (let i1 = 0; i1 < itemLine.length; i1++) {
                itemLine[i1].dataset.animation = "";
            }
        }
    }
};
SimpleLineChart.prototype.createMaskSVG = function (argparent) {
    let DefsTag = this.data.SVGUtils.createSVGElement("defs");
    for (let i1 = 0; i1 < this.data.seriesItemLength; i1++) {
        let MaskTag = this.data.SVGUtils.createSVGElement("mask");
        this.baseMaskRect = Math.random() + this.voData.slideID + "basemaskrect" + i1;
        this.data.SVGUtils.assignAttributes(MaskTag, {
            id: this.baseMaskRect,
            class: "basemaskrect",
            "data-maskelement": "true",
        });
        DefsTag.appendChild(MaskTag);
        let endpercentage = this.intLastX - (this.intStartX - this.intCircleRadius);
        let Masksvg = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(Masksvg, {
            x: this.intStartX - this.intCircleRadius,
            y: 0,
            width: endpercentage,
            height: this.state.height,
            class: "areamaskrect",
        });
        MaskTag.appendChild(Masksvg);
        let basemaskRect = this.data.SVGUtils.createSVGElement("rect");
        this.data.SVGUtils.assignAttributes(basemaskRect, {
            class: "moodanimation",
            x: 0,
            y: 0,
            width: endpercentage,
            fill: "white",
            height: this.state.height,
            "data-animation": "itemarea",
        });
        Masksvg.appendChild(basemaskRect);
    }
    //this.intStartX = 0;
    // this.intLastX = 0;
    argparent.appendChild(DefsTag);
};

SimpleLineChart.prototype.createDropShadow = function (svgElement) {
    let filterDy = this.filterYDistance == 0 ? 0 : parseInt(this.data.layout.shadowxValue);
    let filterDx = this.filterXDistance == 0 ? 0 : parseInt(this.data.layout.shadowyValue);
    let dropshadowColor = this.data.layout.itemBoxShdowColor == "item" || this.data.layout.itemBoxShdowColor == "theme" ? "SourceGraphic" : "SourceAlpha";

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let filterTag = this.data.SVGUtils.createSVGElement("filter");
    this.data.SVGUtils.assignAttributes(filterTag, {
        id: "dropshadow",
        x: "0",
        y: "0",
    });
    defsTag.appendChild(filterTag);

    let feOffsetTag = this.data.SVGUtils.createSVGElement("feOffset");
    this.data.SVGUtils.assignAttributes(feOffsetTag, {
        in: dropshadowColor,
        dx: filterDx,
        dy: filterDy,
        result: "offOut",
    });
    filterTag.appendChild(feOffsetTag);
    let feDropShadowTag = this.data.SVGUtils.createSVGElement("feGaussianBlur");
    let stateDiv = 5;
    if (this.data.layout.itemBoxShdowOpacity) {
        let currentOpacity = 1 - parseFloat(this.data.layout.itemBoxShdowOpacity);
        stateDiv = currentOpacity * 10;
    }
    this.data.SVGUtils.assignAttributes(feDropShadowTag, {
        result: "blurOut",
        stdDeviation: stateDiv,
        in: "blurOut",
    });
    filterTag.appendChild(feDropShadowTag);

    let feBlend = this.data.SVGUtils.createSVGElement("feBlend");
    this.data.SVGUtils.assignAttributes(feBlend, {
        in: "SourceGraphic",
        in2: "blurOut",
        mode: "normal",
    });
    filterTag.appendChild(feBlend);
};

