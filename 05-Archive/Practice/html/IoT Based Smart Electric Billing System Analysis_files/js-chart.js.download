SimpleShapeComparisonSeriesItem.prototype.doMaskPieComputation = function (assetSize, groupindex, index, subelement, argprops) {
    assetSize = parseInt(assetSize);
    let intMaxAngle = 360;
    this.pntCenter.x = parseInt(assetSize / 2);
    this.pntCenter.y = parseInt(assetSize / 2);
    let value = argprops.value < 100 ? argprops.value : 100;
    this.radius = parseInt(assetSize / 2);
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (value / 100);
    this.endAngle = this.startAngle + (intMaxAngle * value) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.ChartFonts.graphicFillColor(groupindex);
    let strBgStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);

    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "micropie",
        x: "0%",
        y: "0%",
        width: parseInt(assetSize) + "px",
        height: parseInt(assetSize) + "px",
        viewBox: 0 + " " + 0 + " " + parseInt(assetSize) + " " + parseInt(assetSize),
    });
    subelement.appendChild(svgElement);

    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to  " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray,
        mask: "url(#mask" + groupindex + ")",
    });

    let circlesvg = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(circlesvg, {
        id: "maskcircle" + groupindex,
        class: "moodanimation transformOrgincenter " + strBgStyleClass,
        cx: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.x),
        cy: this.data.SVGUtils.createPercentValue(assetSize, this.pntCenter.y),
        r: this.data.SVGUtils.createPercentValue(assetSize, this.radius),
        "data-animation": "itembackground",
        "fill-opacity": this.data.layout.backgroundOpacity,
        "stroke-opacity": 0,
    });
    svgElement.appendChild(circlesvg);
    svgElement.appendChild(svgPathTo);
};

SimpleShapeComparisonSeriesItem.prototype.doDoughnutComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let intMaxAngle = 360;
    this.pntCenter.x = assetSize / 2;
    this.pntCenter.y = assetSize / 2;
    this.radius = assetSize / 2;
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.totalDashArray = Math.PI * this.radius;
    this.valueDashArray = this.totalDashArray - this.totalDashArray * (intValue / 100);
    this.innerRadius = this.radius * 0.8;
    this.endAngle = this.startAngle + (intMaxAngle * intValue) / 100;

    this.pntEnd.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.endAngle) / 180));
    this.pntEnd.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.endAngle) / 180));
    this.pntStart.x = Math.round(this.pntCenter.x + this.radius * Math.cos((Math.PI * this.startAngle) / 180));
    this.pntStart.y = Math.round(this.pntCenter.y + this.radius * Math.sin((Math.PI * this.startAngle) / 180));
    this.pntEnd.x = this.pntStart.y == this.pntEnd.y && this.pntStart.x == this.pntEnd.x ? this.pntEnd.x - 0.001 : this.pntEnd.x;

    this.pntInnerStart.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.startAngle / 180)));
    this.pntInnerStart.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.startAngle / 180)));
    this.pntInnerEnd.x = Math.round(this.pntCenter.x + this.innerRadius * Math.cos(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.y = Math.round(this.pntCenter.y + this.innerRadius * Math.sin(Math.PI * (this.endAngle / 180)));
    this.pntInnerEnd.x = this.pntInnerEnd.x == this.pntInnerEnd.x ? this.pntInnerEnd.x - 0.001 : this.pntInnerEnd.x;

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    let strStyleClass = this.ChartFonts.graphicFillColor(groupindex);
    let strBgStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.backgroundColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let strBgStrokeStyleClass = this.getBgFillDetails(groupindex, "clsTertiaryStroke", this.data.layout.backgroundColor, "stroke"); //this.ChartFonts.graphicFillColor(groupindex);

    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-" + groupindex + "_" + index,
        class: "micropie " + strStyleClass,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
        viewBox: 0 + " " + 0 + " " + assetSize + " " + assetSize,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-type": "CHARTITEM",
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    subelement.appendChild(svgElement);

    let svgBgDonghnutPath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
        id: "svgBgDonghnutPath-" + groupindex + "_" + index,
        class: this.ChartUtils.moodClassName + " " + strBgStyleClass + " " + strBgStrokeStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 1 1 " +
            (this.pntStart.x - 0.001) +
            "," +
            this.pntStart.y +
            "L" +
            (this.pntInnerStart.x - 0.001) +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            " 0 1 0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "data-animation": "itembackground",
    });
    svgElement.appendChild(svgBgDonghnutPath);
    if (this.data.layout.backgroundColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgBgDonghnutPath, {
            fill: "",
            stroke: "",
        });
        this.addGradient(svgBgDonghnutPath, svgElement);
    }
    let svgPathTo = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathTo, {
        id: "path-" + groupindex + "_" + index,
        class: "path_to " + strStyleClass,
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntEnd.x +
            "," +
            this.pntEnd.y +
            "L" +
            this.pntInnerEnd.x +
            "," +
            this.pntInnerEnd.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": this.voData.customProperties.appearance == "Outline" ? 0 : 1,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.endAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
        "data-animation": "item",
        "data-totaldasharray": this.totalDashArray,
        "data-valuedasharray": this.valueDashArray,
        mask: "url(#mask" + groupindex + ")",
    });
    svgElement.appendChild(svgPathTo);
    if (this.data.layout.itemColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgPathTo, {
            class: "path_to ",
        });
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathTo, svgElement);
    }

    let svgPathFrom = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(svgPathFrom, {
        id: "path_from-" + groupindex + "_" + index,
        class: "path_from",
        d:
            "M" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "L" +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "A" +
            this.radius +
            "," +
            this.radius +
            " 0 " +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",1 " +
            this.pntStart.x +
            "," +
            this.pntStart.y +
            "L" +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "A" +
            this.innerRadius +
            "," +
            this.innerRadius +
            ",0," +
            (this.endAngle - this.startAngle > 180 ? 1 : 0) +
            ",0 " +
            this.pntInnerStart.x +
            "," +
            this.pntInnerStart.y +
            "z",
        "fill-opacity": 0,
        "stroke-opacity": 0,
        "data-cx": this.pntCenter.x,
        "data-cy": this.pntCenter.y,
        "data-endangle": this.startAngle,
        "data-startangle": this.startAngle,
        "data-outerradius": this.radius,
        "data-innerradius": this.innerRadius,
    });
    svgElement.appendChild(svgPathFrom);
    if (this.data.layout.itemColor == "gradient") {
        this.data.SVGUtils.assignAttributes(svgPathFrom, {
            fill: "",
            stroke: "",
        });
    }
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgPathFrom, svgElement);
    }
};

SimpleShapeComparisonSeriesItem.prototype.doFillComputation = function (assetSize, groupindex, index, subelement, argprops) {
    let strStyleClass = this.getBgFillDetails(groupindex, this.data.ChartFonts.appendgraphicFillColor(groupindex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicFillColor(groupindex);
    let svgFilterElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgFilterElement, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        //filter: "url(#dropshadow)"
    });
    subelement.appendChild(svgFilterElement);

    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "svgElement-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: assetSize + "px",
        height: assetSize + "px",
    });
    svgFilterElement.appendChild(svgElement);

    let svgIcon = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgIcon, {
        class: "bgsvg moodanimation",
        "data-animation": "itembackground",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        fill: "#efefef",
        "xlink:href": "#" + this.data.asset.data[0].id,
    });
    svgElement.appendChild(svgIcon);
    let baseSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSVG, {
        id: "baseSVG-" + groupindex + "_" + index,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        mask: "url(#maskicon" + this.groupindex + ")",
    });
    svgElement.appendChild(baseSVG);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defsTag);
    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        id: "maskicon" + this.groupindex,
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    let svgAsset;
    if (!this.data.layout.boolitemShape) {
        svgAsset = this.data.asset.data[0].data.cloneNode(true);
        svgMask.appendChild(svgAsset);
    } else {
        this.data.SVGUtils.assignAttributes(svgIcon, {
            "xlink:href": "#assetelement",
        });
        this.createGraphicShape(svgElement, svgMask, assetSize);
    }
    let intValue = argprops.value < 100 ? argprops.value : 100;
    this.rectHeight = (assetSize * intValue) / 100;
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + groupindex + "_" + index,
        class: "graphic-container",
        x: "0%",
        y: assetSize - this.rectHeight + "px",
        width: "100%",
        height: this.rectHeight + "px",
    });
    baseSVG.appendChild(graphicContainerSVG);
    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + groupindex + "_" + index,
        class: "transformOrginBottom moodanimation " + strStyleClass,
        "data-type": "CHARTITEM",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-animation": "item",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
};
SimpleShapeComparisonSeriesItem.prototype.createGraphicShape = function (argParent, maskelement, assetsize) {
    if (!this.data.layout.boolitemShape) {
        let svgAsset = this.data.asset.data[0].data.cloneNode(true);
        maskelement.appendChild(svgAsset);
    } else {
        let maskShape = "";
        if (this.data.layout.itemShapeType == "circle") {
            maskShape = this.data.SVGUtils.createSVGElement("circle");
            this.data.SVGUtils.assignAttributes(maskShape, {
                cx: assetsize / 2,
                cy: assetsize / 2,
                r: assetsize / 2,
            });
            if (this.data.layout.itemStyle == "border") {
                this.data.SVGUtils.assignAttributes(maskShape, {
                    r: assetsize / 2 - 5,
                });
            }
        } else {
            if (this.data.layout.itemShapeType == "square") {
                maskShape = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(maskShape, {
                    x: 0,
                    y: 0,
                    width: assetsize,
                    height: assetsize,
                });
                if (this.data.layout.itemStyle == "border") {
                    this.data.SVGUtils.assignAttributes(maskShape, {
                        x: 2.5,
                        y: 2.5,
                        width: assetsize - 5,
                        height: assetsize - 5,
                    });
                }
            }
        }
        this.data.SVGUtils.assignAttributes(maskShape, {
            id: "assetelement",
        });
        this.itemShapebgProperties(maskShape, this.groupindex, this.groupindex);
        let duplicateElement = maskShape.cloneNode(true);
        if (this.data.layout.itemShapeType == "circle") {
            if (this.data.layout.itemStyle == "border") {
                this.data.SVGUtils.assignAttributes(duplicateElement, {
                    r: assetsize / 2 - 7,
                });
            }
        } else {
            if (this.data.layout.itemShapeType == "square") {
                if (this.data.layout.itemStyle == "border") {
                    this.data.SVGUtils.assignAttributes(duplicateElement, {
                        x: 3.5,
                        y: 3.5,
                        width: assetsize - 7,
                        height: assetsize - 7,
                    });
                }
            }
        }
        maskelement.parentNode.appendChild(maskShape);
        maskelement.appendChild(duplicateElement);
    }
};
SimpleShapeComparisonSeriesItem.prototype.itemShapebgProperties = function (element, seriesIndex, groupindex) {
    if (this.data.layout.itemStyle == "border") {
        let borderSize = this.data.layout.itemBorderSize ? this.data.layout.itemBorderSize : "2";
        element.style.strokeWidth = borderSize;
        if (this.data.layout.itemBorderColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryStroke");
            } else {
                element.classList.add(this.data.ChartFonts.appendgraphicStrokeColor(seriesIndex));
            }
        } else {
            element.classList.add("clsTertiaryStroke");
        }
    }
    if (this.data.layout.itemBgColor) {
        if (this.data.layout.itemBgColor == "theme") {
            if (this.data.hasProjection && this.data.projection[groupindex] == true) {
                element.classList.add("clsTertiaryFill");
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                }
            } else {
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicFillColor(seriesIndex));
                }
            }
        } else {
            if (this.data.layout.itemBgColor == "tertiary") {
                if (this.data.layout.itembgOpacity) {
                    element.style.setProperty("fill-opacity", this.data.layout.itembgOpacity, "important");
                } else {
                    element.classList.add("clsTertiaryFill");
                }
            }
        }
    }
};
