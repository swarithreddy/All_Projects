};

AxisBaseLine.prototype.getBoundArea = function (eSeries, elementDiv, alignment) {
    let viewPortBounds = eSeries[0].getBoundingClientRect();
    let targetBounds = elementDiv.getBoundingClientRect();
    let item = { x: 0, y: 0 };
    viewPortBounds.x = parseFloat(window.getComputedStyle(eSeries[0])["x"].split("px")[0]);
    viewPortBounds.y = parseFloat(window.getComputedStyle(eSeries[0])["y"].split("px")[0]);
    viewPortBounds.width = parseFloat(window.getComputedStyle(eSeries[0])["width"].split("px")[0]);
    viewPortBounds.height = parseFloat(window.getComputedStyle(eSeries[0])["height"].split("px")[0]);
    targetBounds.width = parseFloat(window.getComputedStyle(elementDiv)["width"].split("px")[0]);
    targetBounds.height = parseFloat(window.getComputedStyle(elementDiv)["height"].split("px")[0]);
    let itemParent = elementDiv;
    let boolenableposition = false;
    var dataType = (itemParent && itemParent.dataset?.type) || "none";
    while (itemParent && !itemParent.className.includes("slide")) {
        item.x = itemParent.offsetLeft + item.x;
        item.y = itemParent.offsetTop + item.y;
        if (boolenableposition) {
            itemParent.style.position = "relative";
            itemParent.style.top = "0";
            boolenableposition = false;
        }
        itemParent = itemParent.offsetParent;
        dataType = (itemParent && itemParent.dataset?.type) || "none";
        if (alignment == "horizontal") {
            itemParent.classList.forEach(function (item) {
                if (item == "baselineleftparent") {
                    boolenableposition = true;
                    itemParent.style.position = "absolute";
                    itemParent.style.top = "0";
                }
            });
        }
    }
    targetBounds.x = item.x;
    targetBounds.y = item.y >= itemParent.clientHeight ? item.y - itemParent.clientHeight : item.y;
    return { viewPortBounds: viewPortBounds, targetBounds: targetBounds };
};

"use strict";
function BaseChart(argParent, argProps) {
    this.name = "BaseChart";
    DComponent.call(this, argParent, argProps);
}

BaseChart.prototype = Object.create(DComponent.prototype);
BaseChart.prototype.constructor = BaseChart;

BaseChart.prototype.seriesInstance = function (argParent, argProps) {
    return new window["BaseSeries"](argParent, argProps);
};
BaseChart.prototype.hadValidateData = function () {
    return true;
};

BaseChart.prototype.conflictsHandle = function () {};

BaseChart.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        if (this.hadValidateData) {
            this.doAddAxisTitle();
            this.doAddGridDesk();
            this.doAddGraphicDesk();
            this.doAddMetaData();
        }
    }
};

BaseChart.prototype.doAddMetaData = function () {
    let SVGUtils = new window["SVGUtils"]();
    const element = SVGUtils.createSVGElement("metadata");
    SVGUtils.assignAttributes(element, {
        slideID: this.data.slideID,
        maxvalue: this.data.maxValue,
        class: "metadata_group_chart",
        length: this.data.seriesLength,
        sublength: this.data.chartName=="statisticalBarSimpleRectangle"?2:this.data.seriesItemLength,
        viewportwidth: this.state.width,
        viewportheight: this.state.height,
        conflictLayoutList: this.data.conflictLayout,
        emphasis: this.data.baseProperties.hasEmphasis,
        isdivChart: this.data.baseProperties.isDivChart,
        minseries: this.data.baseProperties.minAllowedSeries,
        negativechart: this.data.baseProperties.isNegativeChart,
        projection: this.data.baseProperties.hasProjectionEnable,
        percentagechart: this.data.baseProperties.isPercentageChart,
        minseriesitem: this.data.baseProperties.minAllowedSeriesItems,
        graphicimage: this.data.baseProperties.hasGraphicImage && this.data.seriesItemLength == 1,
        maxseries: this.data.baseProperties.maxAllowedSeries,
        maxseriesitem: this.data.baseProperties.maxAllowedSeriesItems,
    });
    this.parent.appendChild(element);
};

BaseChart.prototype.doMeasurementComputation = function (argParent, bounds = null) {
    //return null;
    this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width, height: this.viewport.height };
    this.rectLegendBaseSeries = { x: 0, y: 0, width: this.viewport.width, height: this.viewport.height };

    if (this.data.baseProperties.legend && (this.voData.seriesItemLength > 1 ||this.data.seriesanimation|| this.data.chartName == "comparisonModelType3"||this.data.chartName=="waterfallchart"||this.data.chartName=="stackedPercentageChart")) {
        let rectSize = 0;
        this.rectBaseLegend = { x: 0, y: 0, width: 0, height: 0 };
        this.rectLegendBaseSeries = { x: 0, y: 0, width: 0, height: 0 };
        this.legendposition = this.voData.legendposition == "" ? "bottom" : this.voData.legendposition;
        const legendMaxSize = argParent ? argParent.clientHeight : bounds ? bounds.height : 120;
        if (this.legendposition == "top") {
            this.parent.style.flexDirection = "column";
            rectSize = this.viewport.height - legendMaxSize;
            this.rectLegendBaseSeries = { x: 0, y: 0, width: rectSize, height: rectSize };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width, height: legendMaxSize };
        } else if (this.legendposition == "bottom") {
            this.parent.style.flexDirection = "column-reverse";
            rectSize = this.viewport.height - legendMaxSize;
            this.rectLegendBaseSeries = { x: 0, y: 0, width: this.viewport.width, height: rectSize };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width, height: legendMaxSize };
        } else if (this.legendposition == "left") {
            if(!this.data.compareDivider)this.parent.style.flexDirection = "row";
            
            rectSize = Math.min(this.viewport.width, this.viewport.height);

            this.rectLegendBaseSeries = {
                x: (this.viewport.width - rectSize) / 2,
                y: (this.viewport.height - rectSize) / 2,
                width: rectSize,
                height: rectSize,
            };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width - rectSize, height: this.viewport.height };
        } else if (this.legendposition == "right") {
            if(!this.data.compareDivider)this.parent.style.flexDirection = "row-reverse";
            rectSize = Math.min(this.viewport.width, this.viewport.height);
            rectSize = rectSize < 400 ? 400 : rectSize;
            this.rectLegendBaseSeries = {
                x: (this.viewport.width - rectSize) / 2,
                y: (this.viewport.height - rectSize) / 2,
                width: rectSize,
                height: rectSize,
            };
            this.rectBaseLegend = { x: 0, y: 0, width: this.viewport.width - rectSize, height: this.viewport.height };
        }
    }
};

BaseChart.prototype.computLegendSize = function (containerElement) {
    let lenegndValues = { x: 0, y: 0, width: 0, height: 0 };
    this.legendHeight = 0;
    this.legendWidth = 0;
    if (containerElement.parentNode&&containerElement.parentNode.querySelector(".legend")) {
        if (this.legendposition == "top" || this.legendposition == "bottom") {
            lenegndValues.height = containerElement.parentNode.querySelector(".legend").clientHeight;
            this.legendHeight =  containerElement.parentNode.querySelector(".legend").clientHeight;
        } else {
            lenegndValues.width =  containerElement.parentNode.querySelector(".legend").clientWidth;
            this.legendWidth = containerElement.parentNode.querySelector(".legend").clientWidth;
            if(!this.data.compareDivider)containerElement.style.flexDirection = "row";
        }
    }
    return lenegndValues;
};
BaseChart.prototype.updateBasicData = function () {
    this.length = this.voData.seriesLength;
};

