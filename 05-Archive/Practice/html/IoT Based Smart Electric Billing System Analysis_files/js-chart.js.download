SimpleLineSeriesItem.prototype.removeValueElement = function () {
    let valueElements = this.data.chartName == "columnStackedRectangle" ? this.parent.parentNode.parentNode.parentNode.querySelectorAll(".value") : this.parent.parentNode.parentNode.querySelectorAll(".value");
    let highlights = this.data.highlights;
    let lineHighlightStyle = this.data.lineHighlightPoint;
    let ChartName = this.data.chartName;
    if (valueElements) {
        let arrLineHighlightStyle = this.data.lineHighlightStyle;
        Array.from(valueElements).forEach(function (item, index) {
            if (arrLineHighlightStyle[index] == "true" && highlights[index] && lineHighlightStyle && ChartName == "lineChart") {
            } else {
                item.style.visibility = "hidden";
                item.children[0].style.visibility = "hidden";
            }
        });
    }
};

SimpleLineSeriesItem.prototype.doAddBottomValue = function (argparent, argprops, boolmax, boolColor = false, boolenablePer = false) {
    const index = argprops.index;
    const groupindex = argprops.gindex;

    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value", true);
    const element = this.ChartHelper.createDivElement({});
    element.id = "bottomvalue-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    element.style.width = this.valueMaxW + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value chartgraphic bottomvalue overflow " + vLayoutName;
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["bottom"] + "px";
    element.style.paddingBottom = padding["top"] + "px";
    if (this.data.layout.valueAlterPaddingClass) {
        element.classList.add(this.data.layout.valueAlterPaddingClass);
    }
    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }

    const subelement = document.createElement("div");
    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    subelement.setAttribute("data-animateItem", "secondarytext" + index);
    subelement.innerText = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = this.valueMaxW + "px";
    subelement.style.maxHeight = this.valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
    }
    if (boolenablePer && this.data.displayValueFormat != "number") {
        subelement.innerText = boolmax ? this.data.longValue + "%" : parseFloat(argprops.valuetext) + "%";
    }
    //subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", -graphicH);
    subelement.dataset.animation = "secondarytext";
    element.appendChild(subelement);
    if (this.data.arrHyperlinkUrl.length >= groupindex) {
        subelement.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[groupindex]);
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["bottom"] + 15 + "px";
                element.style.paddingBottom = padding["top"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["bottom"] + 15 + "px";
                element.style.paddingBottom = padding["top"] + 15 + "px";
            }
            if ("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition == "textbgcalloutstyle4top") {
                this.valueAlignment.vposition = "bottom";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    if (this.data.displayValueFormat != "outof" && this.data.displayValueFormat != "fraction") {
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
    }

    this.ChartHelper.setTextChangeListner(subelement);
    if (boolColor) {
        subelement.classList.remove("clsSecondaryTextColor");
        subelement.classList.add(this.ChartFonts.appendgraphicColor(groupindex)); //"accent" + (groupindex + 1) + "-color")
    }
    if (argparent) argparent.appendChild(element);
    else return element;
    subelement.style.lineHeight = "1.5";
    if (this.data.values[groupindex][index] == this.data.minValue && this.data.minValue < 0) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (this.data.valueTextColor[groupindex][index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex][index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    let calloutStyle = "textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition;
    subelement.style.lineHeight = "";
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        argparent.removeChild(element);
        if (this.data._customProperties.showYAxisGrid) {
            this.data._customProperties.showXAxisLine = true;
        }
    } else {
        this.ChartUtils.createSpanFormat(subelement, this.data);
    }
};

function SimpleFillCompareChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleFillCompareChart";
    BaseColumnChart.call(this,argparent, argprops);
}
SimpleFillCompareChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleFillCompareChart.prototype.constructor = SimpleFillCompareChart;

SimpleFillCompareChart.prototype.seriesInstance=function(argparent, argprops) {
    return new window["SimpleFillCompareSeries"](argparent, argprops);
}
SimpleFillCompareChart.prototype.CreateHightlightDifference = function () {
    return null;
}
function SimpleFillCompareSeries(argparent, argprops) {
    this.name = "SimpleFillCompareSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleFillCompareSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleFillCompareSeries.prototype.constructor = SimpleFillCompareSeries;
SimpleFillCompareSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hposition + " accent" + customColorIndex + " clsMultiColorParent";
    if (this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased != "true") {
        element.style.flexDirection = "column";
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    element.style.width = this.state.width + "px";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }

    // this.doAddLabel(element, argprops, true);
    if (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "bottom" && this.labelAlignment.itemBased != "true") {
        this.addlabel = true;
        this.doAddLabel(element, argprops);
    }
    if (this.valueAlignment.position == "outer" && this.valueAlignment.vposition == "bottom" && this.valueAlignment.itemBased != "true") {
        this.addvalue = true;
        this.doAddValueElement(element, argprops, true);
    }
    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    if (this.data._customProperties.showMergeItems) this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond fillLevelFinder" + " item" + this.graphicElement.hposition;
    subelement.style.width = 100 + "%";
    subelement.style.position = "relative";
    subelement.style.alignItems = "center";
    subelement.style.order = 2;

    if ((this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased != "true") || (this.data.chartName == "singleIconFill" && this.valueAlignment.itemBased == "true" && !this.data.layout.haddivider)) {
        subelement.style.justifyContent = "center";
        subelement.style.order = 0;
    } else {
        subelement.style.justifyContent = "unset";
    }

    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && this.index == 0) subelement.classList.add("alterstyle");

    for (let i1 = 0; i1 < 1; i1++) {
        // if(this.index==0){
        //     subelement.classList.add("flexdirrevers")
        // }else{
        //     subelement.classList.add("flexdirforward")
        // }
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

SimpleFillCompareSeries.prototype.updateBasicData = function () {
    BaseColumnSeries.prototype.updateBasicData.call(this);
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.7;
};

SimpleFillCompareSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleFillCompareSeriesItem"](argparent, argprops);
};

// let objValue;
// let labelMaxW = 230;
// let labeMaxH = 90;
// let valueMaxW = 0;
// let valueMaxH = 0;
// let graphicH = 0;
// let padding = 8;
// let graphicHeightPercentage = 0;
let graphicPercentage = 0.4;
let layoutAreaPercentage = 0.6;
function SimpleFillCompareSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleFillCompareSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleFillCompareSeriesItem.prototype.constructor = SimpleFillCompareSeriesItem;

SimpleFillCompareSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.minValueFontSize[0] > this.maxValueFontSize[0]) {
        this.minValueFontSize = this.maxValueFontSize;
    }
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        labelMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
        labeMaxH = this.state.height * 0.5 - 8;
    } else {
        labelMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
        labeMaxH = this.state.height * 0.5 - 8;
    }
    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        valueMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
        valueMaxH = this.state.height * 0.3;
    } else {
        valueMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
        valueMaxH = this.state.height * 0.3;
    }
    if (this.data.seriesLength == 1 && !this.data.layout.haddivider) {
        valueMaxH = this.state.height * 0.5;
    }
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
    });
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased == "true") valueMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
        if (this.valueAlignment.itemBased == "true") labelMaxW = this.state.width * this.gapPercentage * layoutAreaPercentage;
    }
};

SimpleFillCompareSeriesItem.prototype.doAddGraphicElement = function () {
    // this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    // this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.valuesDenomination[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

SimpleFillCompareSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");
    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };
        let layoutContainer = this.ChartHelper.createDivElement({});
        layoutContainer.className = "layoutContainer";
        layoutContainer.style.width = 100 * layoutAreaPercentage + "%";
        layoutContainer.style.height = "30%";
        layoutContainer.style.position = "relative";
        if (this.data.seriesLength == 1) {
            layoutContainer.style.flexDirection = "column";
        }
        if (this.data.voLayout.valuetextbgstyle) {
            layoutContainer.classList.add(this.data.voLayout.valuetextbgstyle);
        }
        this.doAddTopGraphicsContainer(argparent, eprops, layoutContainer);
        if (this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true") {
            argparent.appendChild(layoutContainer);
            if (this.data.layout.haddivider && this.data.seriesLength > 1) {
                valueMaxW = layoutContainer.clientWidth;
            }
            if (this.data.layout.valueItemBased == "true") this.doAddTopValue(layoutContainer, eprops);
            if (this.data.layout.labelItemBased == "true") this.doAddLabel(layoutContainer, eprops);
        }
        if (this.data.layout.haddivider) {
            let side = groupindex == "0" ? "left" : "right";
            if (this.voData.voLayout.valuetextbgcallout == "true") {
                this.cretaeSvgCallout(layoutContainer, side);
                layoutContainer.style.alignItem = "center";
            } else {
                let valueContainer = layoutContainer.querySelector(".value");
                let labelContainer = layoutContainer.querySelector(".label");
                let levelFinder = argparent.querySelector("#levelfinder");
                let levelFinderTop = levelFinder ? parseFloat(window.getComputedStyle(levelFinder)["top"]) : 0;
                let labelHeight = labelContainer ? parseFloat(labelContainer.clientHeight) : 0;
                let valueHeight = parseFloat(valueContainer.clientHeight);
                valueContainer.style.maxHeight = valueHeight + "px";
                layoutContainer.style.height = "auto";
                labelHeight = labelContainer ? parseFloat(labelContainer.clientHeight) : 0;
                let labelPosition = 0;
                if (this.voData.voLayout.dividerType == "type1") {
                    layoutContainer.style.top = levelFinderTop - valueContainer.clientHeight + "px";
                } else {
                    layoutContainer.style.top = levelFinderTop - valueHeight / 2 + "px";
                }
                let labelpadding = this.setoverlapPadding("label");
                let valuepadding = this.setoverlapPadding("value");
                let containerTopValue = layoutContainer.offsetTop;
                let containerHeight = layoutContainer.clientHeight;
                let totalHeight = containerTopValue + containerHeight;
                let parentContainerHeight = layoutContainer.parentNode.clientHeight;
                if (this.voData.voLayout.dividerType == "type2") {
                    if (this.data.values[this.groupindex][this.index] < 50 || totalHeight > parentContainerHeight) {
                        let BottomGap = this.state.height - (levelFinderTop + valueHeight / 2);
                        if (BottomGap < labelHeight || BottomGap < valueHeight + 5) {
                            layoutContainer.appendChild(valueContainer);
                            if (this.data.seriesLength == 1) {
                                layoutContainer.style.flexDirection = "column-reverse";
                            }
                            layoutContainer.style.flexWrap = "wrap-reverse";
                            layoutContainer.style.top = levelFinderTop - valueHeight / 2 - labelHeight + "px";
                            if (layoutContainer.style.top + layoutContainer.clientHeight > this.state.height) {
                                layoutContainer.style.top = this.state.height - layoutContainer.clientHeight + "px";
                            }
                            valueContainer.style.paddingTop = valuepadding["bottom"] + "px";
                            if (labelContainer) labelContainer.style.paddingTop = labelpadding["bottom"] + "px";
                            if (labelContainer) labelContainer.style.paddingBottom = labelpadding["top"] + "px";
                        } else {
                            labelContainer.style.maxHeight = BottomGap + "px";
                            if (labelContainer?.querySelector(".labeltext")) labelContainer.querySelector(".labeltext").style.maxHeight = BottomGap + "px";
                        }
                    }
                } else {
                    if (this.data.values[this.groupindex][this.index] > 50) {
                        let topGap = levelFinderTop;
                        if (topGap < valueHeight + 5) {
                            layoutContainer.style.top = levelFinderTop + 5 + "px";
                            if (labelContainer) labelContainer.style.paddingTop = labelpadding["top"] + "px";
                        }
                    } else {
                        if (this.data.values[this.groupindex][this.index] < 50 || totalHeight > parentContainerHeight) {
                            let BottomGap = this.state.height - levelFinderTop;
                            if (BottomGap < labelHeight + 5 || BottomGap < valueHeight + 5) {
                                layoutContainer.style.top = levelFinderTop - valueHeight - labelHeight + "px";
                                if (labelContainer) labelContainer.style.paddingTop = labelpadding["top"] + "px";
                            }
                        }
                    }
                }
                layoutContainer.style.position = "absolute";
                this.graphicElement.alterpos == "true" && this.groupindex == 0 ? layoutContainer.classList.add("alterstylepos") : layoutContainer.classList.add("alterstylenoraml");
            }
            let parentbaseElement = !!layoutContainer.parentNode.dataset.singlewidth ? parseFloat(layoutContainer.parentNode.dataset.singlewidth) + layoutContainer.clientWidth : "";
            layoutContainer.parentNode.style.width = parentbaseElement + "px";
        } else {
            layoutContainer.style.height = "100%";
            const vLayoutName = this.valuelayoutClassName("container");
            layoutContainer.classList.add(vLayoutName);
            layoutContainer.style.flexWrap = "unset";
            layoutContainer.style.flexDirection = "column";
            let valueElement = layoutContainer.querySelector(".value");
            if (valueElement && this.data.seriesLength == 1) {
                valueElement.style.height = valueElement.clientHeight + "px";
            }
        }
    }
};

SimpleFillCompareSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, layoutContainer) {
    let divider = this.data.layout.haddivider;
    this.gapPercentage = 1;
    let element = this.ChartHelper.createDivElement({});
    (element.id = "base-graphic-" + argprops.gindex + "_" + argprops.index), (element.className = "basegraphic chartgraphic basetopgraphic");
    if (this.data.layout.dividerType == "type2") {
        element.style.maxWidth = 100 * graphicPercentage + "%";
    } else {
        element.style.maxWidth = 100 * graphicPercentage + "%";
    }
    if (this.data.chartName == "singleIconFill" && this.data.layout.valueInset == "inside") {
        element.style.justifyContent = "center";
    }
    element.style.height = "100%";
    element.style.pointerEvents = "all";
    argparent.appendChild(element);

    //create base svg//
    let borderElement;
    if (false) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "borderelement";
        element.appendChild(borderElement);
    }

    let baseSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSVG, {
        id: "itemplaceholder-" + argprops.gindex,
        "data-type": "ICON",
        "data-icongroup": this.voData.data.getAttribute("data-iconid"),
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    element.appendChild(baseSVG);

    let dummySVGNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(dummySVGNode, {
        "xlink:href": "#" + this.data.itemPlacehoders[argprops.gindex],
        "data-iconpath": this.data.itemPlacehodersPath[argprops.gindex],
        "data-name": this.data.itemPlacehoders[argprops.gindex],
        opacity: 0,
    });
    baseSVG.appendChild(dummySVGNode);
    let bounds = dummySVGNode.getBBox();
    baseSVG.removeChild(dummySVGNode);
    element.style.height = this.state.height * 0.8 < bounds.height ? this.state.height * 0.8 + "px" : bounds.height + "px";
    let maskId = this.data.slideID + Math.random() + "maskicon" + argprops.gindex;
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    baseSVG.appendChild(defsTag);
    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        "data-maskelement": "true",
        id: maskId,
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    const parentHeight = this.state.height * 0.8 < bounds.height ? this.state.height * 0.8 : bounds.height;
    let totalValue = 100;
    if (this.data._rangePositive > 100) {
        totalValue = this.data._rangePositive;
    }
    graphicHeightPercentage = parentHeight * (argprops.value / totalValue);
    // layoutContainer.style.top = (parentHeight - graphicHeightPercentage) + "px";
    graphicH = graphicHeightPercentage;
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + argprops.gindex,
        class: "graphic-container ",
        x: 0,
        y: parentHeight - graphicHeightPercentage + "px",
        width: this.state.width,

        height: graphicHeightPercentage + "px",
    });
    svgMask.appendChild(graphicContainerSVG);
    if (borderElement) borderElement.style.height = graphicHeightPercentage + "px";
    let levelFinder;
    if (divider) {
        levelFinder = this.ChartHelper.createDivElement({});
        levelFinder.id = "levelfinder";
        levelFinder.classList.add("levelfinder");
        levelFinder.classList.add("moodanimation");
        levelFinder.setAttribute("data-graphic-y", graphicH);
        levelFinder.style.position = "absolute";
        if (this.voData.voLayout.dividerType == "type1") {
            levelFinder.style.width = "75%";
        } else {
            levelFinder.style.width = "30px";
        }
        levelFinder.style.height = "0px";
        levelFinder.dataset.animation = "levelfinder";

        let topValue = parentHeight - graphicHeightPercentage;
        let itembase = this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true" ? true : false;
        if (itembase) {
            let graphicTop = (this.state.height - parentHeight) / 2 + parentHeight;
            if (this.data.layout.labelItemBased != "true") {
                let labelElement = this.parent.parentNode.querySelector(".label");
                graphicTop = (this.state.height - labelElement.clientHeight - parentHeight) / 2 + parentHeight;
            }

            levelFinder.style.top = graphicTop - graphicHeightPercentage + "px";
            if (this.data.values[this.groupindex][this.index] == 0) {
                levelFinder.style.top = graphicTop - graphicHeightPercentage - 4 + "px";
            }
        }
        if (this.data.layout.dividerStyle == "outline") {
            levelFinder.style.height = "2px";
        }
        if (this.data.layout.dividerStyle == "dashed") {
            levelFinder.style.border = "2px dashed";
        } else {
            if (this.data.layout.dividerStyle == "dotted") {
                levelFinder.style.border = "2px dotted";
            } else {
                levelFinder.style.border = "2px solid";
            }
        }
        let ConnectorColor = this.getBgColorDetails(this.groupindex, "secondary-border-color", this.data.layout.dividerColor, "bordercolor");
        // if (this.data.layout.dividerColor != "item"&&this.data.layout.dividerColor != "theme") {
        //     levelFinder.classList.add("secondary-border-color");
        // } else {
        // if (argprops.gindex == 0) {
        levelFinder.classList.add(ConnectorColor);
        // } else {
        //     levelFinder.classList.add("accent" + (3 + 1) + "-border-color");
        // }
        // }
        levelFinder.dataset.customopacity = 0.5;
        if (this.voData.voLayout.dividerType == "type1") {
            if (this.data._directionenable) {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.right = "0%";
                } else {
                    levelFinder.style.right = "24%";
                }
            } else {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.left = "0%";
                } else {
                    levelFinder.style.left = "24%";
                }
            }
        } else {
            if (this.data._directionenable) {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.right = "50%";
                } else {
                    levelFinder.style.right = "43%";
                }
            } else {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.left = "50%";
                } else {
                    levelFinder.style.left = "43%";
                }
            }
        }
        argparent.appendChild(levelFinder);
    }

    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + argprops.gindex,
        "data-animation": "item",
        class: "transformOrginBottom moodanimation",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
    let bgColor = this.getBgFillDetails(this.groupindex, "secondary-fill", this.data.layout.backgroundColor, "bgcolor") + " " + this.getBgFillDetails(this.groupindex, "secondary-stroke", this.data.layout.backgroundColor, "stroke");
    let svgBgUseNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgBgUseNode, {
        id: "itemplaceholder-" + argprops.gindex,
        "xlink:href": "#" + this.data.itemPlacehoders[this.groupindex],
        class: "transformOrginTop moodanimation " + bgColor,
        "fill-opacity": this.data.layout.backgroundOpacity,
        "stroke-opacity": this.data.layout.backgroundOpacity,
        "data-animation": "itembackground",
        "data-name": this.data.itemPlacehoders[this.groupindex],
        "data-iconpath": this.data.itemPlacehodersPath[this.groupindex],
        "data-icongroup": this.voData.data.getAttribute("data-iconid"),
        "data-type": "ICON",
        width: "100%",
        height: "100%",
    });
    svgBgUseNode.dataset.customorgin = "top";
    baseSVG.appendChild(svgBgUseNode);
    if (this.data.layout.backgroundColor == "gradient") {
        this.addGradient(svgBgUseNode, baseSVG, true, false, true);
    }
    let styleFill;
    // if (argprops.gindex == 0) {

    styleFill = this.getBgFillDetails(this.groupindex, this.data.ChartFonts.graphicFillColor(this.groupindex), this.data.layout.itemColor, "bgcolor") + this.ChartFonts.graphicStrokeColor(argprops.gindex); //this.ChartFonts.graphicFillColor(argprops.gindex) + this.ChartFonts.graphicStrokeColor(argprops.gindex)
    // } else {
    //     styleFill = this.ChartFonts.graphicFillColor(3) + this.ChartFonts.graphicStrokeColor(3)
    // }
    if (this.data.layout.itemColor == "gradient") {
        styleFill = "";
    }
    let svgUseNode = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgUseNode, {
        id: "itemplaceholder-" + argprops.gindex,
        "xlink:href": "#" + this.data.itemPlacehoders[this.groupindex],
        "data-name": this.data.itemPlacehoders[this.groupindex],
        "data-iconpath": this.data.itemPlacehodersPath[this.groupindex],
        class: styleFill,
        "fill-opacity": this.data.layout.itemOpacity,
        "data-mask": "true",
        "data-type": "ICON",
        "data-icongroup": this.voData.data.getAttribute("data-iconid"),
        mask: "url(#" + maskId + ")",
        width: "100%",
        height: "100%",
    });
    baseSVG.appendChild(svgUseNode);
    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgUseNode, baseSVG);
    }
    let usenodeBounds = svgUseNode.getBBox();
    let boolSingleValue = this.data.seriesLength == 1 ? true : false;
    let layoutWidth = !boolSingleValue ? this.state.width * this.gapPercentage - usenodeBounds.width : this.state.width * this.gapPercentage - usenodeBounds.width;
    if (this.data.layout.dividerType == "type2") {
        if (!boolSingleValue) {
            layoutContainer.style.width = layoutWidth - (this.state.width * this.gapPercentage * 0.1 + 4) + "px";
        } else {
            layoutContainer.style.maxWidth = layoutWidth - (this.state.width * this.gapPercentage * 0.1 + 4) + "px";
            layoutContainer.style.width = "unset";
        }
        if (this.data._directionenable) {
            if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                levelFinder.style.right = "";
                levelFinder.style.left = usenodeBounds.width + 4 + "px";
            } else {
                levelFinder.style.right = usenodeBounds.width + 4 + "px";
            }
        } else {
            if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                levelFinder.style.left = "";
                levelFinder.style.right = usenodeBounds.width + 4 + "px";
            } else {
                levelFinder.style.left = usenodeBounds.width + 4 + "px";
            }
        }
    } else {
        layoutContainer.style.width = layoutWidth + "px";
        if (boolSingleValue) {
            layoutContainer.style.maxWidth = layoutWidth + "px";
            layoutContainer.style.width = "unset";
        }
    }

    element.style.width = usenodeBounds.width + "px";
    if (borderElement) borderElement.style.width = usenodeBounds.width + "px";
    valueMaxW = layoutWidth;
    labelMaxW = layoutWidth;
    if (this.valueAlignment.itemBased != "true" && this.data.seriesLength != 1) {
        const vLayoutName = this.valuelayoutClassName("containervalueoverwrite");
        element.classList.add(vLayoutName);
        this.doAddTopValue(element, argprops);
    }
    if (this.data.seriesLength == 1) {
        let layoutWidth = layoutContainer.clientWidth;
        let usenodeWidth = usenodeBounds.width;
        let dividerWidth = 0;
        if (this.voData.voLayout.dividerType == "type2") {
            dividerWidth = levelFinder.clientWidth;
        }
        element.parentNode.dataset.singlewidth = layoutWidth + usenodeWidth + dividerWidth;
    }
};

SimpleFillCompareSeriesItem.prototype.doAddTopValue = function (argparent, argprops, boolmax) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    this.valueStyle = !this.data.layout.valueInset ? this.ChartFonts.appendgraphicColor(groupindex) : this.ChartFonts.valueInnerColor;
    this.valueStyle = this.getColorDetails(groupindex, this.valueStyle, this.data.layout.valueColor, "color");
    let padding = this.setoverlapPadding("value");
    const vLayoutName = this.valuelayoutClassName("value");
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + groupindex + "_" + index;
    element.style.minHeight = 10 + "px";
    // element.style.height = valueMaxH + "px";
    if (this.data.seriesLength > 1) element.style.width = valueMaxW + "px";
    element.style.maxWidth = valueMaxW + "px";
    element.style.maxHeight = valueMaxH + "px";
    element.style.order = this.valueAlignment.index;
    element.className = "value topvalue overflow " + vLayoutName + " " + this.ChartFonts.graphicColor(groupindex); //" accent" + (groupindex + 1) + "-color";
    if (this.valueAlignment.position == "middle") element.classList.add("middleposition");
    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.data.layout.valuePaddingClass && groupindex == 0) {
        element.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.data.layout.valueAlterPaddingClass && groupindex == 1) {
        element.classList.add(this.data.layout.valueAlterPaddingClass);
    }
    if (this.data.seriesLength == 1 && !this.data.layout.haddivider && padding["bottom"] == 0) {
        element.style.paddingBottom = padding["bottom"] == 0 ? "15PX" : padding["bottom"] + "px";
    }
    if (this.data.layout.labelItemBased != "true" && this.valueAlignment.position == "inner") {
        element.style.position = "absolute";
    }

    if (this.labelAlignment.itemBased == "true" || this.placeholderAlignment.itemBased == "true") {
        if (this.valueAlignment.itemBased != "true" && this.valueAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
    }

    const subelement = document.createElement("div");

    subelement.id = "valuetext-" + groupindex + "_" + index;

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;
    subelement.className = "valuetext " + colorTabValueCustomClass + " moodanimation " + this.valueStyle + " " + this.data.ChartFonts.valueThemeClassName;
    subelement.innerText = this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index];
    // if(this.data.suffix[this.groupindex][this.index]==""){
    //     if(this.data.displayValueFormat!="number")subelement.innerText = this.data.prefix[this.groupindex][this.index] + parseFloat(argprops.value)+"%"
    // }
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    }
    let dummeyMaxWidth = valueMaxW;
    if (this.data.layout.haddivider && this.data.seriesLength > 1) {
        dummeyMaxWidth = valueMaxW - (padding["left"] + padding["right"]);
    }
    subelement.dataset.defalutPercentage = "true";
    subelement.style.maxWidth = dummeyMaxWidth + "px";
    subelement.style.maxHeight = valueMaxH + "px";
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + index];
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", groupindex + "_" + index);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-graphic-y", graphicH);
    subelement.dataset.animation = "secondarytext";
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    element.appendChild(subelement);
    if (this.voData.voLayout.valuetextbgcallout == "true") {
        if (this.groupindex == 0) {
            element.style.marginRight = "40PX";
            element.style.marginLeft = "unset";
        } else {
            element.style.marginLeft = "40PX";
            element.style.marginRight = "unset";
        }
    }
    if (this.valueAlignment.textbg == "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            if (this.valueAlignment.vposition == "bottom") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            } else if (this.valueAlignment.vposition == "top") {
                element.style.paddingTop = padding["top"] + 15 + "px";
                element.style.paddingBottom = padding["bottom"] + 15 + "px";
            }
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.vposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);

    if (argparent) argparent.appendChild(element);
    else return element;
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
        // subelement.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if (this.data.valueTextColor[this.groupindex][this.index]) {
        subelement.style.setProperty("color", this.data.valueTextColor[this.groupindex][this.index], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSize(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.minValueFontSize[this.arrIndex], this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    if (boolmax) {
        this.maxValueH = element.clientHeight;
        argparent.removeChild(element);
    } else {
        subelement.style.maxWidth = element.clientWidth + "px";
        this.ChartUtils.createSpanFormat(subelement, this.data);
        subelement.style.overflow = "hidden";
    }
};

SimpleFillCompareSeriesItem.prototype.doAddLabel = function (argparent, argprops, boolMax = false) {
    if (this.data.layout.showLabel) {
        let padding = this.setoverlapPadding("label");
        let lLayoutName = this.labellayoutClassName("label");
        let element = document.createElement("div");
        element.className = "minheightvalue label moodanimation " + this.ChartFonts.dynamiclabelThemeClassName(this.groupindex) + " " + lLayoutName;
        element.id = "label-text-" + this.groupindex;
        element.setAttribute("data-graphic-y", graphicH);
        element.style.minHeight = 10 + "px";
        if (this.data.seriesLength > 1) element.style.width = labelMaxW + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labeMaxH + "px";
        element.setAttribute("data-textalign", "vertical");
        element.dataset.animation = "primarytext";
        element.style.order = this.labelAlignment.index;
        element.style.paddingLeft = padding["left"] + "px";
        element.style.paddingRight = padding["right"] + "px";
        element.style.paddingTop = padding["top"] + "px";
        // element.style.fontSize = this.maxLabelFontSize[this.index]+"px";
        if (this.data.arrLabelTextSize[this.index]) element.style.fontSize = this.data.arrLabelTextSize[this.index];
        element.style.paddingBottom = padding["bottom"] + "px";
        if (this.data.layout.labelalterpos == "true" && this.groupindex != 0) {
            element.style.paddingRight = "0px";
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }

        // if (this.graphicElement.alterpos == "true") {
        if (this.labelAlignment.itemBased != "true" && this.labelAlignment.position != "inner") {
            if (this.groupindex == 0) {
                element.style.marginLeft = "auto";
            } else {
                element.style.marginRight = "auto";
            }
        }
        labelMaxW = labelMaxW - (padding["right"] + padding["left"]);
        if (this.data.seriesLength > 1) element.style.width = labelMaxW + "px";
        element.style.maxWidth = labelMaxW + "px";

        if (this.data.layout.haddivider && this.voData.voLayout.dividerType == "type1") {
            element.style.paddingTop = padding["top"] + 4 + "px";
        }
        // }
        if (this.labelAlignment.position == "middle") element.classList.add("middleposition");
        if (argparent) argparent.appendChild(element);
        else return element;
        // this.labelStyle = this.ChartFonts.labelOuterColor;
        let labelColor = this.getColorDetails(this.groupindex, this.ChartFonts.labelOuterColor, this.data.layout.labelColor, "color");
        this.labelStyle = labelColor ? labelColor : this.labelStyle;
        let subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupindex;
        if (this.data.arrLabelOpacity[this.groupindex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupindex], "");
        if (this.data.arrLabeltexttransform[this.groupindex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupindex], "");
        subelement.innerHTML = boolMax ? this.data.longLabel : this.data.labels[this.groupindex];
        subelement.style.fontSize = this.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.maxHeight = labeMaxH + "px";
        subelement.setAttribute("maxFontSize", this.ChartFonts.maxLabelFontSize(element));
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupindex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.dataset.themeClass = this.ChartFonts.dynamiclabelThemeClassName(this.groupindex);
        if (this.data._labelTextColor[this.groupindex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupindex], "important");
        }
        if (this.data.layout.boollabelbgShape) {
            subelement.style.padding = "10px";
            this.labelbgProperties(subelement);
        }
        if (this.data.layout.labelshadow == "true") {
            let clsItemStyle = this.labelStyle.includes("Accent") ? this.labelStyle : this.ChartFonts.graphicColor(this.groupindex);
            let clsSendaryStyle = this.ChartFonts.labelOuterColor;
            let colorStyle = this.data.layout.labelTextShdowColor == "item" || this.data.layout.labelTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.groupindex, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.labelShadowClass) subelement.classList.add(this.data.layout.labelShadowClass);
            // subelement.style.textShadow = this.data.layout.labelTextShadow + " " + rgbaValue;
        }
        element.appendChild(subelement);
        if (this.labelAlignment.textbg == "true") {
            subelement.classList.add("textbg" + this.labelAlignment.textbgstyle);
            if (this.labelAlignment.textbgcallout == "true") {
                subelement.style.position = "relative";
                if (this.labelAlignment.vposition == "bottom") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                } else if (this.labelAlignment.vposition == "top") {
                    element.style.paddingTop = padding["top"] + 15 + "px";
                    element.style.paddingBottom = padding["bottom"] + 15 + "px";
                }
                subelement.classList.add("textbgcallout" + this.labelAlignment.vposition);
            }
        }
        if (!boolMax) this.ChartHelper.setTextChangeListner(subelement);
        if (this.voData.voLayout.valuetextbgcallout == "true") {
            if (this.groupindex == 0) {
                element.style.marginRight = "40PX";
                element.style.marginLeft = "unset";
            } else {
                element.style.marginLeft = "40PX";
                element.style.marginRight = "unset";
            }
        }
        if (this.data.labelLineHeight[this.groupindex]) {
            subelement.style.lineHeight = this.data.labelLineHeight[this.groupindex];
        }
        if (this.data.labelLetterSpace[this.groupindex]) {
            subelement.style.letterSpacing = this.data.labelLetterSpace[this.groupindex] + "em";
        }
        this.ChartHelper.adjustFontSize(subelement, 10, this.ChartFonts.maxLabelFontSize(element) - this.ChartFonts.minFontSize, this.ChartFonts.maxLabelFontSize(element));
        if (!boolMax) this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (boolMax) {
            this.maxLabelH = element.clientHeight;
            argparent.removeChild(element);
        }
    }
};

SimpleFillCompareSeriesItem.prototype.cretaeSvgCallout = function (container, slide) {
    let bounds = { width: container.clientWidth, height: container.clientHeight };
    let point1, point2, point3, point4, point5, point6, point7, point8;
    let d;

    let calloutRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(calloutRect, {
        width: bounds.width - 38.5,
        height: bounds.height - 10,
        "fill-opacity": 0,
        class: "background-fill " + this.data.ChartFonts.appendgraphicStrokeColor(this.groupindex),
        rx: 10,
        ry: 10,
    });

    if (slide == "left") {
        point1 = { x: bounds.width - 40, y: bounds.height / 2 + 30 };
        point2 = { x: bounds.width, y: bounds.height / 2 - 70 };
        point3 = { x: bounds.width - 40, y: bounds.height / 2 - 30 };

        d = "M" + point1.x + " " + point1.y;
        d = d + "L" + point2.x + " " + point2.y;
        d = d + "L" + point3.x + " " + point3.y;
    }
    if (slide == "right") {
        point1 = { x: 40, y: bounds.height / 2 + 30 };
        point2 = { x: 0, y: bounds.height / 2 - 70 };
        point3 = { x: 40, y: bounds.height / 2 - 30 };

        d = "M" + point1.x + " " + point1.y;
        d = d + "L" + point2.x + " " + point2.y;
        d = d + "L" + point3.x + " " + point3.y;
        this.data.SVGUtils.assignAttributes(calloutRect, {
            x: 38.5,
        });
    }

    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSvg, {
        class: "calloutBaseSvg",
    });
    let path = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(path, {
        d: d,
        class: "background-fill " + this.data.ChartFonts.appendgraphicStrokeColor(this.groupindex),
    });
    baseSvg.appendChild(calloutRect);
    baseSvg.appendChild(path);
    container.appendChild(baseSvg);
    let svgHighlight = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgHighlight, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        id: "calloutGroup",
    });
    baseSvg.append(svgHighlight);
    this.createDropShadow(svgHighlight);
    // this.data.SVGUtils.assignAttributes(path, {
    //     filter: "url(#dropshadow)",
    // });
    // this.data.SVGUtils.assignAttributes(calloutRect, {
    //     filter: "url(#dropshadow)",
    // });
};

SimpleFillCompareSeriesItem.prototype.createDropShadow = function (svgElement) {
    let defsTag = null;
    let filterDy = 5;
    let filterDx = 5;
    defsTag = this.data.SVGUtils.createSVGElement("defs");
    let filterTag = this.data.SVGUtils.createSVGElement("filter");
    this.data.SVGUtils.assignAttributes(filterTag, {
        id: "dropshadow",
        x: "0",
        y: "0",
        filterUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(filterTag);
    let feOffsetTag = this.data.SVGUtils.createSVGElement("fegaussianblur");
    this.data.SVGUtils.assignAttributes(feOffsetTag, {
        in: "SourceGraphic",
        dx: filterDx,
        dy: filterDy,
        result: "offOut",
    });
    filterTag.appendChild(feOffsetTag);
    let feDropShadowTag = this.data.SVGUtils.createSVGElement("feDropShadow");
    this.data.SVGUtils.assignAttributes(feDropShadowTag, {
        class: "item1",
        stdDeviation: "10",
        "flood-opacity": "0.8",
        in: "SourceGraphic",
    });
    filterTag.appendChild(feDropShadowTag);
    let feBlendTag = this.data.SVGUtils.createSVGElement("feBlend");
    this.data.SVGUtils.assignAttributes(feBlendTag, {
        in: "SourceGraphic",
        in2: "blurOut",
        mode: "normal",
    });
    svgElement.appendChild(defsTag);
};

function SimpleFillNativeShapeChart(argparent, argprops){
    this.index = argprops.index;
    this.name = "SimpleFillNativeShapeChart";
    BaseColumnChart.call(this,argparent, argprops);
}
SimpleFillNativeShapeChart.prototype = Object.create(BaseColumnChart.prototype);
SimpleFillNativeShapeChart.prototype.constructor = SimpleFillNativeShapeChart;

SimpleFillNativeShapeChart.prototype.seriesInstance=function(argparent, argprops) {
    return new window["SimpleFillNativeShapeSeries"](argparent, argprops);
}
SimpleFillNativeShapeChart.prototype.CreateHightlightDifference = function () {
    return null;
}
function SimpleFillNativeShapeSeries(argparent, argprops) {
    this.name = "SimpleFillNativeShapeSeries";
    BaseColumnSeries.call(this, argparent, argprops);
}
SimpleFillNativeShapeSeries.prototype = Object.create(BaseColumnSeries.prototype);
SimpleFillNativeShapeSeries.prototype.constructor = SimpleFillNativeShapeSeries;

SimpleFillNativeShapeSeries.prototype.doAddGraphicElement = function (argprops) {
    let moveX = this.viewport.x;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    const element = document.createElement("div");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.className = "series" + " series" + this.graphicElement.hpositionn + " accent" + customColorIndex + " clsMultiColorParent";
    element.style.width = this.state.width + "px";
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    if (this.parent) this.parent.appendChild(element);
    if (this.voData.arrHyperlinkUrl[this.index]) {
        element.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.index]);
    }
    if (this.data.layout.itemSpace) {
        this.parent.style.justifyContent = "space-between";
    }
    if (this.displayPrimaryPlaceholder() && this.placeholderAlignment.position == "outer" && this.placeholderAlignment.vposition == "bottom" && this.placeholderAlignment.itemBased != "true") {
        this.addplaceholder = true;
        const eprops = {
            index: this.index,
            length: this.length,
            placeholdertype: this.data.primaryPlaceholderType[this.index],
            placeholder: this.data.placeholder,
            placeholderpath: this.data.placeholderpath,
        };
        this.doAddPrimaryPlaceholder(element, eprops);
    }

    this.gapPercentage = 1;

    const subelement = document.createElement("div");
    subelement.id = "seriesitemcond-" + this.index;
    subelement.className = "seriesitemcond fillLevelFinder" + " item" + this.graphicElement.hposition;
    subelement.style.width = this.gapPercentage * 100 + "%";
    subelement.style.position = "relative";
    subelement.style.alignItems = "center";
    subelement.style.justifyContent = "unset  ";
    subelement.style.order = 2;
    // subelement.style.height = this.rectSeriesItem.height + "px"
    subelement.setAttribute("data-width", this.state.width * this.gapPercentage);
    subelement.setAttribute("data-height", this.rectSeriesItem.height);

    if (element) element.appendChild(subelement);

    for (let i1 = 0; i1 < 1; i1++) {
        if (this.index == 0) {
            subelement.classList.add("flexdirrevers");
        } else {
            subelement.classList.add("flexdirforward");
        }
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        const seriesItem = this.seriesItemInstance(subelement, eProps);
        seriesItem.ChartHelper = this.ChartHelper;
        seriesItem.ChartUtils = this.ChartUtils;
        seriesItem.move(moveX, this.rectSeriesItem.y);
        seriesItem.size(this.rectSeriesItem.width, this.rectSeriesItem.height);
        seriesItem.data = this.data;
        this.items[i1] = seriesItem;
        moveX += this.rectSeriesItem.width;
    }
};

SimpleFillNativeShapeSeries.prototype.updateBasicData = function () {
    BaseColumnSeries.prototype.updateBasicData.call(this);
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") this.gapPercentage = this.data.layout.itemgap ? this.data.layout.itemgap : 0.7;
};

SimpleFillNativeShapeSeries.prototype.seriesItemInstance = function (argparent, argprops) {
    return new window["SimpleFillNativeShapeSeriesItem"](argparent, argprops);
};

function SimpleFillNativeShapeSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    this.levefinderWidth = 0;
    this.labelMaxW = 230;
    this.labeMaxH = 90;
    this.valueMaxW = 0;
    this.valueMaxH = 0;
    this.graphicH = 0;
    this.padding = 8;
    this.graphicHeightPercentage = 0;
    this.maxHeightPercentage = 0.8;
    this.parentHeight = 0;
    this.graphicTop = 0;
    this.minValueFontSize = [25, 25];
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleFillNativeShapeSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleFillNativeShapeSeriesItem.prototype.constructor = SimpleFillNativeShapeSeriesItem;

SimpleFillNativeShapeSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.gapPercentage = 1;
    this.graphicElement = { alterPos: this.data.layout.graphicalterpos }; //alterPos : "true"
    this.thicknessPercentage = this.data.layout.itemthickness ? this.data.layout.itemthickness : 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : [42, 42];
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    if (this.data.layout.itemalterpos == "true" && this.data.layout.itemHPosition) {
        this.data.layout.itemHPosition = this.data.layout.itemHPosition == "left" ? "right" : "left";
    }
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;

    if (this.data.layout.labelalterpos == "true" && this.data.layout.labelHPosition != "center") {
        this.data.layout.labelHPosition = this.data.layout.labelHPosition == "left" ? "right" : "left";
        this.data.layout.labelPaddingleft = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingright : this.data.layout.labelPaddingleft;
        this.data.layout.labelPaddingright = this.data.layout.labelHPosition == "left" ? this.data.layout.labelPaddingleft : this.data.layout.labelPaddingright;
    }
    if (this.data.layout.valuealterpos == "true" && this.data.layout.valueHPosition != "center") {
        this.data.layout.valueHPosition = this.data.layout.valueHPosition == "left" ? "right" : "left";
        this.data.layout.valuePaddingleft = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingright : this.data.layout.valuePaddingleft;
        this.data.layout.valuePaddingright = this.data.layout.valueHPosition == "left" ? this.data.layout.valuePaddingleft : this.data.layout.valuePaddingright;
    }
    if (this.data.layout.placeholderalterpos == "true" && this.data.layout.placeholderHPosition != "center") {
        this.data.layout.placeholderHPosition = this.data.layout.placeholderHPosition == "left" ? "right" : "left";
        this.data.layout.placeholderPaddingleft = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingright : this.data.layout.placeholderPaddingleft;
        this.data.layout.placeholderPaddingright = this.data.layout.placeholderHPosition == "left" ? this.data.layout.placeholderPaddingleft : this.data.layout.placeholderPaddingright;
    }

    this.graphicElement = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.itemHPosition,
        vposition: this.data.layout.itemVPosition,
        alterpos: this.data.layout.itemalterpos,
    });

    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        this.labelMaxW = this.state.width * 0.7;
        this.labeMaxH = this.state.height * 0.5 - 8;
    } else {
        this.labelMaxW = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.3 * this.thicknessPercentage;
        this.labeMaxH = this.state.height * 0.5 - 8;
    }
    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });

    if (this.voData.voLayout.valuetextbgcallout == "true") {
        this.valueMaxW = this.state.width * this.gapPercentage * 0.4;
        this.valueMaxH = this.state.height * 0.3;
    } else {
        this.valueMaxW = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.5 * this.thicknessPercentage;
        this.valueMaxH = this.state.height * 0.3;
    }
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        textbgstyle: this.data.layout.placeholdertextbgstyle,
        textbgcallout: this.data.layout.placeholdertextbgcallout,
        textbgitem: this.data.layout.placeholdertextbgItem,
    });

    this.style = this.ChartHelper.getStylesdata(this.data.data);

    // if (this.graphicElement.alterpos == "true") {
    //     if (this.labelAlignment.itemBased == "true") this.valueMaxW = (this.state.width * this.gapPercentage) * 0.5;
    //     if (this.valueAlignment.itemBased == "true") this.labelMaxW = (this.state.width * this.gapPercentage) * 0.5;
    // }
    if (this.voData.voLayout.dividerType == "type2") {
        this.levefinderWidth = this.state.width * this.gapPercentage * 0.06;
    }
};

SimpleFillNativeShapeSeriesItem.prototype.doAddGraphicElement = function () {
    // this.data.values[this.groupindex][this.index] = this.data.values[this.groupindex][this.index] > 100 ? 100 : this.data.values[this.groupindex][this.index];
    // this.data.valuesDenomination[this.groupindex][this.index] = parseFloat(this.data.valuesDenomination[this.groupindex][this.index]) > 100 ? 100 : this.data.valuesDenomination[this.groupindex][this.index];
    if (this.data.boolPercentageChart) {
        this.data.valuesDenomination[this.groupindex][this.index] = parseInt(this.data.values[this.groupindex][this.index]);
    }
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { x: 0, y: 0, width: this.state.width, height: this.state.height },
    };

    const numParentWidth = this.parent.getAttribute("data-width") / this.length;

    // this.doAddbackgroundContainer(element,eProps);
    this.doAddTopSeriesItemElement(this.parent, eProps);
};

SimpleFillNativeShapeSeriesItem.prototype.doAddTopSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    const numMultpleFactor = this.state.height / argprops.totalvalue;
    const numTopHeight = argprops.maxvalue * numMultpleFactor;
    const parentWidth = argparent.getAttribute("data-width");

    if (-1 < argprops.value) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numTopHeight },
        };

        // ((this.state.width*this.gapPercentage)-(((this.state.width*this.gapPercentage) * 0.5)*this.thicknessPercentage))+"PX";
        let layoutContainer = this.ChartHelper.createDivElement({});
        layoutContainer.className = "layoutContainer";
        layoutContainer.style.width = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.3 * this.thicknessPercentage - this.levefinderWidth + "px";
        layoutContainer.style.height = "300px";
        layoutContainer.style.position = "relative";

        if (this.data.voLayout.valuetextbgstyle) {
            layoutContainer.classList.add(this.data.voLayout.valuetextbgstyle);
        }

        this.doAddTopGraphicsContainer(argparent, eprops, layoutContainer);

        argparent.appendChild(layoutContainer);

        this.doAddTopValue(layoutContainer, eprops, false, false);
        // let value = layoutContainer.children[0].children[0];
        // let FontSiz =  parseFloat(window.getComputedStyle(value)["font-size"]);
        // if(value){
        //     value.style.fontSize = "40px";
        // }
        this.doAddLabel(layoutContainer, eprops);

        if (this.data.layout.haddivider) {
            let side = groupindex == "0" ? "left" : "right";
            if (this.voData.voLayout.valuetextbgcallout == "true") {
                this.cretaeSvgCallout(layoutContainer, side);
                layoutContainer.style.alignItem = "center";
            } else {
                let valueContainer = layoutContainer.querySelector(".value");
                let labelContainer = layoutContainer.querySelector(".label");
                let levelFinder = argparent.querySelector("#levelfinder");
                let labelpadding = this.setoverlapPadding("label");
                let valuepadding = this.setoverlapPadding("value");
                let levelFinderTop = levelFinder ? parseFloat(window.getComputedStyle(levelFinder)["top"]) : 0;
                let labelHeight = labelContainer.clientHeight;
                valueContainer.style.maxHeight = this.valueHeight + "px";
                layoutContainer.style.height = "auto";
                let valueHeight = parseFloat(valueContainer.children[0].clientHeight) + valuepadding["top"] + valuepadding["bottom"];
                let labelPosition = 0;
                if (this.voData.voLayout.dividerType == "type1") {
                    layoutContainer.style.top = levelFinderTop - valueHeight + "px";
                } else {
                    layoutContainer.style.top = levelFinderTop - valueHeight / 2 + "px";
                    layoutContainer.style.width = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.3 * this.thicknessPercentage - this.levefinderWidth + "px";
                }

                if (this.voData.voLayout.dividerType == "type2") {
                    if (this.data.values[this.groupindex][this.index] < 50) {
                        let BottomGap = this.state.height - (levelFinderTop + valueHeight / 2);
                        if (BottomGap < labelContainer.clientHeight || BottomGap < valueHeight + 5) {
                            layoutContainer.appendChild(valueContainer);
                            layoutContainer.style.top = levelFinderTop - valueHeight / 2 - labelContainer.clientHeight + "px";
                            valueContainer.style.paddingTop = valuepadding["bottom"] + "px";
                            labelContainer.style.paddingTop = labelpadding["bottom"] + "px";
                            labelContainer.style.paddingBottom = labelpadding["top"] + "px";
                        }
                    }
                } else {
                    if (this.data.values[this.groupindex][this.index] > 50) {
                        let topGap = levelFinderTop;
                        if (topGap < valueHeight + 5) {
                            layoutContainer.style.top = levelFinderTop + 5 + "px";
                            labelContainer.style.paddingTop = labelpadding["top"] + "px";
                        }
                    } else {
                        if (this.data.values[this.groupindex][this.index] < 50) {
                            let BottomGap = this.state.height - levelFinderTop;
                            if (BottomGap < labelHeight + 5 || BottomGap < valueHeight + 5) {
                                layoutContainer.style.top = levelFinderTop - valueHeight - labelHeight + "px";
                                labelContainer.style.paddingTop = labelpadding["top"] + "px";
                            }
                        }
                    }
                }
                // if (side == "left") {
                //     layoutContainer.style.left = "0";
                //     valueContainer.style.justifyContent = "flex-end"
                //     labelContainer.style.textAlign = "right"
                // } else {
                //     layoutContainer.style.right = "0";
                //     valueContainer.style.justifyContent = "flex-start"
                //     labelContainer.style.textAlign = "left"
                // }
                layoutContainer.style.position = "absolute";
                this.graphicElement.alterpos == "true" && this.groupindex == 0 ? layoutContainer.classList.add("alterstylepos") : layoutContainer.classList.add("alterstylenoraml");
            }
        } else {
            layoutContainer.style.height = "100%";
            const vLayoutName = this.valuelayoutClassName("container");
            layoutContainer.classList.add(vLayoutName);
            layoutContainer.style.flexWrap = "unset";
            layoutContainer.style.flexDirection = "column";
        }
    }
};

SimpleFillNativeShapeSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, layoutContainer) {
    let divider = this.data.layout.haddivider;

    let element = this.ChartHelper.createDivElement({});
    (element.id = "base-graphic-" + argprops.gindex + "_" + argprops.index), (element.className = "basegraphic basetopgraphic chartgraphic");
    if (this.data.layout.dividerType == "type2") {
        element.style.width = 30 * this.thicknessPercentage + "%";
    } else {
        element.style.width = 50 * this.thicknessPercentage + "%";
    }
    element.style.justifyContent = "center";
    element.style.height = "100%";
    argparent.appendChild(element);

    //create base svg//

    let baseSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(baseSVG, {
        id: "itemplaceholder-" + argprops.gindex + "_" + argprops.index,
        class: "svgAsset",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "80%",
    });
    element.appendChild(baseSVG);

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    baseSVG.appendChild(defsTag);
    let maskId = this.data.slideID + Math.random() + "maskicon" + argprops.gindex;

    let svgMask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(svgMask, {
        id: maskId,
        "data-maskelement": "true",
        fill: "#fff",
    });
    defsTag.appendChild(svgMask);
    this.parentHeight = argparent.getAttribute("data-height") * this.maxHeightPercentage;
    let totalValue = 100;
    if (this.data._rangePositive > 100) {
        totalValue = this.data._rangePositive;
    }
    this.graphicHeightPercentage = this.parentHeight * (argprops.value / totalValue);
    this.graphicH = this.graphicHeightPercentage;
    // layoutContainer.style.top = (this.parentHeight - this.graphicHeightPercentage) + "px";
    let graphicContainerSVG = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(graphicContainerSVG, {
        id: "graphic-container-" + argprops.gindex,
        class: "graphic-container ",
        x: 0,
        y: this.parentHeight - this.graphicHeightPercentage + "px",
        width: baseSVG.clientWidth,
        height: this.graphicHeightPercentage + "px",
    });
    svgMask.appendChild(graphicContainerSVG);

    if (divider) {
        let levelFinder = this.ChartHelper.createDivElement({});
        (levelFinder.id = "levelfinder"), levelFinder.classList.add("levelfinder");
        levelFinder.classList.add("moodanimation"), levelFinder.setAttribute("data-graphic-y", this.graphicH);
        levelFinder.style.position = "absolute";
        if (this.voData.voLayout.dividerType == "type1") {
            levelFinder.style.width = "75%";
        } else {
            levelFinder.style.width = this.levefinderWidth + "px";
            this.valueMaxW = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.4 * this.thicknessPercentage - this.levefinderWidth;
            this.labelMaxW = this.state.width * this.gapPercentage - this.state.width * this.gapPercentage * 0.4 * this.thicknessPercentage - this.levefinderWidth;
        }
        levelFinder.style.height = "0px";
        levelFinder.dataset.animation = "levelfinder";

        let topValue = this.parentHeight - this.graphicHeightPercentage;
        let itembase = true;
        if (itembase) {
            this.graphicTop = (this.state.height - this.parentHeight) / 2 + this.parentHeight;
            levelFinder.style.top = this.graphicTop - this.graphicHeightPercentage + "px";
            if (this.data.values[this.groupindex][this.index] == 0) {
                levelFinder.style.top = this.graphicTop - this.graphicHeightPercentage - 4 + "px";
            }
        }

        if (this.data.layout.dividerStyle == "outline") {
            levelFinder.style.height = "2px";
        }
        if (this.data.layout.dividerStyle == "dashed") {
            levelFinder.style.border = "2px dashed";
        } else {
            if (this.data.layout.dividerStyle == "dotted") {
                levelFinder.style.border = "2px dotted";
            } else {
                levelFinder.style.border = "2px solid";
            }
        }
        if (this.data.layout.dividerColor != "item" && this.data.layout.dividerColor != "theme") {
            levelFinder.classList.add("secondary-border-color");
        } else {
            // if (argprops.gindex == 0) {
            levelFinder.classList.add(this.data.ChartFonts.appendgraphicBorderColor(argprops.gindex));
            // } else {
            //     levelFinder.classList.add("accent" + (3 + 1) + "-border-color");
            // }
        }
        levelFinder.dataset.customopacity = 0.5;
        if (this.voData.voLayout.dividerType == "type1") {
            if (this.data._directionenable) {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.right = "0%";
                } else {
                    levelFinder.style.right = "24%";
                }
            } else {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.left = "0%";
                } else {
                    levelFinder.style.left = "24%";
                }
            }
        } else {
            if (this.data._directionenable) {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.left = 30 * this.thicknessPercentage + 0.8 + "%";
                } else {
                    levelFinder.style.right = 30 * this.thicknessPercentage + 0.8 + "%";
                }
            } else {
                if (this.graphicElement.alterpos == "true" && argprops.gindex == 0) {
                    levelFinder.style.right = 30 * this.thicknessPercentage + 0.8 + "%";
                } else {
                    levelFinder.style.left = 30 * this.thicknessPercentage + 0.8 + "%";
                }
            }
        }
        argparent.appendChild(levelFinder);
    }
    let svgGrapicsRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgGrapicsRect, {
        id: "graphic-" + argprops.gindex,
        "data-animation": "item",
        class: "moodanimation transformOrginBottom ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    svgGrapicsRect.dataset.customorgin = "bottom";
    graphicContainerSVG.appendChild(svgGrapicsRect);
    let bgStrokeColor = this.data.layout.backgroundBorder && this.data.layout.backgroundBorder.color ? this.data.layout.backgroundBorder.color : "";
    let svgBgUseNode = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgBgUseNode, {
        id: "itemplaceholder-" + argprops.gindex,
        width: "98%",
        height: "99%",
        x: "1%",
        y: "0.5%",
        "stroke-width": this.data.layout.backgroundBorder && this.data.layout.backgroundBorder.width ? this.data.layout.backgroundBorder.width + "px" : "2px",
        class:
            this.getBgFillDetails(argprops.gindex, this.data.ChartFonts.appendgraphicStrokeColor(argprops.gindex), bgStrokeColor, "stroke") +
            " " +
            this.getBgFillDetails(argprops.gindex, this.data.ChartFonts.appendgraphicFillColor(argprops.gindex), this.data.layout.backgroundColor, "bgcolor") +
            " transformOrginTop moodanimation",
        "fill-opacity": this.data.layout.backgroundOpacity,
        "data-animation": "itembackground",
    });
    svgBgUseNode.dataset.customorgin = "top";
    baseSVG.appendChild(svgBgUseNode);

    let svgUseNode = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(svgUseNode, {
        id: "itemplaceholder-" + argprops.gindex,
        width: "100%",
        height: "100%",
        "data-mask": "true",
        class: this.getBgFillDetails(argprops.gindex, this.data.ChartFonts.graphicFillColor(argprops.gindex), this.data.layout.itemColor, "bgcolor") + " " + this.data.ChartFonts.appendgraphicStrokeColor(argprops.gindex),
        mask: "url(#" + maskId + ")",
    });
    baseSVG.appendChild(svgUseNode);

    if (this.data.layout.itemColor == "gradient") {
        this.addGradient(svgUseNode, baseSVG, true, false);
        this.addGradient(svgBgUseNode, baseSVG, false, true);
    }
    if (this.data.layout.borderRadiusClass) {
        this.changeBorderRadius(svgGrapicsRect, baseSVG);
        this.changeBorderRadius(svgBgUseNode, baseSVG);
    }

    if (argprops.gindex == 0) {
    } else {
        this.data.SVGUtils.assignAttributes(svgUseNode, {
            x: "0%",
        });
        this.data.SVGUtils.assignAttributes(svgBgUseNode, {
            x: "1%",
        });
    }
    if (this.data.layout.itemBgborderstyle == "dashed") {
        this.data.SVGUtils.assignAttributes(svgBgUseNode, {
            "stroke-dasharray": "5,5",
        });
    }
};
SimpleFillNativeShapeSeriesItem.prototype.changeBorderRadius = function (GrapicsRect, svgElement) {
    let dummeyLineShape = this.data.SVGUtils.createSVGElement("rect");
    let emptySvgNode = this.data.SVGUtils.createEmptySvgNode();
    emptySvgNode.appendChild(dummeyLineShape);
    svgElement.appendChild(emptySvgNode);
    dummeyLineShape.setAttribute("class", this.data.layout.borderRadiusClass);
    let bounds = window.getComputedStyle(dummeyLineShape) && window.getComputedStyle(dummeyLineShape)["border-radius"] ? parseFloat(window.getComputedStyle(dummeyLineShape)["border-radius"]) : "";
    svgElement.removeChild(emptySvgNode);
    if (bounds) {
        let actualValue = bounds / 2;
        let graphicWidth = GrapicsRect.getBBox().width / 2;
        GrapicsRect.style.rx = graphicWidth > bounds ? bounds + "px" : graphicWidth + "px";
    }
};

