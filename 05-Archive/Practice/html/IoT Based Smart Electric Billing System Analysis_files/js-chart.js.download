BaseBarSeries.prototype.doAddImageUseNodeElement = function (element, argprops, type = "img") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);

    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.src = this.data.primaryPlaceholderPath[this.index];
    subelement.style.position = "absolute";
    subelement.style.margin = "auto";
    subelement.style.left = "0";
    subelement.style.right = "0";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode clsMoodImageStyle";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    subelement.setAttribute("data-nodetype", "imageNode");
    element.appendChild(subelement);

    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    element.setAttribute("data-x", item.x);
    element.setAttribute("data-y", item.y);
    element.setAttribute("data-width", element.clientWidth);
    element.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-width", element.clientWidth);
    subelement.setAttribute("data-height", element.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);
    // if(type=="logo"){
    this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type);
    // }
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    // if ((this.data.hasEmphasis && this.data.emphasis[this.index] != true && this.data._emphasisName == "emphasize-grey")) {
    //     BgStyle = "var(--tertiary-color)";
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle)
    // }
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
    // if ((this.data.hasEmphasis && this.data.emphasis[this.index] == true && this.data._emphasisName == "emphasize-grey")) {
    //    BgStyle = "var(--item" + (this.index) + "-color)";
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle)
    // }
    // if ((this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor") && !this.data.shapeBorder) {
    //     element.style.position = "relative";
    //     this.ChartUtils.applyOverlayToImage(subelement, BgStyle)
    // }
};
BaseBarSeries.prototype.doAddLogoUseNodeElement = function (element, argprops, type = "logo") {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("imageBackground");
    nodeBgElement.setAttribute("data-nodetype", "imageBackground");
    element.appendChild(nodeBgElement);
    element.setAttribute("data-holder-type", "primary");
    element.setAttribute("data-node-content-type", "logo");
    let alignment = this.data.chartFlip ? "left" : "right";
    const subelement = document.createElement("img");
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.style.position = "absolute";
    subelement.style.margin = "auto";
    subelement.style.left = "0";
    subelement.style.right = "0";
    subelement.id = "primaryplaceholdergraphic-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic imageNode clsMoodImageStyle";
    subelement.setAttribute("data-placeholderelement", "icon,image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    subelement.setAttribute("data-imagecropalignment", alignment);
    subelement.setAttribute("data-nodetype", "imageNode");
    element.appendChild(subelement);

    if (type == "logo") {
        subelement.setAttribute("data-type", "logo");
        subelement.classList.add("logoBrightness");
        subelement.setAttribute("logocontrast", this.data.logoContrast[this.index]);
        if (this.data.logoContrast[this.index] == "false") {
            subelement.classList.add("logoBrightnessUnset");
        }
    }
    DiagramResizeUtils.updateDefaultImageData(subelement, "logo");
    subelement.src = this.data.primaryPlaceholderPath[this.index];
    //let item = this.ChartUtils.getOffsetLeftTop(element, "SLIDE", true);
    // element.setAttribute("data-x", item.x);
    // element.setAttribute("data-y", item.y);
    // element.setAttribute("data-width", element.clientWidth);
    // element.setAttribute("data-height", element.clientHeight);
    // subelement.setAttribute("data-width", element.clientWidth);
    // subelement.setAttribute("data-height", element.clientHeight);
    // subelement.setAttribute("data-x", item.x);
    // subelement.setAttribute("data-y", item.y);
    // if(type=="logo"){
    // this.ChartUtils.updateImageReSize(element.clientWidth, element.clientHeight, subelement, "", type);
    // }
    let BgStyle = "var(--item" + 1 + "-color)";
    if (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor" && !this.data.shapeBorder) {
        BgStyle = "var(--item" + 5 + "-color)";
    }
    let overLayDiv = this.ChartHelper.createDivElement({});
    overLayDiv.setAttribute("data-nodetype", "imageOverlay");
    overLayDiv.className = "shapeBgElement imageOverlay";
    element.appendChild(overLayDiv);
};
BaseBarSeries.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    let nodeBgElement = this.ChartHelper.createDivElement({});
    nodeBgElement.classList.add("shapeBgElement");
    nodeBgElement.classList.add("iconBackground");
    nodeBgElement.setAttribute("data-nodetype", "iconBackground");
    argparent.appendChild(nodeBgElement);

    let SVGUtils = new window["SVGUtils"]();
    const element = SVGUtils.createSVGElement("svg");
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode",
        "data-nodetype": "iconNode",
        id: "primaryplaceholdergraphic-" + this.index + "_0",
        "data-type": "ICON",
        width: "100%",
        height: "100%",
    });
    argparent.style.display = "flex";
    argparent.style.alignItems = "center";
    argparent.style.justifyContent = "center";

    let fillClass = this.ChartFonts.graphicFillColor(this.index);
    if (this.data.layout.placHolderBgColor == "theme" && this.data.layout.placHolderBorderColor != "gradient") {
        fillClass = "clsAlterTertiaryColor";
    } else {
        if (
            (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
            (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
        ) {
            fillClass = "clsTertiaryFill";
        }
    }
    SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond iconNode ",
    });
    console.log(this.data._primaryPlaceholderPathData[this.index]);
    const subelement = SVGUtils.createSVGElement("use");
    SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.index + "_0",
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "data-placeholderelement": "icon,image",
        "data-id": this.index + "_0",
        "data-type": "ICON",
        "data-name": this.data.primaryPlaceholderName[this.index],
        "data-iconpath": this.data._primaryPlaceholderPathData[this.index],
        "xlink:href": "#" + this.data.primaryPlaceholderName[this.index],
    });
    element.appendChild(subelement);
    argparent.appendChild(element);

    let overLayDiv = this.ChartHelper.createDivElement({});
    SVGUtils.assignAttributes(overLayDiv, {
        class: "shapeBgElement iconOverlay",
        "data-nodetype": "iconOverlay",
    });
    argparent.appendChild(overLayDiv);
};

BaseBarSeries.prototype.doAddSecondartPlaceholder = function (argparent, argprops) {
    const index = argprops.index;
    const bounds = this.getPlaceholderBounds();
    const element = this.ChartHelper.createDivElement({});
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    element.id = "primaryplaceholder-" + index;
    element.className = "primaryplaceholder topprimaryplaceholder moodanimation";
    element.setAttribute("data-animation", "primaryplaceholder");
    element.style.height = bounds.height + "px";
    element.style.minWidth = bounds.width + "px";
    element.style.width = bounds.width + "px";
    if (argparent) argparent.appendChild(element);
    else return element;
    let type = argprops.placeholdertype;
    switch (type) {
        case "icon":
            this.doAddIconUseNodeElement(element, argprops);
            break;
        case "image":
            this.doAddImageUseNodeElement(element, argprops);
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

BaseBarSeries.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment.show;
};
BaseBarSeries.prototype.changeFontFamily = function (subelement, labelThemeClassName, prevlabelThemeClassName) {
    let valueElements = this.data.chartName == "barStackedRectangle" ? this.parent.parentNode.parentNode.parentNode.querySelectorAll(".label") : this.parent.parentNode.parentNode.parentNode.querySelectorAll(".label");
    if (valueElements) {
        Array.from(valueElements).forEach(function (item) {
            item.classList.remove(prevlabelThemeClassName.trim());
            item.classList.add(labelThemeClassName);
        });
    }
};
BaseBarSeries.prototype.getPlaceholderBounds = function (props) {
    if (this.data.primaryPlaceholder) {
        if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
            return { width: this.state.height * 1, height: this.state.height * 1 };
        } else {
            return { width: this.state.height * 1, height: this.state.height * 1 };
        }
    } else {
        return { width: 0, height: this.state.height };
    }
};
BaseBarSeries.prototype.getLogoBounds = function (props) {
    let Width = 0;
    let Height = 0;
    if (this.data.primaryPlaceholder) {
        // if (this.data.layout.boolplaceholderShape && this.data.layout.placeHolderShapeType == "rect") {
        //     return { width: this.state.height *1, height: this.state.height * 1 };
        // } else {
        Height = this.state.height;
        Width = (this.state.height * 100) / 60;
        return { width: Width, height: Height };
        // }
    } else {
        return { width: 0, height: this.state.height };
    }
};

let objValue;
let graphicW;
let overlapStackedBar = false;
let dropShadowHeight = 0;
function BaseBarSeriesItem(argparent, argprops) {
    this.voData = null;
    this.graphicWidthValue = null;
    this.name = "BaseSeries";
    this.graphicWidth = 0;
    this.valuePosition = "middle";
    this.valueStyle = "outerColor1";
    this.placeholderPosition = "right";
    this.itemBasedPlaceHolderHeight = "";
    this.placeholderStyle = "item1";
    this.valueIndex = argprops.valueIndex;
    this.addlabel = argprops.addlabel;
    this.addvalue = argprops.addvalue;
    this.overlapnode = false;
    this.addplaceholder = argprops.addplaceholder;
    this.maxLabelW = 0;
    this.currentValW = 0;
    this.labelMaxW = 0;
    this.labelMaxH = 0;
    this.valueMaxW = 0;
    this.valueMaxH = 0;
    this.middleH = 0;
    this.maxLabelH = 0;
    this.maxValueH = 0;
    this.middleLW = 0;
    this.middleLH = 0;
    this.middleVW = 0;
    this.middleVH = 0;
    this.middlePW = 0;
    this.middlePH = 0;
    this.gapPercentage = argprops.gapPercentage;
    this.deafaultPercentage = false;
    this.placholderHPos = "";
    this.boolEnableInnerValue = false;
    this.valueOuterposition = false;
    this.valuePosInterchange = false;
    this.maxValueFontSize = [42, 42];
    this.minValueFontSize = [25, 25];
    this.ChartFonts = new window["ChartFonts"]();
    this.emphasisColor = this.ChartFonts.emphasizeColor;
    this.maxLabelFontSize = [24, 24];
    this.placeholderWidth = 0;
    this.statisticalWidth = 0;
    this.transformOrginValue = "transformOrginLeft";
    this.negativeTransformValue = "transformOrginRight";
    this.customOrginValue = "left";
    this.customNegativeOrginmValue = "right";
    this.labelOverlab = false;
    this.statisticalArrowStyle = "";
    BaseSeriesItem.call(this, argparent, argprops);
}

BaseBarSeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
BaseBarSeriesItem.prototype.constructor = BaseBarSeriesItem;
BaseBarSeriesItem.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};
BaseBarSeriesItem.prototype.updateBasicData = function () {
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    this.length = this.voData.seriesItemLength;
    this.maxLabelFontSize = this.data.layout.labelfontsize ? [this.data.layout.labelfontsize, this.data.layout.labelfontsize] : this.maxLabelFontSize;
    this.thicknessPercentage = this.data.layout.itemthickness && (this.data.seriesItemLength < 2 || this.data.compareDivider) ? this.data.layout.itemthickness : 1;
    if (this.data._customProperties.showMergeItems) this.thicknessPercentage = 1;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    if (this.data.chartFlip) {
        this.transformOrginValue = "transformOrginRight";
        this.negativeTransformValue = "transformOrginLeft";
        this.customOrginValue = "right";
        this.customNegativeOrginmValue = "left";
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.ChartFonts.maxValueFontSize;
    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") this.length = 1;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    this.labelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.labelHPosition,
        vposition: this.data.layout.labelVPosition,
        show: this.data.layout.showLabel,
        inset: this.data.layout.labelInset,
        index: this.data.layout.labelPosIndex,
        itemBased: this.data.layout.labelItemBased,
        samepos: this.data.layout.labelSamePos,
        textbg: this.data.layout.labeltextbg,
        textbgstyle: this.data.layout.labeltextbgstyle,
        textbgcallout: this.data.layout.labeltextbgcallout,
        textbgitem: this.data.layout.labeltextbgItem,
    });
    this.labelMaxW = this.data.chartName == "comparisonModelType3" ? this.state.width * 0.3 * 0.5 : this.state.width * 0.3;
    this.labelMaxH = this.data.chartName.includes("comparisonModel") && this.labelAlignment.hposition == "center" ? this.state.height : this.state.height * this.gapPercentage * this.thicknessPercentage;

    this.valueAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.valueHPosition,
        vposition: this.data.layout.valueVPosition,
        show: this.data.layout.showValue,
        inset: this.data.layout.valueInset,
        index: this.data.layout.valuePosIndex,
        itemBased: this.data.layout.valueItemBased,
        samepos: this.data.layout.valueSamePos,
        textbg: this.data.layout.valuetextbg,
        textbgstyle: this.data.layout.valuetextbgstyle,
        textbgcallout: this.data.layout.valuetextbgcallout,
        textbgitem: this.data.layout.valuetextbgItem,
    });
    this.valueMaxW = this.state.width * 0.2;

    this.statisticalAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.statisticalHPosition,
        vposition: this.data.layout.statisticalVPosition,
        show: this.data.layout.showstatistical,
        inset: this.data.layout.statisticalInset,
        index: this.data.layout.statisticalPosIndex,
        itemBased: this.data.layout.statisticalItemBased,
        samepos: this.data.layout.statisticalSamePos,
        textbg: this.data.layout.statisticaltextbg,
        textbgstyle: this.data.layout.statisticaltextbgstyle,
        textbgcallout: this.data.layout.statisticaltextbgcallout,
        textbgitem: this.data.layout.statisticaltextbgItem,
    });
    this.valueMaxH = this.valueAlignment.itemBased == "true" ? (this.state.height * 0.4) / this.length : (this.state.height * this.gapPercentage * this.thicknessPercentage) / this.length;
    if (this.data.chartName == "barStackedRectangle") {
        this.valueMaxH = (this.state.height * this.gapPercentage * this.thicknessPercentage) / 1;
    }
    if (this.valueAlignment.inset != "inside" && this.valueAlignment.itemBased != "true" && this.labelAlignment.itemBased != "true") {
        this.valueMaxH = this.valueAlignment.itemBased == "true" ? (this.state.height * 0.4) / this.length : this.state.height / this.length;
    }
    if (this.data.seriesItemLength > 1 && this.data.baseProperties == "bar" && this.data.promptText) {
        this.valueMaxH = 2 * this.valueMaxH;
    }
    if (this.data.promptText && this.data.chartName == "barStackedRectangle") {
        this.valueMaxW = this.state.width * 0.5;
    }
    this.placeholderAlignment = this.ChartHelper.getAlignData({
        hposition: this.data.layout.placeholderHPosition,
        vposition: this.data.layout.placeholderVPosition,
        show: this.data.layout.showPlaceholder,
        inset: this.data.layout.placeholderInset,
        index: this.data.layout.placeholderPosIndex,
        itemBased: this.data.layout.placeholderItemBased,
        samepos: this.data.layout.placeholderSamePos,
        textbg: this.data.layout.placeholdertextbg,
        padding: this.data.layout.placeholderPadding,
    });
    if (this.placeholderAlignment.position == "middle") {
        this.removeGrid();
        this.data.data.setAttribute("enablegrid", "false");
    } else {
        this.data.data.setAttribute("enablegrid", "");
    }
    this.style = this.ChartHelper.getStylesdata(this.data.data);
    this.secondaryLabelAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLabelHPosition,
        vposition: this.data.layout.secondaryLabelVPosition,
        show: this.data.layout.showsecondaryLabel,
        inset: this.data.layout.secondaryLabelInset,
        index: this.data.layout.secondaryLabelPosIndex,
        itemBased: this.data.layout.secondaryLabelItemBased,
        samepos: this.data.layout.secondaryLabelSamePos,
        textbg: this.data.layout.secondaryLabeltextbg,
        textbgstyle: this.data.layout.secondaryLabeltextbgstyle,
        textbgcallout: this.data.layout.secondaryLabeltextbgcallout,
        textbgitem: this.data.layout.secondaryLabeltextbgItem,
    });
    this.secondaryNumberAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryNumberHPosition,
        vposition: this.data.layout.secondaryNumberVPosition,
        show: this.data.layout.secondaryNumber,
        inset: this.data.layout.secondaryNumberInset,
        index: this.data.layout.secondaryNumberPosIndex,
        itemBased: this.data.layout.secondaryNumberItemBased,
        samepos: this.data.layout.secondaryNumberSamePos,
        textbg: this.data.layout.secondaryNumbertextbg,
        textbgstyle: this.data.layout.secondaryNumbertextbgstyle,
        textbgcallout: this.data.layout.secondaryNumbertextbgcallout,
        textbgitem: this.data.layout.secondaryNumbertextbgItem,
    });
    this.secondaryLogoAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondaryLogoHPosition,
        vposition: this.data.layout.secondaryLogoVPosition,
        show: this.data.layout.secondaryLogo,
        inset: this.data.layout.secondaryLogoInset,
        index: this.data.layout.secondaryLogoPosIndex,
        itemBased: this.data.layout.secondaryLogoItemBased,
        samepos: this.data.layout.secondaryLogoSamePos,
        textbg: this.data.layout.secondaryLogotextbg,
        textbgstyle: this.data.layout.secondaryLogotextbgstyle,
        textbgcallout: this.data.layout.secondaryLogotextbgcallout,
        textbgitem: this.data.layout.secondaryLogotextbgItem,
    });
    this.secondarySequenceAlignment = this.ChartHelper.getHorizantalAlignData({
        hposition: this.data.layout.secondarySquenceNumberHPosition,
        vposition: this.data.layout.secondarySquenceNumberVPosition,
        show: this.data.layout.secondarySquenceNumber,
        inset: this.data.layout.secondarySquenceNumberInset,
        index: this.data.layout.secondarySquenceNumberPosIndex,
        itemBased: this.data.layout.secondarySquenceNumberItemBased,
        samepos: this.data.layout.secondarySquenceNumberSamePos,
        textbg: this.data.layout.secondarySquenceNumbertextbg,
        textbgstyle: this.data.layout.secondarySquenceNumbertextbgstyle,
        textbgcallout: this.data.layout.secondarySquenceNumbertextbgcallout,
        textbgitem: this.data.layout.secondarySquenceNumbertextbgItem,
    });
    this.alignment = this.secondaryLabelAlignment;
    if (this.data.layout.secondaryElementType == "image") {
        this.alignment = this.secondaryLogoAlignment;
    }
    if (this.data.layout.secondaryElementType == "squencenumber") {
        this.alignment = this.secondarySequenceAlignment;
    }
    if (this.data.layout.secondaryElementType == "number") {
        this.alignment = this.secondaryNumberAlignment;
    }
    if (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true") {
        if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true" && this.data.layout.labelVPosition == this.data.layout.valueVPosition) {
            this.labelMaxH = this.valueMaxH = this.state.height * 0.6;
        } else {
            if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased == "true") this.labelMaxH = this.valueMaxH = this.state.height * 0.4;
            else {
                if (this.labelAlignment.itemBased == "true") {
                    this.labelMaxH = this.state.height * 0.4;
                    this.valueMaxH = this.state.height * 0.6;
                } else {
                    this.labelMaxH = this.state.height * 0.6;
                    this.valueMaxH = this.state.height * 0.4;
                }
                if (this.labelAlignment.itemBased == "true" && this.labelAlignment.vposition == "top" && this.labelAlignment.hposition == "left" && this.labelAlignment.inset == "outside") {
                    this.labelMaxH = this.state.height * 0.5;
                    this.valueMaxH = this.state.height * 0.4;
                }
            }
        }
    }
};

BaseBarSeriesItem.prototype.doMeasurementComputation = function () {};

BaseBarSeriesItem.prototype.doAddGraphicElement = function () {
    // let myIndex = this.data.chartName == "comparisonModelType3" ? this.valueIndex : this.groupindex;
    let eProps = {
        index: this.index,
        length: this.length,
        gindex: this.groupindex,
        totalvalue: this.data.rangeTotal,
        maxvalue: this.data.rangePositive,
        minvalue: this.data.rangeNegative,
        placeholder: this.data.primaryPlaceholder,
        placeholdertype: this.data.primaryPlaceholderType[this.groupindex],
        placeholdername: this.data.primaryPlaceholderName[this.groupindex],
        value: this.data.values[this.groupindex][this.index],
        valuetext: this.data.prefix[this.groupindex][this.index] + this.data.valuesDenomination[this.groupindex][this.index] + this.data.suffix[this.groupindex][this.index],
        viewport: { y: 0, x: 0, height: this.state.height, width: this.state.width },
    };
    if (this.groupindex == 0 && this.index == 0) {
        overlapStackedBar = false;
    }
    const stackWidth = this.data._stackedPercentage && this.data._boolPercentageChart ? eProps.value / 100 : eProps.value / this.data.stackSeriesvalueTotal[this.groupindex];
    const element = this.ChartHelper.createDivElement({});
    element.id = "baseseriesitem-" + this.index;
    element.className = "baseseriesitem";
    if (this.data._seriesItemLength > 1) {
        let customColorIndex = this.ChartFonts.customColor(this.index);
        element.className = "baseseriesitem accent" + customColorIndex + " clsMultiColorParent";
        element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
        element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    }
    element.style.height = this.data.chartName == "barStackedRectangle" ? "100%" : 100 / this.length + "%";
    element.style.width = this.data.chartName == "barStackedRectangle" ? stackWidth * 100 + "%" : "100%";
    if (this.data.layout.multiseriesGapValue > 0 && this.data.chartName != "barStackedRectangle") {
        let totalHeight = parseFloat(this.data.layout.multiseriesGapValue) * (this.length - 1);
        let indualHeight = (parseFloat(this.parent.clientHeight) - totalHeight) / this.length;
        element.style.height = this.data.SVGUtils.createPercentValue(this.parent.clientHeight, indualHeight);
        this.parent.style.setProperty("display", "flex");
        this.parent.style.setProperty("flex-direction", "column");
        this.parent.style.setProperty("justify-content", "space-between");
    }
    // if (this.data.data.getAttribute("data-stackpercentage") && this.index == 0) {
    //     element.style.paddingRight = "12px";
    // }

    if (this.data.chartName == "barcomparisonmodel" || this.data.chartName == "comparisonModelType2") {
        if (this.index == 0) element.style.paddingRight = "10px";
        else if (this.index == 1) element.style.paddingLeft = "10px";
    }
    if (this.data.values[this.groupindex][this.index] < 0) {
        element.style.flexDirection = "row-reverse";
        if (this.data.chartFlip) {
            element.style.flexDirection = "row";
        }
    }
    if (this.data.chartName == "comparisonModelType3" && this.groupindex >= this.data.seriesLength / 2) element.style.justifyContent = "flex-end";
    this.parent.appendChild(element);
    if (this.data.values[this.groupindex][this.index] < 0) {
        this.doAddRightSeriesItemElement(element, eProps);
        this.doAddLeftSeriesItemElement(element, eProps);
    } else {
        this.doAddLeftSeriesItemElement(element, eProps);
        this.doAddRightSeriesItemElement(element, eProps);
    }
    if (this.data.chartName == "barStackedRectangle") {
        this.valueOverlapping();
    }
};

BaseBarSeriesItem.prototype.doAddRightSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    // let totlavalue = argprops.totalvalue == 0 ? 1 : argprops.totalvalue;
    let totlavalue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    let maxValue = argprops.maxvalue == 0 && totlavalue == 0 ? 1 : argprops.maxvalue;
    totlavalue = totlavalue == 0 ? 1 : totlavalue;
    const numMultpleFactor = this.state.width / totlavalue;
    let numRightWidth = maxValue * numMultpleFactor;
    numRightWidth = numRightWidth == 0 && maxValue == 0 ? 1 : numRightWidth;
    if (numRightWidth < 10 && argprops.minvalue < 0) {
        numRightWidth = 63;
    }

    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem rightseriesitem";
    if (this.data.chartName == "comparisonModelType3") {
        element.style.width = "50%";
    } else element.style.width = this.data.chartName == "barStackedRectangle" ? "100%" : (numRightWidth / this.state.width) * 100 + "%";
    element.setAttribute("data-width", numRightWidth);
    // if (this.valueAlignment.vposition == "top") {
    //     element.style.flexDirection = "column";
    //     element.style.justifyContent = "center";
    // }
    if (argparent) argparent.appendChild(element);
    else return element;

    if (-1 < argprops.value) {
        var eprops = {
            width: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholderpath: argprops.placeholderpath,
            placeholdertype: argprops.placeholdertype,
            viewport: { y: argprops.viewport.y, x: argprops.viewport.x, width: numRightWidth, height: argprops.viewport.height },
        };
        this.doAddRightGraphicsContainer(element, eprops);
    }
};

BaseBarSeriesItem.prototype.displayPrimaryPlaceholder = function (argprops) {
    return this.placeholderAlignment && !this.addplaceholder && this.placeholderAlignment.position != "middle" ? this.placeholderAlignment.show : false;
};

BaseBarSeriesItem.prototype.displayLabel = function (argprops) {
    return this.labelAlignment && !this.addlabel && this.labelAlignment.position != "middle" ? this.labelAlignment.show : false;
};

BaseBarSeriesItem.prototype.displayValue = function (argprops) {
    return this.valueAlignment && !this.addvalue && this.valueAlignment.position != "middle" ? this.valueAlignment.show : false;
};

BaseBarSeriesItem.prototype.doAddLeftSeriesItemElement = function (argparent, argprops) {
    const index = argprops.index;
    const groupindex = argprops.gindex;
    // argprops.totalvalue = argprops.totalvalue == 0 && argprops.minvalue < 0 ? (-argprops.minvalue) : argprops.totalvalue;
    let totlavalue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.width / totlavalue;
    let numLeftWidth = argprops.minvalue * numMultpleFactor * -1;

    if (numLeftWidth < 10 && argprops.minvalue < 0) {
        numLeftWidth = 200;
    }
    let boolShowplaceholder = this.displayPrimaryPlaceholder({});
    if (!boolShowplaceholder) {
        if (numLeftWidth < 10 && argprops.minvalue < 0) {
            numLeftWidth = 300;
        }
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem leftseriesitem";
    element.style.width = (numLeftWidth / this.state.width) * 100 + "%";
    element.style.flexDirection = "row-reverse";
    element.setAttribute("data-width", numLeftWidth);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (argprops.value < 0) {
        var eprops = {
            width: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholderpath: argprops.placeholderpath,
            placeholdertype: argprops.placeholdertype,
            viewport: { y: argprops.viewport.y, x: argprops.viewport.x, width: numLeftWidth, height: argprops.viewport.height },
        };
        this.doAddLeftGraphicsContainer(element, eprops);
    } else {
        if (this.data.minValue < 0) {
            // let topSeriesItem = this.parent.querySelector(".rightseriesitem");
            // let rightWidth = topSeriesItem ? topSeriesItem.clientWidth : 0;
            // if (topSeriesItem) {
            //     let baseParentWidth = this.parent.querySelector(".baseseriesitem") ? this.parent.querySelector(".baseseriesitem").clientWidth : 0;
            //     baseParentWidth = baseParentWidth < this.state.width ? this.state.width : baseParentWidth;
            //     element.style.width = this.data.SVGUtils.createPercentValue(this.state.width, baseParentWidth - rightWidth);
            //     element.dataset.parentSeriesWidth = baseParentWidth - rightWidth;
            // }
            // element.style.height = baseParentHeight-topHeight+"px";
        }
    }
};

BaseBarSeriesItem.prototype.valuelayoutClassName = function (itemname, boolLeft = false) {
    let vLayoutName = itemname;
    if (vLayoutName.includes("graphic") && this.valueAlignment.position == "inner") {
        if (boolLeft) {
            if (this.valueAlignment.hposition == "left") {
                vLayoutName = "inset" + vLayoutName + "right" + this.valueAlignment.vposition;
            } else if (this.valueAlignment.hposition == "right") {
                vLayoutName = "inset" + vLayoutName + "left" + this.valueAlignment.vposition;
            } else {
                vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
            }
        } else {
            vLayoutName = "inset" + vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    } else {
        //if (vLayoutName.includes("value") && this.valueAlignment.itemBased == "true") vLayoutName = "itembased" + vLayoutName;
        if (boolLeft) {
            if (this.valueAlignment.hposition == "left") {
                vLayoutName = vLayoutName + "right" + this.valueAlignment.vposition;
            } else if (this.valueAlignment.hposition == "right") {
                vLayoutName = vLayoutName + "left" + this.valueAlignment.vposition;
            } else {
                vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
            }
        } else {
            vLayoutName = vLayoutName + this.valueAlignment.hposition + this.valueAlignment.vposition;
        }
    }
    return vLayoutName;
};

BaseBarSeriesItem.prototype.doAddRightValue = function (argparent, argprops, boolmax = false, boolOrder = false, overlapValue = true, graphiccustomW) {
    this.graphicWidthValue = graphicW ? graphicW : this.graphicWidthValue;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let valIndex = this.data.chartName == "comparisonModelType3" ? (groupindex < this.voData.seriesLength / 2 ? 0 : 1) : index;
    let valGroupIndex = this.data.chartName == "comparisonModelType3" ? this.ChartUtils.getFactorIndex(groupindex, this.voData.seriesLength / 2) : groupindex;

    if (overlapStackedBar) {
        overlapStackedBar = false;
        return;
    }
    let padding = this.setoverlapPadding("value");
    let hasLeft = this.overlapnode ? true : false;
    let vLayoutName = this.valueAlignment.itemBased == "true" ? this.valuelayoutClassName("itemlabel") : this.valuelayoutClassName("value", hasLeft);
    if (this.data.layout.boolvaluebgShape && this.data.layout.valuebgShapeType != "rect" && this.valueAlignment.position != "middle") {
        this.valueMaxH = this.valueMaxH > this.valueMaxW ? this.valueMaxW : this.valueMaxH;
        this.valueMaxW = this.valueMaxH > this.valueMaxW ? this.valueMaxW : this.valueMaxH;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "value-text-" + valGroupIndex + "_" + valIndex;
    element.style.minWidth = 20 + "px";
    element.style.height = this.valueMaxH + "px";
    element.style.maxWidth = this.valueMaxW + "px";
    element.style.maxHeight = this.valueMaxH + "px";
    element.dataset.hasstatistical = this.data.showStatistical;
    element.className = "value " + vLayoutName;
    element.style.order = boolOrder ? "1" : this.valueAlignment.index;
    if (this.data.layout.backgroundFillType == "pattern") {
        element.style.zIndex = "1";
    }
    if (this.labelAlignment.itemBased == "true" && this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.valueAlignment.hposition == "right") {
        element.style.height = "auto";
    }
    if (this.valueAlignment.itemBased == "true" && this.valueAlignment.hposition == "right") {
        element.style.justifyContent = "flex-end";
    }

    element.style.paddingLeft = padding["left"] + "px";
    element.style.paddingRight = padding["right"] + "px";
    element.style.paddingTop = padding["top"] + "px";
    element.style.paddingBottom = padding["bottom"] + "px";
    if (this.placeholderAlignment.position == "middle" && this.data.data.getAttribute("primaryplaceholder") && this.valueAlignment.hposition == "left") {
        element.style.marginLeft = this.middlePW / 2 + "px";
    }
    if (this.data.chartFlip || this.data.values[this.groupindex][this.index] < 0) {
        element.style.paddingRight = padding["left"] + "px";
        element.style.paddingLeft = padding["right"] + "px";
        if (this.data.layout.valuePaddingClass) element.classList.remove(this.data.layout.valuePaddingClass);
        if (this.data.layout.valueAlterPaddingClass) {
            element.classList.add(this.data.layout.valueAlterPaddingClass);
        }
    } else {
        if (this.data.layout.valuePaddingClass) {
            element.classList.add(this.data.layout.valuePaddingClass);
        }
    }

    if (this.data.chartName.includes("comparisonModel") && index == 1) {
        element.style.paddingRight = padding["left"] + "px";
        element.style.paddingLeft = padding["right"] + "px";
        vLayoutName = this.valueAlignment.itemBased == "true" ? this.valuelayoutClassName("itemlabel", true) : this.valuelayoutClassName("value", true);
        element.className = "value " + vLayoutName;
        element.classList.add("minlabelsize");
        if (this.data.layout.valuePaddingClass) element.classList.remove(this.data.layout.valuePaddingClass);
        if (this.data.layout.valueAlterPaddingClass) element.classList.add(this.data.layout.valueAlterPaddingClass);
    } else {
        if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.voData.seriesLength / 2) {
            element.style.paddingRight = padding["left"] + "px";
            element.style.paddingLeft = padding["right"] + "px";
            element.classList.add("minlabelsize");
            if (this.data.layout.valuePaddingClass) element.classList.remove(this.data.layout.valuePaddingClass);
            if (this.data.layout.valueAlterPaddingClass) element.classList.add(this.data.layout.valueAlterPaddingClass);
        } else {
            this.data.chartName.includes("comparisonModel") && this.valueAlignment.inset == "inside" ? element.classList.add("minlabelsize") : "";
        }
    }

    if (this.valueAlignment.textbgitem == "true") {
        element.classList.add("textbg" + this.valueAlignment.textbgstyle);
        element.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
    }

    if (this.data.layout.valueInset == "bgoutside") {
        element.classList.remove("minlabelsize");
    }
    if (this.valueBackground) {
        element.className = "value " + vLayoutName + " " + this.ChartFonts.graphicColor;
        element.style.left = "20px";
    }
    if (this.valueAlignment.hposition == "left") element.style.textAlign = "start";
    // if(this.data.data.getAttribute("data-stackpercentage")){
    //     argprops.valuetext= parseInt((100/this.data.stackSeriesvalueTotal[groupindex])*argprops.value)+"%"
    // }
    // if(this.data.chartName == "barcomparisonmodel"){
    //     element.style.boxSizing = "border-box";
    // }
    if (argparent) argparent.appendChild(element);
    else return element;

    let tempMaxValue = this.valueMaxW;
    let tempMaxHeight = this.valueMaxH;
    if (this.valueAlignment.inset != "inside" || this.data.chartName == "barcomparisonmodel") {
        tempMaxValue = this.valueMaxW - parseFloat(window.getComputedStyle(element)["padding-left"] || "0") - parseFloat(window.getComputedStyle(element)["padding-right"] || "0");
    }
    if (this.data.layout.boolvaluebgShape && this.data.layout.valuebgShapeType != "rect" && this.valueAlignment.position != "middle") {
        tempMaxHeight = tempMaxValue - 10;
    }
    tempMaxHeight = tempMaxHeight < 0 ? 0 : tempMaxHeight;
    let themeClassName = this.data.promptText ? " " + this.ChartFonts.promptTextClassName : " " + this.ChartFonts.valueThemeClassName;
    const subelement = document.createElement("div"); //this.ChartHelper.createDivElement({});//
    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement.className = "valuetext " + colorTabValueCustomClass + " " + this.valueStyle + themeClassName + " moodanimation";
    if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
        subelement.className = "valuetext " + this.valueStyle + themeClassName + " moodanimation";
    }
    if (this.data.layout.valueColor) {
        subelement.classList.remove("clsValueTextColor");
        subelement.classList.remove("clsInnerTextColor");
        subelement.classList.add("clsInnerTextColor");
    }

    element.appendChild(subelement);
    subelement.id = "valuetext-" + valGroupIndex + "_" + valIndex;
    subelement.innerHTML = boolmax ? this.data.longValue : argprops.valuetext;
    subelement.style.maxWidth = tempMaxValue + "px";
    subelement.style.maxHeight = tempMaxHeight + "px";
    subelement.style.visibility = boolmax ? "visible" : this.voData._valueDisplayFormat[valGroupIndex + " " + valIndex];
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "value");
    subelement.setAttribute("data-id", valGroupIndex + "_" + valIndex);
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.dataset.animation = !this.data.promptText ? "secondarytext" : "prompttext";
    let fontSize = this.ChartFonts.maxLabelFontSize(subelement);
    if (this.data.promptText) {
        element.style.whiteSpace = "unset";
        subelement.setAttribute("data-type", "promt");
        subelement.setAttribute("data-index", groupindex + "_" + index);
        subelement.classList.add("prompttext");
        subelement.style.overflow = "hidden";
        element.classList.add("promt");
        subelement.setAttribute("data-prompt-text", "10-15");
        subelement.innerHTML = boolmax ? this.data.promptlongValue : this.data.promptTextValue[groupindex][index];
        this.maxValueFontSize[this.arrIndex] = fontSize;
    }
    subelement.style.fontSize = this.maxValueFontSize[this.arrIndex] + "px";
    subelement.setAttribute("maxFontSize", this.maxValueFontSize[this.arrIndex]);
    subelement.setAttribute("data-graphic-x", this.graphicWidthValue);
    if ((this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
    }
    if (this.data._stackedPercentage && this.data._boolPercentageChart) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if (this.data.chartFlip) {
        subelement.setAttribute("data-graphic-x", -this.graphicWidthValue);
    }
    if (this.data.values[this.groupindex][this.index] < 0) {
        subelement.dataset.boolnegative = "true";
    }
    if (this.data.layout.boolvaluebgShape && this.valueAlignment.position != "middle") {
        subelement.style.padding = "10px";
        this.valuebgProperties(subelement);
    }
    if (this.valueStyle == "textgradient") {
        subelement.style.setProperty("background-image", this.data.layout.valueGradientValues, "important");
    }
    if (this.data.presentMode || this.data.disableEdit) {
        subelement.setAttribute("contenteditable", "false");
        subelement.setAttribute("data-dck-selector", "false");
    }
    if (this.data.chartName.includes("comparisonModel") && index == 0) {
        subelement.setAttribute("data-graphic-x", -this.graphicWidthValue);
    }
    if (this.data.chartName.includes("comparisonModelType3") && groupindex >= this.data.seriesLength / 2) {
        subelement.setAttribute("data-graphic-x", this.graphicWidthValue);
    }
    if (graphiccustomW) {
        subelement.setAttribute("data-graphic-x", graphiccustomW);
        if (this.data.chartFlip) {
            subelement.setAttribute("data-graphic-x", -graphiccustomW);
        }
    }

    if (this.data.layout.valueshadow == "true") {
        if (this.data.layout.valueShadowClass) subelement.classList.add(this.data.layout.valueShadowClass);
    }

    if (this.data.chartName == "barStackedRectangle") {
        subelement.dataset.animation = !this.data.promptText ? "secondarytext" + (valIndex + 1) : "prompttext" + (valIndex + 1);
        subelement.dataset.stackedmultiseries = "true";
        if (this.data.seriesLength == 1) subelement.dataset.singlestackedmultiseries = "true";
    }
    if (this.data.layout.valueColor) {
        let multiSeriesIndex = valGroupIndex;
        if (this.voData.seriesItemLength > 1 && this.data.chartName != "comparisonModelType3") {
            multiSeriesIndex = this.index;
        }
        subelement.classList.remove("clsSecondaryTextColor");
        if (this.data.chartName.includes("comparisonModel")) {
            subelement.classList.add(this.ChartFonts.appendgraphicColor(index)); //"accent" + (index + 1) + "-color");
        } else {
            let colorClass = this.getColorDetails(multiSeriesIndex, this.ChartFonts.appendgraphicColor(multiSeriesIndex), this.data.layout.valueColor, "color");
            subelement.classList.add(colorClass);
        }
    }
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement, "Value", "color");
    if (this.valueOuterposition) {
        element.dataset.valueouterPos = "true";
    }
    if ((this.data.hasEmphasis || this.data.hasProjection) && !this.valuePosInterchange) {
        subelement.classList.add("clsValueText");
    }
    if (this.data.arrHyperlinkUrl.length >= valGroupIndex) {
        element.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[valGroupIndex]);
    }
    if (this.deafaultPercentage) {
        subelement.innerText = parseFloat(argprops.valuetext) + "%";
        subelement.dataset.defalutPercentage = "true";
    }
    if (this.data.hasEmphasis && this.valueAlignment.inset == "inside" && this.data.emphasis[this.groupindex] == true && this.data._emphasisName == "emphasize-basic-pattern") {
        subelement.classList.add(this.data.ChartFonts.appendgraphicBgColor(this.groupindex));
    }
    if (this.valueAlignment.textbg == "true" && this.valueAlignment.textbgitem != "true") {
        subelement.classList.add("textbg" + this.valueAlignment.textbgstyle);
        if (this.valueAlignment.textbgcallout == "true") {
            subelement.style.position = "relative";
            subelement.classList.add("textbgcallout" + this.valueAlignment.textbgstyle + this.valueAlignment.hposition);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement);
    subelement.style.lineHeight = "1.5";
    let minFontSize = this.minValueFontSize[this.arrIndex];
    if (this.data.valueTextColor[groupindex]) {
        subelement.style.setProperty("color", this.data.valueTextColor[groupindex], "important");
    }
    this.calculateMaxFonsize(subelement, boolmax, this.maxValueFontSize[this.arrIndex]);
    if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
    this.ChartHelper.adjustFontSize(subelement, 20, minFontSize, this.maxValueFontSize[this.arrIndex], true);
    this.ChartHelper.adjustFontSizeWidth(subelement, 20, minFontSize, this.maxValueFontSize[this.arrIndex]);
    this.ChartHelper.textPositionChangeObserver(subelement);
    let fontsize;
    let overlapgrid = this.data.data.getAttribute("overlapgrid") && this.data.data.getAttribute("overlapgrid") == "true" ? true : false;
    subelement.style.lineHeight = "";
    if (this.labelAlignment.itemBased == "true" && this.labelAlignment.vposition != "top" && this.valueAlignment.itemBased != "true") {
        subelement.style.lineHeight = "1";
    }
    if (this.data.values[this.groupindex][this.index] >= this.data.rangePositive) {
        element.classList.add("gridmaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (this.data.values[this.groupindex][index] == this.data.minValue && this.data.minValue < 0) {
        element.classList.add("gridnegativemaxValue");
        element.dataset.currentMaxHeight = element.clientHeight;
    }
    if (boolmax) {
        this.currentValW = element.clientWidth;
        this.maxValueH = element.clientHeight;
        fontsize = window.getComputedStyle(subelement)["font-size"];
        let hasPrompt = false;
        if (this.data.promptText) {
            hasPrompt = true;
            let lineHeight = window.getComputedStyle(subelement)["line-height"] ? parseFloat(window.getComputedStyle(subelement)["line-height"]) : tempMaxHeight;
            this.data.data.setAttribute("prompthide", false);
            if (tempMaxHeight + 0.7 < lineHeight) {
                hasPrompt = false;
                this.data.data.setAttribute("prompthide", true);
            }
        }
        element.remove();
        let multiSeries = this.data._seriesItemLength > 2 || (this.data._seriesItemLength > 1 && this.data.seriesLength > 1);
        if (((parseFloat(fontsize) <= minFontSize && (this.data.seriesLength > 5 || this.data.promptText)) || (parseFloat(fontsize) <= minFontSize && multiSeries) || (overlapgrid && this.voData.presentMode && this.data.seriesLength > 7)) && this.data.chartName != "barSimpleiconRepeatFill" && !hasPrompt) {
            this.valueMaxLimit = this.valueOverlapping(false, argprops);
            this.currentValW = 0;
        } else {
            if (overlapgrid && !this.data.presentMode) {
                this.removeGrid();
            }
        }
        if (this.data.presentMode && overlapgrid && !hasPrompt) {
            this.valueMaxLimit = this.valueOverlapping(false, argprops);
        }
    } else {
        if (!this.data.promptText) this.ChartUtils.createSpanFormat(subelement, this.data);
        fontsize = window.getComputedStyle(subelement)["font-size"];
        let minWidth = window.getComputedStyle(element)["min-width"];
        if ((this.data.layout.valueInset == "inside") & (this.valueStyle != "outerColor1")) {
            if (this.data.suffixStyle) {
                let valueSuffixElement = subelement.querySelector("." + this.data.suffixStyle);
                if (valueSuffixElement) valueSuffixElement.className = this.data.suffixStyle + " " + this.valueStyle;
            }
            if (this.data.prefixStyle) {
                let valuePerfixElement = subelement.querySelector("." + this.data.prefixStyle);
                if (valuePerfixElement) valuePerfixElement.className = this.data.prefixStyle + " " + this.valueStyle;
            }
        }
        this.currentValW = minWidth > this.currentValW ? minWidth : this.currentValW;
        // element.style.display = "none"
        if (overlapStackedBar || (overlapgrid && overlapValue) || (overlapgrid && this.voData.presentMode)) {
            if (graphicW < element.clientWidth && this.data.chartName == "barStackedRectangle") {
                element.style.display = "none";
            } else {
                if (this.data.chartName != "barStackedRectangle") element.style.display = "none";
            }
            if (!this.data.stackedPercentage && this.data.chartName != "barStackedRectangle") this.removeValueElement();
        } else {
            if (this.valueAlignment.itemBased != "true") {
                // element.style.overflow = "hidden";
            }
            // subelement.style.overflow = "hidden";
        }
        if (this.labelAlignment.itemBased == "true" && this.valueAlignment.itemBased != "true") {
            let graphicDiv = argparent.querySelector(".chartgraphic");
            if (graphicDiv) subelement.setAttribute("data-graphic-x", graphicDiv.clientWidth);
        }
        if (this.data.promptText) {
            this.checkMaxLabelLineHeight(subelement, subelement.clientHeight);
        }
        if (subelement && this.ChartFonts.valueInnerColor && subelement.classList.contains(this.ChartFonts.valueInnerColor)) {
            subelement.classList.remove("clsInnerTextColor");
            subelement.classList.add("clsInnerTextColor");
        }
    }
};

BaseBarSeriesItem.prototype.valueOverlapping = function (enableGrid = true, argprops) {
    this.data._customProperties.showYAxisGrid = true;
    // this.data._customProperties.showYAxisLine = true;
    // this.data._customProperties.showXAxisLine = true;
    this.data._customProperties.showYAxisGridValue = true;
    let valuesRange = this.ChartHelper.getValuesRange(this.data.values, false, this.data._customProperties.yAxisMaxValue, this.data.baseProperties.maxAllowedSeriesItems);
    if (this.data.showStatistical) {
        valuesRange = this.ChartHelper.getValuesRange(this.data.values, false, this.data._customProperties.yAxisMaxValue, 1);
    }
    // this.data.longValue = valuesRange.longValue;
    this.data.rangeTotal = valuesRange.rangeTotal;
    this.data.totalValue = valuesRange.totalValue;
    this.data.rangePositive = valuesRange.rangePositive;
    this.data.rangeNegative = valuesRange.rangeNegative;

    if (!this.data._customProperties.yAxisMaxValue && this.data._minValue < 0) {
        let dummeyNegativeValue = -this.data.rangeNegative;
        let maxTotalValue = dummeyNegativeValue + this.data.rangePositive;
        let gapValues = maxTotalValue / 5;
        let gapCount = gapValues;
        let DummeyCont = 0;
        let negativeSideValue = 0;
        while (dummeyNegativeValue > negativeSideValue) {
            DummeyCont++;
            negativeSideValue = gapValues * DummeyCont;
            if (negativeSideValue > dummeyNegativeValue) {
                this.data.rangeNegative = -negativeSideValue;
                this.data.negativeGridCount = DummeyCont;
                break;
            }
        }
        let secondaryDummeyCont = 5 - DummeyCont;
        let positiveSideValue = 0;
        while (this.data.rangePositive > positiveSideValue) {
            positiveSideValue = gapValues * secondaryDummeyCont;
            if (positiveSideValue >= this.data.rangePositive) {
                this.data.positiveGridCount = secondaryDummeyCont;
                this.data.rangePositive = positiveSideValue;
                this.data.rangeTotal = positiveSideValue;
                break;
            }
            secondaryDummeyCont++;
        }
    }

    // this.data.data.setAttribute("showyaxisline", "true");
    this.data.data.setAttribute("showyaxisgrid", "true");
    this.data.data.setAttribute("yaxissteps", "true");
    this.data.data.setAttribute("overlapgrid", "true");
    this.data.data.setAttribute("displayvalue", "none");
    this.data.data.setAttribute("disaplevalueformat", "true");
    if (this.data.chartName == "barRoundedFill") {
        this.data.data.setAttribute("showyaxisline", "false");
        this.data.data.setAttribute("showxaxisline", "false");
        this.data._customProperties.showYAxisLine = false;
        this.data._customProperties.showXAxisLine = false;
    }
    this.data.data.setAttribute("enablegrid", "false");
    if (argprops) {
        argprops.minvalue = this.data.rangeNegative;
        argprops.maxvalue = this.data.rangePositive;
        argprops.totalvalue = this.data.rangePositive;
    }
};

BaseBarSeriesItem.prototype.removeGrid = function () {
    this.data.data.setAttribute("enablegrid", "");
    // this.data.data.setAttribute("showyaxisline", "false");
    this.data.data.setAttribute("showyaxisgrid", "false");
    this.data.data.setAttribute("yaxissteps", "false");
    this.data.data.setAttribute("overlapgrid", "false");
    this.data.data.setAttribute("displayvalue", "all");
    this.data.data.removeAttribute("disaplevalueformat");
    this.data._customProperties.showYAxisGrid = false;
    // this.data._customProperties.showYAxisLine = false;
    // this.data._customProperties.showXAxisLine = false;
    this.data._customProperties.showYAxisGridValue = false;
};

BaseBarSeriesItem.prototype.setoverlapPadding = function (name) {
    let hposition;
    let vPosition;
    let area = { left: 0, right: 0, top: 0, bottom: 0 };
    if (name == "label") {
        area = { left: this.data.layout.labelPaddingleft, right: this.data.layout.labelPaddingright, top: this.data.layout.labelPaddingtop, bottom: this.data.layout.labelPaddingbottom };
        if (this.data.layout.labeloverlap == "value") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH * 0.5 + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH * 0.5 + this.data.layout.labelPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW * 0.5 + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW * 0.5 + this.data.layout.labelPaddingright;
            return area;
        } else if (this.data.layout.labeloverlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH * 0.5 + this.data.layout.labelPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middlePH * 0.5 + this.data.layout.labelPaddingbottom;
            if (hposition == "left") area["left"] = this.middlePW * 0.5 + this.data.layout.labelPaddingleft;
            if (hposition == "right") area["right"] = this.middlePW * 0.5 + this.data.layout.labelPaddingright;
            return area;
        }
    } else if (name == "value") {
        area = { left: this.data.layout.valuePaddingleft, right: this.data.layout.valuePaddingright, top: this.data.layout.valuePaddingtop, bottom: this.data.layout.valuePaddingbottom };
        if (this.data.layout.valueoverlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH * 0.5 + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleLH * 0.5 + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH * 0.5 + this.data.layout.valuePaddingleft;
            if (hposition == "right") area["right"] = this.middleLH * 0.5 + this.data.layout.valuePaddingright;
            return area;
        } else if (this.data.layout.valueoverlap == "placeholder") {
            hposition = this.placeholderAlignment.hposition;
            vPosition = this.placeholderAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middlePH * 0.5 + this.data.layout.valuePaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middlePH * 0.5 + this.data.layout.valuePaddingbottom;
            if (hposition == "left") area["left"] = this.middlePW * 0.5 + this.data.layout.valuePaddingleft;
            if (graphicW < this.currentValW && this.data.layout.valueoverlap == "placeholder" && this.valueAlignment.position == "inner") {
                if (hposition == "right") area["left"] = this.middlePW * 0.5 + this.data.layout.valuePaddingright;
                if (hposition == "right") area["right"] = this.data.layout.valuePaddingright;
            } else {
                if (hposition == "right") area["right"] = this.middlePW * 0.5 + this.data.layout.valuePaddingright;
            }
            return area;
        }
    } else if (name == "placeholder") {
        area = {
            left: this.data.layout.placeholderPaddingleft,
            right: this.data.layout.placeholderPaddingright,
            top: this.data.layout.placeholderPaddingtop,
            bottom: this.data.layout.placeholderPaddingbottom,
        };
        if (this.data.layout.placeholderoverlap == "label") {
            hposition = this.labelAlignment.hposition;
            vPosition = this.labelAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleLH * 0.5 + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleLH * 0.5 + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleLH * 0.5 + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleLH * 0.5 + this.data.layout.placeholderPaddingright;
            return area;
        } else if (this.data.layout.placeholderoverlap == "placeholder") {
            hposition = this.valueAlignment.hposition;
            vPosition = this.valueAlignment.vposition;
            if (vPosition == "top") area["top"] = this.middleVH * 0.5 + this.data.layout.placeholderPaddingtop;
            if (vPosition == "bottom") area["bottom"] = this.middleVH * 0.5 + this.data.layout.placeholderPaddingbottom;
            if (hposition == "left") area["left"] = this.middleVW * 0.5 + this.data.layout.placeholderPaddingleft;
            if (hposition == "right") area["right"] = this.middleVW * 0.5 + this.data.layout.placeholderPaddingright;
            return area;
        }
    }
    return area;
};

BaseBarSeriesItem.prototype.doAddRightPlaceholder = function (argparent, argprops, boolMidElement = false, svgelement = false) {
    const index = argprops.index;
    let type = String(argprops.placeholdertype).toLowerCase();
    const percentage = type == "image" ? 1 : 0.8;
    const bounds = this.placeholderAlignment.position == "middle" ? { width: this.middlePW * percentage, height: this.middlePH * percentage } : this.getPlaceholderBounds();
    let padding = this.setoverlapPadding("placeholder");
    if (this.itemBasedPlaceHolderHeight) {
        bounds.width = this.itemBasedPlaceHolderHeight;
        bounds.height = this.itemBasedPlaceHolderHeight;
    }
    let baseelement = this.ChartHelper.createDivElement({});
    baseelement.style.marginLeft = padding["left"] + "px";
    baseelement.style.marginRight = padding["right"] + "px";
    baseelement.style.marginTop = padding["top"] + "px";
    baseelement.style.marginBottom = padding["bottom"] + "px";
    if (this.data.chartFlip) {
        baseelement.style.marginLeft = padding["right"] + "px";
        baseelement.style.marginRight = padding["left"] + "px";
    }
    if (this.data.layout.placeholderPaddingClass) {
        baseelement.classList.add(this.data.layout.placeholderPaddingClass);
    }
    baseelement.style.pointerEvents = "all";
    baseelement.style.position = "relative";
    // baseelement.className =this.data.layout.placholderGlopalStyle;
    if (argparent) argparent.appendChild(baseelement);
    argparent.style.setProperty("--node-icon-opacity", "0.5");
    // baseelement.classList.add("chartclsContentNode");
    baseelement.classList.add("contentContainer");
    baseelement.setAttribute("data-nodetype", "contentContainer");

    baseelement.classList.add("moodanimation");
    baseelement.setAttribute("data-animation", "primaryplaceholder");

    let bgElement = this.ChartHelper.createDivElement({});
    bgElement.classList.add("shapeBgElement");
    bgElement.classList.add("contentBackground");
    bgElement.setAttribute("data-nodetype", "contentBackground");
    bgElement.style.zIndex = "0";
    baseelement.appendChild(bgElement);
    if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner") {
    } else {
        baseelement.style.height = this.data.layout.placholderHeight && parseFloat(this.data.layout.placholderHeight) < bounds.height ? this.data.layout.placholderHeight + "px" : bounds.height + "px";
        baseelement.style.width = this.data.layout.placholderWidth && parseFloat(this.data.layout.placholderWidth) < bounds.width ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    }
    if (svgelement) {
        baseelement.style.position = "absolute";
    }

    const element = this.ChartHelper.createDivElement({});
    element.id = "primaryplaceholder-" + argprops.gindex + "_0";
    element.className = "primaryplaceholder rightprimaryplaceholder";
    element.style.position = "relative";
    element.style.height = this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner" ? "100%" : bounds.height + "px";
    element.style.width = bounds.width + "px";
    if (this.placeholderAlignment.samepos == "true" && this.placeholderAlignment.position == "inner") {
    } else {
        element.style.height = this.data.layout.placholderHeight && parseFloat(this.data.layout.placholderHeight) < bounds.height ? this.data.layout.placholderHeight + "px" : bounds.height + "px";
        element.style.width = this.data.layout.placholderWidth && parseFloat(this.data.layout.placholderWidth) < bounds.width ? this.data.layout.placholderWidth + "px" : bounds.width + "px";
    }
    element.style.order = this.placeholderAlignment.index;
    if (this.data.layout.boolplaceholderShape && this.placeholderAlignment.position != "middle") {
        this.bgProperties(element);
    }

    if (this.placeholderStyle == this.ChartFonts.valueInnerColor) element.style.zIndex = 1;
    if (boolMidElement) {
        element.style.display = "flex";
        element.style.justifyContent = "center";
        element.setAttribute("data-animation", "");
        element.className = "primaryplaceholder rightprimaryplaceholder";
    }
    baseelement.appendChild(element);
    switch (type) {
        case "icon":
            element.classList.add("iconHolder");
            element.setAttribute("data-nodetype", "iconHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 0) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[0]);
            this.doAddIconUseNodeElement(element, argprops, boolMidElement);
            this.setBorderWidth(baseelement);
            break;
        case "image":
            element.classList.add("imageHolder");
            element.setAttribute("data-nodetype", "imageHolder");
            if (this.data.layout.arrplacholderGlopalStyle.length > 1) baseelement.classList.add(this.data.layout.arrplacholderGlopalStyle[1]);
            this.doAddImageUseNodeElement(element, argprops);
            this.setImageBorderWidth(baseelement);
            break;
        case "logo":
            this.doAddImageUseNodeElement(element, argprops, "logo");
            break;
        case "text":
            this.doAddTextUseNodeElement(element, argprops);
            break;
    }
};

