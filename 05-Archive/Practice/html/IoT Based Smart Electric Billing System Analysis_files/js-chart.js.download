    xmlData.setAttribute("baseline_left_value", baselinevaleText.toString());
    if (oldValue != baselinevaleText) {
        this.chartUtils.updateChartProperties(slideID, {});
    }
};
ChartDataGenerator.prototype.getElementSlide = function (element) {
    if (element.className.includes("GRAPHIC")||element.id=="TEXTBOX_HOLDER") {
        return element.parentElement;
    } else {
        return this.getElementSlide(element.parentElement);
    }
};

const arrTextItems = ["labeltext", "valuetext", "plabel", "pvalue", "axistitletext"];
const arrGrid = ["xaxis", "yaxis"];
const STR_DEFAULT_ICONGROUP = "currencyicon";
let STR_DEFAULT_ICONPATH = "genericassets/icons/placeholder/placeholder.svg";
let menuDataDetails = null;
function ChartUtils() {
    this.SvgUtils = new window["SVGUtils"]();
}

ChartUtils.prototype.getChartSupportData = function (objChartItem, objDetails, xmlData, objMoods = null) {
    if (objDetails) {
        if (objDetails.property == "dropdowncount" || objDetails.property == "nodecount") {
            this.addNode(xmlData, objDetails);
        } else if (objDetails.operation == "add" || objDetails.operation == "delete" || objDetails.property == "deleteasset" || objDetails.property == "chartrowcount" || objDetails.property == "chartcolumncount") {
            this.addRowCol(xmlData, objDetails);
        } else if (objDetails.property == "axisbaseline") {
            this.axisBaselineoperation(xmlData, objDetails);
        } else if (objDetails.property == "deletebaseline") {
            this.removeBaseLine(xmlData, objDetails);
        } else if (
            objDetails.property == "sortorder" ||
            objDetails.property == "projection" ||
            objDetails.property == "graphicimage" ||
            objDetails.property == "highlightstyle" ||
            objDetails.property == "enablehighlight" ||
            objDetails.property == "highlightemphasize" ||
            objDetails.property == "highlightdescription" ||
            objDetails.property == "deletesimplehighlight"
        ) {
            this.getHighlightProperty(xmlData, objDetails);
        } else if (objDetails.property == "primaryplaceholder") {
            xmlData.setAttribute(objDetails.property, objDetails.value);
        } else if (objDetails.property == "selectedtextlinkurl") {
            this.getChartURLData(objDetails);
        } else if (objDetails.property == "diagramgraphictype" || objDetails.property == "chartimageplaceholder") {
            let index = objDetails.targetid.split("-")[1].split("_")[0];
            if (objDetails.property == "diagramgraphictype") xmlData.children[index].setAttribute("placeholdertype", objDetails.value);
            else if (objDetails.property == "chartimageplaceholder") xmlData.children[index].setAttribute("imageplaceholdertype", objDetails.value);
        } else if (objDetails.property == "customdoughnut") {
            this.customDoughnutoperation(xmlData, objDetails);
        } else if (objDetails.property == "semichart") {
            this.customSemiChartoperation(xmlData, objDetails);
        } else {
            xmlData.setAttribute(objDetails.property, objDetails.value);
        }
    }
};

ChartUtils.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index;
};

ChartUtils.prototype.removeBaseLine = function (xmlData, objDetails) {
    if (objDetails.targetid && objDetails.targetid != "") {
        if (objDetails.targetid.includes("hightlight")) {
            xmlData.removeAttribute("data-highlightdifference");
        } else {
            let arrId = objDetails.targetid.split("-");
            let groupName = arrId[0];
            let groupNameItem = groupName.split("_");
            let index = parseInt(groupNameItem[2]);
            let attrText = groupNameItem[0] + "_" + groupNameItem[1] + "_text";
            let attrValue = groupNameItem[0] + "_" + groupNameItem[1] + "_value";
            let strText = xmlData.getAttribute(attrText);
            let strValue = xmlData.getAttribute(attrValue);
            if (!strValue) {
                strValue = xmlData.getAttribute("baseline_bottom_value");
            }
            let arrText = strText ? strText.split(",") : [];
            let arrValue = strValue ? strValue.split(",") : [];
            arrText.splice(index, 1);
            arrValue.splice(index, 1);
            let length = arrText.length;
            strText = "";
            strValue = "";
            for (let i1 = 0; i1 < length; i1++) {
                strText += i1 == 0 ? arrText[i1] : "," + arrText[i1];
                strValue += i1 == 0 ? arrValue[i1] : "," + arrValue[i1];
            }

            xmlData.removeAttribute("axisbaseline");
            xmlData.removeAttribute("data-baseline");
            // xmlData.setAttribute(attrText, strText);
            // xmlData.setAttribute(attrValue, strValue);
        }
    }
};

ChartUtils.prototype.applyMoodsData = function (objMoods, xmlData, slideId, repaet = false, objDetails) {
    if (objMoods["chart"] && 0 < Object.keys(objMoods["chart"]).length && xmlData) {
        let boolLayout = false;
        let chartName = xmlData.getAttribute("name");
        let layoutName = xmlData.getAttribute("layout");
        let chartListData = ChartHelper.getChartListDataByName(chartName);
        let strclassname = xmlData.getAttribute("data-classname");
        let jsonChartItemMetaData = this.getChartItemMetaData("name", strclassname)[0];
        let moodname = xmlData.getAttribute("data-mood");
        let family = jsonChartItemMetaData ? jsonChartItemMetaData.family : "a";
        let moodsObj = objMoods["chart"]["shape"][family];
        let moodsAssetName = moodsObj && moodsObj.name ? moodsObj.name.split(",") : [];
        let moodsLayoutName = moodsObj && moodsObj.layout ? moodsObj.layout : "";
        if (moodsAssetName.length > 0) {
            let moodAssetList = moodsObj.swaplist ? moodsObj.swaplist : [];
            for (let a1 = 0; a1 < moodAssetList.length; a1++) {
                let nameList = moodAssetList[a1][0].split(",");
                nameList.forEach(function (item) {
                    if (item == chartName) {
                        chartName = moodsAssetName.length > a1 ? moodsAssetName[a1] : chartName;
                        let result = ""; //.getInstance().getMenuDetail(chartName);
                        let objDetails = { menu: result, repeat: true };
                        this.updateChartProperties(slideId, objDetails, true, false);
                    }
                });
            }
        }
        // let moodsStyle = objMoods["chart"]["style"];
        // moodsStyle = moodsStyle == "dropshadow" ? "Shadow" : moodsStyle;
        if (moodsLayoutName && moodname) layoutName = moodsLayoutName;
        let moodEmphasize = objMoods["chart"]["emphasizestyle"];
        if (moodEmphasize) xmlData.setAttribute("data-emphasize", moodEmphasize);
        let moodprojection = objMoods["chart"]["projectionstyle"];
        if (moodprojection) xmlData.setAttribute("data-projection", moodprojection);
        if (objMoods["chart"]["baselinestyle"]) {
            let moodbasline = objMoods["chart"]["baselinestyle"]["name"];
            if (moodbasline) xmlData.setAttribute("data-baslinestyle", moodbasline);
            let moodbaslineStyle = objMoods["chart"]["baselinestyle"]["linestyle"];
            if (moodbaslineStyle) xmlData.setAttribute("data-baseline-line", moodbaslineStyle);
            let shapeStyle = objMoods["chart"]["baselinestyle"]["shape"];
            if (shapeStyle) {
                xmlData.setAttribute("data-baseline-shape", JSON.stringify(shapeStyle));
            } else {
                xmlData.removeAttribute("data-baseline-shape");
            }
        } else {
            xmlData.setAttribute("data-baslinestyle", "simplebaseline");
        }

        if (chartName) xmlData.setAttribute("name", chartName);
        if (layoutName) xmlData.setAttribute("layout", layoutName);
        // return {
        //     chartName: chartName,
        //     layoutName: layoutName,
        // };
    }
    return null;
};

ChartUtils.prototype.addRowCol = function (xmlData, objDetails) {
    let itemIndex = 0;
    let length = xmlData.children.length;
    if (objDetails.targetid) objDetails.index = objDetails.targetid.split("-")[0] == "value" || "graphic" ? objDetails.targetid.split("-")[1].split("_")[0] : objDetails.targetid.split("-")[1];
    objDetails.index = parseInt(objDetails.index);
    if (objDetails.operation == "add") {
        if (objDetails.type == "Column") {
            if (objDetails.columnType == "text") {
                let arrValue = this.shuffleArray();
                for (let i1 = 0; i1 < length; i1++) {
                    let arrAddValue = [];
                    arrAddValue = xmlData.children[i1].attributes["value"].nodeValue.split(",");
                    arrAddValue.splice(objDetails.columnIndex, 0, arrValue[i1]);
                    xmlData.children[i1].attributes["value"].nodeValue = arrAddValue.toString();
                }
            } else if (objDetails.columnType == "icon") {
                xmlData.setAttribute("primaryplaceholder", true);
            }
        } else if (objDetails.type == "Row") {
            let item = this.SvgUtils.createElement("metadata");
            let metaData = xmlData.parentElement.parentElement;
            let primaryName = xmlData.getAttribute("primarychart");
            let secondaryName = xmlData.getAttribute("secondarychart");
            this.seriesLength = metaData.querySelector(".metadata_group_chart").getAttribute("sublength");
            if (primaryName && secondaryName) {
                this.SvgUtils.assignAttributes(item, {
                    class: "chartitem",
                    name: "", //"Enter Label",
                    index: objDetails.index,
                    value: this.addValue(xmlData, objDetails),
                    secondaryvalue: this.addValue(xmlData, objDetails),
                    prefix: "",
                    suffix: "",
                    denomination: "",
                    sprefix: "",
                    ssuffix: "",
                    sdenomination: "",
                });
            } else {
                this.SvgUtils.assignAttributes(item, {
                    class: "chartitem",
                    name: "", //"Enter Label",
                    index: objDetails.index,
                    value: this.addValue(xmlData, objDetails), // this.seriesLength < 1 ? this.getChartValue(xmlData, objDetails) :
                    prefix: "",
                    suffix: "",
                    denomination: "",
                });
            }
            xmlData.insertBefore(item, xmlData.children[objDetails.index]);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].attributes["index"].nodeValue = i1;
            }
        }
    } else if (objDetails.operation == "delete" || objDetails.property == "deleteasset") {
        if (objDetails.type == "Column") {
            if (objDetails.index == 0) return;
            for (let i1 = 0; i1 < length; i1++) {
                let arrDelValue = [];
                arrDelValue = xmlData.children[i1].attributes["value"].nodeValue.split(",");
                if (arrDelValue.length > 1) {
                    arrDelValue.splice(objDetails.index - 1, 1);
                    xmlData.children[i1].attributes["value"].nodeValue = arrDelValue.toString();
                } else return;
            }
        } else {
            for (let i1 = 0; i1 < length; i1++) {
                itemIndex = parseInt(xmlData.children[i1].attributes["index"].nodeValue);
                if (objDetails.index < itemIndex) {
                    xmlData.children[i1].attributes["index"].nodeValue = itemIndex - 1;
                }
            }
            let removeItem = xmlData.children[objDetails.index];
            xmlData.removeChild(removeItem);
            let boolenablemenu = xmlData.getAttribute("data-menuminseries") > length - 1;
            if (boolenablemenu) {
                let shapeName = xmlData.getAttribute("graphicname");
                xmlData.removeAttribute("uniqueLayoutName");
                xmlData.removeAttribute("uniqueLayout");
                let nodeCount = length - 1;
                let result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, nodeCount, "");
                if (!result) {
                    shapeName = this.ChartHelper.getOldMenu(shapeName);
                    result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, nodeCount, "");
                }
                objDetails.menu = result;
                objDetails.repeat = true;
                ChartDataGenerator.propertyUpdation(xmlData, objDetails);
                SlideUtils.updateUniqueLayout(objDetails.slideId, result.name, "chart", result);
                // ChartUtils.updateChartProperties(objDetails.slideId, objDetails);
            }
        }
    }
};

ChartUtils.prototype.shuffleArray = function () {
    let temp;
    let index;
    let arrValue = ["40", "30", "10", "20", "5", "35", "90", "60", "70", "55", "72", "68"];
    let ctr = arrValue.length;

    while (ctr > 0) {
        index = Math.floor(Math.random() * ctr);
        ctr--;
        temp = arrValue[ctr];
        arrValue[ctr] = arrValue[index];
        arrValue[index] = temp;
    }
    return arrValue;
};

ChartUtils.prototype.customDoughnutoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, objDetails.value);
    let objChartNames = {
        pieSimpleStandard: "pieDoughnutStandard",
        pieDoughnutStandard: "pieSimpleStandard",
        halfPieChart: "pieSemiDoughnutStandard",
        pieSemiDoughnutStandard: "halfPieChart",
    };
    let strChartName = xmlData.getAttribute("name");
    xmlData.setAttribute("name", objChartNames[strChartName]);
};

ChartUtils.prototype.customSemiChartoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, objDetails.value);
    let objChartNames = {
        pieSimpleStandard: "halfPieChart",
        pieDoughnutStandard: "pieSemiDoughnutStandard",
        halfPieChart: "pieSimpleStandard",
        pieSemiDoughnutStandard: "pieDoughnutStandard",
    };
    let strChartName = xmlData.getAttribute("name");
    xmlData.setAttribute("name", objChartNames[strChartName]);
};

ChartUtils.prototype.axisBaselineoperation = function (xmlData, objDetails) {
    xmlData.setAttribute(objDetails.property, "true");
    xmlData.setAttribute("chartAxisType", objDetails.dpaxisbaseline.chartAxisType);
    let maxValue = objDetails.dpaxisbaseline.bounds.isnegative ? this.minValueOperation(xmlData) : this.maxValueOperation(xmlData);
    if (objDetails.dpaxisbaseline.chartAxisType == "vertical") {
        if (objDetails.dpaxisbaseline.leftPos) {
            let axisLeftPos = xmlData.getAttribute("baseline_left_value");
            let targetH = Number(objDetails.dpaxisbaseline.bounds.height);
            let targetBtm = Number(objDetails.dpaxisbaseline.bounds.bottom);
            let checkPoint = targetBtm - Number(objDetails.dpaxisbaseline.leftPos.y);
            let percentageDiff = (checkPoint / targetH) * 100;
            let maxPercentage = maxValue / 100;
            let targetY = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            axisLeftPos = axisLeftPos ? xmlData.getAttribute("baseline_left_value") + "," + targetY : targetY;
            xmlData.setAttribute("baseline_left_value", axisLeftPos);
            let axisLeftText = xmlData.getAttribute("baseline_left_text") ? xmlData.getAttribute("baseline_left_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_left_text", axisLeftText);
        } else if (objDetails.dpaxisbaseline.bottomPos) {
            let axisBottomPos = xmlData.getAttribute("baseline_bottom_value");
            let targetW = Number(objDetails.dpaxisbaseline.bounds.width);
            let checkPoint = Number(objDetails.dpaxisbaseline.bottomPos.x) - Number(objDetails.dpaxisbaseline.bounds.x);
            let offsetX = (checkPoint / targetW) * 100;
            let maxPercentage = parseInt(maxValue) / 100;
            offsetX = maxPercentage * offsetX;
            axisBottomPos = axisBottomPos ? xmlData.getAttribute("baseline_bottom_value") + "," + offsetX : offsetX;
            xmlData.setAttribute("baseline_bottom_value", axisBottomPos);
            let axisBottomText = xmlData.getAttribute("baseline_bottom_text") ? xmlData.getAttribute("baseline_bottom_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_bottom_text", axisBottomText);
        }
    } else if (objDetails.dpaxisbaseline.chartAxisType == "horizontal") {
        if (objDetails.dpaxisbaseline.bottomPos) {
            let targetW = Number(objDetails.dpaxisbaseline.bounds.width);
            let checkPoint = Number(objDetails.dpaxisbaseline.bottomPos.x) - Number(objDetails.dpaxisbaseline.bounds.x);
            let percentageDiff = (checkPoint / targetW) * 100;
            let maxPercentage = maxValue / 100;
            let targetX = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            let axisBottomPos = xmlData.getAttribute("baseline_bottom_value");
            axisBottomPos = axisBottomPos ? xmlData.getAttribute("baseline_bottom_value") + "," + targetX : targetX;
            xmlData.setAttribute("baseline_bottom_value", axisBottomPos);
            let axisBottomText = xmlData.getAttribute("baseline_bottom_text") ? xmlData.getAttribute("baseline_bottom_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_bottom_text", axisBottomText);
        } else if (objDetails.dpaxisbaseline.leftPos) {
            let axisLeftPos = xmlData.getAttribute("baseline_left_value");
            let targetH = Number(objDetails.dpaxisbaseline.bounds.height);
            let targetBtm = Number(objDetails.dpaxisbaseline.bounds.bottom);
            let checkPoint = targetBtm - Number(objDetails.dpaxisbaseline.leftPos.y);
            let percentageDiff = (checkPoint / targetH) * 100;
            let maxPercentage = maxValue / 100;
            let targetY = objDetails.dpaxisbaseline.bounds.isnegative ? maxValue - maxPercentage * percentageDiff : maxPercentage * percentageDiff;
            axisLeftPos = axisLeftPos ? xmlData.getAttribute("baseline_left_value") + "," + targetY : targetY;
            xmlData.setAttribute("baseline_left_value", axisLeftPos);
            let axisLeftText = xmlData.getAttribute("baseline_left_text") ? xmlData.getAttribute("baseline_left_text") + "," + "Enter Text" : "Enter Text";
            xmlData.setAttribute("baseline_left_text", axisLeftText);
        }
    }
};

ChartUtils.prototype.maxValueOperation = function (xmlData) {
    let maxValue;
    let xmlChildData = xmlData.children;
    let boolGrid = xmlData.getAttribute("showyaxisgrid") == "true" ? true : false;
    let arrValue = [];
    for (let i1 = 0; i1 < xmlChildData.length; i1++) {
        arrValue[i1] = xmlChildData[i1].getAttribute("value").split(",");
        // for (let i2 = 0; i2 < arrValue.length; i2++) {
        //     if (i1 == 0 && i2 == 0) maxValue = Number(arrValue[i2]);
        //     else maxValue = Number(maxValue) < Number(arrValue[i2]) ? Number(arrValue[i2]) : Number(maxValue);
        // }
    }
    let customMaxValue = xmlData.getAttribute("yaxismaxvalue") ? xmlData.getAttribute("yaxismaxvalue") : "";
    let valuesRange = ChartHelper.getValuesRange(arrValue, boolGrid);
    return valuesRange.rangeTotal;
};

ChartUtils.prototype.getHighlightProperty = function (xmlData, objDetails) {
    if (objDetails.property == "nodecount") {
        let numNumberOfChildren = objDetails.value;
        console.log(numNumberOfChildren);
    } else {
        let index = objDetails.targetid.split("-")[0] == "value" || "graphic" ? objDetails.targetid.split("-")[1].split("_")[0] : objDetails.targetid.split("-")[1];
        if (objDetails.targetid.split("-")[0] == "primary" && objDetails.targetid.split("-").length > 2) {
            index = objDetails.targetid.split("-")[2];
        }
        if (objDetails.property == "highlightemphasize") {
            xmlData.children[index].setAttribute("emphasis", objDetails.value);
            //
            let boolEmphasize = false;
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let emphasis = xmlData.children[i1].getAttribute("emphasis") == "true" ? true : false;
                if (emphasis) {
                    boolEmphasize = emphasis;
                }
            }
            xmlData.setAttribute("emphasis", boolEmphasize);
        } else if (objDetails.property == "enablehighlight") {
            xmlData.children[index].setAttribute("highlight", objDetails.value);
        } else if (objDetails.property == "projection") {
            let boolProjection = false;
            for (let i1 = 0; i1 < index; i1++) {
                let projection = xmlData.children[i1].getAttribute("projection") == "true" ? true : false;
                if (projection) {
                    xmlData.children[i1].removeAttribute("projection");
                }
            }
            xmlData.children[index].setAttribute("projection", objDetails.value);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let projection = xmlData.children[i1].getAttribute("projection");
                if (projection) {
                    boolProjection = projection;
                }
            }
            xmlData.setAttribute("projection", boolProjection);
        } else if (objDetails.property == "sortorder") {
            for (let i2 = 0; i2 < xmlData.children.length; i2++) {
                let sortorder = xmlData.children[i2].getAttribute("sortorder");
                if (sortorder) {
                    xmlData.children[i2].removeAttribute("sortorder");
                }
            }
            xmlData.children[index].setAttribute(objDetails.property, objDetails.value);
        } else if (objDetails.property == "graphicimage") {
            xmlData.children[index].setAttribute("graphicimage", objDetails.value);
            //
            let boolGraphicImage = false;
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                let graphicimage = xmlData.children[i1].getAttribute("graphicimage") == "true" ? true : false;
                if (graphicimage) {
                    boolGraphicImage = graphicimage;
                }
            }
            xmlData.setAttribute("graphicimage", boolGraphicImage);
        } else {
            xmlData.children[index].setAttribute("highlight", true);
            let highlightIcon = xmlData.children[index].getAttribute("highlighticonpath");
            if (highlightIcon) {
                xmlData.children[index].setAttribute("highlighticonpath", highlightIcon);
                xmlData.children[index].setAttribute("highlightstyle", "texticon");
            } else xmlData.children[index].setAttribute("highlightstyle", "text");
            if (objDetails.property == "highlightdescription") {
                xmlData.children[index].setAttribute("caption", objDetails.value);
            }
        }
    }
};

ChartUtils.prototype.addNode = function (xmlData, objDetails) {
    let itemIndex = 0;
    let length = xmlData.children.length;
    let chartName = xmlData.getAttribute("name");
    let numNodeCount = objDetails ? parseInt(objDetails.value) : "";
    // let boolgetDifferntStyle = numNodeCount
    let boolenablemenu = objDetails.enableMenu ? true : xmlData.getAttribute("data-menumaxseries") < numNodeCount;
    // if(objDetails.property=="nodecount"&&boolenablemenu){
    //     let shapeName = xmlData.getAttribute("graphicname");
    //     xmlData.removeAttribute("uniqueLayoutName");
    //     xmlData.removeAttribute("uniqueLayout");
    //     let result = MenuParser.getInstance().getMenuForChartNode("chart",shapeName,numNodeCount,"");
    //     objDetails.menu = result;
    //     objDetails.repeat= true;
    //     objDetails.property ="dropdowncount";
    //     SlideUtils.updateUniqueLayout(objDetails.slideId, result.name, "chart", result);
    //     ChartUtils.updateChartProperties(objDetails.slideId, objDetails);
    // }else{
    objDetails.index = numNodeCount;
    objDetails.operation = numNodeCount > length ? "add" : numNodeCount < length ? "delete" : "";
    let numNoOfItems = objDetails.operation == "add" ? numNodeCount - length : objDetails.operation == "delete" ? length - numNodeCount : 0;
    if (objDetails.operation == "add") {
        for (let i2 = 0; i2 < numNoOfItems; i2++) {
            let item = this.SvgUtils.createElement("metadata");
            let metaData = xmlData.parentElement.parentElement;
            let primaryName = xmlData.getAttribute("primarychart");
            let secondaryName = xmlData.getAttribute("secondarychart");
            this.seriesLength = metaData.querySelector(".metadata_group_chart").getAttribute("sublength");
            //let chartName = xmlData.getAttribute("name");
            //this.seriesLength = chartName=="logoGraphicComparisonChart"?(this.seriesLength+1):this.seriesLength;
            if (primaryName && secondaryName) {
                this.SvgUtils.assignAttributes(item, {
                    class: "chartitem",
                    name: "", //"Enter Label",
                    index: objDetails.index,
                    value: this.seriesLength < 1 ? "25" : this.addValue(xmlData, objDetails, i2),
                    secondaryvalue: this.seriesLength < 1 ? "25" : this.addValue(xmlData, objDetails, i2, "secondaryvalue"),
                    prefix: "",
                    suffix: "",
                    denomination: "",
                    sprefix: "",
                    ssuffix: "",
                    sdenomination: "",
                });
            } else {
                this.SvgUtils.assignAttributes(item, {
                    class: "chartitem",
                    name: "", //"Enter Label",
                    index: objDetails.index,
                    value: this.seriesLength < 1 ? "25" : this.addValue(xmlData, objDetails, i2),
                    prefix: "",
                    suffix: "",
                    denomination: "",
                });
            }

            xmlData.appendChild(item);
            for (let i1 = 0; i1 < xmlData.children.length; i1++) {
                xmlData.children[i1].attributes["index"].nodeValue = i1;
            }
        }
    } else if (objDetails.operation == "delete" || objDetails.property == "deleteasset") {
        for (let i2 = 0; i2 < numNoOfItems; i2++) {
            for (let i1 = 0; i1 < length; i1++) {
                itemIndex = parseInt(xmlData.children[i1].attributes["index"].nodeValue);
                if (objDetails.index < itemIndex) {
                    xmlData.children[i1].attributes["index"].nodeValue = itemIndex - 1;
                }
            }
            length--;
            let nodeItem = xmlData.children[length];
            xmlData.removeChild(nodeItem);
        }
    }
    if (objDetails.property == "nodecount" && boolenablemenu) {
        numNodeCount = xmlData.children.length;
        let slideElement = objDetails.slideobj.content.querySelector("div[id='ELEMENT_DIV']");
        let shapeName = xmlData.getAttribute("graphicname");
        xmlData.removeAttribute("uniqueLayoutName");
        xmlData.removeAttribute("uniqueLayout");
        let result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, numNodeCount, "");
        if (!result) {
            shapeName = ChartHelper.getOldMenu(shapeName);
            result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, numNodeCount, "");
        }
        objDetails.menu = result;
        objDetails.repeat = true;
        objDetails.property = "dropdowncount";
        if (result && result.jsonGraphicTemplateDetails && result.menu) {
            result.jsonGraphicTemplateDetails = result.name;
        }
        this.SvgUtils.assignAttributes(slideElement, {
            "data-json-graphic-template-details": result.jsonGraphicTemplateDetails,
        });
        SlideUtils.updateUniqueLayout(objDetails.slideId, result.name, "chart", result);
        // ChartUtils.updateChartProperties(objDetails.slideId, objDetails);
    }
    // }
};

ChartUtils.prototype.addValue = function (xmlData, objDetails, dropDownIndex = 0, property = "value") {
    let value;
    for (let i1 = 0; i1 < this.seriesLength; i1++) {
        if (i1 == 0) value = this.getChartValue(xmlData, objDetails, i1, dropDownIndex, property);
        else value += "," + this.getChartValue(xmlData, objDetails, i1, dropDownIndex, property); //",25";
    }
    return value;
};
ChartUtils.prototype.addDummyDiv = function (dummyNode, slideContent, slideid) {
    let root = slideContent.querySelector("div[id=GRAPHIC]");
    let Node = document.createElement("div");
    Node.id = "dummydiv" + slideid;
    root.appendChild(Node);
    Node.appendChild(dummyNode);
};

ChartUtils.prototype.removeDummyDiv = function (slideContent, slideid) {
    let root = slideContent.querySelector("div[id=GRAPHIC]");
    let svgNode = root.querySelector("div[id=dummydiv" + slideid + "]");
    root.removeChild(svgNode);
};
ChartUtils.prototype.getChartValue = function (xmlData, objDetails, valIndex, dropDownIndex, property = "value") {
    let index = 0;
    let value = 25;
    let range = "";
    let backValue = null;
    let frontValue = null;
    let dummyXmldata = xmlData.cloneNode(true);
    // this.doSort("asc", dummyXmldata, Number(dummyXmldata.children.length));
    let serieslength = dummyXmldata.children.length;
    let seriesItemlength = dummyXmldata.children[0].getAttribute(property).split(",").length;

    if (objDetails.type == "Column") {
        index = objDetails.columnIndex;
    } else if (objDetails.type == "Row" || objDetails.type == "ADD_ITEM" || objDetails.type == "DROPDOWN_SELECT" || !objDetails.type) {
        if (objDetails.type == "DROPDOWN_SELECT") index = serieslength;
        else index = objDetails.type == "Row" ? objDetails.rowIndex : objDetails.index - 1;

        if (index == 1) {
            range = "lower";
            let frontItem = dummyXmldata.children[index];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);
        } else if (index < serieslength) {
            range = "mid";
            let frontItem = dummyXmldata.children[index];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);

            let backItem = dummyXmldata.children[index - 1];
            if (backItem) backValue = parseInt(backItem.getAttribute(property).split(",")[valIndex]);
        } else if (serieslength == index) {
            range = "higher";
            let frontItem = dummyXmldata.children[index - 1];
            if (frontItem) frontValue = parseInt(frontItem.getAttribute(property).split(",")[valIndex]);
        }
    }

    if (frontValue && backValue) {
        value = this.getRangeValue(range, frontValue, backValue);
    } else if (backValue) {
        value = this.getRangeValue(range, backValue);
    } else if (frontValue) {
        value = this.getRangeValue(range, frontValue);
    } else value = Math.ceil(value * ((valIndex + 1) * 1.2));
    return value;
};

ChartUtils.prototype.getRangeValue = function (range, firstvalue, secondvalue = null) {
    let value;
    let difference;

    if (secondvalue != null) {
        if (secondvalue < firstvalue) {
            difference = firstvalue - secondvalue;
        } else if (secondvalue > firstvalue) {
            difference = secondvalue - firstvalue;
        } else {
            difference = 0;
        }
    }

    if (range == "lower") {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference;
            } else {
                value = firstvalue * 0.8;
            }
        } else {
            value = firstvalue * 0.8;
        }
    } else if (range == "higher") {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference;
            } else {
                value = firstvalue * 1.2;
            }
        } else {
            value = firstvalue * 1.2;
        }
    } else {
        if (secondvalue != null) {
            if (secondvalue < firstvalue) {
                value = secondvalue + difference / 2;
            } else if (secondvalue > firstvalue) {
                value = firstvalue + difference / 2;
            } else {
                value = firstvalue * 1.2;
            }
        } else {
            value = firstvalue;
        }
    }
    return Math.ceil(value);
};

