        this.valuePaddingleft = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 3 ? parseFloat(this.data.value.padding[3]) : "") : "";
        this.valuePaddingright = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 1 ? parseFloat(this.data.value.padding[1]) : "") : "";
        this.valuePaddingtop = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 0 ? parseFloat(this.data.value.padding[0]) : "") : "";
        this.valuePaddingbottom = this.data.value.hasOwnProperty("padding") ? (this.data.value.padding.length > 2 ? parseFloat(this.data.value.padding[2]) : "") : "";
        this.valuePadding = this.data.value.hasOwnProperty("padding") ? { left: this.valuePaddingleft, right: this.valuePaddingright, top: this.valuePaddingtop, bottom: this.valuePaddingbottom } : "";
