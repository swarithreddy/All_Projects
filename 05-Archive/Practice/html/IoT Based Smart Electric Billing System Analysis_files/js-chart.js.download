                    chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
                }
                const arrPathSplit = this._primaryPlaceholderPath[seriesIndex].split("/");
                this._primaryPlaceholderName[seriesIndex] = arrPathSplit[arrPathSplit.length - 1].split(".")[0];
            } else if (strPlaceholderType === "IMAGE") {
                this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
                if (
                    !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
                    (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
                    !this._primaryPlaceholderPath[seriesIndex].includes("http") ||
                    this._primaryPlaceholderPath[seriesIndex].includes("logoimage.png")
                ) {
                    let defaultImageHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
                    if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
                        defaultImageHolder = "genericassets/placeholderimages/logoplaceholder_landscape.png";
                    }
                    this._primaryPlaceholderPath[seriesIndex] = defaultImageHolder;
                    chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
                }
            } else if (strPlaceholderType === "LOGO") {
                this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
                if (!chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) || (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) || !this._primaryPlaceholderPath[seriesIndex].includes("http")) {
                    let defaultImageHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
                    this._primaryPlaceholderPath[seriesIndex] = defaultImageHolder;
                    chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
                }
            }
            this._primaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholderType);
        }
        if (this._compareDivider && this._comparePlaceholder) {
            this._primaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholderType);
        }
        if (strSecondaryPlaceHolder) {
            if (strSecondaryPlaceholderType === "ICON") {
                this._secondaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.secondaryplaceholder);
                if (this._secondaryPlaceholderPath[seriesIndex].split(".").length != 1 || this._secondaryPlaceholderPath[seriesIndex].includes("http")) {
                    this._secondaryPlaceholderPath[seriesIndex] = this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]; //this._chartPlaceHolder[seriesIndex].id;
                    chartItem.setAttribute(ChartPropertiesName.secondaryPlaceholder, this._secondaryPlaceholderPath[seriesIndex]);
                }
                const arrSecondaryPathSplit = this._secondaryPlaceholderPath[seriesIndex].split("/");
                this._secondaryPlaceholderName[seriesIndex] = arrSecondaryPathSplit[arrSecondaryPathSplit.length - 1].split(".")[0];
            }
            // else if (strSecondaryPlaceholderType === "IMAGE") {
            //     this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
            //     if (
            //         !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
            //         (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
            //         !this._primaryPlaceholderPath[seriesIndex].includes("http") ||
            //         this._primaryPlaceholderPath[seriesIndex].includes("logoimage.png")
            //     ) {
            //         let defaultImageHolder = "genericassets/placeholderimages/placeholder.png";
            //         if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
            //             defaultImageHolder = "genericassets/placeholderimages/logoplaceholder_landscape.png";
            //         }
            //         this._primaryPlaceholderPath[seriesIndex] = this._serverUrl + defaultImageHolder;
            //         chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
            //     }
            // } else if (strSecondaryPlaceholderType === "LOGO") {
            //     this._primaryPlaceholderPath[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder);
            //     if (
            //         !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder) ||
            //         (this._primaryPlaceholderPath[seriesIndex].split(".").length == "1" && !chartItem.getAttribute(ChartPropertiesName.primaryPlaceholder)) ||
            //         !this._primaryPlaceholderPath[seriesIndex].includes("http")
            //     ) {
            //         let defaultImageHolder = "genericassets/placeholderimages/logoimage.png";
            //         this._primaryPlaceholderPath[seriesIndex] = this._serverUrl + defaultImageHolder;
            //         chartItem.setAttribute(ChartPropertiesName.primaryPlaceholder, this._primaryPlaceholderPath[seriesIndex]);
            //     }
            // }
            this._secondaryPlaceholderType[seriesIndex] = chartItem.getAttribute(ChartPropertiesName.secondaryPlaceholderType);
        }

        if (strGraphicImage) {
            if (!strItemGraphicPath) {
                let defaultItemPlaceHolder = defaultImagePath ? defaultImagePath : this._serverUrl + "genericassets/placeholderimages/placeholder.png";
                if (this._chartName == "logoComparisonChart" || this.legendPlaceHolderType || this._chartName == "logoGraphicComparisonChart") {
                    defaultItemPlaceHolder = this._serverUrl + "genericassets/placeholderimages/logoplaceholder_landscape.png";
                }
                strItemGraphicPath = defaultItemPlaceHolder;
            }
            this._grapicImage[seriesIndex] = "true";
            this._itemGraphicPath[seriesIndex] = strItemGraphicPath;
            chartItem.setAttribute(ChartPropertiesName.itemGraphicPath, strItemGraphicPath);
        } else {
            this._grapicImage[seriesIndex] = "false";
            this._itemGraphicPath[seriesIndex] = "";
            if (strItemGraphicPath) {
                chartItem.removeAttribute(ChartPropertiesName.itemGraphicPath);
            }
        }

        if (this.baseProperties.hasEmphasis && strEmphasis == "true") {
            this._emphasisCount++;
            this._hasEmphasis = true;
            this._emphasis[seriesIndex] = true;
        } else {
            this._emphasis[seriesIndex] = false;
        }

        if ((this.baseProperties.hasProjectionEnable && strProjection == "true") || this._hasProjection) {
            if (this._projectionStartIndex == "") this._projectionStartIndex = seriesIndex;
            this._hasProjection = true;
            this._boolEnableProjectiontext = "true";
            this._projection[seriesIndex] = true;
        } else {
            this._hasProjection = false;
            this._boolEnableProjectiontext = "";
            this._projection[seriesIndex] = false;
        }

        for (let i1 = 0; i1 < length; i1++) {
            if (this._customProperties.showDataPoints == true) {
                if (this._customProperties.datapoint == "F" && seriesIndex == 0) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "L" && seriesIndex == this._seriesLength - 1) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "F,L" && (seriesIndex == this._seriesLength - 1 || seriesIndex == 0)) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else if (this._customProperties.datapoint == "H" || this._customProperties.datapoint == "LO" || this._customProperties.datapoint == "L,H") {
                    this._valueDisplayFormat[seriesIndex + " " + i1] = "hidden";
                } else if (this._customProperties.datapoint == "true" || this._customProperties.datapoint == "all" || this._customProperties.datapoint == "") this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
                else this._valueDisplayFormat[seriesIndex + " " + i1] = "hidden";
            } else if (this._customProperties.showDataPoints == false) this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
            if (this._lineHighlightPoint && this._chartName == "lineChart" && this._highlights[seriesIndex] && this._lineStyleHightlightValue[seriesIndex] == "true") {
                this._valueDisplayFormat[seriesIndex + " " + i1] = "visible";
            }
        }

        // for (let i2 = 0; i2 < length; i2++) {
        //     if (this._customProperties.showDataPoints == true) {
        //         if (this._customProperties.datapoint == "F" && seriesIndex == 0) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "L" && seriesIndex == this._seriesLength - 1) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "F,L" && (seriesIndex == this._seriesLength - 1 || seriesIndex == 0)) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else if (this._customProperties.datapoint == "H"||this._customProperties.datapoint == "LO"||this._customProperties.datapoint == "L,H") {
        //             this._valueDisplayFormat[seriesIndex + " " + i2] = "hidden";
        //         }
        //         else if (this._customProperties.datapoint == "true" || this._customProperties.datapoint == "all" || this._customProperties.datapoint == "")
        //             this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        //         else this._valueDisplayFormat[seriesIndex + " " + i2] = "hidden";
        //     } else if (this._customProperties.showDataPoints == false) this._valueDisplayFormat[seriesIndex + " " + i2] = "visible";
        // }
        if (this._showStatistical) {
            for (let s2 = 0; s2 < 2; s2++) {
                let tempValue = parseFloat(this._values[seriesIndex][0]) - parseFloat(this._values[seriesIndex][1]);
                let deciamlCount = tempValue.toString().split(".").length > 1 ? tempValue.toString().split(".")[1].length : 0;
                if (deciamlCount > 2) {
                    tempValue = tempValue.toFixed(2);
                }
                this.statisticalValues[seriesIndex] = tempValue;
            }
            this._seriesItemLength = 1;
        }
        this._primaryPlaceholderPathData[seriesIndex] = chartItem.getAttribute("primaryplaceholderpath") ? chartItem.getAttribute("primaryplaceholderpath") : chartItem.getAttribute("secondaryplaceholderpath");
    }
    let hasIconNode = this._primaryPlaceholderType.length > 0 ? this._primaryPlaceholderType.indexOf("ICON") > -1 : false;
    let hasLogoNode = this._primaryPlaceholderType.length > 0 ? this._primaryPlaceholderType.indexOf("logo") > -1 : false;
    if (hasLogoNode && hasIconNode) {
        this._hasIconLogoNode = true;
    } else {
        this._hasIconLogoNode = false;
    }
    this._customValueFontSize = this._data.getAttribute("data-customfontsize") && this._data.getAttribute("data-customfontsize") != "auto" ? parseFloat(this._data.getAttribute("data-customfontsize")) : "";
    this._customValueFontClass = this._data.getAttribute("data-customfontsizeclass") ? this._data.getAttribute("data-customfontsizeclass") : "";
    this._customTitleFontClass = this._data.getAttribute("data-titlefontclass") && this._data.getAttribute("data-titlefontclass") != "auto" ? this._data.getAttribute("data-titlefontclass") : "";
    this.hasCenter = this._chartName == "columnSimpleRectangle" && this.voLayout.labelInset == "inside" && this.voLayout.valueInset == "inside";
    let defaultArrowPosition = this.seriesItemLength == 2 ? "both" : "end";
    this._indualHighlightReverse = this._data.getAttribute("indualhdrev") ? this._data.getAttribute("indualhdrev") : defaultArrowPosition;
    this.sorValues(this._customProperties.sortType);
    if (this.baseProperties.oneatatime) {
        this.data.setAttribute("oneatatimeanimation", "true");
    }
    this.setLayout();
    this._longLabel = ChartHelper.getlabelRange(this._labels, this.data.getAttribute("labelheader"));
    if (this._chartName == "comparisonModelType3") {
        this._longLabel = ChartHelper.getCompareLabelRange(this._comparisonLabel, this._longLabel);
    }
    this._longsecondaryLabel = ChartHelper.getsecondarylabelRange(this._secondaryText);
    if (this._chartName == "lineChart" && this._designerUI) {
        this.customProperties.showYAxisGrid = true;
    }

    // const valuesRange = ChartHelper.getValuesRange(this._values, this.customProperties.showYAxisGrid, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems);
    let valuesRange = ChartHelper.getValuesRange(this._values, false, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems, this._displayValueFormat);
    let longValue = "";
    if (this._showStatistical) {
        valuesRange = ChartHelper.getValuesRange(this._values, false, this._customProperties.yAxisMaxValue, 1, this._displayValueFormat);
    }
    this._longValue = longValue ? longValue : valuesRange.longValue;
    this._rangeTotal = valuesRange.rangeTotal;
    this._totalValue = valuesRange.totalValue;
    this._rangePositive = valuesRange.rangePositive;
    this._rangeNegative = valuesRange.rangeNegative;
    this._seconPostiveHighValue = valuesRange.secondPositiveHighValue;
    this._seconNagativeHighValue = valuesRange.secondNegativeHighValue;
    this._minValue = valuesRange.minvalue;
    this._postiveMaxValue = valuesRange.rangePositive;
    this._longLengthValue = valuesRange.longLengthValue;
    this._seriesItemMaxValue = valuesRange.seriesItemMaxValue;
    this._maxValueSeconPostiveHighValue = valuesRange.hasMaxSecondHighValue;
    if (this._minValue < 0 || this._seriesLength > 15 || (this._seriesItemLength > 1 && this._seriesLength > 10)) {
        this._indualHighlight = false;
    }
    if (this._seconPostiveHighValue < 1) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    // if(this._displayValueFormat == "percentage"){
    //     this._valuesDenomination[seriesIndex][i1] =
    // }
    this.data.setAttribute("minvalue", this._minValue);
    if (this.data.getAttribute("valueprefixtype") && this.data.getAttribute("valueprefixtype").split(",").length > 0) {
        let prefix = this.data.getAttribute("valueprefixtype").split(",")[0];
        this._longLengthValue = prefix + valuesRange.longLengthValue;
    }
    if (this.data.getAttribute("valuesuffixtype") && this.data.getAttribute("valuesuffixtype").split(",").length > 0) {
        let suffix = this.data.getAttribute("valuesuffixtype").split(",")[0];
        this._longLengthValue += suffix;
    }
    let differencePostivePercentage = this._rangePositive / this._seconPostiveHighValue > 1000;
    let differenceNegativePercentage = this._rangeNegative / this._seconNagativeHighValue > 1000;
    let minNodeCount = parseInt(this._seconPostiveHighValue).toString().length;
    let maxNodeCount = parseInt(this._postiveMaxValue).toString().length;
    if (this._minValue < 0) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    let svaluesRange = ChartHelper.getValuesRange(this._secondaryValues, false, this._customProperties.yAxisMaxValue, this.baseProperties.maxAllowedSeriesItems, this._displayValueFormat);
    this._slongValue = svaluesRange.longValue;
    this._srangeTotal = svaluesRange.rangeTotal;
    this._stotalValue = svaluesRange.totalValue;
    this._srangePositive = svaluesRange.rangePositive;
    this._srangeNegative = svaluesRange.rangeNegative;
    this._sseconPostiveHighValue = svaluesRange.secondPositiveHighValue;
    this._sseconNagativeHighValue = svaluesRange.secondNegativeHighValue;
    this._sminValue = svaluesRange.minvalue;
    this._spostiveMaxValue = svaluesRange.rangePositive;
    this._slongLengthValue = svaluesRange.longLengthValue;
    // if(differenceNegativePercentage||differencePostivePercentage){
    //     this._highValueBreak = true;
    // }
    if (this.customProperties.showYAxisGrid && !this._customProperties.yAxisMaxValue && this._minValue < 0 && !this._highValueBreak) {
        let dummeyNegativeValue = -this._rangeNegative;
        let maxTotalValue = dummeyNegativeValue + this._rangePositive;
        let gapValues = maxTotalValue / 5;
        let gapCount = gapValues;
        let DummeyCont = 0;
        // this._rangeNegative = this._rangeNegative-20;
        // this._rangePositive = dummeyNegativeValue*4;
        // this._rangeTotal = (this._rangePositive);
        let negativeSideValue = 0;
        while (dummeyNegativeValue > negativeSideValue) {
            DummeyCont++;
            negativeSideValue = gapValues * DummeyCont;
            if (negativeSideValue > dummeyNegativeValue) {
                if (this._chartName == "lineChart") {
                    this._rangeNegative = -negativeSideValue;
                }
                this._negativeGridCount = DummeyCont;
                break;
            }
        }
        let secondaryDummeyCont = 5 - DummeyCont;
        let positiveSideValue = 0;
        while (this._rangePositive > positiveSideValue) {
            positiveSideValue = gapValues * secondaryDummeyCont;
            if (positiveSideValue >= this._rangePositive) {
                this._positiveGridCount = secondaryDummeyCont;
                if (this.baseProperties.referenceName != "bar") {
                    // this._rangePositive = positiveSideValue;
                    // this._rangeTotal = positiveSideValue;
                }
                break;
            }
            secondaryDummeyCont++;
        }
    }
    if (this._chartName == "barStackedRectangle" || this._chartName == "columnStackedRectangle") this._rangeTotal = this._maxStackValueTotal;
    this._gridCount = ChartHelper.gridCountValidation(this._rangeTotal, this.gridCount);
    // if (this.rangeNegative < 0) {
    //     this.customProperties.showYAxisGrid = false;
    //     this.customProperties.showYAxisLine = false;
    //     this.customProperties.showXAxisLine = false;
    //     this.customProperties.showYAxisGridValue = false;
    // }
    let valuedifference = maxNodeCount - minNodeCount >= 3;
    if (valuedifference) {
        if (!this.presentMode) this.data.setAttribute("highvaluebreak", "true");
    } else {
        this.data.removeAttribute("highvaluebreak");
    }

    if (!this.baseProperties.highvaluebreak) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
    }
    this._highValueBreak = (this.data.getAttribute("highvaluebreak") == "true" && this.data.getAttribute("userhighvaluebreak") != "false") || this.data.getAttribute("userhighvaluebreak") == "true" ? true : false;
    if (this._seconPostiveHighValue < 1) {
        this.data.removeAttribute("highvaluebreak");
        this.data.removeAttribute("userhighvaluebreak");
        this._highValueBreak = false;
    }
    if (this._highValueBreak) {
        this._gridCount = 5;
    } else {
        this.data.removeAttribute("highvaluebreak");
    }
    if (this.highvaluebreak && this.voLayout.labelItemBased != "true") {
        this.customProperties.showYAxisGrid = true;
    }
    for (let s1 = 0; s1 < this._seriesLength; s1++) {
        for (let k1 = 0; k1 < this._seriesItemLength; k1++) {
            if (this._customProperties.showDataPoints == true) {
                if (this._customProperties.datapoint == "H" || this._customProperties.datapoint == "L,H") {
                    if (this._longValue == this._values[s1][k1]) {
                        this._valueDisplayFormat[s1 + " " + k1] = "visible";
                    }
                }
                if (this._customProperties.datapoint == "LO" || this._customProperties.datapoint == "L,H") {
                    if (valuesRange.minvalue == this._values[s1][k1]) {
                        this._valueDisplayFormat[s1 + " " + k1] = "visible";
                    }
                }
            }
            if (this.statisticalValues.length > 0) {
                this._statiSticalLongValue = this.statisticalValues[s1].length > this._statiSticalLongValue.length ? this.statisticalValues[s1] : this._statiSticalLongValue;
            }
            if (this._suffix[s1][k1] == "%" && !this.baseProperties.maxPercentageValue && this._displayValueFormat != "percentage") this._suffix[s1][k1] = "";
            if ((this._displayValueFormat == "currency" || this._displayValueFormat == "asentered") && this._valuesDenomination[s1][k1] && this._valuesDenomination[s1][k1].includes("$") && this._prefix[s1][k1].includes("$")) {
                this._prefix[s1][k1] = "";
            }
        }
    }
    this.getLongValue();
    if (this._displayValueFormat != "percentage") {
        for (let k1 = 0; k1 < this._valuesDenomination.length; k1++) {
            longValue = ChartHelper.getCompareLabelRange(this._valuesDenomination[k1], longValue);
        }
    }
    if (longValue) {
        this._longValue = longValue;
        this._longLengthValue = longValue;
    }
    if (this._chartName == "waterfallchart") {
        this._waterFallData = this.makeWaterfallData();
    }
    if (this._chartName == "comparisonModelType3") this.compareValueFormation();

    if (this.data.getAttribute("data-connectorline")) {
        this._connectorLine = true;
        this._connectorLineType = this.data.getAttribute("data-type");
        this._connectorLineColor = this.data.getAttribute("data-color");
        this._connectorLinedashArray = "15,15";
        this._connectorLineStyle = this.data.getAttribute("data-style");
    }
    if (this.data.getAttribute("data-comparestyle")) {
        this.compareStyle = this.data.getAttribute("data-comparestyle");
    }
    if (this.data.getAttribute("data-logocompare")) {
        this._logoCompare = true;
    }
    if (this.data.getAttribute("data-highlightdifference") && this._seriesItemLength < 2) {
        if (this.data.getAttribute("highlightdifferencemenupoint1")) {
            let strFirstvalue = this.data.getAttribute("highlightdifferencemenupoint1");
            let hdIndex = 1;
            switch (strFirstvalue) {
                case "first":
                    hdIndex = 0;
                    break;
                case "last":
                    hdIndex = this.data.children.length - 1;
                    break;
                case "middle":
                    hdIndex = parseInt(this.data.children.length / 2);
                    break;
                default:
                    hdIndex = parseInt(strFirstvalue) - 1;
                    break;
            }
            this.data.setAttribute("highlightdifferencepoint1", hdIndex);
        }
        if (this.data.getAttribute("highlightdifferencemenupoint2")) {
            let strSecondvalue = this.data.getAttribute("highlightdifferencemenupoint2");
            let hdSecondIndex = 1;
            switch (strSecondvalue) {
                case "first":
                    hdSecondIndex = 0;
                    break;
                case "last":
                    hdSecondIndex = this.data.children.length - 1;
                    break;
                case "middle":
                    hdSecondIndex = parseInt(this.data.children.length / 2);
                    break;
                default:
                    hdSecondIndex = parseInt(strSecondvalue) - 1;
                    break;
            }
            this.data.setAttribute("highlightdifferencepoint2", hdSecondIndex);
        }
        this.boolHighlightDifference = !this.presentMode ? (this.baseProperties.highlightdifference ? true : false) : this.data.getAttribute("orginalLength") == this.data.children.length;
        this.highlightDiffernecPoint1 = this.data.getAttribute("highlightdifferencepoint1") ? this.data.getAttribute("highlightdifferencepoint1") : 0;
        this.highlightDiffernecPoint2 = this.data.getAttribute("highlightdifferencepoint2") ? this.data.getAttribute("highlightdifferencepoint2") : this.seriesLength - 1;
        this.highlightDifferenceStyle = this.data.getAttribute("data-highlight-style") ? this.data.getAttribute("data-highlight-style") : "style1";
        this.highlightdifferencedisplayFormat = this.data.getAttribute("highlightdifferencedisplay") ? this.data.getAttribute("highlightdifferencedisplay") : "";
        this.highlightDifferceText = this.data.getAttribute("highlightdifferencedescription") ? this.data.getAttribute("highlightdifferencedescription") : "";
    }
    if (this._chartName == "columnSimpleRectangle" && (this.voLayout.valueItemBased == "true" || this.voLayout.labelItemBased == "true")) {
        this.boolHighlightDifference = false;
        this.seriesItemLength = 1;
    }
    if (this.boolHighlightDifference || this._indualHighlight || this._highValueBreak || this.data.getAttribute("isTakeaway") == "true") {
        this._boolenaclebaseline = false;
        this._forcedisableBaseline = true;
        this.data.removeAttribute("axisbaseline");
        this.data.removeAttribute("data-baseline");
    }
    if (this.data.getAttribute("isTakeaway") == "true") {
        this.boolHighlightDifference = false;
    }
    this.objHighlightDifferenceDetails = {
        display: this.boolHighlightDifference,
        point1: this.highlightDiffernecPoint1,
        point2: this.highlightDiffernecPoint2,
        style: this.highlightDifferenceStyle,
        displayFormat: this.highlightdifferencedisplayFormat,
    };

    if (this.data.getAttribute("data-highlightdifference") && this.seriesItemLength > 1) {
        this._indualHighlight = true;
    }
    if (!this.baseProperties.highlightdifference || this.data.getAttribute("isTakeaway") == "true") {
        this._indualHighlight = false;
    }
    if (this.voLayout.itemborder) {
        this._shapeBoder = true;
        this.__shapeBoderSize = this.voLayout.itemborder.width ? this.voLayout.itemborder.width : 0;
        this._boderColor = this.voLayout.itemborder.color;
        this._boderAlign = this.voLayout.itemborder.alignment;
    }
    if (this.data.getAttribute("valueformat") == "percentage" && this.seriesLength != 1 && this._rangeTotal > 100 && !this.baseProperties.maxPercentageValue) {
        this.valueFormat();
        this.data.setAttribute("ispercentageChart", "true");
        this._disableEdit = true;
    } else {
        this.data.removeAttribute("ispercentageChart");
    }
    if (this.baseProperties.disablevalueedit) {
        this._disableEdit = true;
    }
    if (this.data.getAttribute("valueformat") == "percentage" && this.seriesLength != 1) {
        this._disableEdit = true;
    }
    if (this._displayValueFormat == "percentage") {
        for (let k1 = 0; k1 < this._valuesDenomination.length; k1++) {
            longValue = ChartHelper.getCompareLabelRange(this._valuesDenomination[k1], longValue);
            longValue = longValue.includes("%") ? longValue : longValue + "%";
        }
    }
    if (longValue) {
        this._longValue = longValue;
        this._longLengthValue = longValue;
    }
    if (this._boolcommonPlaceholder) {
        let strCommonPlacHolderPath = this.data.getAttribute("commonplaceholderpath");
        let CommonPlacHolderTextvalue = this.data.getAttribute("commonplaceholdertext");
        let strCommonPlacHolder = this.data.getAttribute("commonplaceholder");
        if (strCommonPlacHolder) {
            this.strCommonPlacHolderText = CommonPlacHolderTextvalue ? CommonPlacHolderTextvalue : "";
        } else {
            this.strCommonPlacHolderText = CommonPlacHolderTextvalue ? CommonPlacHolderTextvalue : "";
        }
        let strCommonPlaceholder = this._boolcommonPlaceholder == "image" ? "genericassets/placeholderimages/placeholder.png" : this._boolcommonPlaceholder == "logo" ? "genericassets/placeholderimages/logoplaceholder_landscape.png" : "genericassets/placeholderimages/placeholder.png";
        if (strCommonPlacHolder) {
            this.commonplacholder = this._boolcommonPlaceholder == "image" || this._boolcommonPlaceholder == "logo" ? (strCommonPlacHolderPath && !strCommonPlacHolderPath.includes(".svg") ? strCommonPlacHolderPath : this._serverUrl + strCommonPlaceholder) : strCommonPlacHolder;
        } else {
            this.commonplacholder = this._boolcommonPlaceholder == "image" || this._boolcommonPlaceholder == "logo" ? (strCommonPlacHolderPath && !strCommonPlacHolderPath.includes(".svg") ? strCommonPlacHolderPath : this._serverUrl + strCommonPlaceholder) : "placeholder";
            if (this._boolcommonPlaceholder == "logo" && !strCommonPlacHolderPath) {
                this.commonplacholder = this._serverUrl + "genericassets/placeholderimages/logoplaceholder_landscape.png";
            }
        }
    }
    if (this.compareStyle == "style1") {
        let strCommonPlacHolderPath = this.data.getAttribute("commonplaceholderpath");
        let compareTextValue = this.data.getAttribute("comparetext");
        this._strComoareText = compareTextValue ? compareTextValue : "";
    }
    if (this._designerUI) {
        this.stremphasisName = "emphasize-grey,emphasize-basic-fill,emphasize-alpha";
    }
    if (this._designerUI) {
        this.strprojectionName = "projection-grey,projection-grey";
    }
    if (this.stremphasisName) {
        this._emphasisName = this.stremphasisName.split(",")[0];
    }
    if (this.strprojectionName) {
        this.arrprojectionName = this.strprojectionName.split(",");
        this._projectionName = this.arrprojectionName[0];
        if (this.baseProperties.emphasisstyle == "greyemphasize") {
            this._projectionName = this.arrprojectionName[1];
        } else if (this.baseProperties.emphasisstyle == "alphaemphasize") {
            this._projectionName = this.arrprojectionName.length > 2 ? this.arrprojectionName[2] : this.arrprojectionName[1];
        }
    }

    if (!!this.baseProperties.emphasisstyle && this.stremphasisName) {
        let arrayemphasis = this.stremphasisName.split(",");
        if (this.baseProperties.emphasisstyle == "greyemphasize") {
            this._emphasisName = "emphasize-grey";
        }
        if (this.baseProperties.emphasisstyle == "alphaemphasize") {
            this._emphasisName = arrayemphasis.length > 2 ? arrayemphasis[2] : arrayemphasis[1];
        }
    }
    if (this.voLayout.placeholderheder && this.data.getAttribute("boolplaceholderheader") != "false") {
        this.data.setAttribute("boolplaceholderheader", "true");
    }
    if (this.voLayout.itemHeader && this.data.getAttribute("boolitemheader") != "false") {
        this.data.setAttribute("boolitemheader", "true");
    }
    if (this.voLayout.labelHeaderTitle && this.data.getAttribute("boollabelheader") != "false") {
        this.data.setAttribute("boollabelheader", "true");
    }
    if (this.voLayout.valueHeaderTitle && this.data.getAttribute("boolvalueheader") != "false") {
        this.data.setAttribute("boolvalueheader", "true");
    }
    this._itemHeaderTitle = this.data.getAttribute("itemheader") ? this.data.getAttribute("itemheader") : "";
    this._enableItemHeader = this.data.getAttribute("boolitemheader") ? this.data.getAttribute("boolitemheader") == "true" : false;
    this._labelHeaderTitle = this.data.getAttribute("labelheader") ? this.data.getAttribute("labelheader") : "";
    this._enableLabelHeader = this.data.getAttribute("boollabelheader") ? this.data.getAttribute("boollabelheader") == "true" : false;
    this._secondaryHeaderTitle = this.data.getAttribute("secondaryheader") ? this.data.getAttribute("secondaryheader") : "";
    this._enablePlaceholderHeader = this.data.getAttribute("boolplaceholderheader") ? this.data.getAttribute("boolplaceholderheader") == "true" : false;
    this._valueHeaderTitle = this.data.getAttribute("valueheader") ? this.data.getAttribute("valueheader") : "";
    this._enableValueHeader = this.data.getAttribute("boolvalueheader") ? this.data.getAttribute("boolvalueheader") == "true" : false;
    this._boolEnableHeader = (this._labelHeaderTitle || this._enableValueHeader || this._enablePlaceholderHeader || this._enableItemHeader) && (this.voLayout.haslabelHeaderTitle || this.voLayout.hasValueHeaderTitle || this.voLayout.hasitemHeaderTitle);
    this._chartFonts = new window["ChartFonts"](this._fontDetails, this);
    this.baseProperties.grid = this.voLayout.itemCoinChart == "true" ? false : this.baseProperties.grid;
    if (this._headerValueDisplayFormat == "calvalueheader" || (this.voLayout.valueCalculateTitle && this._headerValueDisplayFormat == "")) {
        this.data.setAttribute("valueheaderformat", "calvalueheader");
        this._headerValueDisplayFormat = "calvalueheader";
        let valueHeaderData = this.getValueTitleText(this.voLayout);
        if (valueHeaderData) {
            let arrHeaderValue = { input: valueHeaderData.toString() };
            arrHeaderValue = this.ChartUtils.formatChartValues(arrHeaderValue);
            if (this._displayValueFormat == "asentered") {
                this._valueHeaderTitle = valueHeaderData.toLocaleString("en-US", { currency: "USD" });
            } else {
                this._valueHeaderTitle = arrHeaderValue.valueSystem + arrHeaderValue.currencySystem;
            }
        }
    }
    if (this._chartFlip) {
        let topLeftRadius;
        let topRightRadius;
        let bottomLeftRadius;
        let bottomRightRadius;
        if (this.voLayout.borderRadiusValues) {
            topLeftRadius = this.voLayout.borderRadiusValues.letftop;
            topRightRadius = this.voLayout.borderRadiusValues.righttop;
            bottomLeftRadius = this.voLayout.borderRadiusValues.leftbottom;
            bottomRightRadius = this.voLayout.borderRadiusValues.rightbottom;

            this.voLayout.borderRadiusValues.letftop = bottomLeftRadius;
            this.voLayout.borderRadiusValues.leftbottom = topLeftRadius;
            this.voLayout.borderRadiusValues.rightbottom = topRightRadius;
            this.voLayout.borderRadiusValues.righttop = bottomRightRadius;
        }
        if (this.voLayout.backgroundBorderRadiusValues) {
            topLeftRadius = this.voLayout.backgroundBorderRadiusValues.letftop;
            topRightRadius = this.voLayout.backgroundBorderRadiusValues.righttop;
            bottomLeftRadius = this.voLayout.backgroundBorderRadiusValues.leftbottom;
            bottomRightRadius = this.voLayout.backgroundBorderRadiusValues.rightbottom;

            this.voLayout.backgroundBorderRadiusValues.letftop = bottomLeftRadius;
            this.voLayout.backgroundBorderRadiusValues.leftbottom = topLeftRadius;
            this.voLayout.backgroundBorderRadiusValues.rightbottom = topRightRadius;
            this.voLayout.backgroundBorderRadiusValues.righttop = bottomRightRadius;
        }
    }
    if ((this.data.getAttribute("axisbaseline") || this.data.getAttribute("data-baseline")) && this.chartName != "column3DRectangle" && this.chartName != "bar3DChart") {
        // this.customProperties.showYAxisGrid = false;
    }
    if (this.seriesLength != 1 && (this.chartName.includes("pie") || this.chartName.includes("Pie") || this.chartName.includes("doughnut") || this.chartName.includes("Doughnut"))) {
        this.baseProperties.type2Percentage = true;
        this.baseProperties.maxPercentageValue = "true";
    }
    this._boolPercentageChart = this.checkPecentageChart();
    if (this._stackedPercentage && this._boolPercentageChart) {
        for (let s1 = 0; s1 < this._values.length; s1++) {
            let total = 0;
            for (let s2 = 0; s2 < this._values[s1].length; s2++) {
                if (this._seriesItemMaxValue[s1] > 100) {
                    let difference = 100 / this._seriesItemMaxValue[s1];
                    this._values[s1][s2] = this._values[s1][s2] * difference;
                    total += parseFloat(this._values[s1][s2]);
                    this._stackSeriesvalueTotal[s1] = total;
                }
            }
            for (let s3 = 0; s3 < this._values[s1].length; s3++) {
                let stackeddifferenceValue = 100 / this._stackSeriesvalueTotal[s1];
                this._values[s1][s3] = this._values[s1][s3] * stackeddifferenceValue;
                if (this._displayValueFormat != "asentered") this._valuesDenomination[s1][s3] = this.checkFloat(this._values[s1][s3]) ? parseFloat(this._values[s1][s3]).toFixed(2) : parseFloat(this._values[s1][s3]);
            }
            if (this._seriesItemMaxValue[s1] > 100) {
                this._stackSeriesvalueTotal[s1] = 100;
            }
        }
    }
    if ((this.baseProperties.maxPercentageValue == "true" || this.baseProperties.maxPercentageValue) && (!this._stackedPercentage || !this._boolPercentageChart)) {
        let totalValue = 0;
        for (let p1 = 0; p1 < this._values.length; p1++) {
            if (this._boolPercentageChart && this._postiveMaxValue > 100) {
                let differenceValue = 100 / this._postiveMaxValue;
                this._values[p1][0] = this._values[p1][0] * differenceValue;
                let hasArraValues = this._values[p1][0].toString().split(".");
                if (hasArraValues.length > 1 && hasArraValues[1].length > 3) {
                    this._values[p1][0] = this._values[p1][0].toFixed(1);
                }
                totalValue += parseFloat(this._values[p1][0]);
            }
        }

        if (this._boolPercentageChart && this.baseProperties.type2Percentage) {
            totalValue = totalValue == 0 ? this._totalValue : totalValue;
            let type2differenceValue = 100 / totalValue;
            totalValue = 0;
            for (let v1 = 0; v1 < this._values.length; v1++) {
                this._values[v1][0] = this._values[v1][0] * type2differenceValue;
                totalValue += parseFloat(this._values[v1][0]);
                if (this._displayValueFormat != "asentered") this._valuesDenomination[v1][0] = this.checkFloat(this._values[v1][0]) ? parseFloat(this._values[v1][0]).toFixed(2) : parseFloat(this._values[v1][0]);
            }
            this._totalValue = totalValue ? totalValue : this._totalValue;
        }
        if (this._boolPercentageChart && this.seriesLength == 1) {
            if (this._displayValueFormat != "asentered") this._valuesDenomination[0][0] = this._values[0][0];
        }
        if (this._boolPercentageChart && this._postiveMaxValue > 100) {
            this._rangePositive = 100;
            this._postiveMaxValue = 100;
            this._totalValue = totalValue ? totalValue : this._totalValue;
        }
    }
    if (this.baseProperties.customMaxValue) {
        let customMaxValue = this.data.getAttribute("custommaxvalue");
        customMaxValue = customMaxValue ? customMaxValue : this._rangePositive;
        this._rangePositive = customMaxValue;
        this.data.setAttribute("yaxismaxvalue", customMaxValue);
    }
    if (this.voLayout.labelInset == "inside" && this.voLayout.valueInset == "inside" && this.voLayout.labelSamePos == "true" && this.voLayout.valueSamePos == "true" && this._chartName == "columnStackedRectangle") {
        this._boolEnableWidthReducer = true;
    }
    let iconSize = this.data.getAttribute("iconsize");
    switch (iconSize) {
        case "iconsmall":
            this._iconSizeRatio = 0.5;
            break;
        case "iconmedium":
            this._iconSizeRatio = 0.75;
            break;
        case "iconlarge":
            this._iconSizeRatio = 1;
            break;
    }
    if (this.seriesanimation) {
        this.dummerSeriesItemLength = this.data.children[0].getAttribute("value").split(",");
    }
    if (this.data.getAttribute("changetablecontent") == "true") {
        this._tabelRowLength = this.seriesLength;
        this._tableColumnLength = this._values[0].length + 1;
        if (this._chartName == "waterfallchart") {
            this._tableColumnLength = 2;
        }
        this._arrTableContent = [];
        for (let r1 = 0; r1 < this._seriesLength; r1++) {
            this._arrTableContent.push([]);
            for (let c1 = 0; c1 < this._tableColumnLength; c1++) {
                let object = { type: "text", elementtype: "", value: "" };
                if (c1 == 0) {
                    object = { type: "text", elementtype: "label", value: this._labels[r1], indexvalue: r1 };
                    this._arrTableContent[r1].push(object);
                    object = { type: "text", elementtype: "value", value: this._values[r1][c1], indexvalue: r1 + "_" + c1 };
                    this._arrTableContent[r1].push(object);
                } else {
                    if (this._values[r1][c1]) {
                        object = { type: "text", elementtype: "value", value: this._values[r1][c1], indexvalue: r1 + "_" + c1 };
                        this._arrTableContent[r1].push(object);
                    }
                }
            }
        }
        let xAxisTitle = this.data.getAttribute("xaxistitle") || "Label";
        let yaxisTitle = this.data.getAttribute("yaxistitle") || "Value";
        let xAxisObject = { value: xAxisTitle, type: "text", elementtype: "label" };
        let yAxisObject = { value: yaxisTitle, type: "text", elementtype: "label" };
        let arrHeader = [xAxisObject, yAxisObject];
        this._arrTableHeaderLabel = arrHeader;
        this._arrTableHeaderLabel = JSON.parse(JSON.stringify(arrHeader));
        let multiserieslegend = this.data.getAttribute("multiserieslegend") ? this.data.getAttribute("multiserieslegend").split(",") : [];
        if (multiserieslegend.length > 0) {
            this._arrTableHeaderLabel = [xAxisObject];
        } else {
            if (this._seriesItemLength > 1 && this.showLegend && this.data.getAttribute("customlegend") != "true") {
                this.showLegend = false;
            }
        }
        for (let i1 = 0; i1 < multiserieslegend.length; i1++) {
            this._arrTableHeaderLabel.push({ value: multiserieslegend[i1], type: "text", elementtype: "label" });
        }
    }
    if (this._displayValueFormat) {
        this.data.setAttribute("maindisplayformat", this._displayValueFormat);
    }
}
VOData.prototype.checkLongLabel = function (value) {
    let promptLongValue = "";
    for (let p1 = 0; p1 < value.length; p1++) {
        for (let p2 = 0; p2 < value[p1].length; p2++) {
            promptLongValue = promptLongValue.length > value[p1][p2].length ? promptLongValue : value[p1][p2];
        }
    }
    return promptLongValue;
};
VOData.prototype.checkFloat = function (value) {
    let parsed = Number.parseFloat(value);
    return !Number.isNaN(parsed) && !Number.isInteger(parsed);
};

VOData.prototype.checkPecentageChart = function () {
    let suffixDatas = this._suffix;

    for (let i1 = 0; i1 < suffixDatas.length; i1++) {
        if ((this.baseProperties.suffixData || this.baseProperties.defaultPercentage == "true") && this._displayValueFormat == "percentage" && suffixDatas[i1] == "") {
            suffixDatas[i1] = "%";
            this._suffix[i1] = "%";
        }
        if (this._stackedPercentage && (this.baseProperties.suffixData || this.baseProperties.defaultPercentage == "true") && this._displayValueFormat == "percentage" && suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "") {
            for (let s1 = 0; s1 < suffixDatas[i1].length; s1++) {
                suffixDatas[i1][s1] = "%";
                this._suffix[i1][s1] = "%";
            }
            if (i1 == suffixDatas.length - 1 && this._currencySymbol[i1][0] == "") return true;
        }
        if (this._displayValueFormat != "percentage") {
            // this._suffix[i1][0] ="";
            if (i1 == suffixDatas.length - 1) return false;
        } else {
            if ((suffixDatas[i1] == "%" || (suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "%")) && this._currencySymbol[i1][0] == "") {
                if (i1 == suffixDatas.length - 1) return true;
            } else {
                return false;
            }
        }
    }
};
VOData.prototype.getValueTitleText = function (layout) {
    let calculateValue = this._totalValue / this._seriesLength;

    return Number(calculateValue).toFixed(1);
};
VOData.prototype.getLongValue = function (arrayValues = null) {
    let arrList = arrayValues ? arrayValues : this._values;
    const length = arrList.length;
    let longValue;
    for (let i1 = 0; i1 < length; i1++) {
        const subLength = this.baseProperties.maxAllowedSeriesItems == 1 ? 1 : arrList[i1].length;
        for (let j1 = 0; j1 < subLength; j1++) {
            if (i1 == 0 && j1 == 0) {
                longValue = (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString();
            }
            longValue = longValue.length < (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString().length ? (this._prefix[i1][j1] + arrList[i1][j1] + this._suffix[i1][j1]).toString() : longValue;
        }
        this._longValue = longValue;
    }
};
VOData.prototype.getsLongValue = function () {
    let arrList = this._secondaryValues;
    const length = arrList.length;
    let longValue;
    for (let i1 = 0; i1 < length; i1++) {
        const subLength = this.baseProperties.maxAllowedSeriesItems == 1 ? 1 : arrList[i1].length;
        for (let j1 = 0; j1 < subLength; j1++) {
            if (i1 == 0 && j1 == 0) {
                longValue = (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString();
            }
            longValue = longValue.length < (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString().length ? (this._sprefix[i1][j1] + arrList[i1][j1] + this._ssuffix[i1][j1]).toString() : longValue;
        }
        this._slongValue = longValue;
    }
};
VOData.prototype.valueFormat = function () {
    let length = this._valuesDenomination.length;
    for (let i1 = 0; i1 < length; i1++) {
        let arrValue = this._values[i1];
        let strValue = "";
        for (let i2 = 0; i2 < arrValue.length; i2++) {
            if (i2 == 0) strValue = parseFloat((Number(arrValue[i2]) / this._rangeTotal) * 100).toFixed(0);
            else strValue = parseFloat((Number(arrValue[i2]) / this._rangeTotal) * 100).toFixed(0);
            this._suffix[i1][i2] = "%";
            this._valuesDenomination[i1][i2] = strValue;
        }
    }
    this.getLongValue(this._valuesDenomination);
};

VOData.prototype.setLayout = function () {
    if (this.customProperties.datapoint == "none") this.validHover = true;
    if (this.validHover && this.customProperties.datapoint == "none") {
        this.customProperties.showYAxisGrid = this.baseProperties.grid ? true : false;
        // this.customProperties.showYAxisLine = true;
        // this.customProperties.showXAxisLine = true;
        this.customProperties.showYAxisGridValue = true;
    }
};

VOData.prototype.makeWaterfallData = function () {
    let objData = {};
    let strValue = "";
    let arrValue = [];
    let numValue = 0;
    let numMaxValue = 0;
    let numStartPoint = 0;
    let numPosMaxValue = 0;
    let numNegMaxValue = 0;
    let numLastSumValue = 0;
    let isSumValue = false;
    let nextPoint;
    for (let i1 = 0; i1 < this.seriesLength; i1++) {
        isSumValue = false;
        strValue = this._values[i1][0];
        numValue = parseFloat(strValue);
        if (i1 == this.seriesLength - 1) {
            strValue = "sum";
            // this.data.children[i1].setAttribute("value", "sum");
        }

        if (strValue.toLowerCase() == "sum") {
            isSumValue = true;
            numValue = numLastSumValue;
            numLastSumValue = 0;
            nextPoint = numStartPoint;
        } else {
            numLastSumValue += numValue;
            nextPoint = numStartPoint + numValue;
        }
        if (0 < numValue) {
            if (numPosMaxValue < nextPoint) numPosMaxValue = nextPoint;
        } else {
            if (nextPoint < numNegMaxValue) numNegMaxValue = nextPoint;
        }
        if (strValue.toLowerCase() == "sum") {
            let arrInputValue = { input: numValue.toString() };
            arrInputValue = this.ChartUtils.formatChartValues(arrInputValue);
            let denaminationValue = this._denominationPrefix[i1][0] ? this._denominationPrefix[i1][0] : arrInputValue.currencySystem;
            let CurrencySympol = this._currencySymbol[i1][0] ? this._currencySymbol[i1][0] : arrInputValue.currencysymbol;
            if (this._displayValueFormat == "asentered") {
                this._valuesDenomination[i1][0] = numValue;
            } else {
                this._valuesDenomination[i1][0] = this.ChartUtils.getDenominationValue(numValue, denaminationValue, CurrencySympol);
            }
        }

        arrValue[i1] = {
            value: numValue,
            startValue: numStartPoint,
            isSumValue: isSumValue,
        };
        numStartPoint += isSumValue ? 0 : numValue;
    }
    numMaxValue = numPosMaxValue + Math.abs(numNegMaxValue);
    objData = {
        data: arrValue,
        maxAreaValue: numMaxValue,
        negDiffValue: numNegMaxValue,
    };
    return objData;
};

VOData.prototype.compareValueFormation = function () {
    this._duplicateValues = [];
    this._duplicateLabels = [];
    this._duplicateValueDenominationSuffix = [];
    this._duplicatePrefix = [];
    this._duplicateSuffix = [];
    let length = this._seriesItemLength * this._seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        let value;
        let label;
        let prefix;
        let suffix;
        let index = i1;
        if (i1 < this._seriesLength) {
            value = this._values[index];
            label = this._labels[index];
            prefix = this._prefix[index];
            suffix = this.suffix[index];
            this._duplicateLabels[i1] = label;
            this._duplicateValues[i1] = value[0].toString().split(",");
            this._duplicatePrefix[i1] = prefix[0].toString().split(",");
            this._duplicateSuffix[i1] = suffix[0].toString().split(",");
        } else {
            index = i1 - this._seriesLength;
            value = this._values[index];
            label = this._comparisonLabel[index];
            prefix = this._prefix[index];
            suffix = this.suffix[index];
            this._duplicateLabels[i1] = label;
            this._duplicateValues[i1] = value[1].toString().split(",");
            this._duplicatePrefix[i1] = prefix[1].toString().split(",");
            this._duplicateSuffix[i1] = suffix[1].toString().split(",");
        }
        // if (this.customProperties.seperator) {
        //     if (this._denominationPrefix[index][0] == "none") {
        //         this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._duplicateValueDenominationSuffix[i1 + " " + 0], this.customProperties.valueseparator);
        //     } else {
        //         if (this._denominationPrefix[index][0] == "auto") {
        //             this._arrSeperatorSuffix = ["K", "L", "M", "C", "B"];
        //             this._seperatorSuffix = this._denominationPrefix;
        //             for (let k = 0; k < this._arrSeperatorSuffix.length; k++) {
        //                 if (this._duplicateValueDenominationSuffix[i1 + " " + 0].search(this._arrSeperatorSuffix[k]) != -1) this._seperatorSuffix = this._arrSeperatorSuffix[k];
        //             }
        //             this._seperateValue = this._duplicateValueDenominationSuffix[i1 + " " + 0].split(this._seperatorSuffix)[0];
        //             this._seperatorSuffix = this._seperatorSuffix != "auto" ? this._seperatorSuffix : "";
        //             this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._seperateValue, this.customProperties.valueseparator) + this._seperatorSuffix;
        //         } else {
        //             this._seperateValue = this._denominationPrefix[index][0]
        //                 ? this._duplicateValueDenominationSuffix[i1 + " " + 0].split(this._denominationPrefix[index][0])[0]
        //                 : this._duplicateValueDenominationSuffix[i1 + " " + 0];
        //             this._duplicateValueDenominationSuffix[i1 + " " + 0] = this.seperatorValidation(this._seperateValue, this.customProperties.valueseparator) + this._denominationPrefix[index][0];
        //         }
        //     }
        // }
    }
    this._values = [];
    this._labels = [];

    this._prefix = [];
    this._suffix = [];
    this._valuesDenomination = [];
    this._seriesLength = length;
    this._seriesItemLength = 1;
    this._values = this._duplicateValues;
    this._labels = this._duplicateLabels;
    this._prefix = this._duplicatePrefix;
    this._suffix = this._duplicateSuffix;
    let seriesLength = this._duplicateValues.length;
    this._valuesDenomination = this._duplicateValues;
    let increaseIndex = 0;
    let secondaryIndex = 0;

    for (let s1 = 0; s1 < seriesLength; s1++) {
        secondaryIndex = s1 == seriesLength / 2 ? 0 : secondaryIndex;
        let seriesItemindex = s1 % 2;
        increaseIndex = s1 >= seriesLength / 2 ? 1 : 0;
        this._valuesDenomination[s1][0] = this.ChartUtils.getDenominationValue(this._duplicateValues[s1][0], this._denominationPrefix[secondaryIndex][increaseIndex], this._currencySymbol[secondaryIndex][increaseIndex]);
        secondaryIndex++;
    }

    // this._valuesDenominationSuffix = this._duplicateValueDenominationSuffix;
};

VOData.prototype.doSort = function (type) {
    if (1 < this._data.children[0].getAttribute("value").split(",").length) return;
    const items = [];
    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        const dateLabel = this.getUKFormat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.name));
        let value = this.baseProperties.isNegativeChart ? parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.value)) : Math.abs(parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.value)));
        items[seriesIndex] = {
            index: parseFloat(this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.index)),
            value: value,
            name: this._data.children[seriesIndex].getAttribute(this.ChartPropertiesName.name),
            date: Date.parse(dateLabel),
            data: this._data.children[seriesIndex],
        };
    }

    if (type == "asc") {
        items.sort(function (a, b) {
            return a.value - b.value;
        });
    } else if (type == "des") {
        items.sort(function (a, b) {
            return b.value - a.value;
        });
    } else if (type == "alphabet") {
        items.sort(function (a, b) {
            return a.name.localeCompare(b.name);
        });
    } else if (type == "time") {
        items.sort(function (a, b) {
            return a.date - b.date;
        });
    } else {
        items.sort(function (a, b) {
            return a.index - b.index;
        });
    }
    while (this._data.firstChild) {
        this._data.removeChild(this._data.firstChild);
    }
    for (let seriesIndex = 0; seriesIndex < this._seriesLength; seriesIndex++) {
        this._data.appendChild(items[seriesIndex].data);
    }
    let sortIndex = null;
    for (let orderIndex = 0; orderIndex < this._seriesLength; orderIndex++) {
        if (this._data.children[orderIndex].getAttribute("sortorder") == "true") sortIndex = orderIndex.toString(); //this._data.children[orderIndex].getAttribute("index")
    }
    if (sortIndex) this._data.appendChild(items[sortIndex].data);
};
VOData.prototype.sorValues = function (type) {
    if (type == "asc") {
        this._values.sort(function (a, b) {
            return a - b;
        });
        this._valuesDenomination.sort(function (a, b) {
            return a - b;
        });
    } else if (type == "des") {
        this._values.sort(function (a, b) {
            return b - a;
        });
        this._valuesDenomination.sort(function (a, b) {
            return b - a;
        });
    }
};
VOData.prototype.getUKFormat = function (label = "") {
    var arrSeperator = ["-", "/"];
    for (let s1 = 0; s1 < arrSeperator.length; s1++) {
        var labelData = label ? label.split(arrSeperator[s1]) : [];
        if (labelData.length > 1) {
            if (Number(labelData[0]) > 12 && !isNaN(labelData[0]) && labelData[0].length <= 2) {
                label = labelData[1] + arrSeperator[s1] + labelData[0] + arrSeperator[s1] + labelData[2];
                break;
            }
            if (Number(labelData[1]) > 12 && !isNaN(labelData[1]) && labelData[1].length <= 2) {
                label = labelData[2] + arrSeperator[s1] + labelData[1] + arrSeperator[s1] + labelData[0];
                break;
            }
        }
    }
    return label;
};

VOData.prototype.validationForMinValue = function () {
    let length = this._data.children.length;
    let value = this.data.children[0].getAttribute("value").split(",");
    let menuData = this.data.getAttribute("multiseriescount");
    let seriesItemLength = menuData && value.length < 2 ? 2 : this.baseProperties.minAllowedSeriesItems;
    this.data.removeAttribute("multiseriescount");
    if (value.length < seriesItemLength) {
        let newValue;
        let assenterValue = "";
        let newAsenterValue = "";
        for (let i2 = 0; i2 < length; i2++) {
            value = this.data.children[i2].getAttribute("value").split(",");
            assenterValue = this.data.children[i2].getAttribute("asenteredvalue").split("^");
            for (let i3 = 0; i3 < seriesItemLength; i3++) {
                if (i3 == 0) {
                    newValue = value[i3] ? value[i3] : "25";
                    newAsenterValue = assenterValue[i3] ? assenterValue[i3] : "25";
                } else {
                    let tempNewValue = value[i3] ? value[i3] : parseInt(newValue.split(",")[i3 - 1]) + parseInt(newValue.split(",")[i3 - 1]) * ((i3 + 1) * 0.2);
                    let tempasentervalue = assenterValue[i3] ? assenterValue[i3] : tempNewValue;
                    newAsenterValue += "^" + tempasentervalue;
                    newValue += "," + tempNewValue;
                }
            }
            if (newAsenterValue) this.data.children[i2].setAttribute("asenteredvalue", newAsenterValue);
            if (newValue) this.data.children[i2].setAttribute("value", newValue);
        }
    }
    if (length < this.baseProperties.minAllowedSeries) {
        let duplicateData = this._data.children[0].cloneNode(true);
        let index = Number(duplicateData.getAttribute("index"));
        duplicateData.setAttribute("index", index + 1);
        let arrValue = duplicateData.getAttribute("value").split(",");
        let strValue;
        for (let i2 = 0; i2 < arrValue.length; i2++) {
            let value = Number(arrValue[i2]);
            value = parseInt(value + value * ((i2 + 1) * 0.2));
            if (i2 == 0) strValue = value.toString();
            else strValue += "," + value.toString();
        }
        duplicateData.setAttribute("value", strValue);
        this._data.appendChild(duplicateData);
    }
};
VOData.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index + 1;
};
VOData.prototype.validationForScatterMaxMinValues = function () {
    this._xMaxValue = Math.max.apply(null, this._xValues);
    this._yMaxValue = Math.max.apply(null, this._yValues);
    this._yMinValue = Math.min.apply(null, this._yValues);
    this._xMinValue = Math.min.apply(null, this._xValues);
};
