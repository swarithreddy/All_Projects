function SimpleScaleColumnSeriesItem(argparent, argprops) {
    this.name = "SimpleBarSeriesItem";
    this.groupindex = argprops.groupindex;
    let graphicH = 0;
    let bkelement;
    let bkSubElement;
    BaseColumnSeriesItem.call(this, argparent, argprops);
}
SimpleScaleColumnSeriesItem.prototype = Object.create(BaseColumnSeriesItem.prototype);
SimpleScaleColumnSeriesItem.prototype.constructor = SimpleScaleColumnSeriesItem;

