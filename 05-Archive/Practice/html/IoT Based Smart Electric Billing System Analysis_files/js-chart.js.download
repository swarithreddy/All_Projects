ChartUtils.prototype.loadAssets = function (objPropData, slideElement, elementID, strGraphicTemplateJson, strSlideID, xmldata, isUndoableOp, callback, slideobjContant, boolLoadAsset = true, backXml = null) {
    let objChartAssetLoader = new AssetsLoader();
    let builderChart = new ChartBuilder();
    builderChart.getAssets(objPropData, xmldata);
    objChartAssetLoader.loadAssets(objPropData.assets).then(() => {
        ManifestHelper.getInstance().updateDocumentDefs(objPropData.assets, strSlideID, elementID);
        let chartDiv = builderChart.buildAsset(objPropData);
        if (chartDiv != null) {
            this.SvgUtils.assignAttributes(chartDiv, {
                "data-element-id": elementID,
                "data-json-graphic-template-details": strGraphicTemplateJson,
                xmldata: backXml,
            });
            if (backXml) {
                this.SvgUtils.assignAttributes(chartDiv, {
                    xmldata: backXml,
                });
            }
            if (objPropData.columnIndex != undefined && objPropData.columnIndex)
                this.SvgUtils.assignAttributes(chartDiv, {
                    "data-columnindex": objPropData.columnIndex,
                });
            if (objPropData.rowIndex != undefined && objPropData.rowIndex)
                this.SvgUtils.assignAttributes(chartDiv, {
                    "data-rowindex": objPropData.rowIndex,
                });
        }

        if (chartDiv != null) {
            if (!!xmldata) {
                // OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "csschart", isUndoableOp);
                let cloneNode = chartDiv.cloneNode(true);
                chartDiv.parentNode.removeChild(chartDiv);
                callback(cloneNode);
            } else {
                OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "chart", isUndoableOp);
                return;
            }
        }
    });
};

ChartUtils.prototype.unLoadAssets = function (objPropData, slideElement, elementID, strGraphicTemplateJson, strSlideID, xmldata, isUndoableOp, callback, slideobjContant, boolLoadAsset = true, backXml = null) {
    let builderChart = new ChartBuilder();
    builderChart.getAssets(objPropData, xmldata);
    // ManifestHelper.getInstance().updateDocumentDefs(objPropData.assets, strSlideID, elementID);
    // let arrAsset = objPropData.slideobj&&objPropData.slideobj.content?JSON.parse(objPropData.slideobj.content.querySelector(".metadata_group_chart").getAttribute("asset")):"";
    // objPropData.assets = arrAsset;
    let chartDiv = builderChart.buildAsset(objPropData);
    if (chartDiv != null) {
        this.SvgUtils.assignAttributes(chartDiv, {
            "data-element-id": elementID,
            "data-json-graphic-template-details": strGraphicTemplateJson,
        });
        if (backXml) {
            this.SvgUtils.assignAttributes(chartDiv, {
                xmldata: backXml,
            });
        }
        if (objPropData.columnIndex != undefined && objPropData.columnIndex)
            this.SvgUtils.assignAttributes(chartDiv, {
                "data-columnindex": objPropData.columnIndex,
            });
        if (objPropData.rowIndex != undefined && objPropData.rowIndex)
            this.SvgUtils.assignAttributes(chartDiv, {
                "data-rowindex": objPropData.rowIndex,
            });
    }

    if (chartDiv != null) {
        if (!!xmldata) {
            // OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "csschart", isUndoableOp);
            let cloneNode = chartDiv.cloneNode(true);
            chartDiv.parentNode.removeChild(chartDiv);
            callback(cloneNode);
        } else {
            OperationsManager.getInstance().doChartRedrawOperation(chartDiv, strSlideID, null, "chart", isUndoableOp);
            return;
        }
    }
};

ChartUtils.prototype.onAssetLoad = function (slide, callback = null) {
    let arrAssets = [];
    const strStyleSheetURL = "chart/css/chart.css";
    let strSlideId = slide.getAttribute("id");
    let slideObj = DocumentStore.getInstance().getSlideDetails(strSlideId);
    let elementDiv = slideObj.content.querySelector("div[id='ELEMENT_DIV']");
    let strElementID = elementDiv ? elementDiv.getAttribute("data-element-id") : IDUtils.uuidv4();
    const slideID = strSlideId;
    const xmlData = slideObj.content.querySelector(".chartbase");
    const chartName = xmlData.getAttribute("name");
    const assetName = xmlData.getAttribute("data-asset");
    const appearance = xmlData.getAttribute("data-appearance");
    ChartHelper.getShapeList(slideID, chartName, assetName, arrAssets, appearance, xmlData);
    if (xmlData.getAttribute("primaryplaceholder") == "true" || xmlData.getAttribute("data-primaryplaceholder") == "true") arrAssets = ChartHelper.getIconList(slideID, STR_DEFAULT_ICONGROUP, arrAssets, xmlData);
    if (chartName == "fillcompareChart" || chartName == "columnIconFill" || chartName == "barSimpleIconFill") {
        arrAssets = ChartHelper.getIconList(slideID, STR_DEFAULT_ICONGROUP, arrAssets, xmlData, chartName);
    }
    ///
    if (strStyleSheetURL != undefined) {
        let arrStyleSheetURL = strStyleSheetURL.split("/");
        let strID = arrStyleSheetURL[arrStyleSheetURL.length - 1].split(".")[0];
        arrAssets.push({
            id: strID,
            type: "CSS",
            slideID: strSlideId,
            url: strStyleSheetURL,
        });
    }
    let objChartAssetLoader = new AssetsLoader();
    objChartAssetLoader.loadAssets(arrAssets).then(() => {
        ManifestHelper.getInstance().updateDocumentDefs(arrAssets, strSlideId, strElementID);
        if (callback) callback();
    });
    if (elementDiv) {
        for (let i1 = 0; i1 < arrTextItems.length; i1++) {
            let textElement = elementDiv.getElementsByClassName(arrTextItems[i1]);
            for (let i2 = 0; i2 < textElement.length; i2++) {
                ChartHelper.setTextChangeListner(textElement[i2]);
            }
        }

        for (let i4 = 0; i4 < arrGrid.length; i4++) {
            let gridElemnt = elementDiv.querySelectorAll("#" + arrGrid[i4]);
            // if (gridElemnt) ChartHelper.setBaseLineListner(gridElemnt[0], elementDiv);
        }

        let dataSlideIdElement = elementDiv.querySelectorAll("[data-slideid]");
        for (let i3 = 0; i3 < dataSlideIdElement.length; i3++) {
            dataSlideIdElement[i3].setAttribute("data-slideid", strSlideId);
        }
    }
};

ChartUtils.prototype.addDummySvg = function (dummyNode, slideObject) {
    let slideContent = slideObject;
    let root = slideContent.querySelector("div[id=GRAPHIC]");
    let svgNode = this.SvgUtils.createEmptySvgNode();
    svgNode.id = "dummysvg";
    root.appendChild(svgNode);
    svgNode.appendChild(dummyNode);
};

ChartUtils.prototype.removeDummySvg = function (slideObject) {
    let slideContent = slideObject;
    let root = slideContent.querySelector("div[id=GRAPHIC]");
    let svgNode = root.querySelector("svg[id=dummysvg]");
    root.removeChild(svgNode);
};

ChartUtils.prototype.getChartTableProperties = function (strName, className) {
    // const strListItemName = ChartHelper.getChartListDataByName(strName).name;
    return this.getChartItemMetaData("name", className)[0]; //strListItemName
};

ChartUtils.prototype.getChartItemMetaData = function (strProperty, strPropertyValue) {
    let ChartMetaDataClass = new window["chartjsonValue"]();
    let ChartMetaData = ChartMetaDataClass.getChartValue();
    let arrItems = [];
    let arrCharts = ChartMetaData.charts;
    if (arrCharts[strPropertyValue]) {
        arrItems.push(arrCharts[strPropertyValue]);
    }
    return arrItems;
};

ChartUtils.prototype.getAxisBaselineProperties = function (eltarget, coordinates, boundingRect) {
    let chartAxisType = eltarget.getAttribute("data-charttype");
    let targetid = eltarget.getAttribute("id");
    let dataid = eltarget.getAttribute("data-id");
    let axisType = targetid == "yaxis" ? "left" : "bottom"; //dataid.split("-")[1];
    let leftPos;
    let bottomPos;
    if (axisType == "left") leftPos = coordinates;
    else if (axisType == "bottom") bottomPos = coordinates;
    let dictProps = {
        chartAxisType: chartAxisType,
        axisType: axisType,
        leftPos: leftPos,
        bottomPos: bottomPos,
        bounds: boundingRect,
    };
    return {
        id: targetid,
        dpaxisbaseline: dictProps,
        property: "axisbaseline",
    };
};

ChartUtils.prototype.getFloaterProperties = function (eltarget) {
    let index;
    let parent;
    let length;
    let minLength;
    let percentageChart;
    let itemId = "";
    let editImage = "";
    let iconGroup = "";
    let hasChangeIcon = "";
    let hasChangeImage = "";
    let hasLinkProperty = "";
    let hasDeleteProperty = "";
    let hasEmphasisProperty = "";
    let hasProjectionProperty = "";
    let hasHightlightProperty = "";
    let hasPlaceHolderProperty = {};
    let hasImageProperty = {};
    let hasSortOrderProperty = "";
    let hasGraphicImageProperty = "";
    let boolProjection = false;
    let elementCategory = "";
    let hasEdit = "";
    let chartName = "";
    if (eltarget) {
        itemId = eltarget.getAttribute("id");
        let elementType = eltarget.getAttribute("data-type");
        elementCategory = eltarget.getAttribute("data-category");
        let slide = DocumentStore.getInstance().getSlideDetails(DocumentStore.getInstance().currentSlideID).content;
        let metaData = slide.querySelector(".chartbase");
        chartName = metaData.getAttribute("name");
        if (itemId.includes("baseline")) {
            dictProps = {
                selectionheaderlabel: "BASELINE",
                [FloaterConstants.DELETE_ASSET]: FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.CHART_DELETE_BASELINE),
            };
            return {
                id: itemId,
                dpfloater: dictProps,
            };
        }

        if (elementType == "value" || elementType == "label" || elementType == "legendvalue" || elementType == "legendlabel") parent = this.getParentElementProp(eltarget);
        else if (elementType == "ICON" || elementType == "IMAGE") {
            let arrPlaceHolder = [];
            let selectedIndex = 0;
            iconGroup = eltarget.getAttribute("data-icongroup");
            iconGroup = iconGroup ? iconGroup : "";
            parent = this.getParentElementProp(eltarget);
            let placeholderElements = eltarget.getAttribute("data-placeholderelement");
            if (placeholderElements) {
                arrPlaceHolder = [
                    {
                        [FloaterConstants.PROP_LIST_DATA]: "icon",
                        [FloaterConstants.PROP_LIST_LABEL]: "Icon",
                        icon: "appicons/ic_graphics_type_icon.svg",
                    },
                    {
                        [FloaterConstants.PROP_LIST_DATA]: "image",
                        [FloaterConstants.PROP_LIST_LABEL]: "Image",
                        icon: "appicons/ic_image_rect_outline.svg",
                    },
                ];
                for (let i = 0; i < arrPlaceHolder.length; i++) {
                    if (elementType.toLowerCase() == arrPlaceHolder[i].data) selectedIndex = i;
                }
                hasPlaceHolderProperty = {
                    [FloaterConstants.PROP_LIST_ICON_NODE]: "icon",
                    [FloaterConstants.PROP_LIST_SOURCE]: arrPlaceHolder,
                    [FloaterConstants.PROP_SELECTED_INDEX]: selectedIndex,
                    [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.DIAGRAM_GRAPHIC_TYPE,
                };
            }

            if (elementType == "ICON") hasChangeIcon = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.CHANGE_ICON);
            else if (elementType == "IMAGE") {
                // hasEdit = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.EDIT);
                let imageType = eltarget.getAttribute("data-imagetype") ? eltarget.getAttribute("data-imagetype") : "circle";
                hasChangeImage = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.CHANGE_IMAGE);
                hasImageProperty = !itemId.includes("secondaryPlaceholder") || !itemId.includes("commonplaceholder") ? this.getFloaterImageProp(imageType) : null;

                // let imagePath = eltarget.getAttribute("data-imagepath");
                // if (imagePath)
                editImage = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.EDIT);
            }
        } else parent = null;

        if (parent) {
            let elementDiv = parent.parentNode;
            length = parseInt(parent.querySelector(".metadata_group_chart").getAttribute("length"));
            minLength = parent.querySelector(".metadata_group_chart").getAttribute("minseries") ? parseInt(parent.querySelector(".metadata_group_chart").getAttribute("minseries")) : parseInt(parent.querySelector(".metadata_group_chart").getAttribute("minseries"));

            percentageChart = parent.querySelector(".metadata_group_chart").getAttribute("percentagechart");
            if (
                percentageChart != "true" &&
                itemId.split("-")[0] != "axis" &&
                !itemId.includes("multiSeriesLabel") &&
                !itemId.includes("secondaryvalue") &&
                !itemId.includes("secondarylabel") &&
                !itemId.includes("graphicIcon") &&
                !itemId.includes("srcData") &&
                !itemId.includes("commonPlaceholder") &&
                !itemId.includes("seiriesitemtitle") &&
                chartName != "logoComparisonChart" &&
                chartName != "iconComparisonChart" &&
                elementDiv.querySelector(".chartbase").children.length != 1
            ) {
                hasHightlightProperty = chartName != "assetPercentageChart" ? this.setHighlightProperty(eltarget, parent) : "";
                hasEmphasisProperty = chartName != "barSimpleIconFill" ? this.setEmphasisProperty(hasHightlightProperty) : "";
                hasProjectionProperty = chartName != "barSimpleIconFill" ? this.setProjectionProperty(hasHightlightProperty) : "";
                hasSortOrderProperty = chartName != "barSimpleIconFill" && chartName != "barSimpleIconFill" && chartName != "assetPercentageChart" && chartName != "simpleoverlapcompareChart" && chartName != "logoGraphicComparisonChart" ? this.setSortorderProperety(hasHightlightProperty) : "";
                hasGraphicImageProperty = this.setGraphicImageProperety(hasHightlightProperty);
                if (chartName == "fillcompareChart" || chartName == "ComparisonDoughnutChart" || chartName == "ComparisonpieChart" || chartName == "scaleComparison") {
                    hasEmphasisProperty = "";
                    hasProjectionProperty = "";
                    hasSortOrderProperty = "";
                    hasGraphicImageProperty = "";
                }
            }
            if (metaData.getAttribute("data-graphicimage") == "true" || chartName == "barSimpleiconRepeatFill") {
                hasGraphicImageProperty = "";
            }
            if (chartName == "waterfallchart") {
                hasSortOrderProperty = "";
            }
            if (
                itemId.split("-")[0] != "axis" &&
                minLength < length &&
                !itemId.includes("multiSeriesLabel") &&
                !itemId.includes("secondaryvalue") &&
                !itemId.includes("secondarylabel") &&
                !itemId.includes("graphicIcon") &&
                !itemId.includes("srcData") &&
                !itemId.includes("commonPlaceholder") &&
                !itemId.includes("seiriesitemtitle")
            ) {
                hasDeleteProperty = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.DELETE_ASSET);
            }

            if (itemId.split("-")[0] != "axis" && divChart != "true" && !itemId.includes("commonPlaceholder") && !itemId.includes("seiriesitemtitle") && chartName != "logoComparisonChart" && chartName != "iconComparisonChart") {
                hasLinkProperty = this.setItemLinkProperty(eltarget);
            }
        }
        if (chartName == "scaleiconcompareChart" || itemId.includes("commonPlaceholder")) {
            hasPlaceHolderProperty = "";
        }
    }

    let divChart = parent ? parent.querySelector(".metadata_group_chart").getAttribute("isdivChart") : false;
    let dictProps = null;
    index = itemId.includes("value") || itemId.includes("graphic") || itemId.includes("itemplaceholder") ? itemId.split("-")[1].split("_")[0] : itemId.split("-")[1];
    if (editImage) {
        itemId = eltarget.parentNode.getAttribute("id");
    }
    if (chartName == "logoComparisonChart" || chartName == "logoGraphicComparisonChart" || chartName == "iconComparisonChart" || chartName == "pieChart" || chartName == "doughnutChart" || chartName == "ComparisonpieChart" || chartName == "ComparisonDoughnutChart") {
        hasImageProperty = "";
        hasPlaceHolderProperty = "";
    }
    if (parent && elementCategory == "simple") {
        dictProps = {
            selectionheaderlabel: "BASELINE",
            [FloaterConstants.DELETE_ASSET]: FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.CHART_DELETE_BASELINE),
        };
    } else if (parent) {
        dictProps = {
            selectionheaderlabel: itemId.split("-")[0] != "axis" ? "POINT " + (parseInt(index) + 1) : null,
            [FloaterConstants.CHART_IMAGE_PLACEHOLDER]: hasImageProperty,
            [FloaterConstants.DIAGRAM_GRAPHIC_TYPE]: hasPlaceHolderProperty,
            [FloaterConstants.CHANGE_ICON]: hasChangeIcon,
            [FloaterConstants.CHANGE_IMAGE]: hasChangeImage,
            [FloaterConstants.EDIT]: editImage,
            [FloaterConstants.HIGHLIGHT]: hasHightlightProperty,
            [FloaterConstants.DELETE_ASSET]: hasDeleteProperty,
            [FloaterConstants.SELECTED_TEXT_LINK]: hasLinkProperty,
            [FloaterConstants.PROP_PROJECTION]: hasProjectionProperty,
            [FloaterConstants.PROP_EMPHASIZE]: hasEmphasisProperty,
            [FloaterConstants.PROP_SORTORDER]: hasSortOrderProperty,
            [FloaterConstants.PROP_GRAPHIC_IMAGE]: hasGraphicImageProperty,
        };
    }

    return {
        id: itemId,
        dpfloater: dictProps,
        customprops: {
            iconGroup: iconGroup,
        },
    };
};

ChartUtils.prototype.validationForMinValue = function (xmlData, designerui = false) {
    let length = xmlData.children.length;
    //let value = this.data.children[0].getAttribute("value").split(",");
    // if (value.length < this.baseProperties.minAllowedSeriesItems) {
    //     let newValue;
    //     for (let i3 = 0; i3 < this.baseProperties.minAllowedSeriesItems; i3++) {
    //         if (i3 == 0) newValue = value[i3] ? value[i3] : "25";
    //         else newValue += "," + (value[i3] ? value[i3] : parseInt(newValue.split(",")[i3 - 1]) + parseInt(newValue.split(",")[i3 - 1]) * ((i3 + 1) * 0.2));
    //     }
    //     this.data.children[0].setAttribute("value", newValue);
    // }
    let minSeries = xmlData.getAttribute("data-minseries");

    if (designerui) {
        for (let i2 = length; i2 < minSeries; i2++) {
            let duplicateData = xmlData.children[0].cloneNode(true);
            let index = Number(duplicateData.getAttribute("index"));
            duplicateData.setAttribute("index", index + 1);
            let arrValue = duplicateData.getAttribute("value").split(",");
            let strValue;
            for (let i2 = 0; i2 < arrValue.length; i2++) {
                let value = Number(arrValue[i2]);
                value = parseInt(value + value * ((i2 + 1) * 0.2));
                if (i2 == 0) strValue = value.toString();
                else strValue += "," + value.toString();
            }
            duplicateData.setAttribute("value", strValue);
            xmlData.appendChild(duplicateData);
        }
    } else if (length < minSeries) {
        let duplicateData = xmlData.children[0].cloneNode(true);
        let index = Number(duplicateData.getAttribute("index"));
        duplicateData.setAttribute("index", index + 1);
        let arrValue = duplicateData.getAttribute("value").split(",");
        let strValue;
        for (let i2 = 0; i2 < arrValue.length; i2++) {
            let value = Number(arrValue[i2]);
            value = parseInt(value + value * ((i2 + 1) * 0.2));
            if (i2 == 0) strValue = value.toString();
            else strValue += "," + value.toString();
        }
        duplicateData.setAttribute("value", strValue);
        xmlData.appendChild(duplicateData);
    }
};

ChartUtils.prototype.getFloaterImageProp = function (imageType) {
    let imageProperty = FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.CHART_IMAGE_PLACEHOLDER);
    let selectedIndex = 0;
    for (let i = 0; i < imageProperty.dpsource.length; i++) {
        if (imageType == imageProperty.dpsource[i].data) selectedIndex = i;
    }
    imageProperty.selectedindex = selectedIndex;
    return imageProperty;
};

ChartUtils.prototype.getParentElementProp = function (eltarget) {
    if (eltarget.getAttribute("id") == "base-chart") {
        return eltarget;
    } else {
        eltarget = eltarget.parentElement;
        return eltarget ? this.getParentElementProp(eltarget) : null;
    }
};

ChartUtils.prototype.setHighlightProperty = function (eltarget, parent) {
    let elementType = eltarget.getAttribute("data-type");
    let index = elementType == "value" || elementType == "graphic" || elementType == "legendvalue" ? eltarget.id.split("-")[1].split("_")[0] : eltarget.id.split("-")[1];
    let divSlideGraphicItem = DocumentStore.getInstance().getSlideDetails(DocumentStore.getInstance().currentSlideID).content;
    let chartData = divSlideGraphicItem.querySelector(".chartbase");
    let highlighttype = chartData.children[parseInt(index)].getAttribute("highlight") == "true" ? true : false;
    let highlightDesc = chartData.children[parseInt(index)].getAttribute("caption");
    highlightDesc = highlightDesc ? highlightDesc : "Highlight Text";
    let highlightStyle = chartData.children[parseInt(index)].getAttribute("highlightstyle");
    highlightStyle = highlightStyle ? highlightStyle : "text";
    let metaData = divSlideGraphicItem.querySelector(".metadata_group_chart");
    // let strGraphicIcon = highlightStyle == "texticon" ? IndexStore.getInstance().staticServerURL : "";
    let strGraphicIcon = "";
    let hasEmphasis = metaData.getAttribute("emphasis") == "true" ? true : false;
    let showProjection = metaData.getAttribute("projection") == "true" ? true : false;
    let emphasis = chartData.children[parseInt(index)].getAttribute("emphasis") == "true" ? true : false;
    let hasSortorder = chartData.children[parseInt(index)].getAttribute("sortorder") == "true" ? true : false;
    let hasProjection = chartData.children[parseInt(index)].getAttribute("projection") == "true" ? true : false;
    let highlightIcon = chartData.children[parseInt(index)].getAttribute("highlighticonpath")
        ? !chartData.children[parseInt(index)].getAttribute("highlighticonpath").includes("http")
            ? strGraphicIcon + chartData.children[parseInt(index)].getAttribute("highlighticonpath")
            : chartData.children[parseInt(index)].getAttribute("highlighticonpath")
        : null;
    let showGraphicImage = metaData.getAttribute("graphicimage") == "true" ? true : false;
    let hasGraphicImage = chartData.children[parseInt(index)].getAttribute("graphicimage") == "true" ? true : false;
    let boolProjection = chartData.getAttribute("projection") == "true" ? true : false;
    let boolEmphasize = chartData.getAttribute("emphasis") == "true" ? true : false;
    let boolGraphicImage = chartData.getAttribute("graphicimage") == "true" ? true : false;
    let isProjection = this.projectionCheck(chartData, index);
    let showSortOrder = metaData.getAttribute("sublength") == 1 && metaData.getAttribute("length") != 1 ? true : false;
    // if (highlightStyle == "texticon") chartData.children[parseInt(index)].setAttribute("highlighticonpath", highlightIcon);
    return {
        targetIndex: index,
        projection: boolEmphasize ? false : showProjection ? isProjection : showProjection,
        [FloaterConstants.PROP_VALUE]: highlighttype,
        [FloaterConstants.PROP_DESCRIPTION]: highlightDesc,
        [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.HIGHLIGHT,
        [FloaterConstants.PROP_HIGHLIGHT_STYLE]: highlightStyle,
        [FloaterConstants.PROP_HAS_EMPHASIZE]: boolProjection ? false : hasEmphasis,
        [FloaterConstants.PROP_EMPHASIZE_SELECTED]: emphasis,
        [FloaterConstants.PROP_HIGHLIGHT_ICON]: highlightIcon,
        [FloaterConstants.PROP_PROJECTION_SELECTED]: hasProjection,
        [FloaterConstants.PROP_SORTORDER_SELECTED]: hasSortorder,
        graphicImage: boolProjection ? false : showGraphicImage,
        sortOrder: showSortOrder,
        [FloaterConstants.PROP_GRAPHIC_IMAGE_SELECTED]: hasGraphicImage,
    };
};

ChartUtils.prototype.setItemLinkProperty = function (eltarget) {
    let index = eltarget.id.split("-")[0] == "value" || eltarget.id.split("-")[0] == "graphic" || eltarget.id.split("-")[0] == "legendvalue" ? eltarget.id.split("-")[1].split("_")[0] : eltarget.id.split("-")[1];
    let divSlideGraphicItem = DocumentStore.getInstance().getSlideDetails(DocumentStore.getInstance().currentSlideID).content;
    let chartData = divSlideGraphicItem.querySelector(".chartbase");
    let childData = chartData.children[parseInt(index)].getAttribute("data-navigate-to-slide-on-click");
    let link = chartData.children[parseInt(index)].getAttribute("link");
    if (childData)
        return {
            [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.SELECTED_TEXT_LINK,
            [FloaterConstants.PROP_NAVIGATE_SLIDE_ID]: link == "SLIDE" ? childData : "",
            [FloaterConstants.PROP_DESCRIPTION]: link == "URL" ? childData : "",
            [FloaterConstants.PROP_VALUE]: false,
        };
    else return FloaterPropsModel.getInstance().getFloaterProperty(FloaterConstants.SELECTED_TEXT_LINK);
};

ChartUtils.prototype.setSortorderProperety = function (hasHightlightProperty) {
    return {
        [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.PROP_SORTORDER,
        [FloaterConstants.PROP_VALUE]: hasHightlightProperty[FloaterConstants.PROP_SORTORDER_SELECTED],
        visible: hasHightlightProperty.sortOrder,
    };
};

ChartUtils.prototype.setEmphasisProperty = function (hasHightlightProperty) {
    return {
        [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.PROP_EMPHASIZE,
        [FloaterConstants.PROP_VALUE]: hasHightlightProperty[FloaterConstants.PROP_EMPHASIZE_SELECTED],
        visible: hasHightlightProperty[FloaterConstants.PROP_HAS_EMPHASIZE],
    };
};

ChartUtils.prototype.setProjectionProperty = function (hasHightlightProperty) {
    return {
        [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.PROP_PROJECTION,
        [FloaterConstants.PROP_VALUE]: hasHightlightProperty[FloaterConstants.PROP_PROJECTION_SELECTED],
        visible: hasHightlightProperty.projection,
    };
};

ChartUtils.prototype.setGraphicImageProperety = function (hasHightlightProperty) {
    return {
        [FloaterConstants.PROP_FLOATER_PROP]: FloaterConstants.PROP_GRAPHIC_IMAGE,
        [FloaterConstants.PROP_VALUE]: hasHightlightProperty[FloaterConstants.PROP_GRAPHIC_IMAGE_SELECTED],
        visible: hasHightlightProperty.graphicImage,
    };
};

ChartUtils.prototype.projectionCheck = function (chartData, index) {
    let intIndex = 0;
    let boolProjection = false;
    for (let i1 = 0; i1 < chartData.children.length; i1++) {
        let projection = chartData.children[i1].getAttribute("projection") == "true" ? true : false;
        if (projection) {
            intIndex = i1;
            boolProjection = true;
            break;
        }
    }
    return boolProjection ? (intIndex >= index ? true : false) : true;
};

ChartUtils.prototype.getChartURLData = function (objDetails) {
    let svgDiv = objDetails.slideobj.content;
    let index = objDetails.targetid.split("-")[0] == "valuetext" || objDetails.targetid.split("-")[0] == "pvalue" || objDetails.targetid.split("-")[0] == "graphic" ? objDetails.targetid.split("-")[1].split("_")[0] : objDetails.targetid.split("-")[1];
    let arrGraphics = [".series", ".legenditemgroup"];
    let metadata = objDetails.slideobj.content;
    let xmlData = metadata.querySelector(".chartbase");
    let linkId = "";
    this.strHyperlinkUrl = "";
    if (objDetails.url) {
        this.strHyperlinkUrl = objDetails.url;
        linkId = "URL";
        if (!/^(f|ht)tps?:\/\//i.test(this.strHyperlinkUrl)) {
            this.strHyperlinkUrl = "https://" + this.strHyperlinkUrl;
        }
    } else if (objDetails.linkSlide) {
        this.strHyperlinkUrl = objDetails.linkSlide;
        linkId = "SLIDE";
    }
    // if (this.strHyperlinkUrl && linkId) {
    this.SvgUtils.assignAttributes(xmlData.children[parseInt(index)], {
        "data-navigate-to-slide-on-click": this.strHyperlinkUrl,
        link: linkId,
    });

    for (let i1 = 0; i1 < arrGraphics.length; i1++) {
        let element = svgDiv.querySelectorAll(arrGraphics[i1]);
        this.SvgUtils.assignAttributes(element[parseInt(index)], {
            "data-navigate-to-slide-on-click": this.strHyperlinkUrl,
            link: linkId,
        });
    }
    // }
    return {
        svgDiv,
        xmlData,
    };
};

ChartUtils.prototype.parseBoolen = function (value) {
    switch (value) {
        case "true":
        case true:
            return true;
        default:
            return false;
    }
};

ChartUtils.prototype.getChartProperties = function (argdata) {
    if (argdata == null) return {};
    const properties = {};
    properties.isprops = true;
    properties.name = argdata.getAttribute("name");
    properties.merge = argdata.getAttribute("merge");
    properties.layout = argdata.getAttribute("layout");
    properties.classname = argdata.getAttribute("data-classname");
    // const className = ChartHelper.getChartListDataByName(properties.name).name;
    const jsonChartItemMetaData = this.getChartItemMetaData("name", properties.classname)[0];
    properties.class = jsonChartItemMetaData.class;
    properties.minvaluerow = jsonChartItemMetaData.minAllowedSeries == undefined ? 1 : parseInt(jsonChartItemMetaData.minAllowedSeries);
    properties.maxvaluerow = jsonChartItemMetaData.maxAllowedSeries == undefined ? 12 : parseInt(jsonChartItemMetaData.maxAllowedSeries);
    properties.minvaluecolumn = jsonChartItemMetaData.minAllowedSeriesItems == undefined ? 1 : parseInt(jsonChartItemMetaData.minAllowedSeriesItems);
    properties.maxvaluecolumn = jsonChartItemMetaData.maxAllowedSeriesItems == undefined ? 12 : parseInt(jsonChartItemMetaData.maxAllowedSeriesItems);
    properties.valuerow = properties.maxvaluerow < argdata.children.length ? properties.maxvaluerow : argdata.children.length;
    const valuelength = argdata.children[0].getAttribute("value").split(",").length;
    properties.valuecolumn = valuelength == 0 ? 1 : properties.maxvaluecolumn < valuelength ? properties.maxvaluecolumn : valuelength;
    properties.hadThemeRules = jsonChartItemMetaData.hadThemeRules == undefined ? false : true;
    return properties;
};

ChartUtils.prototype.ruler = function (argMetaData, argRulerData, ruletype = "all") {
    let chartProperties = argMetaData.isprops ? argMetaData : this.getChartProperties(argMetaData);
};

ChartUtils.prototype.getDenominationValue = function (value, denominationSuffix, currencySymbol) {
    let intDivider = 1;
    let strValueDenominationSuffix = "";
    let intLength = value < 0 ? String(value).split(".")[0].length - 1 : String(value).split(".")[0].length;
    if (denominationSuffix != "none") {
        denominationSuffix = denominationSuffix == "auto" ? "" : denominationSuffix;
        if (/\bbillion|bn|b\b/i.test(denominationSuffix) || strValueDenominationSuffix.toLowerCase() == "b") intDivider = 1000000000;
        // else if (denominationSuffix.toLowerCase() == "c" || strValueDenominationSuffix.toLowerCase() == "c") intDivider = 10000000;
        else if (/\bmillion|mn|m\b/i.test(denominationSuffix) || strValueDenominationSuffix.toLowerCase() == "m") intDivider = 1000000;
        // else if (denominationSuffix.toLowerCase() == "l" || strValueDenominationSuffix.toLowerCase() == "l") intDivider = 100000;
        else if (/\bthousand|k\b/i.test(denominationSuffix) || strValueDenominationSuffix.toLowerCase() == "k") intDivider = 1000;
        else if (/\btrillion|tn|t\b/i.test(denominationSuffix)) intDivider = 1000000000000;
        let divideValue = value / intDivider;
        let splitLength = divideValue && divideValue.toString().split(".").length > 1 ? divideValue.toString().split(".")[1].length : 0;
        if (splitLength > 2) {
            divideValue = divideValue.toFixed(2);
        }
        if (currencySymbol) return strValueDenominationSuffix ? currencySymbol + divideValue + strValueDenominationSuffix : currencySymbol + divideValue + denominationSuffix;
        return strValueDenominationSuffix ? divideValue + strValueDenominationSuffix : divideValue + denominationSuffix;
    }
    return value;
};

ChartUtils.prototype.getSelectedIndex = function (list, value, index = 0) {
    let length = list.length;
    for (let i1 = 0; i1 < length; i1++) {
        if (list[i1].data == value) {
            return i1;
        }
    }
    return index;
};
ChartUtils.prototype.getSelectedMenuIndex = function (list, value, index = 0) {
    let length = list.length;
    for (let i1 = 0; i1 < length; i1++) {
        if (list[i1].menuname == value) {
            return i1;
        }
    }
    return index;
};

ChartUtils.prototype.getChartLayoutData = function (strLayoutName, strItemName, strClassname) {
    // let chartListData = ChartHelper.getChartListDataByName(strItemName);
    let jsonChartItemMetaData = this.getChartItemMetaData("name", strClassname)[0]; //chartListData.name
    let category = jsonChartItemMetaData.category == "simple" || !jsonChartItemMetaData.category ? "" : jsonChartItemMetaData.category;
    return ChartHelper.getChartLayoutDataByName(strLayoutName + category);
};

ChartUtils.prototype.doSort = function (type, xmlChart, seriesLength) {
    if (1 < xmlChart.children[0].getAttribute("value").split(",").length) return;
    let items = [];
    for (let seriesIndex = 0; seriesIndex < seriesLength; seriesIndex++) {
        items[seriesIndex] = {
            index: parseFloat(xmlChart.children[seriesIndex].getAttribute(ChartPropertiesName.index)),
            value: parseFloat(xmlChart.children[seriesIndex].getAttribute(ChartPropertiesName.value)),
            name: xmlChart.children[seriesIndex].getAttribute(ChartPropertiesName.name),
            date: Date.parse(xmlChart.children[seriesIndex].getAttribute(ChartPropertiesName.name)),
            data: xmlChart.children[seriesIndex],
        };
    }

    if (type == "asc") {
        items.sort(function (a, b) {
            return a.value - b.value;
        });
    } else if (type == "des") {
        items.sort(function (a, b) {
            return b.value - a.value;
        });
    } else if (type == "alphabet") {
        items.sort(function (a, b) {
            return a.name.localeCompare(b.name);
        });
    } else if (type == "date") {
        items.sort(function (a, b) {
            return a.date - b.date;
        });
    } else {
        items.sort(function (a, b) {
            return a.index - b.index;
        });
    }
    while (xmlChart.firstChild) {
        xmlChart.removeChild(xmlChart.firstChild);
    }
    for (let seriesIndex = 0; seriesIndex < seriesLength; seriesIndex++) {
        xmlChart.appendChild(items[seriesIndex].data);
    }
};

ChartUtils.prototype.getTextMeasurement = function (slideId, text, maxW, maxH, maxFontSize, minFontSize, fontFamily, fontWeight = null, iswordwrap = true, size = 1, isClass = null) {
    let fontSize = maxFontSize;
    let svgElement = this.SvgUtils.createSVGElement("text");
    this.SvgUtils.assignAttributes(svgElement, {
        "font-size": fontSize,
        "data-editable": "false",
        "data-type": "TEXT",
        "data-maxwidth": maxW,
        "data-maxheight": maxH,
        "data-lineheight": 1,
        "text-rendering": "geometricPrecision",
        "font-family": fontFamily,
    });

    if (fontWeight)
        this.SvgUtils.assignAttributes(svgElement, {
            "font-weight": fontWeight,
        });
    this.SvgUtils.assignAttributes(svgElement, {
        style: "font-size:" + fontSize + "px;",
    });

    if (isClass)
        this.SvgUtils.assignAttributes(svgElement, {
            class: isClass,
        });
    let emptySvgNode = this.SvgUtils.createEmptySvgNode();
    emptySvgNode.appendChild(svgElement);
    this.addDummySvg(emptySvgNode, slideId);
    fontSize = TextUtils.fitFontSize(svgElement, text.toString(), maxW, maxH, fontSize, iswordwrap);
    fontSize = fontSize * size;
    TextUtils.buildText(text.toString(), maxW, svgElement, fontSize, 1, iswordwrap);
    let textBounds = svgElement.getBBox();
    this.removeDummySvg(slideId);
    return {
        fontsize: fontSize,
        x: 0,
        y: 0,
        maxwidth: maxW,
        maxheight: maxH,
        width: textBounds.width == 0 ? Math.ceil(maxW) : Math.ceil(textBounds.width),
        height: textBounds.height == 0 ? Math.ceil(maxH) : Math.ceil(textBounds.height),
    };
};

ChartUtils.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index;
};

ChartUtils.prototype.updateImageReSize = function (width, height, originalImageNode, properties, imageType = "logo", voData = null) {
    const imgSrc = originalImageNode.src;
    originalImageNode.src = imgSrc;
    let currentInstance = this;
    if (originalImageNode.dataset && (parseInt(originalImageNode.dataset.height) == 0 || parseInt(originalImageNode.dataset.width) == 0 || (originalImageNode.dataset.style && originalImageNode.style.cssText == ""))) {
        return;
    }
    const numContainerW = parseInt(width);
    const numContainerH = parseInt(height);
    let hasLogo = imageType == "logo" ? "true" : "false";
    originalImageNode.style.removeProperty("min-width");
    originalImageNode.style.removeProperty("min-height");
    originalImageNode.style.removeProperty("max-width");
    originalImageNode.style.removeProperty("max-height");
    originalImageNode.style.removeProperty("filter");
    originalImageNode.style.setProperty("width", "auto");
    originalImageNode.style.setProperty("height", "auto");
    originalImageNode.style.setProperty("margin", "auto");
    // originalImageNode.style.setProperty("position", "absolute");
    originalImageNode.style.setProperty("left", "unset");
    originalImageNode.style.setProperty("right", "unset");
    originalImageNode.style.setProperty("top", "unset");
    originalImageNode.style.setProperty("bottom", "unset");
    originalImageNode.style.setProperty("x", "0");
    originalImageNode.style.setProperty("y", "0");
    originalImageNode.style.setProperty("transform", "scale(1)");
    originalImageNode.style.setProperty("object-fit", "unset");
    let allowFill = originalImageNode.dataset && originalImageNode.dataset.focusParent && originalImageNode.dataset.focusParent && originalImageNode.dataset.focusParent.toLowerCase().includes("infobox");
    let imageDimensionRatio = originalImageNode.width / originalImageNode.height;
    let canvasDimensionRatio = numContainerW / numContainerH;
    // let filltype = originalImageNode.id.includes("logo") ? "fitcanvas" : "fillcanvas";
    let filltype = hasLogo != "false" ? "fitcanvas" : "fillcanvas";
    if (voData) {
        if (originalImageNode) CommonImageUtils.updateImageReSize(originalImageNode, { filltype: filltype, containerwidth: numContainerW, containerheight: numContainerH }, voData?.redrawOpertion?.updateSaveCall, voData?.slideID);
    } else {
        if (imageDimensionRatio < canvasDimensionRatio || (hasLogo != "false" && imageDimensionRatio == canvasDimensionRatio)) {
            if (filltype == "fitcanvas") currentInstance.fitHeight(originalImageNode, numContainerW);
            else currentInstance.fitWidth(originalImageNode, numContainerH);
        } else if (imageDimensionRatio > canvasDimensionRatio) {
            if (filltype == "fitcanvas") currentInstance.fitWidth(originalImageNode, numContainerH);
            else currentInstance.fitHeight(originalImageNode, numContainerW);
        } else {
            originalImageNode.style.setProperty("width", "auto");
            originalImageNode.style.setProperty("height", "auto");
            originalImageNode.style.setProperty("left", "0");
            originalImageNode.style.setProperty("margin", "unset");
            originalImageNode.style.setProperty("top", "0");
        }
        if (originalImageNode && originalImageNode.dataset && originalImageNode.dataset.imagecropalignment && originalImageNode.dataset.imagecropalignment == "bottom" && hasLogo != "center") {
            originalImageNode.style.setProperty("top", "unset");
            originalImageNode.style.setProperty("bottom", "0px");
        }
        if (originalImageNode && originalImageNode.dataset && originalImageNode.dataset.imagecropalignment && originalImageNode.dataset.imagecropalignment == "right") {
            originalImageNode.style.setProperty("right", "0");
            originalImageNode.style.setProperty("left", "unset");
        }
    }
};
ChartUtils.prototype.fitHeight = function (originalImageNode, numContainerW) {
    originalImageNode.style.setProperty("height", "100%");
    originalImageNode.style.setProperty("width", "auto");
    originalImageNode.style.setProperty("margin", "unset");
    originalImageNode.style.setProperty("top", "0");
    originalImageNode.style.setProperty("left", (numContainerW - originalImageNode.width) / 2 / (numContainerW / 100) + "%");
};
ChartUtils.prototype.fitWidth = function (originalImageNode, numContainerH) {
    originalImageNode.style.setProperty("width", "100%");
    originalImageNode.style.setProperty("height", "auto");
    originalImageNode.style.setProperty("left", "0");
    // originalImageNode.style.setProperty("margin", "unset");
    originalImageNode.style.setProperty("top", (numContainerH - originalImageNode.height) / 2 / (numContainerH / 100) + "%");
};
ChartUtils.prototype.clone = function (object) {
    return Object.assign(Object.create(Object.getPrototypeOf(object)), object);
};
ChartUtils.prototype.getOffsetLeftTop = function (imageParent, parenttype = "SLIDE", nextSlide = false, heightonly = true) {
    let item = { x: 0, y: 0 };
    let itemParent = imageParent;
    let elementHeight = "";
    let elementWidth = "";
    while (itemParent && itemParent.dataset && itemParent.dataset.type != parenttype) {
        if (nextSlide && itemParent.getAttribute("id") == "GRAPHIC") {
            elementHeight = itemParent.clientHeight;
            elementWidth = itemParent.clientWidth;
        }
        item.x = itemParent.offsetLeft + item.x;
        item.y = itemParent.offsetTop + item.y;
        itemParent = itemParent.offsetParent;
    }
    if (nextSlide && elementHeight && item.y > elementHeight) item.y = item.y - elementHeight;
    if (nextSlide && elementWidth && item.x > elementWidth && !heightonly) item.x = item.x - elementWidth;
    return { x: item.x, y: item.y };
};

ChartUtils.prototype.createRBGColor = function (color = "tertiary", index, opacity = 1) {
    if (color) {
        let SrtColorCode = color.replace(/\s/g, "");
        if (SrtColorCode.includes("Accent")) {
            index = color.match(/\d+/g) && color.match(/\d+/g).length > 0 ? color.match(/\d+/g)[0] : 1;
            return "rgba(var(--item" + index + "-color-rgb)," + opacity + ")";
        }
        if (SrtColorCode.includes("tertiary")) {
            return "rgba(var(--tertiary-color-rgb)," + opacity + ")";
        }
        if (SrtColorCode.includes("secondary")) {
            return "rgba(var(--secondary-color-rgb)," + opacity + ")";
        }
        if (SrtColorCode.includes("alterbg")) {
            return "rgba(var(--node-contract-color)," + opacity + ")";
        }
        if (SrtColorCode.includes("alterbg")) {
            return "rgba(var(--node-contract-color)," + opacity + ")";
        }
        if (SrtColorCode.includes("clsQuaternaryBg")) {
            return "rgba(var(--quaternary-color-rgb)," + opacity + ")";
        }
        if (SrtColorCode.includes("clsQuaternaryBg")) {
            return "rgba(var(--quaternary-color-rgb)," + opacity + ")";
        }
        if (SrtColorCode.includes("itembgColor")) {
            return "rgba(var(--bg-color-rgb)," + opacity + ")";
        }

        if (SrtColorCode.includes("bg")) {
            return "";
        }
    }
};

ChartUtils.prototype.assetNodeCountChange = function (xmlData, oldXml, objDetails) {
    let operation = xmlData.children.length > oldXml.children.length ? "add" : xmlData.children.length < oldXml.children.length ? "delete" : "";
    let boolenablemenu = false;
    if (operation == "delete") {
        boolenablemenu = oldXml.getAttribute("data-menuminseries") > xmlData.children.length;
    }
    if (operation == "add") {
        boolenablemenu = oldXml.getAttribute("data-menumaxseries") < xmlData.children.length;
    }
    if (boolenablemenu) {
        let shapeName = xmlData.getAttribute("graphicname");
        xmlData.removeAttribute("uniqueLayoutName");
        xmlData.removeAttribute("uniqueLayout");
        let nodeCount = xmlData.children.length;
        let result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, nodeCount, "");
        if (!result) {
            shapeName = ChartHelper.getOldMenu(shapeName);
            result = ""; //MenuParser.getInstance().getMenuForChartNode("chart", shapeName, nodeCount, "");
        }
        objDetails.menu = result;
        ChartDataGenerator.propertyUpdation(xmlData, objDetails);
        SlideUtils.updateUniqueLayout(objDetails.slideId, result.name, "chart", result);
    }
};
ChartUtils.prototype.setmenuData = function (menuDeails) {
    menuDataDetails = menuDeails;
};
ChartUtils.prototype.getmenuData = function () {
    return menuDataDetails;
};
ChartUtils.prototype.getDocumentDefs = function (nodeParent, localDefs = null) {
    let defName = localDefs == true || nodeParent != document.body ? "svgDefsLocal" : "svgDefs";
    let svgDefs = nodeParent.querySelector("[id='" + defName + "']");
    if (!svgDefs) {
        svgDefs = this.SvgUtils.createSVGElement("svg");
        this.SvgUtils.assignAttributes(svgDefs, {
            width: 0,
            height: 0,
            id: defName,
        });
        let defs = this.SvgUtils.createSVGElement("defs");
        svgDefs.appendChild(defs);
        nodeParent.appendChild(svgDefs);
    }
    return svgDefs.children[0];
};
ChartUtils.prototype.appenDefs = function (item, nodeParent) {
    if (item != null) {
        let defs = this.getDocumentDefs(nodeParent);
        if (!this.isAssetInDefs(item.id, defs)) {
            let parser = new DOMParser();
            let svgDOM = parser.parseFromString(item.data, "image/svg+xml").documentElement;
            svgDOM.setAttribute("id", item.id);
            defs.appendChild(svgDOM);
            parser = null;
        }
    }
};
ChartUtils.prototype.isAssetInDefs = function (assetId, defs) {
    for (let i1 = 0; i1 < defs.children.length; i1++) {
        let defNode = defs.children[i1];
        if (defNode.getAttribute("id") == assetId) return true;
    }
    return false;
};
ChartUtils.prototype.applyOverlayToImage = function (imageDetails, colorValue = null, firseIn = false) {
    try {
        if (imageDetails && imageDetails != "") {
            imageDetails.dataset.customFilter = firseIn ? false : true;
            let color;
            if (colorValue && colorValue != "") {
                color = colorValue;
            } else {
                color = imageDetails.style.color != "" ? imageDetails.style.color : imageDetails.style.backgroundImage;
            }
            let isOverLayDiv = imageDetails.parentNode.querySelector("div[data-type='overlay']");
            if (isOverLayDiv && isOverLayDiv != "") {
                imageDetails.parentNode.removeChild(isOverLayDiv);
            }
            let overLayDiv = SVGUtils.createElement("div");
            SVGUtils.assignAttributes(overLayDiv, { id: imageDetails.id + "overlayDiv", class: "overlayDiv", "data-type": "overlay" });
            if (color && color != "transparent" && color != "") {
                if (color.split("-gradient")[0] == "linear") {
                    overLayDiv.style.backgroundImage = color;
                } else {
                    overLayDiv.style.backgroundColor = color;
                }
                imageDetails.parentNode.appendChild(overLayDiv);
            } else if (color == "transparent") {
                imageDetails.parentNode.appendChild(overLayDiv);
            }
        }
    } catch (e) {
        console.log("error occure while applying overlay to image @applyOverlayToImage ..." + e);
    }
};
ChartUtils.prototype.enableTextHeighlight = function (element, data) {
    if (data && data._designerUI) {
    } else {
        if (!!element.innerHTML && TextHighLightUtils) TextHighLightUtils.updateHighlight(element, element.innerHTML);
        let elementType = element.getAttribute("data-type");

        switch (elementType) {
            case "label":
                let index = element.getAttribute("data-id") ? element.getAttribute("data-id").split("_")[0] : "";
                if (index != "") {
                    if (data && data.labelHighlightColor && data.labelHighlightColor[index]) {
                        TextHighLightUtils.createHighlightColor?.(data.labelHighlightColor[index], element, data.moodData);
                    }
                    if (data?._labelTextColor[index]) {
                        TextHighLightUtils.clearStylesBasedOnType(element, "textcolor");
                    }
                }
                break;
        }
    }
};
ChartUtils.prototype.getFontDetails = function (data, legend = false) {
    let category = data && data.baseProperties.fontcategory ? data.baseProperties.fontcategory : "";
    let hasMultiGraphic = data && data.hasmultigraphic;
    if (data.baseProperties.maxAllowedSeries == 1 && category != "singlefill") {
        category = "single";
    }
    if (legend) {
        category = "legend";
    }
    switch (category) {
        case "bar":
            return { maxSize: 54, minSize: 17 };
            break;
        case "column":
            return { maxSize: 68, minSize: 17 };
            break;
        case "legend":
            return { maxSize: 32, minSize: 23 };
            break;
        case "single":
            if (hasMultiGraphic) {
                return { maxSize: 200, minSize: 20 };
            } else {
                return { maxSize: 200, minSize: 79 };
            }
            break;
        case "singlefill":
            return { maxSize: 68, minSize: 17 };
            break;
        default:
            return null;
            break;
    }
};
ChartUtils.prototype.createSpanFormat = function (element, data, sumData = false) {
    let prefixStyle = data.prefixStyle;
    let suffixStyle = data.suffixStyle;
    let arrKeyValue = { input: element.textContent };
    if (element.querySelector("#spanMainText")) {
        if (!element.innerText) {
            let strKeyValue = "";
            for (let i1 = 0; i1 < element.children.length; i1++) {
                strKeyValue += element.children[i1].innerHTML;
            }
            arrKeyValue = { input: strKeyValue };
        } else {
            arrKeyValue = { input: element.innerText };
        }
    }
    let objFormatted = this.formatChartValues(arrKeyValue);
    if (!objFormatted.validData) {
        data.invaidData = true;
    }
    let prefix = document.createElement("span");
    prefix.className = prefixStyle;
    prefix.textContent = !!objFormatted.currencysymbol && data.displayValueFormat != "asentered" ? objFormatted.prefix + objFormatted.currencysymbol : objFormatted.prefix == undefined ? "" : objFormatted.prefix;
    let suffix = document.createElement("span");
    suffix.className = suffixStyle;
    suffix.textContent = !!objFormatted.currencySystem && data.displayValueFormat != "asentered" ? objFormatted.suffix + objFormatted.currencySystem : objFormatted.suffix == undefined ? "" : objFormatted.suffix;

    let valueSpan = document.createElement("span");
    valueSpan.className = "clSpanMainText";
    valueSpan.id = "spanMainText";
    valueSpan.textContent = data.displayValueFormat == "asentered" ? objFormatted.input : objFormatted.value == undefined ? "" : objFormatted.value;
    if (!!objFormatted.currencyValueNormalized && objFormatted.valueSystem && sumData) {
        if (objFormatted.currencyValueNormalized < 0) {
            valueSpan.textContent = -parseInt(objFormatted.valueSystem);
        } else {
            valueSpan.textContent = parseInt(objFormatted.valueSystem);
        }
    }
    if (!element.textContent.includes(valueSpan.textContent + suffix.textContent) && (data.displayValueFormat == "asentered" || (data.displayValueFormat == "currency" && (data._oldDisplayFormat == "asentered" || !data._oldDisplayFormat)))) {
        valueSpan.textContent = objFormatted.valueSystem < 0 && data.displayValueFormat == "asentered" ? objFormatted.input : parseInt(objFormatted.value);
        suffix.textContent = !!objFormatted.suffix ? objFormatted.suffix : "";
        if (data.displayValueFormat != "asentered") DiagramNodeUtils.checkNumberFormat(element, element.parentNode, data.moodData);
        if (element?.querySelector("#spanMainText")?.textContent?.includes(",")) {
            element.querySelector("#spanMainText").dataset.hasnumberformat = true;
        }
    } else {
        element.innerHTML = prefix.outerHTML + valueSpan.outerHTML + suffix.outerHTML;
        element.dataset.oldinnertext = prefix.outerHTML + valueSpan.outerHTML + suffix.outerHTML;
    }
};
ChartUtils.prototype.formatChartValues = function (element) {
    var gDataFormatter = eval("new " + "DataFormatUtil" + "()");
    gDataFormatter.formatCurrency(element);
    return element;
};
ChartUtils.prototype.getSeqNumber = function (moodData, index) {
    let sequenceNumber = moodData && moodData.seqnumproperties ? moodData.seqnumproperties : null;
    if (sequenceNumber) {
        return this.getSeqMoodStyle(sequenceNumber, index);
    } else {
        return index;
    }
};
ChartUtils.prototype.getSeqMoodStyle = function (moodData, index) {
    try {
        let strContent = index;
        // let restrictSequence = properties.ismoodsequence != null && properties.ismoodsequence == false;
        // if (restrictSequence) return strContent;
        if (moodData.sequenceprefix || moodData.sequencesuffix) {
            let prefix = this.setSeqStyle(moodData.sequenceprefix.style, index, true);
            let suffix = this.setSeqStyle(moodData.sequencesuffix.style, index, true);
            let mainStyle = moodData.sequencemain && moodData.sequencemain.style;
            let mainContent = mainStyle && (mainStyle == "abc" || mainStyle == "ABC") ? this.getABCStyle(index - 1, mainStyle == "ABC") : index;
            strContent = prefix + mainContent + suffix;
        }
        return strContent;
    } catch (error) {
        return index;
    }
};
ChartUtils.prototype.setSeqStyle = function (style, index, filterStyle = false) {
    let strContent = "";
    if (style == "0" && index < 10) strContent = style + (filterStyle ? "" : index);
    else if (style == "abc" || style == "ABC") strContent = DiagramUtils.getABCStyle(index - 1, style == "ABC");
    else if (style != "0") strContent = style + (filterStyle ? "" : index);
    return strContent;
};
ChartUtils.prototype.getABCStyle = function (index, isUpperCase) {
    let strAlphabet = "abcdefghijklmnopqrstuvwxyz";
    let arrAbc = isUpperCase ? strAlphabet.toUpperCase().split("") : strAlphabet.split("");
    return arrAbc[index];
};
ChartUtils.prototype.checkPecentageChart = function (data) {
    let suffixDatas = data.suffix;
    for (let i1 = 0; i1 < suffixDatas.length; i1++) {
        if ((suffixDatas[i1] == "%" || (suffixDatas[i1].length > 0 && suffixDatas[i1][0] == "%")) && data._currencySymbol[i1][0] == "") {
            if (i1 == suffixDatas.length - 1) return true;
        } else {
            return false;
        }
    }
};

