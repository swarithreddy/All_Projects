                    gridValueElement.style.marginLeft = "-7px";
                }

                valueElement.style.whiteSpace = "nowrap";
                valueElement.dataset.animation = "gridvalue";
                valueElement.style.textAlign = "end";
                valueElement.style.boxSizing = "border-box";
                if (this.data._directionenable) {
                    valueElement.style.paddingLeft = "20px";
                } else {
                    valueElement.style.paddingRight = "20px";
                }

                if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
