SimpleScaleColumnSeriesItem.prototype.doAddBottomSeriesItemElement = function (argparent, argprops) {
    return;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;
    const numMultpleFactor = this.state.height / totalValue;
    let numBottomHeight = -argprops.minvalue * numMultpleFactor;
    if (argprops.minvalue < 0) {
        let minimumHeight =
            (this.labelAlignment && this.labelAlignment.position == "middle") ||
            (this.valueAlignment && this.valueAlignment.position == "middle") ||
            (this.placeholderAlignment && this.placeholderAlignment.position == "middle") ||
            (this.valueAlignment && this.valueAlignment.position == "middle")
                ? 300
                : 163;
        if (numBottomHeight < minimumHeight && argprops.minvalue < 0) {
            numBottomHeight = minimumHeight;
        }
        numBottomHeight = numBottomHeight > this.state.height - this.itembasedHeight ? this.state.height - this.itembasedHeight : numBottomHeight;
    }

    let minGraphicHeight = (numBottomHeight / this.state.height) * 100;
    const parentWidth = argparent.getAttribute("data-width");
    const element = this.ChartHelper.createDivElement({});
    element.id = "seriesitem-" + groupindex + "_" + index;
    element.className = "seriesitem bottomseriesitem";
    element.style.height = minGraphicHeight + "%";
    element.setAttribute("data-width", parentWidth);
    element.setAttribute("data-height", numBottomHeight);
    if (argparent) argparent.appendChild(element);
    else return element;

    if (argprops.value < 0) {
        var eprops = {
            height: 30,
            index: index,
            gindex: groupindex,
            item: argprops.item,
            value: argprops.value,
            valuetext: argprops.valuetext,
            length: argprops.length,
            minvalue: argprops.minvalue,
            maxvalue: argprops.maxvalue,
            totalvalue: argprops.totalvalue,
            placeholder: argprops.placeholder,
            placeholdername: argprops.placeholdername,
            placeholdertype: argprops.placeholdertype,
            viewport: { x: argprops.viewport.x, y: argprops.viewport.y, width: argprops.viewport.width, height: numBottomHeight },
        };
        // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "top") {
        //     this.doAddBottomPlaceholder(element, argprops);
        // }

        // if (this.displayValue(argprops) && this.valuePosition == "top") {
        //     this.doAddBottomValue(element, argprops);
        // }
        this.doAddBottomGraphicsContainer(element, eprops);

        // this.middleElementvalidationBottom(bkelement, element, middleelementValue, middleelementPlaceholder, middleelementLabel,eprops);
    } else {
        if (bkSubElement) {
            this.middleElementvalidation(bkelement, bkSubElement, middleelementValue, middleelementPlaceholder, middleelementLabel);
        }
    }
};

SimpleScaleColumnSeriesItem.prototype.doAddTopGraphicsContainer = function (argparent, argprops, centerAlign = false) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const groupindex = argprops.gindex;
    objValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();
    let highlightDifferenceHeight = 0;
    if (this.data.highlightDifference.display) {
        highlightDifferenceHeight = 30;
    }
    if(this.data.indualHighlight){
        highlightDifferenceHeight += 30;
}
    // if (this.displayValue(argprops) && this.valueAlignment.position == "middle") _iHeight += valueMaxH-4;

    //if (this.displayPrimaryPlaceholder(argprops) && this.placeholderAlignment.position == "middle") _iHeight += _dataPlaceholder.height;
    if (this.groupindex == 0 && this.index == 0) {
        overlapStackedColumn = false;
    }
    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + groupindex + "_" + index;
    element.className = "basegraphic basetopgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    if (this.labelAlignment.position == "outer" && this.labelAlignment.itemBased != "true" && this.labelAlignment.vposition == "top") this.doAddLabel(element, argprops, true);
    if (this.valueAlignment.position == "outer" && this.valueAlignment.itemBased != "true" && this.valueAlignment.vposition == "top") this.doAddTopValue(element, argprops, true);

    if (this.labelAlignment.position == "middle") {
        //this.labelAlignment.position == "middle" ? labelMaxW * 0.8 : //this.labelAlignment.position == "middle" ? 40 :
        this.middleLW = this.valueAlignment.position == "middle" || this.placeholderAlignment.position == "middle" ? this.labelMaxW * 0.5 : this.labelMaxW * 0.8;
        this.middleLH = 40;
        middleelementLabel = this.ChartHelper.createDivElement({});
        middleelementLabel.id = "middleelement-" + groupindex + "_" + index;
        middleelementLabel.className = "middleelement  moodanimation";
        middleelementLabel.dataset.animation = "columncirclearrow";
        middleelementLabel.style.width = this.middleLW + "px";
        middleelementLabel.style.height = this.middleLH + "px";
        middleelementLabel.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementLabel);
        if (this.labelAlignment.position == "middle") middleelementLabel.className = "middleelementlabel";
        this.createSVGElement(middleelementLabel, argprops, "label");
    }
    if (this.valueAlignment.position == "middle") {
        this.middleVW = parseInt(this.state.width * 0.7 * 0.25);
        this.middleVH = parseInt(this.state.width * 0.7 * 0.25);
        if (this.data.chartName == "columnslider") {
            this.middleVW = parseInt(this.state.width * 0.7 * 0.55);
            this.middleVH = parseInt(this.state.width * 0.7 * 0.55);
        }
        middleelementValue = this.ChartHelper.createDivElement({});
        middleelementValue.id = "middleelement-" + groupindex + "_" + index;
        middleelementValue.className = "middleelement  moodanimation";
        middleelementValue.dataset.animation = "columncirclearrow";
        middleelementValue.style.width = this.middleVW + "px";
        middleelementValue.style.height = this.middleVH + "px";
        middleelementValue.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementValue);
        this.createSVGElement(middleelementValue, argprops, "value");
    }
    if (this.placeholderAlignment.position == "middle" && (this.data.data.getAttribute("primaryplaceholder") || this.data.data.getAttribute("data-primaryplaceholder"))) {
        this.middlePW = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        this.middlePH = parseInt(this.state.width * 0.8) > 100 ? 100 : parseInt(this.state.width * 0.8);
        middleelementPlaceholder = this.ChartHelper.createDivElement({});
        middleelementPlaceholder.id = "middleelement-" + groupindex + "_" + index;
        middleelementPlaceholder.className = "middleelement  moodanimation";
        middleelementPlaceholder.dataset.animation = "columncirclearrow";
        middleelementPlaceholder.style.width = this.middlePW + "px";
        middleelementPlaceholder.style.height = this.middlePH + "px";
        middleelementPlaceholder.style.border = "4px solid rgba(var(--item" + (groupindex + 1) + "-color-rgb),1)";
        element.appendChild(middleelementPlaceholder);
        if (this.data.layout.boolplaceholderShape) {
            this.bgProperties(middleelementPlaceholder);
        }
        this.createSVGElement(middleelementPlaceholder, argprops, "placeholder");
    }

    parentHeight = this.state.height;
    // parentHeight =this.parent.querySelector(".baseseriesitem")?this.parent.querySelector(".baseseriesitem").clientHeight:0;
    // parentHeight = parentHeight<this.state.height?this.state.height:parentHeight;
    let baseGraphicHeight =
        parentHeight - (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight);
    let valueHeight = argprops.minvalue < 0 ? 2 * this.maxValueH : this.maxValueH;
    if (this.valueAlignment.position == "outer") {
        baseGraphicHeight =
            parentHeight -
            (this.maxLabelH + parseInt(this.middlePH * 0.6) + parseInt(this.middleLH * 0.6) + parseInt(this.middleVH * 0.6) + dropShadowHeight + highlightDifferenceHeight + valueHeight);
    }

    let totalValue = argprops.minvalue < 0 ? -argprops.minvalue + argprops.maxvalue : argprops.totalvalue;

    const baseGraphicHeightPercentage = baseGraphicHeight;
    let graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / totalValue);
    let parentPercentage = baseGraphicHeightPercentage * (argprops.totalvalue / totalValue);
    let ParentHeightValue = parentPercentage + this.maxValueH;
    if (this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true" && this.labelAlignment.position == "outer") {
        ParentHeightValue = parentPercentage + this.maxValueH + this.maxLabelH;
    }
    let seriesItem = this.parent.querySelector(".topseriesitem");
    seriesItem.style.height = this.data.SVGUtils.createPercentValue(this.state.height, ParentHeightValue);

    if (this.data.data.getAttribute("data-multiseries") && this.data.seriesItemLength > 1) {
        graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / this.data.seriesItemMaxValue[groupindex]);
    }
    if (this.data.minValue == 0) {
        graphicHeightPercentage = baseGraphicHeightPercentage * ((parseFloat(argprops.value) + 3) / (argprops.maxvalue + 3));
    }
    if (this.valueAlignment.position == "middle") {
        middleelementValue.setAttribute("data-graphic-y", graphicH);
    }
    let backgroundElement;
    if (this.data.layout.enableBackground) {
        let bgClsStyle = this.style.bgFillType;
        let bgClsFillStyle = "";
        if (this.data.layout.backgroundColor == "theme") {
            bgClsFillStyle = this.ChartFonts.graphicFillColor(groupindex);
        } else {
            if (this.data.layout.backgroundColor == "transparent") {
                bgClsFillStyle = " transparent";
            } else {
                bgClsFillStyle = this.ChartFonts.emphasizeFillColor;
            }
        }
        backgroundElement = this.ChartHelper.createDivElement({});
        backgroundElement.id = "backgroundItem-" + groupindex + "_" + index;
        backgroundElement.className = "backgroundItem moodanimation" + " " + bgClsFillStyle;
        backgroundElement.dataset.animation = "itembackground";
        backgroundElement.dataset.customopacity = this.data.layout.backgroundOpacity;
        backgroundElement.dataset.customorgin = "bottom";
        if (this.data.chartName == "columnslider") {
            backgroundElement.style.width = 100 * this.thicknessPercentage + "%";
            backgroundElement.style.borderRadius = "35px";
        }
        element.appendChild(backgroundElement);
        let backgroundBorderElement;
        if (this.data.layout.backgroundBorder) {
            backgroundBorderElement = this.ChartHelper.createDivElement({});
            backgroundBorderElement.className = "backgroundItem moodanimation";
            backgroundBorderElement.style.position = "absolute";
            backgroundBorderElement.style.width = backgroundElement.style.width;
            backgroundBorderElement.dataset.animation = "itembackgroundborder";
            if (this.data.chartName == "barSimpleRounded" || this.data.chartName == "barRoundedFill") backgroundBorderElement.style.borderRadius = this.valueMaxH + "px";
            element.appendChild(backgroundBorderElement);
            backgroundBorderElement.classList.add("shapeborder" + this.data.layout.backgroundBorder.alignment);
            backgroundBorderElement.style.borderWidth = this.data.layout.backgroundBorder.width + "px";
            if (this.data.layout.backgroundBorder.color == "theme") {
                let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
                backgroundBorderElement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
                if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                    this.setHasEmphasis(backgroundBorderElement, strBordeStyleClass, groupindex);
                }
            }
        }
        if (this.data.layout.backgroundItemType == "svg") {
            this.createGraphicsShape(backgroundElement, argprops, false, true);
        }
    }

    let styleIndex = 1 < this.voData.seriesItemLength ? index : groupindex;
    let clsStyle = this.getBgColorDetails(styleIndex, this.ChartFonts.graphicBgColor(styleIndex), this.data.layout.itemColor, "bgcolor"); //this.ChartFonts.graphicBgColor(styleIndex);

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphicconatiner-" + groupindex + "_" + index;
    subelement.className = "graphicconatiner chartgraphic";
    subelement.style.width = "102%";
    if (this.valueAlignment.position == "middle" && this.valueAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middleVW * 0.6) + "px";
    else if (this.placeholderAlignment.position == "middle" && this.placeholderAlignment.hposition != "center")
        subelement.style.width = parseInt(this.state.width * this.gapPercentage * this.thicknessPercentage - this.middlePW * 0.6) + "px";
    // subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : graphicHeightPercentage+"px";
    subelement.style.height = this.data.chartName == "columnStackedRectangle" ? "100%" : this.data.SVGUtils.createPercentValue(ParentHeightValue, graphicHeightPercentage);
    subelement.style.order = 0;
    subelement.style.order = 0;
    subelement.style.display = "flex";
    subelement.setAttribute("data-width", this.state.width);
    subelement.setAttribute("data-height", baseGraphicHeight);
    subelement.style.position = "relative";
    element.appendChild(subelement);
    if (this.graphicElement.alterpos == "true" && groupindex == 0) subelement.classList.add("alterstyle");
    if (centerAlign) {
        subelement.style.alignItems = "center";
    }
    if (this.data.chartName == "columnslider") {
        subelement.style.borderRadius = "35px";
    }
    const graphicElement = this.ChartHelper.createDivElement({});
    graphicElement.id = "graphic-" + groupindex + "_" + index;
    graphicElement.className = "chartgraphic graphicnode moodanimation transformOrginBottom " + clsStyle;
    graphicElement.dataset.customorgin = "bottom";
    graphicElement.style.height = 100 + "%";
    graphicElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
    graphicElement.dataset.animation = "item";

    graphicElement.setAttribute("data-id", groupindex + "_" + index);
    graphicElement.setAttribute("data-type", "ITEM");
    graphicElement.setAttribute("data-animation", "item");
    if (this.data.chartName == "columnStackedRectangle") {
        graphicElement.dataset.animation = "item" + (this.index + 1);
    }

    if (this.data.chartName == "columnslider") {
        graphicElement.style.borderRadius = "35px";
    }
    // if (this.style.bgFillType == "gradient") graphicElement.classList.add("gradient");
    if (this.style.bgFillType == "gradient") {
        graphicElement.style.backgroundImage = this.data.layout.itemGradientValues ? this.data.layout.itemGradientValues : "";
    }
    if (this.style.border == "true") graphicElement.classList.add("chartborder");
    // subelement.appendChild(graphicElement);
    if (this.data.layout.enableBackground) {
        if (this.voData.layout.borderRadiusValues) {
            let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
            let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom
                ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px"
                : 0 + "px";
            let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop
                ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px"
                : 0 + "px";
            let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom
                ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px"
                : 0 + "px";
            backgroundElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
        }
    }
    clsStyle =
        this.data.hasEmphasis && this.data.emphasis[groupindex] != true && !this.data.shapeBorder
            ? this.setNoEmphasis(graphicElement, clsStyle, groupindex)
            : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
            ? this.setHasEmphasis(graphicElement, clsStyle, groupindex)
            : clsStyle;

    if (this.data.chartName != "columnSimpleRectangleFill") {
        ///DropShadow
        let rgbColor = window.getComputedStyle(graphicElement)["background-color"];
        // let rgbaColor = rgbColor.replace(")", ", 0.5)").replace("rgb", "rgba");
        let colorStyle = this.data.layout.itemBoxShdowColor == "item" ? clsStyle : "";
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, styleIndex, this.data.layout.itemBoxShdowOpacity);
        graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
    }
    let borderElement;
    if (this.voData.shapeBorder) {
        borderElement = this.ChartHelper.createDivElement({});
        borderElement.className = "columnborderelement";
        borderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
        borderElement.style.height = "100%";
        subelement.appendChild(borderElement);

        graphicElement.classList.remove(this.data.chartFonts.appendgraphicBgColor(styleIndex));
        graphicElement.classList.add("background-bg-color");

        borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";

        if (this.voData.shapeBoderColor == "theme") {
            let strBordeStyleClass = this.ChartFonts.graphicBorderColor(groupindex);
            borderElement.classList.add(this.data.chartFonts.appendgraphicBgColor(groupindex));
            this.emphasisColor = " tertiary-border-color";
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true) {
                let empasisColor = this.setNoEmphasis(borderElement, strBordeStyleClass, groupindex);
                let rgbaValue = this.ChartUtils.createRBGColor(empasisColor, styleIndex, this.data.layout.itemBoxShdowOpacity);
                graphicElement.style.boxShadow = this.data.layout.itemBoxShadow + " " + rgbaValue;
            }
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] == true) {
                this.setHasEmphasis(borderElement, strBordeStyleClass, groupindex);
            }
            borderElement.classList.add("moodanimation");
            borderElement.dataset.animation = "itemborder";
            borderElement.setAttribute("data-graphic-y", graphicElement.clientHeight);
        }

        borderElement.classList.add("shapeborder" + this.voData.shapeBoderAlign);
        borderElement.style.borderWidth = this.voData.shapeBoderSize + "px";
    }

    if (this.data.borderRadius) {
        graphicElement.style.borderRadius = graphicElement.clientHeight + "px 0% 0%";
    }
    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic graphicnode moodanimation transformOrginBottom " + clsStyle + " projection" + (groupindex + 1);
        graphicElement.dataset.customorgin = "bottom";
    }

    if (this.data.projection[groupindex] == true && this.data.hasProjection && this.data._projectionName == "patternprojection") {
        graphicElement.className = "chartgraphic transformOrginBottom graphicnode " + clsStyle + " projection" + (groupindex + 1);
    }

    if (borderElement) {
        borderElement.classList.remove("columnborderelement");
        borderElement.classList.add("columnborderelement");
    }
    if (this.data.grapicImage[groupindex] == "true" && this.data.seriesItemLength == 1) {
        const subImgelement = document.createElement("img");
        subImgelement.style.width = "100%";
        subImgelement.style.height = "100%";
        subImgelement.src = this.data.seriesItemGraphicPath[groupindex];
        // subImgelement.style.position = "unset";
        subImgelement.id = "graphicimage-" + groupindex + "_" + index;
        subImgelement.className = "graphicimage";
        subImgelement.setAttribute("data-id", groupindex + "_" + index);
        subImgelement.setAttribute("data-type", "IMAGE");
        graphicElement.appendChild(subImgelement);
        let item = this.ChartUtils.getOffsetLeftTop(graphicElement, "SLIDE", true);
        graphicElement.setAttribute("data-x", item.x);
        graphicElement.setAttribute("data-y", item.y);
        graphicElement.setAttribute("data-width", graphicElement.clientWidth);
        graphicElement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-width", graphicElement.clientWidth);
        subImgelement.setAttribute("data-height", graphicElement.clientHeight);
        subImgelement.setAttribute("data-imagepath", this.data.seriesItemGraphicPath[groupindex]);

        subImgelement.setAttribute("data-x", item.x);
        subImgelement.setAttribute("data-y", item.y);
        graphicElement.style.position = "absolute";
        graphicElement.style.overflow = "hidden";
        if (
            this.data.data.getAttribute("layout") == "outsidenumberbottom" ||
            this.data.data.getAttribute("layout") == "outsidenumberinsidelabel" ||
            this.data.data.getAttribute("layout") == "outsidenumber" ||
            this.data.data.getAttribute("layout") == "labeloutsidetop"
        ) {
            // subImgelement.style.position = "absolute";
            graphicElement.style.position = "relative";
        }
        this.ChartUtils.updateImageReSize(graphicElement.clientWidth, graphicElement.clientHeight, subImgelement, "", "img");
        if (this.data.layout.itemFillType == "imagewithfilter") {
            SlideUtils.applyOverlayToImage(subImgelement, "var(--item" + (styleIndex + 1) + "-color)");
        }
    }
    if (this.index == 1) {
        graphicElement.classList.remove("chartgraphic");
    }

    if (
        (this.labelAlignment.samepos == "true" || this.valueAlignment.samepos == "true" || this.placeholderAlignment.samepos == "true") &&
        (this.labelAlignment.itemBased == "true" ||
            this.valueAlignment.itemBased == "true" ||
            this.placeholderAlignment.itemBased == "true" ||
            this.labelAlignment.position == "inner" ||
            this.valueAlignment.position == "inner" ||
            this.placeholderAlignment.position == "inner")
    ) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        this.doAddTopValue(element, argprops, true);
        let booloverLap = graphicH < this.maxLabelH + this.maxValueH + (this.middleLH + this.middleVH + this.middlePH);
        const vLayoutName = this.labellayoutClassName("container");
        const sameElement = this.ChartHelper.createDivElement({});
        sameElement.id = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt-" : "sameelement-") + groupindex + "_" + index;
        sameElement.className = (this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? "itembasedsameeelemnt " : "sameelement ") + vLayoutName;
        sameElement.style.display = "flex";
        sameElement.style.flexDirection = "column";
        sameElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

        if (booloverLap) {
            let overlapParentDiv = this.ChartHelper.createDivElement({});
            subelement.parentNode.appendChild(overlapParentDiv);
            overlapParentDiv.appendChild(subelement);
            overlapParentDiv.appendChild(sameElement);
            this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                style: "display:flex;align-items: flex-end;width:100%",
            });
            if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
        } else {
            subelement.appendChild(sameElement);
        }
        if (this.labelAlignment.samepos == "true" && this.displayLabel(argprops)) {
            this.addlabel = true;
            this.labelStyle =
                this.labelAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.labelOuterColor : this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            // if (booloverLap) this.doAddLabel(element, argprops);
            this.doAddLabel(sameElement, argprops);
        }
        if (this.valueAlignment.samepos == "true" && this.displayValue(argprops)) {
            this.addvalue = true;
            this.valueStyle =
                this.valueAlignment.itemBased == "true" || booloverLap ? this.ChartFonts.valueOuterColor : this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            // if (booloverLap) this.doAddTopValue(element, argprops);
            this.doAddTopValue(sameElement, argprops);
        }
        if (this.placeholderAlignment.samepos == "true" && this.displayPrimaryPlaceholder(argprops)) {
            this.placeholderStyle =
                this.placeholderAlignment.itemBased == "true"
                    ? this.ChartFonts.graphicFillColor(styleIndex)
                    : this.voData.shapeBorder
                    ? this.ChartFonts.valueOuterColor
                    : this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(sameElement, argprops);
        }
    }

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "outer" && this.placeholderAlignment.itemBased != "true") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            this.doAddTopPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner" && this.placeholderAlignment.samepos != "true") {
            const pLayoutName = this.placeholderlayoutClassName("containerplaceholder");
            const placeholderElement = this.ChartHelper.createDivElement({});
            placeholderElement.id = "placeholderelement-" + groupindex + "_" + index;
            placeholderElement.className = "placeholderelement " + pLayoutName;
            placeholderElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(placeholderElement);
            this.placeholderStyle = this.ChartFonts.valueInnerColor;
            this.doAddTopPlaceholder(placeholderElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom") {
            this.placeholderStyle = this.ChartFonts.graphicFillColor(styleIndex);
            element.style.order = 1;
            this.doAddTopPlaceholder(argparent, argprops);
        }
    }

    if (this.displayLabel(argprops)) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddLabel(element, argprops, true);
        if (this.labelAlignment.position == "inner" && this.labelAlignment.samepos != "true" && graphicH > this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "labelelement-" + groupindex + "_" + index;
            labelElement.className = "labelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(labelElement);
            this.labelStyle = this.voData.shapeBorder ? this.ChartFonts.labelOuterColor : this.ChartFonts.labelInnerColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            if (this.data.hasEmphasis && this.data.emphasis[groupindex] != true && (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
            }
            if (
                this.data.hasEmphasis &&
                this.data.emphasis[groupindex] == true &&
                this.voData.shapeBorder &&
                (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")
            ) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            if (
                this.data.projection[groupindex] == true &&
                this.data.hasProjection &&
                (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")
            ) {
                this.labelStyle = this.ChartFonts.labelOuterColor;
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.labelStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (
                this.data.projection[groupindex] == true &&
                this.voData.shapeBorder &&
                this.data.hasProjection &&
                (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")
            ) {
                this.labelStyle = this.ChartFonts.labelInnerColor;
            }
            this.doAddLabel(labelElement, argprops);
        } else if (this.labelAlignment.itemBased == "true" && this.labelAlignment.samepos != "true" && this.labelAlignment.position != "inner") {
            const vLayoutName = this.labellayoutClassName("containerlabel");
            const labelElement = this.ChartHelper.createDivElement({});
            labelElement.id = "itembasedlabelelement-" + groupindex + "_" + index;
            labelElement.className = "itembasedlabelelement " + vLayoutName;
            labelElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";

            if (graphicH < this.maxLabelH + this.valueMaxH + (this.middleLH + this.middleVH + this.middlePH)) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                subelement.parentNode.appendChild(overlapParentDiv);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(labelElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");

                subelement.style.width = "50%";
            } else {
                subelement.appendChild(labelElement);
            }
            this.labelStyle = this.ChartFonts.labelOuterColor;
            this.labeMaxH = subelement.clientHeight * 0.8;
            this.doAddLabel(labelElement, argprops);
        } else if (
            (this.labelAlignment.position == "outer" && this.labelAlignment.vposition == "top" && this.labelAlignment.itemBased != "true") ||
            graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)
        ) {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            if (graphicH < this.maxLabelH + (this.middleLH + this.middleVH + this.middlePH)) this.middleElementoverlapvalidation("label");
            this.doAddLabel(element, argprops);
        } else if (this.labelAlignment.vposition == "bottom") {
            this.labelStyle = this.ChartFonts.labelOuterColor;
            element.style.order = 1;
            this.doAddLabel(argparent, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        graphicH = Math.round(baseGraphicHeight * graphicHeightPercentage);
        this.doAddTopValue(element, argprops, true);
        if (this.valueAlignment.itemBased == "true" && this.valueAlignment.samepos != "true") {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "itembasedvalueelement-" + groupindex + "_" + index;
            valueElement.className = "itembasedvalueelement " + vLayoutName;
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            if (graphicH < this.valueMaxH) {
                let overlapParentDiv = this.ChartHelper.createDivElement({});
                let label = subelement.parentNode.getElementsByClassName("label");
                subelement.parentNode.appendChild(overlapParentDiv);
                subelement.parentNode.appendChild(label[0]);
                overlapParentDiv.appendChild(subelement);
                overlapParentDiv.appendChild(valueElement);
                this.data.SVGUtils.assignAttributes(overlapParentDiv, {
                    style: "display:flex;align-items: flex-end;width:100%",
                });
                if (this.graphicElement.alterpos == "true" && groupindex == 0) overlapParentDiv.classList.add("alterstyle");
                subelement.style.width = "50%";
            } else {
                subelement.appendChild(valueElement);
            }

            this.valueStyle = this.ChartFonts.valueOuterColor;
            this.doAddTopValue(valueElement, argprops);
        } else if (
            (this.valueAlignment.position == "outer" ||
                (this.data.chartName == "columnStackedRectangle" && subelement.clientHeight < this.maxValueH) ||
                graphicH < this.maxValueH + (this.middleLH + this.middleVH + this.middlePH)) &&
            this.valueAlignment.itemBased != "true"
        ) {
            this.valueStyle =
                this.data.hasEmphasis && this.data.emphasis[groupindex] != true
                    ? this.data._emphasisName == "greyemphasize"
                        ? this.ChartFonts.labelOuterColor
                        : this.ChartFonts.valueOuterColor
                    : this.data.hasEmphasis && this.data.emphasis[groupindex] == true
                    ? this.ChartFonts.graphicColor(styleIndex)
                    : this.ChartFonts.valueOuterColor;
            if (this.data.hasProjection && this.data._projectionName == "projection-fill-multicolor") {
                let tempstyle = this.getColorDetails(this.groupindex, this.valueStyle, this.data.layout.valueColor, "color");
                if (tempstyle == "clsAccentColor") {
                    if (this.data.projection[groupindex] == true) {
                        this.valueStyle = this.ChartFonts.graphicColor(5);
                    } else {
                        this.valueStyle = this.ChartFonts.graphicColor(0);
                    }
                }
            }
            graphicH = Math.round(subelement.clientHeight) - this.maxValueH;
            if (this.data.layout.enableBackground) {
                this.valueAlignment.position == "inner" ? this.doAddTopValue(element, argprops) : this.doAddTopValue(argparent, argprops);
            } else if (this.data.chartName == "columnStackedRectangle") {
                overlapStackedColumn = true;
                this.removeValueElement();
            } else this.doAddTopValue(element, argprops);
        } else if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight > this.maxValueH) {
            const vLayoutName = this.valuelayoutClassName("containervalue");
            const valueElement = this.ChartHelper.createDivElement({});
            valueElement.id = "valueelement-" + groupindex + "_" + index;
            valueElement.className = "valueelement " + vLayoutName;
            valueElement.style.zIndex = "1";
            valueElement.style.width = this.labelAlignment.itemBased == "true" || this.valueAlignment.itemBased == "true" ? this.state.width * 0.4 + "px" : "100%";
            subelement.appendChild(valueElement);
            this.valueStyle = this.voData.shapeBorder ? this.ChartFonts.valueOuterColor : this.ChartFonts.valueInnerColor;
            if (
                this.data.hasEmphasis &&
                this.data.emphasis[groupindex] == true &&
                this.voData.shapeBorder &&
                (this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern")
            ) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            if (
                this.data.projection[groupindex] == true &&
                this.data.hasProjection &&
                (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha")
            ) {
                if (this.data._projectionName == "projection-basic-border-invert" || this.data._projectionName == "projection-alpha") {
                    this.valueStyle = this.ChartFonts.graphicColor(groupindex);
                }
            }
            if (
                this.data.projection[groupindex] == true &&
                this.voData.shapeBorder &&
                this.data.hasProjection &&
                (this.data._projectionName == "projection-basic-border-grey" || this.data._projectionName == "projection-basic-border-invert")
            ) {
                this.valueStyle = this.ChartFonts.valueInnerColor;
            }
            this.doAddTopValue(valueElement, argprops);
        } else if (this.valueAlignment.vposition == "bottom" || (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH)) {
            this.valueStyle = this.ChartFonts.valueOuterColor;
            element.style.order = 1;
            if (this.valueAlignment.position == "inner" && this.valueAlignment.samepos != "true" && subelement.clientHeight < this.maxValueH) {
                this.overlap =subelement.clientHeight < this.maxValueH
                this.doAddTopValue(element, argprops);
            } else {
                this.doAddTopValue(argparent, argprops);
            }
        }
    }
    bkelement = element;
    bkSubElement = subelement;
    this.middleElementvalidation(element, subelement, middleelementValue, middleelementPlaceholder, middleelementLabel);
    if (this.voData.layout.borderRadiusValues) {
        let borderRadiuslefttop = this.voData.layout.borderRadiusValues.letftop ? (parseInt(this.voData.layout.borderRadiusValues.letftop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.voData.layout.borderRadiusValues.leftbottom
            ? (parseInt(this.voData.layout.borderRadiusValues.leftbottom) / 100) * graphicElement.clientHeight + "px"
            : 0 + "px";
        let borderRadiusRightTop = this.voData.layout.borderRadiusValues.righttop ? (parseInt(this.voData.layout.borderRadiusValues.righttop) / 100) * graphicElement.clientHeight + "px" : 0 + "px";
        let borderRadiusRightBottom = this.voData.layout.borderRadiusValues.rightbottom
            ? (parseInt(this.voData.layout.borderRadiusValues.rightbottom) / 100) * graphicElement.clientHeight + "px"
            : 0 + "px";
        graphicElement.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
    let multiSeries = this.data.data.getAttribute("data-multiseries") ? true : false;
    if ((this.data.comparisonStyle == "style2" && this.data.seriesItemLength < 2 && this.data.rangeNegative >= 0) || (this.data.comparisonStyle == "style2" && multiSeries)) {
        differnceIndex = multiSeries ? index : groupindex;
        let boolEnablecomparestyle = "";
        if (multiSeries) {
            boolEnablecomparestyle =
                differnceIndex == 0
                    ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index + 1])
                    : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex][index - 1]);
        } else {
            boolEnablecomparestyle =
                differnceIndex == 0
                    ? parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex + 1][index])
                    : parseFloat(this.data.values[groupindex][index]) < parseFloat(this.data.values[groupindex - 1][index]);
        }

        if (boolEnablecomparestyle) {
            let differentValue1;
            if (multiSeries) {
                differentValue1 =
                    differnceIndex == 0
                        ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index])
                        : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            } else {
                differentValue1 =
                    differnceIndex == 0
                        ? parseFloat(this.data.values[groupindex][index + 1]) - parseFloat(this.data.values[groupindex][index])
                        : parseFloat(this.data.values[groupindex][index - 1]) - parseFloat(this.data.values[groupindex][index]);
            }
            let differentValue = ((differentValue1 / this.data.rangePositive) * 100).toFixed(0) + "%";
            let eprops = {
                differentValue: differnceIndex == 0 ? differentValue : differentValue,
            };
            this.createCompareStyle(element, eprops, graphicElement);
        }
    }
    if (this.data.chartName == "columnSimpleRectangleFill") {
        this.createRect(graphicElement, argparent);
    }
    if (this.data.layout.itemFillType == "pattern") {
        this.createPatternSvg(graphicElement);
        if (borderElement) borderElement.style.zIndex = "3";
    }
    if (this.data.layout.backgroundFillType == "pattern") {
        this.createPatternSvg(backgroundElement);
        subelement.parentNode.appendChild(subelement);
    }
    if (this.voData.chartName == "barFXGScaleVerticalChart") this.createGraphicsScaleShape(subelement, argprops);
    else if (this.voData.chartName == "barVerticalMaskChart") this.createGraphicsMaskShape(subelement, argprops);
    else this.createGraphicsShape(subelement, argprops);
    ///DropShadow
    if (this.data.layout.itemShadow && this.data.chartName != "barStackedRectangle") {
        graphicElement.classList.add(this.data.layout.itemShadow);
    }
    if(this.data.layout.itemOpacityClass){
        graphicElement.style.opacity = this.data.layout.itemOpacity;
        graphicElement.dataset.customopacity = this.data.layout.itemOpacity;
    }
};

SimpleScaleColumnSeriesItem.prototype.doAddBottomGraphicsContainer = function (argparent, argprops) {
    let _oHeight = 0;
    let _iHeight = 0;
    const index = argprops.index;
    const _dataValue = this.getValueBounds();
    const _dataPlaceholder = this.getPlaceholderBounds();

    // if (this.displayValue(argprops) && this.valuePosition == "middle") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "middle") _iHeight += _dataPlaceholder.height;

    const parentHeight = argparent.getAttribute("data-height");
    const baseGraphicHeight = parentHeight - _iHeight;
    const baseGraphicHeightPercentage = baseGraphicHeight / parentHeight;
    const graphicHeightPercentage = baseGraphicHeightPercentage * (argprops.value / argprops.minvalue);

    const element = this.ChartHelper.createDivElement({});
    element.id = "base-graphic-" + index;
    element.className = "basegraphic basebottomgraphic";
    element.style.width = "100%";
    element.style.height = "calc(100% - " + _oHeight + "px)";
    if (argparent) argparent.appendChild(element);
    else return element;

    const subelement = this.ChartHelper.createDivElement({});
    subelement.id = "graphiccond-" + index;
    subelement.className = "graphiccond bottomgraphic";
    subelement.style.height = graphicHeightPercentage * 100 + "%";
    subelement.setAttribute("data-width", this.state.width);
    subelement.setAttribute("data-height", baseGraphicHeight * -graphicHeightPercentage);
    element.appendChild(subelement);

    argprops.rotation = 180;

    // if (this.displayValue(argprops) && this.valuePosition == "middle") _iHeight += _dataValue.height;

    // if (this.displayPrimaryPlaceholder(argprops) && this.placeholderPosition == "middle") _iHeight += _dataPlaceholder.height;

    if (this.displayPrimaryPlaceholder(argprops)) {
        if (this.placeholderAlignment.position == "middle") {
            this.placeholderStyle = "outerstyle";
            this.doAddBottomPlaceholder(element, argprops);
        } else if (this.placeholderAlignment.position == "inner") {
            this.placeholderStyle = "innerstyle";
            this.doAddBottomPlaceholder(subelement, argprops);
        }
    }

    if (this.displayValue(argprops)) {
        if (this.valueAlignment.position == "outer") {
            this.valueStyle = "clsSecondaryTextColor";
            this.doAddBottomValue(element, argprops);
        } else if (this.valueAlignment.position == "inner") {
            this.valueStyle = "clsContrastColor";
            this.doAddBottomValue(subelement, argprops);
        }
    }
    // this.createGraphicsShape(subelement, argprops, true);
};

SimpleScaleColumnSeriesItem.prototype.createGraphicsMaskShape = function (subelement, argprops) {
    // subelement.style.border= "2px solid red";
    let asset = this.data.asset.data[0];
    let assetBounds = DocumentStore.getInstance().getAssetDimensions(this.data.asset.data[0].id);
    assetBounds = !assetBounds
        ? {
              width: asset.assetWidth,
              height: asset.assetHeight,
          }
        : assetBounds;
    let numScale = subelement.clientWidth / assetBounds.width;
    let scaleX = subelement.clientWidth / assetBounds.width;
    let scaleY = this.state.height / assetBounds.width;
    numScale = scaleX < scaleY ? scaleX : scaleY;
    let strStyleClass = 1 < this.voData.seriesItemLength ? "item" + (argprops.index + 1) : "item" + (argprops.gindex + 1);
    strStyleClass =
        this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true ? "outerColor1" : this.data.hasEmphasis && this.data.emphasis[argprops.gindex] == true ? "item1" : strStyleClass;
    let numFillOpacity = this.data.emphasis[argprops.gindex] == true ? 1 : 0.5;
    numFillOpacity = this.data.hasEmphasis ? numFillOpacity : 1;
    let numStrokeOpacity = this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true ? 0 : 1;
    numFillOpacity = this.voData.customProperties.appearance == "Outline" ? 0 : numFillOpacity;
    numStrokeOpacity = this.voData.customProperties.appearance == "Outline" ? 1 : numStrokeOpacity;
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-container" + argprops.gindex + "_" + argprops.index,
        class: "graphic-container",
        x: "0%", //SVGUtils.createPercentValue(this.width, this.rectGraphics.x),
        y: "0%", //SVGUtils.createPercentValue(this.height, this.rectGraphics.y),
        width: "100%", //SVGUtils.createPercentValue(this.width, this.rectGraphics.width),
        height: "100%", //SVGUtils.createPercentValue(this.height, this.rectGraphics.height),
        "stroke-opacity": numStrokeOpacity,
        "fill-opacity": numFillOpacity,
        fill: "url(#pattern)",
    });
    subelement.appendChild(svgElement);

    let svgPosition = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgPosition, {
        id: "graphic-" + argprops.gindex + "_" + argprops.index,
        class: "graphic " + strStyleClass,
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });

    if (asset.appearance != "RealImage") {
        let svgIcon = this.data.SVGUtils.createSVGElement("use");
        this.data.SVGUtils.assignAttributes(svgIcon, {
            x: "0%",
            y: "0%",
            class: strStyleClass,
            width: assetBounds.width,
            height: assetBounds.height,
            transform: "scale(" + numScale + ")",
            "xlink:href": "#" + asset.id,
        });
        svgPosition.appendChild(svgIcon);
    } else {
        let image = this.data.SVGUtils.createSVGElement("image");
        this.data.SVGUtils.assignAttributes(image, {
            x: "0%",
            y: "0%",
            // "xlink:href": IndexStore.getInstance().staticServerURL + asset.url,
            transform: "scale(" + numScale + ")",
            width: assetBounds.width,
            height: assetBounds.height,
        });
        svgPosition.appendChild(image);
    }
    svgElement.appendChild(svgPosition);
};

SimpleScaleColumnSeriesItem.prototype.createGraphicsScaleShape = function (subelement, argprops) {
    // subelement.style.border = "2px solid red";
    let asset = this.data.asset.data[0];
    let assetBounds = DocumentStore.getInstance().getAssetDimensions(this.data.asset.data[0].id);
    assetBounds = !assetBounds
        ? {
              width: asset.assetWidth,
              height: asset.assetHeight,
          }
        : assetBounds;
    let elementW = subelement.clientWidth;
    let elementH = subelement.clientHeight;
    let scaleX = elementW / assetBounds.width;
    let scaleY = elementH / assetBounds.height;
    let strStyleClass = 1 < this.voData.seriesItemLength ? "item" + (argprops.index + 1) : "item" + (argprops.gindex + 1);
    strStyleClass =
        this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true ? "outerColor1" : this.data.hasEmphasis && this.data.emphasis[argprops.gindex] == true ? "item1" : strStyleClass;
    let numFillOpacity = this.data.emphasis[argprops.gindex] == true ? 1 : 0.5;
    numFillOpacity = this.data.hasEmphasis ? numFillOpacity : 1;
    let numStrokeOpacity = this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true ? 0 : 1;
    numFillOpacity = this.voData.customProperties.appearance == "Outline" ? 0 : numFillOpacity;
    numStrokeOpacity = this.voData.customProperties.appearance == "Outline" ? 1 : numStrokeOpacity;
    let rotateX = elementW / 2; //this.rectGraphics.x +
    let rotateY = elementH / 2; //this.rectGraphics.y +
    let rotateDegree = this.numValue < 0 ? 180 : 0;

    let svgParentGroup = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgParentGroup, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    subelement.appendChild(svgParentGroup);
    let svgBaseGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(svgBaseGroup, {
        transform: "rotate(" + rotateDegree + "," + rotateX + "," + rotateY + ")",
        // "data-x": this.rectGraphics.x,
        // "data-y": this.rectGraphics.y,
        "data-width": elementW,
        "data-height": elementH,
    });
    svgParentGroup.appendChild(svgBaseGroup);
    let svgElement = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "graphic-container" + argprops.gindex + "_" + argprops.index,
        class: "graphic-container",
        x: "0%", //SVGUtils.createPercentValue(this.width, this.rectGraphics.x),
        y: "0%", //SVGUtils.createPercentValue(this.height, this.rectGraphics.y),
        width: elementW, //SVGUtils.createPercentValue(this.width, elementW),
        height: elementH, //SVGUtils.createPercentValue(this.height, elementH),
        // "data-x": this.rectGraphics.x,
        // "data-y": this.rectGraphics.y,
        "data-width": elementW,
        "data-height": elementH,
    });
    if (this.data.enableCustomMinValue && this.numValue <= this.data.customMinValue)
        this.data.SVGUtils.assignAttributes(svgElement, {
            style: "display:none",
        });
    else
        this.data.SVGUtils.assignAttributes(svgElement, {
            style: "display:block",
        });
    svgBaseGroup.appendChild(svgElement);

    let svgPosition = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(svgPosition, {
        id: "graphic-" + argprops.gindex + "_" + argprops.index,
        class: "graphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "stroke-opacity": numStrokeOpacity,
        "fill-opacity": numFillOpacity,
        "data-drawType": "Normal",
    });
    let parentGroup = this.data.SVGUtils.createSVGElement("g");
    this.data.SVGUtils.assignAttributes(parentGroup, {
        "data-animation": "shapemask",
        class: "transformOrginBottom moodanimation",
    });
    parentGroup.dataset.customorgin = "bottom";
    let svgIcon = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(svgIcon, {
        class: "graphicuse " + strStyleClass,
        x: "0%",
        y: "0%",
        width: assetBounds.width,
        height: assetBounds.height,
        transform: "scale(" + scaleX + "," + scaleY + ")",
        "xlink:href": "#" + asset.id,
        "stroke-opacity": numStrokeOpacity,
        "fill-opacity": numFillOpacity,
        "data-hover": this.data.validHover,
        "data-hover-value": this.numValue,
    });
    parentGroup.appendChild(svgIcon);
    svgPosition.appendChild(parentGroup);
    svgElement.appendChild(svgPosition);
    //return svgBaseGroup;
};

SimpleScaleColumnSeriesItem.prototype.createGraphicsShape = function (argparent, argprops, bottomelement = false, bgElement = false) {
    let intGraphicsWidth = argparent.clientWidth;
    let intGraphicsHeight = argparent.clientHeight; //argparent.getAttribute("data-height");
    let xValue = 0;
    let yValue = 0;
    if (this.data.layout.itemShadowValues && this.data.layout.itemShadowValues.length > 0) {
        intGraphicsWidth = argparent.clientWidth;
        intGraphicsHeight = argparent.clientHeight;
        xValue = (argparent.clientWidth - intGraphicsWidth) / 2;
        yValue = (argparent.clientHeight - intGraphicsHeight) / 2;
    }
    this.data.SVGUtils.assignAttributes(argparent, {
        "data-type": "ITEM",
    });

    ///
    let svgAsset;
    if (this.data.chartName == "barFXGHandVerticalChart") {
        this.asset = this.data.asset.data[this.ChartUtils.getFactorIndex(this.groupindex, 4)].data;
        this.assetName = this.data.asset.name;
    } else {
        this.asset = this.data.asset.data[0].data;
        this.assetName = this.data.asset.name;
    }
    if (!this.asset) {
        if (this.data.presentMode && this.data.slideObj.querySelector("#series-0").parentElement.querySelector("#container")) {
            svgAsset = this.data.slideObj.querySelector("#series-0").parentElement.querySelector("#container").children[0].children[0].children[0].cloneNode(true);
        } else {
            if (argprops.gindex == 0 && this.data.slideObj.querySelector("#series-" + argprops.gindex)) {
                if (this.data.slideObj.querySelector("#series-" + argprops.gindex)) {
                    this.data.svgcolumnasset = this.data.slideObj
                        .querySelector("#series-" + argprops.gindex)
                        .querySelector("#container")
                        .children[0].children[0].children[0].cloneNode(true);
                } else {
                    this.data.svgcolumnasset = this.data.slideObj.querySelector("#series-0").querySelector("#container")
                        ? this.data.slideObj.querySelector("#series-0").querySelector("#container").children[0].children[0].children[0].cloneNode(true)
                        : "";
                }
            }
            if (this.data.svgcolumnasset) {
                svgAsset = this.data.svgcolumnasset.cloneNode(true);
            }
        }
    } else {
        svgAsset = this.asset.cloneNode(true);
    }
    if (svgAsset) {
        if (svgAsset && svgAsset.getAttribute("viewBox")) {
            svgAsset.setAttribute("viewBoxDefault", svgAsset.getAttribute("viewBox"));
        }
        let arrViewBox = svgAsset.getAttribute("viewBoxDefault")
            ? svgAsset.getAttribute("viewBoxDefault").split(" ")
            : svgAsset.getAttribute("viewboxdefault")
            ? svgAsset.getAttribute("viewboxdefault").split(" ")
            : svgAsset.getAttribute("viewBox")
            ? svgAsset.getAttribute("viewBox").split(" ")
            : "0 0 400 400";
        let numProportionateScale = intGraphicsWidth / arrViewBox[2];
        let numContainerProportionateScale = 100 / (numProportionateScale * 100);
        let itemMinSize = parseInt(arrViewBox[3] * numProportionateScale);
        if (bottomelement) itemMinSize = parseInt(arrViewBox[3] * numProportionateScale);
        let graphicParentMaxHeight = intGraphicsHeight > 11 ? intGraphicsHeight : 11;
        intGraphicsHeight = itemMinSize < intGraphicsHeight ? intGraphicsHeight : itemMinSize;
        //

        let clstyle =
            this.data.hasEmphasis && this.data.emphasis[argprops.gindex] != true
                ? "clsTertiaryFill"
                : this.data.hasEmphasis && this.data.emphasis[argprops.gindex] == true
                ? "clsAccentfill"
                : this.getBgFillDetails(argprops.gindex, this.data.ChartFonts.appendgraphicFillColor(argprops.gindex), this.data.layout.itemColor, "bgcolor");
        let svgGraphicMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
            id: "graphicmask-container ",
            x: "1%",
            y: "0%",
            width: "98%",
            height: "100%",
            // filter: "url(#f1" + argprops.gindex + ")",
            style: "overflow:hidden !important",
        });
        argparent.appendChild(svgGraphicMaskContainer);
        if (bgElement && this.data.layout.backgroundOpacity) {
            this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
                "fill-opacity": this.data.layout.backgroundOpacity,
            });
        }

        let svgMaskContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgMaskContainer, {
            id: "mask-container",
            x: "0%",
            y: "0%",
            width: "100%",
            height: "100%",
            style: "overflow:hidden !important",
            "data-mask": "true",
            class: clstyle + " chartMainGraphic",
        });
        if (bgElement) {
            this.data.SVGUtils.assignAttributes(svgMaskContainer, {
                class: "",
            });
        }
        svgGraphicMaskContainer.appendChild(svgMaskContainer);
        let svgContainer = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(svgContainer, {
            id: "container",
            x: xValue,
            y: yValue,
            width: this.state.width + "px",
            height: intGraphicsHeight + "px",
            style: "overflow:hidden !important",
        });
        svgMaskContainer.appendChild(svgContainer);
        let svgparetGroup = this.data.SVGUtils.createSVGElement("g");
        this.data.SVGUtils.assignAttributes(svgparetGroup, {
            "data-animation": "shapeitem",
            "data-graphic-y": intGraphicsHeight,
            class: "moodanimation transformOrginBottom",
        });
        let svgGroup = this.data.SVGUtils.createSVGElement("g");
        svgContainer.appendChild(svgparetGroup);
        svgparetGroup.appendChild(svgGroup);
        svgGroup.appendChild(svgAsset);
        this.data.SVGUtils.assignAttributes(svgGroup, {
            transform: "scale(" + numProportionateScale + "," + numProportionateScale + ")",
        });
        this.data.SVGUtils.assignAttributes(svgAsset, {
            width: numContainerProportionateScale * 100 + "%",
            height: numContainerProportionateScale * 100 + "%",
        });
        this.updateSize(svgAsset, intGraphicsWidth, intGraphicsHeight * numContainerProportionateScale);
        if (bottomelement && this.data.seriesLength > 3) {
            this.data.SVGUtils.assignAttributes(svgGraphicMaskContainer, {
                height: svgAsset.getBBox().height,
            });
        }
        argparent.style.height = argparent.clientHeight < 12 ? 12 + "px" : graphicParentMaxHeight + "px";
    }
};

SimpleScaleColumnSeriesItem.prototype.updateSize = function (svgAsset, width, height) {
    const intPad = 2;
    const th = this.getViewBoxValue(svgAsset.getElementById(this.assetName + "-top"), 3);
    const bh = this.getViewBoxValue(svgAsset.getElementById(this.assetName + "-bottom"), 3);
    let ch = height - (th + bh);
    ch = ch < 0 ? 1 : ch;
    ch += intPad;
    let gap = this.asset ? intPad / 2 : 0;
    if (ch != NaN && bh != 0) {
        let y = Number(svgAsset.getElementById(this.assetName + "-centerUse").getAttribute("y")) - gap;
        svgAsset.getElementById(this.assetName + "-centerUse").setAttribute("y", y);
        svgAsset.getElementById(this.assetName + "-centerUse").setAttribute("height", ch);
    }
};

SimpleScaleColumnSeriesItem.prototype.createProjection = function (argParent, argprops) {
    let patternDefsTag = this.data.SVGUtils.createSVGElement("defs");
    let patternTag = this.data.SVGUtils.createSVGElement("pattern");
    this.data.SVGUtils.assignAttributes(patternTag, {
        id: "pattern",
        patternUnits: "userSpaceOnUse",
        width: "20",
        height: "20",
    });
    patternDefsTag.appendChild(patternTag);
    let patternMaskTag = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(patternMaskTag, {
        id: "mask" + argprops.gindex + "_" + argprops.index,
        patternUnits: "userSpaceOnUse",
    });
    patternDefsTag.appendChild(patternMaskTag);
    let patternImageTag = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(patternImageTag, {
        "xlink:href": "#chartprojectionpattern",
    });
    patternTag.appendChild(patternImageTag);
    let patternRect = this.data.SVGUtils.createSVGElement("rect");
    this.data.SVGUtils.assignAttributes(patternRect, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    patternMaskTag.appendChild(patternRect);
    argParent.appendChild(patternDefsTag);
};

SimpleScaleColumnSeriesItem.prototype.getViewBoxValue = function (element, index) {
    return element != null && element.getAttribute("viewBox") ? parseFloat(element.getAttribute("viewBox").split(/\s+|,/)[index]) : 0;
};
SimpleScaleColumnSeriesItem.prototype.addGradient = function (svgElement, argElement) {
    let defs = this.data.SVGUtils.createSVGElement("defs");
    svgElement.appendChild(defs);
    let linearGrad = this.data.SVGUtils.createSVGElement("linearGradient");
    this.data.SVGUtils.assignAttributes(linearGrad, {
        id: "grad",
        x1: "0%",
        x2: "0%",
        y1: "100%",
        y2: "0%",
    });
    defs.appendChild(linearGrad);
    let stop1 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop1, {
        class: "stop1",
        offset: "0%",
        style: "stop-color:var(--bg-color);stop-opacity:1",
    });
    linearGrad.appendChild(stop1);
    let stop2 = this.data.SVGUtils.createSVGElement("stop");
    this.data.SVGUtils.assignAttributes(stop2, {
        class: "stop2",
        offset: "100%",
        style: "stop-color:var(--accent" + 2 + "-color);stop-opacity:1",
    });
    linearGrad.appendChild(stop2);
    this.data.SVGUtils.assignAttributes(argElement, {
        fill: "url(#grad)",
    });
};

