                if (this.data.chartFlip) {
                    valueElement.style.display = "flex";
                    valueElement.style.alignItems = "flex-end";
                }
                if (gridValueElement) {
                    gridValueElement.appendChild(valueElement);
                    if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                    if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != 0) {
                        gridValueElement.removeChild(valueElement);
