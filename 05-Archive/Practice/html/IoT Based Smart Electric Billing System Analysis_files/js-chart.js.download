    let result = { maxheight: 30 };
    return result;
};

ChartHelper.prototype.getPixelValueFromPercentage = function (strInput, numDefaultValue) {
    return numDefaultValue;
};

ChartHelper.prototype.adjustFontSize = function (nodeTextElement, numMaxH, intMinFontSize, intMaxFontSize, barValue = false) {
    if (nodeTextElement) {
        let boolContinueEdit = true;
        const cssValue = window.getComputedStyle(nodeTextElement);
        let intFontSize = this.getPixelValueFromPercentage(cssValue["font-size"], intMaxFontSize);
        let numScrollH = nodeTextElement.scrollHeight;
        let numClientH = nodeTextElement.clientHeight;
        let sizeDifference = barValue ? 5 : 0;
        if (numScrollH < 1 && numClientH < 1) {
            nodeTextElement.style.setProperty("font-size", 23 + "px", "");
            return false;
        }
        if (numClientH === numScrollH && numClientH) {
            while (numScrollH <= numClientH) {
                intFontSize += 1;
                if (intFontSize > intMaxFontSize) {
                    boolContinueEdit = false;
                    break;
                }
                nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
                numScrollH = nodeTextElement.scrollHeight;
                numClientH = nodeTextElement.clientHeight;
            }
        }

        if (numClientH + sizeDifference < numScrollH) {
            while (numScrollH > numClientH) {
                intFontSize -= 1;
                if (intFontSize < intMinFontSize) {
                    boolContinueEdit = false;
                    break;
                }
                nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
                numScrollH = nodeTextElement.scrollHeight;
                numClientH = nodeTextElement.clientHeight;
            }
        }
        return boolContinueEdit;
    }
    return true;
};

ChartHelper.prototype.adjustFontSizeWidth = function (nodeTextElement, numMaxW, intMinFontSize, intMaxFontSize) {
    if (nodeTextElement) {
        let boolContinueEdit = true;
        nodeTextElement.style.width = "100%";
        const cssValue = window.getComputedStyle(nodeTextElement);
        let intFontSize = cssValue["font-size"].split("px")[0]; //this.getPixelValueFromPercentage(cssValue["font-size"], intMaxFontSize);
        let numScrollW = nodeTextElement.scrollWidth;
        let numClientW = nodeTextElement.clientWidth;
        if (numScrollW < 1 && numClientW < 1) {
            nodeTextElement.style.setProperty("font-size", 23 + "px", "");
            return false;
        }
        while (numScrollW > numClientW && intFontSize > intMinFontSize) {
            intFontSize = parseFloat(intFontSize) - 1;
            nodeTextElement.style.setProperty("font-size", intFontSize + "px", "");
            numScrollW = nodeTextElement.scrollWidth;
        }
        return false;
    }
    return true;
};

ChartHelper.prototype.getMaxValue = function (argDataMax, argCustomMax, boolClose = false) {
    let value = argDataMax;
    if (!isNaN(argCustomMax)) if (argDataMax < argCustomMax) return argCustomMax;
    let length = 0 < value && value < 1 ? 0 : String(value).split(".")[0].length;
    if (argDataMax == 0) {
        value = argDataMax;
    } else if (argDataMax < 10) {
        value = argDataMax + 1;
    } else {
        if (0 < length) value = this.getValueTens(argDataMax, length, argCustomMax, boolClose);
        else if (length == 0) value = 1;
    }
    return value;
};

ChartHelper.prototype.getValueTens = function (argDataMax, length, maxValue, closeValue = false) {
    let intTens;
    let intvalue;
    let originalValue;
    if (length > 1) intTens = 10;
    else if (length > 2) intTens = 100;
    else if (length > 3) intTens = 1000;
    else if (length > 4) intTens = 10000;
    else if (length > 5) intTens = 100000;
    else if (length > 6) intTens = 1000000;
    else if (length > 7) intTens = 10000000;
    else if (length > 8) intTens = 100000000;
    else if (length > 9) intTens = 1000000000;
    const value = (argDataMax / intTens).toString();
    const tensValue_1 = parseInt(value.split(".")[0]);
    const tensValue_2 = parseInt(value.split(".")[1]);
    const originaltens = intTens * tensValue_1;
    let paddingValue = 0;
    // if (argDataMax >= 100) intvalue = tensValue_2 >= 5 ? 25 : 20;
    // else intvalue = tensValue_2 >= 5 || argDataMax >= 25 ? 10 : 5;
    //return originaltens + intvalue;
    if (argDataMax >= 100) {
        if (tensValue_2 >= 5) {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        } else {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        }
    } else {
        if (tensValue_2 >= 5 || argDataMax >= 25) {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        } else {
            paddingValue = (closeValue ? 0 : 10) + (closeValue ? 10 : 0);
            intvalue = paddingValue;
        }
    }
    originalValue = originaltens + intvalue;
    originalValue = this.gridValueValidation(originalValue, maxValue, paddingValue);
    return originalValue;
};

ChartHelper.prototype.gridValueValidation = function (value, maxValue, paddingValue) {
    let boolGridCount = false;
    let dummyValue;
    let gridCount = 4;
    for (let i1 = gridCount; i1 <= 10; i1++) {
        dummyValue = value / i1;
        if (dummyValue % 5 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        } else if (dummyValue % 10 == 0) {
            gridCount = i1;
            boolGridCount = true;
            break;
        }
    }
    dummyValue = value / 5;
    if (dummyValue % 5 == 0) {
        gridCount = 5;
        boolGridCount = true;
    }
    if (!boolGridCount) {
        this.getMaxValue(value, maxValue, true);
        return value + paddingValue;
    }
    return value;
};

ChartHelper.prototype.parseBoolen = function (value) {
    switch (value) {
        case "true":
        case true:
            return true;
        default:
            return false;
    }
};

ChartHelper.prototype.getMenuDetail = function (menuName) {
    this.menuData = window.menuJSON;
    let intLength = this.menuData.categories.length;
    for (let i = 0; i < intLength; i++) {
        let category = this.menuData.categories[i];
        for (let j = 0; j < category.menu.length; j++) {
            let menu = category.menu[j];
            for (let k = 0; k < menu.variations.length; k++) {
                let variations = menu.variations[k];
                for (let l = 0; l < variations.style.length; l++) {
                    let style = variations.style[l];
                    if (style.name == menuName) {
                        return JSON.parse(JSON.stringify(style));
                    } else if (style.shapes) {
                        for (let m = 0; m < style.shapes.length; m++) {
                            let shape = style.shapes[m];
                            if (shape.name == menuName) {
                                return JSON.parse(JSON.stringify(shape));
                            }
                        }
                    }
                }
            }
        }
    }
};

ChartHelper.prototype.getChartOldMenuDetail = function (menuName, count) {
    this.menuData = window.menuJSON;
    let intLength = this.menuData.categories.length;
    for (let i = 0; i < intLength; i++) {
        let category = this.menuData.categories[i];
        for (let j = 0; j < category.menu.length; j++) {
            let menu = category.menu[j];
            for (let k = 0; k < menu.variations.length; k++) {
                let variations = menu.variations[k];
                for (let l = 0; l < variations.style.length; l++) {
                    let style = variations.style[l];
                    if (style.classname == menuName) {
                        if (style.node && style.node[0] <= count && count <= style.node[1]) {
                            return JSON.parse(JSON.stringify(style));
                        }
                    } else if (style.shapes) {
                        for (let m = 0; m < style.shapes.length; m++) {
                            let shape = style.shapes[m];
                            if (shape.classname == menuName) {
                                if (shape.node && shape.node[0] <= count && count <= shape.node[1]) {
                                    return JSON.parse(JSON.stringify(shape));
                                }
                            }
                        }
                    }
                }
            }
        }
    }
};
ChartHelper.prototype.getLayout = function (objectDetails, strItemName, strclassName, xmlData, boolmutiseries = false, multicolumn = false) {
    // let chartListData = ChartHelper.getChartListDataByName(strItemName);
    let graphicName = xmlData.getAttribute("graphicname");
    let className = xmlData.getAttribute("name");
    let childLength = xmlData.children.length;
    let jsonChartItemMetaData = this.getMenuDetail(graphicName);
    if (!jsonChartItemMetaData) {
        jsonChartItemMetaData = this.getChartOldMenuDetail(className, childLength);
        if (!jsonChartItemMetaData) {
            graphicName = this.getOldMenu(graphicName);
            jsonChartItemMetaData = this.getMenuDetail(graphicName);
        }
    }
    let layoutData = jsonChartItemMetaData.chartlayout;
    let secondaryLayout = {};
    if (layoutData && !boolmutiseries) {
        return layoutData;
    } else {
        if (boolmutiseries) {
            if (multicolumn) {
                secondaryLayout = getChartMultiLayout("", false, true);
            } else {
                secondaryLayout = getChartMultiLayout("", true, false);
            }
            return secondaryLayout;
        }
    }
};
ChartHelper.prototype.getChartMultiLayout = function (moodName = "elegant", barchart = false, columnChart = false) {
    let jsonValues = {
        elegant: {
            barchart: {
                chartlayout: {
                    label: { position: ["left", "middle"], padding: [0, 20, 0, 0] },
                    value: { position: ["right", "middle"], padding: [0, 0, 0, 20], fontsize: "38", color: "multiple" },
                    placeholder: {
                        position: ["left", "middle"],
                        padding: [0, 20, 0, 0],
                        shape: {
                            type: "circle",
                            style: "border",
                            bordercolor: "gradient",
                            fillcolor: "tertiary",
                        },
                    },
                    common: { nodesize: "160px", gap: "16px", vPosition: "middle" },
                },
            },
            columnchart: {
                chartlayout: {
                    label: { position: ["center", "bottom"], padding: [20, 0, 0, 0] },
                    value: { position: ["center", "top"], padding: [0, 0, 20, 0] },
                    placeholder: {
                        position: ["center", "bottom"],
                        padding: [20, 0, 0, 0],
                        shape: {
                            type: "circle",
                            style: "border",
                            bordercolor: "theme",
                            fillcolor: "bgcolor",
                        },
                    },
                    common: { nodesize: "160px", gap: "16px", hPosition: "center" },
                },
            },
        },
    };
    let layout = "";
    if (barchart) {
        layout = jsonValues[moodName].barchart;
    } else {
        layout = jsonValues[moodName].columnchart;
    }
    return layout.chartlayout;
};

