};

BaseTableSeries.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
};

BaseTableSeries.prototype.updateBasicData = function () {
    let _oWidth = 0;
    this.length = this.voData.seriesItemLength;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
    this.rectSeriesItem = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

BaseTableSeries.prototype.doMeasurementComputation = function (argprops) {};

BaseTableSeries.prototype.doAddGraphicElement = function (argprops) {
    if (this.index == 0) {
        this.doAddTableHeader();
    }
    this.parent.style.alignItems = "flex-start";
    let tableBaseSeriesElement = this.parent.querySelector(".tableseries");
    let element = document.createElement("tr");
    element.id = "series-" + this.index;
    element.dataset.dckSelector = true;
    element.dataset.index = this.index;
    let customColorIndex = this.ChartFonts.customColor(this.index);
    element.className = "accent" + customColorIndex + " clsMultiColorParent";
    // this.data.SVGUtils.assignAttributes(element, {
    //     style: "position:absolute;top:0;bottom:0;",
    //     class: "series accent"+customColorIndex+" clsMultiColorParent"
    // });
    element.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
    element.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");
    if (tableBaseSeriesElement) tableBaseSeriesElement.appendChild(element);
    let eProps = {
        index: 0,
        groupindex: this.index,
    };
    for (let i1 = 0; i1 < this.data.tableColumnLength; i1++) {
        const eProps = { index: i1, groupindex: this.index, addvalue: this.addvalue, addlabel: this.addlabel, addplaceholder: this.addplaceholder, gapPercentage: this.gapPercentage };
        let seriesitem = this.seriesItemInstance(element, eProps);
        seriesitem.ChartHelper = this.ChartHelper;
        seriesitem.ChartUtils = this.ChartUtils;
        seriesitem.move(0, 0);
        seriesitem.size(this.state.width, this.state.height);
        seriesitem.data = this.data;
    }
};
BaseTableSeries.prototype.doAddTableHeader = function (argprops) {
    let element = document.createElement("thead");
    element.id = "tableheader";
    if (this.parent) this.parent.appendChild(element);
    let tableRowElement = document.createElement("tr");
    element.appendChild(tableRowElement);

    let tableBodyElement = document.createElement("tbody");
    tableBodyElement.classList.add("tableseries");
    if (this.parent) this.parent.appendChild(tableBodyElement);

    for (let i1 = 0; i1 < this.data.tableColumnLength; i1++) {
        let tableColumnElement = document.createElement("td");
        tableRowElement.appendChild(tableColumnElement);
        let labelElement = document.createElement("div");
        labelElement.className = "h8";
        labelElement.innerText = this.data.arrTableHeaderLabel[i1].value;
        tableColumnElement.appendChild(labelElement);
    }
};

function BaseTableSeriesItem(argparent, argprops){
    this.voData = null;
    this.pntCenter = {};
    this.endAngle = argprops.endAngle;
    this.startAngle = argprops.startAngle;
    this.centerPointPadding = argprops.centerPointPad;
    BaseSeriesItem.call(this, argparent, argprops);
}
BaseTableSeriesItem.prototype = Object.create(BaseSeriesItem.prototype);
BaseTableSeriesItem.prototype.constructor = BaseTableSeriesItem;

BaseTableSeriesItem.prototype.doComputation=function() {
    if (this.datavalidation) {
        this.clear();
        this.updateBasicData();
        this.doMeasurementComputation();
        this.doAddGraphicElement();
    }
}

BaseTableSeriesItem.prototype.updateBasicData=function() {


}

BaseTableSeriesItem.prototype.doAddGraphicElement=function() {
    let tableColumnElement = document.createElement("td");
    this.parent.appendChild(tableColumnElement);
    let tableContentNode = document.createElement("div");
    tableColumnElement.appendChild(tableContentNode)
    let textElementValues = this.data.arrTableContent[this.groupindex][this.index];
    tableContentNode.setAttribute("data-id", textElementValues.indexvalue);
    tableContentNode.setAttribute("data-slideid", this.data.slideID);
    if(textElementValues&&textElementValues.elementtype=="label"){
        tableContentNode.innerText = textElementValues.value;
        tableContentNode.className ="p6 tablelabeltext"
        // tableContentNode.setAttribute("contenteditable", "true");
        tableContentNode.setAttribute("data-prompt-text","Enter label");
        this.ChartUtils.enableTextHeighlight(tableContentNode, this.data);
    }else{
        // tableContentNode.setAttribute("contenteditable", "true");
        tableContentNode.innerText = textElementValues.value
    }
    switch(textElementValues.elementtype){
        case "value":
            tableContentNode.id = "valuetext-" +textElementValues.indexvalue;
            // tableContentNode.setAttribute("data-type", "value");
        break;
        case "label":
            tableContentNode.id = "labeltext-" +textElementValues.indexvalue;
            // tableContentNode.setAttribute("data-type", "label");
        break;
    }
    // this.ChartHelper.setTextChangeListner(tableContentNode);
}

