ChartFonts.prototype.maxLabelFontSize = function (element) {
    let fontSize = parseInt(window.getComputedStyle(element).fontSize.split("px")[0]);
    return fontSize;
};

ChartFonts.prototype.secondaryFill = function () {
    return " clsSecondaryFill";
};
ChartFonts.prototype.secondaryStroke = function () {
    return " clsSecondaryStroke";
};
ChartFonts.prototype.tertiaryBorder = function (index) {
    " clsBorderTertiary";
};

ChartFonts.prototype.vodataDeatils = function (value) {
    vodata = value;
    fontDeatils = ChartFonts.getFonList();
};
ChartFonts.prototype.getFonList = function () {
    let seriesLength = vodata.seriesLength;
    let strAssetName = "";
    if (seriesLength < 6) {
        strAssetName = "mininode";
    }
    if (seriesLength >12) {
        strAssetName = "maxnode";
    }
    let fontJSON = "";
    if (strAssetName) {
        fontJSON = PresetThemeHelper.getFontClassName("chart", strAssetName);
    } else {
        fontJSON = PresetThemeHelper.getFontClassName("chart");
    }
    return fontJSON;
};
ChartFonts.prototype.customColor = function (index) {
    if (vodata.seriesItemLength > 1||vodata.dummerSeriesItemLength>1) {
        if(vodata.tintArray.length > index){
            return vodata.tintArray[index];
        }else{
            if(vodata.chartName!="barStackedRectangle"&&vodata.chartName!="columnStackedRectangle"){
                if ((vodata.seriesItemLength == 3||vodata.dummerSeriesItemLength == 3) && index > 0) {
                    return index + index * 2;
                }
                if ((vodata.seriesItemLength == 2||vodata.dummerSeriesItemLength == 2) && index > 0) {
                    return 6;
                }
                if ((vodata.seriesItemLength == 4||vodata.dummerSeriesItemLength == 4) && index > 0) {
                    if (index == 2 || index == 3) {
                        return index + 3;
                    } else {
                        return index + index * 2;
                    }
                }
            }
       
        }
     
    } else {
        if (vodata.tintArray.length > index) {
            return vodata.tintArray[index];
        }
    }
    if(index>=12){
       return this.getFactorIndex(index,12)
    }else{
        return index + 1;
    }
};
ChartFonts.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index+1;
}

function Grid(argparent, argprops) {
    DComponent.call(this, argparent, argprops);
    this.gridCount = 2;
    this.gridSize = argprops.gridsize;
    this.disableMargin = argprops.disablemargin;
    this.type = argprops.type;
    this.reverse = argprops.reverse;
    this.rectSeries = { x: 0, y: 0, width: 0, height: 0 };
    this.gridValueSizeW = argprops.gridvalueSize.width;
    this.gridValueSizeH = argprops.gridvalueSize.height;
    this.negBounds = { width: 0, height: 0 };
    this.valueHeight = argprops.valueHeight ? argprops.valueHeight : 0;
    this.negativeHeight = argprops.negativeHeight ? argprops.negativeHeight : 0;
    this.valueWidth = argprops.valueWidth ? argprops.valueWidth : 0;
    this.negativeWidth = argprops.negativeValueWidth ? argprops.negativeValueWidth : 0;
    this.negValueBounds = { width: 0, height: 0 };
    this.move3dY = parseFloat(argprops.move3dspace);
    this.ChartFonts = new window["ChartFonts"]();
}
Grid.prototype = Object.create(DComponent.prototype);
Grid.prototype.constructor = Grid;
Grid.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        if (this.hadValidateData) {
            this.doAddGraphicElement();
        }
    }
};
Object.defineProperties(Grid.prototype, {
    data: {
        get: function () {
            return this.voData;
        },
        set: function (value) {
            this.voData = value;
        },
    },
    measurementvalidation: {
        get: function () {
            return true;
        },
    },
});

Grid.prototype.hadValidateData = function () {
    return true;
};

Grid.prototype.updateBasicData = function () {
    this.gridCount = this.voData.gridCount;
    this.xmlData = this.voData.data;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

Grid.prototype.doAddGraphicElement = function () {
    this.positiveGridCount = this.gridCount;
    let lineElementHeight = 0;
    if (this.type == "horizontal" && this.negBounds.width != 0) {
        this.gridCount = 5;
        this.getVerticalGridData(this.negBounds.width);
    }
    if (this.type == "vertical" && this.negBounds.height != 0) {
        this.gridCount = 5;
        this.getNegativeGridData(this.negBounds.height);
    }
    let width = (this.viewport.width - this.negBounds.width - this.gridValueSizeW) / this.positiveGridCount + "px";
    let height = (this.viewport.height - this.negBounds.height - this.gridValueSizeH) / this.positiveGridCount + "px";
    let padding = 20;
    let arrBottom = this.xmlData.getAttribute("baseline_bottom_value") ? this.xmlData.getAttribute("baseline_bottom_value").split(",") : [];
    let arrLeft = this.xmlData.getAttribute("baseline_left_value") ? this.xmlData.getAttribute("baseline_left_value").split(",") : [];
    let gridValueElement;
    let gridNegValueElement;
    if (this.type == "vertical") {
        gridValueElement = document.createElement("div");
        gridValueElement.className = "gridValuecontainer";
        gridValueElement.style.width = this.gridValueSizeW + "px";
        gridValueElement.style.height = this.viewport.height - this.negBounds.height - this.gridValueSizeH > 0 ? this.viewport.height - this.negBounds.height - this.gridValueSizeH + "px" : "auto";
        gridValueElement.style.marginTop = "-11px";
        if (this.data.chartFlip) {
            gridValueElement.style.marginTop = "7px";
            gridValueElement.style.display = "flex";
            gridValueElement.style.flexDirection = "column-reverse";
        }
        this.parent.appendChild(gridValueElement);
    }

    let elementYDiv = document.createElement("div");
    elementYDiv.id = "yaxis";
    elementYDiv.className = "removelistner yaxis";
    elementYDiv.style.pointerEvents = "all"; //not change line
    elementYDiv.style.width = padding + "px";
    if (this.data._directionenable) {
        elementYDiv.style.right = this.rectSeries.left - padding * 0.5 + "px";
    } else {
        elementYDiv.style.left = this.rectSeries.left - padding * 0.5 + "px";
    }
    if (this.type != "vertical" && this.data.chartName == "barStackedRectangle") {
        elementYDiv.style.left = this.rectSeries.left + 1 + "px";
        elementYDiv.style.width = 2 + "px";
    }
    elementYDiv.style.pointerEvents = "auto";
    elementYDiv.style.height = this.rectSeries.height - this.gridValueSizeH - this.negativeHeight + "px";
    elementYDiv.dataset.charttype = "horizontal";
    elementYDiv.style.position = "absolute";
    if (!this.data.Yaxis) elementYDiv.style.visibility = "hidden";
    elementYDiv.dataset.listner = "true";
    this.parent.appendChild(elementYDiv);
    // if (arrLeft.length < 2 && arrBottom.length == 0 && this.type == "vertical") this.ChartHelper.setBaseLineListner(elementYDiv, this.parent, this.data.slideID);
    let axisYElemntDiv = document.createElement("div");
    axisYElemntDiv.className = "axisYlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
    if (this.data.layout.showYAxisCustomLine == "false") {
        axisYElemntDiv.style.visibility = "hidden";
    }
    if (this.data.layout.yAxisLineOpacity) {
        axisYElemntDiv.style.opacity = this.data.layout.yAxisLineOpacity;
    }
    if (this.data.layout.yAxisLineStyleClass) {
        axisYElemntDiv.classList.add(this.data.layout.yAxisLineStyleClass);
    }
    if (this.data.layout.yAxisLineColor) {
        let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.yAxisLineColor, "bordercolor");
        axisYElemntDiv.classList.add(colorValue);
    }
    if (this.data.layout.yAxisLineThickness) {
        axisYElemntDiv.style.borderLeftWidth = this.data.layout.yAxisLineThickness;
    }
    if (this.data.layout.yAxisLineStyle) {
        axisYElemntDiv.style.borderLeftStyle = this.data.layout.yAxisLineStyle;
    }
    axisYElemntDiv.style.height = this.rectSeries.height - this.gridValueSizeH - this.negativeHeight + "px";
    axisYElemntDiv.dataset.animation = "gridyaxis";
    if (this.data.minValue < 0) {
        axisYElemntDiv.style.marginLeft = "8px";
    }
    if (this.type == "horizontal" && this.move3dY) {
        axisYElemntDiv.style.height = this.rectSeries.height - this.gridValueSizeH - this.negativeHeight - this.move3dY + "px";
        elementYDiv.style.left = this.move3dY + this.rectSeries.left - padding * 0.5 + "px";
    }
    if (!this.voData._customProperties.showYAxisLine) axisYElemntDiv.style.setProperty("opacity", "0", "important");
    if (this.voData._customProperties.showYAxisLine) elementYDiv.appendChild(axisYElemntDiv);
    if (this.type == "vertical" && this.move3dY != 0) {
        axisYElemntDiv.style.setProperty("opacity", "0", "important");
    }
    let elementXDiv = document.createElement("div");
    elementXDiv.id = "xaxis";
    elementXDiv.className = "removelistner xaxis";
    elementXDiv.style.pointerEvents = "all"; //not change line
    elementXDiv.style.top = this.type != "vertical" ? this.rectSeries.height - padding * 0.3 - this.gridValueSizeH + "px" : this.rectSeries.height + this.valueHeight - this.gridValueSizeH - this.negBounds.height + "px"; //+ this.rectSeries.top - padding * 0.5 - this.gridValueSizeH
    if (this.negBounds.height <= 0) {
        elementXDiv.style.top = this.type != "vertical" ? this.rectSeries.height - padding * 0.3 - this.gridValueSizeH + "px" : this.rectSeries.height + this.valueHeight - this.gridValueSizeH - this.negBounds.height - this.move3dY + "px";
    }
    if (this.data.chartFlip && this.type == "vertical") {
        elementXDiv.style.removeProperty("top");
        elementXDiv.style.bottom = this.type != "vertical" ? this.rectSeries.height - padding * 0.3 - this.gridValueSizeH + "px" : this.rectSeries.height + this.valueHeight - this.gridValueSizeH - this.negBounds.height - 2 - this.move3dY + "px"; //+ this.rectSeries.top - padding * 0.5 - this.gridValueSizeH
        if (this.negBounds.height < 0) {
            elementXDiv.style.bottom = this.type != "vertical" ? this.rectSeries.height - padding * 0.3 - this.gridValueSizeH + "px" : this.rectSeries.height + this.valueHeight - this.gridValueSizeH - this.negBounds.height - this.move3dY + "px";
        }
    }
    if (this.type == "vertical") {
        elementXDiv.style.width = this.rectSeries.width - this.gridValueSizeW - this.move3dY + "px";
    } else {
        elementXDiv.style.width = this.rectSeries.width - this.gridValueSizeW + "px";
    }
    elementXDiv.style.height = padding + "px";
    if (this.negBounds.height > 2) {
        elementXDiv.style.top = this.type != "vertical" ? this.rectSeries.height - padding * 0.3 - this.gridValueSizeH + "px" : this.rectSeries.height + this.valueHeight - this.gridValueSizeH - (this.negBounds.height + 3) + "px"; //+ this.rectSeries.top - padding * 0.5 - this.gridValueSizeH
    }
    if (!this.data.Xaxis) elementXDiv.style.visibility = "hidden";
    if (this.type == "vertical") {
        elementXDiv.style.left = this.rectSeries.left + this.move3dY + "px";
        elementXDiv.style.height = 2 + "px";
        if (this.data.chartFlip && this.negativeHeight <= 0) {
            elementYDiv.style.top = this.rectSeries.top + "px";
            if (this.data.chartFlip) {
                elementYDiv.style.top = "0px";
            }
        } else {
            elementYDiv.style.top = this.valueHeight;
        }
        elementYDiv.style.height = this.rectSeries.height - 2 - this.negativeHeight + "px";
    } else {
        if (this.data.chartName == "barStackedRectangle") {
            axisYElemntDiv.style.marginLeft = "0px";
            elementXDiv.style.left = this.rectSeries.left + "px";
        } else {
            if (this.data.layout.labelItemBased == "true") {
                axisYElemntDiv.style.marginLeft = "10px";
            }
        }
    }
    elementXDiv.style.position = "absolute";
    elementXDiv.dataset.charttype = "vertical";
    elementXDiv.dataset.listner = "true";
    this.parent.appendChild(elementXDiv);
    // if (arrBottom.length < 2 && arrLeft.length == 0 && this.type != "vertical") this.ChartHelper.setBaseLineListner(elementXDiv, this.parent, this.data.slideID);
    let axisXElemntDiv = document.createElement("div");
    axisXElemntDiv.className = "axisXlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
    axisXElemntDiv.dataset.animation = "gridxaxis";
    if (!this.voData._customProperties.showXAxisLine) axisXElemntDiv.style.setProperty("opacity", "0", "important");
    if (this.voData._customProperties.showXAxisLine) elementXDiv.appendChild(axisXElemntDiv);
    if (this.type == "horizontal" && this.move3dY != 0) {
        axisXElemntDiv.style.setProperty("opacity", "0", "important");
    }
    if (this.data.layout.showXAxisCustomLine == "false") {
        axisXElemntDiv.style.visibility = "hidden";
    }
    if (this.data.layout.xAxisLineOpacity) {
        axisXElemntDiv.style.opacity = this.data.layout.xAxisLineOpacity;
    }
    if (this.data.layout.xAxisLineColor) {
        let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.xAxisLineColor, "bordercolor");
        axisXElemntDiv.classList.add(colorValue);
    }
    if (this.type != "vertical") {
        if (this.data.layout.labelItemBased == "true") {
            axisXElemntDiv.style.marginLeft = "0px";
        }
    }
    if (this.data.layout.xAxisLineThickness) {
        axisXElemntDiv.style.borderBottomWidth = this.data.layout.xAxisLineThickness;
    }
    if (this.data.layout.xAxisLineStyleClass) {
        axisXElemntDiv.classList.add(this.data.layout.xAxisLineStyleClass);
    }
    if (this.data.layout.xAxisLineStyle) {
        axisXElemntDiv.style.borderBottomStyle = this.data.layout.xAxisLineStyle;
    }
    if (this.voData._customProperties.showYAxisGrid) {
        let gridLineElement = document.createElement("div");
        let gridNegLineElement = document.createElement("div");
        gridLineElement.className = "gridcontainer";
        gridLineElement.style.width = this.rectSeries.width + "px";
        gridLineElement.style.height = this.viewport.height - this.gridValueSizeH + "px";
        if (this.type == "vertical") {
            gridLineElement.style.position = "absolute";
            gridLineElement.style.left = this.rectSeries.left + "px";
        } else {
            if (this.data.chartFlip) {
                gridLineElement.classList.add("posflipcontainer");
            }
        }
        this.parent.appendChild(gridLineElement);
        if (this.type == "horizontal" && this.negBounds.width != 0) {
            gridLineElement.style.width = this.viewport.width - this.negBounds.width + "px";
            if (!this.data.chartFlip) {
                gridLineElement.style.marginLeft = this.negBounds.width + "px";
            }
            ///
            gridNegLineElement.className = "gridcontainer";
            gridNegLineElement.style.position = "absolute";
            gridNegLineElement.style.width = this.negBounds.width + "px";
            gridNegLineElement.style.height = this.viewport.height - this.gridValueSizeH + "px";
            gridNegLineElement.style.top = 0;
            this.parent.appendChild(gridNegLineElement);
            if (this.data.chartFlip) {
                gridNegLineElement.classList.add("negflipcontainer");
                gridNegLineElement.style.left = gridLineElement.clientWidth + "px";
            }
        }
        if (this.type == "horizontal") {
            gridValueElement = document.createElement("div");
            gridValueElement.className = "gridValuecontainer";
            gridValueElement.style.width = this.viewport.width - this.negBounds.width + "px";
            gridValueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
            gridValueElement.style.left = this.rectSeries.left + "px";
            if (!this.data.chartFlip) {
                gridValueElement.style.marginLeft = this.disableMargin ? "unset" : "11px";
                if (this.negBounds.width != 0) {
                    gridValueElement.style.marginLeft = this.negBounds.width + 11 + "px";
                }
            }

            if (this.data.chartFlip) {
                gridValueElement.style.left = "0px";
                gridValueElement.classList.add("posflipvaluecontainer");
            }
            this.parent.appendChild(gridValueElement);

            for (let i1 = 0; i1 < this.positiveGridCount; i1++) {
                let lineElement = document.createElement("div");
                lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                lineElement.style.width = width;
                lineElement.style.height = this.viewport.height - this.gridValueSizeH + "px";
                lineElement.dataset.animation = "gridlines";
                if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                    lineElement.style.opacity = "0";
                    lineElement.style.visibility = "hidden";
                }
                if (this.data.layout.showGridCustomLine == "false") {
                    lineElement.style.visibility = "hidden";
                }
                if (this.data.layout.showGridCustomLine == "false") {
                    lineElement.style.visibility = "hidden";
                }
                if (this.data.layout.gridLineOpacity) {
                    lineElement.style.opacity = this.data.layout.gridLineOpacity;
                }
                if (this.data.layout.gridLineColor) {
                    let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.gridLineColor, "bordercolor");
                    lineElement.classList.add(colorValue);
                }
                if (this.data.layout.gridLineStyle) {
                    lineElement.style.borderRightStyle = this.data.layout.gridLineStyle;
                    if (this.data.chartFlip) {
                        lineElement.style.borderLeftStyle = this.data.layout.gridLineStyle;
                    }
                }
                if (this.data.layout.gridLineThickness) {
                    lineElement.style.borderRightWidth = this.data.layout.gridLineThickness;
                    if (this.data.chartFlip) {
                        lineElement.style.borderLeftWidth = this.data.layout.gridLineThickness;
                    }
                }
                if (this.data.layout.gridLineStyleClass) {
                    lineElement.classList.add(this.data.layout.gridLineStyleClass);
                }
                gridLineElement.appendChild(lineElement);
                lineElementHeight = lineElement.clientWidth;
                if (this.reverse) lineElement.classList.add("reverse");
                if (i1 == this.positiveGridCount - 1 && this.move3dY && this.negBounds.width != 0) {
                    let poswidth = lineElement.clientWidth;
                    let posmoveX = Math.round(this.move3dY);
                    poswidth = poswidth - posmoveX;
                    let posheight = gridLineElement.clientHeight;
                    let posintY = this.move3dY;
                    let posmoveY = 0;
                    let svgPos3dshape = this.data.SVGUtils.createSVGElement("svg");
                    this.data.SVGUtils.assignAttributes(svgPos3dshape, {
                        height: "100%",
                    });
                    svgPos3dshape.style.position = "absolute";
                    svgPos3dshape.style.top = "0px";
                    gridLineElement.appendChild(svgPos3dshape);
                    let pospathElement = this.data.SVGUtils.createSVGElement("path");
                    this.data.SVGUtils.assignAttributes(pospathElement, {
                        d: "M" + 0 + "," + posintY + "L" + posmoveX + "," + posmoveY + "L" + posmoveX + "," + (posheight - posintY * 2 + posmoveY) + "L" + 0 + "," + (posheight - 2) + " Z",
                        "fill-opacity": 0.15,
                        class: "moodanimation",
                        "data-animation": "gridlines",
                        fill: "rgba(var(--secondary-color-rgb),1)",
                    });
                    svgPos3dshape.appendChild(pospathElement);
                }
            }

            for (let i2 = 0; i2 < this.positiveGridCount; i2++) {
                let valueElement = document.createElement("div");
                valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                valueElement.style.width = width;
                valueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                let gridValue = this.reverse ? (this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2) : (this.voData.rangeTotal / this.positiveGridCount) * (i2 + 1);
                let deciamlCount = gridValue.toString().split(".").length > 1 ? gridValue.toString().split(".")[1].length : 0;
                if (deciamlCount > 2) {
                    gridValue = gridValue.toFixed(1);
                }
                valueElement.innerHTML = this.getDenominationValue(gridValue);
                if (this.data.data.getAttribute("data-stackpercentage")) {
                    valueElement.innerHTML = this.getDenominationValue(Math.round((100 / this.positiveGridCount) * (i2 + 1))) + "%";
                }
                if (this.data.highvaluebreak && i2 != this.positiveGridCount - 1) {
                    valueElement.innerHTML = this.reverse ? this.getDenominationValue(Math.round((this.voData.secondPositiveHighValue / this.positiveGridCount) * (this.positiveGridCount - i2))) : this.getDenominationValue(Math.round((this.voData.secondPositiveHighValue / (this.positiveGridCount - 1)) * (i2 + 1)));
                }
                if (valueElement.innerHTML == "0") {
                    valueElement.innerHTML = this.reverse ? this.getDenominationValue(Math.round((this.voData.rangeTotal / this.positiveGridCount) * (this.positiveGridCount - i2))) : this.getDenominationValue(Math.round((this.voData.rangeTotal / this.positiveGridCount) * (i2 + 1)));
                }
                if (this.data._boolPercentageChart) {
                    let rangeTotalValue = this.voData.rangeTotal > 100 ? 100 : this.voData.rangeTotal;
                    valueElement.innerHTML = this.reverse ? Math.round((rangeTotalValue / this.positiveGridCount) * (this.positiveGridCount - i2)) + "%" : Math.round((rangeTotalValue / this.positiveGridCount) * (i2 + 1)) + "%";
                }
                valueElement.style.textAlign = this.reverse ? "start" : "end";
                valueElement.dataset.animation = "gridvalue";
                if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                    valueElement.style.opacity = "0";
                    valueElement.style.visibility = "hidden";
                }
                gridValueElement.appendChild(valueElement);
                if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != this.positiveGridCount - 1) {
                    valueElement.style.setProperty("opacity", "0", "important");
                }
            }

            if (this.type == "horizontal" && this.negBounds.width != 0) {
                let negWidth = 0;
                for (let i1 = 0; i1 < this.negativeGridCount; i1++) {
                    negWidth = this.negBounds.width / this.negativeGridCount + "px";
                    let lineElement = document.createElement("div");
                    lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                    lineElement.style.width = negWidth;
                    lineElement.style.height = this.viewport.height - this.gridValueSizeH + "px";
                    lineElement.dataset.animation = "gridlines";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        lineElement.style.opacity = "0";
                        lineElement.style.visibility = "hidden";
                    }
                    if (this.data.layout.showGridCustomLine == "false") {
                        lineElement.style.visibility = "hidden";
                    }
                    if (this.data.layout.gridLineOpacity) {
                        lineElement.style.opacity = this.data.layout.gridLineOpacity;
                    }
                    if (this.data.layout.gridLineColor) {
                        let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.gridLineColor, "bordercolor");
                        lineElement.classList.add(colorValue);
                    }
                    if (this.data.layout.gridLineStyle) {
                        lineElement.style.borderRightStyle = this.data.layout.gridLineStyle;
                        if (this.data.chartFlip) {
                            lineElement.style.borderLeftStyle = this.data.layout.gridLineStyle;
                        }
                    }
                    if (this.data.layout.gridLineStyleClass) {
                        lineElement.classList.add(this.data.layout.gridLineStyleClass);
                    }
                    if (this.data.layout.gridLineThickness) {
                        lineElement.style.borderRightWidth = this.data.layout.gridLineThickness;
                        if (this.data.chartFlip) {
                            lineElement.style.borderLeftWidth = this.data.layout.gridLineThickness;
                        }
                    }
                    gridNegLineElement.appendChild(lineElement);
                    lineElementHeight = lineElement.clientWidth;
                    lineElement.classList.add("reverse");
                }

                gridNegValueElement = document.createElement("div");
                gridNegValueElement.className = "gridValuecontainer";
                gridNegValueElement.style.width = this.negBounds.width - this.negValueBounds.width - this.gridValueSizeW + "px";
                gridNegValueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                gridNegValueElement.style.position = "absolute";
                gridNegValueElement.style.top = this.viewport.height - this.gridValueSizeH + "px";
                this.parent.appendChild(gridNegValueElement);
                if (this.data.chartFlip) {
                    gridNegValueElement.style.left = gridLineElement.clientWidth + "px";
                    gridNegValueElement.classList.add("negflipvaluecontainer");
                }

                for (let i2 = 0; i2 < this.negativeGridCount; i2++) {
                    let valueElement = document.createElement("div");
                    valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                    valueElement.style.width = negWidth;
                    valueElement.style.height = this.gridValueSizeH > 0 ? this.gridValueSizeH + "px" : "auto";
                    valueElement.innerHTML = this.getDenominationValue(Math.round((this.voData.rangeNegative / this.negativeGridCount) * (this.negativeGridCount - i2)));
                    if (this.data.displayValueFormat == "percentage") {
                        let valueDifference = (this.voData.rangeNegative / this.voData.rangeTotal) * 100;
                        valueElement.innerHTML = Math.round((valueDifference / this.negativeGridCount) * (this.negativeGridCount - i2)) + "%";
                    }
                    if (this.voData.rangeNegative > -1) {
                        valueElement.innerHTML = this.getDenominationValue((this.voData.rangeNegative / this.negativeGridCount) * (this.negativeGridCount - i2));
                    }

                    valueElement.style.textAlign = "start";
                    valueElement.dataset.animation = "gridvalue";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        valueElement.style.opacity = "0";
                        valueElement.style.visibility = "hidden";
                    }
                    gridNegValueElement.appendChild(valueElement);
                    if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                    if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != this.negativeGridCount - 1) {
                        valueElement.style.setProperty("opacity", "0", "important");
