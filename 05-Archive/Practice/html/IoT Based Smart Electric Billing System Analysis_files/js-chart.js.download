            return _defaultDisplayFormat;
        },
    },
    baseline: {
        get: function () {
            return _baseLine;
        },
    },
});

function VOLayout(argProps, xmlData, objMenu, slide, voBaseProperties, mooddata, hasDirection) {
    this.ChartHelper = new window["ChartHelper"]();
    this.data = argProps ? argProps : {};
    this.xmlData = xmlData;
    this.gridValueSize = 20;
    this.axisLineThickness = 0;
    this.gridLineThickness = 1;
    this.seriesViewPercentage = 100;
    this.legendAlignment = [];
