                gridNegLineElement.className = "gridcontainer";
                gridNegLineElement.style.position = "absolute";
                gridNegLineElement.style.width = this.viewport.width - this.gridValueSizeW + "px";
                gridNegLineElement.style.height = this.negBounds.height - this.negValueBounds.height - this.negativeHeight + "px";
                gridNegLineElement.style.left = this.rectSeries.left + "px";
                if (this.data.chartFlip) {
                    gridNegLineElement.style.bottom = this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                } else {
                    gridNegLineElement.style.top = this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                }
                this.parent.appendChild(gridNegLineElement);
                let negHeight = 0;
                for (let i1 = 0; i1 < this.negativeGridCount; i1++) {
                    negHeight = this.negBounds.height / this.negativeGridCount + "px";
                    let lineElement = document.createElement("div");
                    lineElement.className = "gridlines moodanimation" + this.ChartFonts.gridLabelOuterColor;
                    lineElement.style.width = this.viewport.width - this.gridValueSizeW + "px";
                    lineElement.style.height = negHeight;
                    lineElement.dataset.animation = "gridlines";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        lineElement.style.opacity = "0";
                        lineElement.style.visibility = "hidden";
                    }
                    if (this.data.layout.showGridCustomLine == "false") {
                        lineElement.style.visibility = "hidden";
                    }
                    if (this.data.layout.gridLineOpacity) {
                        lineElement.style.opacity = this.data.layout.gridLineOpacity;
                    }
                    if (this.data.layout.gridLineColor) {
                        let colorValue = this.getBgColorDetails(0, this.ChartFonts.gridLabelOuterColor, this.data.layout.gridLineColor, "bordercolor");
                        lineElement.classList.add(colorValue);
                    }
                    if (this.data.layout.gridLineStyle) {
                        lineElement.style.borderTopStyle = this.data.layout.gridLineStyle;
                    }
                    if (this.data.layout.gridLineStyleClass) {
                        lineElement.classList.add(this.data.layout.gridLineStyleClass);
                    }
                    if (this.data.layout.gridLineThickness) {
                        lineElement.style.borderTopWidth = this.data.layout.gridLineThickness;
                    }
                    gridNegLineElement.appendChild(lineElement);
                    lineElementHeight = lineElement.clientHeight;
                    lineElement.classList.add("reverse");
                    if (i1 == this.negativeGridCount - 1 && this.move3dY) {
                        let width = lineElement.clientWidth;
                        let moveX = Math.round(10);
                        width = width - moveX;
                        let height = lineElement.clientHeight + Math.round(lineElement.clientHeight * 0.07);
                        let intY = Math.round(height * 0.2) + Math.round(lineElement.clientHeight * 0.09);
                        let moveY = 0;
                        let svg3dshape = this.data.SVGUtils.createSVGElement("svg");
                        this.data.SVGUtils.assignAttributes(svg3dshape, {
                            width: "100%",
                        });
                        svg3dshape.style.position = "absolute";
                        svg3dshape.style.top = lineElement.offsetTop + lineElement.clientHeight + "px";
                        gridNegLineElement.appendChild(svg3dshape);
                        let pathElement = this.data.SVGUtils.createSVGElement("path");
                        this.data.SVGUtils.assignAttributes(pathElement, {
                            d: "M0" + "," + intY + "L" + moveX + "," + moveY + "L" + (width + moveX) + "," + moveY + "L" + width + "," + intY + " Z",
                            "fill-opacity": 0.15,
                            class: "moodanimation",
                            "data-animation": "gridlines",
                            fill: "rgba(var(--secondary-color-rgb),1)",
                        });
                        svg3dshape.appendChild(pathElement);
                    }
                }

                gridNegValueElement = document.createElement("div");
                gridNegValueElement.className = "gridValuecontainer";
                gridNegValueElement.style.width = this.gridValueSizeW + "px";
                gridNegValueElement.style.height = this.negBounds.height - this.negValueBounds.height - this.gridValueSizeH - this.negativeHeight + "px";
                gridNegValueElement.style.position = "absolute";
                gridNegValueElement.style.marginLeft = "0px";
                gridNegValueElement.style.display = "flex";
                gridNegValueElement.style.flexDirection = "column-reverse";
                gridNegValueElement.style.justifyContent = "flex-end";
                this.parent.appendChild(gridNegValueElement);
                if (this.data.chartFlip) {
                    gridNegValueElement.style.flexDirection = "column";
                    gridNegValueElement.style.bottom = 11 + this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                } else {
                    gridNegValueElement.style.top = this.viewport.height - this.negBounds.height - this.gridValueSizeH + this.valueHeight + "px";
                }
                for (let i2 = 0; i2 < this.negativeGridCount; i2++) {
                    let valueElement = document.createElement("div");
                    valueElement.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                    valueElement.style.width = this.gridValueSizeW + "px";
                    valueElement.style.height = negHeight;
                    valueElement.innerHTML = this.getDenominationValue(Math.round(((this.voData.rangeNegative + this.data.psitiveDiff) / this.negativeGridCount) * (this.negativeGridCount - i2)));
                    if (this.data.displayValueFormat == "percentage") {
                        let valueDifference = ((this.voData.rangeNegative + this.data.psitiveDiff) / this.voData.rangeTotal) * 100;
                        valueElement.innerHTML = Math.round((valueDifference / this.negativeGridCount) * (this.negativeGridCount - i2)) + "%";
                    }
                    if (this.voData.rangeNegative > -3) {
                        valueElement.innerHTML = this.getDenominationValue(((this.voData.rangeNegative + this.data.psitiveDiff) / this.negativeGridCount) * (this.negativeGridCount - i2));
                    }
                    valueElement.style.textAlign = "start";
                    valueElement.style.display = "flex";
                    valueElement.style.alignItems = "flex-end";
                    valueElement.dataset.animation = "gridvalue";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        valueElement.style.opacity = "0";
                        valueElement.style.visibility = "hidden";
                    }
                    if (this.data.chartFlip) {
                        valueElement.style.alignItems = "flex-start";
                    }
                    gridNegValueElement.appendChild(valueElement);
                    if (i2 == 0) this.checkgridOverlap(valueElement, lineElementHeight);
                    if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != 0) {
                        gridNegValueElement.removeChild(valueElement);
                    }
                }
                if (this.data.chartName == "waterfallchart" && this.negativeGridCount > 0) {
                    let valueElement1 = document.createElement("div");
                    valueElement1.className = "gridvalues moodanimation " + " " + this.ChartFonts.gridThemeClassName + this.ChartFonts.gridLabelOuterColor;
                    valueElement1.style.width = this.gridValueSizeW + "px";
                    valueElement1.style.height = negHeight;
                    valueElement1.innerHTML = "0";
                    valueElement1.style.textAlign = "start";
                    valueElement1.style.display = "flex";
                    valueElement1.style.alignItems = "flex-start";
                    valueElement1.dataset.animation = "gridvalue";
                    valueElement1.style.position = "absolute";
                    valueElement1.style.top = "-15px";
                    valueElement1.style.justifyContent = "center";
                    if (this.data.data.getAttribute("data-baseline") || (this.data.data.getAttribute("axisbaseline") && this.data.data.getAttribute("axisbaseline") == "true")) {
                        valueElement1.style.opacity = "0";
                        valueElement.style.visibility = "hidden";
                    }
                    if (this.data.chartFlip) {
                        valueElement1.style.alignItems = "flex-end";
                    }
                    gridNegValueElement.appendChild(valueElement1);
                    // if (i2 == 0) this.checkgridOverlap(valueElement1, lineElementHeight);
                    // if (this.data.data.getAttribute("gridvalueoverlap") == "true" && i2 != 0) {
                    //     gridNegValueElement.removeChild(valueElement1);
                    // }
                }
            }
        }
    }
};
Grid.prototype.checkgridOverlap = function (valueElement, lineElementHeight) {
    let cloneNode = valueElement.cloneNode(true);
    cloneNode.style.height = "fit-content";
    this.parent.appendChild(cloneNode);
    let gridValueheight = cloneNode.clientHeight;
    if (this.type == "horizontal") {
        cloneNode.style.width = "fit-content";
        gridValueheight = cloneNode.clientWidth;
    }
    if (gridValueheight > lineElementHeight) {
        this.data.data.setAttribute("gridvalueoverlap", "true");
    } else {
        this.data.data.removeAttribute("gridvalueoverlap");
    }
    this.parent.removeChild(cloneNode);
};
Grid.prototype.getDenominationValue = function (value) {
    let intDivider = 1;
    let strValueDenominationSuffix = "";
    let intLength = value < 0 ? String(value).split(".")[0].length - 1 : String(value).split(".")[0].length;
    if (intLength >= 10) {
        strValueDenominationSuffix = "B";
        intDivider = 1000000000;
    } else if (intLength >= 8) {
        strValueDenominationSuffix = "M";
        intDivider = 1000000;
    } else if (intLength >= 7) {
        strValueDenominationSuffix = "M";
        intDivider = 1000000;
    } else if (intLength >= 6) {
        strValueDenominationSuffix = "L";
        intDivider = 100000;
    } else if (intLength >= 4) {
        strValueDenominationSuffix = "K";
        intDivider = 1000;
    }
    if (this.data.chartName != "waterfallchart") {
        let gridValue = value / intDivider;
        let deciamlCount = gridValue.toString().split(".").length > 1 ? gridValue.toString().split(".")[1].length : 0;
        if (deciamlCount > 2) {
            gridValue = gridValue.toFixed(1);
        }
        return gridValue + strValueDenominationSuffix;
    } else {
        let objinputValue = { input: value.toString() };
        let objValue = this.chartHelper.formatChartValues(objinputValue);
        // return parseInt(objValue.valueSystem)+objValue.currencySystem;
        let boolFloat = this.isFloat(value / intDivider);
        if (boolFloat) {
            return parseFloat(value / intDivider).toFixed(1) + strValueDenominationSuffix;
        } else {
            return parseFloat(value / intDivider) + strValueDenominationSuffix;
        }
    }
};

Grid.prototype.getVerticalGridData = function (intZeroPos) {
    let data = {};
    let intNegativeLimit = 0;
    let intPositiveGridCount = 0;
    let intNegativeGridCount = 0;
    let intVPositiveErrorSpace = 0;
    let intVNegativeErrorSpace = 0;
    let intAxisPoint = intZeroPos;
    let intGap = (this.viewport.width - this.gridValueSizeW) / this.gridCount;
    let intPositiveLimit = parseInt(this.viewport.width);
    let intGridLimit = intAxisPoint + intGap;

    while (intPositiveLimit > intGridLimit) {
        intPositiveGridCount++;
        intGridLimit = intGridLimit + intGap;
    }
    intGridLimit = intAxisPoint - intGap;

    while (intNegativeLimit <= parseInt(intGridLimit)) {
        intNegativeGridCount++;
        intGridLimit = intGridLimit - intGap;
    }
    this.positiveGridCount = this.data.positiveGridCount ? this.data.positiveGridCount : intPositiveGridCount;
    this.negativeGridCount = this.data.negativeGridCount ? this.data.negativeGridCount : intNegativeGridCount;
};

Grid.prototype.getNegativeGridData = function (intZeroPos) {
    let data = {};
    let intNegativeLimit = 0;
    let intPositiveGridCount = 0;
    let intNegativeGridCount = 0;
    let intVPositiveErrorSpace = 0;
    let intVNegativeErrorSpace = 0;
    let intAxisPoint = intZeroPos;
    let intGap = (this.viewport.height - this.gridValueSizeH) / 6;
    let intPositiveLimit = parseInt(this.viewport.height);
    let intGridLimit = intAxisPoint + intGap;

    while (intPositiveLimit > intGridLimit) {
        intPositiveGridCount++;
        intGridLimit = intGridLimit + intGap;
    }
    intGridLimit = intAxisPoint - intGap;

    while (intNegativeLimit <= parseInt(intGridLimit)) {
        intNegativeGridCount++;
        intGridLimit = intGridLimit - intGap;
    }
    this.positiveGridCount = this.data.positiveGridCount ? this.data.positiveGridCount : intPositiveGridCount;
    this.negativeGridCount = this.data.negativeGridCount ? this.data.negativeGridCount : intNegativeGridCount;
    if (this.data.chartName == "waterfallchart") {
        let postiveSideHeight = this.viewport.height - this.negBounds.height;
        this.positiveGridCount = this.data.positiveGridCount ? this.data.positiveGridCount : intPositiveGridCount;
        let positiveIndeualHeight = postiveSideHeight / this.positiveGridCount;
        let negativeCount = parseInt(this.negBounds.height / positiveIndeualHeight);
        if (this.negBounds.height > 0 && positiveIndeualHeight <= 0) {
            negativeCount = 5;
        }
        this.negativeGridCount = negativeCount;
    }
};

Grid.prototype.getBgColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "bgcolor":
            if (fillProperty == "bordercolor") {
                return "bgborderColor";
            } else {
                return "itembgColor";
            }
            break;
        case "tertiary":
            if (fillProperty == "bordercolor") {
                return "tertiary-border-color";
            } else {
                return "clsNodeTertiarybg";
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 && this.data.seriesItemLength == 1 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicColor(PropertyIndex);
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 && this.data.seriesItemLength == 1 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicBgColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicBgColor(groupindex);
                    break;
                case "bordercolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicBorderColor(colorValue);
                    }
                    return this.ChartFonts.appendgraphicBorderColor(groupindex);
                    break;
            }
        }
    }
};
Grid.prototype.isFloat = function (n) {
    return Number(n) === n && n % 1 !== 0;
};

function Legend(argparent, argprops, boolmultiseries = false) {
    this.legendlabel = argprops.legendlabel;
    this.multiseries = boolmultiseries;
    DComponent.call(this, argparent, argprops);
    this.ChartFonts = new window["ChartFonts"]();
}
Legend.prototype = Object.create(DComponent.prototype);
Legend.prototype.constructor = Legend;

Legend.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        if (this.hadValidateData) {
            this.doAddGraphicElement();
        }
    }
};

Legend.prototype.hadValidateData = function () {
    return true;
};

Legend.prototype.updateBasicData = function () {
    this.length = this.legendlabel ? this.voData.seriesItemLength : this.voData.seriesLength;
    this.length = this.voData.chartName == "comparisonModelType3" ? 2 : parseInt(this.length);
    this.length = this.voData.chartName == "waterfallchart" ? 3 : this.length;
    this.length = this.data.seriesanimation ? 1 : this.length;
    this.position = this.voData.legendposition == "" ? "right" : this.voData.legendposition;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

Legend.prototype.doAddGraphicElement = function () {
    const element = this.ChartHelper.createDivElement();
    element.className = "legendbase";
    element.style.maxWidth = this.state.width + "px";
    element.style.maxHeight = this.state.height + "px";
    this.parent.appendChild(element);
    if (this.voData.legendposition == "right" || this.voData.legendposition == "left") {
        element.style.minWidth = "121px";
    }
    if ((this.voData.legendposition == "right" || this.voData.legendposition == "left") && this.data.layout.legendValign != "center") {
        this.parent.style.height = "100%";
        element.style.height = "auto";
        if (this.data.layout.legendValign == "top") {
            this.parent.style.alignItems = "flex-start";
        }
        if (this.data.layout.legendValign == "bottom") {
            this.parent.style.alignItems = "flex-end";
        }
    }
    if (this.voData.legendposition == "top" || this.voData.legendposition == "bottom") {
        this.parent.style.width = "100%";
        if (this.data.layout.legendHalign == "left") {
            this.parent.style.justifyContent = "flex-start";
        }
        if (this.data.layout.legendHalign == "right") {
            this.parent.style.justifyContent = "flex-end";
        }
    }
    if (this.data.layout.enableBackground && this.data.layout.backgroundType == "full") {
        element.style.width = this.state.width - 41 + "px";
    }
    if (this.data.layout.compareLegend) {
        element.style.width = this.state.width + "px";
        element.style.display = "flex";
        if (this.voData.chartName.includes("comparisonModel") && this.data.layout.labelHPosition == "center") {
            element.style.justifyContent = "space-between";
        }
    }

    if (this.position == "top") {
        this.parent.style.paddingBottom = "72PX";

        this.setGridVerticalAlign(this.length, element);
    } else if (this.position == "bottom") {
        this.parent.style.paddingTop = this.multiseries ? "72px" : "72px";
        if (this.data.baseProperties.grid && this.data._customProperties.showYAxisGrid && this.voData.chartName != "columnSimpleRectangle") {
            this.parent.style.paddingTop = "72px";
        }
        this.setGridVerticalAlign(this.length, element);
    } else if (this.position == "left") {
        element.classList.add("centeralign");
        if (this.data._directionenable) {
            this.parent.style.paddingLeft = "72px";
        } else {
            this.parent.style.paddingRight = "72px";
        }
    } else if (this.position == "right") {
        element.classList.add("centeralign");
        if (this.data._directionenable) {
            this.parent.style.paddingRight = "72px";
        } else {
            this.parent.style.paddingLeft = "72px";
        }
    }

    for (let i1 = 0; i1 < this.length; i1++) {
        let eProps = { index: i1, legendlabel: this.legendlabel };
        let subelement = document.createElement("div");
        subelement.id = "legendseries_" + i1;
        let customColorIndex = this.ChartFonts.customColor(i1);
        if (this.data.seriesanimation) customColorIndex = this.ChartFonts.customColor(this.data.seriesAnimationIndex);
        subelement.className = "legendseries legendseries" + this.position + " accent" + customColorIndex + " clsMultiColorParent " + this.data.layout.legendGlopalStyle;
        subelement.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
        subelement.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

        if (this.voData.chartName != "waterfallchart") {
            let indexvalue = this.ChartFonts.customColor(i1);
            if (this.data.seriesanimation) indexvalue = this.ChartFonts.customColor(this.data.seriesAnimationIndex);
            if (this.data.chartName == "comparisonModelType3" && i1 >= this.data.seriesLength / 2) {
                indexvalue = 6;
            }
            subelement.style.setProperty("--customItemColor", "var(--item" + indexvalue + "-color-rgb)");
            subelement.style.setProperty("--customContrastColor", "var(--contrast" + indexvalue + "-rgb)");
        } else {
            subelement.style.setProperty("--customItemColor", "var(--item" + (i1 + 1) + "-color-rgb)");
            subelement.style.setProperty("--customContrastColor", "var(--contrast" + (i1 + 1) + "-rgb)");

            if (i1 == 1) {
                subelement.style.setProperty("--customItemColor", "var(--item" + 6 + "-color-rgb)");
                subelement.style.setProperty("--customContrastColor", "var(--contrast" + 6 + "-rgb)");
            }
            if (i1 == 2) {
                subelement.style.setProperty("--customItemColor", "var(--tertiary-color-rgb)");
            }
        }

        if (this.position == "bottom" && this.length < 4) {
            subelement.style.paddingBottom = "0px";
            if (this.data._directionenable) {
                subelement.style.paddingLeft = "72px";
            } else {
                subelement.style.paddingRight = "72px";
            }
        }
        element.appendChild(subelement);
        if (!this.multiseries && this.data.hasEmphasis && this.data.emphasis[i1] != true) {
            subelement.classList.add("emphasis");
        }
        if (!this.multiseries && this.data.projection[i1] != true && this.data.hasProjection && this.data._projectionName == "projection1") {
            subelement.classList.add("emphasis");
        }
        if (this.data.layout.compareLegend) {
            subelement.style.width = "50%";
            if (this.voData.chartName.includes("comparisonModel") && this.data.layout.labelHPosition == "center") {
                this.data.layout.showLabel ? (subelement.style.width = "40%") : (subelement.style.width = "50%");
            }
            let hPos = this.data.layout.legendLabelalterPos && i1 == 0 ? (this.data.layout.legendLabelHPos == "left" ? "right" : "left") : this.data.layout.legendLabelHPos;

            if (hPos == "right") {
                subelement.style.flexDirection = "row-reverse";
            }
            if (this.data.layout.legendLabelalterPos) {
                subelement.classList.add("seriesalterPos");
            }
        }
        let legendserise = new window["LegendSerise"](this.parent, eProps, this.multiseries);
        legendserise.move(0, 0);
        legendserise.ChartHelper = this.ChartHelper;
        legendserise.ChartUtils = this.ChartUtils;
        legendserise.size(this.state.width, this.state.height);
        legendserise.data = this.data;
    }
};

Legend.prototype.setGridVerticalAlign = function (length, element) {
    switch (length) {
        case 1:
            element.className = element.className + " vgrid-" + length;
            break;
        case 2:
            element.className = element.className + " vgrid-" + length;
            break;
        case 3:
            element.className = element.className + " vgrid-" + length;
            break;
        case 4:
            element.className = element.className + " vgrid-" + length;
            break;
        case 5:
            element.className = element.className + " vgrid-" + length;
            break;
        case 6:
            element.className = element.className + " vgrid-" + length;
            break;
        case 7:
            element.className = element.className + " vgrid-" + length;
            break;
        case 8:
            element.className = element.className + " vgrid-" + length;
            break;
        case 9:
            element.className = element.className + " vgrid-" + length;
            break;
        case 10:
            element.className = element.className + " vgrid-" + length;
            break;
        case 11:
            element.className = element.className + " vgrid-" + length;
            break;
        case 12:
            element.className = element.className + " vgrid-" + length;
            break;
    }
};

const arrbottomalignment = [
    { length: "2", row: 1, column: 2 },
    { length: "3", row: 2, column: 2 },
    { length: "4", row: 2, column: 2 },
    { length: "5", row: 2, column: 3 },
    { length: "6", row: 2, column: 3 },
    { length: "7", row: 2, column: 4 },
    { length: "8", row: 2, column: 4 },
];
const arrMultiseriesbottomalignment = [
    { length: "2", row: 1, column: 2 },
    { length: "3", row: 2, column: 2 },
    { length: "4", row: 2, column: 2 },
    { length: "5", row: 2, column: 3 },
    { length: "6", row: 2, column: 3 },
    { length: "7", row: 2, column: 4 },
    { length: "8", row: 2, column: 4 },
];
const arrPromptText = ["Increase", "Decrease", "Net profit"];
function LegendSerise(argparent, argprops, multiseries) {
    this.hadshape = true;
    this.hadvalue = true;
    this.ispercentagechart = true;
    this.index = argprops.index;
    this.legendlabel = argprops.legendlabel;
    this.multiseries = multiseries;
    this.ChartFonts = new window["ChartFonts"]();
    this.arrWaterfallColor = [this.ChartFonts.appendgraphicBgColor(0), this.ChartFonts.appendgraphicBgColor(5), "waterfall-bg-color"];
    DComponent.call(this, argparent, argprops);
}

LegendSerise.prototype = Object.create(DComponent.prototype);
LegendSerise.prototype.constructor = LegendSerise;

LegendSerise.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doAddGraphicElement();
    }
};

LegendSerise.prototype.updateBasicData = function () {
    this.subElement = this.parent.getElementsByClassName("legendseries")[this.index];
    this.length = this.multiseries ? this.voData.seriesItemLength : this.voData.seriesLength;
    this.position = this.voData.legendposition;
    this.subElement.style.alignItems = this.position == "left" ? "right" : "left";
    this.ispercentagechart = this.voData.baseProperties.maxAllowedSeries == 1 ? true : false;
    this.hadvalue = this.legendlabel ? false : this.hadvalue;
};

LegendSerise.prototype.doAddGraphicElement = function () {
    let valueWidth = "0%";
    let valueHeight = "0%";
    let labelWidth = "0%";
    let labelHeight = "0%";
    let shapeWidth = "0%";
    let shapeHeight = "0%";
    this.state.width = this.state.width < 121 ? 121 : this.state.width;
    let totalWidth = this.state.width;
    if (this.data.layout.compareLegend) {
        totalWidth = this.state.width * 0.5;
    }
    let totalHeight = this.state.height / this.length;
    let shapeSize = 13;
    let maxValueFontSize = 23;
    let minValueFontSize = 10;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data, true);
    if (categoryFontDetails) {
        maxValueFontSize = categoryFontDetails.maxSize;
        minValueFontSize = categoryFontDetails.minSize < 10 ? 10 : categoryFontDetails.minSize;
    }
    let fonsize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : maxValueFontSize;
    if (this.data.customValueFontSize) {
        fonsize = this.data.customValueFontSize;
        if (minValueFontSize > this.data.customValueFontSize) minValueFontSize = this.data.customValueFontSize;
    }
    if (this.ispercentagechart) {
        this.hadshape = false;
        fonsize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : maxValueFontSize;
        if (this.position == "top" || this.position == "bottom") {
            labelWidth = "60%";
            labelHeight = "100%";
            valueWidth = this.hadvalue ? "40%" : "0%";
            valueHeight = "100%";
        } else {
            labelWidth = "100%";
            labelHeight = totalHeight * 0.4 + "px";
            valueWidth = this.hadvalue ? "100%" : "0%";
            valueHeight = totalHeight * 0.4 + "px";
            this.subElement.style.flexDirection = "column";
        }
    } else {
        labelWidth = totalWidth * 0.6 + "px"; //"60%";
        if (this.data.layout.compareLegend) {
            labelWidth = totalWidth * 0.7 + "px"; //"60%";
        }
        labelHeight = totalHeight - 25 + "px"; // "100%";
        valueWidth = this.hadvalue ? totalWidth * 0.4 + "px" : "0px";
        valueHeight = totalHeight + "px"; //"100%";
        if (this.position != "right" && this.position != "left") {
            totalHeight = this.state.height;
            let numColumn = 1;
            let numRow = 1;
            let legendgridPositions = this.multiseries ? arrMultiseriesbottomalignment : arrbottomalignment;
            for (let i1 = 0; i1 < legendgridPositions.length; i1++) {
                let lengthValue = this.multiseries ? this.data.legendLabels.length : this.data.seriesLength;
                if (legendgridPositions[i1].length == lengthValue) {
                    numColumn = parseInt(legendgridPositions[i1].column);
                    numRow = parseInt(legendgridPositions[i1].row);
                }
            }
            if (numRow > 1 && numColumn > 2) {
                labelWidth = (totalWidth / numColumn) * 0.7 + "px"; //"60%";
            } else {
                labelWidth = (totalWidth / numColumn) * 0.6 + "px"; //"60%";
            }
            if (this.data.layout.compareLegend) {
                labelWidth = (totalWidth / numColumn) * 0.7 + "px"; //"60%";
            }
            labelHeight = totalHeight / numRow + "px"; // "100%";
            valueWidth = this.hadvalue ? (totalWidth / numColumn) * 0.4 + "px" : "0px";
            valueHeight = totalHeight / numRow + "px"; //"100%";
        }
    }
    let shapeelement = "";
    if (this.hadshape) {
        if (this.data.layout.legendShape == "placholder") {
            const bounds = { width: 120, height: 120 };
            const element = this.ChartHelper.createDivElement({});
            (element.id = "primaryplaceholdergraphic-" + this.index + "_" + this.index), (element.className = "primaryplaceholder bottomprimaryplaceholder");
            element.style.width = bounds.width + "px";
            element.style.height = bounds.height + "px";
            element.style.display = "flex";
            if (this.data.layout.itemalterpos == "true" && this.index == 0) {
                element.classList.add("itemright");
            }
            let property = { placeholdertype: "image" };
            if (this.data.primaryPlaceholderType[this.index]) {
                property.placeholdertype = this.data.primaryPlaceholderType[this.index];
            }
            let type = String(property.placeholdertype).toLowerCase();
            this.subElement.appendChild(element);
            if (type != "image") {
                element.style.maxWidth = bounds.width + "px";
                element.style.width = "auto";
            }
            switch (type) {
                case "icon":
                    this.doAddIconUseNodeElement(element, "");
                    break;
                case "image":
                    this.doAddImageUseNodeElement(element, "");
                    break;
                case "text":
                    this.doAddTextUseNodeElement(element, argprops);
                    break;
            }
        } else {
            if (this.data.layout.legendShape == "square" || this.data.layout.legendShape == "circle") {
                shapeSize = 2 * shapeSize;
            }
            shapeWidth = shapeHeight = shapeSize + "px";
            shapeWidth = this.data.layout.legendShapeWidth ? this.data.layout.legendShapeWidth + "px" : shapeWidth;
            shapeHeight = this.data.layout.legendShapeHeight ? this.data.layout.legendShapeHeight + "px" : shapeHeight;
            shapeelement = document.createElement("div");
            // shapeelement.style.width = shapeWidth;
            // shapeelement.style.height = shapeHeight;
            if (this.data.layout.legendShape == "square") {
                // shapeelement.style.borderRadius = "0px";
            }
            if (this.data.layout.legendShape == "circle") {
                //shapeelement.style.borderRadius = "50%";
            }

            shapeelement.className = "moodanimation clsLegendShape";
            if (this.voData.chartName != "waterfallchart") {
                this.legendShapeBgstyle(shapeelement);
            } else {
                this.data.legendLabels = this.data.data.getAttribute("multiserieslegend") ? this.data.data.getAttribute("multiserieslegend").split(",") : this.data.legendLabels;
                shapeelement.classList.add(this.arrWaterfallColor[this.index]);
            }

            shapeelement.dataset.animation = "legendshape";
            if (this.multiseries && !this.data.legendLabels[this.index]) {
                shapeelement.dataset.animation = "";
            }
            if (this.data.layout.legendShape == "arrow") {
                let hPos = this.data.layout.legendLabelalterPos && this.index == 0 ? (this.data.layout.legendLabelHPos == "left" ? "right" : "left") : this.data.layout.legendLabelHPos;
                this.subElement.classList.add("legendshape" + this.data.layout.legendShapePosition + hPos);
                this.subElement.appendChild(this.createArrowShape(hPos));
                if (this.index == 1 && this.data.layout.legendLabelalterPos) {
                    this.subElement.style.flexDirection = "column";
                }
            } else {
                this.subElement.appendChild(shapeelement);
            }
            if (this.data.layout.legendShapeType == "image") {
                let imageTag = document.createElement("img");
                imageTag.src = this.data.asset.data.length < 5 ? this.data.serverUrl + this.data.asset.data[0].url : this.data.serverUrl + this.data.asset.data[this.getFactorIndex(this.index, 7)].url;
                shapeelement.appendChild(imageTag);
                shapeelement.style.overflow = "hidden";
                shapeelement.classList.remove(this.data.ChartFonts.appendgraphicBgColor(this.index));
                imageTag.style.width = "100%";
            }
            totalWidth -= shapeSize;
        }
    }

    if (this.hadvalue) {
        const valueelement = document.createElement("div");
        valueelement.id = "legendvalue-0_" + this.index;
        valueelement.className = "legendvalue";
        valueelement.style.minWidth = 10 + "px";
        valueelement.style.height = valueHeight + "px";
        valueelement.style.maxWidth = valueWidth;
        valueelement.style.maxHeight = valueHeight;
        this.subElement.appendChild(valueelement);

        let color = (this.ispercentagechart ? this.getColorDetails(this.index, this.ChartFonts.graphicColor(0), this.data.layout.valueColor, "color") : this.getColorDetails(this.index, this.ChartFonts.valueOuterColor, this.data.layout.valueColor, "color")) + " " + this.ChartFonts.valueThemeClassName;
        const pvalue = document.createElement("div");

        let hasInnerValue = this.data.layout.valueInset == "inside";
        color = this.checkMoodColorvalue(this.data.layout.valueColor, color, pvalue, "value", hasInnerValue);
        this.checkMoodLevelColorvalue(this.data.layout.valueColor, pvalue, "value", "color", null, hasInnerValue);

        pvalue.id = "pvalue-" + this.index + "_0";
        pvalue.className = "pvalue moodanimation " + color;
        (pvalue.innerText = this.data.prefix[this.index][0] + this.data.valuesDenomination[this.index][0] + this.data.suffix[this.index][0]), (pvalue.style.fontSize = fonsize + "px");
        pvalue.style.maxWidth = valueWidth;
        pvalue.style.maxHeight = valueHeight;
        pvalue.style.alignItems = "flex-end";
        pvalue.style.display = "block";
        pvalue.setAttribute("maxFontSize", fonsize);
        pvalue.setAttribute("contenteditable", "true");
        pvalue.setAttribute("data-dck-selector", "true");
        if (this.data.valueTextColor[this.index][0]) {
            pvalue.style.setProperty("color", this.data.valueTextColor[this.index][0], "important");
        }
        if (this.data.presentMode || this.data.seriesanimation) {
            pvalue.setAttribute("data-dck-selector", "false");
            pvalue.setAttribute("contenteditable", "false");
        }
        if (this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) {
            pvalue.setAttribute("data-dck-selector", "false");
            pvalue.setAttribute("contenteditable", "false");
        }
        pvalue.setAttribute("data-slideid", this.data.slideID);
        pvalue.setAttribute("data-id", this.index + "_0");
        pvalue.setAttribute("data-type", "legendvalue");
        pvalue.dataset.animation = "legendvalue";
        if (this.data.layout.valuePaddingClass) {
            pvalue.classList.add(this.data.layout.valuePaddingClass);
        }
        if (this.data.layout.valueshadow == "true") {
            let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
            let clsSendaryStyle = this.ChartFonts.valueOuterColor;
            let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
            let rgbaValue = this.data.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.valueTextShdowOpacity);
            if (this.data.layout.valueShadowClass) pvalue.classList.add(this.data.layout.valueShadowClass);
            // pvalue.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
        }
        valueelement.appendChild(pvalue);
        if (this.data.arrHyperlinkUrl.length >= this.index) {
            pvalue.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[this.index]);
        }
        if (this.ispercentagechart) {
            pvalue.style.fontSize = "60px";
            pvalue.setAttribute("maxFontSize", 60);
            pvalue.innerText = (this.data.values[this.index][0] > 100 ? 100 : this.data.values[this.index][0]) + "%";
        } else {
            pvalue.innerText = this.data.prefix[this.index][0] + this.data.valuesDenomination[this.index][0] + this.data.suffix[this.index][0];
        }
        let padding = { left: this.data.layout.valuePaddingleft, right: this.data.layout.valuePaddingright, top: this.data.layout.valuePaddingtop, bottom: this.data.layout.valuePaddingbottom };
        pvalue.style.paddingLeft = padding["left"] + "px";
        pvalue.style.paddingRight = padding["right"] + "px";
        pvalue.style.paddingTop = padding["top"] + "px";
        pvalue.style.paddingBottom = padding["bottom"] + "px";
        pvalue.style.lineHeight = "1.5";
        this.ChartHelper.setTextChangeListner(pvalue);
        if (!this.multiseries) this.calculateMaxFonsize(pvalue, false, fonsize, this.index);
        this.ChartHelper.adjustFontSize(pvalue, 20, minValueFontSize, fonsize);
        this.ChartHelper.adjustFontSizeWidth(pvalue, 20, minValueFontSize, fonsize);
        this.ChartHelper.textPositionChangeObserver(pvalue);
        this.ChartUtils.createSpanFormat(pvalue, this.data);
        let width = pvalue.clientWidth;
        if (!this.data.layout.enableBackground && this.data.layout.backgroundType != "full") {
            // pvalue.style.width = width + "px";
        }
    }
    let labelColor = this.getColorDetails(this.index, this.ChartFonts.labelOuterColor, this.data.layout.legendLabelColor, "color");
    const labelelement = document.createElement("div");

    let hasInnerLabel = false;
    labelColor = this.checkMoodColorvalue(this.data.layout.labelColor, labelColor, labelelement, "heading", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, labelelement, "heading", "color", null, hasInnerLabel);
    let colorTabCustomClass = labelColor == "dummeycolor" || this.data.layout.labelColor ? "" : this.data.clsLabelTextColor;
    labelelement.className = "legendlabel " + colorTabCustomClass + " moodanimation " + labelColor + " " + this.ChartFonts.dynamiclegendLabelThemeClassName(this.index);
    labelelement.id = "legendlabel-0_" + this.index;
    // labelelement.style.minWidth = 130 + "px";
    labelelement.style.height = labelHeight + "px";
    labelelement.style.maxWidth = labelWidth;
    labelelement.style.maxHeight = labelHeight;
    // labelelement.style.wordBreak = "break-all";
    labelelement.setAttribute("data-textalign", "horizantal");
    labelelement.dataset.animation = "legendlabel";
    this.subElement.appendChild(labelelement);
    let maxFontSize = this.data.layout.legendLabelFonSize ? this.data.layout.legendLabelFonSize : this.ChartFonts.maxLabelFontSize(labelelement);

    let labelPadding = { left: this.data.layout.legendLabelPaddingleft, right: this.data.layout.legendLabelPaddingright, top: this.data.layout.legendLabelPaddingtop, bottom: this.data.layout.legendLabelPaddingbottom };
    labelelement.style.paddingLeft = labelPadding["left"] + "px";
    labelelement.style.paddingRight = labelPadding["right"] + "px";
    labelelement.style.paddingTop = labelPadding["top"] + "px";
    labelelement.style.paddingBottom = labelPadding["bottom"] + "px";
    labelelement.style.overflow = "hidden";
    if (this.data.layout.legendLabelPaddingClass) {
        labelelement.classList.add(this.data.layout.legendLabelPaddingClass);
    }
    const plabel = document.createElement("div");
    plabel.id = "plabel-" + this.index;
    plabel.className = "plabel";
    plabel.innerHTML = !this.multiseries ? this.data.labels[this.index] : this.data.legendLabels[this.index];
    if (this.data.seriesanimation) plabel.innerHTML = this.data.legendLabels[this.data.seriesAnimationIndex];
    plabel.style.fontSize = maxFontSize + "px";
    plabel.style.maxWidth = labelWidth;
    if (this.data.arrLabelOpacity[this.index]) plabel.style.setProperty("opacity", this.data.arrLabelOpacity[this.index], "");
    if (this.data.arrLabeltexttransform[this.index]) plabel.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.index], "");

    plabel.style.maxHeight = labelHeight;
    plabel.setAttribute("maxFontSize", maxFontSize);
    plabel.setAttribute("contenteditable", "true");
    plabel.setAttribute("data-dck-selector", "true");
    if (this.data.presentMode || this.data.seriesanimation) {
        plabel.setAttribute("data-dck-selector", "false");
        plabel.setAttribute("contenteditable", "false");
    }
    if (!plabel.innerText && shapeelement && !this.hadvalue) {
        shapeelement.dataset.animation = "";
    }
    plabel.setAttribute("data-type", "legendlabel");
    if (this.data.arrHyperlinkUrl.length >= this.index) {
        plabel.setAttribute("data-navigate-to-slide-on-click", this.data.arrHyperlinkUrl[this.index]);
    }
    if (this.multiseries) {
        plabel.setAttribute("data-type", "multilegendlabel");
        if (this.data.multiLegendTextColor[this.index]) {
            plabel.style.setProperty("color", this.data.multiLegendTextColor[this.index], "important");
        }
    } else {
        plabel.setAttribute("data-specialtype", "legendlabel");
        if (this.data._labelTextColor[this.index]) {
            plabel.style.setProperty("color", this.data._labelTextColor[this.index], "important");
        }
    }
    plabel.setAttribute("data-prompt-text", "Enter Label");
    plabel.setAttribute("data-slideid", this.data.slideID);
    plabel.setAttribute("data-id", this.index);
    if (this.data.layout.legendlabelshadow == "true") {
        let clsItemStyle = this.ChartFonts.graphicColor(this.index);
        let clsSendaryStyle = this.ChartFonts.labelOuterColor;
        let colorStyle = this.data.layout.legendlabelTextShdowColor == "item" || this.data.layout.legendlabelTextShdowColor == "theme" ? clsItemStyle : this.data.layout.legendlabelTextShdowColor == "secondary" ? clsSendaryStyle : "";
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, this.index, this.data.layout.legendlabelTextShdowOpacity);
        if (this.data.layout.legendlabelShadowClass) plabel.classList.add(this.data.layout.legendlabelShadowClass);
        // plabel.style.textShadow = this.data.layout.legendlabelTextShadow + " " + rgbaValue;
    }
    plabel.classList.add("transparentBg");
    labelelement.appendChild(plabel);
    if (this.data.labelLineHeight[this.index] && !this.multiseries) {
        plabel.style.lineHeight = this.data.labelLineHeight[this.index];
    }
    if (this.data.labelLetterSpace[this.index] && !this.multiseries) {
        plabel.style.letterSpacing = this.data.labelLetterSpace[this.index] + "em";
    }
    if (this.data.legendlabellineHeight[this.index]) plabel.style.lineHeight = this.data.legendlabellineHeight[this.index];
    if (this.data.legendlabelletterspacing[this.index]) plabel.style.letterSpacing = this.data.legendlabelletterspacing[this.index] + "em";
    this.ChartHelper.setTextChangeListner(plabel);
    this.ChartHelper.adjustFontSize(plabel, 10, 24, maxFontSize);
    this.ChartHelper.adjustFontSizeWidth(plabel, 10, 24, this.ChartFonts.maxLabelFontSize(labelelement));
    this.ChartHelper.textPositionChangeObserver(plabel);
    if (!this.multiseries) this.ChartUtils.enableTextHeighlight(plabel, this.data);
    this.recalculateMaxHeight(plabel);
    if (this.voData.chartName == "waterfallchart") {
        plabel.setAttribute("data-prompt-text", arrPromptText[this.index]);
    }
};
LegendSerise.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
LegendSerise.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};
LegendSerise.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize, groupindex) {
    if (groupindex == this.data.seriesLength - 1 && !boolmax && !this.data.promptText) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        this.data.data.removeAttribute("valuemaxfontsize");
    }
};
LegendSerise.prototype.legendShapeBgstyle = function (element) {
    if (this.data.layout.legendShapeStyle == "border") {
        if (this.data.layout.legendShapeBorderSize) {
            element.style.border = this.data.layout.legendShapeBorderSize + "px solid";
        } else {
            element.style.border = "2px solid";
        }
        if (this.data.layout.legendShapeBorderColor == "theme") {
            if (
                (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("tertiary-border-color");
            } else {
                if (this.data.layout.legendShapeborderOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(this.data.ChartFonts.appendgraphicBorderColor(this.index), this.index, this.data.layout.legendShapeborderOpacity);
                    element.style.borderColor = rgbavalue;
                } else {
                    element.classList.add(this.data.ChartFonts.appendgraphicBorderColor(this.index));
                }
            }
        }
        if (this.data.layout.legendShapeBorderColor == "gradient") {
            element.classList.add("bordergradient");
        }
        if (this.data.layout.legendShapeBorderColor == "secondary") {
            if (this.data.layout.legendShapeborderOpacity) {
                let rgbavalue = this.ChartUtils.createRBGColor("tertiary-border-color", this.index, this.data.layout.legendShapeborderOpacity);
                element.style.borderColor = rgbavalue;
            } else {
                element.classList.add("tertiary-border-color");
            }
        }
        if (this.data.layout.legendShapeBorderColor == "bgcolor") {
            element.classList.add("bgborderColor");
        }
        if (this.data.layout.legendShapeBorderColor == "tertiary") {
            if (this.data.layout.legendShapeborderOpacity) {
                let rgbavalue = this.ChartUtils.createRBGColor("tertiary-border-color", this.index, this.data.layout.legendShapeborderOpacity);
                element.style.borderColor = rgbavalue;
            } else {
                element.classList.add("tertiary-border-color");
            }
        }
    }
    if (this.data.layout.legendShapeBgColor) {
        if (this.data.layout.legendShapeBgColor == "theme") {
            if (
                (this.data.projection[this.index] == true && this.data.hasProjection && this.data._projectionName == "projection-grey") ||
                (this.data.hasEmphasis && this.data.emphasis[this.index] != true && (this.data._emphasisName == "emphasize-grey" || ((this.data._emphasisName == "emphasize-basic-fill" || this.data._emphasisName == "emphasize-basic-pattern") && !this.data.shapeBorder)))
            ) {
                element.classList.add("clsNodeTertiarybg");
            } else {
                if (this.data.layout.legendShapebgOpacity) {
                    let rgbavalue = this.ChartUtils.createRBGColor(this.data.ChartFonts.appendgraphicBgColor(this.index), this.index, this.data.layout.legendShapebgOpacity);
                    element.style.background = rgbavalue;
                } else {
                    let styleIndex = this.index;
                    if (this.data.chartName == "comparisonModelType3") {
                        styleIndex = this.index > 0 ? 5 : this.index;
                    }
                    element.classList.add(this.data.ChartFonts.appendgraphicBgColor(styleIndex));
                }
            }
        }
        if (this.data.layout.legendShapeBgColor == "tertiary") {
            if (this.data.layout.legendShapebgOpacity) {
                let rgbavalue = this.ChartUtils.createRBGColor("clsNodeTertiarybg", this.index, this.data.layout.legendShapebgOpacity);
                element.style.background = rgbavalue;
            } else {
                element.classList.add("clsNodeTertiarybg");
            }
        }
        if (this.data.layout.legendShapeBgColor == "secondary") {
            if (this.data.layout.legendShapebgOpacity) {
                let rgbavalue = this.ChartUtils.createRBGColor("secondary-bg-color", this.index, this.data.layout.legendShapebgOpacity);
                element.style.background = rgbavalue;
            } else {
                element.classList.add("secondary-bg-color");
            }
        }
        if (this.data.layout.legendShapeBgColor == "gradient") {
            element.classList.add("gradient");
        }
        if (this.data.layout.legendShapeBgColor == "bgcolor") {
            element.classList.add("itembgColor");
        }
    }
    if (this.data.layout.legendShapeRadius) {
        let borderRadiuslefttop = this.data.layout.legendShapeRadius && this.data.layout.legendShapeRadius.length > 0 && this.data.layout.legendShapeRadius[0] ? this.data.layout.legendShapeRadius[0] + "px" : 0 + "px";
        let borderRadiusLeftBottom = this.data.layout.legendShapeRadius && this.data.layout.legendShapeRadius.length > 1 && this.data.layout.legendShapeRadius[1] ? this.data.layout.legendShapeRadius[1] + "px" : 0 + "px";
        let borderRadiusRightTop = this.data.layout.legendShapeRadius && this.data.layout.legendShapeRadius.length > 2 && this.data.layout.legendShapeRadius[2] ? this.data.layout.legendShapeRadius[2] + "px" : 0 + "px";
        let borderRadiusRightBottom = this.data.layout.legendShapeRadius && this.data.layout.legendShapeRadius.length > 3 && this.data.layout.legendShapeRadius[3] ? this.data.layout.legendShapeRadius[3] + "px" : 0 + "px";
        element.style.borderRadius = borderRadiuslefttop + " " + borderRadiusRightTop + " " + borderRadiusRightBottom + " " + borderRadiusLeftBottom;
    }
};
LegendSerise.prototype.getFactorIndex = function (index, length) {
    if (index < 0 && length < 0) return 0;
    if (length <= index) index = index % length;
    return index;
};
LegendSerise.prototype.createArrowShape = function (position) {
    let baseSvg = this.data.SVGUtils.createSVGElement("svg");
    let point1, point2, point3, point4, point5, point6, point7;
    if (position == "right") {
        let rightArrow = this.data.SVGUtils.createSVGElement("path");
        let arrowWidth = this.state.width * 0.3;
        let arrowHeight = this.state.height * 0.3;
        this.data.SVGUtils.assignAttributes(baseSvg, {
            width: arrowWidth,
            height: arrowHeight,
        });
        point1 = 0 + "," + arrowHeight * 0.4;
        point2 = arrowWidth * 0.8 + "," + arrowHeight * 0.4;
        point3 = arrowWidth * 0.8 + "," + arrowHeight * 0.1;
        point4 = arrowWidth * 0.9 + "," + arrowHeight * 0.5;
        point5 = arrowWidth * 0.8 + "," + arrowHeight * 0.9;
        point6 = arrowWidth * 0.8 + "," + arrowHeight * 0.6;
        point7 = 0 + "," + arrowHeight * 0.6;
        let strPathValue = "M" + point1 + " L" + point2 + " L" + point3 + " L" + point4 + " L" + point5 + " L" + point6 + " L" + point7 + "z";
        this.data.SVGUtils.assignAttributes(rightArrow, {
            d: strPathValue,
            class: this.ChartFonts.graphicFillColor(this.index),
        });
        baseSvg.appendChild(rightArrow);
    } else {
        let leftArrow = this.data.SVGUtils.createSVGElement("path");
        let arrowWidth = this.state.width * 0.3;
        let arrowHeight = this.state.height * 0.3;
        this.data.SVGUtils.assignAttributes(baseSvg, {
            width: arrowWidth,
            height: arrowHeight,
        });
        point1 = arrowWidth + "," + arrowHeight * 0.4;
        point2 = arrowWidth * 0.2 + "," + arrowHeight * 0.4;
        point3 = arrowWidth * 0.2 + "," + arrowHeight * 0.1;
        point4 = arrowWidth * 0.1 + "," + arrowHeight * 0.5;
        point5 = arrowWidth * 0.2 + "," + arrowHeight * 0.9;
        point6 = arrowWidth * 0.2 + "," + arrowHeight * 0.6;
        point7 = arrowWidth + "," + arrowHeight * 0.6;
        let strPathValue = "M" + point1 + " L" + point2 + " L" + point3 + " L" + point4 + " L" + point5 + " L" + point6 + " L" + point7 + "z";
        this.data.SVGUtils.assignAttributes(leftArrow, {
            d: strPathValue,
            class: this.ChartFonts.graphicFillColor(this.index),
        });
        baseSvg.appendChild(leftArrow);
    }
    return baseSvg;
};
LegendSerise.prototype.recalculateMaxHeight = function (nodeTextElement) {
    let numScrollH = nodeTextElement.scrollHeight;
    let numClientH = nodeTextElement.clientHeight;
    let maxHeight;
    let boolHeightChange = false;
    const cssValue = window.getComputedStyle(nodeTextElement);
    if (numClientH <= numScrollH) {
        let maxHeight = cssValue["maxHeight"].split("px")[0];
        let value = maxHeight / parseFloat(cssValue["lineHeight"]);
        let maxLines = parseInt(value) == 0 ? 1 : parseInt(value);
        if (maxLines > 0 && parseFloat(cssValue["lineHeight"]) > 0) maxHeight = parseInt(maxLines * parseFloat(cssValue["lineHeight"])) + 5;
        nodeTextElement.parentElement.style.maxHeight = maxHeight + "px";
        // nodeTextElement.parentElement.style.height = maxHeight + "px";
        nodeTextElement.style.maxHeight = maxHeight + "px";
        boolHeightChange = true;
    }
};
LegendSerise.prototype.doAddImageUseNodeElement = function (argparent, argprops) {
    const subelement = document.createElement("img");
    argparent.appendChild(subelement);
    subelement.style.width = "100%";
    subelement.style.height = "100%";
    subelement.src = this.data.seriesItemGraphicPath.length < 5 ? this.data.seriesItemGraphicPath[0] : this.data.seriesItemGraphicPath[this.index];
    subelement.style.position = "unset";
    subelement.id = "graphicimage-" + this.index + "_0";
    subelement.className = "primaryplaceholdergraphic";
    subelement.setAttribute("data-placeholderelement", "image");
    subelement.setAttribute("data-id", this.index + "_0");
    subelement.setAttribute("data-type", "IMAGE");
    subelement.style.objectFit = "unset";
    subelement.setAttribute("data-logotype", "true");
    let item = this.data.ChartUtils.getOffsetLeftTop(argparent);
    argparent.setAttribute("data-x", item.x);
    argparent.setAttribute("data-y", item.y);
    argparent.setAttribute("data-width", argparent.clientWidth);
    argparent.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-width", argparent.clientWidth);
    subelement.setAttribute("data-height", argparent.clientHeight);
    subelement.setAttribute("data-x", item.x);
    subelement.setAttribute("data-y", item.y);

    this.data.ChartUtils.updateImageReSize(120, 120, subelement);
};

LegendSerise.prototype.doAddIconUseNodeElement = function (argparent, argprops) {
    let iconFillColor = this.ChartFonts.graphicFillColor(this.index);
    const element = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(element, {
        class: "primaryplaceholdercond" + iconFillColor,
        id: "placeholder-" + this.index + "_" + this.index,
        width: "100%",
        height: "100%",
    });
    const subelement = this.data.SVGUtils.createSVGElement("use");
    this.data.SVGUtils.assignAttributes(subelement, {
        id: "primaryplaceholdergraphic-" + this.index + "_" + this.index,
        class: "primaryplaceholdergraphic ",
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
        "xlink:href": "#" + this.data.primaryPlaceholderName[this.index],
        "data-placeholderelement": "icon,image",
        "data-id": this.index + "_" + this.index,
        "data-type": "ICON",
    });
    element.appendChild(subelement);
    argparent.appendChild(element);
};
LegendSerise.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    return this.ChartFonts.appendgraphicColor(PropertyIndex); //"accent" + (PropertyIndex + 1) + "-color";
                    break;
                case "bgcolor":
                    return this.chartFonts.appendgraphicBgColor(groupindex);
                    break;
            }
        }
    }
};
LegendSerise.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            return "textgradient";
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "secondary":
            if (fillProperty == "color") {
                return "clsSecondaryTextColor";
            } else {
                return "clsNodeTertiarybg";
            }
            break;
        default:
            return valueStyle;
            break;
    }
    if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
        switch (fillProperty) {
            case "color":
                return this.ChartFonts.appendgraphicColor(PropertyIndex);
                break;
            case "bgcolor":
                return this.data.ChartFonts.appendgraphicBgColor(groupindex); //"accent" + (groupindex + 1) + "-bg-color";
                break;
        }
    }
};

function LayoutManagerCurrencyConnector(argProps) {
    this.intPadding = 10;
    this.maximumChar = 30;
    this.intHorPadding = 40;
    this.intCircleRadius = 5;
    this.textAnchor = "middle";
    this.svgSeriesGroup = "";
    this.ChartHelper = argProps.ChartHelper;
    this.index = argProps.hasOwnProperty("index") ? argProps.index : null;
    this.groupIndex = argProps.hasOwnProperty("groupIndex") ? argProps.groupIndex : null;
    this.labelMaxWidth = argProps.hasOwnProperty("labelMaxWidth") ? argProps.labelMaxWidth : null;
    this.labelMaxHeight = argProps.hasOwnProperty("intLabelMaxHeight") ? argProps.intLabelMaxHeight : null;
    this.chartGrapicsAreaWidth = argProps.hasOwnProperty("graphicsAreaWidth") ? argProps.graphicsAreaWidth : null;
    this.chartGrapicsAreaHeight = argProps.hasOwnProperty("graphicsAreaHeight") ? argProps.graphicsAreaHeight : null;
    this.chartGrapicsAreaX = argProps.hasOwnProperty("graphicsAreaX") ? argProps.graphicsAreaX : null;
    this.layoutAreaHeight = argProps.hasOwnProperty("layoutAreaHeight") ? argProps.layoutAreaHeight : null;
    this.chartGrapicsAreaY = argProps.hasOwnProperty("graphicsAreaY") ? argProps.graphicsAreaY : null;
    this.parentWidth = argProps.hasOwnProperty("parentWidth") ? argProps.parentWidth : null;
    this.parentHeight = argProps.hasOwnProperty("parentHeight") ? argProps.parentHeight : null;
    this.objLongValueMeasurements = { width: 60, height: 30 };
    this.objLongLabelMeasurements = { width: 90, height: 40 };
    this.valueMaxWidth = this.objLongValueMeasurements.width;
    this.valueMaxHeight = this.objLongValueMeasurements.height;
    this.parentNode = argProps.parentElement;
    this.ChartUtils = argProps.ChartUtils;
    DComponent.call(this, this.parentNode, argProps);
}
LayoutManagerCurrencyConnector.prototype = Object.create(DComponent.prototype);
LayoutManagerCurrencyConnector.prototype.constructor = LayoutManagerCurrencyConnector;

Object.defineProperties(LayoutManagerCurrencyConnector.prototype, {
    svgData: {
        get: function () {
            if (this.groupIndex == 0) {
                this.doCalloutArrangement();
            }
            let layoutBaseSvg = this.data.SVGUtils.createElement("div");
            this.data.SVGUtils.assignAttributes(layoutBaseSvg, {
                id: "connectorSvg-" + this.groupIndex + "_" + 0,
                class: "connector",
            });
            layoutBaseSvg.style.position = "absolute";
            layoutBaseSvg.style.top = "0";
            layoutBaseSvg.style.width = "100%";
            layoutBaseSvg.style.height = "100%";
            this.svgSeriesGroup.style.position = "absolute";
            this.svgSeriesGroup.style.top = this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y);
            this.svgSeriesGroup.style.left = this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x);
            // if(this.data.layout.itemLayoutData[this.groupIndex].bounds.pos=="top"){
            //     this.svgSeriesGroup.style.top = this.data.SVGUtils.createPercentValue(this.parentHeight, 0);
            // }
            // this.data.SVGUtils.assignAttributes(this.svgSeriesGroup, {
            //     x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x),
            //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y)
            // });
            this.parentNode.appendChild(layoutBaseSvg);
            layoutBaseSvg.appendChild(this.svgSeriesGroup);
            this.doLabelCalloutArrangement();
            let layoutConnetorSvg = this.CreateConnector(layoutBaseSvg);
        },
    },
});

LayoutManagerCurrencyConnector.prototype.createLayoutSVG = function () {
    return this.layoutData;
};
LayoutManagerCurrencyConnector.prototype.doLabelCalloutArrangement = function () {
    let labelNodes = this.parentNode.querySelectorAll(".labeltext");
    for (let i1 = 0; i1 < labelNodes.length; i1++) {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX = this.data.layout.itemLayoutData[this.groupIndex].bounds.x + labelNodes[i1].offsetLeft;
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth = labelNodes[i1].clientWidth;
    }
};
LayoutManagerCurrencyConnector.prototype.doCalloutArrangement = function () {
    let currentX;
    let currentWidth;
    let prevX;
    let prevWidth;
    let currentY;
    let currentHeight;
    let prevY;
    let prevHeight;
    // let labelElements =
    for (let i1 = 0; i1 < this.data.layout.itemLayoutData.length; i1++) {
        currentX = this.data.layout.itemLayoutData[i1].bounds.x;
        currentWidth = this.data.layout.itemLayoutData[i1].bounds.w;
        prevX = "";
        prevWidth = "";
        if (i1 % 2 == 0) {
            if (i1 != 0) {
                prevX = this.data.layout.itemLayoutData[i1 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i1 - 2].bounds.w;
                if (currentX < prevX + prevWidth) {
                    let diffWidth = prevX + prevWidth - currentX;
                    this.data.layout.itemLayoutData[i1 - 2].bounds.x = prevX - diffWidth;
                    i1 = 0;
                }
            }
        } else {
            if (i1 != 1) {
                prevX = this.data.layout.itemLayoutData[i1 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i1 - 2].bounds.w;
                if (currentX < prevX + prevWidth) {
                    let diffWidth = prevX + prevWidth - currentX;
                    this.data.layout.itemLayoutData[i1 - 2].bounds.x = prevX - diffWidth;
                    i1 = 0;
                }
            }
        }
    }
    let topCount = 0;
    let bottomCount = 0;
    let moveX = 0;
    for (let i2 = 0; i2 < this.data.layout.itemLayoutData.length; i2++) {
        currentX = this.data.layout.itemLayoutData[i2].bounds.x;
        currentWidth = this.data.layout.itemLayoutData[i2].bounds.w;
        currentY = this.data.layout.itemLayoutData[i2].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i2].bounds.h;
        prevX = "";
        prevWidth = "";
        prevY = "";
        prevHeight = "";
        if (i2 % 2 == 0) {
            if (this.data.layout.itemLayoutData[0].bounds.x < 0) {
                moveX += 0 - this.data.layout.itemLayoutData[0].bounds.x;
            }
            if (i2 != 0) {
                prevX = this.data.layout.itemLayoutData[i2 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i2 - 2].bounds.w;
                moveX += currentX - (prevX + prevWidth) < 10 ? 1 * this.intHorPadding : 0;
            }
            // if (this.data.layout.itemLayoutData[i2].bounds.y < 0) {
            //     this.data.layout.itemLayoutData[i2].bounds.y = 0;
            // }
            this.data.layout.itemLayoutData[i2].bounds.x += moveX;
            topCount++;
        } else {
            this.data.layout.itemLayoutData[i2].bounds.y -= currentY + currentHeight > this.parentHeight ? currentY + currentHeight - this.parentHeight : 0;
            if (i2 != 1) {
                prevX = this.data.layout.itemLayoutData[i2 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i2 - 2].bounds.w;
                this.data.layout.itemLayoutData[i2].bounds.x += currentX - (prevX + prevWidth) < 10 ? 1 * this.intHorPadding : 0;
            }
            bottomCount++;
        }
    }
};

LayoutManagerCurrencyConnector.prototype.doComputation = function () {
    this.connectorHeight = (this.layoutAreaHeight / 2) * 0.2;
    this.maxSeriesHeight = this.layoutAreaHeight - this.connectorHeight;
    this.intNumerOfItemTop = Math.ceil(this.voData.seriesLength / 2);
    this.intNumberOfItemBottom = this.voData.seriesLength - this.intNumerOfItemTop;
    this.maxSeriesWidth = this.intNumerOfItemTop != 1 ? (this.parentWidth - this.intPadding * (this.intNumerOfItemTop - 1)) / this.intNumerOfItemTop : this.parentWidth * 0.9;
    if (this.groupIndex == 0) {
        this.data.layout.itemLayoutData = [];
    }
    if (this.groupIndex % 2 == 0) {
        // top
        this.vAlign = "top";
        this.hAlign = "center";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth / 2;
        this.centerY = this.chartGrapicsAreaY - this.connectorHeight;
        this.intPathY1 = this.chartGrapicsAreaY;
    } else {
        // bottom
        this.hAlign = "center";
        this.vAlign = "bottom";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth / 2;
        this.centerY = this.chartGrapicsAreaY + this.chartGrapicsAreaHeight + this.connectorHeight;
        this.intPathY1 = this.chartGrapicsAreaHeight + this.chartGrapicsAreaY;
    }

    let strLabelPosition = this.voData.layout.connectorLabelPosition ? this.voData.layout.connectorLabelPosition : this.voData.layout.calloutLabelPosition;
    let strValuePosition;
    if (strLabelPosition == "2") {
        strValuePosition = "LEFT";
    } else if (strLabelPosition == "3") {
        strValuePosition = "LEFT";
    } else if (strLabelPosition == "4") {
        strValuePosition = "RIGHT";
    } else if (strLabelPosition == "5") {
        strValuePosition = "TOP";
    } else if (strLabelPosition == "6") {
        strValuePosition = "TOP";
    }
    this.strValuePosition = strValuePosition;
    if (this.strValuePosition == "TOP") {
        this.labelhAlign = this.hAlign;
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth;
        this.maxValueHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxLabelWidth = this.maxSeriesWidth;
        this.maxLabelHeight = this.maxSeriesWidth;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, itemHeight, 36, 14);
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    } else if (this.strValuePosition == "LEFT") {
        this.hAlign = "left";
        this.labelhAlign = this.hAlign;
        this.textAnchor = "start";
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth * 0.4;
        this.maxValueHeight = this.maxSeriesHeight + 10;
        this.maxLabelHeight = this.maxValueHeight + 10;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, this.maxSeriesHeight, 36, 14);
        this.maxLabelWidth = this.maxSeriesWidth - this.objLongValueMeasurements.width;
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    }

    this.createSeriesItem();
};
LayoutManagerCurrencyConnector.prototype.createSeriesItem = function () {
    let labelMaxH;
    let labelMaxW;
    let labelHeight;
    let valueHeight;
    let element = document.createElement("div");
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let subelement = "";
    if (this.voData.layout.showLabel) {
        labelMaxH = (this.layoutAreaHeight / 2) * 0.5;
        labelMaxW = this.maxLabelWidth;

        let labelMaxFontSize = this.data.layout.labelfontsize ? this.data.layout.labelfontsize : 28;
        let labelanimationName = this.groupIndex % 2 == 0 ? "toplabel" : "bottomlabel";
        element.className = "label minlabelsize  moodanimation" + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
        element.id = "label-text-" + this.groupIndex;
        element.style.minWidth = 10 + "px";
        // element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";

        this.labelStyle = this.getColorDetails(this.groupIndex, "clsTextTertiaryColor", this.data.layout.labelColor, "color");
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (this.data.arrLabelTextSize[this.groupIndex]) element.style.fontSize = this.data.arrLabelTextSize[this.groupIndex];
        element.style.justifyContent = "unset";
        element.setAttribute("data-textalign", "horizantal");
        element.setAttribute("data-animation", labelanimationName);
        if (this.labelStyle == "clsAlterTertiaryColor") {
            element.style.position = "absolute";
            element.style.zIndex = 1;
        }

        this.parentNode.appendChild(element);
        subelement = document.createElement("div");
        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext  " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupIndex;
        if (this.data.arrLabelOpacity[this.groupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupIndex], "");
        if (this.data.arrLabeltexttransform[this.groupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupIndex], "");

        subelement.innerText = this.data.labels[this.groupIndex];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.overflow = "hidden";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.data.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.margin = "auto";
        subelement.setAttribute("maxFontSize", labelMaxFontSize);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-specialtype", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.classList.add("transparentBg");
        subelement.style.textAlign = "center";
        if (this.data._labelTextColor[this.groupIndex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupIndex], "important");
        }
        element.appendChild(subelement);
        if (this.data.arrHyperlinkUrl[this.groupIndex]) {
            subelement.style.pointerEvents = "all";
            element.style.pointerEvents = "all";
            subelement.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
        }
        if (this.vAlign == "top") {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        } else {
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        }
        this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, labelMaxFontSize, labelMaxFontSize);
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, labelMaxFontSize, labelMaxFontSize);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (this.vAlign == "top") {
            element.style.borderTop = "2px solid rgba(var(--item" + (this.groupIndex + 1) + "-color-rgb),1)";
        } else {
            element.style.borderBottom = "2px solid rgba(var(--item" + (this.groupIndex + 1) + "-color-rgb),1)";
            element.style.height = parseFloat(element.style.height) + 15 + "px";
            element.style.maxHeight = parseFloat(element.style.maxHeight) + 15 + "px";
        }
        if (this.strValuePosition == "LEFT") {
            subelement.style.borderTop = "unset";
            subelement.style.borderBottom = "unset";
            element.style.borderLeft = "6px solid rgba(var(--item" + (this.groupIndex + 1) + "-color-rgb),1)";
        }
        labelHeight = element.clientHeight;
        this.parentNode.removeChild(element);
    }
    this.valueStyle = this.getColorDetails(this.groupIndex, this.data.ChartFonts.valueOuterColor, this.data.layout.valueColor, "color");
    const groupindex = this.groupIndex;
    let valueMaxH = (this.layoutAreaHeight / 2) * 0.5;
    let valueMaxW = (this.parentWidth / this.voData.seriesLength) * 0.5;
    this.index = 0;
    let valueMaxFontSize = 32;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        valueMaxFontSize = categoryFontDetails.maxSize;
        minValueFontSize = categoryFontDetails.minSize;
    }
    valueMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : valueMaxFontSize;
    let animationName = this.groupIndex % 2 == 0 ? "topvalue" : "bottomvalue";
    const element1 = this.ChartHelper.createDivElement({});
    element1.id = "value-text-" + groupindex + "_" + this.index;
    element1.style.minHeight = 10 + "px";
    element1.style.height = valueMaxH + "px";
    element1.style.maxWidth = valueMaxW + "px";
    element1.style.maxHeight = valueMaxH + "px";
    element1.setAttribute("data-animation", animationName);
    if (this.groupIndex % 2 == 0) {
        element1.style.alignItems = "flex-end";
    }
    element1.className = "value topvalue overflow moodanimation";
    element1.style.justifyContent = "center";
    element1.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element1.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element1.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element1.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        element1.style.pointerEvents = "all";

        element1.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }

    this.parentNode.appendChild(element1);
    const subelement1 = document.createElement("div");

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement1, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement1, "value", "color", null, hasInnerValue);

    subelement1.id = "valuetext-" + groupindex + "_" + this.index;
    subelement1.className = "valuetext clsValueTextColor " + this.valueStyle + this.data.ChartFonts.valueThemeClassName;
    (subelement1.innerText = this.data.prefix[groupindex][0] + this.data.valuesDenomination[groupindex][0] + this.data.suffix[groupindex][0]), (subelement1.style.maxWidth = valueMaxW + "px");
    subelement1.style.maxHeight = valueMaxH + "px";
    subelement1.style.fontSize = valueMaxFontSize + "px";
    subelement1.style.justifyContent = "center";
    subelement1.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + this.index];
    subelement1.setAttribute("maxFontSize", valueMaxFontSize);
    subelement1.setAttribute("contenteditable", "true");
    subelement1.setAttribute("data-dck-selector", "true");
    subelement1.setAttribute("data-type", "value");
    subelement1.setAttribute("data-specialtype", "value");
    subelement1.setAttribute("data-id", groupindex + "_" + this.index);
    subelement1.setAttribute("data-slideid", this.data.slideID);
    subelement1.setAttribute("data-graphic-y", 20);
    if (this.data.layout.valueshadow == "true") {
        // let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        // let clsSendaryStyle = this.data.ChartFonts.valueOuterColor;
        // let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle
        // let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement1.classList.add(this.data.layout.valueShadowClass);
        // subelement1.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if (this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) {
        subelement1.setAttribute("data-dck-selector", "false");
        subelement1.setAttribute("contenteditable", "false");
    }
    // subelement1.dataset.animation = "secondarytext";
    this.maxValueFontSize = [42, 42];
    this.minValueFontSize = [25, 25];
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    element1.appendChild(subelement1);
    if (this.vAlign == "top") {
        if (this.data.layout.valuePaddingClass) {
            element1.classList.add(this.data.layout.valuePaddingClass);
        }
    } else {
        if (this.data.layout.valueAlterPaddingClass) {
            element1.classList.add(this.data.layout.valueAlterPaddingClass);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement1);
    this.calculateMaxFonsize(subelement1, false, valueMaxFontSize, groupindex);
    this.ChartHelper.adjustFontSize(subelement1, this.minValueFontSize[groupindex], valueMaxFontSize, valueMaxFontSize);
    this.ChartHelper.textPositionChangeObserver(subelement1);
    this.ChartUtils.createSpanFormat(subelement1, this.data);
    element1.style.height = "auto";
    this.checkHeight(element1);
    valueHeight = element1.clientHeight;
    this.parentNode.removeChild(element1);
    this.svgSeriesGroup = this.data.SVGUtils.createElement("div");
    this.svgSeriesGroup.style.display = "flex";
    this.svgSeriesGroup.style.alignItems = "center";
    this.svgSeriesGroup.style.justifyContent = "center";
    this.svgSeriesGroup.style.flexWrap = "wrap";
    let layoutAreaWidth = "";
    if (this.strValuePosition == "TOP") {
        this.svgSeriesGroup.style.flexFlow = this.vAlign == "top" ? "column-reverse" : "column";
    } else {
        this.svgSeriesGroup.style.flexFlow = "row-reverse";
    }
    if (this.vAlign == "top") {
        layoutAreaWidth = this.parentWidth / this.intNumerOfItemTop;
    } else {
        layoutAreaWidth = this.parentWidth / this.intNumberOfItemBottom;
    }

    this.svgSeriesGroup.append(element);
    this.svgSeriesGroup.append(element1);
    let containerHeight = valueHeight + labelHeight;
    let boundary = { width: layoutAreaWidth, height: containerHeight };
    this.svgSeriesGroup.style.width = this.data.SVGUtils.createPercentValue(this.parentWidth, boundary.width);
    this.svgSeriesGroup.style.height = this.data.SVGUtils.createPercentValue(this.parentHeight, boundary.height);
    this.centerY = this.vAlign == "top" ? this.centerY - boundary.height : this.centerY;
    if (this.vAlign == "top") {
        this.svgSeriesGroup.style.justifyContent = "flex-start";
    }
    //element percentage
    this.data.layout.itemLayoutData[this.groupIndex] = {
        bounds: {
            x: boundary.width,
            y: this.centerY,
            h: boundary.height,
            w: boundary.width,
            cx: this.centerX,
            cy: this.intPathY1,
            pos: this.vAlign,
            griphicWidth: this.chartGrapicsAreaWidth,
            griphicX: this.chartGrapicsAreaX,
        },
    };
    if (this.vAlign == "top") {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.x = this.groupIndex != 0 ? (this.groupIndex == 2 ? boundary.width * (this.groupIndex - 1) : boundary.width * (this.groupIndex - 2)) : 0;
    } else {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.x = this.groupIndex != 1 ? boundary.width * (this.groupIndex - 2) : boundary.width * (this.groupIndex - 1);
    }
};
LayoutManagerCurrencyConnector.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
LayoutManagerCurrencyConnector.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};

LayoutManagerCurrencyConnector.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize, groupindex) {
    if (groupindex == this.data.seriesLength - 1 && !boolmax) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        this.data.data.removeAttribute("valuemaxfontsize");
    }
};
LayoutManagerCurrencyConnector.prototype.checkHeight = function (element) {
    let paddingTop = window.getComputedStyle(element)["padding-top"] ? parseFloat(window.getComputedStyle(element)["padding-top"]) : 0;
    let paddingBottom = window.getComputedStyle(element)["padding-bottom"] ? parseFloat(window.getComputedStyle(element)["padding-bottom"]) : 0;
    let totalPadding = paddingTop + paddingBottom;
    let parentHeight = element.clientHeight;
    let childHeight = element.children[0].clientHeight;
    element.style.minHeight = childHeight + totalPadding + "px";
};
LayoutManagerCurrencyConnector.prototype.CreateConnector = function (argParent) {
    let connectorShape = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(connectorShape, {
        class: "labelcircle moodanimation connectorshape",
    });
    let layoutConnetorSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(layoutConnetorSvg, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    layoutConnetorSvg.style.pointerEvents = "none";
    argParent.appendChild(layoutConnetorSvg);
    layoutConnetorSvg.appendChild(connectorShape);
    let shapeBounds = this.getShapeBounds(connectorShape);
    if (shapeBounds.width > 0) {
        this.intCircleRadius = shapeBounds.width / 2;
    }
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let StrPath;
    let currentX = this.data.layout.itemLayoutData[this.groupIndex].bounds.x;
    let currentWidth = this.data.layout.itemLayoutData[this.groupIndex].bounds.w;
    let currentCx = this.data.layout.itemLayoutData[this.groupIndex].bounds.cx;
    let shapeX;
    let ShapeY;
    let layoutShapeMidPoint = this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX + this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth / 2;
    let minX = this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicX + this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicWidth * 0.2;
    let maxX = this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicX + this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicWidth * 0.8;
    y1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    if (this.data.layout.itemLayoutData[this.groupIndex].bounds.pos == "top") {
        y2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y + this.data.layout.itemLayoutData[this.groupIndex].bounds.h;
        if (minX <= layoutShapeMidPoint && maxX >= layoutShapeMidPoint) {
            x1 = layoutShapeMidPoint;
            x2 = layoutShapeMidPoint;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
            shapeX = x2;
            ShapeY = y2 + this.intCircleRadius;
        } else {
            x1 = currentCx;
            y1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
            x2 = currentCx;
            y2 = y2 + (y1 - y2) / 2;
            x3 = layoutShapeMidPoint;
            y3 = y2;
            x4 = x3;
            y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y + this.data.layout.itemLayoutData[this.groupIndex].bounds.h;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
            shapeX = x4;
            ShapeY = y4 + this.intCircleRadius;
        }
    } else {
        y2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
        if (minX <= layoutShapeMidPoint && maxX >= layoutShapeMidPoint) {
            x1 = layoutShapeMidPoint;
            x2 = layoutShapeMidPoint;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
            shapeX = x2;
            ShapeY = y2 - this.intCircleRadius;
        } else {
            x1 = currentCx;
            x2 = currentCx;
            x3 = layoutShapeMidPoint;
            y2 = y1 + (y2 - y1) / 2;
            y3 = y2;
            x4 = x3;
            y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
            shapeX = x4;
            ShapeY = y4 - this.intCircleRadius;
        }
        // if ((this.groupIndex < this.data.layout.itemLayoutData.length - 2 && currentX + currentWidth < currentCx) || currentX > currentCx) {
        //     y2 = y1 + (y2 - y1) / 2;
        //     x3 = currentX + currentWidth / 2;
        //     y3 = y2;
        //     x4 = x3;
        //     y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
        //     StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
        //     shapeX = x4;
        //     ShapeY = y4 - this.intCircleRadius;
        // } else {
        //     StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
        //     shapeX = x2;
        //     ShapeY = y2 - this.intCircleRadius;
        // }
    }

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    layoutConnetorSvg.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, {
        id: this.data.slideID + "mask_" + this.groupIndex,
        maskUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(mask);

    let startingBgLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingBgLine, {
        d: StrPath,
        stroke: "#fff",
        class: "clsstrokestyle",
        fill: "transparent",
        "stroke-dasharray": "6",
        "stroke-width": "2px",
    });
    mask.appendChild(startingBgLine);

    let startingLine = this.data.SVGUtils.createSVGElement("path");
    let strokeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutline" : "bottomlayoutline";
    this.data.SVGUtils.assignAttributes(startingLine, {
        id: "startingLine-" + this.groupIndex + "_" + 0,
        d: StrPath,
        "fill-opacity": "0",
        "stroke-width": "2px",
        "stroke-opacity": "0.5",
        "data-customopacity": "0.5",
        // mask: "url(#"+this.data.slideID+"mask_" + this.groupIndex + ")",
        class: "startingLine tertiary-stroke hdline moodanimation",
        "data-animation": strokeAnimationName,
    });
    layoutConnetorSvg.appendChild(startingLine);

    let shapeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutshape" : "bottomlayoutshape";
    this.data.SVGUtils.assignAttributes(connectorShape, {
        id: "labelcircle-" + this.groupIndex + "_" + 0,
        class: "labelcircle moodanimation connectorshape",
        cx: this.data.SVGUtils.createPercentValue(this.parentWidth, shapeX),
        cy: this.data.SVGUtils.createPercentValue(this.parentHeight, ShapeY),
        r: this.intCircleRadius,
        "data-animation": shapeAnimationName,
        "data-x": shapeX,
        "data-y": ShapeY,
    });
    layoutConnetorSvg.appendChild(connectorShape);
    return layoutConnetorSvg;
};
LayoutManagerCurrencyConnector.prototype.getShapeBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    return { width: width, height: height };
};
LayoutManagerCurrencyConnector.prototype.longlabelMeasurementCalculation = function (labelW, labelH, fontSize) {
    let objLongLabelMeasurements = {};
    let arrlonglabelMeasurements = [];
    let longlabelWidth = 0;
    let longlabelHeight = 0;
    let longlabelFontSize = 0;
    let length = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData._seriesItemLength : this.voData.seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        objLongLabelMeasurements = this.computeLabelMeasurement(i1, labelW, labelH, fontSize);
        arrlonglabelMeasurements.push(objLongLabelMeasurements);
        if (i1 == 0) {
            longlabelWidth = objLongLabelMeasurements.width;
            longlabelHeight = objLongLabelMeasurements.height;
            longlabelFontSize = objLongLabelMeasurements.fontsize;
        } else {
            longlabelWidth = longlabelWidth < objLongLabelMeasurements.width ? objLongLabelMeasurements.width : longlabelWidth;
            longlabelHeight = longlabelHeight < objLongLabelMeasurements.height ? objLongLabelMeasurements.height : longlabelHeight;
            longlabelFontSize = longlabelFontSize > objLongLabelMeasurements.fontsize ? objLongLabelMeasurements.fontsize : longlabelFontSize;
        }
    }
    objLongLabelMeasurements.width = longlabelWidth;
    objLongLabelMeasurements.height = longlabelHeight;
    objLongLabelMeasurements.fontsize = longlabelFontSize;
    return objLongLabelMeasurements;
};

LayoutManagerCurrencyConnector.prototype.computeLabelMeasurement = function (index, argMaxWidth, argMaxHeight, argMaxFontSize = 24, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 380, height: 20 };
};

LayoutManagerCurrencyConnector.prototype.computeValueMeasurement = function (argMaxWidth, argMaxHeight, argMaxFontSize = 28, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 110, height: 20 };
};
LayoutManagerCurrencyConnector.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor") && styleProperty == "multiple") {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsNodeAccentbg";
                    }
                    if (this.data.multicolor) {
                        return "clsNodeAccentbg";
                    } else {
                        return "clsNodeAccentbg";
                        // return "accent1-bg-color";
                    }
                    break;
            }
        }
    }
};

function LayoutManagerVerticalConnector(argProps) {
    this.intPadding = 10;
    this.maximumChar = 30;
    this.intHorPadding = 40;
    this.intCircleRadius = 5;
    this.textAnchor = "middle";
    this.ChartHelper = argProps.ChartHelper;
    this.index = argProps.hasOwnProperty("index") ? argProps.index : null;
    this.groupIndex = argProps.hasOwnProperty("groupIndex") ? argProps.groupIndex : null;
    this.labelMaxWidth = argProps.hasOwnProperty("labelMaxWidth") ? argProps.labelMaxWidth : null;
    this.labelMaxHeight = argProps.hasOwnProperty("intLabelMaxHeight") ? argProps.intLabelMaxHeight : null;
    this.chartGrapicsAreaWidth = argProps.hasOwnProperty("graphicsAreaWidth") ? argProps.graphicsAreaWidth : null;
    this.chartGrapicsAreaHeight = argProps.hasOwnProperty("graphicsAreaHeight") ? argProps.graphicsAreaHeight : null;
    this.chartGrapicsAreaX = argProps.hasOwnProperty("graphicsAreaX") ? argProps.graphicsAreaX : null;
    this.layoutAreaWidth = argProps.hasOwnProperty("layoutAreaWidth") ? argProps.layoutAreaWidth : null;
    this.chartGrapicsAreaY = argProps.hasOwnProperty("graphicsAreaY") ? argProps.graphicsAreaY : null;
    this.parentWidth = argProps.hasOwnProperty("parentWidth") ? argProps.parentWidth : null;
    this.parentHeight = argProps.hasOwnProperty("parentHeight") ? argProps.parentHeight : null;
    this.objLongValueMeasurements = { width: 60, height: 30 };
    this.objLongLabelMeasurements = { width: 90, height: 40 };
    this.valueMaxWidth = this.objLongValueMeasurements.width;
    this.valueMaxHeight = this.objLongValueMeasurements.height;
    this.parentNode = argProps.parentElement;
    this.ChartUtils = argProps.ChartUtils;
    this.svgSeriesGroup = "";
    DComponent.call(this, this.parentNode, argProps);
}
LayoutManagerVerticalConnector.prototype = Object.create(DComponent.prototype);
LayoutManagerVerticalConnector.prototype.constructor = LayoutManagerVerticalConnector;

Object.defineProperties(LayoutManagerVerticalConnector.prototype, {
    svgData: {
        get: function () {
            let layoutBaseSvg = this.data.SVGUtils.createElement("div");
            this.data.SVGUtils.assignAttributes(layoutBaseSvg, {
                id: "connectorSvg-" + this.groupIndex + "_" + 0,
                class: "connector verticalconnector",
            });
            layoutBaseSvg.style.position = "absolute";
            layoutBaseSvg.style.top = "0";
            layoutBaseSvg.style.width = "100%";
            layoutBaseSvg.style.height = "100%";
            this.svgSeriesGroup.style.position = "absolute";
            //this.svgSeriesGroup.style.top = this.data.layout.itemLayoutData[this.groupIndex].bounds.y+"px";
            this.svgSeriesGroup.style.left = this.data.layout.itemLayoutData[this.groupIndex].bounds.x + "px";
            // this.data.SVGUtils.assignAttributes(this.svgSeriesGroup, {
            //     x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x),
            //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y)
            // });
            this.parentNode.appendChild(layoutBaseSvg);
            layoutBaseSvg.appendChild(this.svgSeriesGroup);

            if (this.groupIndex == this.data.seriesLength - 1) {
                this.doCalloutArrangement();
                let positionTotalValues = [];
                let ArrLayoutBaseSvg = this.parentNode.parentNode ? this.parentNode.parentNode.querySelectorAll(".verticalconnector") : [];
                let labelGroupWidth = this.parentNode.parentNode ? this.parentNode.parentNode.querySelectorAll(".labelseriesgroup") : [];
                let seriesItems = this.parentNode.parentNode ? this.parentNode.parentNode.querySelectorAll(".seriesitem") : [];
                let seriesElements = this.parentNode.parentNode ? this.parentNode.parentNode.querySelectorAll(".series") : [];
                for (let s1 = 0; s1 < ArrLayoutBaseSvg.length; s1++) {
                    let labelConnectorWidth = labelGroupWidth[s1] ? labelGroupWidth[s1].clientWidth + this.connectorWidth : 0;
                    labelConnectorWidth += seriesItems[s1] ? seriesItems[s1].clientWidth : 0;
                    positionTotalValues.push(labelConnectorWidth);
                    this.reArrangePosition(ArrLayoutBaseSvg[s1], s1);
                }
                let maxValue = "";
                let differnceValue = "";
                if (positionTotalValues.length > 0) {
                    maxValue = Math.max.apply(null, positionTotalValues);
                    switch (this.data.layout.parenthPosition) {
                        case "center":
                            differnceValue = (this.parentWidth - maxValue) / 2;
                            break;
                        case "right":
                            differnceValue = this.parentWidth - maxValue;
                            break;
                    }
                }
                for (let s2 = 0; s2 < seriesElements.length; s2++) {
                    if (differnceValue && seriesElements[s2]) seriesElements[s2].style.left = differnceValue + "px";
                }
            }
            // this.doLabelCalloutArrangement();
            // let layoutConnetorSvg = this.CreateConnector(layoutBaseSvg);
        },
    },
});
LayoutManagerVerticalConnector.prototype.reArrangePosition = function (layoutBaseSvg, index) {
    let seriesGroup = layoutBaseSvg.querySelector(".labelseriesgroup");
    seriesGroup.style.top = this.data.layout.itemLayoutData[index].bounds.y + "px";
    let layoutConnetorSvg = this.CreateConnector(layoutBaseSvg, index);
};
LayoutManagerVerticalConnector.prototype.createLayoutSVG = function () {
    return this.layoutData;
};
LayoutManagerVerticalConnector.prototype.doLabelCalloutArrangement = function () {
    let labelNodes = this.parentNode.querySelectorAll(".labeltext");
    for (let i1 = 0; i1 < labelNodes.length; i1++) {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX = this.data.layout.itemLayoutData[this.groupIndex].bounds.x + labelNodes[i1].offsetLeft;
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth = labelNodes[i1].clientWidth;
    }
};
LayoutManagerVerticalConnector.prototype.doCalloutArrangement = function () {
    let currentX;
    let currentWidth;
    let prevX;
    let prevWidth;
    let currentY;
    let currentHeight;
    let prevY;
    let prevHeight;
    // let labelElements =
    for (let i1 = 0; i1 < this.data.layout.itemLayoutData.length; i1++) {
        currentY = this.data.layout.itemLayoutData[i1].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i1].bounds.h;
        prevY = "";
        prevHeight = "";
        if (i1 != 0) {
            prevY = this.data.layout.itemLayoutData[i1 - 1].bounds.y;
            prevHeight = this.data.layout.itemLayoutData[i1 - 1].bounds.h;
            if (currentY < prevY + prevHeight) {
                let diffHeight = prevY + prevHeight - currentY;
                this.data.layout.itemLayoutData[i1 - 1].bounds.y = prevY - diffHeight - intPadding;
                i1 = 0;
            }
        }
    }
    let topCount = 0;
    let bottomCount = 0;
    let moveY = 0;
    for (let i2 = 0; i2 < this.data.layout.itemLayoutData.length; i2++) {
        currentY = this.data.layout.itemLayoutData[i2].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i2].bounds.h;
        currentY = this.data.layout.itemLayoutData[i2].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i2].bounds.h;
        prevX = "";
        prevWidth = "";
        prevY = "";
        prevHeight = "";
        if (this.data.layout.itemLayoutData[0].bounds.y < 0) {
            moveY += 0 - this.data.layout.itemLayoutData[0].bounds.y;
        }
        // if (i2 != 0) {
        //     prevY = this.data.layout.itemLayoutData[i2 - 1].bounds.y;
        //     prevHeight = this.data.layout.itemLayoutData[i2 - 1].bounds.h;
        //     moveY += currentY - (prevY + prevHeight) < 10 ? 1 * this.intHorPadding : 0;
        // }
        // if (this.data.layout.itemLayoutData[i2].bounds.y < 0) {
        //     this.data.layout.itemLayoutData[i2].bounds.y = 0;
        // }
        // this.data.layout.itemLayoutData[i2].bounds.y -= moveY;
        // this.data.layout.itemLayoutData = this.data.layout.itemLayoutData;
    }
};

LayoutManagerVerticalConnector.prototype.doComputation = function () {
    this.connectorWidth = this.layoutAreaWidth * 0.1;
    this.maxSeriesWidth = this.layoutAreaWidth - this.connectorWidth;
    this.intNumerOfItem = this.voData.seriesLength;
    this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth;
    this.centerY = this.chartGrapicsAreaY + this.chartGrapicsAreaHeight / 2;
    this.intPathY1 = this.chartGrapicsAreaY;
    this.createSeriesItem();
};

LayoutManagerVerticalConnector.prototype.createSeriesItem = function () {
    let labelMaxH;
    let labelMaxW;
    let labelHeight;
    let valueHeight;
    let labelClientWidth = 0;
    let valueClientWidth = 0;
    let element = document.createElement("div");
    let subelement = "";
    if (this.voData.layout.showLabel) {
        labelMaxH = (this.parentHeight / this.data.seriesLength) * 0.8;
        labelMaxW = this.maxSeriesWidth * 0.9;

        let labelMaxFontSize = this.data.layout.labelfontsize ? this.data.layout.labelfontsize : 28;
        let labelanimationName = "toplabel";
        element.className = "label minlabelsize  moodanimation " + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
        element.id = "label-text-" + this.groupIndex;
        element.style.minWidth = 10 + "px";
        // element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";
        if (this.data.arrLabelTextSize[this.groupIndex]) element.style.fontSize = this.data.arrLabelTextSize[this.groupIndex];

        this.labelStyle = this.getColorDetails(this.groupIndex, "clsTextTertiaryColor", this.data.layout.labelColor, "color");
        element.style.justifyContent = "unset";
        element.setAttribute("data-animation", labelanimationName);
        this.ChartUtils.addDummyDiv(element, this.data.getCurrentSlide, this.data.slideID);
        subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;
        subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupIndex;
        if (this.data.arrLabelOpacity[this.groupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupIndex], "");
        if (this.data.arrLabeltexttransform[this.groupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupIndex], "");

        subelement.innerText = this.data.labels[this.groupIndex];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.overflow = "hidden";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.data.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.margin = "auto";
        subelement.setAttribute("maxFontSize", labelMaxFontSize);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-specialtype", "label");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.classList.add("transparentBg");
        element.appendChild(subelement);
        if (this.data._labelTextColor[this.groupIndex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupIndex], "important");
        }
        if (this.data.arrHyperlinkUrl[this.groupIndex]) {
            subelement.style.pointerEvents = "all";
            element.style.pointerEvents = "all";
            subelement.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
        }
        if (this.data.layout.labelPaddingClass) {
            element.classList.add(this.data.layout.labelPaddingClass);
        }
        // if (this.vAlign == "top") {
        //     if(this.data.layout.labelPaddingClass)
        //     {
        //         element.classList.add(this.data.layout.labelPaddingClass)
        //     }
        // }else{
        //     if(this.data.layout.labelAlterPaddingClass)
        //     {
        //         element.classList.add(this.data.layout.labelAlterPaddingClass)
        //     }
        // }
        this.ChartHelper.setTextChangeListner(subelement);
        // this.ChartHelper.adjustFontSize(subelement, 10,  this.data.ChartFonts.maxLabelFontSize(element), this.data.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.textPositionChangeObserver(subelement);
        // this.ChartHelper.adjustFontSizeWidth(subelement, 10, this.data.ChartFonts.maxLabelFontSize(element), this.data.ChartFonts.maxLabelFontSize(element));
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        labelHeight = element.clientHeight;
        labelClientWidth = element.clientWidth;
        this.ChartUtils.removeDummyDiv(this.data.getCurrentSlide, this.data.slideID);
        // if (this.vAlign == "top") {
        //     // subelement.style.borderTop = "2px solid var(--item" + (this.groupIndex + 1) + "-color)"
        // } else {
        //     // subelement.style.borderBottom = "2px solid var(--item" + (this.groupIndex + 1) + "-color)";
        //     element.style.height = parseFloat(element.style.height) + 15 + "px";
        //     element.style.maxHeight = parseFloat(element.style.maxHeight) + 15 + "px";
        // }
        // if (this.strValuePosition == "LEFT") {
        //     subelement.style.borderTop = "unset";
        //     subelement.style.borderBottom = "unset";
        //     // element.style.borderLeft = "6px solid var(--item" + (this.groupIndex + 1) + "-color)";
        // }

        if (this.data.layout.parenthPosition == "right") this.parentNode.parentNode.style.overflow = "hidden";
    }
    this.valueStyle = this.getColorDetails(this.groupIndex, this.data.ChartFonts.valueOuterColor, this.data.layout.valueColor, "color");
    const groupindex = this.groupIndex;
    let valueMaxH = (this.parentHeight / this.data.seriesLength) * 0.8;
    let valueMaxW = this.maxSeriesWidth * 0.3;
    this.index = 0;
    let valueMaxFontSize = 32;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        valueMaxFontSize = categoryFontDetails.maxSize;
        minValueFontSize = categoryFontDetails.minSize;
    }
    valueMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : valueMaxFontSize;
    let animationName = this.groupIndex % 2 == 0 ? "topvalue" : "bottomvalue";
    const element1 = this.ChartHelper.createDivElement({});
    element1.id = "value-text-" + groupindex + "_" + this.index;
    element1.style.minHeight = 10 + "px";
    // element1.style.height = valueMaxH + "px";
    element1.style.maxWidth = valueMaxW + "px";
    element1.style.maxHeight = valueMaxH + "px";
    element1.setAttribute("data-animation", animationName);
    element1.style.alignItems = "center";
    element1.className = "value topvalue overflow moodanimation";
    element1.style.justifyContent = "center";
    element1.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element1.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element1.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element1.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        element1.style.pointerEvents = "all";

        element1.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }

    this.parentNode.appendChild(element1);
    const subelement1 = document.createElement("div");

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement1, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement1, "value", "color", null, hasInnerValue);
    let colorTabValueCustomClass = this.valueStyle == "dummeycolor" ? "" : this.data.clsValueTextColor;

    subelement1.id = "valuetext-" + groupindex + "_" + this.index;
    subelement1.className = "valuetext " + this.valueStyle + this.data.ChartFonts.valueThemeClassName + " " + colorTabValueCustomClass;
    (subelement1.innerText = this.data.prefix[groupindex][0] + this.data.valuesDenomination[groupindex][0] + this.data.suffix[groupindex][0]), (subelement1.style.maxWidth = valueMaxW + "px");
    subelement1.style.maxHeight = valueMaxH + "px";
    subelement1.style.fontSize = valueMaxFontSize + "px";
    subelement1.style.justifyContent = "center";
    subelement1.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + this.index];
    subelement1.setAttribute("maxFontSize", valueMaxFontSize);
    subelement1.setAttribute("contenteditable", "true");
    subelement1.setAttribute("data-dck-selector", "true");
    subelement1.setAttribute("data-type", "value");
    subelement1.setAttribute("data-specialtype", "value");
    subelement1.setAttribute("data-id", groupindex + "_" + this.index);
    subelement1.setAttribute("data-slideid", this.data.slideID);
    subelement1.setAttribute("data-graphic-y", 20);
    if (this.data.layout.valueshadow == "true") {
        // let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        // let clsSendaryStyle = this.data.ChartFonts.valueOuterColor;
        // let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle
        // let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement1.classList.add(this.data.layout.valueShadowClass);
        // subelement1.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if (this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) {
        subelement1.setAttribute("data-dck-selector", "false");
        subelement1.setAttribute("contenteditable", "false");
    }
    // subelement1.dataset.animation = "secondarytext";
    valueHeight = element1.clientHeight;
    this.maxValueFontSize = [42, 42];
    this.minValueFontSize = [25, 25];
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    element1.appendChild(subelement1);
    if (this.data.layout.valuePaddingClass) {
        element1.classList.add(this.data.layout.valuePaddingClass);
    }
    // if (this.vAlign == "top") {
    //     if(this.data.layout.valuePaddingClass)
    //     {
    //         element1.classList.add(this.data.layout.valuePaddingClass)
    //     }
    // }else{
    //     if(this.data.layout.valueAlterPaddingClass)
    //     {
    //         element1.classList.add(this.data.layout.valueAlterPaddingClass)
    //     }
    // }
    this.ChartHelper.setTextChangeListner(subelement1);
    this.ChartHelper.adjustFontSize(subelement1, this.minValueFontSize[groupindex], valueMaxFontSize, valueMaxFontSize);
    this.ChartHelper.textPositionChangeObserver(subelement1);
    this.ChartUtils.createSpanFormat(subelement1, this.data);
    valueClientWidth = element1.clientWidth;
    this.parentNode.removeChild(element1);

    this.svgSeriesGroup = this.data.SVGUtils.createElement("div");
    this.svgSeriesGroup.className = "labelseriesgroup";
    // this.svgSeriesGroup.style.border = "2px solid green";
    this.svgSeriesGroup.style.display = "flex";
    this.svgSeriesGroup.style.alignItems = "center";
    this.svgSeriesGroup.style.justifyContent = "center";
    this.svgSeriesGroup.style.flexWrap = "wrap";
    let layoutAreaWidth = "";
    if (this.strValuePosition == "TOP") {
        this.svgSeriesGroup.style.flexFlow = this.vAlign == "top" ? "column-reverse" : "column";
    } else {
        this.svgSeriesGroup.style.flexFlow = "row-reverse";
    }
    this.svgSeriesGroup.append(element);
    this.svgSeriesGroup.append(element1);
    let containerHeight = valueHeight > labelHeight ? valueHeight : labelHeight;
    let ContainerWidth = valueClientWidth + labelClientWidth;
    let boundary = { width: ContainerWidth, height: containerHeight };
    this.svgSeriesGroup.style.maxWidth = this.data.SVGUtils.createPercentValue(this.parentWidth, this.maxSeriesWidth);
    this.svgSeriesGroup.style.height = this.data.SVGUtils.createPercentValue(this.parentHeight, boundary.height);
    let intcenterY = this.centerY - boundary.height / 2;
    //element percentage
    this.data.layout.itemLayoutData[this.groupIndex] = {
        bounds: {
            x: this.chartGrapicsAreaWidth + this.connectorWidth,
            y: intcenterY,
            h: boundary.height,
            w: boundary.width,
            cx: this.centerX,
            cy: this.centerY,
            pos: this.vAlign,
            griphicWidth: this.chartGrapicsAreaWidth,
            griphicX: this.chartGrapicsAreaX,
        },
    };
};

LayoutManagerVerticalConnector.prototype.CreateConnector = function (argParent, index) {
    let connectorShape = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(connectorShape, {
        class: "labelcircle moodanimation connectorshape",
    });
    let layoutConnetorSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(layoutConnetorSvg, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    argParent.appendChild(layoutConnetorSvg);
    layoutConnetorSvg.appendChild(connectorShape);
    let shapeBounds = this.getShapeBounds(connectorShape);
    if (shapeBounds.width > 0) {
        this.intCircleRadius = shapeBounds.width / 2;
    }
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let StrPath;
    let strPadding = 5;
    let currentCx = this.data.layout.itemLayoutData[index].bounds.cx;
    let shapeX;
    let ShapeY;
    let y3Value = this.data.layout.itemLayoutData[index].bounds.y + this.data.layout.itemLayoutData[index].bounds.h / 2;
    x1 = currentCx;
    y1 = this.data.layout.itemLayoutData[index].bounds.cy;
    x2 = currentCx + strPadding;
    y2 = this.data.layout.itemLayoutData[index].bounds.cy;
    x3 = currentCx + strPadding;
    y3 = y3Value;
    x4 = this.data.layout.itemLayoutData[index].bounds.x;
    y4 = y3Value;
    StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
    shapeX = x4;
    ShapeY = y4;

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    layoutConnetorSvg.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, {
        id: this.data.slideID + "mask_" + index,
        maskUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(mask);

    let startingBgLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingBgLine, {
        d: StrPath,
        stroke: "#fff",
        class: "clsstrokestyle",
        fill: "transparent",
        "stroke-dasharray": "6",
        "stroke-width": "2px",
    });
    mask.appendChild(startingBgLine);

    let startingLine = this.data.SVGUtils.createSVGElement("path");
    let strokeAnimationName = index % 2 == 0 ? "toplayoutline" : "bottomlayoutline";
    this.data.SVGUtils.assignAttributes(startingLine, {
        id: "startingLine-" + index + "_" + 0,
        d: StrPath,
        "fill-opacity": "0",
        "stroke-width": "2px",
        "stroke-opacity": "0.5",
        "data-customopacity": "0.5",
        // mask: "url(#"+this.data.slideID+"mask_" + this.groupIndex + ")",
        class: "startingLine tertiary-stroke hdline moodanimation",
        "data-animation": strokeAnimationName,
    });
    layoutConnetorSvg.appendChild(startingLine);

    let shapeAnimationName = index % 2 == 0 ? "toplayoutshape" : "bottomlayoutshape";
    this.data.SVGUtils.assignAttributes(connectorShape, {
        id: "labelcircle-" + index + "_" + 0,
        class: "labelcircle moodanimation connectorshape",
        cx: this.data.SVGUtils.createPercentValue(this.parentWidth, shapeX),
        cy: this.data.SVGUtils.createPercentValue(this.parentHeight, ShapeY),
        r: this.intCircleRadius,
        "data-animation": shapeAnimationName,
        "data-x": shapeX,
        "data-y": ShapeY,
    });
    layoutConnetorSvg.appendChild(connectorShape);
    return layoutConnetorSvg;
};
LayoutManagerVerticalConnector.prototype.getShapeBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    return { width: width, height: height };
};
LayoutManagerVerticalConnector.prototype.longlabelMeasurementCalculation = function (labelW, labelH, fontSize) {
    let objLongLabelMeasurements = {};
    let arrlonglabelMeasurements = [];
    let longlabelWidth = 0;
    let longlabelHeight = 0;
    let longlabelFontSize = 0;
    let length = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData._seriesItemLength : this.voData.seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        objLongLabelMeasurements = this.computeLabelMeasurement(i1, labelW, labelH, fontSize);
        arrlonglabelMeasurements.push(objLongLabelMeasurements);
        if (i1 == 0) {
            longlabelWidth = objLongLabelMeasurements.width;
            longlabelHeight = objLongLabelMeasurements.height;
            longlabelFontSize = objLongLabelMeasurements.fontsize;
        } else {
            longlabelWidth = longlabelWidth < objLongLabelMeasurements.width ? objLongLabelMeasurements.width : longlabelWidth;
            longlabelHeight = longlabelHeight < objLongLabelMeasurements.height ? objLongLabelMeasurements.height : longlabelHeight;
            longlabelFontSize = longlabelFontSize > objLongLabelMeasurements.fontsize ? objLongLabelMeasurements.fontsize : longlabelFontSize;
        }
    }
    objLongLabelMeasurements.width = longlabelWidth;
    objLongLabelMeasurements.height = longlabelHeight;
    objLongLabelMeasurements.fontsize = longlabelFontSize;
    return objLongLabelMeasurements;
};

LayoutManagerVerticalConnector.prototype.computeLabelMeasurement = function (index, argMaxWidth, argMaxHeight, argMaxFontSize = 24, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 380, height: 20 };
};
LayoutManagerVerticalConnector.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
LayoutManagerVerticalConnector.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};

LayoutManagerVerticalConnector.prototype.computeValueMeasurement = function (argMaxWidth, argMaxHeight, argMaxFontSize = 28, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 110, height: 20 };
};
LayoutManagerVerticalConnector.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor") && styleProperty == "multiple") {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsNodeAccentbg";
                    }
                    if (this.data.multicolor) {
                        return "clsNodeAccentbg";
                    } else {
                        return "clsNodeAccentbg";
                        // return "accent1-bg-color";
                    }
                    break;
            }
        }
    }
};

function LayoutManagerStackedBarConnector(argProps) {
    this.intPadding = 10;
    this.maximumChar = 30;
    this.intHorPadding = 40;
    this.intCircleRadius = 5;
    this.textAnchor = "middle";
    this.ChartHelper = argProps.ChartHelper;
    this.index = argProps.hasOwnProperty("index") ? argProps.index : null;
    this.groupIndex = argProps.hasOwnProperty("groupIndex") ? argProps.groupIndex : null;
    this.labelMaxWidth = argProps.hasOwnProperty("labelMaxWidth") ? argProps.labelMaxWidth : null;
    this.labelMaxHeight = argProps.hasOwnProperty("intLabelMaxHeight") ? argProps.intLabelMaxHeight : null;
    this.chartGrapicsAreaWidth = argProps.hasOwnProperty("graphicsAreaWidth") ? argProps.graphicsAreaWidth : null;
    this.chartGrapicsAreaHeight = argProps.hasOwnProperty("graphicsAreaHeight") ? argProps.graphicsAreaHeight : null;
    this.chartGrapicsAreaX = argProps.hasOwnProperty("graphicsAreaX") ? argProps.graphicsAreaX : null;
    this.layoutAreaHeight = argProps.hasOwnProperty("layoutAreaHeight") ? argProps.layoutAreaHeight : null;
    this.chartGrapicsAreaY = argProps.hasOwnProperty("graphicsAreaY") ? argProps.graphicsAreaY : null;
    this.parentWidth = argProps.hasOwnProperty("parentWidth") ? argProps.parentWidth : null;
    this.parentHeight = argProps.hasOwnProperty("parentHeight") ? argProps.parentHeight : null;
    this.objLongValueMeasurements = { width: 60, height: 30 };
    this.objLongLabelMeasurements = { width: 90, height: 40 };
    this.valueMaxWidth = this.objLongValueMeasurements.width;
    this.valueMaxHeight = this.objLongValueMeasurements.height;
    this.parentNode = argProps.parentElement;
    this.graphicElements = this.parentNode.querySelectorAll(".secondarychartgraphic");
    DComponent.call(this, this.parentNode, argProps);
}
LayoutManagerStackedBarConnector.prototype = Object.create(DComponent.prototype);
LayoutManagerStackedBarConnector.prototype.constructor = LayoutManagerStackedBarConnector;

Object.defineProperties(LayoutManagerStackedBarConnector.prototype, {
    svgData: {
        get: function () {
            if (this.groupIndex == 0) {
                this.doCalloutArrangement();
            }
            let layoutBaseSvg = this.data.SVGUtils.createElement("div");
            this.data.SVGUtils.assignAttributes(layoutBaseSvg, {
                id: "connectorSvg-" + this.groupIndex + "_" + 0,
                class: "connector",
            });
            layoutBaseSvg.style.position = "absolute";
            layoutBaseSvg.style.top = "0";
            layoutBaseSvg.style.width = "100%";
            layoutBaseSvg.style.height = "100%";
            this.svgSeriesGroup.style.position = "absolute";
            this.svgSeriesGroup.style.top = this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y);
            this.svgSeriesGroup.style.left = this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x);
            // this.data.SVGUtils.assignAttributes(this.svgSeriesGroup, {
            //     x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x),
            //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y)
            // });
            this.parentNode.appendChild(layoutBaseSvg);
            layoutBaseSvg.appendChild(this.svgSeriesGroup);
            this.doLabelCalloutArrangement();
            let layoutConnetorSvg = this.CreateConnector();
            layoutBaseSvg.appendChild(layoutConnetorSvg);
        },
    },
});

LayoutManagerStackedBarConnector.prototype.createLayoutSVG = function () {
    return this.layoutData;
};
LayoutManagerStackedBarConnector.prototype.doLabelCalloutArrangement = function () {
    let labelNodes = this.parentNode.querySelectorAll(".labeltext");
    for (let i1 = 0; i1 < labelNodes.length; i1++) {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX = this.data.layout.itemLayoutData[this.groupIndex].bounds.x + labelNodes[i1].offsetLeft;
        this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth = labelNodes[i1].clientWidth;
    }
};
LayoutManagerStackedBarConnector.prototype.doCalloutArrangement = function () {
    let currentX;
    let currentWidth;
    let prevX;
    let prevWidth;
    let currentY;
    let currentHeight;
    let prevY;
    let prevHeight;
    let halfPerc = this.data.seriesLength;
    // let labelElements =
    for (let i1 = 0; i1 < this.data.layout.itemLayoutData.length; i1++) {
        currentX = this.data.layout.itemLayoutData[i1].bounds.x;
        currentWidth = this.data.layout.itemLayoutData[i1].bounds.w;
        prevX = "";
        prevWidth = "";
        if (i1 % 2 == 0) {
            if (i1 != 0) {
                prevX = this.data.layout.itemLayoutData[i1 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i1 - 2].bounds.w;
                if (currentX < prevX + prevWidth) {
                    let diffWidth = prevX + prevWidth - currentX;
                    this.data.layout.itemLayoutData[i1 - 2].bounds.x = prevX - diffWidth;
                    i1 = 0;
                }
            }
        } else {
            if (i1 != 1) {
                prevX = this.data.layout.itemLayoutData[i1 - 2].bounds.x;
                prevWidth = this.data.layout.itemLayoutData[i1 - 2].bounds.w;
                if (currentX < prevX + prevWidth) {
                    let diffWidth = prevX + prevWidth - currentX;
                    this.data.layout.itemLayoutData[i1 - 2].bounds.x = prevX - diffWidth;
                    i1 = 0;
                }
            }
        }
    }
    let topCount = 0;
    let bottomCount = 0;
    let moveX = 0;
    for (let i2 = 0; i2 < this.data.layout.itemLayoutData.length; i2++) {
        currentX = this.data.layout.itemLayoutData[i2].bounds.x;
        currentWidth = this.data.layout.itemLayoutData[i2].bounds.w;
        currentY = this.data.layout.itemLayoutData[i2].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i2].bounds.h;
        prevX = "";
        prevWidth = "";
        prevY = "";
        prevHeight = "";
        // if (i2 % 2 == 0) {
        if (this.data.layout.itemLayoutData[0].bounds.x < 0) {
            moveX += 0 - this.data.layout.itemLayoutData[0].bounds.x;
        }
        if (i2 != 0) {
            prevX = this.data.layout.itemLayoutData[i2 - 1].bounds.x;
            prevWidth = this.data.layout.itemLayoutData[i2 - 1].bounds.w;
            moveX += currentX - (prevX + prevWidth) < 10 ? 1 * this.intHorPadding : 0;
        }
        // if (this.data.layout.itemLayoutData[i2].bounds.y < 0) {
        //     this.data.layout.itemLayoutData[i2].bounds.y = 0;
        // }
        this.data.layout.itemLayoutData[i2].bounds.x += moveX;
        topCount++;
        // } else {
        //     this.data.layout.itemLayoutData[i2].bounds.y -= (currentY + currentHeight) > this.parentHeight ? (currentY + currentHeight) - this.parentHeight : 0;
        //         prevX = this.data.layout.itemLayoutData[i2 - 2].bounds.x;
        //         prevWidth = this.data.layout.itemLayoutData[i2 - 2].bounds.w;
        //         this.data.layout.itemLayoutData[i2].bounds.x += currentX - (prevX + prevWidth) < 10 ? 1 * this.intHorPadding : 0;
        //     bottomCount++;
        // }
    }
};

LayoutManagerStackedBarConnector.prototype.doComputation = function () {
    this.connectorHeight = (this.layoutAreaHeight / 2) * 0.2;
    this.maxSeriesHeight = this.layoutAreaHeight - this.connectorHeight;
    this.intNumerOfItemTop = this.voData.seriesLength > 3 ? this.voData.seriesLength - 3 : 0;
    this.intNumberOfItemBottom = this.voData.seriesLength - this.intNumerOfItemTop;
    this.maxSeriesWidth = this.intNumerOfItemTop != 1 ? (this.parentWidth - this.intPadding * (this.intNumerOfItemTop - 1)) / this.intNumerOfItemTop : this.parentWidth * 0.9;
    if (this.groupIndex > 2) {
        // top
        this.vAlign = "top";
        this.hAlign = "center";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth * 0.1;
        this.centerY = this.chartGrapicsAreaY - this.connectorHeight;
        this.intPathY1 = this.chartGrapicsAreaY;
    } else {
        // bottom
        this.hAlign = "center";
        this.vAlign = "bottom";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth * 0.1;
        this.centerY = this.chartGrapicsAreaY + this.chartGrapicsAreaHeight + this.connectorHeight;
        this.intPathY1 = this.chartGrapicsAreaHeight + this.chartGrapicsAreaY;
    }

    let strLabelPosition = this.voData.layout.connectorLabelPosition ? this.voData.layout.connectorLabelPosition : this.voData.layout.calloutLabelPosition;
    let strValuePosition;
    if (strLabelPosition == "2") {
        strValuePosition = "LEFT";
    } else if (strLabelPosition == "3") {
        strValuePosition = "LEFT";
    } else if (strLabelPosition == "4") {
        strValuePosition = "RIGHT";
    } else if (strLabelPosition == "5") {
        strValuePosition = "TOP";
    } else if (strLabelPosition == "6") {
        strValuePosition = "TOP";
    }
    this.strValuePosition = strValuePosition;
    if (this.strValuePosition == "TOP") {
        this.labelhAlign = this.hAlign;
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth;
        this.maxValueHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxLabelWidth = this.maxSeriesWidth;
        this.maxLabelHeight = this.maxSeriesWidth;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, itemHeight, 36, 14);
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    } else if (this.strValuePosition == "LEFT") {
        this.hAlign = "left";
        this.labelhAlign = this.hAlign;
        this.textAnchor = "start";
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth * 0.4;
        this.maxValueHeight = this.maxSeriesHeight + 10;
        this.maxLabelHeight = this.maxValueHeight + 10;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, this.maxSeriesHeight, 36, 14);
        this.maxLabelWidth = this.maxSeriesWidth - this.objLongValueMeasurements.width;
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    }

    this.createSeriesItem();
};

LayoutManagerStackedBarConnector.prototype.createSeriesItem = function () {
    let labelMaxH;
    let labelMaxW;
    let labelHeight;
    let valueHeight;
    let element = document.createElement("div");
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let subelement = "";
    if (this.voData.layout.showLabel) {
        labelMaxH = (this.layoutAreaHeight / 2) * 0.5;
        labelMaxW = this.maxLabelWidth;

        let labelMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : 28;
        let labelanimationName = this.groupIndex > 2 ? "toplabel" : "bottomlabel";
        element.className = "label minlabelsize clsSecondaryTextColor moodanimation" + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
        element.id = "label-text-" + this.groupIndex;
        element.style.minWidth = 10 + "px";
        element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";

        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";

        element.style.justifyContent = "unset";
        element.setAttribute("data-textalign", "horizantal");
        element.dataset.animation = "primarytext";
        element.setAttribute("data-animation", labelanimationName);
        if (this.labelStyle == "clsAlterTertiaryColor") {
            element.style.position = "absolute";
            element.style.zIndex = 1;
        }

        this.parentNode.appendChild(element);
        subelement = document.createElement("div");

        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);

        subelement.className = "labeltext " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupIndex;
        if (this.data.arrLabelOpacity[this.groupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupIndex], "");
        if (this.data.arrLabeltexttransform[this.groupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupIndex], "");

        subelement.innerText = this.data.labels[this.groupIndex];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.overflow = "hidden";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = labelMaxFontSize + "px";
        // subelement.style.margin = "auto";
        subelement.setAttribute("maxFontSize", labelMaxFontSize);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-specialtype", "label");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        element.appendChild(subelement);
        if (this.data._labelTextColor[this.groupIndex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupIndex], "important");
        }
        if (this.data.arrHyperlinkUrl[this.groupIndex]) {
            subelement.style.pointerEvents = "all";
            element.style.pointerEvents = "all";
            subelement.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
        }
        this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, labelMaxFontSize, labelMaxFontSize);
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.recalculateMaxHeight(subelement);
        labelHeight = element.clientHeight;
        if (this.vAlign == "top") {
            // subelement.style.borderTop = "2px solid var(--item" + (this.groupIndex + 1) + "-color)"
        } else {
            // subelement.style.borderBottom = "2px solid var(--item" + (this.groupIndex + 1) + "-color)";
            element.style.height = parseFloat(element.style.height) + 15 + "px";
            element.style.maxHeight = parseFloat(element.style.maxHeight) + 15 + "px";
        }
        if (this.strValuePosition == "LEFT") {
            subelement.style.borderTop = "unset";
            subelement.style.borderBottom = "unset";
            element.style.borderLeft = "6px solid rgba(var(--item" + (this.groupIndex + 1) + "-color-rgb),1)";
        }
        this.parentNode.removeChild(element);
    }
    this.valueStyle = this.data.ChartFonts.valueOuterColor;
    const groupindex = this.groupIndex;
    let valueMaxH = (this.layoutAreaHeight / 2) * 0.5;
    let valueMaxW = (this.parentWidth / this.voData.seriesLength) * 0.5;
    this.index = 0;
    let valueMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : 32;
    let animationName = this.groupIndex % 2 == 0 ? "topvalue" : "bottomvalue";
    const element1 = this.ChartHelper.createDivElement({});
    element1.id = "value-text-" + groupindex + "_" + this.index;
    element1.style.minHeight = 10 + "px";
    // element1.style.height = valueMaxH + "px";
    element1.style.maxWidth = valueMaxW + "px";
    element1.style.maxHeight = valueMaxH + "px";
    element1.setAttribute("data-animation", animationName), (element1.className = "value topvalue overflow moodanimation");
    element1.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element1.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element1.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element1.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        element1.style.pointerEvents = "all";

        element1.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }
    this.parentNode.appendChild(element1);
    const subelement1 = document.createElement("div");
    subelement1.id = "valuetext-" + groupindex + "_" + this.index;
    subelement1.className = "valuetext " + this.valueStyle + this.data.ChartFonts.valueThemeClassName;
    (subelement1.innerText = this.data.prefix[groupindex][0] + this.data.valuesDenomination[groupindex][0] + this.data.suffix[groupindex][0]), (subelement1.style.maxWidth = valueMaxW + "px");
    subelement1.style.maxHeight = valueMaxH + "px";
    subelement1.style.fontSize = valueMaxFontSize + "px";
    subelement1.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + this.index];
    subelement1.setAttribute("maxFontSize", valueMaxFontSize);
    subelement1.setAttribute("contenteditable", "true");
    subelement1.setAttribute("data-dck-selector", "true");
    subelement1.setAttribute("data-type", "value");
    subelement1.setAttribute("data-specialtype", "value");
    subelement1.setAttribute("data-id", groupindex + "_" + this.index);
    subelement1.setAttribute("data-slideid", this.data.slideID);
    subelement1.setAttribute("data-graphic-y", 20);
    subelement1.dataset.animation = "secondarytext";
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement1.classList.add(this.data.layout.valueShadowClass);
        // subelement1.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    valueHeight = element1.clientHeight;
    element1.appendChild(subelement1);
    this.ChartHelper.setTextChangeListner(subelement1);
    this.ChartHelper.adjustFontSize(subelement1, 10, 20, valueMaxFontSize);
    this.ChartHelper.textPositionChangeObserver(subelement1);
    this.parentNode.removeChild(element1);

    this.svgSeriesGroup = this.data.SVGUtils.createElement("div");
    this.svgSeriesGroup.style.display = "flex";
    this.svgSeriesGroup.style.alignItems = "flex-start";
    this.svgSeriesGroup.style.justifyContent = "flex-end";
    this.svgSeriesGroup.style.flexWrap = "wrap";
    let layoutAreaWidth = "";

    if (this.strValuePosition == "TOP") {
        this.svgSeriesGroup.style.flexFlow = "column-reverse";
    } else {
        this.svgSeriesGroup.style.flexFlow = "row-reverse";
    }
    if (this.vAlign == "top") {
        this.svgSeriesGroup.style.alignItems = "flex-end";
        layoutAreaWidth = this.parentWidth / this.intNumberOfItemBottom;
    } else {
        layoutAreaWidth = this.parentWidth / this.intNumberOfItemBottom;
    }
    let graphicWidth = this.graphicElements.length > groupindex ? this.graphicElements[groupindex].clientWidth : 0;
    layoutAreaWidth = layoutAreaWidth > graphicWidth ? layoutAreaWidth : graphicWidth;
    this.svgSeriesGroup.append(element);
    this.svgSeriesGroup.append(element1);
    let containerHeight = valueHeight + labelHeight;
    let boundary = { width: layoutAreaWidth, height: containerHeight };
    this.svgSeriesGroup.style.width = this.data.SVGUtils.createPercentValue(this.parentWidth, boundary.width);
    this.svgSeriesGroup.style.height = this.data.SVGUtils.createPercentValue(this.parentHeight, boundary.height);
    this.centerY = this.vAlign == "top" ? this.centerY - boundary.height : this.centerY;

    //element percentage

    this.data.layout.itemLayoutData[this.groupIndex] = {
        bounds: {
            x: boundary.width,
            y: this.centerY,
            h: boundary.height,
            w: boundary.width,
            cx: this.centerX,
            cy: this.intPathY1,
            pos: this.vAlign,

            griphicWidth: this.chartGrapicsAreaWidth,
            griphicX: this.chartGrapicsAreaX,
        },
    };
    if (this.vAlign == "top") {
        this.data.layout.itemLayoutData[this.groupIndex].bounds.x = this.parentWidth - this.data.layout.itemLayoutData[this.groupIndex].bounds.w * (this.data.seriesLength - this.groupIndex);
    } else {
        if (this.groupIndex == 0) {
            this.data.layout.itemLayoutData[this.groupIndex].bounds.x = boundary.width * this.groupIndex;
        } else {
            this.data.layout.itemLayoutData[this.groupIndex].bounds.x = this.data.layout.itemLayoutData[this.groupIndex - 1].bounds.x + this.data.layout.itemLayoutData[this.groupIndex - 1].bounds.w;
        }
    }
};

LayoutManagerStackedBarConnector.prototype.CreateConnector = function () {
    let layoutConnetorSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(layoutConnetorSvg, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let StrPath;
    let currentX = this.data.layout.itemLayoutData[this.groupIndex].bounds.x;
    let currentWidth = this.data.layout.itemLayoutData[this.groupIndex].bounds.w;
    let currentCx = this.data.layout.itemLayoutData[this.groupIndex].bounds.cx;
    let currentCy = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    let shapeX;
    let ShapeY;
    let layoutShapeMidPoint = this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX + this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth / 2;
    let minX = this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicX + this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicWidth * 0.1;
    let maxX = this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicX + this.data.layout.itemLayoutData[this.groupIndex].bounds.griphicWidth * 0.1;
    y1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    if (this.data.layout.itemLayoutData[this.groupIndex].bounds.pos == "top") {
        layoutShapeMidPoint = this.data.layout.itemLayoutData[this.groupIndex].bounds.labelX + this.data.layout.itemLayoutData[this.groupIndex].bounds.labelWidth * 0.9;
        y2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y + this.data.layout.itemLayoutData[this.groupIndex].bounds.h;
        if (minX <= layoutShapeMidPoint && maxX >= layoutShapeMidPoint) {
            x1 = layoutShapeMidPoint;
            x2 = layoutShapeMidPoint;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
            shapeX = x2;
            ShapeY = y2 + this.intCircleRadius;
        } else {
            x1 = currentCx;
            y1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
            x2 = currentCx;
            y2 = y2 + (y1 - y2) / 2;
            x3 = layoutShapeMidPoint;
            y3 = y2;
            x4 = x3;
            y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y + this.data.layout.itemLayoutData[this.groupIndex].bounds.h;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
            shapeX = x4;
            ShapeY = y4 + this.intCircleRadius;
        }
    } else {
        y2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
        if (minX <= layoutShapeMidPoint && maxX >= layoutShapeMidPoint) {
            x1 = layoutShapeMidPoint;
            x2 = layoutShapeMidPoint;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
            shapeX = x2;
            ShapeY = y2 - this.intCircleRadius;
        } else {
            x1 = currentCx;
            x2 = currentCx;
            x3 = layoutShapeMidPoint;
            y2 = y1 + (y2 - y1) / 2;
            y3 = y2;
            x4 = x3;
            y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
            StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
            shapeX = x4;
            ShapeY = y4 - this.intCircleRadius;
        }
        // if ((this.groupIndex < this.data.layout.itemLayoutData.length - 2 && currentX + currentWidth < currentCx) || currentX > currentCx) {
        //     y2 = y1 + (y2 - y1) / 2;
        //     x3 = currentX + currentWidth / 2;
        //     y3 = y2;
        //     x4 = x3;
        //     y4 = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;
        //     StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2 + " L" + x3 + " " + y3 + " L" + x4 + " " + y4;
        //     shapeX = x4;
        //     ShapeY = y4 - this.intCircleRadius;
        // } else {
        //     StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y2;
        //     shapeX = x2;
        //     ShapeY = y2 - this.intCircleRadius;
        // }
    }

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    layoutConnetorSvg.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, {
        id: "mask_" + this.groupIndex,
        maskUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(mask);

    let startingBgLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingBgLine, {
        d: StrPath,
        stroke: "#fff",
        fill: "transparent",
        "stroke-dasharray": "6",
        "stroke-width": "2px",
    });
    mask.appendChild(startingBgLine);

    let startingLine = this.data.SVGUtils.createSVGElement("path");
    let strokeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutline" : "bottomlayoutline";
    this.data.SVGUtils.assignAttributes(startingLine, {
        id: "startingLine-" + this.groupIndex + "_" + 0,
        d: StrPath,
        "fill-opacity": 0,
        "fill-opacity": 0,
        "stroke-width": "2px",
        // mask: "url(#mask_" + this.groupIndex + ")",
        class: "startingLine secondary-fill secondary-stroke moodanimation",
        "data-animation": strokeAnimationName,
    });
    layoutConnetorSvg.appendChild(startingLine);

    let connectorShape = this.data.SVGUtils.createSVGElement("circle");
    let shapeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutshape" : "bottomlayoutshape";
    this.data.SVGUtils.assignAttributes(connectorShape, {
        id: "labelcircle-" + this.groupIndex + "_" + 0,
        class: "labelcircle moodanimation clsTertiaryFill",
        cx: this.data.SVGUtils.createPercentValue(this.parentWidth, currentCx),
        cy: this.data.SVGUtils.createPercentValue(this.parentHeight, currentCy),
        r: this.intCircleRadius,
        "data-animation": shapeAnimationName,
        "data-x": currentCx,
        "data-y": currentCy,
    });
    layoutConnetorSvg.appendChild(connectorShape);
    return layoutConnetorSvg;
};

LayoutManagerStackedBarConnector.prototype.longlabelMeasurementCalculation = function (labelW, labelH, fontSize) {
    let objLongLabelMeasurements = {};
    let arrlonglabelMeasurements = [];
    let longlabelWidth = 0;
    let longlabelHeight = 0;
    let longlabelFontSize = 0;
    let length = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData._seriesItemLength : this.voData.seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        objLongLabelMeasurements = this.computeLabelMeasurement(i1, labelW, labelH, fontSize);
        arrlonglabelMeasurements.push(objLongLabelMeasurements);
        if (i1 == 0) {
            longlabelWidth = objLongLabelMeasurements.width;
            longlabelHeight = objLongLabelMeasurements.height;
            longlabelFontSize = objLongLabelMeasurements.fontsize;
        } else {
            longlabelWidth = longlabelWidth < objLongLabelMeasurements.width ? objLongLabelMeasurements.width : longlabelWidth;
            longlabelHeight = longlabelHeight < objLongLabelMeasurements.height ? objLongLabelMeasurements.height : longlabelHeight;
            longlabelFontSize = longlabelFontSize > objLongLabelMeasurements.fontsize ? objLongLabelMeasurements.fontsize : longlabelFontSize;
        }
    }
    objLongLabelMeasurements.width = longlabelWidth;
    objLongLabelMeasurements.height = longlabelHeight;
    objLongLabelMeasurements.fontsize = longlabelFontSize;
    return objLongLabelMeasurements;
};

LayoutManagerStackedBarConnector.prototype.computeLabelMeasurement = function (index, argMaxWidth, argMaxHeight, argMaxFontSize = 24, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 380, height: 20 };
};

LayoutManagerStackedBarConnector.prototype.computeValueMeasurement = function (argMaxWidth, argMaxHeight, argMaxFontSize = 28, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 110, height: 20 };
};

let intRBItemLength = 0;
let intLTItemLength = 0;
let intLTItemCount = 1;
let objlabelMaxHeight = {};
let intPadding = 10;
let hAlign = "left";
let vAlign = "bottom";
let textAnchor = "start";
let arrLeftTop = [];
let arrRightTop = [];
let arrLeftBottom = [];
let arrRightBottom = [];
let arrCenterLeftTop = [];
let arrCenterRightTop = [];
let arrCenterLeftBottom = [];
let arrCenterRightBottom = [];
let connectorPointsArray = [];
let RTSeriesItemMaxHeight = "";
let RBSeriesItemMaxHeight;
let LBSeriesItemMaxHeight;
let LTSeriesItemMaxHeight;
let CLBSeriesItemMaxHeight;
let CLTSeriesItemMaxHeight;
let CRTSeriesItemMaxHeight;
let CRBSeriesItemMaxHeight;
let intpreviousRTY = 0;
let intpreviousRBY = 0;
let intpreviousLTY = 0;
let intpreviousLBY = 0;
let intTopBottomCount = 0;
let CLTSeriesItemMaxHeightValue = 0;
let intpreviousLeftYValue = 0;
let intpreviousRightYValue = 0;
let extraYvalue = 0;
function LayoutManagerRoundedConnector(argProps) {
    this.index = argProps.hasOwnProperty("index") ? argProps.index : null;
    this.endAngle = argProps.hasOwnProperty("endAngle") ? argProps.endAngle : null;
    this.startAngle = argProps.hasOwnProperty("startAngle") ? argProps.startAngle : null;
    this.groupIndex = argProps.hasOwnProperty("groupIndex") ? argProps.groupIndex : null;
    this.rectGraphics = argProps.hasOwnProperty("graphicsAreaSize") ? argProps.graphicsAreaSize : null;
    this.radius = argProps.hasOwnProperty("groupIndex") ? argProps.radius : null;
    this.valueMaxWidth = argProps.hasOwnProperty("valueMaxWidth") ? argProps.valueMaxWidth : null;
    this.labelMaxWidth = argProps.hasOwnProperty("labelMaxWidth") ? argProps.labelMaxWidth : null;
    this.valueMaxHeight = argProps.hasOwnProperty("valueMaxHeight") ? argProps.valueMaxHeight : null;
    this.labelMaxHeight = argProps.hasOwnProperty("labelMaxHeight") ? argProps.labelMaxHeight : null;
    this.chartGrapicsArea = argProps.hasOwnProperty("chartGrapicsAreaSize") ? argProps.chartGrapicsAreaSize : null;
    this.halfPiePosition = argProps.hasOwnProperty("halfPiePosition") ? argProps.halfPiePosition : null;
    this.maxAngle = argProps.hasOwnProperty("maxAngle") ? argProps.maxAngle : null;
    this.totalAngle = this.maxAngle == 180 ? 0 : this.maxAngle;
    this.ChartFonts = argProps.hasOwnProperty("ChartHelper") ? argProps.ChartHelper : null;
    this.customColorIndex = argProps.hasOwnProperty("customindex") ? argProps.customindex : null;
    this.ConnectorLabelSvg;
    this.ConnectorLineSvg;
    this.intSereiesItemMaxHeight;
    this.ConnectorSvg;
    this.alignSide = "left";
    //////////////////////////
    this.connectorLabelMaxWidth = 0;
    this.connectorLabelMaxHeight = 0;
    this.arrConnectorMeasurement = [
        {
            alignSide: "HorizontalAlign.RIGHT.BOTTOM",
            minAng: 0,
            maxAng: 46,
        },
        {
            alignSide: "HorizontalAlign.CENTER.BOTTOM.RIGHT",
            minAng: 47,
            maxAng: 90,
        },
        {
            alignSide: "HorizontalAlign.CENTER.LEFT.BOTTOM",
            minAng: 90,
            maxAng: 134,
        },
        {
            alignSide: "HorizontalAlign.LEFT.BOTTOM",
            minAng: 134,
            maxAng: 180,
        },
        {
            alignSide: "HorizontalAlign.LEFT.TOP",
            minAng: 180,
            maxAng: 224,
        },

        {
            alignSide: "HorizontalAlign.CENTER.LEFT.TOP",
            minAng: 224,
            maxAng: 271,
        },
        {
            alignSide: "HorizontalAlign.CENTER.RIGHT.TOP",
            minAng: 270,
            maxAng: 314,
        },
        {
            alignSide: "HorizontalAlign.RIGHT.TOP",
            minAng: 314,
            maxAng: 360,
        },
    ];
    this.ChartHelper = argProps.ChartHelper;
    this.ChartUtils = argProps.ChartUtils;
    this.parentNode = argProps.parentElement;
    this.width = argProps.parentWidth;
    this.height = argProps.parentHeight;
    this.negativeYValue = argProps.extraYvalue;
    DComponent.call(this, this.parentNode, argProps);
}
LayoutManagerRoundedConnector.prototype = Object.create(DComponent.prototype);
LayoutManagerRoundedConnector.prototype.constructor = LayoutManagerRoundedConnector;

Object.defineProperties(LayoutManagerRoundedConnector.prototype, {
    svgData: {
        get: function () {
            return this.ConnectorSvg;
        },
    },
    extraData: {
        get: function () {
            return extraYvalue;
        },
    },
    conflictsStatus: {
        get: function () {
            let calloutStatus = true;
            for (let i1 = 0; i1 < this.voData.seriesLength; i1++) {
                let currentValues;
                let nextValues;
                if (connectorPointsArray[i1].HorizontalAlign == "HorizontalAlign.RIGHT.TOP" && i1 < this.voData.seriesLength - 1 && (connectorPointsArray[i1 + 1].HorizontalAlign == "HorizontalAlign.RIGHT.TOP" || connectorPointsArray[i1 + 1].HorizontalAlign == "HorizontalAlign.CENTER.RIGHT.TOP")) {
                    currentValues = connectorPointsArray[i1].y + connectorPointsArray[i1].height;
                    nextValues = connectorPointsArray[i1 + 1].y;
                    if (currentValues <= nextValues) {
                        calloutStatus = true;
                    } else {
                        calloutStatus = false;
                    }
                } else if (connectorPointsArray[i1].HorizontalAlign == "HorizontalAlign.LEFT.TOP" && i1 < this.voData.seriesLength - 1 && (connectorPointsArray[i1 + 1].HorizontalAlign == "HorizontalAlign.LEFT.TOP" || connectorPointsArray[i1 + 1].HorizontalAlign == "HorizontalAlign.CENTER.LEFT.TOP")) {
                    currentValues = connectorPointsArray[i1].y;
                    nextValues = connectorPointsArray[i1 + 1].y + connectorPointsArray[i1 + 1].height;
                    if (nextValues <= currentValues) {
                        calloutStatus = true;
                    } else {
                        calloutStatus = false;
                    }
                }
                if (!calloutStatus) i1 += this.voData.seriesLength;
            }
            return calloutStatus;
        },
    },
});

LayoutManagerRoundedConnector.prototype.doComputation = function () {
    if (this.isvalid) {
        let intValueX, intValueY, intLabelY, intLabelX, intLineX4, intLineY4;
        let objPosition = {};
        let intSereiesItemMaxWidth = (this.width - this.chartGrapicsArea) / 2;
        let intSereiesItemMaxHeight = (this.height - this.chartGrapicsArea) / 2;
        let intMaxAngle = this.maxAngle;
        let boolStrightLine;
        let intConnectorLabelSvgX = 0;
        let intConnectorLabelSvgY = 0;
        let intConnectorLabelSvgWidth = 0;
        let intSeriesItemWidth = intSereiesItemMaxWidth;
        let intLineWidth = intSereiesItemMaxWidth * 0.13;
        this.valueMaxWidth = intSereiesItemMaxWidth * 0.87;
        this.connectorLabelMaxWidth = intSeriesItemWidth;
        this.connectorLabelMaxWidth = this.connectorLabelMaxWidth > intSeriesItemWidth * 0.85 ? intSeriesItemWidth * 0.85 : this.connectorLabelMaxWidth;
        let intStartAngle = this.startAngle;
        let intEndAngle = this.endAngle;
        let intCX = parseInt(this.width / 2);
        let intCY = parseInt(this.height / 2) + this.halfPiePosition;

        let intHalfAngle = (intEndAngle - intStartAngle) / 2;
        let intMidAngleX = Math.round(intCX + this.radius * Math.cos((Math.PI * (intStartAngle + intHalfAngle)) / 180));
        let intMidAngleY = Math.round(intCY + this.radius * Math.sin((Math.PI * (intStartAngle + intHalfAngle)) / 180));
        let intMidAngle = intHalfAngle + intStartAngle > intMaxAngle ? intHalfAngle + intStartAngle - this.totalAngle : intHalfAngle + intStartAngle;
        this.ConnectorLabelSvg = this.ChartHelper.createDivElement({});
        this.data.SVGUtils.assignAttributes(this.ConnectorLabelSvg, {
            id: "ConnectorLabelSvg" + this.groupIndex,
            "data-x": 0,
            "data-y": 0,
        });
        this.ConnectorLabelSvg.style.position = "absolute";
        // this.ConnectorLabelSvg.style.border = "2px solid green";
        this.ConnectorLabelSvg.style.display = "flex";
        let customColorIndex = this.customColorIndex;
        this.ConnectorSvg = this.ChartHelper.createDivElement({});
        this.data.SVGUtils.assignAttributes(this.ConnectorSvg, {
            id: "connectorSvg" + this.groupIndex,
            class: "connector accent" + customColorIndex + " clsMultiColorParent",
        });
        this.ConnectorSvg.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
        this.ConnectorSvg.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

        this.ConnectorSvg.style.width = "100%";
        this.ConnectorSvg.style.height = "100%";
        this.ConnectorSvg.style.position = "absolute";
        this.ConnectorSvg.style.pointerEvents = "none";
        this.ConnectorSvg.appendChild(this.ConnectorLabelSvg);
        this.ConnectorLineSvg = this.data.SVGUtils.createSVGElement("svg");
        this.data.SVGUtils.assignAttributes(this.ConnectorLineSvg, {
            id: "connectorLineSvg" + this.groupIndex,
            class: "accent" + customColorIndex + " clsMultiColorParent",
            width: "100%",
            height: "100%",
            "data-x": 0,
            "data-y": 0,
            style: "pointer-events:none;",
        });
        this.ConnectorLineSvg.style.setProperty("--customItemColor", "var(--item" + customColorIndex + "-color-rgb)");
        this.ConnectorLineSvg.style.setProperty("--customContrastColor", "var(--contrast" + customColorIndex + "-rgb)");

        this.ConnectorSvg.appendChild(this.ConnectorLineSvg);

        if (this.groupIndex == 0) {
            RTSeriesItemMaxHeight;
            RBSeriesItemMaxHeight;
            LBSeriesItemMaxHeight;
            LTSeriesItemMaxHeight;
            CLBSeriesItemMaxHeight;
            CLTSeriesItemMaxHeight;
            CRTSeriesItemMaxHeight;
            CRBSeriesItemMaxHeight;
            intpreviousRTY = 0;
            intpreviousRBY = 0;
            intpreviousLTY = 0;
            intpreviousLBY = 0;
            intRBItemLength = 0;
            objlabelMaxHeight = {};
            intPadding = 10;
            hAlign = "left";
            vAlign = "bottom";
            textAnchor = "start";
            arrRightBottom = [];
            arrLeftBottom = [];
            arrLeftTop = [];
            arrRightTop = [];
            arrCenterRightBottom = [];
            arrCenterRightTop = [];
            arrCenterLeftBottom = [];
            arrCenterLeftTop = [];
            connectorPointsArray = [];

            RBSeriesItemMaxHeight = 0;
            LBSeriesItemMaxHeight = 0;
            LTSeriesItemMaxHeight = 0;
            CLBSeriesItemMaxHeight = 1;
            CLTSeriesItemMaxHeight = 0;
            CRBSeriesItemMaxHeight = 1;
            intpreviousRTY = 0;
            intpreviousRBY = this.height;
            intpreviousLTY = this.height / 2;
            intpreviousLBY = this.height;

            intRBItemLength = 0;
            intLTItemLength = 0;
            intLTItemCount = 1;
            intpreviousRightYValue = 0;
            intpreviousLeftYValue = this.height;
            objlabelMaxHeight = {};
            extraYvalue = 0;
            this.doElementPosition();
        }
        let anglePoint = intMidAngleX;
        for (let i1 = 0; i1 < this.arrConnectorMeasurement.length; i1++) {
            if (intMidAngle <= this.arrConnectorMeasurement[i1].maxAng && intMidAngle >= this.arrConnectorMeasurement[i1].minAng) {
                objPosition = this.arrConnectorMeasurement[i1];
            }
        }
        let arrSereiesItemHeight = [RTSeriesItemMaxHeight, RBSeriesItemMaxHeight, LBSeriesItemMaxHeight, LTSeriesItemMaxHeight, CLBSeriesItemMaxHeight, CLTSeriesItemMaxHeight, CRTSeriesItemMaxHeight, CRBSeriesItemMaxHeight];
        let arrSereiesItemHeightvalues = [];
        for (let i2 = 0; i2 < arrSereiesItemHeight.length; i2++) {
            if (arrSereiesItemHeight[i2] != 0) {
                arrSereiesItemHeightvalues.push(arrSereiesItemHeight[i2]);
            } else {
                let seriesHeight = this.height / 2;
                arrSereiesItemHeightvalues.push(seriesHeight);
            }
        }
        intSereiesItemMaxHeight = Math.min.apply(null, arrSereiesItemHeightvalues);
        this.intSereiesItemMaxHeight = intSereiesItemMaxHeight * 0.77;
        this.data.maxValueW = this.valueMaxWidth;
        this.data.maxValueH = intSereiesItemMaxHeight;
        this.voData.voTheme.valueFontSize = !this.data.layout.valueInset ? 30 : this.voData.voTheme.valueFontSize;
        this.labelMaxHeight = intSereiesItemMaxHeight * 0.8;
        this.valueMaxHeight = intSereiesItemMaxHeight * 0.8;
        this.labelMaxWidth = this.connectorLabelMaxWidth;
        this.ConnectorLabelSvg.style.width = this.data.SVGUtils.createPercentValue(this.width, this.labelMaxWidth);
        let pntValueBounds = this.ValueMeasurement(true);
        let intValueWidth = pntValueBounds.width > this.valueMaxWidth ? this.valueMaxWidth : pntValueBounds.width;
        let intValueHeight = pntValueBounds.height > this.intSereiesItemMaxHeight ? this.intSereiesItemMaxHeight : pntValueBounds.height;

        let pntLabelBounds = this.labelMeasurement(true);
        let intLabelWidth = pntLabelBounds.width > intSeriesItemWidth ? intSeriesItemWidth : this.labelMaxWidth;
        let intLabelHeight = pntLabelBounds.height > this.intSereiesItemMaxHeight ? this.intSereiesItemMaxHeight : pntLabelBounds.height;
        intConnectorLabelSvgWidth = intLabelWidth;
        let ConnectorLabelSvgHeight = intLabelHeight > intValueHeight ? intLabelHeight : intValueHeight;
        let dummeyCLTSeriesItemMaxHeight = ConnectorLabelSvgHeight;
        //CLTSeriesItemMaxHeight =ConnectorLabelSvgHeight<CLTSeriesItemMaxHeight*0.8?CLTSeriesItemMaxHeight*0.8:CLTSeriesItemMaxHeight
        let parentHeight = this.height;
        let parentWidth = this.width;
        let padding = 12;
        if (objPosition.alignSide == "HorizontalAlign.LEFT.TOP" || objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.TOP") {
            boolStrightLine = true;
            // intLTItemLength = intLTItemLength == 1 ? 0 : intLTItemLength;
            intConnectorLabelSvgY = boolStrightLine ? intMidAngleY - dummeyCLTSeriesItemMaxHeight / 2 : intpreviousLTY - intLTItemCount * dummeyCLTSeriesItemMaxHeight;

            intConnectorLabelSvgY = boolStrightLine && intpreviousLeftYValue < intConnectorLabelSvgY + dummeyCLTSeriesItemMaxHeight + padding ? intpreviousLeftYValue - (padding + dummeyCLTSeriesItemMaxHeight) : intConnectorLabelSvgY;
            intpreviousLeftYValue = intConnectorLabelSvgY;
            if (this.negativeYValue < 0) {
                // intConnectorLabelSvgY += -(this.negativeYValue);
                this.negativeYValue = 0;
            }
            extraYvalue = intConnectorLabelSvgY;
            anglePoint = intSereiesItemMaxWidth;
            intLTItemCount++;
            intLTItemLength--;
            this.ConnectorLabelSvg.style.alignItems = "flex-end";
            this.ConnectorLabelSvg.style.pointerEvents = "none";
            if (objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.TOP") {
                anglePoint = intMidAngleX - intMidAngleX * 0.2;
            }
            this.alignSide = "left";
        } else {
            if (objPosition.alignSide == "HorizontalAlign.LEFT.BOTTOM" || objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.BOTTOM") {
                boolStrightLine = true;
                intConnectorLabelSvgY = intMidAngleY - dummeyCLTSeriesItemMaxHeight / 2;

                intConnectorLabelSvgY = boolStrightLine && intpreviousLeftYValue < intConnectorLabelSvgY + dummeyCLTSeriesItemMaxHeight ? intpreviousLeftYValue - dummeyCLTSeriesItemMaxHeight : intConnectorLabelSvgY;
                intpreviousLeftYValue = intConnectorLabelSvgY;
                anglePoint = intSereiesItemMaxWidth;

                // intConnectorLabelSvgY =
                //     LBSeriesItemMaxHeight == 0 && intLabelHeight > intValueHeight
                //         ? intpreviousLBY - ConnectorLabelSvgHeight
                //         : intConnectorLabelSvgY;
                intpreviousLBY -= objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.BOTTOM" ? CLBSeriesItemMaxHeight : 0;
                this.ConnectorLabelSvg.style.alignItems = "flex-end";
                if (objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.BOTTOM") {
                    anglePoint = intMidAngleX - intMidAngleX * 0.2;
                }
                this.alignSide = "left";
            }
        }
        if (objPosition.alignSide == "HorizontalAlign.LEFT.BOTTOM" || objPosition.alignSide == "HorizontalAlign.LEFT.TOP" || objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.BOTTOM" || objPosition.alignSide == "HorizontalAlign.CENTER.LEFT.TOP") {
            intValueX = intConnectorLabelSvgWidth - (intValueWidth + intPadding / 2);
            intLabelX = !this.data.layout.valueInset ? intValueX - (intLabelWidth + intPadding) : intConnectorLabelSvgWidth - intLabelWidth;
            intConnectorLabelSvgX = 0; //intMidAngleX - (intValueWidth + intLineWidth + intLabelWidth + intPadding + intPadding / 2);
            intLineX4 = intConnectorLabelSvgX + intValueX + intValueWidth + intPadding + intPadding;
            intLineY4 = intConnectorLabelSvgY + ConnectorLabelSvgHeight / 2;
            intValueY = intLabelHeight > intValueHeight ? (intLabelHeight - intValueHeight) / 2 : 0;
            intLabelY = intLabelHeight > intValueHeight ? 0 : intValueY + (intValueHeight - intLabelHeight) / 2;
            hAlign = "right";
            textAnchor = "end";
            // anglePoint = intSereiesItemMaxWidth;
            this.ConnectorLabelSvg.style.alignItems = "center";
            this.ConnectorLabelSvg.style.flexDirection = "row-reverse";
            this.alignSide = "left";
        }

        if (objPosition.alignSide == "HorizontalAlign.RIGHT.TOP" || objPosition.alignSide == "HorizontalAlign.CENTER.RIGHT.TOP") {
            intConnectorLabelSvgWidth = intLabelWidth;
            boolStrightLine = true;
            intConnectorLabelSvgY = intMidAngleY - ConnectorLabelSvgHeight / 2;
            intConnectorLabelSvgY = intpreviousRightYValue > intConnectorLabelSvgY ? intpreviousRightYValue : intConnectorLabelSvgY;
            intpreviousRightYValue = intConnectorLabelSvgY + ConnectorLabelSvgHeight;
            intLabelY = 0;
            intLabelX = intValueX + intValueWidth + intPadding;
            intLineX4 = this.width;
            intLineY4 = intConnectorLabelSvgY + ConnectorLabelSvgHeight / 2;
            intpreviousRTY += objPosition.alignSide == "HorizontalAlign.CENTER.RIGHT.TOP" ? (intLabelHeight > CRTSeriesItemMaxHeight ? intLabelHeight : CRTSeriesItemMaxHeight) : 0;
            anglePoint = intSereiesItemMaxWidth + this.chartGrapicsArea;
            if (objPosition.alignSide == "HorizontalAlign.CENTER.RIGHT.TOP") {
                anglePoint = intMidAngleX + intMidAngleX * 0.1;
            }
            this.alignSide = "right";
        }

        if (objPosition.alignSide == "HorizontalAlign.RIGHT.BOTTOM" || objPosition.alignSide == "HorizontalAlign.CENTER.BOTTOM.RIGHT") {
            intConnectorLabelSvgWidth = intLabelWidth;
            boolStrightLine = objPosition.alignSide == "HorizontalAlign.CENTER.BOTTOM.RIGHT" ? false : true;
            intRBItemLength = intRBItemLength == 1 ? 0 : intRBItemLength;

            intConnectorLabelSvgY = intMidAngleY - ConnectorLabelSvgHeight / 2;
            intConnectorLabelSvgY = intpreviousRightYValue > intConnectorLabelSvgY ? intpreviousRightYValue : intConnectorLabelSvgY;
            intpreviousRightYValue = intConnectorLabelSvgY + ConnectorLabelSvgHeight;

            intpreviousRBY - (ConnectorLabelSvgHeight + intRBItemLength * CRBSeriesItemMaxHeight);
            // intConnectorLabelSvgY =
            //     LBSeriesItemMaxHeight == 0 && intLabelHeight > intValueHeight
            //         ? intpreviousRBY - (ConnectorLabelSvgHeight + 10)
            //         : intConnectorLabelSvgY;
            intLabelY = 0;
            intLineX4 = this.width;
            anglePoint = intSereiesItemMaxWidth + this.chartGrapicsArea;
            objPosition.alignSide == "HorizontalAlign.CENTER.BOTTOM.RIGHT" ? intRBItemLength-- : "";
            if (objPosition.alignSide == "HorizontalAlign.CENTER.BOTTOM.RIGHT") {
                anglePoint = intMidAngleX + intMidAngleX * 0.1;
            }
            this.alignSide = "right";
        }

        if (objPosition.alignSide == "HorizontalAlign.RIGHT.TOP" || objPosition.alignSide == "HorizontalAlign.RIGHT.BOTTOM" || objPosition.alignSide == "HorizontalAlign.CENTER.RIGHT.TOP" || objPosition.alignSide == "HorizontalAlign.CENTER.BOTTOM.RIGHT") {
            intValueX = intPadding / 2;
            intLabelX = !this.voData.voLayout.valueInset ? intValueX + intValueWidth + intPadding : intValueX;
            intConnectorLabelSvgX = this.width - intConnectorLabelSvgWidth;
            intLineX4 = intConnectorLabelSvgX + intValueX - intPadding - intPadding;
            intLineY4 = intConnectorLabelSvgY + ConnectorLabelSvgHeight / 2;
            intValueY = intLabelHeight > intValueHeight ? intLabelY + (intLabelHeight - intValueHeight) / 2 : 0;
            intLabelY = intLabelHeight > intValueHeight ? 0 : intValueY + (intValueHeight - intLabelHeight) / 2;
            hAlign = "left";
            textAnchor = "start";
            this.alignSide = "right";
            this.ConnectorLabelSvg.style.alignItems = "center";
            this.ConnectorLabelSvg.style.flexDirection = "row";
        }
        this.ConnectorLabelSvg.style.width = this.data.SVGUtils.createPercentValue(this.width, intConnectorLabelSvgWidth);
        this.ConnectorLabelSvg.style.height = ConnectorLabelSvgHeight + "px";
        this.ConnectorLabelSvg.style.left = this.data.SVGUtils.createPercentValue(this.width, intConnectorLabelSvgX);
        this.ConnectorLabelSvg.style.top = intConnectorLabelSvgY + "px";

        let objConnectorShapePosition = {
            intLineX1: intMidAngleX,
            intLineY1: intMidAngleY,
            intLineX2: anglePoint,
            intLineY2: intLineY4,
            intLineX3: anglePoint,
            intLineY3: intLineY4,
            intLineX4: intLineX4,
            intLineY4: intLineY4,
            intLabelX: intLabelX,
            intLabelY: intLabelY,
            intValueX: intValueX,
            intValueY: intValueY,
            intSereiesItemMaxWidth: intSereiesItemMaxWidth,
            intConnectorLabelSvgWidth: intConnectorLabelSvgWidth,
            intSereiesItemMaxHeight: this.intSereiesItemMaxHeight,
            intConnectorLabelSvgHeight: ConnectorLabelSvgHeight,
            intLabelWidth: intLabelWidth,
            intValueWidth: intValueWidth,
            alignside: objPosition.alignSide,
        };
        let objConnectorPoints = {
            x: intConnectorLabelSvgX,
            y: intConnectorLabelSvgY,
            intLineY: intLineY4,
            midY: intMidAngleY,
            height: ConnectorLabelSvgHeight,
            width: intConnectorLabelSvgWidth,
            HorizontalAlign: objPosition.alignSide,
        };
        if (this.groupIndex == 0) connectorPointsArray = [];
        connectorPointsArray.push(objConnectorPoints);
        this.DrawConnectorShapes(objConnectorShapePosition, intValueWidth / 2);
        let svgMaskerShape1 = this.data.SVGUtils.createSVGElement("circle");
        this.data.SVGUtils.assignAttributes(svgMaskerShape1, {
            cx: intMidAngleX,
            cy: intMidAngleY,
            r: 4,
            id: "markershape-" + this.groupIndex + "_" + 0,
            class: "startShape moodanimation " + this.strStyleClass,
            "data-animation": "connectortail",
        });
        this.ConnectorLineSvg.appendChild(svgMaskerShape1);
    }
};

LayoutManagerRoundedConnector.prototype.DrawConnectorShapes = function (objConnectorShapePosition, radius = 5) {
    this.strStyleClass = this.getBgFillDetails(this.groupIndex, this.data.ChartFonts.graphicFillColor(this.groupIndex), this.data.layout.itemColor, "bgcolor");
    let svgMaskerShape;
    let randamId = Math.random().toFixed(3);
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    this.ConnectorLineSvg.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, {
        id: "mask-" + randamId,
        "data-maskelement": "true",
        maskUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(mask);

    let StrPath =
        "M" +
        objConnectorShapePosition.intLineX1 +
        "," +
        objConnectorShapePosition.intLineY1 +
        " L" +
        objConnectorShapePosition.intLineX2 +
        "," +
        objConnectorShapePosition.intLineY2 +
        " L" +
        objConnectorShapePosition.intLineX3 +
        "," +
        objConnectorShapePosition.intLineY3 +
        " L" +
        objConnectorShapePosition.intLineX4 +
        "," +
        objConnectorShapePosition.intLineY4;

    let startingBgLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingBgLine, {
        d: StrPath,
        stroke: "#fff",
        "shape-rendering": "crispEdges",
        "stroke-linejoin": "arcs",
        fill: "transparent",
        "stroke-width": "2px",
    });
    if (this.data.layout.connectorstyle == "dash" || this.data.layout.connectorstyle == "dashed")
        this.data.SVGUtils.assignAttributes(startingBgLine, {
            "stroke-dasharray": "5",
        });
    mask.appendChild(startingBgLine);
    let startingLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingLine, {
        id: "startingLine-" + this.groupIndex + "_" + 0,
        d: StrPath,
        "stroke-linejoin": "arcs",
        "stroke-width": this.data.layout.connectorThickness + "px",
        class: "startingLine moodanimation " + this.data.ChartFonts.graphicStrokeColor(this.groupIndex),
        "data-animation": "connectorline",
        "data-headindex": this.groupIndex,
        "fill-opacity": 0,
    });
    if (this.data.layout.connectorstyle == "dash" || this.data.layout.connectorstyle == "dashed") {
        this.data.SVGUtils.assignAttributes(startingLine, {
            mask: "url(#mask-" + randamId + ")",
            "data-mask": "true",
        });
    }
    this.ConnectorLineSvg.appendChild(startingLine);
    svgMaskerShape = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(svgMaskerShape, {
        cx: 0,
        cy: 0,
        r: 4,
        id: "markershape-" + this.groupIndex + "_" + 0,
        class: "markershape moodanimation " + this.strStyleClass,
        "data-animation": "connectorshape",
    });
    this.ConnectorLineSvg.appendChild(svgMaskerShape);
    svgMaskerShape.style.offsetPath = "path('" + StrPath + "')";
    svgMaskerShape.style.offsetDistance = "100%";
    svgMaskerShape.classList.add("moodanimation");
    svgMaskerShape.dataset.animation = "arrowhead";
    this.ValueMeasurement();
    this.labelMeasurement();
};

LayoutManagerRoundedConnector.prototype.doElementPosition = function () {
    arrRightBottom = [];
    arrLeftBottom = [];
    arrLeftTop = [];
    arrRightTop = [];
    arrCenterRightBottom = [];
    arrCenterRightTop = [];
    arrCenterLeftBottom = [];
    arrCenterLeftTop = [];
    let intAngle = 0;
    let intCX = parseInt(this.width / 2);
    let intCY = parseInt(this.height / 2) + this.halfPiePosition;
    let intEndAngle = parseInt(270);
    let intStartAngle = parseInt(270);
    for (let i1 = 0; i1 < this.voData.seriesLength; i1++) {
        intAngle = (this.maxAngle / this.data.totalValue) * parseFloat(this.voData.values[i1][0]);
        let intPaddingStartAngle = (intEndAngle * Math.PI) / 180;
        let intPaddingeEndAngles = ((intEndAngle + intAngle) * Math.PI) / 180;
        let midAngle = intPaddingStartAngle + (intPaddingeEndAngles - intPaddingStartAngle) / 2;
        intEndAngle += intAngle;
        let intHalfAngle = (intEndAngle - intStartAngle) / 2;
        let intMidAngleY = Math.round(intCY + this.radius * Math.sin((Math.PI * (intStartAngle + intHalfAngle)) / 180));
        let intMidAngle = intHalfAngle + intStartAngle > this.maxAngle ? intHalfAngle + intStartAngle - this.totalAngle : intHalfAngle + intStartAngle;
        intStartAngle += intAngle;
        if (intMidAngle < 44 && intMidAngle >= 0) {
            arrRightBottom.push(intMidAngleY);
        }
        if (intMidAngle < 90 && intMidAngle >= 44) {
            arrCenterRightBottom.push(intMidAngleY);
        }
        if (intMidAngle < 134 && intMidAngle >= 90) {
            arrCenterLeftBottom.push(intMidAngleY);
        }
        if (intMidAngle < 180 && intMidAngle >= 134) {
            arrLeftBottom.push(intMidAngleY);
        }
        if (intMidAngle <= 224 && intMidAngle >= 180) {
            arrLeftTop.push(intMidAngleY);
        }
        if (intMidAngle <= 270 && intMidAngle >= 224) {
            arrCenterLeftTop.push(intMidAngleY);
        }
        if (intMidAngle <= 314 && intMidAngle >= 270) {
            arrCenterRightTop.push(intMidAngleY);
        }
        if (intMidAngle <= 360 && intMidAngle >= 314) {
            arrRightTop.push(intMidAngleY);
        }
    }
    let intRTItemLength = arrRightTop.length + arrCenterRightTop.length;
    RTSeriesItemMaxHeight = arrRightTop.length > 1 ? (intCY - 30) / intRTItemLength : 0;
    CRTSeriesItemMaxHeight = arrCenterRightTop.length > 1 ? (intCY - 30) / intRTItemLength : (intCY - 30) / 2;

    intRBItemLength = arrRightBottom.length + arrCenterRightBottom.length;
    RBSeriesItemMaxHeight = arrRightBottom.length > 1 ? (intCY - 30) / intRBItemLength : 0;
    CRBSeriesItemMaxHeight = arrCenterRightBottom.length > 1 ? (intCY - 30) / intRBItemLength : (intCY - 30) / 2;

    let intLBItemLength = arrLeftBottom.length + arrCenterLeftBottom.length;
    LBSeriesItemMaxHeight = arrLeftBottom.length > 1 ? (intCY - 30) / intLBItemLength : 0;
    CLBSeriesItemMaxHeight = arrCenterLeftBottom.length > 1 ? (intCY - 30) / intLBItemLength : (intCY - 30) / 2;

    intLTItemLength = arrLeftTop.length + arrCenterLeftTop.length;
    LTSeriesItemMaxHeight = arrLeftTop.length > 1 ? (intCY - 30) / intLTItemLength : 0;
    CLTSeriesItemMaxHeight = arrCenterLeftTop.length > 1 ? intCY / intLTItemLength : (intCY - 30) / 2;

    intRBItemLength = arrCenterRightBottom.length;

    objlabelMaxHeight = {
        RTSeriesItemMaxHeight: RTSeriesItemMaxHeight,
        RBSeriesItemMaxHeight: RBSeriesItemMaxHeight,
        LBSeriesItemMaxHeight: LBSeriesItemMaxHeight,
        LTSeriesItemMaxHeight: LTSeriesItemMaxHeight,
        CLBSeriesItemMaxHeight: CLBSeriesItemMaxHeight,
        CLTSeriesItemMaxHeight: CLTSeriesItemMaxHeight,
        CRTSeriesItemMaxHeight: CRTSeriesItemMaxHeight,
        CRBSeriesItemMaxHeight: CRBSeriesItemMaxHeight,
    };
};

LayoutManagerRoundedConnector.prototype.labelMeasurement = function (mesurement = false) {
    let element = document.createElement("div");
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let subelement = "";
    let labelMaxFontSize = 28;
    let labelanimationName = this.groupIndex % 2 == 0 ? "toplabel" : "bottomlabel";
    element.className = "label minlabelsize clsSecondaryTextColor moodanimation" + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
    element.id = "label-text-" + this.groupIndex;
    element.style.zIndex = "10" + this.groupIndex;
    element.style.minWidth = 10 + "px";
    // element.style.height = this.labelMaxHeight + "px";
    element.style.maxWidth = this.labelMaxWidth + "px";
    element.style.maxHeight = this.labelMaxHeight + "px";

    element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
    element.style.paddingRight = this.data.layout.labelPaddingright + "px";
    element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
    element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
    if (this.data.arrLabelTextSize[this.groupIndex]) element.style.fontSize = this.data.arrLabelTextSize[this.groupIndex];
    element.style.justifyContent = "unset";
    element.setAttribute("data-textalign", "horizantal");
    element.dataset.animation = "primarytext";
    if (this.labelStyle == "clsAlterTertiaryColor") {
        element.style.position = "absolute";
        element.style.zIndex = 1;
    }
    // element.style.alignItems="center"

    this.parentNode.appendChild(this.ConnectorSvg);
    this.ConnectorLabelSvg.appendChild(element);
    subelement = document.createElement("div");

    let hasInnerLabel = this.data.layout.labelInset == "inside";
    this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
    this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
    let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

    subelement.className = "labeltext " + colorTabCustomClass + " " + this.labelStyle;
    subelement.id = "labeltext-" + this.groupIndex;
    if (this.data.arrLabelOpacity[this.groupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupIndex], "");
    if (this.data.arrLabeltexttransform[this.groupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupIndex], "");
    subelement.innerText = mesurement ? this.data.longLabel : this.data.labels[this.groupIndex];
    subelement.style.maxWidth = this.labelMaxWidth + "px";
    subelement.style.overflow = "hidden";
    subelement.style.maxHeight = this.labelMaxHeight + "px";
    subelement.style.wordBreak = "normal";
    subelement.style.fontSize = this.data.ChartFonts.maxLabelFontSize(element) + "px";
    subelement.setAttribute("maxFontSize", labelMaxFontSize);
    subelement.setAttribute("contenteditable", "true");
    subelement.setAttribute("data-dck-selector", "true");
    subelement.setAttribute("data-type", "label");
    subelement.setAttribute("data-specialtype", "label");
    subelement.setAttribute("data-slideid", this.data.slideID);
    subelement.setAttribute("data-id", this.groupIndex);
    subelement.setAttribute("data-prompt-text", "Enter Label");
    if (this.data._labelTextColor[this.groupIndex]) {
        subelement.style.setProperty("color", this.data._labelTextColor[this.groupIndex], "important");
    }
    subelement.dataset.themeClass = this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
    element.appendChild(subelement);

    if (this.alignSide == "left") {
        element.classList.add(this.data.layout.labelAlterPaddingClass);
        element.style.justifyContent = "center";
        subelement.style.textAlign = "right";
        this.ConnectorLabelSvg.style.alignItems = "center";
    }
    if (this.alignSide == "right") {
        element.classList.add(this.data.layout.labelPaddingClass);
        element.style.justifyContent = "center";
        subelement.style.textAlign = "left";
        this.ConnectorLabelSvg.style.alignItems = "center";
    }

    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        subelement.style.pointerEvents = "all";
        element.style.pointerEvents = "all";
        subelement.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }
    subelement.classList.add("transparentBg");
    this.parentNode.appendChild(this.ConnectorSvg);
    this.ChartUtils.enableTextHeighlight(subelement, this.data);
    this.ChartHelper.setTextChangeListner(subelement);
    this.ChartHelper.adjustFontSize(subelement, 10, 12, this.data.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.textPositionChangeObserver(subelement);
    this.ChartHelper.adjustFontSizeWidth(subelement, 10, 12, this.data.ChartFonts.maxLabelFontSize(element));
    this.ChartHelper.recalculateMaxHeight(subelement);
    // subelement.style.maxWidth = element.clientWidth+"px"
    labelHeight = element.clientHeight;
    if (this.vAlign == "top") {
    } else {
        element.style.height = parseFloat(element.style.height) + 15 + "px";
        element.style.maxHeight = parseFloat(element.style.maxHeight) + 15 + "px";
    }
    if (this.strValuePosition == "LEFT") {
        subelement.style.borderTop = "unset";
        subelement.style.borderBottom = "unset";
        element.style.borderLeft = "6px solid rgba(var(--item" + (this.groupIndex + 1) + "-color-rgb),1)";
    }
    let bounds = { width: element.clientWidth, height: element.clientHeight };
    this.parentNode.removeChild(this.ConnectorSvg);
    let boundsValue = "";

    if (mesurement) {
        boundsValue = this.parentNode.querySelector(".mesurementvalue");
        if (boundsValue) {
            boundsValue.parentNode.removeChild(boundsValue);
        }
        this.ConnectorLabelSvg.removeChild(element);
        return bounds;
    } else {
        boundsValue = this.parentNode.querySelector(".mesurementvalue");
        if (!boundsValue && subelement.parentNode && subelement.parentNode.parentNode) {
            boundsValue = subelement.parentNode.parentNode.querySelector(".mesurementvalue");
        }
        if (boundsValue) {
            boundsValue.parentNode.removeChild(boundsValue);
        }
    }
};

LayoutManagerRoundedConnector.prototype.ValueMeasurement = function (mesurement = false) {
    this.valueStyle = this.data.ChartFonts.valueOuterColor;
    const groupindex = this.groupIndex;
    let valueMaxH = this.valueMaxHeight;
    let valueMaxW = this.valueMaxWidth;
    this.index = 0;
    let valueMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : 32;
    if (this.data.customValueFontSize) {
        valueMaxFontSize = this.data.customValueFontSize;
    }
    let animationName = this.groupIndex % 2 == 0 ? "topvalue" : "bottomvalue";
    const element1 = this.ChartHelper.createDivElement({});
    element1.id = "value-text-" + groupindex + "_" + this.index;
    element1.style.minHeight = 10 + "px";
    element1.style.height = valueMaxH + "px";
    element1.style.maxWidth = valueMaxW + "px";
    element1.style.maxHeight = valueMaxH + "px";
    element1.style.zIndex = "10" + groupindex;
    element1.style.alignItems = "center";

    if (this.alignSide == "left") {
        element1.style.justifyContent = "flex-end";
        this.ConnectorLabelSvg.style.alignItems = "flex-start";
    }
    if (this.alignSide == "right") {
        element1.style.justifyContent = "flex-start";
        this.ConnectorLabelSvg.style.alignItems = "flex-end";
    }
    element1.className = "value topvalue overflow  n1";
    element1.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element1.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element1.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element1.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.layout.valuePaddingClass) {
        element1.classList.add(this.data.layout.valuePaddingClass);
    }
    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        element1.style.pointerEvents = "all";

        element1.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }
    this.parentNode.appendChild(this.ConnectorSvg);
    this.ConnectorLabelSvg.appendChild(element1);
    const subelement1 = document.createElement("div");

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement1, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement1, "value", "color", null, hasInnerValue);

    subelement1.id = "valuetext-" + groupindex + "_" + this.index;
    subelement1.className = "valuetext moodanimation " + this.valueStyle + this.data.ChartFonts.valueThemeClassName;
    subelement1.innerText = this.data.prefix[groupindex][0] + this.data.valuesDenomination[groupindex][0] + this.data.suffix[groupindex][0];
    subelement1.style.maxWidth = valueMaxW + "px";
    subelement1.style.maxHeight = valueMaxH + "px";
    subelement1.style.fontSize = valueMaxFontSize + "px";
    subelement1.setAttribute("data-animation", "secondarytext"), (subelement1.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + this.index]);
    subelement1.setAttribute("maxFontSize", valueMaxFontSize);
    subelement1.setAttribute("contenteditable", "true");
    subelement1.setAttribute("data-dck-selector", "true");

    subelement1.setAttribute("data-type", "value");
    subelement1.setAttribute("data-specialtype", "value");
    subelement1.setAttribute("data-id", groupindex + "_" + this.index);
    subelement1.setAttribute("data-slideid", this.data.slideID);
    subelement1.setAttribute("data-graphic-y", 20);
    if (this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) {
        subelement1.setAttribute("data-dck-selector", "false");
        subelement1.setAttribute("contenteditable", "false");
    }
    if (this.data.layout.valueshadow == "true") {
        let clsItemStyle = this.valueStyle.includes("Accent") ? this.valueStyle : this.ChartFonts.graphicColor(groupindex);
        let clsSendaryStyle = this.ChartFonts.valueOuterColor;
        let colorStyle = this.data.layout.valueTextShdowColor == "item" || this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle;
        let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement1.classList.add(this.data.layout.valueShadowClass);
        // subelement1.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    subelement1.dataset.animation = "secondarytext";
    valueHeight = element1.clientHeight;
    element1.appendChild(subelement1);
    this.ChartHelper.setTextChangeListner(subelement1);
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    let minValueFontSize = 25;
    if (categoryFontDetails) {
        valueMaxFontSize = categoryFontDetails.maxSize;
        minValueFontSize = categoryFontDetails.minSize;
    }
    if (this.data.customValueFontSize) {
        valueMaxFontSize = this.data.customValueFontSize;
    }
    subelement1.style.lineHeight = "1.5";
    this.calculateMaxFonsize(subelement1, false, valueMaxFontSize, groupindex);
    this.ChartHelper.adjustFontSize(subelement1, 10, minValueFontSize, valueMaxFontSize);
    this.ChartHelper.textPositionChangeObserver(subelement1);
    let pntValueBounds = { width: element1.clientWidth, height: element1.clientHeight };
    // this.parentNode.removeChild(this.ConnectorSvg);
    if (mesurement) {
        element1.classList.add("mesurementvalue");
        // this.ConnectorLabelSvg.removeChild(element1)
        return pntValueBounds;
    }
};
LayoutManagerRoundedConnector.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
LayoutManagerRoundedConnector.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};
LayoutManagerRoundedConnector.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize, groupindex) {
    if (groupindex == this.data.seriesLength - 1 && !boolmax && !this.data.promptText) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        this.data.data.removeAttribute("valuemaxfontsize");
    }
};
LayoutManagerRoundedConnector.prototype.longlabelMeasurementCalculation = function (labelW, labelH, fontSize) {
    let objLongLabelMeasurements = {};
    let arrlonglabelMeasurements = [];
    let longlabelWidth = 0;
    let longlabelHeight = 0;
    let longlabelFontSize = 0;
    let length = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData._seriesItemLength : this.voData.seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        objLongLabelMeasurements = this.computeLabelMeasurement(i1, labelW, labelH, fontSize);
        arrlonglabelMeasurements.push(objLongLabelMeasurements);
        if (i1 == 0) {
            longlabelWidth = objLongLabelMeasurements.width;
            longlabelHeight = objLongLabelMeasurements.height;
            longlabelFontSize = objLongLabelMeasurements.fontsize;
        } else {
            longlabelWidth = longlabelWidth < objLongLabelMeasurements.width ? objLongLabelMeasurements.width : longlabelWidth;
            longlabelHeight = longlabelHeight < objLongLabelMeasurements.height ? objLongLabelMeasurements.height : longlabelHeight;
            longlabelFontSize = longlabelFontSize > objLongLabelMeasurements.fontsize ? objLongLabelMeasurements.fontsize : longlabelFontSize;
        }
    }
    objLongLabelMeasurements.width = longlabelWidth;
    objLongLabelMeasurements.height = longlabelHeight;
    objLongLabelMeasurements.fontsize = longlabelFontSize;
    return objLongLabelMeasurements;
};

LayoutManagerRoundedConnector.prototype.computeLabelMeasurement = function (index, argMaxWidth, argMaxHeight, argMaxFontSize = 24, argMinFontSize = 12) {
    let textLongLabel = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData.multiSeriesLegend[index] : this.voData._labels[index];
    return this.ChartUtils.getTextMeasurement(this.voData.slideID, textLongLabel, argMaxWidth, argMaxHeight, argMaxFontSize, argMinFontSize, this.data.voTheme.labelFontFamily, this.data.voTheme.labelFontWeight, true, 1, this.ChartFonts.dynamiclegendLabelThemeClassName(0));
};

LayoutManagerRoundedConnector.prototype.computeValueMeasurement = function (argMaxWidth, argMaxHeight, argMaxFontSize = 28, argMinFontSize = 12) {
    return this.ChartUtils.getTextMeasurement(this.voData.slideID, this.data.longValue + this.singleSeriesText, argMaxWidth, argMaxHeight, argMaxFontSize, argMinFontSize, this.data.voTheme.valueFontFamily, this.data.voTheme._valueFontWeight, false, this.data.labelSize, this.ChartUtils.legendValueThemeClassName);
};
LayoutManagerRoundedConnector.prototype.getBgFillDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            if (fillProperty && fillProperty == "color") {
                PropertyIndex = 0;
            } else {
                PropertyIndex = groupindex;
            }
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "bgcolor":
            if (fillProperty == "stroke") {
                return "bgstroke";
            } else {
                return "fillbgColor";
            }
            break;
        case "tertiary":
            if (fillProperty == "stroke") {
                return "clsTertiaryStroke";
            } else {
                return "clsTertiaryFill";
            }
            break;
        case "secondary":
            if (fillProperty == "stroke") {
                return "secondary-stroke";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-fill";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = PropertyIndex != 0 ? 5 : groupindex;
                        return this.ChartFonts.appendgraphicColor(colorValue);
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        // return "accent" + (colorValue + 1) + "-fill";
                        return "clsAccentfill";
                    }
                    // return "accent" + (groupindex + 1) + "-fill";
                    if (this.data.multicolor) {
                        return "clsAccentfill";
                    } else {
                        return "clsAccentfill";
                        // return "accent1-fill";
                    }
                    break;
                case "stroke":
                    return this.data.ChartFonts.appendgraphicStrokeColor(groupindex);
                    break;
            }
        }
    }
};

function LayoutManagerVerticalDoubleSideConnector(argProps) {
    this.intPadding = 10;
    this.maximumChar = 30;
    this.intHorPadding = 40;
    this.intCircleRadius = 5;
    this.textAnchor = "middle";
    this.svgSeriesGroup = "";
    this.ChartHelper = argProps.ChartHelper;
    this.index = argProps.hasOwnProperty("index") ? argProps.index : null;
    this.measurement = argProps.hasOwnProperty("measurement") ? argProps.measurement : null;
    this.groupIndex = argProps.hasOwnProperty("groupIndex") ? argProps.groupIndex : null;
    this.labelMaxWidth = argProps.hasOwnProperty("intLabelMaxWidth") ? argProps.intLabelMaxWidth : null;
    this.connectorWidth = argProps.hasOwnProperty("connectorWidth") ? argProps.connectorWidth : null;
    this.labelMaxHeight = argProps.hasOwnProperty("intLabelMaxHeight") ? argProps.intLabelMaxHeight : null;
    this.chartGrapicsAreaWidth = argProps.hasOwnProperty("graphicsAreaWidth") ? argProps.graphicsAreaWidth : null;
    this.chartGrapicsAreaHeight = argProps.hasOwnProperty("graphicsAreaHeight") ? argProps.graphicsAreaHeight : null;
    this.chartGrapicsAreaX = argProps.hasOwnProperty("graphicsAreaX") ? argProps.graphicsAreaX : null;
    this.layoutAreaHeight = argProps.hasOwnProperty("layoutAreaHeight") ? argProps.layoutAreaHeight : null;
    this.chartGrapicsAreaY = argProps.hasOwnProperty("graphicsAreaY") ? argProps.graphicsAreaY : null;
    this.parentWidth = argProps.hasOwnProperty("parentWidth") ? argProps.parentWidth : null;
    this.parentHeight = argProps.hasOwnProperty("parentHeight") ? argProps.parentHeight : null;
    this.objLongValueMeasurements = { width: 60, height: 30 };
    this.objLongLabelMeasurements = { width: 90, height: 40 };
    this.valueMaxWidth = this.objLongValueMeasurements.width;
    this.valueMaxHeight = this.objLongValueMeasurements.height;
    this.parentNode = argProps.parentElement;
    this.ChartUtils = argProps.ChartUtils;
    DComponent.call(this, this.parentNode, argProps);
}
LayoutManagerVerticalDoubleSideConnector.prototype = Object.create(DComponent.prototype);
LayoutManagerVerticalDoubleSideConnector.prototype.constructor = LayoutManagerVerticalDoubleSideConnector;

Object.defineProperties(LayoutManagerVerticalDoubleSideConnector.prototype, {
    svgData: {
        get: function () {
            if (this.groupIndex == 0 && !this.measurement) {
                this.doCalloutArrangement();
            }
            let layoutBaseSvg = this.data.SVGUtils.createElement("div");
            this.data.SVGUtils.assignAttributes(layoutBaseSvg, {
                id: "connectorSvg-" + this.groupIndex + "_" + 0,
                class: "connector",
            });
            layoutBaseSvg.style.position = "absolute";
            layoutBaseSvg.style.top = "0";
            layoutBaseSvg.style.width = "100%";
            layoutBaseSvg.style.height = "100%";
            layoutBaseSvg.style.pointerEvents = "none";
            this.svgSeriesGroup.style.position = "absolute";
            this.svgSeriesGroup.style.top = this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y);
            this.svgSeriesGroup.style.left = this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x);
            this.svgSeriesGroup.dataset.top = this.data.layout.itemLayoutData[this.groupIndex].bounds.y;

            // if(this.data.layout.itemLayoutData[this.groupIndex].bounds.pos=="top"){
            //     this.svgSeriesGroup.style.top = this.data.SVGUtils.createPercentValue(this.parentHeight, 0);
            // }
            // this.data.SVGUtils.assignAttributes(this.svgSeriesGroup, {
            //     x: this.data.SVGUtils.createPercentValue(this.parentWidth, this.data.layout.itemLayoutData[this.groupIndex].bounds.x),
            //     y: this.data.SVGUtils.createPercentValue(this.parentHeight, this.data.layout.itemLayoutData[this.groupIndex].bounds.y)
            // });
            // this.parentNode.appendChild(layoutBaseSvg);
            layoutBaseSvg.appendChild(this.svgSeriesGroup);
            this.CreateConnector(layoutBaseSvg);
            return layoutBaseSvg;
        },
    },
});

LayoutManagerVerticalDoubleSideConnector.prototype.createLayoutSVG = function () {
    return this.layoutData;
};

LayoutManagerVerticalDoubleSideConnector.prototype.doCalloutArrangement = function () {
    let currentY;
    let currentHeight;
    let prevy;
    let prevHeight;
    let count = 0;
    // let labelElements =
    let leftVerPosition = "top";
    let rightVerTopPosition = "top";
    for (let i1 = 0; i1 < this.data.layout.itemLayoutData.length; i1++) {
        count++;
        currentY = this.data.layout.itemLayoutData[i1].bounds.y;
        currentHeight = this.data.layout.itemLayoutData[i1].bounds.h;
        prevY = "";
        prevHeight = "";
        if (count > 200) {
            break;
        }
        if (i1 % 2 == 0) {
            if (i1 != 0) {
                prevY = this.data.layout.itemLayoutData[i1 - 2].bounds.y;
                prevHeight = this.data.layout.itemLayoutData[i1 - 2].bounds.h;
                if (currentY < prevY + prevHeight) {
                    if (leftVerPosition == "top") {
                        let diffHeight = prevY + prevHeight - currentY;
                        if (prevY - diffHeight < 0) {
                            this.data.layout.itemLayoutData[i1 - 2].bounds.y = prevY + diffHeight;
                            this.data.layout.itemLayoutData[i1 - 2].bounds.labelcenterpoint = prevY - diffHeight + this.data.layout.itemLayoutData[i1 - 2].bounds.h / 2;
                        } else {
                            this.data.layout.itemLayoutData[i1 - 2].bounds.y = prevY - diffHeight;
                            this.data.layout.itemLayoutData[i1 - 2].bounds.labelcenterpoint = prevY - diffHeight + this.data.layout.itemLayoutData[i1 - 2].bounds.h / 2;
                        }
                        leftVerPosition = "bottom";
                        i1 = 0;
                    } else if (leftVerPosition == "bottom") {
                        let diffHeight = prevY + prevHeight - currentY;
                        this.data.layout.itemLayoutData[i1].bounds.y = prevY + diffHeight;
                        this.data.layout.itemLayoutData[i1].bounds.labelcenterpoint = prevY + diffHeight + this.data.layout.itemLayoutData[i1 - 2].bounds.h / 2;

                        leftVerPosition = "top";
                        i1 = 0;
                    }
                }
            }
        } else {
            if (i1 != 1) {
                prevY = this.data.layout.itemLayoutData[i1 - 2].bounds.y;
                prevHeight = this.data.layout.itemLayoutData[i1 - 2].bounds.h;
                if (currentY < prevY + prevHeight) {
                    if (rightVerTopPosition == "top") {
                        let diffHeight = prevY + prevHeight - currentY;
                        this.data.layout.itemLayoutData[i1 - 2].bounds.y = prevY - diffHeight;
                        this.data.layout.itemLayoutData[i1 - 2].bounds.labelcenterpoint = prevY - diffHeight + this.data.layout.itemLayoutData[i1 - 2].bounds.h / 2;
                        rightVerTopPosition = "bottom";
                        i1 = 0;
                    } else if (rightVerTopPosition == "bottom") {
                        let diffHeight = prevY + prevHeight - currentY;
                        this.data.layout.itemLayoutData[i1].bounds.y = prevY + diffHeight;
                        this.data.layout.itemLayoutData[i1].bounds.labelcenterpoint = prevY + diffHeight + this.data.layout.itemLayoutData[i1 - 2].bounds.h / 2;
                        rightVerTopPosition = "top";
                        i1 = 0;
                    }
                }
            }
        }
    }
};

LayoutManagerVerticalDoubleSideConnector.prototype.doComputation = function () {
    this.connectorHeight = (this.layoutAreaHeight / 2) * 0.2;
    this.maxSeriesHeight = this.layoutAreaHeight - this.connectorHeight;
    this.intNumerOfItemTop = Math.ceil(this.voData.seriesLength / 2);
    this.intNumberOfItemBottom = this.voData.seriesLength - this.intNumerOfItemTop;
    this.maxSeriesWidth = this.intNumerOfItemTop != 1 ? (this.parentWidth - this.intPadding * (this.intNumerOfItemTop - 1)) / this.intNumerOfItemTop : this.parentWidth * 0.9;
    if (this.groupIndex == 0 && this.measurement) {
        this.data.layout.itemLayoutData = [];
    }
    if (this.groupIndex % 2 == 0) {
        // top
        this.vAlign = "left";
        this.hAlign = "left";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth / 2;
        this.centerY = this.chartGrapicsAreaY;
        this.intPathY1 = this.chartGrapicsAreaY;
    } else {
        // bottom
        this.hAlign = "right";
        this.vAlign = "right";
        this.centerX = this.chartGrapicsAreaX + this.chartGrapicsAreaWidth / 2;
        this.centerY = this.chartGrapicsAreaY;
        this.intPathY1 = this.chartGrapicsAreaY;
    }

    let strLabelPosition = this.voData.layout.connectorLabelPosition ? this.voData.layout.connectorLabelPosition : this.voData.layout.calloutLabelPosition;
    let strValuePosition = "LEFT";
    this.strValuePosition = strValuePosition;
    if (this.strValuePosition == "TOP") {
        this.labelhAlign = this.hAlign;
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth;
        this.maxValueHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxLabelWidth = this.maxSeriesWidth;
        this.maxLabelHeight = this.maxSeriesWidth;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, itemHeight, 36, 14);
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    } else if (this.strValuePosition == "LEFT") {
        this.hAlign = "left";
        this.labelhAlign = this.hAlign;
        this.textAnchor = "start";
        let itemHeight = (this.maxSeriesHeight - this.intPadding) / 2;
        this.maxValueWidth = this.maxSeriesWidth * 0.4;
        this.maxValueHeight = this.maxSeriesHeight + 10;
        this.maxLabelHeight = this.maxValueHeight + 10;
        this.objLongValueMeasurements = this.computeValueMeasurement(this.maxValueWidth, this.maxSeriesHeight, 36, 14);
        this.maxLabelWidth = this.maxSeriesWidth - this.objLongValueMeasurements.width;
        this.objLongLabelMeasurements = this.longlabelMeasurementCalculation(this.maxLabelWidth, itemHeight, 28, 14);
    }
    this.createSeriesItem();
};
LayoutManagerVerticalDoubleSideConnector.prototype.createSeriesItem = function () {
    let labelMaxH;
    let labelMaxW;
    let labelHeight;
    let valueHeight;
    let element = document.createElement("div");
    this.arrIndex = this.data.seriesLength <= 2 ? 0 : 1;
    let subelement = "";
    if (this.voData.layout.showLabel) {
        labelMaxH = (this.layoutAreaHeight / 2) * 0.5;
        labelMaxW = this.maxLabelWidth;

        let labelMaxFontSize = this.data.layout.labelfontsize ? this.data.layout.labelfontsize : 28;
        let labelanimationName = this.groupIndex % 2 == 0 ? "toplabel" : "bottomlabel";
        element.className = "label minlabelsize  moodanimation " + this.data.ChartFonts.dynamiclabelThemeClassName(this.groupIndex);
        element.id = "label-text-" + this.groupIndex;
        element.style.minWidth = 10 + "px";
        // element.style.height = labelMaxH + "px";
        element.style.maxWidth = labelMaxW + "px";
        element.style.maxHeight = labelMaxH + "px";

        this.labelStyle = this.getColorDetails(this.groupIndex, "clsTextTertiaryColor", this.data.layout.labelColor, "color");
        element.style.paddingLeft = this.data.layout.labelPaddingleft + "px";
        element.style.paddingRight = this.data.layout.labelPaddingright + "px";
        element.style.paddingTop = this.data.layout.labelPaddingtop + "px";
        element.style.paddingBottom = this.data.layout.labelPaddingbottom + "px";
        if (this.data.arrLabelTextSize[this.groupIndex]) element.style.fontSize = this.data.arrLabelTextSize[this.groupIndex];
        element.style.justifyContent = "unset";
        element.setAttribute("data-textalign", "horizantal");
        element.setAttribute("data-animation", labelanimationName);
        if (this.labelStyle == "clsAlterTertiaryColor") {
            element.style.position = "absolute";
            element.style.zIndex = 1;
        }

        this.parentNode.appendChild(element);
        subelement = document.createElement("div");
        let hasInnerLabel = this.data.layout.labelInset == "inside";
        this.labelStyle = this.checkMoodColorvalue(this.data.layout.labelColor, this.labelStyle, subelement, "heading", hasInnerLabel);
        this.checkMoodLevelColorvalue(this.data.layout.labelColor, subelement, "heading", "color", null, hasInnerLabel);
        let colorTabCustomClass = this.labelStyle == "dummeycolor" ? "" : this.data.clsLabelTextColor;

        subelement.className = "labeltext  " + colorTabCustomClass + " " + this.labelStyle;
        subelement.id = "labeltext-" + this.groupIndex;
        if (this.data.arrLabelOpacity[this.groupIndex]) subelement.style.setProperty("opacity", this.data.arrLabelOpacity[this.groupIndex], "");
        if (this.data.arrLabeltexttransform[this.groupIndex]) subelement.style.setProperty("text-transform", this.data.arrLabeltexttransform[this.groupIndex], "");

        subelement.innerText = this.data.labels[this.groupIndex];
        subelement.style.maxWidth = labelMaxW + "px";
        subelement.style.overflow = "hidden";
        subelement.style.maxHeight = labelMaxH + "px";
        subelement.style.fontSize = this.data.ChartFonts.maxLabelFontSize(element) + "px";
        subelement.style.margin = "auto";
        subelement.setAttribute("maxFontSize", labelMaxFontSize);
        subelement.setAttribute("contenteditable", "true");
        subelement.setAttribute("data-dck-selector", "true");
        subelement.setAttribute("data-type", "label");
        subelement.setAttribute("data-specialtype", "label");
        subelement.setAttribute("data-slideid", this.data.slideID);
        subelement.setAttribute("data-id", this.groupIndex);
        subelement.setAttribute("data-prompt-text", "Enter Label");
        subelement.classList.add("transparentBg");
        subelement.style.textAlign = "center";
        element.appendChild(subelement);
        if (this.data._labelTextColor[this.groupIndex]) {
            subelement.style.setProperty("color", this.data._labelTextColor[this.groupIndex], "important");
        }
        if (this.data.arrHyperlinkUrl[this.groupIndex]) {
            subelement.style.pointerEvents = "all";
            element.style.pointerEvents = "all";
            subelement.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
        }
        if (this.vAlign == "left") {
            if (this.data.layout.labelAlterPaddingClass) {
                element.classList.add(this.data.layout.labelAlterPaddingClass);
            }
        } else {
            if (this.data.layout.labelPaddingClass) {
                element.classList.add(this.data.layout.labelPaddingClass);
            }
        }
        this.ChartHelper.setTextChangeListner(subelement);
        this.ChartHelper.adjustFontSize(subelement, 10, labelMaxFontSize, labelMaxFontSize);
        this.ChartHelper.textPositionChangeObserver(subelement);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, labelMaxFontSize, labelMaxFontSize);
        this.ChartHelper.recalculateMaxHeight(subelement);
        this.ChartUtils.enableTextHeighlight(subelement, this.data);
        if (this.vAlign == "left") {
        } else {
            element.style.height = parseFloat(element.style.height) + 15 + "px";
            element.style.maxHeight = parseFloat(element.style.maxHeight) + 15 + "px";
        }

        labelHeight = element.clientHeight;
        this.parentNode.removeChild(element);
    }
    this.valueStyle = this.getColorDetails(this.groupIndex, this.data.ChartFonts.valueOuterColor, this.data.layout.valueColor, "color");
    const groupindex = this.groupIndex;
    let valueMaxH = (this.layoutAreaHeight / 2) * 0.5;
    let valueMaxW = (this.parentWidth / this.voData.seriesLength) * 0.5;
    this.index = 0;
    let valueMaxFontSize = 32;
    let categoryFontDetails = this.ChartUtils.getFontDetails(this.data);
    if (categoryFontDetails) {
        valueMaxFontSize = categoryFontDetails.maxSize;
        minValueFontSize = categoryFontDetails.minSize;
    }
    valueMaxFontSize = this.data.layout.valuefontsize ? this.data.layout.valuefontsize : valueMaxFontSize;
    let animationName = this.groupIndex % 2 == 0 ? "topvalue" : "bottomvalue";
    const element1 = this.ChartHelper.createDivElement({});
    element1.id = "value-text-" + groupindex + "_" + this.index;
    element1.style.minHeight = 10 + "px";
    element1.style.height = valueMaxH + "px";
    element1.style.maxWidth = valueMaxW + "px";
    element1.style.maxHeight = valueMaxH + "px";
    element1.setAttribute("data-animation", animationName);
    if (this.groupIndex % 2 == 0) {
        element1.style.alignItems = "flex-end";
    }
    element1.className = "value topvalue overflow moodanimation";
    element1.style.justifyContent = "center";
    element1.style.paddingLeft = this.data.layout.valuePaddingleft + "px";
    element1.style.paddingRight = this.data.layout.valuePaddingright + "px";
    element1.style.paddingTop = this.data.layout.valuePaddingtop + "px";
    element1.style.paddingBottom = this.data.layout.valuePaddingbottom + "px";
    if (this.data.arrHyperlinkUrl[this.groupIndex]) {
        element1.style.pointerEvents = "all";

        element1.setAttribute("data-navigate-to-slide-on-click", this.voData.arrHyperlinkUrl[this.groupIndex]);
    }

    this.parentNode.appendChild(element1);
    const subelement1 = document.createElement("div");

    let hasInnerValue = this.data.layout.valueInset == "inside";
    this.valueStyle = this.checkMoodColorvalue(this.data.layout.valueColor, this.valueStyle, subelement1, "value", hasInnerValue);
    this.checkMoodLevelColorvalue(this.data.layout.valueColor, subelement1, "value", "color", null, hasInnerValue);

    subelement1.id = "valuetext-" + groupindex + "_" + this.index;
    subelement1.className = "valuetext clsValueTextColor " + this.valueStyle + this.data.ChartFonts.valueThemeClassName;
    (subelement1.innerText = this.data.prefix[groupindex][0] + this.data.valuesDenomination[groupindex][0] + this.data.suffix[groupindex][0]), (subelement1.style.maxWidth = valueMaxW + "px");
    subelement1.style.maxHeight = valueMaxH + "px";
    subelement1.style.fontSize = valueMaxFontSize + "px";
    subelement1.style.justifyContent = "center";
    subelement1.style.visibility = this.voData._valueDisplayFormat[groupindex + " " + this.index];
    subelement1.setAttribute("maxFontSize", valueMaxFontSize);
    subelement1.setAttribute("contenteditable", "true");
    subelement1.setAttribute("data-dck-selector", "true");
    subelement1.setAttribute("data-type", "value");
    subelement1.setAttribute("data-specialtype", "value");
    subelement1.setAttribute("data-id", groupindex + "_" + this.index);
    subelement1.setAttribute("data-slideid", this.data.slideID);
    subelement1.setAttribute("data-graphic-y", 20);
    if (this.data.layout.valueshadow == "true") {
        // let clsItemStyle = this.valueStyle.includes("Accent")?this.valueStyle:this.ChartFonts.graphicColor(groupindex);
        // let clsSendaryStyle = this.data.ChartFonts.valueOuterColor;
        // let colorStyle = this.data.layout.valueTextShdowColor == "item"||this.data.layout.valueTextShdowColor == "theme" ? clsItemStyle : clsSendaryStyle
        // let rgbaValue = this.ChartUtils.createRBGColor(colorStyle, groupindex, this.data.layout.valueTextShdowOpacity);
        if (this.data.layout.valueShadowClass) subelement1.classList.add(this.data.layout.valueShadowClass);
        // subelement1.style.textShadow = this.data.layout.valuetextShadow + " " + rgbaValue;
    }
    if (this.data.baseProperties.type2Percentage && this.data.boolPercentageChart) {
        subelement1.setAttribute("data-dck-selector", "false");
        subelement1.setAttribute("contenteditable", "false");
    }
    // subelement1.dataset.animation = "secondarytext";
    this.maxValueFontSize = [42, 42];
    this.minValueFontSize = [25, 25];
    if (categoryFontDetails) {
        this.maxValueFontSize = [categoryFontDetails.maxSize, categoryFontDetails.maxSize];
        this.minValueFontSize = [categoryFontDetails.minSize, categoryFontDetails.minSize];
    }
    this.maxValueFontSize = this.data.layout.valuefontsize ? [this.data.layout.valuefontsize, this.data.layout.valuefontsize] : this.maxValueFontSize;
    if (this.data.customValueFontSize) {
        this.maxValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
        if (this.minValueFontSize[0] > this.data.customValueFontSize) this.minValueFontSize = [this.data.customValueFontSize, this.data.customValueFontSize];
    }
    element1.appendChild(subelement1);
    if (this.vAlign == "left") {
        if (this.data.layout.valueAlterPaddingClass) {
            element1.classList.add(this.data.layout.valueAlterPaddingClass);
        }
    } else {
        if (this.data.layout.valuePaddingClass) {
            element1.classList.add(this.data.layout.valuePaddingClass);
        }
    }
    this.ChartHelper.setTextChangeListner(subelement1);
    this.calculateMaxFonsize(subelement1, false, valueMaxFontSize, groupindex);
    this.ChartHelper.adjustFontSize(subelement1, this.minValueFontSize[groupindex], valueMaxFontSize, valueMaxFontSize);
    this.ChartHelper.textPositionChangeObserver(subelement1);
    this.ChartUtils.createSpanFormat(subelement1, this.data);
    element1.style.height = "auto";
    this.checkHeight(element1);
    valueHeight = element1.clientHeight;
    this.parentNode.removeChild(element1);
    this.svgSeriesGroup = this.data.SVGUtils.createElement("div");
    this.svgSeriesGroup.style.display = "flex";
    this.svgSeriesGroup.style.alignItems = "center";
    this.svgSeriesGroup.style.justifyContent = "center";
    this.svgSeriesGroup.style.flexWrap = "wrap";
    let layoutAreaWidth = "";
    if (this.vAlign == "left") {
        this.svgSeriesGroup.style.flexFlow = "row";
    } else {
        this.svgSeriesGroup.style.flexFlow = "row-reverse";
    }
    this.svgSeriesGroup.append(element);
    this.svgSeriesGroup.append(element1);
    this.parentNode.append(this.svgSeriesGroup);
    this.svgSeriesGroup.style.width = this.data.SVGUtils.createPercentValue(this.parentWidth, this.labelMaxWidth);

    let elementHeightValue = element.clientHeight;
    let boundary = { width: this.labelMaxWidth, height: element.clientHeight };
    if (this.vAlign == "left") {
        boundary = { x: 0, width: this.labelMaxWidth, height: element.clientHeight };
    } else {
        boundary = { x: this.chartGrapicsAreaX + this.chartGrapicsAreaWidth + this.connectorWidth, width: this.labelMaxWidth, height: element.clientHeight };
    }
    this.parentNode.removeChild(this.svgSeriesGroup);

    this.svgSeriesGroup.style.height = this.data.SVGUtils.createPercentValue(this.parentHeight, boundary.height);

    if (this.vAlign == "left") {
        this.svgSeriesGroup.style.justifyContent = "flex-start";
    }
    let elementY = this.centerY - elementHeightValue / 2;
    //element percentage
    if (this.measurement) {
        this.data.layout.itemLayoutData[this.groupIndex] = {
            bounds: {
                x: boundary.x,
                y: elementY,
                h: boundary.height,
                w: boundary.width,
                cx: this.centerX,
                cy: this.intPathY1,
                pos: this.vAlign,
                griphicWidth: this.chartGrapicsAreaWidth,
                griphicX: this.chartGrapicsAreaX,
                labelcenterpoint: this.centerY,
            },
        };
    }
};
LayoutManagerVerticalDoubleSideConnector.prototype.checkMoodLevelColorvalue = function (valuestyle, element, colorValue = "", type = "", elementtype = null, hasinner = false) {
    if (!hasinner && !valuestyle && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.style[type] = this.data.moodData.theme.textcolormapping[colorValue];
    }
};
LayoutManagerVerticalDoubleSideConnector.prototype.checkMoodColorvalue = function (menuStyle, currentStyle, element, colorValue, hasinner = false) {
    if (!hasinner && !menuStyle && element && element.classList.length > 0 && element.classList.contain(currentStyle) && this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
        element.classList.remove(currentStyle);
    }
    if (!hasinner && !menuStyle) {
        if (this.data.moodData && this.data.moodData.theme && this.data.moodData.theme.textcolormapping && this.data.moodData.theme.textcolormapping[colorValue]) {
            return "dummeycolor";
        } else {
            return "";
        }
    } else {
        return currentStyle;
    }
};

LayoutManagerVerticalDoubleSideConnector.prototype.calculateMaxFonsize = function (subelement, boolmax, fontsize, groupindex) {
    if (groupindex == this.data.seriesLength - 1 && !boolmax) {
        subelement.style.removeProperty("font-size");
        if (this.data.customValueFontClass) {
            subelement.classList.remove(this.data.customValueFontClass);
            subelement.classList.add("n1");
        }
        let dummeyFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.ChartHelper.adjustFontSize(subelement, 20, 18, dummeyFontSize, true);
        this.ChartHelper.adjustFontSizeWidth(subelement, 10, 18, dummeyFontSize);
        let DummeyFinalFontSize = parseFloat(window.getComputedStyle(subelement)["font-size"]);
        this.data.data.setAttribute("valuemaxfontsize", DummeyFinalFontSize);
        subelement.style.fontSize = fontsize + "px";
        if (this.data.customValueFontClass) {
            subelement.classList.add(this.data.customValueFontClass);
            subelement.classList.remove("n1");
        }
    } else {
        this.data.data.removeAttribute("valuemaxfontsize");
    }
};
LayoutManagerVerticalDoubleSideConnector.prototype.checkHeight = function (element) {
    let paddingTop = window.getComputedStyle(element)["padding-top"] ? parseFloat(window.getComputedStyle(element)["padding-top"]) : 0;
    let paddingBottom = window.getComputedStyle(element)["padding-bottom"] ? parseFloat(window.getComputedStyle(element)["padding-bottom"]) : 0;
    let totalPadding = paddingTop + paddingBottom;
    let parentHeight = element.clientHeight;
    let childHeight = element.children[0].clientHeight;
    element.style.minHeight = childHeight + totalPadding + "px";
};
LayoutManagerVerticalDoubleSideConnector.prototype.CreateConnector = function (argParent) {
    let connectorShape = this.data.SVGUtils.createSVGElement("circle");
    this.data.SVGUtils.assignAttributes(connectorShape, {
        class: "labelcircle moodanimation connectorshape",
    });
    let layoutConnetorSvg = this.data.SVGUtils.createSVGElement("svg");
    this.data.SVGUtils.assignAttributes(layoutConnetorSvg, {
        x: "0%",
        y: "0%",
        width: "100%",
        height: "100%",
    });
    argParent.appendChild(layoutConnetorSvg);
    layoutConnetorSvg.appendChild(connectorShape);
    let shapeBounds = this.getShapeBounds(connectorShape);
    if (shapeBounds.width > 0) {
        this.intCircleRadius = shapeBounds.width / 2;
    }
    let x1, y1, x2, y2, x3, y3, x4, y4;
    let StrPath;
    x1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cx;
    y1 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    x2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    y2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cy;
    y3 = this.data.layout.itemLayoutData[this.groupIndex].bounds.labelcenterpoint;
    if (this.data.layout.itemLayoutData[this.groupIndex].bounds.pos == "left") {
        x2 = this.chartGrapicsAreaX;
        x3 = this.chartGrapicsAreaX - this.connectorWidth;
        StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y1 + " L" + x3 + " " + y3;
    } else {
        x2 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cx + this.chartGrapicsAreaWidth / 2;
        x3 = this.data.layout.itemLayoutData[this.groupIndex].bounds.cx + this.chartGrapicsAreaWidth / 2 + this.connectorWidth;
        StrPath = "M" + x1 + " " + y1 + " L" + x2 + " " + y1 + " L" + x3 + " " + y3;
    }

    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    layoutConnetorSvg.appendChild(defsTag);
    let mask = this.data.SVGUtils.createSVGElement("mask");
    this.data.SVGUtils.assignAttributes(mask, {
        id: this.data.slideID + "mask_" + this.groupIndex,
        maskUnits: "userSpaceOnUse",
    });
    defsTag.appendChild(mask);

    let startingBgLine = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(startingBgLine, {
        d: StrPath,
        stroke: "#fff",
        class: "clsstrokestyle",
        fill: "transparent",
        "stroke-dasharray": "6",
        "stroke-width": "2px",
    });
    mask.appendChild(startingBgLine);

    let startingLine = this.data.SVGUtils.createSVGElement("path");
    let strokeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutline" : "bottomlayoutline";
    this.data.SVGUtils.assignAttributes(startingLine, {
        id: "startingLine-" + this.groupIndex + "_" + 0,
        d: StrPath,
        "fill-opacity": "0",
        "stroke-width": "2px",
        "stroke-opacity": "0.5",
        "data-customopacity": "0.5",
        // mask: "url(#"+this.data.slideID+"mask_" + this.groupIndex + ")",
        class: "startingLine tertiary-stroke hdline moodanimation",
        "data-animation": strokeAnimationName,
    });
    layoutConnetorSvg.appendChild(startingLine);

    let shapeAnimationName = this.groupIndex % 2 == 0 ? "toplayoutshape" : "bottomlayoutshape";
    this.data.SVGUtils.assignAttributes(connectorShape, {
        id: "labelcircle-" + this.groupIndex + "_" + 0,
        class: "labelcircle moodanimation connectorshape",
        cx: this.data.SVGUtils.createPercentValue(this.parentWidth, x3),
        cy: this.data.SVGUtils.createPercentValue(this.parentHeight, y3),
        r: this.intCircleRadius,
        "data-animation": shapeAnimationName,
        "data-x": x2,
        "data-y": y1,
    });
    // layoutConnetorSvg.appendChild(connectorShape);
    return layoutConnetorSvg;
};
LayoutManagerVerticalDoubleSideConnector.prototype.getShapeBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    return { width: width, height: height };
};
LayoutManagerVerticalDoubleSideConnector.prototype.longlabelMeasurementCalculation = function (labelW, labelH, fontSize) {
    let objLongLabelMeasurements = {};
    let arrlonglabelMeasurements = [];
    let longlabelWidth = 0;
    let longlabelHeight = 0;
    let longlabelFontSize = 0;
    let length = this.voData.isMultiSeries && !this.voData._baseProperties.isRankingChart ? this.voData._seriesItemLength : this.voData.seriesLength;
    for (let i1 = 0; i1 < length; i1++) {
        objLongLabelMeasurements = this.computeLabelMeasurement(i1, labelW, labelH, fontSize);
        arrlonglabelMeasurements.push(objLongLabelMeasurements);
        if (i1 == 0) {
            longlabelWidth = objLongLabelMeasurements.width;
            longlabelHeight = objLongLabelMeasurements.height;
            longlabelFontSize = objLongLabelMeasurements.fontsize;
        } else {
            longlabelWidth = longlabelWidth < objLongLabelMeasurements.width ? objLongLabelMeasurements.width : longlabelWidth;
            longlabelHeight = longlabelHeight < objLongLabelMeasurements.height ? objLongLabelMeasurements.height : longlabelHeight;
            longlabelFontSize = longlabelFontSize > objLongLabelMeasurements.fontsize ? objLongLabelMeasurements.fontsize : longlabelFontSize;
        }
    }
    objLongLabelMeasurements.width = longlabelWidth;
    objLongLabelMeasurements.height = longlabelHeight;
    objLongLabelMeasurements.fontsize = longlabelFontSize;
    return objLongLabelMeasurements;
};

LayoutManagerVerticalDoubleSideConnector.prototype.computeLabelMeasurement = function (index, argMaxWidth, argMaxHeight, argMaxFontSize = 24, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 380, height: 20 };
};

LayoutManagerVerticalDoubleSideConnector.prototype.computeValueMeasurement = function (argMaxWidth, argMaxHeight, argMaxFontSize = 28, argMinFontSize = 12) {
    return { x: 0, y: 0, width: 110, height: 20 };
};
LayoutManagerVerticalDoubleSideConnector.prototype.getColorDetails = function (groupindex, valueStyle, styleProperty, fillProperty, boolreturnIndex = false) {
    let PropertyIndex = "";
    switch (styleProperty) {
        case "theme":
            PropertyIndex = 0;
            break;
        case "gradient":
            if (fillProperty == "color") {
                return "textgradient";
            } else {
                if (fillProperty == "bgcolor") {
                    PropertyIndex = groupindex;
                }
            }
            break;
        case "dual":
            PropertyIndex = (groupindex + 1) % 2 ? 0 : 1;
            break;
        case "multiple":
            PropertyIndex = groupindex;
            break;
        case "tertiary":
            if (fillProperty == "color") {
                return "clsTextTertiaryColor";
            } else {
                return "clsNodeTertiarybg";
            }
        case "secondary":
            if (fillProperty == "bordercolor") {
                return "secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsSecondaryTextColor";
                } else {
                    return "secondary-bg-color";
                }
            }
            break;
        case "innercolor":
            if (fillProperty == "bordercolor") {
                return "alter-secondary-border-color";
            } else {
                if (fillProperty == "color") {
                    return "clsContrastColor";
                } else {
                    return "alter-secondary-bg-color";
                }
            }
            break;
        default:
            if (!boolreturnIndex) {
                return valueStyle;
            } else {
                PropertyIndex = groupindex;
            }
            break;
    }
    if (boolreturnIndex) {
        return PropertyIndex;
    } else {
        if (fillProperty && (PropertyIndex || PropertyIndex == 0) && styleProperty != "gradient") {
            switch (fillProperty) {
                case "color":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor") && styleProperty == "multiple") {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsAccentColor";
                    }
                    return "clsAccentColor";
                    break;
                case "bgcolor":
                    if (this.data.seriesLength == 2 && this.data.data.getAttribute("data-multicolor")) {
                        let colorValue = groupindex != 0 ? 5 : groupindex;
                        return "clsNodeAccentbg";
                    }
                    if (this.data.multicolor) {
                        return "clsNodeAccentbg";
                    } else {
                        return "clsNodeAccentbg";
                        // return "accent1-bg-color";
                    }
                    break;
            }
        }
    }
};

function hightlightDifference(argparent, baseparent, argprops) {
    this.name = "BaseChart";
    this.gridSize = argprops.gridsize;
    this.chartStyle = argprops.type;
    this.highlightNodes = argprops.highlightNodes;
    this.orginalNodes = argprops.highlightNodes;
    this.grandParent = baseparent;
    this.parentElemnt = argparent;
    this.chartHelper = argprops.chartHelper;
    this.orginalHighValue = false;
    DComponent.call(this, argparent, baseparent, argprops);
}

hightlightDifference.prototype = Object.create(DComponent.prototype);
hightlightDifference.prototype.constructor = hightlightDifference;

hightlightDifference.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        this.doAddGraphicElement();
    }
};

Object.defineProperties(hightlightDifference.prototype, {
    data: {
        get: function () {
            return this.voData;
        },
        set: function (value) {
            this.voData = value;
        },
    },
});

hightlightDifference.prototype.hadValidateData = function () {
    return true;
};

hightlightDifference.prototype.updateBasicData = function () {
    this.xmlData = this.voData.data;
    this.valuedisplayformat = this.voData._valueDisplayFormat;
    this.boolEnable = this.xmlData.getAttribute("axisbaseline") ? true : false;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

hightlightDifference.prototype.doAddGraphicElement = function () {
    if (parseFloat(this.orginalNodes[0]) > parseFloat(this.orginalNodes[1])) {
        this.orginalHighValue = true;
    }
    switch (this.data.highlightDifference.style) {
        case "style1":
            if (this.chartStyle == "column") {
                this.createColumnLineStyle();
            } else {
                this.createBarLineStyle();
            }
            break;
        case "style2":
            this.createBorderStyles();
            break;
    }
};
hightlightDifference.prototype.createColumnLineStyle = function (argparent, containerHeight, element) {
    this.style = this.data.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = "3";
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.gradient = this.style.bgFillType == "gradient";
    this.pointshape = this.style.pointshape == "true";
    this.dashedarray = this.style.dashed;
    this.state.height -= 40;
    let svgElement = document.createElement("div");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "highlightseries-common",
        class: "commonitem",
        x: 0,
        y: 0,
        style: "width:100%;height:100%;",
    });
    this.parentElemnt.appendChild(svgElement);

    ///
    let seriesItemLength = this.voData.seriesItemLength;

    for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
        let svgSeiesItem = document.createElement("div");
        this.data.SVGUtils.assignAttributes(svgSeiesItem, {
            id: "highlightsvgseriesitem-" + seriesItemIndex,
            class: "highlightsvgseriesitem",
            style: "width:100%;height:100%;position:relative;z-index:15;pointer-events:none;",
            //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
        });
        svgElement.appendChild(svgSeiesItem);

        if (this.dropshadow) {
            this.createDropShadow(svgElement);
            this.data.SVGUtils.assignAttributes(svgSeiesItem, {
                filter: "url(#dropshadow)",
            });
        }
        for (let seriesIndex = 0; seriesIndex < 1; seriesIndex++) {
            let FirstPoint = this.highlightNodes[0];
            let secondPoint = this.highlightNodes[1];
            let firstPointValue = this.data.values[FirstPoint][0];
            let secondPointValue = this.data.values[secondPoint][0];
            let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
            this.creatColumnHighlightNode(svgSeiesItem, FirstPoint, secondPoint, firstValueHigh, seriesIndex, this.data.seriesLength);
        }
    }
};
hightlightDifference.prototype.creatColumnHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let grahicNodes = this.grandParent.querySelectorAll(".chartgraphic");
    let valuNode = this.grandParent.querySelectorAll(".value");
    let seriesElement = this.grandParent.querySelectorAll(".series");
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][0], index);
    let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint].parentNode : "";
    let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint].parentNode : "";
    let firstSeries = seriesElement.length > FirstPoint ? seriesElement[FirstPoint] : "";
    let secondSeries = seriesElement.length > secondPoint ? seriesElement[secondPoint] : "";
    let firstSeriesItemElements = firstSeries.querySelector(".bottomseriesitem");
    let secondSeriesItemElements = secondSeries.querySelector(".bottomseriesitem");

    let hasValue = false;
    let firstTopGap = 0;
    let secondTopGap = 0;
    let firstargChildNodeTop = 0;
    let secondChildNodeTop = 0;
    if (this.data.layout.valueInset != "inside" && this.data.layout.valueVPosition == "top" && valuNode.length > 0 && valuNode[0].style.display != "none") {
        firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
        secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
        hasValue = true;
        // firstTopGap = 30;
        // secondTopGap = 30;
    } else {
        if (this.data.layout.valueInset == "inside") {
            if (valuNode.length > FirstPoint && valuNode[FirstPoint] && valuNode[FirstPoint].dataset.outerside == "true") {
                firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
                // firstTopGap = 30;
            } else {
                firstargChildNodeTop = grahicNodes[FirstPoint].offsetTop;
            }
            if (valuNode.length > secondPoint && valuNode[secondPoint].dataset.outerside == "true") {
                secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
                // secondTopGap = 30;
            } else {
                secondChildNodeTop = grahicNodes[secondPoint].offsetTop;
            }
        }
    }
    let X1 = 0;
    let Y1 = 0;
    let X2 = 0;
    let Y2 = 0;
    let X3 = 0;
    let Y3 = 0;
    let X4 = 0;
    let Y4 = 0;
    let fisrtNodeLeft = firstSeries.offsetLeft + firstargParentNode.offsetLeft;
    let fisrtNodeRight = firstargParentNode.offsetRight;
    let fisrtNodeWidth = firstargParentNode.clientWidth;
    let fisrtNodeTop = firstargParentNode.offsetTop + firstTopGap + firstargChildNodeTop;
    let fisrtNodeHeight = firstargParentNode.clientHeight;
    let secondNodeLeft = secondSeries.offsetLeft + secondtargParentNode.offsetLeft;
    let secondNodeRight = secondtargParentNode.offsetRight;
    let secondNodeWidth = secondtargParentNode.clientWidth;
    let secondNodeTop = secondtargParentNode.offsetTop + secondTopGap + secondChildNodeTop;
    let secondNodeHeight = secondtargParentNode.clientHeight;
    let topspace = 20;
    let elementGap = 7;
    let fistNode = index == 0;
    let secondNode = index == length - 1;
    let hasFlip = this.data.chartFlip;
    if (firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y1 = hasFlip ? fisrtNodeTop + firstargParentNode.clientHeight + elementGap : fisrtNodeTop - elementGap;
        X2 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y2 = hasFlip ? fisrtNodeTop + firstargParentNode.clientHeight + topspace : fisrtNodeTop - topspace;
        X3 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y3 = hasFlip ? fisrtNodeTop + firstargParentNode.clientHeight + topspace : fisrtNodeTop - topspace;
        X4 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y4 = hasFlip ? secondNodeTop + secondtargParentNode.clientHeight + elementGap : secondNodeTop - elementGap;
    }

    if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y1 = hasFlip ? fisrtNodeTop + firstargParentNode.clientHeight + elementGap : fisrtNodeTop - elementGap;
        X2 = fistNode ? fisrtNodeLeft + fisrtNodeWidth / 2 : fisrtNodeLeft + fisrtNodeWidth * 0.6;
        Y2 = hasFlip ? secondNodeTop + secondtargParentNode.clientHeight + topspace : secondNodeTop - topspace;
        X3 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y3 = hasFlip ? secondNodeTop + secondtargParentNode.clientHeight + topspace : secondNodeTop - topspace;
        X4 = secondNode ? secondNodeLeft + secondNodeWidth / 2 : secondNodeLeft + secondNodeWidth * 0.4;
        Y4 = hasFlip ? secondNodeTop + secondtargParentNode.clientHeight + elementGap : secondNodeTop - elementGap;
    }
    if (this.data.values[secondPoint][0] < 0) {
        Y4 = secondSeriesItemElements.offsetTop - topspace;
    }
    if (this.data.values[FirstPoint][0] < 0) {
        Y1 = firstSeriesItemElements.offsetTop - topspace;
    }
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + X1 + "," + Y1 + " L" + X2 + "," + Y2 + " L" + X3 + "," + Y3 + " L" + X4 + "," + Y4;
    let secondaryPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    // if (this.data.HighlightArrowState == "start") {
    //     strPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    // }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "tertiary-stroke  moodanimation hdline",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode, strPath);
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");

        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.data.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    callout.style.maxWidth = (X3 - X2) * 0.8 + "px";
    let calloutWidth = callout.clientWidth;
    let calloutHeight = callout.clientHeight;
    callout.style.top = Y2 - calloutHeight / 2 + "px";
    callout.style.left = X3 > X2 ? X2 + (X3 - X2 - calloutWidth) / 2 + "px" : X3 + (X2 - X3 - calloutWidth) / 2 + "px";
};
hightlightDifference.prototype.setMaxHeight = function (childNode) {
    let lineHeight = window.getComputedStyle(childNode) && window.getComputedStyle(childNode)["line-height"] ? parseFloat(window.getComputedStyle(childNode)["line-height"]) : 0;
    let lineCount = 1;
    let maxHeight = lineHeight * lineCount;
    childNode.style.maxHeight = maxHeight + "px";
    childNode.style.overflow = "hidden";
};
hightlightDifference.prototype.createArrowHeaderChild = function (svgNode) {
    if (true) {
        let arrowHeader = "";
        let type = "arrow";
        switch (type) {
            case "arrow":
                arrowHeader = this.data.SVGUtils.createSVGElement("path");
                if (arrowHeader) svgNode.appendChild(arrowHeader);
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    d: "M0,0 L0,15 L10,7.5 z",
                    class: "tertiary-fill hdarrow",
                });
                arrowHeader.style.transform = "translate(-7.5px,-7.5px)";
                let bounds = this.getArrowBounds(arrowHeader);
                if (bounds) {
                    let strBounds = "M" + bounds.x1 + "," + bounds.y1 + " L" + bounds.x2 + "," + bounds.y2 + " L" + bounds.x3 + "," + bounds.y3;
                    this.data.SVGUtils.assignAttributes(arrowHeader, {
                        d: strBounds,
                    });
                    arrowHeader.style.transform = "translate(-" + bounds.y3 + "px,-" + bounds.y3 + "px)";
                }
                return arrowHeader;
                break;
            case "circle":
                arrowHeader = this.data.SVGUtils.createSVGElement("circle");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    cx: "5",
                    cy: "5",
                    r: "10",
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translateY(-5px)";
                break;
            case "square":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 30,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translate(-15px,-15px)";
                break;
            case "rect":
                arrowHeader = this.data.SVGUtils.createSVGElement("rect");
                this.data.SVGUtils.assignAttributes(arrowHeader, {
                    width: 60,
                    height: 30,
                    x: 0,
                    y: 0,
                    class: "clsAccentfill",
                });
                arrowHeader.style.transform = "translateY(-15px)";
                break;
            default:
                return null;
                break;
        }
    }
};
hightlightDifference.prototype.createBarLineStyle = function (argparent, containerHeight, element) {
    this.style = this.data.ChartHelper.getStylesdata(this.data.data);
    this.linethickness = "3";
    this.dropshadow = this.style.dropShadow;
    this.chart = this.style.chartType;
    this.gradient = this.style.bgFillType == "gradient";
    this.pointshape = this.style.pointshape == "true";
    this.dashedarray = this.style.dashed;
    let bgOutsideGap = 30;
    if (this.data.chartFlip) {
        bgOutsideGap = -30;
    }
    this.state.height -= 40;
    let svgElement = document.createElement("div");
    this.data.SVGUtils.assignAttributes(svgElement, {
        id: "highlightseries-common",
        class: "commonitem",
        x: 0,
        y: 0,
        style: "width:100%;height:100%;",
    });
    this.parentElemnt.appendChild(svgElement);

    ///
    let seriesItemLength = this.voData.seriesItemLength;
    for (let seriesItemIndex = 0; seriesItemIndex < seriesItemLength; seriesItemIndex++) {
        let svgSeiesItem = document.createElement("div");
        this.data.SVGUtils.assignAttributes(svgSeiesItem, {
            id: "highlightsvgseriesitem-" + seriesItemIndex,
            class: "highlightsvgseriesitem",
            style: "width:100%;height:100%;position:relative;z-index:15;pointer-events:none;",
            //  viewBox: 0 + " " + 0 + " " + this.width + " " + this.height
        });
        svgElement.appendChild(svgSeiesItem);

        if (this.dropshadow) {
            this.createDropShadow(svgElement);
            this.data.SVGUtils.assignAttributes(svgSeiesItem, {
                filter: "url(#dropshadow)",
            });
        }
        for (let seriesIndex = 0; seriesIndex < 1; seriesIndex++) {
            let FirstPoint = this.highlightNodes[0];
            let secondPoint = this.highlightNodes[1];
            let firstPointValue = this.data.values[FirstPoint][0];
            let secondPointValue = this.data.values[secondPoint][0];
            let firstValueHigh = parseFloat(firstPointValue) > parseFloat(secondPointValue);
            this.creatBarHighlightNode(svgSeiesItem, FirstPoint, secondPoint, firstValueHigh, seriesIndex, this.data.seriesLength);
        }
    }
};
hightlightDifference.prototype.getComputedLeft = function (firstargParentNode, classname) {
    if (firstargParentNode) {
        let item = { x: 0, y: 0 };
        var dataType = firstargParentNode.classList || ["none"];
        let itemParent = firstargParentNode;
        while (itemParent && classname && !dataType.contains(classname)) {
            item.x = itemParent.offsetLeft + item.x;
            item.y = itemParent.offsetTop + item.y;
            itemParent = itemParent.parentNode;
            dataType = itemParent && itemParent.classList ? itemParent.classList : ["none"];
        }
        return item;
    }
};
hightlightDifference.prototype.creatBarHighlightNode = function (argParent, FirstPoint, secondPoint, firstValueHigh, index, length) {
    let grahicNodes = this.grandParent.querySelectorAll(".chartgraphic");
    let valuNode = this.grandParent.querySelectorAll(".value");
    let seriesElement = this.grandParent.querySelectorAll(".series");
    let seriesitemCondent = this.grandParent.querySelectorAll(".seriesitemcond");
    let enableHeader = this.data.layout.labelHeaderPosition == "top" || this.data.layout.valueHeaderPosition == "top" || this.data.layout.itemHeaderPosition == "top";
    let titleHeight = 0;

    if (enableHeader) {
        let titleNode = this.grandParent.querySelector(".header");
        // if(titleNode)titleHeight = titleNode.clientHeight;
    }
    let differenceValue = this.createHdDisplayFormat(this.data.values[FirstPoint][0], this.data.values[secondPoint][0], index);
    let firstargParentNode = grahicNodes.length > FirstPoint ? grahicNodes[FirstPoint] : "";
    let secondtargParentNode = grahicNodes.length > secondPoint ? grahicNodes[secondPoint] : "";
    let firstSeries = seriesElement.length > FirstPoint ? seriesElement[FirstPoint] : "";
    let secondSeries = seriesElement.length > secondPoint ? seriesElement[secondPoint] : "";
    let firstSeriesItemContent = seriesitemCondent.length > FirstPoint ? seriesitemCondent[FirstPoint] : "";
    let secondSeriesItemContent = seriesitemCondent.length > secondPoint ? seriesitemCondent[secondPoint] : "";
    let baseFirstSeriesItemContent = firstSeriesItemContent ? firstSeriesItemContent.querySelector(".baseseriesitem") : "";
    let baseSecondSeriesItemContent = secondSeriesItemContent ? secondSeriesItemContent.querySelector(".baseseriesitem") : "";
    let hasValue = false;
    if (this.data.layout.valueInset != "inside" && this.data.layout.valueHPosition == "right" && valuNode.length > 0 && valuNode[0].style.display != "none") {
        firstargParentNode = valuNode.length > FirstPoint ? valuNode[FirstPoint] : firstargParentNode;
        secondtargParentNode = valuNode.length > secondPoint ? valuNode[secondPoint] : secondtargParentNode;
        hasValue = true;
    }
    let X1 = 0;
    let Y1 = 0;
    let X2 = 0;
    let Y2 = 0;
    let X3 = 0;
    let Y3 = 0;
    let X4 = 0;
    let Y4 = 0;
    let firstSeriesContentLeft = 0;
    let secondSeriesContentLeft = 0;
    if (baseFirstSeriesItemContent) {
        firstSeriesContentLeft = baseFirstSeriesItemContent.offsetLeft;
    }
    if (baseSecondSeriesItemContent) {
        secondSeriesContentLeft = baseSecondSeriesItemContent.offsetLeft;
    }
    let firstSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? firstSeriesItemContent.offsetLeft : 0;
    let secondSeriesItemContentLeft = this.data.layout.valueInset != "bgoutside" ? secondSeriesItemContent.offsetLeft : 0;
    let fisrtNodeLeft = firstSeries.offsetLeft + firstSeriesItemContentLeft + firstargParentNode.offsetLeft + firstargParentNode.parentNode.offsetLeft;
    if (this.data.chartFlip) fisrtNodeLeft = firstSeries.offsetLeft + this.getComputedLeft(firstargParentNode, "seriesitemcond").x; //firstSeriesItemContentLeft + firstargParentNode.offsetLeft+firstargParentNode.parentNode.offsetLeft;
    let fisrtNodeRight = firstargParentNode.offsetRight;
    let fisrtNodeWidth = firstargParentNode.clientWidth;
    let fisrtNodeTop = firstSeries.offsetTop;
    if (this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true") {
        fisrtNodeTop = firstSeries.offsetTop + firstargParentNode.parentNode.offsetTop;
    }
    let fisrtNodeHeight = firstargParentNode.clientHeight;
    let secondNodeLeft = secondSeries.offsetLeft + secondSeriesItemContentLeft + secondtargParentNode.offsetLeft + secondtargParentNode.parentNode.offsetLeft;
    if (this.data.chartFlip) secondNodeLeft = secondSeries.offsetLeft + this.getComputedLeft(secondtargParentNode, "seriesitemcond").x;
    let secondNodeRight = secondtargParentNode.offsetRight;
    let secondNodeWidth = secondtargParentNode.clientWidth;
    let secondNodeTop = secondSeries.offsetTop;
    if (this.data.layout.labelItemBased == "true" || this.data.layout.valueItemBased == "true") {
        secondNodeTop = secondSeries.offsetTop + secondtargParentNode.parentNode.offsetTop;
    }
    let secondNodeHeight = secondtargParentNode.clientHeight;

    let topspace = 50;
    let padding = 5;
    let indualGap = 6;
    let firstGap = fisrtNodeHeight * 0.2 < indualGap ? fisrtNodeHeight * 0.5 + indualGap : fisrtNodeHeight * 0.6;
    let secondGap = secondNodeHeight * 0.2 < indualGap ? secondNodeHeight * 0.5 - indualGap : secondNodeHeight * 0.4;
    let firstNode = index == 0;
    let secondNode = index == length - 1;
    let hasFlip = this.data.chartFlip;
    if (firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = hasFlip ? fisrtNodeLeft - padding : fisrtNodeLeft + fisrtNodeWidth + padding;
        Y1 = firstNode ? fisrtNodeTop + titleHeight + fisrtNodeHeight / 2 : fisrtNodeTop + titleHeight + firstGap;
        X2 = hasFlip ? fisrtNodeLeft - topspace : fisrtNodeLeft + fisrtNodeWidth + topspace;
        Y2 = Y1;
        X3 = hasFlip ? fisrtNodeLeft - topspace : fisrtNodeLeft + fisrtNodeWidth + topspace;
        Y3 = secondNode ? secondNodeTop + titleHeight + secondNodeHeight / 2 : secondNodeTop + titleHeight + secondGap;
        X4 = hasFlip ? secondNodeLeft - padding : secondNodeLeft + secondNodeWidth + padding;
        Y4 = secondNode ? secondNodeTop + titleHeight + secondNodeHeight / 2 : secondNodeTop + titleHeight + secondGap;
    }
    if (!firstValueHigh && firstargParentNode && secondtargParentNode) {
        X1 = hasFlip ? fisrtNodeLeft - padding : fisrtNodeLeft + fisrtNodeWidth + padding;
        Y1 = firstNode ? fisrtNodeTop + titleHeight + fisrtNodeHeight / 2 : fisrtNodeTop + titleHeight + firstGap;
        X2 = hasFlip ? secondNodeLeft - topspace : secondNodeLeft + secondNodeWidth + topspace;
        Y2 = Y1;
        X3 = hasFlip ? secondNodeLeft - topspace : secondNodeLeft + secondNodeWidth + topspace;
        Y3 = secondNode ? secondNodeTop + titleHeight + secondNodeHeight / 2 : secondNodeTop + titleHeight + secondGap;
        X4 = hasFlip ? secondNodeLeft - padding : secondNodeLeft + secondNodeWidth + padding;
        Y4 = secondNode ? secondNodeTop + titleHeight + secondNodeHeight / 2 : secondNodeTop + titleHeight + secondGap;
    }
    let svgNode = this.data.SVGUtils.createSVGElement("svg");
    svgNode.style.position = "absolute";
    svgNode.classList.add("indualhighlightsvgNode");
    argParent.appendChild(svgNode);
    let strPath = "M" + X1 + "," + Y1 + " L" + X2 + "," + Y2 + " L" + X3 + "," + Y3 + " L" + X4 + "," + Y4;
    let secondaryPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    // if (this.data.HighlightArrowState == "start") {
    //     strPath = "M" + X4 + "," + Y4 + " L" + X3 + "," + Y3 + " L" + X2 + "," + Y2 + " L" + X1 + "," + Y1;
    // }

    let linePath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(linePath, {
        d: strPath,
        stroke: "red",
        class: "tertiary-stroke  moodanimation hdline",
        fill: "none",
        "stroke-width": "2",
        "data-animation": "indualhdline",
    });
    svgNode.appendChild(linePath);
    let arrowHead = this.createArrowHeader(svgNode, strPath);
    let callout = this.createCallout();
    callout.children[0].innerHTML = differenceValue;
    argParent.appendChild(callout);
    if (this.data.indualHdFormat == "customlabel") {
        callout.children[0].setAttribute("contenteditable", "true");
        callout.children[0].setAttribute("data-dck-selector", "true");
        callout.children[0].setAttribute("data-type", "hdtext");
        callout.children[0].setAttribute("data-prompt-text", "10-15");
        callout.children[0].setAttribute("data-index", index + "_" + 0);
        callout.children[0].setAttribute("id", "hdtext" + index);
        callout.children[0].style.pointerEvents = "all";
        this.data.ChartHelper.setTextChangeListner(callout.children[0]);
        this.setMaxHeight(callout.children[0]);
    }
    callout.style.maxHeight = (Y3 - Y2) * 0.8 + "px";
    let calloutWidth = callout.clientWidth;
    let calloutHeight = callout.clientHeight;
    callout.style.top = Y3 > Y2 ? Y2 + (Y3 - Y2 - calloutHeight) / 2 + "px" : Y2 + (Y2 - Y3 - calloutHeight) / 2 + "px";
    callout.style.left = X3 - calloutWidth / 2 + "px";
};

hightlightDifference.prototype.createSvgPath = function (argparent) {
    let defsTag = this.data.SVGUtils.createSVGElement("defs");
    argparent.appendChild(defsTag);
    let markerTag = this.data.SVGUtils.createSVGElement("marker");
    defsTag.appendChild(markerTag);
    this.data.SVGUtils.assignAttributes(markerTag, {
        id: "arrow",
        refX: "4",
        "data-animation": "highlightdiffarrow",
        refY: "3.5",
        markerWidth: "7",
        markerHeight: "7",
        orient: "auto-start-reverse",
    });
    if (this.data.darkBg) {
        this.data.SVGUtils.assignAttributes(markerTag, {
            class: "alter-secondary-stroke moodanimation",
        });
    } else {
        this.data.SVGUtils.assignAttributes(markerTag, {
            class: "secondary-fill moodanimation",
        });
    }
    let Markerpath = this.data.SVGUtils.createSVGElement("path");
    this.data.SVGUtils.assignAttributes(Markerpath, {
        d: "M 0 0 L 7 3.5 L 0 7 z",
    });
    markerTag.appendChild(Markerpath);
};
hightlightDifference.prototype.getBoundArea = function (eSeries, elementDiv, alignment) {
    let viewPortBounds = eSeries.getBoundingClientRect();
    let targetBounds = elementDiv.getBoundingClientRect();
    let item = { x: 0, y: 0 };
    viewPortBounds.x = parseFloat(window.getComputedStyle(eSeries)["x"].split("px")[0]);
    viewPortBounds.y = parseFloat(window.getComputedStyle(eSeries)["y"].split("px")[0]);
    viewPortBounds.width = parseFloat(window.getComputedStyle(eSeries)["width"].split("px")[0]);
    viewPortBounds.height = parseFloat(window.getComputedStyle(eSeries)["height"].split("px")[0]);
    targetBounds.width = parseFloat(window.getComputedStyle(elementDiv)["width"].split("px")[0]);
    targetBounds.height = parseFloat(window.getComputedStyle(elementDiv)["height"].split("px")[0]);
    let itemParent = elementDiv;
    let boolenableposition = false;
    while (itemParent && !itemParent.className.includes("GRAPHIC")) {
        item.x = itemParent.offsetLeft + item.x;
        item.y = itemParent.offsetTop + item.y;
        if (boolenableposition) {
            itemParent.style.position = "relative";
            itemParent.style.top = "0";
            boolenableposition = false;
        }
        itemParent = itemParent.offsetParent;
        if (alignment == "horizontal") {
            itemParent.classList.forEach(function (item) {
                if (item == "baselineleftparent") {
                    boolenableposition = true;
                    itemParent.style.position = "absolute";
                    itemParent.style.top = "0";
                }
            });
        }
    }
    targetBounds.x = item.x;
    targetBounds.y = item.y;
    return { viewPortBounds: viewPortBounds, targetBounds: targetBounds };
};
hightlightDifference.prototype.createArrowHeader = function (svgElement, strPath) {
    let reversePath = strPath;
    if (this.data.HighlightArrowState == "start") {
        reversePath = this.createReversePath(strPath);
    }
    let arrowHeader = this.createArrowHeaderChild(svgElement);
    arrowHeader.style.offsetPath = "path('" + reversePath + "')";
    arrowHeader.style.offsetDistance = "100%";
    arrowHeader.classList.add("moodanimation");
    arrowHeader.dataset.animation = "indualhdarrowhead";
    this.data.SVGUtils.assignAttributes(arrowHeader, {
        "data-customsmovey": "-5px",
        "data-customsmovex": "-5px",
        "data-customsmoveendy": "-5px",
        "data-customsmoveendx": "-5px",
        "data-customorgin": "null",
    });
    if (this.data.HighlightArrowState == "both") {
        let endreversePath = this.createReversePath(reversePath);
        let arrowHead1 = this.createArrowHeaderChild(svgElement);
        arrowHead1.style.offsetPath = "path('" + endreversePath + "')";
        arrowHead1.style.offsetDistance = "100%";
        arrowHead1.classList.add("moodanimation");
        arrowHead1.classList.add("arrowhead");
    }
};
hightlightDifference.prototype.getArrowBounds = function (arrowHeader) {
    let width = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["width"] ? parseFloat(window.getComputedStyle(arrowHeader)["width"]) : "";
    let height = window.getComputedStyle(arrowHeader) && window.getComputedStyle(arrowHeader)["height"] ? parseFloat(window.getComputedStyle(arrowHeader)["height"]) : "";
    if (width && height) {
        let x1 = 0;
        let y1 = 0;
        let x2 = 0;
        let y2 = width;
        let x3 = height;
        let y3 = width * 0.5;
        return { x1: x1, y1: y1, x2: x2, y2: y2, x3: x3, y3: y3 };
    } else {
        return null;
    }
};
hightlightDifference.prototype.createReversePath = function (strPath) {
    let arrPoints = strPath.split("L");
    let firstPoint = arrPoints[0].split("M")[1];
    arrPoints[0] = firstPoint;
    let dummeyStrPath = "";
    for (let p1 = arrPoints.length - 1; p1 >= 0; p1--) {
        if (p1 == arrPoints.length - 1) {
            dummeyStrPath = "M" + arrPoints[p1];
        } else {
            dummeyStrPath += "L" + arrPoints[p1];
        }
    }
    return dummeyStrPath;
};
hightlightDifference.prototype.createCallout = function () {
    let calloutDiv = document.createElement("div");
    calloutDiv.className = "indualhighlightcallout hdcallout moodanimation";
    calloutDiv.dataset.animation = "indualhdcalloutdiv";
    let textCallout = document.createElement("div");
    textCallout.className = "indualhighlighttextcallout " + this.data.ChartFonts.hdClassName;
    calloutDiv.appendChild(textCallout);
    return calloutDiv;
};
hightlightDifference.prototype.createHdDisplayFormat = function (value1, value2, index) {
    let TextValue = "";
    switch (this.data.indualHdFormat) {
        case "number":
            TextValue = parseInt(value1 - value2);
            let elementMaxValue = value1 > value2 ? -TextValue : -TextValue;
            return this.data.HighlightArrowState == "start" ? -elementMaxValue : elementMaxValue;
            break;
        case "percentage":
            let maxValue = parseFloat(value1);
            let minValue = parseFloat(value2);
            let differnceValue = minValue - maxValue;
            let maxPercentage = 100 / maxValue;
            let percentage = maxPercentage * differnceValue;
            if (maxValue < 1) {
                percentage = 100;
            }
            let deciamlCount = percentage.toString().split(".").length > 1 ? percentage.toString().split(".")[1].length : 0;
            if (deciamlCount > 2) {
                return percentage.toFixed(2) + "%";
            } else {
                return percentage + "%";
            }
            break;
        case "fraction":
            let fractionvalue = "";
            let numValue1 = value1 > value2 ? value1 : value2;
            let numValue2 = value1 < value2 ? value1 : value2;
            let countNode = 0;
            for (var i1 = Math.max(numValue1, numValue2); i1 > 1; i1--) {
                if (numValue1 % i1 == 0 && numValue2 % i1 == 0) {
                    numValue1 /= i1;
                    numValue2 /= i1;
                }
                if (countNode > 400) {
                    break;
                }
                countNode++;
            }
            if (numValue2 === 1) {
                fractionvalue = numValue1.toString();
            } else {
                fractionvalue = numValue1.toString() + "/" + numValue2.toString();
            }
            return fractionvalue;

            break;
        case "customlabel":
            return this.data.indualHdFormatText[index][0];
            break;
        case "multiplevalue":
            let percentage1 = ((100 / value1) * value2) / 100;
            let deciamlCount2 = percentage1.toString().split(".").length > 1 ? percentage1.toString().split(".")[1].length : 0;
            if (deciamlCount2 > 2) {
                return percentage1.toFixed(2) + "x";
            } else {
                return percentage1 + "x";
            }
            break;
    }
};

function AxisBaseLine(argparent, argprops) {
    this.name = "BaseChart";
    this.gridSize = argprops.gridsize;
    this.type = argprops.type;
    this.ChartHelper = argprops.chartHelper;
    DComponent.call(this, argparent, argprops);
}
AxisBaseLine.prototype = Object.create(DComponent.prototype);
AxisBaseLine.prototype.constructor = AxisBaseLine;

AxisBaseLine.prototype.doComputation = function () {
    if (this.isvalid) {
        this.clear();
        this.updateBasicData();
        if (this.hadValidateData) {
            this.doAddGraphicElement();
        }
    }
};
Object.defineProperties(AxisBaseLine.prototype, {
    data: {
        get: function () {
            return this.voData;
        },
        set: function (value) {
            this.voData = value;
        },
    },
});
AxisBaseLine.prototype.hadValidateData = function () {
    return true;
};

AxisBaseLine.prototype.updateBasicData = function () {
    this.xmlData = this.voData.data;
    this.boolEnable = (this.xmlData.getAttribute("axisbaseline") || this.xmlData.getAttribute("data-baseline")) && !this.voData._forcedisableBaseline && this.data.baseProperties.baseline ? true : false;
    this.viewport = { x: 0, y: 0, width: this.state.width, height: this.state.height };
};

AxisBaseLine.prototype.doAddGraphicElement = function () {
    if (this.boolEnable) {
        let baseLineBottomValue = this.xmlData.getAttribute("baseline_bottom_value") ? this.xmlData.getAttribute("baseline_bottom_value") : this.data.highvaluebreak ? this.data.secondPositiveHighValue / 2 : this.voData.rangeTotal / 2;
        if (!this.xmlData.getAttribute("baseline_bottom_value")) {
            this.xmlData.setAttribute("baseline_bottom_value", baseLineBottomValue);
        }
        baseLineBottomValue = baseLineBottomValue > this.voData.rangeTotal ? this.voData.rangeTotal : baseLineBottomValue;
        let endValue = baseLineBottomValue >= this.voData.rangeTotal ? true : false;
        let arrBottom = baseLineBottomValue ? baseLineBottomValue.toString().split(",") : [];

        let baseLineLeftValue = this.xmlData.getAttribute("baseline_left_value") ? this.xmlData.getAttribute("baseline_left_value") : "";
        baseLineLeftValue = baseLineLeftValue && baseLineLeftValue > this.voData.rangeTotal ? this.voData.rangeTotal - 4 : baseLineLeftValue;

        let arrBottomText = this.xmlData.getAttribute("baseline_bottom_text") ? this.xmlData.getAttribute("baseline_bottom_text").split(",") : ["Enter Text"];
        this.xmlData.setAttribute("baseline_bottom_text", arrBottomText[0]);
        let baseelementDiv = this.parent.parentElement.parentElement.parentElement.parentElement;
        let parent = baseelementDiv.firstChild;
        if (this.type != "horizontal") {
            let parentElementDiv = baseelementDiv.querySelectorAll("#ELEMENT_DIV");
            if (parentElementDiv.length > 1) {
                parent = this.ChartHelper.getElementDiv(this.parent)?.firstChild;
            } else {
                parent = parentElementDiv[0].firstChild;
            }
        }
        let seriesName = this.type == "horizontal" ? "seriesitemcond" : "baseseries";
        let eSeries = baseelementDiv.getElementsByClassName(seriesName);
        let elementvalueDiv = baseelementDiv.querySelector("#ELEMENT_DIV");
        if (elementvalueDiv) {
            elementvalueDiv.style.position = "absolute";
            elementvalueDiv.style.top = "0";
        } else {
            baseelementDiv.style.position = "absolute";
            baseelementDiv.style.top = "0";
        }

        let alignment;
        let topPadding = 7;
        let baseLineValueSize = this.voData._customProperties.showYAxisGrid ? 70 : 80;
        if (this.type == "vertical") {
            arrBottom = [];
        }
        for (let i1 = 0; i1 < arrBottom.length; i1++) {
            const parentWidth = this.viewport.width;
            const baseGraphicWidth = parentWidth;
            const baseGraphicWidthPercentage = baseGraphicWidth / parentWidth;
            let differncePercentage = (this.voData.rangePositive * 0.8) / this.data.secondPositiveHighValue;
            let dummeyValue = parseInt(arrBottom[i1]);
            if (this.data.highvaluebreak) {
                dummeyValue = parseInt(arrBottom[i1]) * differncePercentage;
            }
            const graphicWidthPercentage = baseGraphicWidthPercentage * (dummeyValue / this.voData.rangeTotal);
            let parentDiv = document.createElement("div");
            parentDiv.className = "baselinebottomparent accent1 clsMultiColorParent";
            parentDiv.style.setProperty("--customItemColor", "var(--item" + 1 + "-color-rgb)");
            parentDiv.style.setProperty("--customContrastColor", "var(--contrast" + 1 + "-rgb)");
            parentDiv.style.width = this.viewport.width + "px";
            parentDiv.style.height = this.viewport.height + "px";
            this.parent.appendChild(parentDiv);

            let elementDiv = document.createElement("div");
            elementDiv.className = "baselinebottom moodanimation";
            if (this.data.chartFlip) {
                elementDiv.style.right = this.viewport.width * graphicWidthPercentage - 2 + "px";
            } else {
                elementDiv.style.left = this.viewport.width * graphicWidthPercentage - 2 + "px";
            }
            elementDiv.style.width = "2px"; //this.viewport.width * graphicWidthPercentage + "px";
            elementDiv.style.height = this.viewport.height + "px";
            elementDiv.dataset.animation = "baselineline";
            if (this.voData.darkBg) {
                elementDiv.style.borderColor = "rgba(var(--alter-secondary-color-rgb),1)";
            }
            parentDiv.appendChild(elementDiv);

            let baseLineValue = document.createElement("div");
            baseLineValue.id = "baseline_bottom-value";
            if (this.voData.darkBg) {
                baseLineValue.className = "baselinevalue baselinebottomValue moodanimation n1 clsContrastColor";
            } else {
                baseLineValue.className = "baselinevalue baselinebottomValue moodanimation n1 clsSecondaryTextColor";
            }
            if (this.data.chartFlip) {
                baseLineValue.style.right = this.viewport.width * graphicWidthPercentage - 2 - 20 + "px";
            } else {
                baseLineValue.style.left = this.viewport.width * graphicWidthPercentage - 2 - 20 + "px";
            }
            baseLineValue.style.width = "auto"; //this.viewport.width * graphicWidthPercentage + "px";
            if (endValue) {
                baseLineValue.style.justifyContent = "center";
                baseLineValue.style.width = "80px"; //this.viewport.width * graphicWidthPercentage + "px";
            }
            baseLineValue.style.height = 48 + "px";
            baseLineValue.setAttribute("data-type", "basevalue");
            baseLineValue.setAttribute("contenteditable", "true");
            baseLineValue.setAttribute("data-dck-selector", "true");

            baseLineValue.setAttribute("data-slideid", this.voData.slideID);
            baseLineValue.innerText = parseInt(baseLineBottomValue);
            baseLineValue.style.top = this.viewport.height + topPadding + "px";
            baseLineValue.dataset.animation = "baselinevalue";
            parentDiv.appendChild(baseLineValue);
            let basevalueWidth = baseLineValue.clientWidth;
            if (this.data.chartFlip) {
                baseLineValue.style.right = this.viewport.width * graphicWidthPercentage - 2 - basevalueWidth / 2 + "px";
            } else {
                baseLineValue.style.left = this.viewport.width * graphicWidthPercentage - 2 - basevalueWidth / 2 + "px";
            }
            this.ChartHelper.setTextChangeListner(baseLineValue);
            baseLineValue.style.height = "auto";
