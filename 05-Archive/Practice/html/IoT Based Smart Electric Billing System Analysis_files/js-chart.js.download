    let newName = menulist[graphicname];
    let dummeymenu = "";
    if (newName) {
        dummeymenu = this.getMenuDetail(newName);
    }
    if (!dummeymenu) {
        newName = secondaryMenulist[graphicname];
        dummeymenu = this.getMenuDetail(newName);
    }
    if (!dummeymenu) {
        newName = ThirdMenuList[graphicname];
        dummeymenu = this.getMenuDetail(newName);
    }
    if (!dummeymenu) {
        newName = fourtListMenu[graphicname];
        dummeymenu = this.getMenuDetail(newName);
    }
    if (!newName || !dummeymenu) {
        if (graphicname && graphicname.toLowerCase().includes("column")) {
            newName = "column-arrow-sty-a";
            dummeymenu = this.getMenuDetail(newName);
            if (!dummeymenu) {
                newName = "column-arrow-sty-a";
                dummeymenu = this.getMenuDetail(newName);
            }
        } else if (graphicname && graphicname.toLowerCase().includes("bar")) {
            newName = "bar-arrow-sty-a";
        } else {
            newName = "column-arrow-sty-a";
            dummeymenu = this.getMenuDetail(newName);
            if (!dummeymenu) {
                newName = "column-arrow-sty-a";
                dummeymenu = this.getMenuDetail(newName);
            }
        }
    }
    return newName;
};
ChartHelper.prototype.getItemImagePlaceHolderPath = function (xmlData, serverurl, groupindex, totalCount = 0) {
    let itemPlaceholderValue = xmlData.children[groupindex].getAttribute("itemimageplaceholder");
    let arrItemPlaceHolder = [];
    let defaultPlaceHolder = serverurl + "genericassets/placeholderimages/placeholder.png";
    let strImagePlaceHolder = "";
    if (itemPlaceholderValue) {
        arrItemPlaceHolder = itemPlaceholderValue.split("}");
        let indexValue = arrItemPlaceHolder.length;
        let lengthValue = arrItemPlaceHolder.length < totalCount ? totalCount : arrItemPlaceHolder.length;
        for (let c1 = indexValue; c1 < lengthValue; c1++) {
            arrItemPlaceHolder.push(defaultPlaceHolder);
        }
        strImagePlaceHolder = arrItemPlaceHolder.join("}");
        xmlData.children[groupindex].setAttribute("itemimageplaceholder", strImagePlaceHolder);
    } else {
        for (let r1 = 0; r1 < totalCount; r1++) {
            arrItemPlaceHolder.push(defaultPlaceHolder);
        }
        if (arrItemPlaceHolder.length > 0) {
            strImagePlaceHolder = arrItemPlaceHolder.join("}");
            xmlData.children[groupindex].setAttribute("itemimageplaceholder", strImagePlaceHolder);
        }
    }
    return arrItemPlaceHolder;
};

