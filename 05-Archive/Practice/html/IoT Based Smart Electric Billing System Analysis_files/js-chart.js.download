        }
        if (((strPlaceHolder == null || strPlaceHolder == "") && this._customProperties.primaryPlaceholder) || (strPlaceholderType === "logo" && strPlaceHolder && strPlaceHolder.includes(".svg") && !strPlaceHolder.includes(".png"))) {
            let defaultPlaceHolder = defaultLogoPath ? defaultLogoPath : this._serverUrl + "genericassets/placeholderimages/logoimage.png";
            strPlaceHolder = strPlaceholderType === "ICON" || strPlaceholderType === "icon" ? (this._chartPlaceHolder.split("/").length > 4 ? this._chartPlaceHolder.split("/")[4] : this._chartPlaceHolder.split("/")[3]) : defaultPlaceHolder;
            strPlaceHolder = strPlaceholderType === "logo" && strPlaceHolder && strPlaceHolder.includes(".svg") ? defaultPlaceHolder : strPlaceHolder;
