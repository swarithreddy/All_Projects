    //------------------------------------------  highlight value  -----------------------------------------------------

    this.enableHighlightValue = hadhighlightvalue && data.getAttribute("highlightvalue") ? true : false;
    this.valueHighlightValue = data.getAttribute("highlightvalue") == "true" ? true : false;
    let objHighlightValue = {
        visible: this.enableHighlightValue,
        value: this.valueHighlightValue,
    };
    //------------------------------------------  labelHeader  -----------------------------------------------------
    let hasHeader = voLayout.haslabelHeaderTitle || voLayout.hasvalueHeaderTitle || voLayout.hasitemHeaderTitle || voLayout.hasPlaceholderHeaderTitle;
    this.enableLabelHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    this.valueLabelHeader = data.getAttribute("boollabelheader") == "true" ? true : false;
    let objLabelHeader = {
        visible: this.enableLabelHeader,
        value: this.valueLabelHeader,
    };
    //------------------------------------------  valueHeader  -----------------------------------------------------
    this.enableValueHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    let valueNode = data.getAttribute("overlapgrid") == "true";
    if (valueNode) {
        this.enableValueHeader = false;
    }
    this.valueValueHeader = data.getAttribute("boolvalueheader") == "true" ? true : false;
    let selectedValueFormat = data.getAttribute("valueheaderformat") ? data.getAttribute("valueheaderformat") : "";
    let selectedindex = ChartUtils.getSelectedIndex(dpValueHeaderFormat, selectedValueFormat);
    let objValueHeader = {
        visible: this.enableValueHeader,
        value: this.valueValueHeader,
        formatIndex: selectedindex,
    };
    //------------------------------------------  itemHeader  -----------------------------------------------------

    this.enableItemHeader = hasHeader && seriesItemLength < 2; //data.getAttribute("data-baseline") ? true : false;
    this.valueItemHeader = data.getAttribute("boolitemheader") == "true" ? true : false;
    let objItemHeader = {
        visible: this.enableItemHeader,
        value: this.valueItemHeader,
    };
    //------------------------------------------  placeholderHeader  -----------------------------------------------------

    this.enablePlaceholderHeader = hasHeader; //data.getAttribute("data-baseline") ? true : false;
    this.valuePlaceholderHeader = data.getAttribute("boolplaceholderheader") == "true" ? true : false;
    let objPlaceholderHeader = {
        visible: this.enablePlaceholderHeader,
        value: this.valuePlaceholderHeader,
    };
    //------------------------------------------  Highlight Differnce  -----------------------------------------------------

    this.enableindulaHd = hadIndualHd || data.getAttribute("data-indualhighlight") == "true" ? true : false;
    this.valueIndualHd = data.getAttribute("data-indualhighlight") == "true" || data.getAttribute("indualhd") == "true" ? true : false;
    let objIndualHd = {
        visible: this.enableindulaHd,
        value: this.valueIndualHd,
    };

    //------------------------------------------  prompttext  -----------------------------------------------------

    this.enablePrompttext = hadPromptText;
    this.valuePrompttext = data.getAttribute("prompttext") == "true" ? true : false;
    let objPromptText = {
        visible: this.enablePrompttext,
        value: this.valuePrompttext,
        secondaryvalue: this.enablePrompttext && data.getAttribute("prompthide") == "true",
        property: "prompttext",
    };
    //------------------------------------------  sourceText  -----------------------------------------------------

    this.enableSorcetext = true;
    this.valueSourcetext = data.getAttribute("sourcetext") == "true" ? true : false;
    let objSourceText = {
        visible: this.enableSorcetext,
        value: this.valueSourcetext,
        property: "sourcetext",
        label: "sourcetext",
    };
    //------------------------------------------  chart Title  -----------------------------------------------------

    this.enableTitletext = true;
    this.valueChartTitle = data.getAttribute("charttitle") == "true" ? true : false;
    let objChartTitle = {
        visible: this.enableTitletext,
        value: this.valueChartTitle,
        property: "charttitle",
        label: "charttitle",
    };
    //------------------------------------------  primary  -----------------------------------------------------

    this.primaryPlaceholder = data.getAttribute("primaryplaceholder") == "true" ? true : data.getAttribute("data-primaryplaceholder") == "true" ? true : false;
    this.placehoderType = data.getAttribute("primaryplaceholder") == "true" ? true : data.getAttribute("data-primaryplaceholder") == "true" ? true : false;
    if (chartName == "logoGraphicComparisonChart") {
        this.primaryPlaceholder = data.getAttribute("primaryplaceholder") == "true" ? true : data.getAttribute("data-primaryplaceholder") == "true" ? true : false;
    }
    let rules = ChartUtils.ruler(data, null, "layout");
    if (layoutName == "toplabel" || layoutName == "topvalue") {
        //|| seriesItemLength > 1
        hadPlaceholder = false;
        this.primaryPlaceholder = false;
    }
    if (rules) {
        if (rules["layout"] && this._validHover) {
            hadPlaceholder = false;
            this.primaryPlaceholder = false;
        }
    }
    if (voLayout.showPlaceholder) voLayout.showPlaceholder = this.primaryPlaceholder;
    // if (data.getAttribute("data-primaryplaceholder") == "true") hadPlaceholder = false;
    this.placeholderType = hadPlaceholder && data.getAttribute("primaryplaceholder-type") ? data.getAttribute("primaryplaceholder-type") : "none";
    let intPlaceholderindex = ChartUtils.getSelectedIndex(arrPlaceholder, this.placeholderType);
    let objPrimaryPlaceholder = {
        visible: hadPlaceholder,
        value: this.primaryPlaceholder,
        dpSource: arrPlaceholder,
        selectedindex: intPlaceholderindex,
        // property:"primaryplaceholderType",
        // secondaryProperty:[{property:"primaryplaceholder",value:this.primaryPlaceholder}]
    };
    this.secondaryPlaceholder = true;
    //--------------------------------------  value seperator  -----------------------------------------------------

    hadValueSeperator = hadValueSeperator ? false : true;
    hadValueSeperator = this.datapoint == "none" ? false : hadValueSeperator;
    this.seperator = data.getAttribute("showvalueseperator") ? (data.getAttribute("showvalueseperator") == "true" ? true : false) : true;
    this.valueseparator = data.getAttribute("valueseparator");

    let intSeperatorindex = ChartUtils.getSelectedIndex(arrSeperatorList, this.valueseparator);
    let objValueSeperator = {
        visible: hadValueSeperator,
        dpSource: arrSeperatorList,
        selectedindex: intSeperatorindex,
        value: this.seperator,
    };
    //------------------------------------------  ComparePlaceholder  -----------------------------------------------------

    this.enableComparePlaceholder = data.getAttribute("comparedivider") == "true" ? true : false;
    this.valueComparePlaceholder = data.getAttribute("enablecompareplaceholder") == "false" ? false : true;
    if (this.enableComparePlaceholder) {
        let comparePlaceholderType = data.getAttribute("primaryplaceholder-type") ? data.getAttribute("primaryplaceholder-type") : "logo";
        intPlaceholderindex = ChartUtils.getSelectedIndex(arrPlaceholder, comparePlaceholderType);
        objPrimaryPlaceholder = {
            visible: this.enableComparePlaceholder,
            value: this.valueComparePlaceholder,
            dpSource: arrPlaceholder,
            selectedindex: intPlaceholderindex,
            property: "primaryplaceholderType",
            secondaryProperty: [{ property: "primaryplaceholder", value: this.primaryPlaceholder }],
        };
    }
    //-----------------------------------------------Custom Lgend -------------------------------------------------
    this.customLegend = data.getAttribute("customlegend") == "false" ? false : true;
    let Value = data.children[0].getAttribute("value") ? data.children[0].getAttribute("value").split(",") : [];
    hadCustomLegend = Value.length > 1 && chartName != "waterfallchart" ? true : hadCustomLegend;
    let secondaryCustomLegend = chartName.includes("pie") || chartName.includes("Pie") || chartName.toLowerCase().includes("doughnut") ? false : hadCustomLegend;
    // this.customLegend = layoutName.includes("legend") ? this.customLegend : false;
    if (data.getAttribute("comparedivider") == "true") {
        hadCustomLegend = false;
    }

    let objCustomLegend = {
        visible: hadLegend && hadCustomLegend,
        value: this.customLegend,
        secondary: secondaryCustomLegend,
    };
    // -----------------------------------------------Semi Chart----------------------------------------------------
    this.semichart = data.getAttribute("semichart") == "true" || chartName.includes("half") || chartName.includes("Semi") ? true : false;
    // hadSemiChart = !data.getAttribute("doughnutchart") || data.getAttribute("doughnutchart") != "true" ? hadSemiChart : false;
    let objSemiChart = {
        visible: false, //hadSemiChart
        value: this.semichart,
    };
    // -----------------------------------------------Doughnut Chart----------------------------------------------------
    this.customdoughnut = data.getAttribute("customdoughnut") == "true" || chartName.toLowerCase().includes("doughnut") ? true : false;
    hadCustomDoughnut = !data.getAttribute("semichart") || data.getAttribute("semichart") != "true" ? hadCustomDoughnut : false;
    let objdoughnutChart = {
        visible: hadCustomDoughnut,
        value: this.customdoughnut,
    };
    //------------------------------------------  secondary Text  -----------------------------------------------------

    if (hadSecondaryText) {
        this.secondaryElements = data.getAttribute("secondarytext") == "true" ? true : false;
        if (this.secondaryElements) data.setAttribute("secondaryplaceholder", "text");
        else data.getAttribute("secondaryplaceholder", "none");
        voLayout.showSecondaryPlaceholder = hadSecondaryText && this.secondaryElements;
        this.secondaryType = "text";
    }
    let objSecondaryText = {
        visible: hadSecondaryText,
        value: this.secondaryElements,
    };
    // ---------------------------------------------------------------------------------------------------------------
    let chartProperties = ChartUtils.getChartProperties(argProp.data);
    let customMaxValue = hadCustomMaxValue;
    let objCustomMax = "";
    // showxaxis:disbleXaxis,
    if (customMaxValue) {
        let numCustomMaxValue = data.getAttribute("customdisplaymaxvalue") ? data.getAttribute("customdisplaymaxvalue") : data.getAttribute("yaxismaxvalue");
        objCustomMax = {
            visible: customMaxValue,
            value: numCustomMaxValue,
        };
    }
    let hasProjection = false;
    if (objBaseProperties.projectionEnable == "true") {
        hasProjection = true;
    }
    //show chartlist:
    let hadChartList = true;

    let chartDpList = [
        { icon: "bar_chart", lable: "bar", assettype: "chart", menuname: "bar-sty-a" },
        { icon: "column_chart", lable: "column", assettype: "chart", menuname: "column-sty-a" },
        { icon: "area_chart", lable: "area", assettype: "chart", menuname: "area-spline-sty-a" },
        { icon: "line_area_chart", lable: "line", assettype: "chart", menuname: "line-spline-sty-a" },
        { icon: "pie_chart", lable: "pie", assettype: "chart", menuname: "pie-sty-a" },
        { icon: "waterfall", lable: "waterfall", assettype: "chart", menuname: "waterfall-sty-a" },
        { icon: "comparison_chart", lable: "compare", assettype: "chart", menuname: "compare-scale-sty-a" },
    ];
    let currentGraphicMenuName = data.getAttribute("graphicname");
    let menuSelectedIndex = ChartUtils.getSelectedMenuIndex(chartDpList, currentGraphicMenuName);
    let objChartList = {
        visible: hadChartList,
        dpSource: chartDpList,
        selectedindex: menuSelectedIndex,
    };

    let hadLabelInterChange = Value?.length > 0 ? true : false;
    let arrLabelNode = [{ data: "label", label: "label" }];
    for (let l1 = 0; l1 < Value?.length; l1++) {
        arrLabelNode.push({ data: "value" + l1, label: "point" + (l1 + 1) });
    }
    let labelValue = data.getAttribute("interchangelabeldata");
    let intLabelSepearteIndex = ChartUtils.getSelectedIndex(arrLabelNode, labelValue);
    let objLabelInterchange = {
        visible: hadLabelInterChange,
        dpSource: arrLabelNode,
        selectedindex: intLabelSepearteIndex,
    };

    let hadValueInterChange = true;
    let objValueInterchange = {
        visible: hadValueInterChange,
        dpSource: [],
        selectedindex: menuSelectedIndex,
    };
    let valueNodes = [];
    let interChangeNode = data?.children[0]?.getAttribute("valueinterchange");
    let arrInterChangeNode = interChangeNode?.split(",");
    let inetrChangelength = interChangeNode?.split(",")?.length || Value?.length;
    inetrChangelength = Value?.length > 1 && chartName == "waterfallchart" ? 1 : inetrChangelength;
    let reverseChart = chartName == "columnStackedRectangle";
    if (reverseChart) {
        for (let i1 = 0; i1 < inetrChangelength; i1++) {
            let indexValue = data?.children[0]?.getAttribute("valueinterchange")?.split(",")[i1] || i1;
            valueNodes.push({ data: indexValue, label: "point" + (parseFloat(arrInterChangeNode?.[i1] || i1) + 1), value: Value[i1], isreverseChart: reverseChart });
        }
        valueNodes.reverse();
    } else {
        for (let i1 = 0; i1 < inetrChangelength; i1++) {
            let indexValue = data?.children[0]?.getAttribute("valueinterchange")?.split(",")[i1] || i1;
            valueNodes.push({ data: indexValue, label: "point" + (parseFloat(arrInterChangeNode?.[i1] || i1) + 1) });
        }
    }

    objValueInterchange["dpSource"] = valueNodes;

    let addColumn = maxAllowedSeriesItems > seriesItemLength ? true : false;
    let objAddColumn = {
        visible: addColumn,
        value: addColumn,
    };
    objAllProperties = {
        xaxis: objXAxis,
        yaxis: objYAxis,
        grid: enablegrid,
        sorting: objSorting,
        iconsize: objiconsize,
        animation: objAnimation,
        coinstyle: objCoinType,
        valueformat: objValueFormat,
        maxvaluecount: objMaxValueCount,
        prefixsuffix: objPrefixSuffix,
        valueseperator: objValueSeperator,
        highlightdiff: objHighlightDiffrents,
        primaryplaceholder: objPrimaryPlaceholder,
        baseline: objBaseLine,
        spline: objSpline,
        linehead: objLineHead,
        prompt: objPromptText,
        sourcetext: objSourceText,
        charttitletext: objChartTitle,
        secondaryplaceholder: objSecondaryplaceholder,
        commonplaceholder: objCommonPlaceHolder,
        innerradius: objInnerradius,
        basicproperties: chartProperties,
        customlegend: objCustomLegend,
        customlegendpos: objLegendPosition,
        semichart: objSemiChart,
        secondarytext: objSecondaryText,
        customdoughnut: objdoughnutChart,
        alignment: this.alignment,
        valuedisplayformat: objValueDisplayFormat,
        sequencenumber: objSequenceNumber,
        highvaluebreak: objHighValueBreak,
        chartflip: objChartFlip,
        showlabels: objShaowLabel,
        showCustomMaxValue: objCustomMax,
        disableAdditem: boolDisableAdditem,
        indualhd: objIndualHd,
        itemheader: objItemHeader,
        valueheader: objValueHeader,
        labelheader: objLabelHeader,
        placeholderheader: objPlaceholderHeader,
        highlightvalue: objHighlightValue,
        multislide: objMultiSlide,
        chartlist: objChartList,
        projection: data.getAttribute("projection") == "true",
        emphasis: data.getAttribute("emphasis") == "true",
        hasProjection: hasProjection,
        valueinterchange: objValueInterchange,
        labelinterchange: objLabelInterchange,
        addcolumn: objAddColumn,
        maxallowedseriesitems: maxAllowedSeriesItems,
    };
}

